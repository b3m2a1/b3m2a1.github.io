Cell["and using that we can factor out the overlap contribution as", \
"ExpositoryText",
 CellChangeTimes->{{3.916164910774534*^9, 3.9161649524708567`*^9}, {
  3.9161656666267223`*^9, 
  3.916165666987728*^9}},ExpressionUUID->"93bb20ef-82b9-4850-aea6-\
8e29f2a95b3a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["X", "0", 
    RowBox[{"(", 
     RowBox[{"i", ",", "j"}], ")"}]], " ", "=", " ", 
   RowBox[{
    SqrtBox[
     RowBox[{
      SuperscriptBox["\[Pi]", "d"], 
      RowBox[{"\[LeftBracketingBar]", 
       SuperscriptBox["\[CapitalSigma]", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]], "\[RightBracketingBar]"}]}]], 
    "\[InvisibleSpace]", 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], 
      RowBox[{
       SuperscriptBox["p", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]], "\[Transpose]"}], 
      SuperscriptBox["\[CapitalLambda]", 
       RowBox[{"(", 
        RowBox[{"i", ",", "j"}], ")"}]], 
      SuperscriptBox["p", 
       RowBox[{"(", 
        RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["\[DoubleStruckI]\[Xi]", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]]}], "\[CenterDot]", 
      SuperscriptBox["p", 
       RowBox[{"(", 
        RowBox[{"i", ",", "j"}], ")"}]]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916164935859263*^9, 3.916164936385347*^9}, {
  3.916165271406515*^9, 3.916165388702989*^9}, {3.916165606235589*^9, 
