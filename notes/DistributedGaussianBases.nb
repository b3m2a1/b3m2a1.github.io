d7f62867daf2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Integral]", "q"], 
    RowBox[{
     RowBox[{
      SubscriptBox["P", 
       StyleBox["n",
        FontWeight->"Bold"]], "(", "x", ")"}], 
     RowBox[{"\[Phi]", "(", 
      RowBox[{"x", ",", " ", "\[Xi]", ",", " ", "\[CapitalSigma]"}], 
      ")"}]}]}], " ", "=", " ", 
   RowBox[{
    RowBox[{"\[Phi]", "(", 
