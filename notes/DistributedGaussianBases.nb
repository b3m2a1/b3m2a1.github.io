Cell[BoxData[
 RowBox[{
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "a1"}], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"c1", "-", "q"}], ")"}], "2"]}], "-", 
    RowBox[{"a2", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"c2", "-", "q"}], ")"}], "2"]}], "+", 
    RowBox[{"\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{"p1", "+", "p2"}], ")"}], " ", "q"}]}]], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], " ", "a2"}], "+", 
    SuperscriptBox[
