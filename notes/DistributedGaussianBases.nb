864b22db67bc"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       UnderscriptBox["\[Sum]", "k"], " ", 
       RowBox[{
        FractionBox["1", 
         SubscriptBox["m", "k"]], 
        FractionBox["d", 
