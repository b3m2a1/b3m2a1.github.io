        TemplateBox[{"\"(\"", 
          RowBox[{"Q", "-", 
            TemplateBox[{"\[Xi]", 
              TemplateBox[{"\"(\"", "c", "\")\""}, "RowDefault"]}, 
             "Superscript", SyntaxForm -> SuperscriptBox]}], "\")\""},
         "RowDefault"], "\[CircleTimes]", 
        TemplateBox[{
          TemplateBox[{"\[CapitalSigma]", 
            TemplateBox[{"\"(\"", "d", "\")\""}, "RowDefault"]}, 
           "Superscript", SyntaxForm -> SuperscriptBox], 
          "\"\[CapitalDelta]\""},
         "RowDefault"], "\[CircleTimes]", 
        TemplateBox[{"\"(\"", 
          RowBox[{"Q", "-", 
            TemplateBox[{"\[Xi]", 
              TemplateBox[{"\"(\"", "c", "\")\""}, "RowDefault"]}, 
             "Superscript", SyntaxForm -> SuperscriptBox]}], "\")\""},
         "RowDefault"], "\[CircleTimes]", 
        TemplateBox[{
          TemplateBox[{"\[CapitalSigma]", 
            TemplateBox[{"\"(\"", "d", "\")\""}, "RowDefault"]}, 
           "Superscript", SyntaxForm -> SuperscriptBox], 
          "\"\[CapitalDelta]\""},
         "RowDefault"]}],
       StripOnInput->False,
       ShowStringCharacters->False,
       FontSize->18],
      CircleTimes[
       $CellContext`Q[
        $CellContext`\[Xi][$CellContext`c]], 
       NonCommutativeMultiply[
        $CellContext`\[CapitalGamma][$CellContext`d], 
        $CellContext`\[CapitalDelta][$CellContext`i, $CellContext`j]], 
       $CellContext`Q[
        $CellContext`\[Xi][$CellContext`c]], 
       NonCommutativeMultiply[
        $CellContext`\[CapitalGamma][$CellContext`d], 
        $CellContext`\[CapitalDelta][$CellContext`i, $CellContext`j]]]]},
    {
     InterpretationBox[
      StyleBox[
