Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"N", "(", "\[CapitalSigma]", ")"}], " ", "=", " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[Pi]", 
       RowBox[{"-", "d"}]], 
      RowBox[{"det", "(", 
       SuperscriptBox["\[CapitalSigma]", 
        RowBox[{"-", "1"}]], ")"}]}], ")"}], 
    RowBox[{"1", "/", "4"}]], " "}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.883847037855648*^9, 3.883847207630611*^9}, {
