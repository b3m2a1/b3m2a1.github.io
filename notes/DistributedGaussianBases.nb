Cell[CellGroupData[{

Cell["Tests", "Subsubsubsection",
 CellChangeTimes->{{3.916082409507059*^9, 
  3.916082410165107*^9}},ExpressionUUID->"5c42dda0-654d-44e4-9693-\
ab1db654570e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"G", "(", 
    RowBox[{"\[Alpha]", ",", " ", "p", ",", " ", "k", ",", " ", "b"}], ")"}], 
   " ", "=", " ", 
   RowBox[{
    RowBox[{"\[CapitalGamma]", "(", 
     RowBox[{"b", "+", 
      RowBox[{"\[LeftFloor]", 
       RowBox[{"k", "/", "2"}], "\[RightFloor]"}]}], ")"}], 
    RowBox[{
     SubscriptBox["F", "1"], "(", 
     RowBox[{
      RowBox[{"b", "+", 
       RowBox[{"\[LeftFloor]", 
        RowBox[{"k", "/", "2"}], "\[RightFloor]"}]}], ";", " ", 
      RowBox[{"b", "+", 
       RowBox[{"\[LeftFloor]", 
        RowBox[{"k", "/", "2"}], "\[RightFloor]"}]}], ";", " ", 
      RowBox[{"-", 
       FractionBox[
        SuperscriptBox["p", "2"], 
        RowBox[{"4", "\[InvisibleSpace]", "\[Alpha]"}]]}]}], ")"}], " "}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916068938290694*^9, 
  3.916069036942236*^9}},ExpressionUUID->"48d15490-c7a1-4a15-b018-\
08efcf00958c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"hgfTerm", "[", 
    RowBox[{"b_", ",", " ", "k_", ",", " ", "x_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Exp", "[", "x", "]"}], "*", 
    RowBox[{"Total", "@", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Gamma", "[", 
          RowBox[{"b", "+", "k"}], "]"}], "/", 
         RowBox[{"Pochhammer", "[", 
          RowBox[{"b", ",", " ", "n"}], "]"}]}], "*", 
        RowBox[{"Binomial", "[", 
         RowBox[{"k", ",", "n"}], "]"}], "*", 
        RowBox[{"x", "^", "n"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "0", ",", " ", "k"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaussG", "[", 
    RowBox[{"a_", ",", " ", "p_", ",", " ", "k_", ",", " ", "b_"}], "]"}], ":=",
    "\[IndentingNewLine]", 
   RowBox[{"hgfTerm", "[", 
    RowBox[{"b", ",", " ", 
     RowBox[{"Floor", "[", 
      RowBox[{"k", "/", "2"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"p", "^", "2"}]}], "/", 
      RowBox[{"(", 
       RowBox[{"4", "a"}], ")"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gaussX", "[", "k_", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"2", "^", 
        RowBox[{"Ceiling", "[", 
         RowBox[{"k", "/", "2"}], "]"}]}], "/", 
       RowBox[{"(", 
        RowBox[{
         SqrtBox["\[Pi]"], 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            SuperscriptBox["\[FormalP]", "2"]}], "/", 
           RowBox[{"(", 
            RowBox[{"4", "\[FormalA]"}], ")"}]}], "]"}]}], ")"}]}], 
      RowBox[{"gaussG", "[", 
       RowBox[{"\[FormalA]", ",", " ", "\[FormalP]", ",", " ", "k", ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OddQ", "[", "k", "]"}], ",", " ", 
          RowBox[{"3", "/", "2"}], ",", " ", 
          RowBox[{"1", "/", "2"}]}], "]"}]}], "]"}]}], "/.", 
     RowBox[{"\[FormalA]", "->", 
      RowBox[{
       SuperscriptBox["\[FormalP]", "2"], "/", 
       RowBox[{"(", 
        RowBox[{"2", "\[FormalN]"}], ")"}]}]}]}], ")"}], " ", "//", 
   "Expand"}]}]}], "Input",
 CellChangeTimes->{{3.916082234113264*^9, 3.916082287867817*^9}, {
  3.916082351372862*^9, 3.916082493563426*^9}, {3.916147400988525*^9, 
  3.916147488031575*^9}},
 CellLabel->
  "In[1819]:=",ExpressionUUID->"5399fde6-ea11-4ebe-8dff-3cf5ad50ca37"],

Cell[CellGroupData[{

