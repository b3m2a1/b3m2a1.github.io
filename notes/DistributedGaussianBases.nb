Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       FractionBox[
        SuperscriptBox["\[PartialD]", "\[Nu]"], 
        RowBox[{"\[PartialD]", 
         SubsuperscriptBox["x", "k", "\[Nu]"]}]], 
       SubsuperscriptBox["P", 
        StyleBox["n",
         FontWeight->"Bold"], 
        RowBox[{"(", "i", ")"}]]}], " ", "=", " ", 
      RowBox[{
       SqrtBox[
        FractionBox["1", 
         RowBox[{
          StyleBox["n",
           FontWeight->"Bold"], 
          StyleBox["!",
           FontWeight->"Plain"]}]]], "\[InvisibleSpace]", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["P",
          FontWeight->"Bold"], 
         StyleBox["n",
          FontWeight->"Bold"], 
         RowBox[{"(", "i", ")"}]], "\[CircleDot]", 
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           SuperscriptBox["\[PartialD]", "\[Nu]"], 
           RowBox[{"\[PartialD]", 
            SubsuperscriptBox["x", "k", "\[Nu]"]}]], 
          SuperscriptBox["\[Chi]", 
           StyleBox["n",
            FontWeight->"Bold"]]}], ")"}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SqrtBox[
        FractionBox["1", 
         RowBox[{
          StyleBox["n",
           FontWeight->"Bold"], 
          StyleBox["!",
           FontWeight->"Plain"]}]]], "\[InvisibleSpace]", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["P",
          FontWeight->"Bold"], 
         StyleBox["n",
          FontWeight->"Bold"], 
         RowBox[{"(", "i", ")"}]], "\[CircleDot]", 
        RowBox[{"(", 
         RowBox[{
          UnderscriptBox["\[CircleTimes]", "j"], 
          TagBox[GridBox[{
             {"\[Piecewise]", GridBox[{
                {
                 SuperscriptBox["\[Chi]", 
                  SubscriptBox[
                   StyleBox["n",
                    FontWeight->"Bold"], "j"]], 
                 RowBox[{"j", "\[NotEqual]", "k"}]},
                {
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"rfac", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"i", "-", "v", "+", "1"}], ",", " ", "i"}], ")"}], 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{
                    SubscriptBox["x", "k"], 
                    StyleBox["\[VeryThinSpace] ",
                    FontSize->14], 
                    StyleBox["-",
                    FontSize->14], 
                    StyleBox[" ",
                    FontSize->14], 
                    SubsuperscriptBox["\[Xi]", "k", 
                    RowBox[{"(", 
                    RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]]}], ")"}], 
                    
                    RowBox[{"i", "-", "v"}]]}], ":", "i"}], "=", 
                   RowBox[{
                    RowBox[{"0", "..."}], 
                    SubscriptBox["n", "k"]}]}], "}"}], 
                 RowBox[{"j", "=", "k"}]}
               },
               AllowedDimensions->{2, Automatic},
