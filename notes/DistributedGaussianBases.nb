  3.9168368506509323`*^9}},ExpressionUUID->"e90ac6ca-d994-400f-a069-\
4108f0f3b44c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Integral]", 
    RowBox[{
     UnderscriptBox["\[Product]", "n"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["V", 
         SubscriptBox["a", "n"], 
         RowBox[{"(", "n", ")"}]], "Q"}], "-", "\[Mu]", "+", 
       SubsuperscriptBox["s", 
        SubscriptBox["a", "n"], 
        RowBox[{"(", "n", ")"}]]}], ")"}]}]}], " ", "=", " ", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{"p", "\[Element]", 
      RowBox[{"LP", "(", "N", ")"}]}]], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       UnderscriptBox["\[Product]", 
        RowBox[{"k", "\[Element]", 
         RowBox[{"F", "(", "p", ")"}]}]], 
       SubsuperscriptBox["s", 
        SubscriptBox["a", "k"], 
        RowBox[{"(", "k", ")"}]]}], ")"}], 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{"b", "\[Element]", 
        RowBox[{"PP", "(", 
         RowBox[{"T", "(", "p", ")"}], ")"}]}]], 
      RowBox[{
       UnderscriptBox["\[Product]", 
        RowBox[{" ", 
         RowBox[{
          SubscriptBox["k", "1"], ",", " ", 
          RowBox[{
           SubscriptBox["k", "2"], "\[Element]", "b"}]}]}]], 
       RowBox[{
        SubsuperscriptBox["V", 
         SubscriptBox["a", 
          SubscriptBox["k", "1"]], 
         RowBox[{"(", "\[VeryThinSpace]", 
          SubscriptBox["k", "1"], ")"}]], 
        SuperscriptBox["\[CapitalSigma]", 
         RowBox[{"(", 
          RowBox[{"i", ",", "j"}], ")"}]], 
        SubsuperscriptBox["V", 
         SubscriptBox["a", 
          SubscriptBox["k", "2"]], 
         RowBox[{"(", "\[VeryThinSpace]", 
          SubscriptBox["k", "2"], ")"}]]}]}]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916836868165621*^9, 3.9168369638327503`*^9}, {
  3.9168370438356*^9, 
  3.916837118715577*^9}},ExpressionUUID->"d4c8e754-20e6-4929-87e8-\
33c865e09b6c"],

Cell[TextData[{
 "where LP is the set of lattice paths as binary strings, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "(", "p", ")"}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "d0731814-abaf-417a-b981-341d99ea4aaf"],
