29dbae90dc5e"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["\[Mu]", 
       RowBox[{"n", " "}], 
       RowBox[{"(", "k", ")"}]], " ", "=", " ", 
      RowBox[{
       RowBox[{"\[LeftCeiling]", 
        RowBox[{"k", "/", "2"}], "\[RightCeiling]"}], 
       RowBox[{"(", " ", 
        RowBox[{
         SubsuperscriptBox["\[Mu]", 
          RowBox[{"n", " "}], 
          RowBox[{"(", 
           RowBox[{"k", "-", "2"}], ")"}]], " ", "-", 
         RowBox[{
          FractionBox["1", 
           RowBox[{
            RowBox[{"2", "\[InvisibleSpace]", "n"}], " ", "-", " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "k"]}]], 
          SubsuperscriptBox["\[Mu]", 
           RowBox[{"n", "-", "1"}], 
           RowBox[{"(", 
            RowBox[{"k", "-", "2"}], ")"}]]}]}], ")"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "n"], "\[InvisibleSpace]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          UnderoverscriptBox["\[Product]", 
           RowBox[{"j", "=", 
            RowBox[{"n", "+", "1"}]}], 
           RowBox[{"\[LeftFloor]", 
            RowBox[{"k", "/", "2"}], "\[RightFloor]"}]], 
          RowBox[{"2", "\[InvisibleSpace]", "j"}]}], " ", "-", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], "k"]}], ")"}], "\[VeryThinSpace]", 
       RowBox[{"(", GridBox[{
          {
           RowBox[{"\[LeftFloor]", 
            RowBox[{"k", "/", "2"}], "\[RightFloor]"}]},
          {"n"}
         },
         GridBoxAlignment->{"Columns" -> {Center}}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
