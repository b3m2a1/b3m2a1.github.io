         "\[LeftDoubleBracket]", 
        RowBox[{"u", ",", "v"}], "\[RightDoubleBracket]"}]}], ",", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"\[CapitalGamma]j", "\[LeftDoubleBracket]", 
           RowBox[{"n", ",", "v"}], "\[RightDoubleBracket]"}], " ", 
          RowBox[{"\[CapitalGamma]i", "\[LeftDoubleBracket]", 
           RowBox[{"m", ",", "u"}], "\[RightDoubleBracket]"}]}], "+", 
         RowBox[{
          RowBox[{"\[CapitalGamma]j", "\[LeftDoubleBracket]", 
