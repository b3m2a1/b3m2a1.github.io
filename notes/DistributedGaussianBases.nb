Cell[TextData[{
 "And we can combine some of this to make for less typing, first using the \
same mind blowing ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", "x"}], " ", "=", " ", 
    RowBox[{"x", " ", "+", " ", "x"}]}], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "de20c7da-0e6d-430b-b294-c51b30449c94"],
 " trick to write"
}], "ExpositoryText",
