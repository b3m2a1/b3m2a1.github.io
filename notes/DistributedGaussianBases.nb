cd365f8130bd"],

Cell["but then we note that", "ExpositoryText",
 CellChangeTimes->{{3.916169836340035*^9, 3.916169844944363*^9}, {
  3.91617006781408*^9, 
  3.916170070259117*^9}},ExpressionUUID->"fbfc2fbd-c5bb-498d-9a16-\
d06754e51ded"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["M", "2", 
    RowBox[{"(", 
     RowBox[{"i", ",", "j"}], ")"}]], " ", "=", " ", 
   RowBox[{"1", "-", 
    FractionBox[
     SuperscriptBox[
      SubsuperscriptBox["p", "s", 
       RowBox[{"(", 
        RowBox[{"i", ",", "j"}], ")"}]], "2"], 
     RowBox[{"2", "\[InvisibleSpace]", 
