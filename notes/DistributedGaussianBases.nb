Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", 
         RowBox[{"\[LeftFloor]", 
          RowBox[{"k", "/", "2"}], "\[RightFloor]"}]}], " ", "+", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], 
         RowBox[{"k", "+", "1"}]]}], ")"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"2", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"k", " ", "-", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", " ", "-", " ", 
              SuperscriptBox[
               RowBox[{"(", 
