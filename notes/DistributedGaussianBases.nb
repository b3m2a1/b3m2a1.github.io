Cell[BoxData[
 RowBox[{
  RowBox[{"watsonTotalIntegrate", "[", 
   RowBox[{"f1_", ",", " ", "f2_", ",", " ", "x_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"terms", ",", " ", "exponent", ",", " ", "polys"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"terms", "=", 
      RowBox[{
       RowBox[{"Total", "@", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"watsonZeta", "@@", "ijkl"}], ")"}], "*", 
           RowBox[{"testWatson", "[", 
            RowBox[{"f1", ",", " ", "f2", ",", " ", "x", ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
             "ijkl"}], "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"ijkl", ",", " ", 
            RowBox[{"Tuples", "[", 
             RowBox[{
              RowBox[{"Range", "[", "3", "]"}], ",", " ", 
              RowBox[{"{", "4", "}"}]}], "]"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], "//", "Simplify"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"exponent", "=", 
      RowBox[{
       RowBox[{"Cases", "[", 
        RowBox[{"terms", ",", " ", 
         RowBox[{"Power", "[", 
          RowBox[{"E", ",", " ", "_"}], "]"}], ",", " ", "Infinity"}], "]"}], 
       "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"polys", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"terms", "/.", 
          RowBox[{
           RowBox[{"Power", "[", 
            RowBox[{"E", ",", " ", "_"}], "]"}], "->", "1"}]}], "//", 
         "Expand"}], "//", 
        RowBox[{"Apply", "[", "List", "]"}]}], "//", 
       RowBox[{
        RowBox[{"GroupBy", "[", 
         RowBox[{"#", ",", " ", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"Cases", "[", 
             RowBox[{"#", ",", " ", 
              RowBox[{"\[FormalZ]", "[", "ijkl__", "]"}], ",", " ", 
              "Infinity"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "&"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Total", "@*", 
           RowBox[{"ReplaceAll", "[", 
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{"_\[FormalZ]", "->", "1"}], "\[IndentingNewLine]", "}"}],
             "]"}]}]}], "\[IndentingNewLine]", "]"}], "&"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Prepend", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#", ",", " ", 
             RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], "&"}], 
          "/@", "x"}], ",", "\[IndentingNewLine]", 
         RowBox[{"exponent", "*", "#"}]}], "\[IndentingNewLine]", "]"}], 
       "&"}], "/@", "polys"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.9076046409389772`*^9, 3.907604761132864*^9}, 
   3.9076048206924553`*^9, 3.907604996793406*^9, {3.907605223409886*^9, 
