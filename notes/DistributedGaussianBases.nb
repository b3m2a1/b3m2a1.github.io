6a3e7ed179c6"],

Cell[BoxData[
 FormBox[
  RowBox[{"q", " ", "=", " ", 
   RowBox[{
    SubscriptBox["L", "c"], "(", 
    RowBox[{"x", " ", "-", " ", 
     SubscriptBox["\[Xi]", "j"]}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
