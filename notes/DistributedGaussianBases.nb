  3.8840131661100883`*^9}},ExpressionUUID->"2f3b1bd9-6738-45f0-9a1b-\
949b3b8347d2"],

Cell[TextData[{
 "then we\[CloseCurlyQuote]ll introduce the unitary transformation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "c"], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"bf61b8bd-1767-4623-9c2a-e898d0459516"],
 " that diagonalizes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalSigma]", "c"], TraditionalForm]],
