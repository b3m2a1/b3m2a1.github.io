    RowBox[{"k_", ",", " ", "n_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"testMkRec", "[", 
     RowBox[{"k", ",", " ", "n"}], "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", 
        RowBox[{"Floor", "[", 
         RowBox[{"k", "/", "2"}], "]"}]}], "+", 
