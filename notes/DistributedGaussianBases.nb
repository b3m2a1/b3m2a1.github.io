Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"gaussianIntegrate", ",", " ", "gaussianPolyIntegral"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaussianPolyIntegral", "[", 
    RowBox[{"k_", ",", " ", "alpha_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "k"]}], ")"}], " ", 
    SuperscriptBox["alpha", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], "-", 
      FractionBox["k", "2"]}]], " ", 
    RowBox[{"Gamma", "[", 
     FractionBox[
      RowBox[{"1", "+", "k"}], "2"], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gaussianIntegrate", "[", 
   RowBox[{"L_", ",", " ", "uc_", ",", " ", "x_", ",", " ", "integrand_", ",", 
    RowBox[{"normalize", ":", 
     RowBox[{"False", "|", "True"}], ":", "True"}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Block", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
     "int", ",", " ", "exp", ",", "arg", ",", "\[IndentingNewLine]", "prefac",
       ",", "alphas", ",", "norm", ",", "\[IndentingNewLine]", 
      RowBox[{"q", "=", 
       RowBox[{"Array", "[", 
        RowBox[{"\[FormalQ]", ",", " ", 
         RowBox[{"Length", "@", "x"}]}], "]"}]}], ",", " ", 
      "\[IndentingNewLine]", "poly", ",", "\[IndentingNewLine]", 
      "polyEvals"}], "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"int", "=", 
      RowBox[{
       RowBox[{"integrand", "/.", 
        RowBox[{"Thread", "[", 
         RowBox[{"x", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"L", ".", "q"}], "+", "uc"}], ")"}]}], "]"}]}], "//", 
       "Simplify"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"exp", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Cases", "[", 
         RowBox[{"int", ",", " ", 
          RowBox[{
           RowBox[{"e", ":", 
            RowBox[{"Power", "[", 
             RowBox[{"E", ",", " ", "_"}], "]"}]}], ":>", 
           RowBox[{"Chop", "[", "e", "]"}]}], ",", " ", "Infinity"}], "]"}], 
        "[", 
        RowBox[{"[", "1", "]"}], "]"}], "//", "FullSimplify"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"arg", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", "exp", "}"}], "//", 
        RowBox[{
         RowBox[{"Cases", "[", 
          RowBox[{"#", ",", " ", 
           RowBox[{
            RowBox[{"Power", "[", 
             RowBox[{"E", ",", " ", "p_"}], "]"}], ":>", "p"}], ",", " ", 
           "Infinity"}], "]"}], "&"}]}], "//", "First"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"prefac", "=", 
      RowBox[{
       RowBox[{"CoefficientList", "[", 
        RowBox[{"arg", ",", " ", "q"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"Sequence", "@@", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"1", ",", " ", 
           RowBox[{"Length", "@", "q"}]}], "]"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"alphas", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
