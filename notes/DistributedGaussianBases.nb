  3.8857273852783403`*^9}},ExpressionUUID->"d76fe7cf-575f-4460-b677-\
e7c7209ceabd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[CapitalLambda]", 
       RowBox[{"(", "i", ")"}]], ")"}], 
     RowBox[{"-", "1"}]], " ", "+", " ", 
    RowBox[{"R", "\[InvisibleSpace] ", 
     SuperscriptBox[
      RowBox[{"(", 
       SuperscriptBox["\[CapitalLambda]", 
        RowBox[{"(", "j", ")"}]], ")"}], 
      RowBox[{"-", "1"}]], 
     SuperscriptBox["R", 
      StyleBox["T",
       FontSize->9,
       FontSlant->"Plain"]]}]}], " ", "=", " ", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{
        SubsuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["\[CapitalLambda]", 
            RowBox[{"(", "i", ")"}]], " ", "+", " ", 
           SuperscriptBox["\[CapitalLambda]", 
            RowBox[{"(", "j", ")"}]]}], ")"}], "TR", 
         RowBox[{"-", "1"}]], " "}], " "},
      {" ", 
       SuperscriptBox[
        SubsuperscriptBox["\[CapitalSigma]", "vib", 
         RowBox[{"(", "eff", ")"}]], 
        RowBox[{"-", "1"}]]}
     }], ")"}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.885724918874527*^9, 3.88572500088627*^9}, {
