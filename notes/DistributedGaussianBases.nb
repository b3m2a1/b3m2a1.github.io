    RowBox[{"phaseGauss", "[", 
     RowBox[{"a2_", ",", " ", "p2_", ",", " ", "c2_"}], "]"}]}], ")"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"phaseGauss", "[", 
   RowBox[{
    RowBox[{"a1", "*", 
