              FractionBox[
               SuperscriptBox["\[PartialD]", "2"], 
               RowBox[{"\[PartialD]", 
                SuperscriptBox[
                 SubscriptBox["x", "k"], "2"]}]], 
              RowBox[{
               SubscriptBox["\[Phi]", "j"], "(", "x", ")"}]}], ")"}], "p"], 
           RowBox[{
            UnderoverscriptBox["\[Product]", 
             RowBox[{"k", "\[VeryThinSpace]", "=", "\[VeryThinSpace]", "1"}], 
             
             RowBox[{"3", "\[InvisibleSpace]", "N"}]], " ", 
            RowBox[{
             FractionBox["1", 
