        RowBox[{"\[Phi]", "(", 
         RowBox[{"x", ",", " ", "\[Xi]", ",", " ", "\[CapitalSigma]"}], 
         ")"}]}]}]}]},
    {
     RowBox[{" ", 
      RowBox[{"=", " ", 
       RowBox[{
        RowBox[{
