Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[Del]", "x"], 
         RowBox[{"(", 
          RowBox[{"x", "-", 
           SuperscriptBox["\[Xi]", 
            RowBox[{"(", "j", ")"}]]}], ")"}]}], ")"}], "..."}], " ", "=", 
      " ", 
      RowBox[{"I", "..."}]}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", "j", ")"}]]}], ")"}], 
        RowBox[{
         SubscriptBox["\[Del]", "x"], 
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[Delta]", 
            RowBox[{"j", "\[InvisibleSpace]", "i"}]], "-", 
           SuperscriptBox["w", 
            RowBox[{"(", "i", ")"}]]}], ")"}]}]}], "..."}], " ", "=", " ", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"x", "-", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", "j", ")"}]]}], ")"}]}], "\[CircleTimes]", 
       RowBox[{
        SubscriptBox["\[Del]", "x"], 
        SuperscriptBox["w", 
         RowBox[{"(", "i", ")"}]]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.915808375574727*^9, 3.915808391299534*^9}, {
