  "43900feb-e9f7-4679-ba2b-aa7f86f2de19"],
 " to be the ",
 StyleBox["entirely even",
  FontSlant->"Italic"],
 " partitions of ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "9b92bc12-5fa6-4df4-ba54-d82347efb0a5"]
}], "ExpositoryText",
