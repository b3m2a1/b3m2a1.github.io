    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{"[", 
        RowBox[{
         RowBox[{
         "Q", "\[VeryThinSpace]", "\[CircleTimes]", "I", "\[CircleTimes]", 
          "P"}], "+", 
         RowBox[{"Q", "\[CircleTimes]", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"Q", "\[CircleTimes]", 
             RowBox[{
              SubscriptBox["\[Del]", "Q"], "P"}]}], ")"}], 
           RowBox[{"2", "->", "1"}]]}], "+", 
         RowBox[{
         "Q", "\[CircleTimes]", "P", "\[CircleTimes]", "Q", "\[CircleTimes]", 
          "P"}]}], "]"}], 
       SuperscriptBox["\[CurlyPhi]", 
        RowBox[{"*", 
         RowBox[{"(", "j", ")"}]}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916806891138464*^9, 3.9168071598799067`*^9}, {
