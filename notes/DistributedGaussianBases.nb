Cell[TextData[{
 "which is just the classic way of saying we sum over ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalP]", "(", "d", ")"}], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "1063a54a-3e07-43cd-9a49-3fb137274b28"],
 ", the set of partitions of permutations of the total order of the \
polynomial, to figure out what order polynomial we have in each dimension. \
Then for each order we sum over the ways to distribute these across the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["V", 
    RowBox[{"(", 
     SubscriptBox["a", "n"], ")"}]], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "d996c813-bd79-422d-a51c-60b68e6ca6fe"],
 " boxes.\nFinally, each order partition permutation gets the appropriate \
prefactor."
}], "ExpositoryText",
 CellChangeTimes->{{3.916198615063901*^9, 
  3.9161989309236593`*^9}},ExpressionUUID->"dee48802-805a-41db-96bd-\
84590de2ca68"],

Cell["\<\
We\[CloseCurlyQuote]ll probably want to show how to construct this whole deal \
via induction, but first we should look at the function\
\>", "ExpositoryText",
 CellChangeTimes->{{3.9161991237844*^9, 3.916199154569393*^9}, {
  3.916199209197877*^9, 3.916199212128921*^9}, {3.916204121434993*^9, 
  3.916204122829789*^9}},ExpressionUUID->"cf3dee0c-9330-4f70-9470-\
96b4963e8911"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"Z", "(", "k", ")"}], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Product]", 
        RowBox[{"m", "=", "1"}], "d"], 
       RowBox[{
        FractionBox[
         SubsuperscriptBox["X", "0", 
          RowBox[{"(", 
           RowBox[{"i", ",", "j"}], ")"}]], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"2", 
            SubsuperscriptBox["\[Alpha]", "m", 
             RowBox[{"(", 
              RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], 
          RowBox[{"\[LeftCeiling]", 
           RowBox[{"k", "/", "2"}], "\[RightCeiling]"}]]], 
        TagBox[GridBox[{
           {"\[Piecewise]", GridBox[{
              {
               RowBox[{" ", 
                RowBox[{"\[DoubleStruckI]", "\[InvisibleSpace]\[VeryThinSpace]", 
                 SubsuperscriptBox["p", "m", 
                  RowBox[{"(", 
                   RowBox[{"i", ",", "j"}], ")"}]], "\[InvisibleSpace]", 
                 SubsuperscriptBox["M", "m", 
                  SubscriptBox["k", "m"]]}]}], 
               RowBox[{
                SubscriptBox["k", "m"], " ", "odd"}]},
              {
               SubsuperscriptBox["M", "m", 
                SubscriptBox["k", "m"]], 
               RowBox[{
                SubscriptBox["k", "m"], " ", "even"}]}
             },
             AllowedDimensions->{2, Automatic},
             Editable->True,
             
             GridBoxAlignment->{
              "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
               "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
             
             GridBoxItemSize->{
              "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, 
               "Rows" -> {{1.}}, "RowsIndexed" -> {}},
             GridBoxSpacings->{"Columns" -> {
                 Offset[0.27999999999999997`], {
                  Offset[0.84]}, 
                 Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, 
               "Rows" -> {
                 Offset[0.2], {
                  Offset[0.4]}, 
                 Offset[0.2]}, "RowsIndexed" -> {}},
             Selectable->True]}
          },
          
          GridBoxAlignment->{
           "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
            "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
          
          GridBoxItemSize->{
           "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, 
            "Rows" -> {{1.}}, "RowsIndexed" -> {}},
          GridBoxSpacings->{"Columns" -> {
              Offset[0.27999999999999997`], {
               Offset[0.35]}, 
              Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
              Offset[0.2], {
               Offset[0.4]}, 
              Offset[0.2]}, "RowsIndexed" -> {}}],
         "Piecewise",
         DeleteWithContents->True,
         Editable->False,
         SelectWithContents->True,
         Selectable->False,
         StripWrapperBoxes->True]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{
         SuperscriptBox["\[DoubleStruckI]", "d"], "\[InvisibleSpace]", "(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{
         RowBox[{"z", "(", "k", ")"}], "-", "1"}]], 
       SubsuperscriptBox["X", "0", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]], 
       RowBox[{
        UnderoverscriptBox["\[Product]", 
         RowBox[{"m", "=", "1"}], "d"], " ", 
        RowBox[{
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"2", 
             SubsuperscriptBox["\[Alpha]", "m", 
              RowBox[{"(", 
               RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], 
           RowBox[{"\[LeftCeiling]", 
            RowBox[{
             SubscriptBox["k", "m"], "/", "2"}], "\[RightCeiling]"}]]], 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"n", "=", "0"}], 
           RowBox[{"\[LeftFloor]", 
            RowBox[{
             SubscriptBox["k", "m"], "/", "2"}], "\[RightFloor]"}]], " ", 
          SuperscriptBox[
           RowBox[{
            SubsuperscriptBox["\[Mu]", 
             RowBox[{"n", " "}], 
             SubscriptBox["k", "m"]], "(", 
            FractionBox[
             SubsuperscriptBox["p", "m", 
              RowBox[{"2", "\[InvisibleSpace]"}]], 
             RowBox[{"2", 
              SubscriptBox["\[Alpha]", "m"]}]], ")"}], "n"]}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916199166273859*^9, 3.916199166935451*^9}, {
   3.916199214478784*^9, 3.9161992408569403`*^9}, {3.9161993189961576`*^9, 
   3.916199407887308*^9}, {3.916200764923046*^9, 3.916200785331841*^9}, {
   3.916200828933885*^9, 3.916200829202545*^9}, 3.9162034154655447`*^9, {
   3.916203467924334*^9, 3.916203481938622*^9}, {3.916204110022752*^9, 
   3.916204111293467*^9}},ExpressionUUID->"85eb7615-dab6-47b4-8b92-\
04bc567e1349"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "(", "k", ")"}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "4f1d417a-4b87-4ee5-b334-74ddbc5d64e2"],
 " is the number of odd partitions in ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "0db8da61-c70f-46cc-a120-06f0b50f6504"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Mu]", 
    RowBox[{"n", " "}], "k"], TraditionalForm]],
  CellChangeTimes->{{3.9161802823152857`*^9, 3.9161803026202517`*^9}, 
    3.916181004063675*^9},ExpressionUUID->
  "e2f7d201-1af9-4cfb-ab34-94e4d3f9bc48"],
 " is given by"
}], "ExpositoryText",
 CellChangeTimes->{{3.91618132984654*^9, 3.9161813369083652`*^9}, {
  3.916200722514887*^9, 3.91620075784982*^9}, {3.916200799215892*^9, 
  3.916200834023059*^9}},ExpressionUUID->"d358659f-f142-4758-90e5-\
858e88b45e4b"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["\[Mu]", 
       RowBox[{"n", " "}], 
       RowBox[{"(", "k", ")"}]], " ", "=", " ", 
      RowBox[{
       RowBox[{"\[LeftCeiling]", 
        RowBox[{"k", "/", "2"}], "\[RightCeiling]"}], 
       RowBox[{"(", " ", 
        RowBox[{
         SubsuperscriptBox["\[Mu]", 
          RowBox[{"n", " "}], 
          RowBox[{"(", 
           RowBox[{"k", "-", "2"}], ")"}]], " ", "-", 
         RowBox[{
          FractionBox["1", 
           RowBox[{
            RowBox[{"2", "\[InvisibleSpace]", "n"}], " ", "-", " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "k"]}]], 
          SubsuperscriptBox["\[Mu]", 
           RowBox[{"n", "-", "1"}], 
           RowBox[{"(", 
            RowBox[{"k", "-", "2"}], ")"}]]}]}], ")"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "n"], "\[InvisibleSpace]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          UnderoverscriptBox["\[Product]", 
           RowBox[{"j", "=", 
            RowBox[{"n", "+", "1"}]}], 
           RowBox[{"\[LeftFloor]", 
            RowBox[{"k", "/", "2"}], "\[RightFloor]"}]], 
          RowBox[{"2", "\[InvisibleSpace]", "j"}]}], " ", "-", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], "k"]}], ")"}], "\[VeryThinSpace]", 
       RowBox[{"(", GridBox[{
          {
           RowBox[{"\[LeftFloor]", 
            RowBox[{"k", "/", "2"}], "\[RightFloor]"}]},
          {"n"}
         },
         GridBoxAlignment->{"Columns" -> {Center}}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9161802823152857`*^9, 3.9161803026202517`*^9}, 
   3.916181004063675*^9, {3.9161995813258553`*^9, 3.9161995891986*^9}, {
   3.916199658659046*^9, 
   3.9161996849902143`*^9}},ExpressionUUID->"c1fe8505-1257-4229-b26a-\
e43eaf8359af"],

Cell[TextData[{
 "therefore we get a product of expansions in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["p", "m", 
      RowBox[{"2", "\[InvisibleSpace]"}]], "/", "2"}], 
    SubscriptBox["\[Alpha]", "m"]}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "4e4c9fcd-8632-4aed-82dd-2399eaf12e15"],
 " for each dimension"
}], "ExpositoryText",
 CellChangeTimes->{{3.916203428897107*^9, 
  3.916203452724352*^9}},ExpressionUUID->"75c5c492-4f92-4a35-82d9-\
f25fef996228"],

Cell[TextData[{
 "Next we\[CloseCurlyQuote]ll note that for any ",
 Cell[BoxData[
  FormBox[
   RowBox[{"s", "\[Element]", 
    RowBox[{"\[ScriptCapitalD]", "(", "k", ")"}]}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "404f91d3-cde5-4751-b044-cb2fbedfa530"],
 ", we can isolate the product of the form"
}], "ExpositoryText",
 CellChangeTimes->{{3.916204113870829*^9, 3.916204176647537*^9}, {
  3.916204241841331*^9, 
  3.9162042464061937`*^9}},ExpressionUUID->"38592375-db13-49aa-9ef3-\
def5bb2089cd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   UnderoverscriptBox["\[Product]", 
    RowBox[{"n", "=", "1"}], 
    SubscriptBox["k", "m"]], 
   RowBox[{
    SubsuperscriptBox["V", 
     SubscriptBox["b", "n"], 
     RowBox[{"(", 
      SubscriptBox["a", "n"], ")"}]], "\[InvisibleSpace]", 
    RowBox[{
     SubsuperscriptBox["L", "m", 
      RowBox[{"(", 
       RowBox[{"i", ",", "j"}], ")"}]], "\[Transpose]"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916204178151903*^9, 3.91620417882827*^9}, {
  3.9162042107585707`*^9, 
  3.916204237224998*^9}},ExpressionUUID->"a0978e51-fb69-46d1-89d8-\
5dbf59ffe81b"],

Cell[TextData[{
 "where we WLOG chose ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "61681a5e-606b-4757-9c7a-7fabc4d17726"],
 " to start at 1"
}], "ExpositoryText",
 CellChangeTimes->{{3.9162042485161858`*^9, 
  3.916204256705657*^9}},ExpressionUUID->"47b219eb-3d2f-4a51-9b06-\
56ab58268b91"],

Cell[TextData[{
 "And so we have ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftFloor]", 
    RowBox[{
     SubscriptBox["k", "m"], "/", "2"}], "\[RightFloor]"}], TraditionalForm]],
   "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "7781a98e-6337-4744-ab7e-2a2ffd1d4345"],
 " terms like "
}], "ExpositoryText",
 CellChangeTimes->{{3.916204296122284*^9, 3.916204369090995*^9}, 
   3.916204410572958*^9},ExpressionUUID->"40020753-9837-43b0-a5cb-\
aa784a5cddf0"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["V", 
       SubscriptBox["b", 
        SubscriptBox["n", "1"]], 
       RowBox[{"(", 
        SubscriptBox["a", 
         SubscriptBox["n", "1"]], ")"}]], "\[InvisibleSpace]", 
      RowBox[{
       SubsuperscriptBox["L", "m", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]], "\[Transpose]"}]}], ")"}], 
    RowBox[{"(", "\[InvisibleSpace]", 
     RowBox[{
      SubsuperscriptBox["V", 
       SubscriptBox["b", 
        SubscriptBox["n", "2"]], 
       RowBox[{"(", 
        SubscriptBox["a", 
         SubscriptBox["n", "2"]], ")"}]], "\[InvisibleSpace]", 
      RowBox[{
       SubsuperscriptBox["L", "m", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]], "\[Transpose]"}]}], ")"}]}], 
   RowBox[{"2", 
    SubsuperscriptBox["\[Alpha]", "m", 
     RowBox[{"(", 
      RowBox[{"i", ",", "j"}], ")"}]]}]], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916204305845368*^9, 3.916204306599296*^9}, {
  3.916204341738082*^9, 3.9162043887008963`*^9}, {3.9162044421080008`*^9, 
  3.916204445653236*^9}, {3.9162045060213957`*^9, 
  3.916204510348955*^9}},ExpressionUUID->"b670b6b0-7538-4d2d-9508-\
e2b9ed260093"],

Cell[TextData[{
 "and if ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "m"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "4494b41a-6f3c-40dc-9c31-1f763904cd8c"],
 " is odd, one additional term of the form"
}], "ExpositoryText",
 CellChangeTimes->{{3.916204413021635*^9, 
  3.916204428857031*^9}},ExpressionUUID->"c99baae9-6a63-43c4-b068-\
b52ae4ddfccb"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["V", 
       SubscriptBox["b", 
        SubscriptBox["n", "3"]], 
       SubscriptBox["a", 
        SubscriptBox["n", "3"]]], "\[InvisibleSpace]", 
      RowBox[{
       SubsuperscriptBox["L", "m", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]], "\[Transpose]"}]}], ")"}], 
    SubsuperscriptBox["p", "m", 
     RowBox[{"(", 
      RowBox[{"i", ",", "j"}], ")"}]]}], 
   RowBox[{"2", 
    SubsuperscriptBox["\[Alpha]", "m", 
     RowBox[{"(", 
      RowBox[{"i", ",", "j"}], ")"}]]}]], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916204430365176*^9, 
  3.916204468479704*^9}},ExpressionUUID->"55e5b24b-c0c5-40d0-8842-\
274987bc8a9a"],

Cell[TextData[{
 "and generically if we add up over all the appropriate ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "577efd10-2250-4791-979a-4ebdf002088e"],
 ", the first of these turns into things of the form"
}], "ExpositoryText",
 CellChangeTimes->{{3.9162044714346743`*^9, 
  3.9162045034290113`*^9}},ExpressionUUID->"15af38e6-fade-4af0-92f3-\
96aeeb44994e"],

Cell[BoxData[
 FormBox[
  SubscriptBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["V", 
      RowBox[{"(", 
       SubscriptBox["a", 
        SubscriptBox["n", "1"]], ")"}]], 
     SuperscriptBox["\[CapitalSigma]", 
      RowBox[{"(", 
       RowBox[{"i", ",", "j"}], ")"}]], 
     SuperscriptBox["V", 
      RowBox[{"(", 
       SubscriptBox["a", 
        SubscriptBox["n", "2"]], ")"}]]}], ")"}], 
   RowBox[{
    SubscriptBox["b", 
     SubscriptBox["n", "1"]], 
    SubscriptBox["b", 
     SubscriptBox["n", "2"]]}]], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9162045142832937`*^9, 
  3.916204543688243*^9}},ExpressionUUID->"06a9427f-b879-46b0-b2c8-\
57c9282f4ca4"],

Cell["and the latter becomes", "ExpositoryText",
 CellChangeTimes->{{3.916204545605051*^9, 
  3.916204548248928*^9}},ExpressionUUID->"180aa4e3-155e-46f1-8d98-\
a92f2b8b441d"],

Cell[BoxData[
 FormBox[
  SubscriptBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["V", 
      RowBox[{"(", 
       SubscriptBox["a", 
        SubscriptBox["n", "3"]], ")"}]], 
     SuperscriptBox["\[Rho]", 
      RowBox[{"(", 
       RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], 
   SubscriptBox["b", 
    SubscriptBox["n", "3"]]], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9162045551705647`*^9, 
  3.9162045838083553`*^9}},ExpressionUUID->"b9cb90ad-50e5-4cc5-99a3-\
99ad96554871"],

Cell[TextData[{
 "We might worry that we aren\[CloseCurlyQuote]t adding over the correct set \
of ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "3cfc8300-bda9-43e4-ab48-ed52e5feae97"],
 ", but this fear is alleviated by considering that the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", "n"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "6ff348eb-8cc9-4a37-969f-b21c856c0e22"],
 " weight the permutations appropriately once we consider the sum over ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "3da4c29b-fc94-4b1e-a6ee-89c3e1d335f5"]
}], "ExpositoryText",
 CellChangeTimes->{{3.916204587646756*^9, 
  3.916204686211253*^9}},ExpressionUUID->"d0e53cbf-62d5-4450-9f8d-\
9009b0b26a34"],

Cell["\<\
This is tedious to show, but it becomes clear at least for the no momentum \
case when looking back at that 4th order integration from the Watson term\
\>", "ExpositoryText",
 CellChangeTimes->{{3.916204715371006*^9, 
  3.9162047370342493`*^9}},ExpressionUUID->"b19abd37-252e-46ba-a7c3-\
7dadab155c36"],

Cell[TextData[{
 "The other way to see this is to note that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", "0"], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"784480ac-d0b9-4751-bb37-4c1227ce93e6"],
 " always provides the number of partitions of the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "m"], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"a691c571-16c7-4290-8be6-2995ee20432f"],
 " elements into pairs"
}], "ExpositoryText",
 CellChangeTimes->{{3.916204762955277*^9, 
  3.916204803836918*^9}},ExpressionUUID->"b480e061-c7f3-4559-93a7-\
45d9a5be5471"],

Cell[CellGroupData[{

Cell["General Integral Form", "Subsubsubsubsection",
 CellChangeTimes->{{3.916204833571121*^9, 
  3.916204836172182*^9}},ExpressionUUID->"32f18df5-9e32-48a9-969c-\
759a2119c7c9"],

Cell[TextData[{
 "Finally, the sign of the contribution will clearly depend on how many \
momentum terms we have, e.g. in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "2"}], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"dcbcaee6-0086-4809-9653-6b530e5d6c52"],
 " case we had"
}], "ExpositoryText",
 CellChangeTimes->{{3.916204822537964*^9, 
  3.91620486642629*^9}},ExpressionUUID->"92a4beed-c052-4e92-9fd6-\
ed742c5b39f0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["V", 
       RowBox[{"(", "1", ")"}]], "\[InvisibleSpace]", 
      SuperscriptBox["\[CapitalSigma]", 
       RowBox[{"(", 
        RowBox[{"i", ",", "j"}], ")"}]], "\[InvisibleSpace]", 
      SuperscriptBox["V", 
       RowBox[{"(", "2", ")"}]]}], ")"}], 
    RowBox[{"n", "\[InvisibleSpace]", "m"}]], " ", "-", " ", 
   RowBox[{
    SubscriptBox[
     RowBox[{"(", "\[InvisibleSpace]", 
      RowBox[{
       SuperscriptBox["V", 
        RowBox[{"(", "1", ")"}]], "\[InvisibleSpace]", 
       SuperscriptBox["\[Rho]", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], "n"], 
    SubscriptBox[
     RowBox[{"(", "\[InvisibleSpace]", 
      RowBox[{
       SuperscriptBox["V", 
        RowBox[{"(", "2", ")"}]], "\[InvisibleSpace]", 
       SuperscriptBox["\[Rho]", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], "m"]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916204858977952*^9, 
  3.916204859546041*^9}},ExpressionUUID->"02bd8ef9-da4e-445a-ba5e-\
7d66548d2531"],

Cell[TextData[{
 "and similarly in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "3"}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "77266041-179c-4cf1-b941-c1dbd7281e21"],
 " case by this argument we get"
}], "ExpositoryText",
