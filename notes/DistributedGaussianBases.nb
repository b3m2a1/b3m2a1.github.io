   TemplateBox[{
     SubscriptBox["\[Phi]", 
      RowBox[{"i", " \[VeryThinSpace]"}]], 
     RowBox[{" ", "f"}]},
    "BraKet"], " ", "=", " ", 
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", "k"], "\[VeryThinSpace]", 
     RowBox[{
      SubscriptBox["c", "k"], "\[InvisibleSpace]\[VeryThinSpace]", 
      TemplateBox[{
        SubscriptBox["\[Phi]", 
         RowBox[{"i", " \[VeryThinSpace]"}]], 
