  3.883941076829712*^9, 3.883941264719776*^9}, {3.883947610402853*^9, 
  3.883947708571507*^9}, {3.8839477439195127`*^9, 3.8839478239837427`*^9}, {
  3.883948979837261*^9, 3.883948999396782*^9}, {3.883949045078515*^9, 
  3.883949112840579*^9}, {3.883951456580675*^9, 3.883951458923381*^9}, {
  3.883959218252227*^9, 
  3.883959233190909*^9}},ExpressionUUID->"4c8edffb-93e3-42ff-bc38-\
e73dcf3f8f33"],

Cell["and now we\[CloseCurlyQuote]re forced to show that", "ExpositoryText",
 CellChangeTimes->{{3.883947773383828*^9, 
  3.8839477780344343`*^9}},ExpressionUUID->"45dd9ebd-777b-4204-b862-\
ee5a6d3fa5cd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderoverscriptBox["\[Product]", 
     RowBox[{"l", "=", "1"}], 
     RowBox[{
      SubscriptBox["p", "k"], "/", "2"}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", "\[InvisibleSpace]", "l"}], "-", "1"}], ")"}]}], " ", "=", 
   " ", 
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["p", "k"], "/", "2"}], "+", "1"}], ",", " ", 
       SubscriptBox["p", "k"]}], ")"}], "!"}], 
    SuperscriptBox["2", 
     RowBox[{
      SubscriptBox["p", "k"], "/", "2"}]]]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.883947831503868*^9, 3.8839478616277847`*^9}, 
   3.8839491205482273`*^9, {3.883952707036891*^9, 3.8839527104304*^9}, {
   3.883956071844067*^9, 3.883956072499063*^9}, {3.8839561987437143`*^9, 
   3.883956198951892*^9}, {3.8839591767715*^9, 
   3.883959177105241*^9}},ExpressionUUID->"4a628a09-28b7-4071-bc31-\
9b29f153d480"],

Cell[TextData[{
 "which we\[CloseCurlyQuote]ll do by reverting to our ",
 StyleBox["original",
  FontSlant->"Italic"],
 " expression"
}], "ExpositoryText",
 CellChangeTimes->{{3.883956081364812*^9, 
  3.883956090544635*^9}},ExpressionUUID->"a694ed58-3a58-4d96-85a6-\
d89744c1a6d5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["p", "k"], "/", "2"}], "+", "1"}], ",", " ", 
       SubscriptBox["p", "k"]}], ")"}], "!"}], 
    SuperscriptBox["2", 
     RowBox[{
      SubscriptBox["p", "k"], "/", "2"}]]], " ", "=", " ", 
   FractionBox[
    RowBox[{
     SubscriptBox["p", "k"], "!"}], 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["p", "k"], "/", "2"}], ")"}], "!"}], 
     SuperscriptBox["2", 
      RowBox[{
       SubscriptBox["p", "k"], "/", "2"}]]}]]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.883956095552535*^9, 3.883956159174864*^9}, {
  3.883956213722115*^9, 3.883956232944056*^9}, {3.883956283770351*^9, 
  3.883956296555567*^9}, {3.8839563370646467`*^9, 3.883956337289288*^9}, {
  3.88395917948136*^9, 
  3.883959181655526*^9}},ExpressionUUID->"84a3bf43-08ba-4523-a127-\
9edc01c9364d"],

Cell[TextData[{
 "and we\[CloseCurlyQuote]ll note that even numbers up to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "k"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "14e30ff2-f07e-46d8-937d-fd91628d8fbc"],
 " can be generated by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Product]", 
     RowBox[{"l", "=", "1"}], 
     RowBox[{
      SubscriptBox["p", "k"], "/", "2"}]], 
    RowBox[{"(", 
     RowBox[{"2", "\[InvisibleSpace]", "l"}], ")"}]}], TraditionalForm]],
  CellChangeTimes->{{3.883947831503868*^9, 3.8839478616277847`*^9}, 
    3.8839491205482273`*^9, {3.883952707036891*^9, 3.8839527104304*^9}, {
    3.883956071844067*^9, 3.883956072499063*^9}, {3.8839561987437143`*^9, 
    3.883956198951892*^9}},ExpressionUUID->
  "f28b3ee4-feaa-46f4-ab01-c2430d3db368"],
 " and the odds are generated by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Product]", 
     RowBox[{"l", "=", "1"}], 
     RowBox[{
      SubscriptBox["p", "k"], "/", "2"}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", "\[InvisibleSpace]", "l"}], "-", "1"}], ")"}]}], 
   TraditionalForm]],
  CellChangeTimes->{{3.883947831503868*^9, 3.8839478616277847`*^9}, 
    3.8839491205482273`*^9, {3.883952707036891*^9, 3.8839527104304*^9}, {
    3.883956071844067*^9, 3.883956072499063*^9}, {3.8839561987437143`*^9, 
    3.883956198951892*^9}},ExpressionUUID->
  "40e0b7a2-76c2-4d73-9c9d-68c9bffa5ac1"],
 ", giving us"
}], "ExpositoryText",
 CellChangeTimes->{{3.8839562979532337`*^9, 
  3.8839563305093813`*^9}},ExpressionUUID->"6080cbca-9803-45f9-8ea1-\
732ab3e966a8"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      FractionBox[
       RowBox[{
        SubscriptBox["p", "k"], "!"}], 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["p", "k"], "/", "2"}], ")"}], "!"}], 
        SuperscriptBox["2", 
         RowBox[{
          RowBox[{
           SubscriptBox["p", "k"], "/", "2"}], "-", "1"}]]}]], "=", 
      FractionBox[
       RowBox[{
        UnderoverscriptBox["\[Product]", 
         RowBox[{"l", "=", "1"}], 
         RowBox[{
          SubscriptBox["p", "k"], "/", "2"}]], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "\[InvisibleSpace]", "l"}], "-", "1"}], ")"}], 
         RowBox[{
          UnderoverscriptBox["\[Product]", 
           RowBox[{"l", "=", "1"}], 
           RowBox[{
            SubscriptBox["p", "k"], "/", "2"}]], 
          RowBox[{"(", 
           RowBox[{"2", "\[InvisibleSpace]", "l"}], ")"}]}]}]}], 
       RowBox[{
        SuperscriptBox["2", 
         RowBox[{
          SubscriptBox["p", "k"], "/", "2"}]], " ", 
        FormBox[
         RowBox[{
          UnderoverscriptBox["\[Product]", 
           RowBox[{"l", "=", "1"}], 
           RowBox[{
            SubscriptBox["p", "k"], "/", "2"}]], "l"}],
         TraditionalForm]}]]}]},
    {
     RowBox[{"=", 
      RowBox[{
       FractionBox["1", 
        SuperscriptBox["2", 
         RowBox[{
          SubscriptBox["p", "k"], "/", "2"}]]], 
       RowBox[{
        UnderoverscriptBox["\[Product]", 
         RowBox[{"l", "=", "1"}], 
         RowBox[{
          SubscriptBox["p", "k"], "/", "2"}]], 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "\[InvisibleSpace]", "l"}], "-", "1"}], ")"}], 
          RowBox[{"(", 
           RowBox[{"2", "l"}], ")"}]}], "l"]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       FractionBox[
        SuperscriptBox["2", 
         RowBox[{
          SubscriptBox["p", "k"], "/", "2"}]], 
        SuperscriptBox["2", 
         RowBox[{
          SubscriptBox["p", "k"], "/", "2"}]]], " ", 
       RowBox[{
        UnderoverscriptBox["\[Product]", 
         RowBox[{"l", "=", "1"}], 
         RowBox[{
          SubscriptBox["p", "k"], "/", "2"}]], 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "\[InvisibleSpace]", "l"}], "-", "1"}], ")"}], 
          RowBox[{"(", 
           RowBox[{"2", "l"}], ")"}]}], 
         RowBox[{"2", "l"}]]}]}]}]},
    {
     RowBox[{"=", "  ", 
      RowBox[{
       UnderoverscriptBox["\[Product]", 
        RowBox[{"l", "=", "1"}], 
        RowBox[{
         SubscriptBox["p", "k"], "/", "2"}]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "\[InvisibleSpace]", "l"}], "-", "1"}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.883956314124596*^9, 3.883956473304676*^9}, {
  3.883959186564501*^9, 
  3.883959192854802*^9}},ExpressionUUID->"dd124656-14c2-4cec-964c-\
93ed0d6ffa54"],

Cell["\<\
and so the two expressions are equivalent when evaluated with local expansions\
\>", "ExpositoryText",
 CellChangeTimes->{{3.883959195639165*^9, 
  3.883959213878571*^9}},ExpressionUUID->"31c50031-087a-4870-9358-\
ddb99ea98918"]
}, Closed]]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Integration of the Kinetic Energy (Non-Rotated)", "Section",
 CellChangeTimes->{{3.883926828712255*^9, 
  3.883926841670969*^9}},ExpressionUUID->"ea1d3211-607d-4300-bdf9-\
bbd03ca71c0f"],

Cell[TextData[{
 "We start with our multivariate Gaussian basis function centered around a \
point ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Xi]", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "c668defc-82fe-4463-b61f-3e63badb4ab3"]
}], "ExpositoryText",
 CellChangeTimes->{{3.883124356730083*^9, 3.8831243942580442`*^9}, {
  3.8831244648190002`*^9, 
  3.883124467853714*^9}},ExpressionUUID->"10eac186-6f9a-4dca-9a50-\
ecf1648eb5d6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CurlyPhi]", "i"], "(", 
    StyleBox["x",
     FontWeight->"Bold"], ")"}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Product]", 
     RowBox[{"j", "\[VeryThinSpace]", "=", "\[VeryThinSpace]", "1"}], 
     RowBox[{"3", "\[InvisibleSpace]", "N"}]], " ", 
    RowBox[{"\[Phi]", "(", 
     RowBox[{
      RowBox[{
       SubscriptBox["x", 
        RowBox[{"j", ","}]], 
       SubsuperscriptBox["\[Xi]", "j", 
        RowBox[{"(", "i", ")"}]]}], ",", " ", 
      SubscriptBox["\[Alpha]", "i"]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.883123758929969*^9, 3.883123814163766*^9}, {
  3.8831238444687757`*^9, 3.883123896321591*^9}, {3.88312614649897*^9, 
  3.8831261524609327`*^9}},ExpressionUUID->"d1255778-e9de-4f9c-99cd-\
cb5cf42859a2"],

Cell["the integral we then want to evaluate is", "ExpositoryText",
 CellChangeTimes->{{3.883124401756212*^9, 
  3.883124410627383*^9}},ExpressionUUID->"67616445-b9c7-4dc3-a2a9-\
352f8152f075"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["T", 
       RowBox[{"i", "\[InvisibleSpace]", "j"}]], " ", "=", " ", 
      RowBox[{"-", 
       RowBox[{
        SubscriptBox["\[Integral]", 
         SuperscriptBox["\[DoubleStruckCapitalR]", "N"]], 
        RowBox[{
         RowBox[{
          SubscriptBox["\[CurlyPhi]", "i"], "(", 
          StyleBox["x",
           FontWeight->"Bold"], ")"}], 
         RowBox[{
          FractionBox[
           SuperscriptBox["\[Del]", "2"], 
           RowBox[{
            StyleBox["2",
             FontWeight->"Plain"], 
            StyleBox["\[InvisibleSpace]",
             FontWeight->"Bold"], 
            StyleBox["m",
             FontWeight->"Bold"]}]], 
          RowBox[{
           SubscriptBox["\[CurlyPhi]", "j"], "(", 
           StyleBox["x",
            FontWeight->"Bold"], ")"}]}], 
         RowBox[{"\[DifferentialD]", 
          StyleBox["x",
           FontWeight->"Bold"]}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{"-", 
       RowBox[{
        UnderscriptBox["\[Sum]", "k"], "\[VeryThinSpace]", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"2", "\[InvisibleSpace]", 
           SubscriptBox["m", "k"]}]], 
         RowBox[{
          SubscriptBox["\[Integral]", 
           SuperscriptBox["\[DoubleStruckCapitalR]", "N"]], 
          RowBox[{
           RowBox[{
            SubscriptBox["\[CurlyPhi]", "i"], "(", 
            StyleBox["x",
             FontWeight->"Bold"], ")"}], 
           RowBox[{
            FractionBox["\[PartialD]", 
             RowBox[{"\[PartialD]", 
              SubscriptBox[
               RowBox[{"x", "\[VeryThinSpace]"}], "k"]}]], 
            RowBox[{
             SubscriptBox["\[CurlyPhi]", "j"], "(", 
             StyleBox["x",
              FontWeight->"Bold"], ")"}]}], 
           RowBox[{"\[DifferentialD]", 
            StyleBox["x",
             FontWeight->"Bold"]}]}]}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8831244119780197`*^9, 3.8831244966482286`*^9}, {
  3.883926854009248*^9, 3.883926891229641*^9}, {3.883926966726736*^9, 
  3.88392703513238*^9}, {3.8839272150658083`*^9, 
  3.883927225332082*^9}},ExpressionUUID->"25879de3-6984-4a97-bdb2-\
0acd2cbe2adf"],

Cell["where we note that ", "ExpositoryText",
 CellChangeTimes->{{3.883927050109358*^9, 
  3.883927055768528*^9}},ExpressionUUID->"f56c602f-0160-4a86-b65b-\
e7a3f63ff8cf"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox["\[PartialD]", 
     RowBox[{"\[PartialD]", 
      SubscriptBox[
       RowBox[{"x", "\[VeryThinSpace]"}], "k"]}]], 
    RowBox[{
     SubscriptBox["\[CurlyPhi]", "j"], "(", 
     StyleBox["x",
      FontWeight->"Bold"], ")"}]}], " ", "=", " ", 
   RowBox[{"2", 
    RowBox[{
     SubsuperscriptBox["\[Alpha]", "k", 
      RowBox[{"(", "j", ")"}]], "(", 
     RowBox[{
      RowBox[{"2", 
       SuperscriptBox[
        RowBox[{
         SubsuperscriptBox["\[Alpha]", "k", 
          RowBox[{"(", "j", ")"}]], "(", 
         RowBox[{
          SubscriptBox["x", "k"], "-", 
          SubsuperscriptBox["\[Xi]", "k", 
           RowBox[{"(", "j", ")"}]]}], ")"}], "2"]}], "-", "1"}], ")"}], " ", 
    
    RowBox[{
     SubscriptBox["\[CurlyPhi]", "j"], "(", 
     StyleBox["x",
      FontWeight->"Bold"], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.883927060870502*^9, 3.883927117667852*^9}, {
  3.883927156079471*^9, 3.883927156660769*^9}, {3.883927229106721*^9, 
  3.883927283922068*^9}, {3.8840090598007593`*^9, 
  3.884009060809642*^9}},ExpressionUUID->"fc1dd48a-0cb4-464d-987d-\
ef6825cc569d"],

Cell["so we have", "ExpositoryText",
 CellChangeTimes->{{3.8839273205593224`*^9, 
  3.8839273227489147`*^9}},ExpressionUUID->"1456dab0-8f6a-4c2b-8f13-\
88a3e170633a"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox["\[Xi]", 
       RowBox[{"(", 
        RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], " ", "=", " ", 
      FractionBox[
       RowBox[{
        RowBox[{
         SuperscriptBox["\[Alpha]", 
          RowBox[{"(", "i", ")"}]], 
         SubsuperscriptBox["\[Xi]", "k", 
          RowBox[{"(", "i", ")"}]]}], "+", 
        RowBox[{
         SuperscriptBox["\[Alpha]", 
          RowBox[{"(", "j", ")"}]], 
         SubsuperscriptBox["\[Xi]", "k", 
          RowBox[{"(", "j", ")"}]]}]}], 
       RowBox[{
        SuperscriptBox["\[Alpha]", 
         RowBox[{"(", "i", ")"}]], "+", 
        SuperscriptBox["\[Alpha]", 
         RowBox[{"(", "j", ")"}]]}]]}]},
    {
     RowBox[{
      SuperscriptBox["\[Alpha]", 
       RowBox[{"(", 
        RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], " ", "=", " ", 
      RowBox[{
       SuperscriptBox["\[Alpha]", 
        RowBox[{"(", "i", ")"}]], "+", 
       SuperscriptBox["\[Alpha]", 
        RowBox[{"(", "j", ")"}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8839303735319*^9, 3.883930671158495*^9}, {
   3.8839394809077463`*^9, 3.8839394820770187`*^9}, 3.8839423374341593`*^9, 
   3.883943492620051*^9, 3.883945395209621*^9, {3.883958581416401*^9, 
   3.8839585819920273`*^9}, {3.883998452493495*^9, 
   3.883998453117783*^9}},ExpressionUUID->"d77f441d-a3ba-443a-ae69-\
1cf7e433b277"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["T", 
       RowBox[{"i", "\[InvisibleSpace]", "j"}]], " ", "=", " ", 
      RowBox[{"-", 
       RowBox[{
        SubscriptBox["\[Integral]", 
         SuperscriptBox["\[DoubleStruckCapitalR]", "N"]], 
        RowBox[{
         RowBox[{
          SubscriptBox["\[CurlyPhi]", "i"], "(", 
          StyleBox["x",
           FontWeight->"Bold"], ")"}], 
         RowBox[{
          FractionBox[
           SuperscriptBox["\[Del]", "2"], 
           RowBox[{
            StyleBox["2",
             FontWeight->"Plain"], 
            StyleBox["\[InvisibleSpace]",
             FontWeight->"Bold"], 
            StyleBox["m",
             FontWeight->"Bold"]}]], 
          RowBox[{
           SubscriptBox["\[CurlyPhi]", "j"], "(", 
           StyleBox["x",
            FontWeight->"Bold"], ")"}]}], 
         RowBox[{"\[DifferentialD]", 
          StyleBox["x",
           FontWeight->"Bold"]}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{"-", 
       RowBox[{
        UnderscriptBox["\[Sum]", "k"], "\[VeryThinSpace]", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"2", "\[InvisibleSpace]", 
           SubscriptBox["m", "k"]}]], 
         RowBox[{
          SubscriptBox["\[Integral]", 
           SuperscriptBox["\[DoubleStruckCapitalR]", "N"]], 
          RowBox[{"2", 
           RowBox[{
            SubsuperscriptBox["\[Alpha]", "k", 
             RowBox[{"(", "j", ")"}]], "(", 
            RowBox[{
             RowBox[{"2", 
              SuperscriptBox[
               RowBox[{
                SubsuperscriptBox["\[Alpha]", "k", 
                 RowBox[{"(", "j", ")"}]], "(", 
                RowBox[{
                 SubscriptBox["x", "k"], "-", 
                 SubsuperscriptBox["\[Xi]", "k", 
                  RowBox[{"(", "j", ")"}]]}], ")"}], "2"]}], "-", "1"}], 
            ")"}], 
           RowBox[{
            SubscriptBox["\[Phi]", "i"], "(", 
            StyleBox["x",
             FontWeight->"Bold"], ")"}], 
           RowBox[{
            SubscriptBox["\[Phi]", "j"], "(", 
            StyleBox["x",
             FontWeight->"Bold"], ")"}], 
           RowBox[{"\[DifferentialD]", 
            StyleBox["x",
             FontWeight->"Bold"]}]}]}]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderscriptBox["\[Sum]", "k"], "\[VeryThinSpace]", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"2", "\[InvisibleSpace]", 
          SubscriptBox["m", "k"]}]], 
        SuperscriptBox["W", 
         RowBox[{"(", 
          RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], 
        "\[InvisibleSpace]", 
        RowBox[{
         SubscriptBox["\[Integral]", 
          SuperscriptBox["\[DoubleStruckCapitalR]", "N"]], 
         RowBox[{"2", 
          RowBox[{
           SubsuperscriptBox["\[Alpha]", "k", 
            RowBox[{"(", "j", ")"}]], "(", 
           RowBox[{"1", "-", 
            RowBox[{"2", 
             SuperscriptBox[
              RowBox[{
               SubsuperscriptBox["\[Alpha]", "k", 
                RowBox[{"(", "j", ")"}]], "(", 
               RowBox[{
                SubscriptBox["x", "k"], "-", 
                SubsuperscriptBox["\[Xi]", "k", 
                 RowBox[{"(", "j", ")"}]]}], ")"}], "2"]}]}], ")"}], 
          RowBox[{
           SuperscriptBox["\[Phi]", 
            RowBox[{"(", 
             RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], "(", 
           StyleBox["x",
            FontWeight->"Bold"], ")"}], 
          RowBox[{"\[DifferentialD]", 
           StyleBox["x",
            FontWeight->"Bold"]}]}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8831244119780197`*^9, 3.8831244966482286`*^9}, {
  3.883926854009248*^9, 3.883926891229641*^9}, {3.883926966726736*^9, 
  3.88392703513238*^9}, {3.8839272150658083`*^9, 3.883927225332082*^9}, {
  3.883927333760786*^9, 3.883927394641398*^9}, {3.8839980645317*^9, 
  3.883998067078883*^9}, {3.8839981039675417`*^9, 3.883998121979785*^9}, {
  3.883998409640077*^9, 3.8839984100536823`*^9}, {3.883998457468779*^9, 
  3.883998503854041*^9}, {3.8839985700260963`*^9, 3.883998634284836*^9}, {
  3.8840010890199633`*^9, 3.884001148927312*^9}, {3.884001184958845*^9, 
  3.8840012061079683`*^9}, {3.8840013000402393`*^9, 3.884001305341013*^9}, {
  3.884001446258325*^9, 3.884001455414197*^9}, {3.884007212906391*^9, 
  3.884007217587184*^9}, {3.884009065977482*^9, 3.884009067714158*^9}, {
  3.886521857239174*^9, 
  3.886521876244686*^9}},ExpressionUUID->"193686ca-457c-43b5-b384-\
0cdf2ab2a51f"],

Cell[CellGroupData[{

Cell["Shifted Approach", "Subsubsection",
 CellChangeTimes->{{3.886522910088149*^9, 
  3.886522915068404*^9}},ExpressionUUID->"c34b3408-2fd6-4d19-bb1b-\
a2d50b4b8ff2"],

Cell[TextData[{
 "We will now introduce the shift ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Chi]", 
     RowBox[{"(", 
      RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], " ", "=", " ", 
    RowBox[{"x", " ", "\[Minus]", " ", 
     SuperscriptBox["\[Xi]", 
