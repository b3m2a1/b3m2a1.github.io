   3.8839584085461607`*^9}},ExpressionUUID->"67440343-967e-4436-8ff7-\
35b0211c9a4e"],

Cell["and then for even order terms we have", "ExpositoryText",
 CellChangeTimes->{{3.883928083484928*^9, 
  3.883928102170738*^9}},ExpressionUUID->"f790c89b-27e1-42fd-9f68-\
01d8dcaaadf2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[CapitalGamma]", 
    RowBox[{"(", 
     FractionBox[
      RowBox[{
       SubscriptBox["p", "k"], "+", "1"}], "2"], ")"}]}], " ", "=", " ", 
   RowBox[{
    FractionBox[
     SqrtBox["\[Pi]"], 
     SuperscriptBox["2", 
      RowBox[{
       SubscriptBox["p", "k"], "/", "2"}]]], "\[VeryThinSpace]", 
    RowBox[{
     UnderoverscriptBox["\[Product]", 
      RowBox[{"m", "=", "1"}], 
      RowBox[{
       SubscriptBox["p", "k"], "/", "2"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "\[InvisibleSpace]", "m"}], "-", "1"}], ")"}], " "}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.883928107170649*^9, 3.8839281098228292`*^9}, {
  3.883928142402844*^9, 3.883928366633319*^9}, {3.883928407573285*^9, 
  3.883928444929348*^9}, {3.883928509565864*^9, 3.88392851485297*^9}, {
  3.8839285977239523`*^9, 
  3.883928607911797*^9}},ExpressionUUID->"9a3f1f15-3462-499d-8101-\
6f20613aa769"],

Cell[TextData[{
 "giving us, for even ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "k"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "2eb22da6-c284-4513-b3ff-7362884cd362"],
 ","
}], "ExpositoryText",
 CellChangeTimes->{{3.883928713875325*^9, 
  3.8839287259063683`*^9}},ExpressionUUID->"5c0f4581-ef9f-435c-93b1-\
59be6d78aa2c"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"\[Integral]", 
       RowBox[{
        RowBox[{"\[Phi]", "(", 
         RowBox[{
          RowBox[{
           SubscriptBox["x", 
            RowBox[{"k", ","}]], "0"}], ",", " ", "\[Alpha]"}], ")"}], 
        SuperscriptBox[
         SubscriptBox["x", 
          RowBox[{"\[VeryThinSpace]", "k"}]], 
         SubscriptBox["p", "k"]]}]}], " ", "=", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{"2", 
           SuperscriptBox["\[Alpha]", 
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", 
                SubscriptBox["p", "k"]}], "+", "1"}], ")"}]}]]}], "\[Pi]"], 
         ")"}], 
        RowBox[{"1", "/", "4"}]], 
       FractionBox[
        SqrtBox["\[Pi]"], 
        SuperscriptBox["2", 
         RowBox[{
          SubscriptBox["p", "k"], "/", "2"}]]], 
       RowBox[{
        UnderoverscriptBox["\[Product]", 
         RowBox[{"m", "=", "1"}], 
         RowBox[{
          SubscriptBox["p", "k"], "/", "2"}]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "\[InvisibleSpace]", "m"}], "-", "1"}], ")"}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       FractionBox["1", 
        SqrtBox[
         RowBox[{
          SuperscriptBox["2", 
           RowBox[{
            SubscriptBox["p", "k"], "/", "2"}]], 
          SuperscriptBox["\[Alpha]", 
           RowBox[{
            SubscriptBox["p", "k"], "/", "2"}]]}]]], 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{"2", "\[Pi]", " "}], "\[Alpha]"], ")"}], 
        RowBox[{"1", "/", "4"}]], 
       RowBox[{
        UnderoverscriptBox["\[Product]", 
         RowBox[{"m", "=", "1"}], 
         RowBox[{
          SubscriptBox["p", "k"], "/", "2"}]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "\[InvisibleSpace]", "m"}], "-", "1"}], ")"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.883928727750029*^9, 3.8839287465429897`*^9}, {
   3.8839287776397038`*^9, 3.883928837325186*^9}, 3.8839299050383673`*^9, {
   3.883954433819108*^9, 3.883954509580975*^9}, {3.8839547029397297`*^9, 
