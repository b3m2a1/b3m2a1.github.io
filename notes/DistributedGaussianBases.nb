4ead1c6a5f07"],

Cell[TextData[{
 "Can we find a basis for the space of Cartesian displacement coordinates \
that lead to a change in an internal coordinate ",
 Cell[BoxData[
  FormBox["\[Tau]", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "ac6aff96-1977-42b2-b510-d88c44c073a5"],
 " that lead to the minimum possible change in some alternate space of \
coordinates ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "06b954e9-ff44-44f7-bd33-788c88dfd38f"],
 "?"
}], "ExpositoryText",
 InitializationCell->True,
 CellChangeTimes->{{3.918581118712182*^9, 
  3.918581216283492*^9}},ExpressionUUID->"b9ca839d-e550-449c-bb0f-\
24ad2839dcc3"],

Cell[TextData[{
 "I can find ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "\[Tau]"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "981ffac4-efef-4750-b8d3-4487e464b971"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "Q"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "e0a9c727-f1bf-4fa1-8552-09c4b7013604"],
 " where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "\[Tau]"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "3d154205-e153-44a1-990d-f58c2941c4af"],
 " is the basis for \[Tau] and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "Q"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "6060390b-1eb1-4c31-a9ea-c6e45e5eaca9"],
 " is the complement to the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "Q"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "7752c402-59ca-4da4-954b-cc4d2b05ff99"],
 ", the basis for ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "61c50dd2-8c4e-48d1-87cd-256e60deeace"],
 ", then in principle I can then use least squares to find a way to best \
describe ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "\[Tau]"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "8f647537-3130-44f3-939a-b90382e2ca84"],
 " in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "Q"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "c56d60cc-344f-4548-83ac-a5ef5014d2ef"],
 " if I need it to be the case that ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "15231984-21de-40be-81e6-73a11d80f5c6"],
 " not change ",
 "or I can use least squares to describe ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "Q"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "04da62a0-b4ef-4b5c-9965-65092d00fea1"],
 " in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "\[Tau]"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "d760d6ff-df43-455f-8255-ccbbde9303df"]
}], "ExpositoryText",
 CellChangeTimes->{{3.9185813880570793`*^9, 3.918581549460297*^9}, {
  3.9185816421926117`*^9, 
  3.918581645865305*^9}},ExpressionUUID->"6e01068d-3921-49ab-9b86-\
8365105a27f5"],

Cell[TextData[{
 "Generally, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "\[Tau]"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "16c93212-8b1b-4451-8eaf-878d352c81d1"],
 " is likely a lower-dimensional space than ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "Q"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "1901bf00-bf29-4503-b6fd-9d89d66c07f8"],
 ", and so there is no pseudoinverse-based transformation that maps it \
cleanly onto all of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "Q"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "8d8763b7-d308-4063-8060-4e937e389f78"],
 "..."
}], "ExpositoryText",
 CellChangeTimes->{{3.918581778845561*^9, 3.918581853196608*^9}, {
  3.918581930583786*^9, 
  3.9185819468051023`*^9}},ExpressionUUID->"085c0a75-caa2-4073-be8e-\
f3b5ee9ae8ed"],

Cell[CellGroupData[{

Cell["Maximally Linearized Modes", "Subsubsection",
 CellChangeTimes->{{3.9170284022458677`*^9, 
  3.917028409638486*^9}},ExpressionUUID->"dfa78771-da2d-439f-b6a4-\
5149cc38e4f8"],

Cell["\<\
For ease of use, we would like to be able to decompose our normal modes into \
versions of themselves that look the most like a local stretch or bend to be \
able to fit potential contributions. As we can do this via a sequence of \
linear transformations, we can quickly get a \
\[OpenCurlyDoubleQuote]linearized\[CloseCurlyDoubleQuote] internal coordinate \
representation\
\>", "ExpositoryText",
 CellChangeTimes->{{3.91695577537635*^9, 3.916955793714424*^9}, {
  3.916956272086083*^9, 3.916956305382319*^9}, {3.916985224828211*^9, 
  3.916985277071269*^9}},ExpressionUUID->"dbff424f-fa38-4d59-b7d8-\
dbd7a59f7bdd"],

Cell[TextData[{
 "Letting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Q", "r"], "(", "q", ")"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "fbe2d33f-2728-4b36-9f58-7fb26ee8720a"],
 " be the linear transformation that takes ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "61e9ef4e-6888-413f-8bc9-c6d07c235f20"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", "X"], "\[InvisibleSpace]", "r"}], 
   TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "f16db2a8-7c7b-46fc-8164-683bf95cc457"],
 ", we can then write"
}], "ExpositoryText",
 CellChangeTimes->{{3.916985278801814*^9, 3.91698532683202*^9}, {
  3.91698540408397*^9, 
  3.916985462448031*^9}},ExpressionUUID->"390f641a-761e-4557-9fe1-\
c5af019066b6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["r", "~"], "(", "q", ")"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     SubscriptBox["Q", "r"], "(", "q", ")"}], "q"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916985467266345*^9, 3.916985467289586*^9}, {
  3.916985577860612*^9, 
  3.91698560008594*^9}},ExpressionUUID->"3676eaf8-a9ed-4e85-bb9f-\
d2ff354a227d"],

Cell["and then we just have linear transformations so, e.g.,", \
"ExpositoryText",
 CellChangeTimes->{{3.916985685244349*^9, 3.9169856966592903`*^9}, {
  3.916985799588516*^9, 
  3.916985839478826*^9}},ExpressionUUID->"9194c4d1-32e1-4cff-9131-\
bd820a2a0b4a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", "r"], 
    RowBox[{"V", "(", "q", ")"}]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     SubscriptBox["Q", "r"], "(", "q", ")"}], 
    RowBox[{
     SubscriptBox["\[Del]", "q"], "V"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916985699519827*^9, 3.916985709719624*^9}, {
  3.916985787840294*^9, 
  3.91698582954566*^9}},ExpressionUUID->"cf1ded1b-01c3-44a2-b3b7-\
647860513c4a"],

Cell["and then we\[CloseCurlyQuote]ll write a 1D potential contribution as", \
"ExpositoryText",
 CellChangeTimes->{{3.9169859713815928`*^9, 3.9169859955499163`*^9}, {
  3.916986154134779*^9, 
  3.916986162664493*^9}},ExpressionUUID->"76db5a0f-e2aa-4bff-b4bc-\
78bb57df6120"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["V", "~"], "(", "q", ")"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox[
       OverscriptBox["V", "~"], 
       SubscriptBox["r", "1"]], "(", "q", ")"}], " ", "+", " ", 
     RowBox[{
      SubscriptBox[
       OverscriptBox["V", "~"], 
       SubscriptBox["r", "2"]], "(", "q", ")"}], " ", "+"}], " ", "..."}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916986047493347*^9, 
  3.9169861132623177`*^9}},ExpressionUUID->"9a545e85-0532-41dc-b42e-\
fe675cc8ca5f"],

Cell["where we do a global fit to a potential of this form", "ExpositoryText",
 CellChangeTimes->{{3.916986450216115*^9, 
  3.91698645926963*^9}},ExpressionUUID->"c9d7209c-8474-41f7-b8e2-\
65cef7262d4e"]
}, Closed]],

Cell[CellGroupData[{

Cell["Multiple Interpolant Form", "Subsubsection",
 CellChangeTimes->{{3.9169866919303017`*^9, 
  3.916986701944605*^9}},ExpressionUUID->"bdb54721-f9ca-4575-9a52-\
4bb37583b804"],

Cell["\<\
Alternately, to avoid imposing any type of model, we can try to build 1D \
potentials by minimizing in all coordinates except for a given one by \
assuming a quadratic expansion, that means given a local quadratic expansion\
\>", "ExpositoryText",
 CellChangeTimes->{{3.916986703802164*^9, 3.9169867866899023`*^9}, {
  3.917014259906719*^9, 
  3.917014266016432*^9}},ExpressionUUID->"2cc491f8-942b-4edb-88a3-\
f0725240da5d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"V", "(", 
    RowBox[{"q", ";", " ", "\[Xi]"}], ")"}], " ", "\[TildeEqual]", " ", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"q", "-", "\[Xi]"}], ")"}], "T"], "\[VeryThinSpace]", 
     RowBox[{"F", "\[InvisibleSpace]", "(", 
      RowBox[{"q", "-", "\[Xi]"}], ")"}]}], " ", "+", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"q", "-", "\[Xi]"}], ")"}], "T"], "\[InvisibleSpace]", "f"}], 
    " ", "+", " ", 
    SubscriptBox["V", "0"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.91698676677166*^9, 3.916986826539453*^9}, {
   3.916987035688508*^9, 3.916987066342197*^9}, 3.917013747400435*^9, {
   3.9170142796061068`*^9, 
   3.9170142975596046`*^9}},ExpressionUUID->"bb2b0826-1cfc-4329-bd20-\
122f53b21d30"],

Cell[TextData[{
 "we simply fix the select coordinate, ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "006df9cb-e14b-467f-9856-c14240ab3634"],
 ", and find minimizing position by noting that with a quadratic form like \
this\[LongDash]letting ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    RowBox[{"/", "r"}]], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "941ef69f-8927-4661-8e20-ce434dc887e8"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", 
    RowBox[{"/", "r"}]], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "36ef98e4-d742-46d7-8fda-11ec4bc5f93f"],
 " be the submatrices/vectors where the ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "59be7cb0-0dba-4ac8-8426-fdf01fb8578f"],
 " coordinate is dropped\[LongDash]we can complete the square to get a \
minimum energy contribution from"
}], "ExpositoryText",
 CellChangeTimes->{{3.916987025486315*^9, 3.916987094999384*^9}, {
  3.9169871867233686`*^9, 3.916987213327849*^9}, {3.916987276763542*^9, 
  3.916987278579359*^9}, {3.91701373500419*^9, 3.917013744867342*^9}, {
  3.9170137871946917`*^9, 3.917013889806476*^9}, {3.9170139504735107`*^9, 
  3.9170139599902487`*^9}, {3.917014526501652*^9, 3.917014529170712*^9}, {
  3.917014571223508*^9, 3.917014575362496*^9}, {3.917015122380156*^9, 
  3.917015127984502*^9}},ExpressionUUID->"e37b107c-e2bc-4c2d-ac52-\
de4d6b6d005d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["V", 
    RowBox[{"0", "/", "r"}]], " ", "=", " ", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], " ", 
    SuperscriptBox[
     RowBox[{
      SuperscriptBox[
       SubscriptBox["f", 
        RowBox[{"/", "r"}]], "T"], "(", 
      SubscriptBox["F", 
       RowBox[{"/", "r"}]], ")"}], 
     RowBox[{"-", "1"}]], 
    SubscriptBox["f", 
     RowBox[{"/", "r"}]]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.91701398964143*^9, 3.917013997010269*^9}, {
  3.917014063644326*^9, 3.9170140806142607`*^9}, {3.917014219789558*^9, 
  3.917014221557242*^9}},ExpressionUUID->"dbcbebac-6bb4-4ba0-b073-\
22b99eab1aee"]
}, Closed]],

