Cell[CellGroupData[{

Cell["Final Expression", "Subsubsection",
 CellChangeTimes->{{3.886525242249317*^9, 
  3.886525244305441*^9}},ExpressionUUID->"9c3e02cc-c06c-495a-958f-\
f80d93612927"],

Cell["Using these evaluation strategies we have", "ExpositoryText",
 CellChangeTimes->{{3.8865252457574577`*^9, 3.886525256764344*^9}, 
   3.886526606353565*^9},ExpressionUUID->"89f8ae9b-80a6-472d-911c-\
f9f5b48fabbb"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["\[Integral]", 
       SuperscriptBox["\[DoubleStruckCapitalR]", "N"]], 
      RowBox[{
       RowBox[{
        SubscriptBox["\[CurlyPhi]", "i"], "(", 
        StyleBox["x",
         FontWeight->"Bold"], ")"}], "\[AlignmentMarker]", 
       RowBox[{"V", "(", "x", ")"}], 
       RowBox[{
        SubscriptBox["\[CurlyPhi]", "j"], "(", 
        StyleBox["x",
         FontWeight->"Bold"], ")"}], 
       RowBox[{"\[DifferentialD]", 
        StyleBox["x",
         FontWeight->"Bold"]}]}]}]},
    {
     RowBox[{"\[AlignmentMarker]", 
      RowBox[{"=", " ", 
       RowBox[{
        SubscriptBox["S", 
         RowBox[{"i", "\[InvisibleSpace]", "j"}]], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"m", "=", "0"}], "M"], 
         RowBox[{
          FractionBox["1", 
           RowBox[{
            SqrtBox[
             SuperscriptBox["2", "m"]], "\[InvisibleSpace]"}]], 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"p", "\[Element]", 
             RowBox[{"P", "(", "m", ")"}]}], "\[InvisibleSpace]"], 
           RowBox[{
            SubscriptBox[
             StyleBox["V",
              FontWeight->"Bold"], "p"], 
            RowBox[{
             UnderoverscriptBox["\[Product]", 
              RowBox[{"k", "\[VeryThinSpace]", "=", "\[VeryThinSpace]", "1"}], 
              RowBox[{"3", "\[InvisibleSpace]", "N"}]], " ", 
             RowBox[{
              FractionBox["1", 
               SuperscriptBox[
                RowBox[{"(", 
                 SubsuperscriptBox["\[Alpha]", "k", 
                  RowBox[{"(", 
                   RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], ")"}], 
                SubscriptBox["p", 
                 RowBox[{"k", "/", "2"}]]]], 
              RowBox[{
               UnderoverscriptBox["\[Sum]", 
                RowBox[{"l", "=", "0"}], 
                TemplateBox[{
                  RowBox[{
                    SubscriptBox["p", "k"], "/", "2"}]},
                 "Floor"]], 
               RowBox[{
                RowBox[{"\[LeftBracketingBar]", 
                 SubsuperscriptBox["H", 
                  RowBox[{"\[InvisibleSpace]", 
                   RowBox[{
                    SubscriptBox["p", "k"], "-", 
                    RowBox[{"2", "\[InvisibleSpace]", "l"}]}]}], 
                  SubscriptBox["p", "k"]], "\[RightBracketingBar]"}], 
                SuperscriptBox[
                 RowBox[{
                  SuperscriptBox["\[Alpha]", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    SubscriptBox["p", "k"], "-", 
                    RowBox[{"2", "\[InvisibleSpace]", "l"}]}], ")"}], "/", 
                    "2"}]], "(", 
                  RowBox[{
                   SubsuperscriptBox["\[Xi]", "k", 
                    RowBox[{"(", 
                    RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], "-", 
                   SubscriptBox["\[Zeta]", "k"]}], ")"}], 
                 RowBox[{
                  SubscriptBox["p", "k"], "-", 
                  RowBox[{
                  "2", "\[InvisibleSpace]", "l"}]}]]}]}]}]}]}]}]}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCenteredManuallyAligned",
 CellChangeTimes->{{3.886525276006316*^9, 3.886525358450778*^9}, {
   3.886526210885673*^9, 3.886526228694153*^9}, {3.886526265824429*^9, 
   3.8865262737158937`*^9}, {3.8865264395405073`*^9, 3.886526502812791*^9}, {
   3.88652663240401*^9, 3.8865266376698847`*^9}, 3.886527177518744*^9, {
   3.886533465115383*^9, 
   3.886533477041409*^9}},ExpressionUUID->"abb6e415-e3a0-4593-9487-\
31462ae36e67"],

Cell["where ", "ExpositoryText",
 CellChangeTimes->{{3.886525366049753*^9, 
  3.886525366587533*^9}},ExpressionUUID->"584054b3-a533-41c5-94fe-\
54c106e9faf6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["V",
     FontWeight->"Bold"], "p"], " ", "=", " ", 
   RowBox[{
    FractionBox["1", 
     RowBox[{
      SubscriptBox["W", "p"], "\[InvisibleSpace]"}]], 
    FractionBox[
     RowBox[{"\[PartialD]", 
      RowBox[{"V", "(", 
       StyleBox["\[Zeta]",
        FontWeight->"Bold"], ")"}]}], 
     RowBox[{
      RowBox[{
       RowBox[{"\[PartialD]", 
        SubsuperscriptBox["x", 
         RowBox[{"\[VeryThinSpace]", "1"}], 
         SubscriptBox["p", "1"]]}], "..."}], 
      RowBox[{"\[PartialD]", 
       SubsuperscriptBox["x", 
        RowBox[{"\[VeryThinSpace]", 
         RowBox[{"3", "\[InvisibleSpace]", "N"}]}], 
        SubscriptBox["p", 
         RowBox[{"\[VeryThinSpace]", 
          RowBox[{"3", "\[InvisibleSpace]", "N"}]}]]]}]}]]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.886525369586117*^9, 
  3.886525382694257*^9}},ExpressionUUID->"8c6df970-a9fc-4d08-b941-\
9e35e3662fc7"],

Cell[TextData[{
 "If we choose ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "\[Element]", 
    RowBox[{
     SubscriptBox["P", "+"], "(", "m", ")"}]}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "c545eaae-05ad-473d-a69f-73cce79aeb33"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "+"], "(", "m", ")"}], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "4a027804-8eb8-4a25-abae-38c776ff2961"],
 " are non-decreasing permutations, we can omit the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubscriptBox["W", "p"], ")"}], 
     RowBox[{"-", "1"}]], "\[InvisibleSpace]"}], TraditionalForm]], 
  "ExpositoryText",
  CellChangeTimes->{{3.886525369586117*^9, 3.886525382694257*^9}},
  ExpressionUUID->"19d4ba8c-ceee-42fe-b168-353ad9b49f91"]
}], "ExpositoryText",
 CellChangeTimes->{{3.886525419684671*^9, 
  3.886525526307168*^9}},ExpressionUUID->"ac3be8a2-6903-41f3-84ac-\
ddea0759f0b5"],

Cell["\<\
We could reduce this further, but that would decrease the direct \
correspondence with the local expansion form.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.886526648926895*^9, 
  3.88652672352806*^9}},ExpressionUUID->"3bcb371a-4746-462e-9109-\
8d93e8fc8388"],

Cell[CellGroupData[{

Cell["Pros & Cons ", "Subsubsubsection",
 CellChangeTimes->{{3.883129133472959*^9, 
  3.883129159892762*^9}},ExpressionUUID->"9c74fcd2-9f02-4dc1-a5af-\
d8580a81ba46"],

Cell["Scales well as we need only to expand about one point", "Item",
 CellChangeTimes->{{3.8831242212307873`*^9, 3.8831242804471416`*^9}, {
  3.883124320289752*^9, 
  3.883124335218441*^9}},ExpressionUUID->"0a988305-a72f-4e24-b7e2-\
794b14fe75b5"],

Cell["Can be handled analytically", "Item",
