Cell[TextData[{
 "But this is just equivalent to taking the marginal distribution in ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[Delta]",
    FontWeight->"Bold"], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"16dc5910-2c04-416b-ad29-824e2f354975"],
 " and multiplying by the integral over the ",
 Cell[BoxData[
  FormBox[
   StyleBox["p",
    FontWeight->"Bold"], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"578a9572-b9b4-41a9-96a0-244819f487f5"],
 " coordinates, which in fact means we only need to compute ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[CapitalSigma]", "\[Delta]"], 
    RowBox[{"-", "1"}]], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"46b8c028-a321-49e7-99e5-925eea0bcb8b"],
 " and (once all normalization factors are accounted for) we get"
}], "ExpositoryText",
 CellChangeTimes->{{3.9119551474421988`*^9, 3.9119551959556026`*^9}, {
  3.9119558743453007`*^9, 
  3.911955900184574*^9}},ExpressionUUID->"3a4e8cf0-c5df-4b39-92ed-\
76274a1027e9"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"\[Integral]", 
       RowBox[{
        RowBox[{"V", "(", "r", ")"}], 
        SuperscriptBox["e", 
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", "2"]}], 
          RowBox[{
           StyleBox["(",
            FontSize->12], 
           RowBox[{
            SuperscriptBox[
             StyleBox["x",
              FontWeight->"Bold"], "T"], 
            SuperscriptBox[
             StyleBox["\[CapitalSigma]",
              FontSize->12], 
             RowBox[{"-", "1"}]], 
            StyleBox[" ",
             FontSize->12], 
            StyleBox["x",
             FontSize->12,
             FontWeight->"Bold"]}], 
           StyleBox[")",
            FontSize->12]}]}]], "d", "\[InvisibleSpace]", 
        StyleBox["x",
         FontWeight->"Bold"]}]}], 
      StyleBox[" ",
       FontWeight->"Bold"], "=", "  ", 
      RowBox[{
       SqrtBox[
        FractionBox[
         RowBox[{"\[LeftBracketingBar]", 
          RowBox[{
          "2", "\[InvisibleSpace]", "\[Pi]", "\[VeryThinSpace]", 
           "\[CapitalSigma]"}], "\[RightBracketingBar]"}], 
         RowBox[{"\[LeftBracketingBar]", 
          RowBox[{"\[Pi]", "\[VeryThinSpace]", 
           SubscriptBox["\[CapitalSigma]", "\[Delta]"]}], 
          "\[RightBracketingBar]"}]]], 
       RowBox[{"\[Integral]", 
        RowBox[{
         RowBox[{"V", "(", "r", ")"}], 
         SuperscriptBox["e", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], 
           RowBox[{
            StyleBox["(",
             FontSize->12], 
            RowBox[{
             SuperscriptBox[
              StyleBox["\[Delta]",
               FontSize->12,
               FontWeight->"Bold"], "T"], 
             SuperscriptBox[
              SubscriptBox[
               StyleBox["\[CapitalSigma]",
                FontSize->12], "\[Delta]"], 
              RowBox[{"-", "1"}]], 
             StyleBox["\[InvisibleSpace]",
              FontSize->12], 
             StyleBox["\[Delta]",
              FontSize->12,
              FontWeight->"Bold"]}], 
            StyleBox[")",
             FontSize->12]}]}]], "d", "\[InvisibleSpace]", 
         StyleBox["\[Delta]",
          FontWeight->"Bold"]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{"(", 
        SqrtBox[
         RowBox[{
          SuperscriptBox["\[Pi]", 
           RowBox[{"(", 
            RowBox[{"d", "-", "k"}], ")"}]], 
          FractionBox[
           RowBox[{
           "\[LeftBracketingBar]", "\[VeryThinSpace]", "\[CapitalSigma]", 
            "\[RightBracketingBar]"}], 
           RowBox[{"\[LeftBracketingBar]", 
            SubscriptBox["\[CapitalSigma]", "\[Delta]"], 
            "\[RightBracketingBar]"}]]}]], ")"}], 
       RowBox[{"\[Integral]", 
        RowBox[{
         RowBox[{"V", "(", "r", ")"}], 
         SuperscriptBox["e", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], 
           RowBox[{
            StyleBox["(",
             FontSize->12], 
            RowBox[{
             SuperscriptBox[
              StyleBox["\[Delta]",
               FontSize->12,
               FontWeight->"Bold"], "T"], 
             SuperscriptBox[
              SubscriptBox[
               StyleBox["\[CapitalSigma]",
                FontSize->12], "\[Delta]"], 
              RowBox[{"-", "1"}]], 
             StyleBox["\[InvisibleSpace]",
              FontSize->12], 
             StyleBox["\[Delta]",
              FontSize->12,
              FontWeight->"Bold"]}], 
            StyleBox[")",
             FontSize->12]}]}]], "d", "\[InvisibleSpace]", 
         StyleBox["\[Delta]",
          FontWeight->"Bold"]}]}]}]}]}
