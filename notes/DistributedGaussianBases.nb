  3.916519855148244*^9}},ExpressionUUID->"33327001-094c-41d3-842e-\
fe301b6cb9cc"],

Cell["And the interior term may be reexpanded as", "ExpositoryText",
 CellChangeTimes->{{3.91651995788181*^9, 3.916519966674028*^9}, 
   3.9165210221721077`*^9},ExpressionUUID->"00ce5639-4e59-4702-a3ea-\
b96500546283"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubscriptBox["\[CapitalSigma]", "A"], ")"}], 
      RowBox[{"-", "1"}]], "\[CircleDot]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["q", "A"], "-", 
        SubscriptBox["\[Mu]", "A"], "-", 
        SubscriptBox[
         RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", "(", 
          RowBox[{"\[CapitalSigma]", "\[VeryThinSpace]", "p"}], ")"}], "A"]}],
        ")"}], "2"]}]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        SubscriptBox["\[CapitalSigma]", "A"], ")"}], 
       RowBox[{"-", "1"}]], "\[CircleDot]", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["q", "A"], "-", 
         SubscriptBox["\[Mu]", "A"]}], ")"}], "2"]}]}], " ", "+", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"\[DoubleStruckI]", "(", 
       SubscriptBox["\[CapitalSigma]", "A"], ")"}], 
      RowBox[{"-", "1"}]], 
     SubscriptBox[
      RowBox[{"(", 
       RowBox[{"\[CapitalSigma]", "\[VeryThinSpace]", "p"}], ")"}], "A"], 
     RowBox[{"(", 
      RowBox[{"q", "-", "\[Mu]"}], ")"}]}], " ", "+", " ", 
    RowBox[{
     FractionBox["1", "2"], "\[VeryThinSpace]", 
     RowBox[{
      RowBox[{"(", 
       SubscriptBox["\[CapitalSigma]", "A"], ")"}], "\[VeryThinSpace]", 
      "\[CircleDot]", 
      SuperscriptBox[
       SubscriptBox[
        RowBox[{"(", 
         RowBox[{"\[CapitalSigma]", "\[VeryThinSpace]", "p"}], ")"}], "A"], 
       "2"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.91651997416127*^9, 3.91651997498003*^9}, {
  3.916520017791975*^9, 3.916520018164873*^9}, {3.916520162841563*^9, 
