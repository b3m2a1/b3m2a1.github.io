Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HoldPattern", "[", 
    RowBox[{"calcTerm2", "[", 
     RowBox[{
     "\[Xi]_", ",", "\[CapitalDelta]\[Xi]_", ",", "\[CapitalSigma]c_", ",", 
      "\[CapitalSigma]p_", ",", "\[CapitalGamma]j_", ",", "\[CapitalGamma]i_",
       ",", "\[CapitalDelta]\[CapitalSigma]_", ",", "zeta_", ",", 
      RowBox[{"{", 
       RowBox[{"n_", ",", "u_", ",", "m_", ",", "v_"}], "}"}]}], "]"}], "]"}],
    "\[RuleDelayed]", 
   RowBox[{
    RowBox[{"zeta", "\[LeftDoubleBracket]", 
     RowBox[{"n", ",", "u"}], "\[RightDoubleBracket]"}], " ", 
    RowBox[{"zeta", "\[LeftDoubleBracket]", 
     RowBox[{"m", ",", "v"}], "\[RightDoubleBracket]"}], " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
