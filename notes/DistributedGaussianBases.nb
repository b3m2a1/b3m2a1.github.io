1a72140595e0"],

Cell["and therefore", "ExpositoryText",
 CellChangeTimes->{{3.886544688396481*^9, 
  3.886544689852147*^9}},ExpressionUUID->"e7c1780c-d934-4d59-b744-\
62f67e618e67"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["\[CurlyPhi]", "n", 
        RowBox[{"(", "i", ")"}]], 
       SubsuperscriptBox["\[CurlyPhi]", "m", 
        RowBox[{"(", "j", ")"}]]}], " ", "=", " ", 
      RowBox[{
       SubsuperscriptBox["P", "n", 
        RowBox[{"(", "i", ")"}]], 
       SubsuperscriptBox["P", "m", 
        RowBox[{"(", "j", ")"}]], 
       SuperscriptBox["W", 
        RowBox[{"(", 
         RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], 
       SuperscriptBox["\[Phi]", 
        RowBox[{"(", 
         RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       FractionBox[
        SuperscriptBox["W", 
         RowBox[{"(", 
          RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], 
        SqrtBox[
         RowBox[{
          RowBox[{"n", "!"}], "\[VeryThinSpace]", 
          RowBox[{"m", "!"}]}]]], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox[
           StyleBox["P",
            FontWeight->"Bold"], "n", 
           RowBox[{"(", "i", ")"}]], "\[CircleTimes]", 
          SubsuperscriptBox[
           StyleBox["P",
            FontWeight->"Bold"], "m", 
           RowBox[{"(", "j", ")"}]]}], ")"}], "\[CircleDot]", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["\[Chi]", 
           StyleBox["n",
            FontWeight->"Bold"]], "\[CircleTimes]", 
          SuperscriptBox["\[Chi]", 
           StyleBox["m",
            FontWeight->"Bold"]]}], ")"}]}], 
       SuperscriptBox["\[Phi]", 
        RowBox[{"(", 
         RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.886442542531756*^9, 3.8864425803437138`*^9}, {
  3.886442739268886*^9, 3.886442742098936*^9}, {3.886542510755692*^9, 
  3.886542513558363*^9}, {3.886544705732213*^9, 3.886544741228569*^9}, {
