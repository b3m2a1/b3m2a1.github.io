  RowBox[{
   SubsuperscriptBox["\[Mu]", 
    RowBox[{"n", " "}], "k"], " ", "=", " ", 
   RowBox[{
    RowBox[{"\[LeftCeiling]", 
     RowBox[{"k", "/", "2"}], "\[RightCeiling]"}], 
    RowBox[{"(", " ", 
     RowBox[{
      SubsuperscriptBox["\[Mu]", 
       RowBox[{"n", " "}], 
       RowBox[{"k", "-", "2"}]], " ", "-", 
      RowBox[{
       FractionBox["1", 
        RowBox[{
         RowBox[{"2", "\[InvisibleSpace]", "n"}], " ", "-", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], "k"]}]], 
       SubsuperscriptBox["\[Mu]", 
        RowBox[{"n", "-", "1"}], 
        RowBox[{"k", "-", "2"}]]}]}], ")"}]}]}], 
