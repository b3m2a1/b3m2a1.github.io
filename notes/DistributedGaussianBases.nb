        RowBox[{
         RowBox[{"(", 
          RowBox[{"l", "+", "i"}], ")"}], "i"}], ")"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "1", ",", " ", "l"}], "}"}]}], 
    "]"}]}]}]], "Input",
