Cell[TextData[{
 "letting ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalOmega]", " ", "=", " ", 
    RowBox[{
     SubscriptBox["T", "A"], "\[CapitalGamma]", "\[VeryThinSpace]", 
     SuperscriptBox[
      SubscriptBox["T", "B"], "T"]}]}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "2b8441f7-250d-4a31-83ed-443592f92299"],
 " we get"
}], "ExpositoryText",
 CellChangeTimes->{{3.900166338781329*^9, 
  3.9001663652198267`*^9}},ExpressionUUID->"fe656a92-b087-425b-853e-\
4cac939b73f5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["T", "A"], "0"},
       {"0", 
        SubscriptBox["T", "B"]}
      }], ")"}], 
    RowBox[{"(", GridBox[{
       {"A", "\[CapitalGamma]"},
       {
        SuperscriptBox["\[CapitalGamma]", "T"], "B"}
      }], ")"}], 
    RowBox[{"(", GridBox[{
       {
        SuperscriptBox[
         SubscriptBox["T", "A"], "T"], "0"},
       {"0", 
        SuperscriptBox[
         SubscriptBox["T", "B"], "T"]}
      }], ")"}]}], " ", "=", " ", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{
        SubscriptBox["T", "A"], "A", "\[VeryThinSpace]", 
        SuperscriptBox[
         SubscriptBox["T", "A"], "T"]}], "\[CapitalOmega]"},
      {
       SuperscriptBox["\[CapitalOmega]", "T"], 
       RowBox[{
        SubscriptBox["T", "B"], "B", "\[VeryThinSpace]", 
        SuperscriptBox[
         SubscriptBox["T", "B"], "T"]}]}
     }], ")"}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.900166411485743*^9, 
  3.9001664287547293`*^9}},ExpressionUUID->"321b613e-17f6-4608-ad97-\
710c5bff5124"],

Cell[TextData[{
 "then if we want ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalOmega]", " ", "=", " ", "\[DoubleStruckZero]"}], 
   TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "54399bb8-b185-4f98-a0f8-efdefc728b92"],
 " we need ",
 Cell[BoxData[
  RowBox[{"\[CapitalGamma]", "\[InvisibleSpace]", 
   SuperscriptBox[
    SubscriptBox["T", "B"], "T"]}]], "ExpositoryTextInline",ExpressionUUID->
  "23b77aa1-c0cf-46da-afb8-e6db7fe708a5"],
 " to have an appropriately large nullspace, but we also"
}], "ExpositoryText",
