Cell["\<\
The real saving grace of a DGB approach is that the product of two DGB \
functions is again a DGB function, just centered around the weighted average \
of the original DGB points\
\>", "ExpositoryText",
 CellChangeTimes->{{3.883124522163189*^9, 3.8831245831211443`*^9}, {
  3.883125736494587*^9, 3.883125748636017*^9}, {3.883125887593059*^9, 
  3.883125959189546*^9}},ExpressionUUID->"5c67107f-0018-4191-86b0-\
8b5cc0211867"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"\[Phi]", "(", 
     RowBox[{"x", ",", " ", 
      SubscriptBox["\[Xi]", "i"], ",", " ", 
      SubscriptBox["\[Alpha]", "i"]}], ")"}], 
    RowBox[{"\[Phi]", "(", 
     RowBox[{"x", ",", " ", 
      SubscriptBox["\[Xi]", "j"], ",", " ", 
      SubscriptBox["\[Alpha]", "j"]}], ")"}]}], " ", "=", " ", 
   RowBox[{
    RowBox[{"W", "(", 
     RowBox[{
      FractionBox[
       RowBox[{
        SubscriptBox["\[Alpha]", "i"], 
        SubscriptBox["\[Alpha]", "j"]}], 
       RowBox[{
        SubscriptBox["\[Alpha]", "i"], "+", 
        SubscriptBox["\[Alpha]", "j"]}]], ",", " ", 
