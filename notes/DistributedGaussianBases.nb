3bd32d2df44c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DGBN", "[", 
     RowBox[{"\[Xi]_List", ",", " ", "\[Alpha]_List", ",", " ", 
      RowBox[{"tf_List", "?", "SquareMatrixQ"}]}], "]"}], "[", 
    "\"\<Covariance\>\"", "]"}], ":=", 
   RowBox[{"tf", ".", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"2", "*", "\[Alpha]"}], ")"}]}], "]"}], ".", 
    RowBox[{"Transpose", "[", "tf", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DGBN", "[", 
     RowBox[{"\[Xi]_List", ",", " ", "\[Alpha]_List", ",", " ", 
      RowBox[{"tf_List", "?", "SquareMatrixQ"}]}], "]"}], "[", 
    "\"\<InverseCovariance\>\"", "]"}], ":=", 
   RowBox[{"tf", ".", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"(", 
      RowBox[{"2", "*", "\[Alpha]"}], ")"}], "]"}], ".", 
    RowBox[{"Transpose", "[", "tf", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"d", ":", 
      RowBox[{"DGBN", "[", 
       RowBox[{"\[Xi]_List", ",", " ", "\[Alpha]_List", ",", " ", 
        RowBox[{"tf_List", "?", "SquareMatrixQ"}]}], "]"}]}], ")"}], "[", 
    "\"\<Normalization\>\"", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Power", "[", 
       RowBox[{"\[Pi]", ",", " ", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "4"}]}], "]"}], ")"}], "^", 
     RowBox[{"Length", "[", "\[Alpha]", "]"}]}], "*", 
    RowBox[{"Power", "[", 
     RowBox[{
      RowBox[{"Det", "[", 
       RowBox[{"d", "[", "\"\<InverseCovariance\>\"", "]"}], "]"}], ",", " ", 
      
      RowBox[{"1", "/", "4"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DGBN", "[", 
     RowBox[{"\[Xi]_List", ",", " ", "\[Alpha]_List", ",", " ", 
      RowBox[{"tf_List", "?", "SquareMatrixQ"}]}], "]"}], "[", 
    "\"\<Centers\>\"", "]"}], ":=", "\[IndentingNewLine]", "\[Xi]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"d", ":", 
     RowBox[{"DGBN", "[", 
      RowBox[{"\[Xi]_List", ",", " ", "\[Alpha]_List", ",", " ", 
       RowBox[{"tf_List", "?", "SquareMatrixQ"}]}], "]"}]}], ")"}], "[", 
   "vars__", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"d", "[", "\"\<Normalization\>\"", "]"}]}], ",", " ", 
      RowBox[{"x", "=", 
       RowBox[{
        RowBox[{"{", "vars", "}"}], "-", 
        RowBox[{"d", "[", "\"\<Centers\>\"", "]"}]}]}], ",", " ", 
      RowBox[{"S", "=", 
       RowBox[{"d", "[", "\"\<InverseCovariance\>\"", "]"}]}]}], "}"}], ",", 
    RowBox[{"n", "*", 
     RowBox[{"Exp", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "/", "2"}], 
       RowBox[{"x", ".", 
        RowBox[{"(", 
         RowBox[{"S", ".", "x"}], ")"}]}]}], "\[IndentingNewLine]", "]"}]}]}],
    "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.88422065777135*^9, 3.8842208982065496`*^9}, 
