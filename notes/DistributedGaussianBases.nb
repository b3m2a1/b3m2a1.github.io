  3.916167405024111*^9}},ExpressionUUID->"eda8bb04-9958-4669-ae5b-\
a28264f60890"],

Cell["We have", "ExpositoryText",
 CellChangeTimes->{{3.916169577268572*^9, 3.916169582362669*^9}, {
  3.916169656310714*^9, 
  3.916169657109829*^9}},ExpressionUUID->"9e5c408d-53c4-4f3a-80a8-\
a35f1265338c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"\[Integral]", 
     RowBox[{
      RowBox[{
       SubsuperscriptBox["V", "n", 
        RowBox[{"(", "1", ")"}]], "(", 
       RowBox[{"Q", "-", 
        SuperscriptBox["\[Xi]", 
         RowBox[{"(", 
          RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], 
      RowBox[{
       SubsuperscriptBox["V", "m", 
        RowBox[{"(", "2", ")"}]], "(", 
       RowBox[{"Q", "-", 
        SuperscriptBox["\[Xi]", 
         RowBox[{"(", 
          RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], 
      SuperscriptBox["\[CurlyPhi]", 
       RowBox[{"(", "i", ")"}]], 
      SuperscriptBox["\[CurlyPhi]", 
       RowBox[{"(", "j", ")"}]]}]}], 
    SubsuperscriptBox["X", "0", 
     RowBox[{"(", 
      RowBox[{"i", ",", "j"}], ")"}]]], " ", "=", " ", 
   RowBox[{
    UnderscriptBox["\[Sum]", "s"], " ", 
    RowBox[{
     UnderscriptBox["\[Sum]", "t"], " ", 
     RowBox[{
      FractionBox[
       RowBox[{
        SubscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["V", 
            RowBox[{"(", "1", ")"}]], "\[InvisibleSpace]", 
           RowBox[{
            SuperscriptBox["L", 
             RowBox[{"(", 
              RowBox[{"i", ",", "j"}], ")"}]], "\[Transpose]"}]}], ")"}], 
         RowBox[{"n", "\[InvisibleSpace]", "s"}]], 
        SubscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["V", 
            RowBox[{"(", "2", ")"}]], "\[InvisibleSpace]", 
           RowBox[{
            SuperscriptBox["L", 
             RowBox[{"(", 
              RowBox[{"i", ",", "j"}], ")"}]], "\[Transpose]"}]}], ")"}], 
         "s"]}], 
       RowBox[{"2", 
        SubsuperscriptBox["\[Alpha]", "s", 
         RowBox[{"(", 
          RowBox[{"i", ",", "j"}], ")"}]]}]], " ", 
      TagBox[GridBox[{
         {"\[Piecewise]", GridBox[{
            {
             SubsuperscriptBox["M", "2", 
              RowBox[{"(", 
               RowBox[{"i", ",", "j"}], ")"}]], 
             RowBox[{"s", "=", "t"}]},
            {
             RowBox[{
              RowBox[{"-", 
               FractionBox[
                RowBox[{"\[VeryThinSpace]", 
                 RowBox[{
                  SubsuperscriptBox["p", "s", 
                   RowBox[{"(", 
                    RowBox[{"i", ",", "j"}], ")"}]], "\[InvisibleSpace]", 
                  SubsuperscriptBox["p", "t", 
                   RowBox[{"(", 
                    RowBox[{"i", ",", "j"}], ")"}]]}]}], 
                RowBox[{"2", 
                 SubsuperscriptBox["\[Alpha]", "t", 
                  RowBox[{"(", 
                   RowBox[{"i", ",", "j"}], ")"}]]}]]}], "\[InvisibleSpace]", 
              
              SubsuperscriptBox["M", "1", 
               RowBox[{"(", 
                RowBox[{"i", ",", "j"}], ")"}]]}], 
             RowBox[{"s", "\[NotEqual]", "t"}]}
           },
