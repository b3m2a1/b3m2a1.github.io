Cell[CellGroupData[{

Cell["When Factoring out the Overlap Element", "Subsubsection",
 CellChangeTimes->{{3.9139006348694487`*^9, 
  3.913900643750629*^9}},ExpressionUUID->"aca77219-5c3d-47f3-bbd4-\
c7fe38cef4d2"],

Cell["\<\
Everything we do has the overlap matrix element factored out (since we \
reintroduce it later). In this case, our integral really looks like\
\>", "ExpositoryText",
 CellChangeTimes->{{3.9139006454524527`*^9, 3.91390067576716*^9}, {
  3.9139022638225317`*^9, 
  3.913902289012639*^9}},ExpressionUUID->"7d4d925c-cb9a-4c37-993a-\
42e194c04fdc"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["V", 
       RowBox[{"i", "\[InvisibleSpace]", "j"}]], "=", 
      RowBox[{
       SubscriptBox["W", 
        RowBox[{"i", "\[InvisibleSpace]", "j"}]], " ", 
       RowBox[{"\[Integral]", 
        RowBox[{
         RowBox[{"V", "(", "r", ")"}], 
         RowBox[{"\[Phi]", "(", 
          RowBox[{
           SubscriptBox["\[Mu]", "c"], ",", " ", 
           SubscriptBox["\[CapitalSigma]", "c"]}], ")"}], "d", 
         "\[InvisibleSpace]", "x"}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SubscriptBox["W", 
        RowBox[{"i", "\[InvisibleSpace]", "j"}]], 
       RowBox[{"\[Integral]", 
        RowBox[{
         RowBox[{"V", "(", "r", ")"}], 
         RowBox[{"exp", "(", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"x", "-", 
              SubscriptBox["\[Mu]", "c"]}], ")"}], "T"], 
           RowBox[{
            SuperscriptBox[
             SubscriptBox["\[CapitalSigma]", "c"], 
             RowBox[{"-", "1"}]], "(", 
            RowBox[{"x", "-", 
             SubscriptBox["\[Mu]", "c"]}], ")"}]}], ")"}], "d", 
         "\[InvisibleSpace]", 
         StyleBox["x",
          FontWeight->"Bold"]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SubscriptBox["W", 
        RowBox[{"i", "\[InvisibleSpace]", "j"}]], " ", 
       RowBox[{"(", 
        SqrtBox[
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"2", "\[Pi]"}], ")"}], 
           RowBox[{"(", 
            RowBox[{"d", "-", "k"}], ")"}]], 
          FractionBox[
           RowBox[{
           "\[LeftBracketingBar]", "\[VeryThinSpace]", "\[CapitalSigma]", 
            "\[RightBracketingBar]"}], 
           RowBox[{"\[LeftBracketingBar]", 
            SubscriptBox["\[CapitalSigma]", "\[Delta]"], 
            "\[RightBracketingBar]"}]]}]], ")"}], 
       RowBox[{"\[Integral]", 
        RowBox[{
         RowBox[{"V", "(", "r", ")"}], 
         SuperscriptBox["e", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], 
           RowBox[{
            StyleBox["(",
             FontSize->12], 
            RowBox[{
             SuperscriptBox[
              StyleBox["\[Delta]",
               FontSize->12,
               FontWeight->"Bold"], "T"], 
             SuperscriptBox[
              SubscriptBox[
               StyleBox["\[CapitalSigma]",
                FontSize->12], "\[Delta]"], 
              RowBox[{"-", "1"}]], 
             StyleBox["\[InvisibleSpace]",
              FontSize->12], 
             StyleBox["\[Delta]",
              FontSize->12,
              FontWeight->"Bold"]}], 
            StyleBox[")",
             FontSize->12]}]}]], "d", "\[InvisibleSpace]", 
         StyleBox["\[Delta]",
          FontWeight->"Bold"]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.913900677212723*^9, 3.9139006772267323`*^9}, {
   3.9139007087074547`*^9, 3.913900720627165*^9}, {3.913900750643798*^9, 
   3.913900822579918*^9}, {3.913900869129257*^9, 3.913900900355233*^9}, {
