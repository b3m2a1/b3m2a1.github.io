d608ed4c7605"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "dQ", ",", " ", "\[CapitalTau]Q", ",", "\[CapitalTau]Qsimp", ",", " ", 
    "nQ", ",", " ", "watSimp", ",", " ", "watFmt", ",", "wrapPlusRecursive"}],
    "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dQ", "[", 
    RowBox[{"\[Phi]", "[", "j_", "]"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"\[CapitalSigma]", "[", "j", "]"}], "**", 
       RowBox[{"Q", "[", 
        RowBox[{"\[Xi]", "[", "j", "]"}], "]"}]}]}], ")"}], "*", 
    RowBox[{"\[Phi]", "[", "j", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dQ", "[", 
    RowBox[{"\[CurlyPhi]", "[", "j_", "]"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"-", 
       RowBox[{
        RowBox[{"\[CapitalSigma]", "[", "j", "]"}], "**", 
        RowBox[{"Q", "[", 
         RowBox[{"\[Xi]", "[", "j", "]"}], "]"}]}]}], ")"}], "*", 
     RowBox[{"\[CurlyPhi]", "[", "j", "]"}]}], "-", 
    RowBox[{"I", " ", 
     RowBox[{"J", "[", "j", "]"}], "*", 
     RowBox[{"\[CurlyPhi]", "[", "j", "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dQ", "[", 
    RowBox[{"NonCommutativeMultiply", "[", 
     RowBox[{"a_", ",", " ", "b_"}], "]"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"dQ", "[", "a", "]"}], "**", "b"}], "+", 
    RowBox[{"a", "**", 
     RowBox[{"dQ", "[", "b", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dQ", "[", 
    RowBox[{"CircleTimes", "[", 
     RowBox[{"a_", ",", " ", "b_"}], "]"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"dQ", "[", "a", "]"}], "\[CircleTimes]", "b"}], "+", 
    RowBox[{"\[CapitalTau]Q", "[", 
     RowBox[{
      RowBox[{"a", "\[CircleTimes]", 
       RowBox[{"dQ", "[", "b", "]"}]}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"nQ", "[", "a", "]"}], "+", "1"}], "->", "1"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dQ", "[", 
    RowBox[{
     RowBox[{"HoldPattern", "[", "Plus", "]"}], "[", "x__", "]"}], "]"}], ":=", 
   RowBox[{"Plus", "@@", 
    RowBox[{"Map", "[", 
     RowBox[{"dQ", ",", " ", 
      RowBox[{"{", "x", "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dQ", "[", 
    RowBox[{
     RowBox[{"HoldPattern", "[", "Times", "]"}], "[", 
     RowBox[{
      RowBox[{"x_", "?", "NumericQ"}], ",", " ", "y_"}], "]"}], "]"}], ":=", 
   RowBox[{"x", "*", 
    RowBox[{"dQ", "[", "y", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dQ", "[", 
    RowBox[{
     RowBox[{"HoldPattern", "[", "Times", "]"}], "[", 
     RowBox[{"x_", ",", " ", 
      RowBox[{"\[Phi]", "[", "j_", "]"}]}], "]"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"x", "\[CircleTimes]", 
     RowBox[{"dQ", "[", 
      RowBox[{"\[Phi]", "[", "j", "]"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"dQ", "[", "x", "]"}], "*", 
     RowBox[{"\[Phi]", "[", "j", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dQ", "[", 
    RowBox[{
     RowBox[{"HoldPattern", "[", "Times", "]"}], "[", 
     RowBox[{"x_", ",", " ", 
      RowBox[{"\[CurlyPhi]", "[", "j_", "]"}]}], "]"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"x", "\[CircleTimes]", 
     RowBox[{"dQ", "[", 
      RowBox[{"\[CurlyPhi]", "[", "j", "]"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"dQ", "[", "x", "]"}], "*", 
     RowBox[{"\[CurlyPhi]", "[", "j", "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dQ", "[", 
    RowBox[{"\[CapitalTau]Q", "[", 
     RowBox[{"A_", ",", " ", 
      RowBox[{"x_", "->", "y_"}]}], "]"}], "]"}], ":=", 
   RowBox[{"\[CapitalTau]Q", "[", 
    RowBox[{
     RowBox[{"dQ", "[", "A", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"x", "+", "1"}], "->", 
      RowBox[{"y", "+", "1"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dQ", "[", "Q", "]"}], "=", "\[CapitalIota]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dQ", "[", 
    RowBox[{"Q", "[", "x_", "]"}], "]"}], ":=", "\[CapitalIota]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dQ", "[", "\[CapitalIota]", "]"}], "=", "0"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dQ", "[", 
    RowBox[{"\[CapitalSigma]", "[", "_", "]"}], "]"}], ":=", "0"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dQ", "[", 
    RowBox[{"\[Xi]", "[", "_", "]"}], "]"}], ":=", "0"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dQ", "[", 
    RowBox[{"J", "[", "_", "]"}], "]"}], ":=", "0"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dQ", "[", 
    RowBox[{"i_", "?", "NumericQ"}], "]"}], ":=", "0"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalTau]Qsimp", "[", 
    RowBox[{"t", ":", 
     RowBox[{"\[CapitalTau]Q", "[", 
      RowBox[{
       RowBox[{"CircleTimes", "[", "a__", "]"}], ",", " ", 
       RowBox[{"n_", "->", "m_"}]}], "]"}]}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"nSums", "=", 
        RowBox[{"Accumulate", "[", 
         RowBox[{"Map", "[", 
          RowBox[{"nQ", ",", " ", 
           RowBox[{"{", "a", "}"}]}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"x", "=", 
        RowBox[{"{", "a", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Replace", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"FirstPosition", "[", 
          RowBox[{"nSums", ",", " ", "n"}], "]"}], ",", " ", 
         "\[IndentingNewLine]", 
         RowBox[{"FirstPosition", "[", 
          RowBox[{"nSums", ",", " ", "m"}], "]"}]}], "\[IndentingNewLine]", 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "nP_Integer", "}"}], ",", " ", 
             RowBox[{"{", "mP_Integer", "}"}]}], "}"}], "/;", 
           RowBox[{"nP", ">=", "mP"}]}], ":>", "\[IndentingNewLine]", 
          RowBox[{"CircleTimes", "@@", 
           RowBox[{"Join", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"x", "[", 
              RowBox[{"[", 
               RowBox[{";;", 
                RowBox[{"mP", "-", "1"}]}], "]"}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"x", "[", 
              RowBox[{"[", 
               RowBox[{"{", "nP", "}"}], "]"}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"x", "[", 
              RowBox[{"[", 
               RowBox[{"mP", ";;", 
                RowBox[{"nP", "-", "1"}]}], "]"}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"x", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"nP", "+", "1"}], ";;"}], "]"}], "]"}]}], 
            "\[IndentingNewLine]", "]"}]}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"_", "->", "t"}]}], "\[IndentingNewLine]", "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nQ", "[", 
    RowBox[{"CircleTimes", "[", "a__", "]"}], "]"}], ":=", 
   RowBox[{"Total", "@", 
    RowBox[{"Map", "[", 
     RowBox[{"nQ", ",", " ", 
      RowBox[{"{", "a", "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nQ", "[", "_Q", "]"}], ":=", "1"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nQ", "[", "_\[Xi]", "]"}], ":=", "1"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nQ", "[", "_\[CapitalSigma]", "]"}], ":=", "2"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nQ", "[", "_\[CapitalGamma]", "]"}], ":=", "2"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
