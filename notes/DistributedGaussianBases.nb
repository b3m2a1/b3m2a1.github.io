Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"aj", " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         FractionBox["aj", "aij"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "aij", " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"\[Xi]ij", "-", "\[Xi]j"}], ")"}], "2"]}], "+", "1"}], 
          ")"}]}]}], ")"}]}], "/.", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"aij", "->", 
        RowBox[{"ai", "+", "aj"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\[Xi]ij", " ", "->", " ", 
        FractionBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"ai", " ", "\[Xi]i"}], " ", "+", " ", 
           RowBox[{"aj", " ", "\[Xi]j"}]}], ")"}], 
         RowBox[{"ai", "+", "aj"}]]}]}], "\[IndentingNewLine]", "}"}]}], "//",
     "Simplify"}], "//", 
   RowBox[{"ReplaceAll", "[", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[Xi]i", "-", "\[Xi]j"}], ")"}], "2"], "->", "d"}], "]"}]}], "//",
   "Expand"}]], "Input",
