      SubsuperscriptBox["P", 
       StyleBox["m",
        FontWeight->"Bold"], 
       RowBox[{"(", "j", ")"}]]}], 
     RowBox[{
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", 
        SubscriptBox["x", "k"]}]], 
      RowBox[{
       SuperscriptBox["\[Phi]", 
        RowBox[{"(", "j", ")"}]], "(", 
       StyleBox["x",
        FontWeight->"Bold"], ")"}]}]}], " ", "+", " ", 
    RowBox[{
