Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "Q"], "\[VeryThinSpace]", 
       SuperscriptBox["\[Phi]", 
        RowBox[{"(", "j", ")"}]]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["\[CapitalSigma]", "j", 
         RowBox[{"-", "1"}]], "(", 
        RowBox[{"Q", "-", 
         SubscriptBox["\[Xi]", "j"]}], ")"}], 
       SuperscriptBox["\[Phi]", 
        RowBox[{"(", "j", ")"}]]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "Q"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Q", "-", 
            SubscriptBox["\[Xi]", "c"], " ", "+", " ", 
            SubscriptBox["\[Xi]", "c"]}], ")"}], "\[CircleTimes]", 
          RowBox[{
           SubsuperscriptBox["\[CapitalSigma]", "j", 
            RowBox[{"-", "1"}]], "(", 
           RowBox[{"Q", "-", 
            SubscriptBox["\[Xi]", "j"]}], ")"}]}], 
         SuperscriptBox["\[Phi]", 
          RowBox[{"(", "j", ")"}]]}], ")"}]}], " ", "=", " ", "..."}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "Q"], 
       RowBox[{"(", 
        RowBox[{"A", "\[CircleTimes]", "B"}], ")"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", "Q"], 
         RowBox[{"(", "A", ")"}]}], "\[CircleTimes]", "B"}], " ", "+", " ", 
       RowBox[{"T", "(", 
        RowBox[{
         RowBox[{"A", "\[CircleTimes]", 
          RowBox[{
           SubscriptBox["\[Del]", "Q"], 
           RowBox[{"(", "B", ")"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{
           SubscriptBox["n", "A"], "+", "1"}], "->", "1"}]}], ")"}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "Q"], 
       RowBox[{"(", 
        RowBox[{"T", "(", 
         RowBox[{"X", ",", " ", 
          RowBox[{"n", "->", "m"}]}], ")"}], ")"}]}], " ", "=", " ", 
      RowBox[{"T", "(", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", "Q"], 
         RowBox[{"(", "X", ")"}]}], ",", " ", 
        RowBox[{
         RowBox[{"n", "+", "1"}], "->", 
         RowBox[{"m", "+", "1"}]}]}], ")"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.914163861023567*^9, 3.914163903936164*^9}, {
  3.914163937789653*^9, 3.914163973798644*^9}, {3.914164020760339*^9, 
