        SuperscriptBox[
         RowBox[{"(", 
          StyleBox[
           RowBox[{
            SuperscriptBox["\[CapitalSigma]", 
             RowBox[{"(", "i", ")"}]], "+", 
            SuperscriptBox["\[CapitalSigma]", 
             RowBox[{"(", "j", ")"}]]}],
           FontSize->14], ")"}], 
         RowBox[{"-", "1"}]], 
        StyleBox["\[CircleDot]",
         FontSize->14], 
        StyleBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Xi]", "i"], "-", 
            SubscriptBox["\[Xi]", "j"]}], ")"}], "2"],
         FontSize->14]}], 
       StyleBox[")",
        FontSize->14]}]}]]}]}], TraditionalForm]], "ExpositoryMathCentered",
