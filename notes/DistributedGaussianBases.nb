       RowBox[{"Length", "@", "sig1"}]}]}], "\[IndentingNewLine]", "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tt", "=", 
      RowBox[{
       RowBox[{"(", 
