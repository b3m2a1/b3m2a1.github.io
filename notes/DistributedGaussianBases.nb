 RowBox[{
  RowBox[{"testMat1", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"#", ".", 
      RowBox[{"Transpose", "[", "#", "]"}]}], "&"}], "@", 
    RowBox[{"BlockRandom", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"SeedRandom", "[", "0", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", "}"}], ",", " ", 
        RowBox[{"{", 
