 CellChangeTimes->{{3.913304686655477*^9, 
  3.913304717684957*^9}},ExpressionUUID->"68e9349e-430e-4d88-8894-\
880222841a35"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["\[CapitalGamma]", "k"], " ", "=", " ", 
      RowBox[{
       SubscriptBox["\[Phi]", "k"], " ", "-", " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], 
         RowBox[{"k", "-", "1"}]], 
        RowBox[{
         TemplateBox[{
           RowBox[{"\[VeryThinSpace]", 
             SubscriptBox["\[Phi]", "i"], "\[VeryThinSpace] "}], 
           RowBox[{" ", 
             SubscriptBox["\[Phi]", "k"]}]},
          "BraKet"], 
         SubscriptBox["\[Phi]", "i"]}]}]}]}]},
    {
     RowBox[{
      SubscriptBox["\[CurlyPhi]", "k"], " ", "=", " ", 
      RowBox[{
       SubscriptBox["\[CapitalGamma]", "k"], " ", "-", " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], 
         RowBox[{"k", "-", "1"}]], 
        RowBox[{
         TemplateBox[{
           RowBox[{"\[VeryThinSpace]", 
             OverscriptBox[
              SubscriptBox["\[CapitalGamma]", "i"], "_"], 
             "\[VeryThinSpace] "}], 
           RowBox[{" ", 
             SubscriptBox["\[Phi]", "k"]}]},
          "BraKet"], 
         SubscriptBox["\[CapitalGamma]", "i"]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SubscriptBox["\[Phi]", "k"], " ", "-", " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], 
         RowBox[{"k", "-", "1"}]], 
        RowBox[{
         TemplateBox[{
           RowBox[{"\[VeryThinSpace]", 
             SubscriptBox["\[Phi]", "i"], "\[VeryThinSpace] "}], 
           RowBox[{" ", 
             SubscriptBox["\[Phi]", "k"]}]},
          "BraKet"], 
         SubscriptBox["\[Phi]", "i"]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9133046999805193`*^9, 
  3.913304802383436*^9}},ExpressionUUID->"05558de4-8c14-4be8-b2d8-\
60c74f8bf10e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Algorithm with Pivoting", "Subsubsection",
 CellChangeTimes->{{3.916668705576881*^9, 
  3.916668711927949*^9}},ExpressionUUID->"2a7cd8f5-0504-4a9b-a9ac-\
773f9cf72c7d"],

Cell[TextData[{
 "Generically, we have a basis of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox["\[Phi]", "i"], "}"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "e0ffbb38-2e62-4413-aa9a-232cb2fd901c"],
 " functions that we would like to turn into ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox["\[CurlyPhi]", "i"], "}"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "568949ca-9756-4fb7-95a7-eb5a1e129ed7"],
 " orthogonalized functions"
}], "ExpositoryText",
 CellChangeTimes->{{3.9166687149147*^9, 3.916668736841095*^9}, {
  3.916668782283127*^9, 
  3.916668793316566*^9}},ExpressionUUID->"fbf9a927-b93d-4c46-bc13-\
014297f236d1"],

Cell[TextData[{
 "To do this, we can almost use standard Gram-Schmidt with pivoting, in which \
the function ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CurlyPhi]", "i"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "f21791f4-68d0-4951-8ff4-b5cca4a8a5bc"],
 " is computed by removing the contribution from all ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox["\[CurlyPhi]", 
     RowBox[{"i", "\[Minus]", "1"}]], "}"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "5e1547c7-6282-465e-9e74-e02176c11ca2"],
 " functions from every ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox["\[Phi]", 
     RowBox[{"i", "+", "1"}]], "}"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "fc8d41e9-deb9-4ebc-9354-c1528d36e314"],
 " and then the one with the largest remaining norm is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CurlyPhi]", "i"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "b53f09f6-a1de-4c50-8f09-6f78cf001fe1"],
 ". This removes much of the order-dependence and improve the numerical \
stability."
}], "ExpositoryText",
 InitializationCell->True,
 CellChangeTimes->{{3.916668815817349*^9, 
  3.916668949721603*^9}},ExpressionUUID->"1ec323af-295e-49ab-8218-\
9cc2c1650c5e"],

Cell["\<\
The only difference is that our norms must be computed via the overlap \
matrix, i.e. if we have\
\>", "ExpositoryText",
