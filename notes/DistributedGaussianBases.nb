Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"\[CapitalGamma]", "(", 
     RowBox[{
      RowBox[{"3", "/", "2"}], "+", "k"}], ")"}], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{"3", "/", "2"}], ")"}], 
     RowBox[{"(", "n", ")"}]]], " ", "=", 
   RowBox[{
    FractionBox[
     SqrtBox["\[Pi]"], 
     SuperscriptBox["2", 
      RowBox[{"k", "+", "1", "-", "n"}]]], "\[InvisibleSpace]", 
    FractionBox[
     RowBox[{"2", "\[InvisibleSpace]", 
      RowBox[{"k", "!!"}]}], 
     RowBox[{"2", "\[InvisibleSpace]", 
      RowBox[{"n", "!!"}]}]]}]}], TraditionalForm]], "ExpositoryMathCentered",\

