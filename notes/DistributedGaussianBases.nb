Cell[TextData[{
 "which isn\[CloseCurlyQuote]t an issue for the very, very subtle reason that",
 StyleBox[" ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"m", " ", "=", " ", 
    RowBox[{
     RowBox[{"v", " ", "\[Implies]", " ", 
      SubsuperscriptBox["\[Zeta]", 
       RowBox[{"m", "\[InvisibleSpace]", "v"}], 
       RowBox[{"(", "\[Alpha]", ")"}]]}], " ", "=", " ", "0"}]}], 
   TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "feb03283-10be-447c-a8ad-fafce006087b"],
 " and so the asymmetric term disappears, which ",
 StyleBox["also",
  FontSlant->"Italic"],
 " means that we get away with just writing"
}], "ExpositoryText",
 CellChangeTimes->{{3.914204320822763*^9, 3.914204371782446*^9}, {
