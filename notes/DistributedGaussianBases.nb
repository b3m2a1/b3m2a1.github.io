   3.8842759434802103`*^9, 
   3.8842759436727057`*^9}},ExpressionUUID->"8b031cd7-958f-414a-9ce5-\
951c7dad446e"],

Cell["\<\
As this is a unitary linear transformation (plus a shift), we now have\
\>", "ExpositoryText",
 CellChangeTimes->{{3.883854206524651*^9, 3.8838542147151546`*^9}, {
  3.8838545175478888`*^9, 3.8838545571836433`*^9}, {3.883854683998296*^9, 
  3.8838547012711487`*^9}, {3.8838687770958767`*^9, 
  3.883868780231867*^9}},ExpressionUUID->"cbb3c328-45b6-4cb9-a34e-\
570656cc1b1f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["T", 
    RowBox[{"i", "\[InvisibleSpace]", "j"}]], " ", "=", " ", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"W", "(", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[CapitalSigma]", "i"], "+", 
        SubscriptBox["\[CapitalSigma]", "j"]}], ",", " ", 
       RowBox[{
        SubscriptBox["\[Xi]", "i"], "-", 
        SubscriptBox["\[Xi]", "j"]}]}], ")"}]}], 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      SuperscriptBox["\[DoubleStruckCapitalR]", "d"], " "], 
     RowBox[{
      RowBox[{"\[Phi]", "(", 
       RowBox[{"q", ",", " ", 
        SubscriptBox["\[Zeta]", "c"], ",", " ", 
        SubscriptBox["\[CapitalLambda]", "c"]}], ")"}], 
      FractionBox["Tr", 
       RowBox[{"2", "\[InvisibleSpace]", "m"}]], 
      RowBox[{"(", 
       SubscriptBox["\[ScriptCapitalT]", "j"], ")"}], 
      RowBox[{"\[DifferentialD]", "q", " "}]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.883854621742291*^9, 3.883854673358849*^9}, {
   3.883854730597674*^9, 3.8838547464898577`*^9}, 3.883868792711279*^9, 
   3.883885972760915*^9, 3.883963526893927*^9, {3.8839636001575403`*^9, 
   3.883963600676086*^9}, 3.883963928967841*^9, 3.883964007854754*^9, 
   3.884013170751034*^9},ExpressionUUID->"e0522ae2-03be-46c7-9ab3-\
6f87a7bfe548"],

Cell["We can now evaluate this by first defining", "ExpositoryText",
 CellChangeTimes->{{3.883854705160898*^9, 3.8838547280995007`*^9}, {
   3.883854763337736*^9, 3.88385481311836*^9}, {3.883855078223857*^9, 
   3.883855081347929*^9}, {3.883855171493952*^9, 3.883855174564825*^9}, 
   3.88386879564602*^9},ExpressionUUID->"8922809d-4789-4147-bfc7-\
9f1d0838b8e4"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["\[Eta]", "j"], " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["\[CapitalSigma]", "j", 
         RowBox[{"-", "1"}]], "\[CircleDot]", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", 
           SubscriptBox["\[Xi]", "j"]}], ")"}], "2"]}], ")"}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "x"], "\[VeryThinSpace]", 
       SubscriptBox["\[Eta]", "j"]}], " ", "=", " ", 
      RowBox[{
       SubsuperscriptBox["\[CapitalSigma]", "j", 
        RowBox[{"-", "1"}]], "\[CircleDot]", 
       RowBox[{
        SubscriptBox["\[Del]", "x"], "\[VeryThinSpace]", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", 
           SubscriptBox["\[Xi]", "j"]}], ")"}], "2"]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{"2", 
       RowBox[{"(", 
        SubsuperscriptBox["\[CapitalSigma]", "j", 
         RowBox[{"-", "1"}]], ")"}], 
       RowBox[{"(", 
        RowBox[{"x", "-", 
         SubscriptBox["\[Xi]", "j"]}], ")"}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["x", "2"]], 
       SubscriptBox["\[Eta]", "j"]}], "=", 
      RowBox[{"2", 
       SubsuperscriptBox["\[CapitalSigma]", "j", 
        RowBox[{"-", "1"}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.883855176337433*^9, 3.883855213834218*^9}, {
  3.883855405776216*^9, 3.883855407224566*^9}, {3.883855716682789*^9, 
  3.883855734639389*^9}, {3.883855772782748*^9, 3.883855789932168*^9}, {
  3.883858298860299*^9, 
  3.883858320746641*^9}},ExpressionUUID->"d521c2b0-d696-41b3-92a0-\
6d3e0b19517d"],

Cell["and then noting that", "ExpositoryText",
 CellChangeTimes->{{3.8838552163694*^9, 
  3.883855218751094*^9}},ExpressionUUID->"e07976c6-64ea-49d1-b415-\
0dff342d4692"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[InvisibleSpace]", GridBox[{
     {
      RowBox[{"\[InvisibleSpace]", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", 
          StyleBox["x",
           FontSize->12]], 
         SubscriptBox["\[Eta]", "j"]}], "=", " ", 
        RowBox[{"2", 
         RowBox[{
          SubscriptBox["L", "c"], "(", 
          SubsuperscriptBox["\[CapitalSigma]", "j", 
           RowBox[{"-", "1"}]], ")"}], 
         RowBox[{"(", 
          RowBox[{"x", " ", "-", " ", 
           SubscriptBox["\[Xi]", "j"]}], ")"}]}]}]}]},
     {
      RowBox[{"=", " ", 
       RowBox[{"2", 
        SubsuperscriptBox["\[CapitalSigma]", "j", 
         RowBox[{"-", "1"}]], 
        SuperscriptBox[
         SubscriptBox["L", "c"], 
         StyleBox["T",
          FontSize->9,
          FontSlant->"Plain"]], "q", " "}]}]}
    }]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.883858180521517*^9, 3.8838581886229486`*^9}, {
  3.883858468018817*^9, 3.8838584724905443`*^9}, {3.883858628032319*^9, 
  3.883858741606689*^9}, {3.883859260564171*^9, 3.883859356993764*^9}, {
  3.883859413668672*^9, 3.883859468490678*^9}, {3.883874602698783*^9, 
  3.883874634767685*^9}, {3.883874816910317*^9, 3.8838748213862953`*^9}, {
  3.8838751663568277`*^9, 
  3.883875169385017*^9}},ExpressionUUID->"d63e2097-f7e5-4bed-857c-\
9833e97af00c"],

Cell["so we have", "ExpositoryText",
 CellChangeTimes->{{3.8838581847499104`*^9, 3.8838581921547127`*^9}, {
  3.883885981897537*^9, 
  3.883885982224844*^9}},ExpressionUUID->"357bc4d5-3cbf-45a0-a051-\
a822be7551ed"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       FractionBox["1", "4"], 
       RowBox[{"Tr", "(", 
        RowBox[{
         SuperscriptBox["M", 
          RowBox[{"-", "1"}]], 
         RowBox[{
          RowBox[{
           SubscriptBox["\[Del]", 
            StyleBox["x",
             FontSize->12]], 
           SubscriptBox["\[Eta]", "j"]}], "\[CircleTimes]", 
          RowBox[{
           SubscriptBox["\[Del]", 
            StyleBox["x",
             FontSize->12]], 
           SubscriptBox["\[Eta]", "j"]}]}]}], ")"}]}], " ", "=", " ", 
      RowBox[{
       FractionBox["1", "4"], 
       RowBox[{"Tr", "(", 
        RowBox[{
         SuperscriptBox["M", 
          RowBox[{"-", "1"}]], "(", 
         RowBox[{
          SubsuperscriptBox["\[CapitalSigma]", "j", 
           RowBox[{"-", "1"}]], 
          SuperscriptBox[
           SubscriptBox["L", "c"], 
           StyleBox["T",
            FontSize->9,
            FontSlant->"Plain"]], 
          RowBox[{"q", " ", "\[CircleTimes]", " ", 
           SubsuperscriptBox["\[CapitalSigma]", "j", 
            RowBox[{"-", "1"}]]}], 
          SuperscriptBox[
           SubscriptBox["L", "c"], 
           StyleBox["T",
            FontSize->9,
            FontSlant->"Plain"]], "q"}], ")"}], ")"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       FractionBox["1", "4"], 
       RowBox[{"Tr", "(", 
        RowBox[{
         SuperscriptBox["M", 
          RowBox[{
           RowBox[{"-", "1"}], "/", "2"}]], 
         SubsuperscriptBox["\[CapitalSigma]", "j", 
          RowBox[{"-", "1"}]], 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["L", "c"], 
           StyleBox["T",
            FontSize->9,
            FontSlant->"Plain"]], "(", 
          RowBox[{"q", " ", "\[CircleTimes]", " ", "q"}], ")"}], 
         SubscriptBox["L", "c"], 
         SubsuperscriptBox["\[CapitalSigma]", "j", 
          RowBox[{"-", "1"}]], 
         SuperscriptBox["M", 
          RowBox[{
           RowBox[{"-", "1"}], "/", "2"}]]}], ")"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       FractionBox["1", "4"], 
       RowBox[{"Tr", "(", 
        RowBox[{
         SubscriptBox["L", "c"], 
         SubsuperscriptBox["\[CapitalSigma]", "j", 
          RowBox[{"-", "1"}]], 
         SuperscriptBox["M", 
          RowBox[{"-", "1"}]], 
         SubsuperscriptBox["\[CapitalSigma]", "j", 
          RowBox[{"-", "1"}]], 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["L", "c"], 
           StyleBox["T",
            FontSize->9,
            FontSlant->"Plain"]], "(", 
          RowBox[{"q", " ", "\[CircleTimes]", " ", "q"}], ")"}]}], 
        ")"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       FractionBox["1", "4"], "\[VeryThinSpace]", 
       RowBox[{
        UnderscriptBox["\[Sum]", "k"], " ", 
        RowBox[{
         SubscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["L", "c"], 
            SubsuperscriptBox["\[CapitalSigma]", "j", 
             RowBox[{"-", "1"}]], 
            SuperscriptBox["M", 
             RowBox[{"-", "1"}]], 
            SubsuperscriptBox["\[CapitalSigma]", "j", 
             RowBox[{"-", "1"}]], 
            SuperscriptBox[
             SubscriptBox["L", "c"], 
             StyleBox["T",
              FontSize->9,
              FontSlant->"Plain"]]}], ")"}], "k"], "\[CenterDot]", 
         SubscriptBox[
          RowBox[{"(", 
           RowBox[{"q", "\[CircleTimes]", "q"}], ")"}], "k"]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       FractionBox["1", "4"], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["L", "c"], 
          SubsuperscriptBox["\[CapitalSigma]", "j", 
           RowBox[{"-", "1"}]], 
          SuperscriptBox["M", 
           RowBox[{"-", "1"}]], 
          SubsuperscriptBox["\[CapitalSigma]", "j", 
           RowBox[{"-", "1"}]], 
          SuperscriptBox[
           SubscriptBox["L", "c"], 
           StyleBox["T",
            FontSize->9,
            FontSlant->"Plain"]]}], ")"}], "\[CircleDot]", 
        SuperscriptBox["q", "2"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.883855219647416*^9, 3.883855288644948*^9}, {
   3.8838553201927156`*^9, 3.883855320581756*^9}, {3.8838580749513187`*^9, 
   3.883858081686391*^9}, {3.8838581711353893`*^9, 3.883858175060729*^9}, {
   3.883859200625586*^9, 3.883859243712315*^9}, {3.883859479455782*^9, 
   3.883859482012389*^9}, {3.883859663064351*^9, 3.883859685427845*^9}, {
   3.883859719446088*^9, 3.883859759544438*^9}, {3.88387546730263*^9, 
   3.8838754911095753`*^9}, {3.883875603082623*^9, 3.883875613040783*^9}, {
   3.883875728327414*^9, 3.883875733847299*^9}, {3.883877273021888*^9, 
   3.8838772764550753`*^9}, {3.8838795810321703`*^9, 
   3.8838795816173143`*^9}, {3.88388605538372*^9, 3.8838860560908737`*^9}, {
   3.8838861042639503`*^9, 3.883886113067219*^9}, {3.883886217204681*^9, 
   3.883886228167151*^9}, {3.8838863074518642`*^9, 3.88388632026931*^9}, {
   3.883925269401473*^9, 3.883925307101791*^9}, {3.8839255408464003`*^9, 
   3.883925559730582*^9}, {3.88392559046144*^9, 3.8839256053066483`*^9}, {
   3.883964062106907*^9, 3.883964076583754*^9}, {3.8839641272548933`*^9, 
   3.883964133063057*^9}, {3.883964284149472*^9, 3.88396428597969*^9}, {
   3.883964370273378*^9, 3.8839643718820667`*^9}, {3.883964651270687*^9, 
   3.883964656104472*^9}, {3.8839647165537033`*^9, 3.8839647281567*^9}, {
   3.883964777872211*^9, 3.8839648291612263`*^9}, {3.883965008312613*^9, 
   3.883965049275442*^9}, 
   3.895344618893134*^9},ExpressionUUID->"313e3bf3-bd72-48c6-b1cd-\
225d234114f5"],

Cell[TextData[{
 "which we\[CloseCurlyQuote]ll write more compactly by noting that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "c"], 
    SubsuperscriptBox["\[CapitalSigma]", "j", 
     RowBox[{"-", "1"}]], 
    SuperscriptBox["M", 
     RowBox[{"-", "1"}]], 
    SubsuperscriptBox["\[CapitalSigma]", "j", 
     RowBox[{"-", "1"}]], 
    SuperscriptBox[
     SubscriptBox["L", "c"], 
     StyleBox["T",
      FontSize->9,
      FontSlant->"Plain"]]}], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"7180e8b1-b226-4192-b883-18fa17e7221f"],
 " is just a similarity transformation of the mass-weighted alphas (squared) \
to this new basis, meaning it\[CloseCurlyQuote]s reasonable to write"
}], "ExpositoryText",
 CellChangeTimes->{{3.883926284281206*^9, 3.8839262919922867`*^9}, {
  3.883926331826519*^9, 3.883926352861393*^9}, {3.883965151658766*^9, 
  3.88396518309067*^9}},ExpressionUUID->"0c6bc017-e9af-412d-bbdc-\
eeabf14954f5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["A", 
    RowBox[{"j", "\[InvisibleSpace]"}], 
    RowBox[{
     RowBox[{"(", "c", ")"}], "-", "2"}]], " ", "=", " ", 
   RowBox[{
    SubscriptBox["L", "c"], 
    SubsuperscriptBox["\[CapitalSigma]", "j", 
     RowBox[{"-", "1"}]], 
    SuperscriptBox["M", 
     RowBox[{"-", "1"}]], 
    SubsuperscriptBox["\[CapitalSigma]", "j", 
     RowBox[{"-", "1"}]], 
    SuperscriptBox[
     SubscriptBox["L", "c"], 
     StyleBox["T",
      FontSize->9,
      FontSlant->"Plain"]]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.883926295755863*^9, 3.8839263626322937`*^9}, {
  3.883965192790008*^9, 3.883965203299407*^9}, {3.883966329166106*^9, 
  3.883966329308897*^9}},ExpressionUUID->"9c6f4b8b-f0c0-41fa-91fe-\
7fa80aad74c7"],

Cell["and finally", "ExpositoryText",
 CellChangeTimes->{{3.88385749284943*^9, 3.883857495859144*^9}, {
  3.8838597964870768`*^9, 
  3.883859801003662*^9}},ExpressionUUID->"69451966-debd-40ab-9018-\
aaaf8b9ac214"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"Tr", "(", 
        RowBox[{
         SuperscriptBox["M", 
          RowBox[{"-", "1"}]], 
         RowBox[{
          SubscriptBox["L", "c"], "(", 
          RowBox[{
           SubscriptBox["\[Del]", 
            SuperscriptBox["x", "2"]], 
           SubscriptBox["\[Eta]", "j"]}], ")"}], 
         SuperscriptBox[
          SubscriptBox["L", "c"], 
          StyleBox["T",
           FontSize->9,
           FontSlant->"Plain"]]}], ")"}]}], " ", "=", " ", 
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"Tr", "(", 
        RowBox[{
         SuperscriptBox["M", 
          RowBox[{"-", "1"}]], 
         RowBox[{
          SubscriptBox["\[Del]", 
           SuperscriptBox["x", "2"]], 
          SubscriptBox["\[Eta]", "j"]}]}], ")"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"Tr", "(", 
        RowBox[{
         SuperscriptBox["M", 
          RowBox[{"-", "1"}]], 
         SubsuperscriptBox["\[CapitalSigma]", "j", 
          RowBox[{"-", "1"}]]}], ")"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{
        UnderscriptBox["\[Sum]", "k"], " ", 
        RowBox[{
         SubscriptBox[
          RowBox[{"(", 
           SubsuperscriptBox["\[CapitalSigma]", "j", 
            RowBox[{"-", "1"}]], ")"}], 
          RowBox[{"k", "\[InvisibleSpace]", "k"}]], "/", 
         SubscriptBox["m", "k"]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{
        SuperscriptBox["M", 
         RowBox[{"-", "1"}]], "\[CircleDot]", 
        SubsuperscriptBox["\[CapitalSigma]", "j", 
         RowBox[{"-", "1"}]]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.883857502324786*^9, 3.883857532576635*^9}, {
  3.883879685944147*^9, 3.883879692594421*^9}, {3.883925416104982*^9, 
  3.883925422613957*^9}, {3.883965215145389*^9, 3.883965234893553*^9}, {
  3.883966493932214*^9, 3.883966514765057*^9}, {3.884017261305212*^9, 
  3.8840172636623497`*^9}, {3.884085650984568*^9, 
  3.884085659247518*^9}},ExpressionUUID->"837bd95d-ea14-46a5-bf3d-\
03b419ed7234"],

Cell["so we end up with", "ExpositoryText",
 CellChangeTimes->{{3.8838598036655693`*^9, 3.883859803782895*^9}, {
  3.883965246434548*^9, 
  3.883965249759808*^9}},ExpressionUUID->"d4d7aa11-321b-4d58-87eb-\
93ee9d69ee59"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["T", 
       RowBox[{"i", "\[InvisibleSpace]", "j"}]], " ", "=", " ", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"W", "(", 
         RowBox[{
          RowBox[{
           SubscriptBox["\[CapitalSigma]", "i"], "+", 
           SubscriptBox["\[CapitalSigma]", "j"]}], ",", " ", 
          RowBox[{
           SubscriptBox["\[Xi]", "i"], "-", 
           SubscriptBox["\[Xi]", "j"]}]}], ")"}]}], 
       RowBox[{
        SubsuperscriptBox["\[Integral]", 
         SuperscriptBox["\[DoubleStruckCapitalR]", "d"], " "], 
        RowBox[{
         RowBox[{"\[Phi]", "(", 
          RowBox[{"q", ",", " ", 
           SubscriptBox["\[Zeta]", "c"], ",", " ", 
           SubscriptBox["\[CapitalLambda]", "c"]}], ")"}], 
         RowBox[{"Tr", "(", 
          SubscriptBox["\[ScriptCapitalT]", "j"], ")"}], 
         RowBox[{"\[DifferentialD]", "q", " "}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"W", "(", 
         RowBox[{
          RowBox[{
           SubscriptBox["\[CapitalSigma]", "i"], "+", 
           SubscriptBox["\[CapitalSigma]", "j"]}], ",", " ", 
          RowBox[{
           SubscriptBox["\[Xi]", "i"], "-", 
           SubscriptBox["\[Xi]", "j"]}]}], ")"}]}], 
       RowBox[{
        SubsuperscriptBox["\[Integral]", 
         SuperscriptBox["\[DoubleStruckCapitalR]", "d"], " "], 
        RowBox[{
         RowBox[{"\[Phi]", "(", 
          RowBox[{"q", ",", " ", 
           SubscriptBox["\[Zeta]", "c"], ",", " ", 
           SubscriptBox["\[CapitalLambda]", "c"]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            FractionBox["1", "4"], 
            RowBox[{
             SubsuperscriptBox["A", 
              RowBox[{"j", "\[InvisibleSpace]"}], 
              RowBox[{
               RowBox[{"(", "c", ")"}], "-", "2"}]], "\[CircleDot]", 
             SuperscriptBox["q", "2"]}]}], " ", "-", " ", 
           RowBox[{
            FractionBox["1", "2"], 
            RowBox[{
             UnderscriptBox["\[Sum]", "k"], " ", 
             RowBox[{
              SubscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox["\[CapitalSigma]", "j", 
                 RowBox[{"-", "1"}]], ")"}], 
               RowBox[{"k", "\[InvisibleSpace]", "k"}]], "/", 
              SubscriptBox["m", "k"]}]}]}]}], ")"}], 
         RowBox[{"\[DifferentialD]", "q"}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.883854621742291*^9, 3.883854673358849*^9}, {
   3.883854730597674*^9, 3.8838547464898577`*^9}, {3.883859810902008*^9, 
   3.883859839796493*^9}, {3.8838598724252787`*^9, 3.883859902246221*^9}, {
   3.883885997741514*^9, 3.883886042872031*^9}, 3.883925460113933*^9, {
   3.8839256283276157`*^9, 3.883925648453388*^9}, 3.8839263766979637`*^9, {
   3.8839663354443903`*^9, 3.883966353626039*^9}, 3.884013103750804*^9, {
   3.884013176620823*^9, 3.884013177719597*^9}, {3.884017283643622*^9, 
   3.884017288079825*^9}},ExpressionUUID->"2da04976-f5a1-400d-ba31-\
a7eb0e362619"],

Cell["\<\
Finally, the actual process of evaluating this ends up very similar to the \
evaluation of the potential for a Taylor series expanded potential.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.883926460042104*^9, 3.883926508899852*^9}, {
  3.883926780592162*^9, 3.883926782088751*^9}, {3.883961267904251*^9, 
  3.883961277789691*^9}, {3.884014109895022*^9, 
  3.8840141111896353`*^9}},ExpressionUUID->"5dd914c6-649a-434d-a66a-\
62cc2a4fd22e"],

Cell["We will let", "ExpositoryText",
 CellChangeTimes->{{3.883961456916729*^9, 
  3.8839614659547358`*^9}},ExpressionUUID->"b5e1746e-95af-45e4-a931-\
ad6622198f83"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["\[Alpha]", 
    RowBox[{"(", 
     RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], " ", "=", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubscriptBox["\[CapitalLambda]", "c"], ")"}], 
     RowBox[{"-", "1"}]], "/", "2"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.883961529667008*^9, 3.883961561437601*^9}, {
  3.883961728261301*^9, 3.883961738914776*^9}, {3.883966363048469*^9, 
  3.883966363403211*^9}, {3.8840849875772552`*^9, 
  3.88408498926558*^9}},ExpressionUUID->"729a5e5b-915d-4c10-9c2d-\
18c39743e5e2"],

Cell["giving us", "ExpositoryText",
 CellChangeTimes->{{3.883961718253166*^9, 
  3.883961719680894*^9}},ExpressionUUID->"1c1f3086-627e-469a-82d0-\
b90ca9362139"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["tr", "1"], "=", 
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"k", ">", 
          RowBox[{"k", "'"}]}], "\[InvisibleSpace]"], "\[VeryThinSpace] ", 
        RowBox[{
         SubscriptBox[
          RowBox[{"(", 
           SubsuperscriptBox["A", 
            RowBox[{"j", "\[InvisibleSpace]"}], 
            RowBox[{
             RowBox[{"(", "c", ")"}], "-", "2"}]], ")"}], 
          RowBox[{"k", "\[InvisibleSpace]", 
           RowBox[{"k", "'"}]}]], "\[InvisibleSpace]", 
         SubsuperscriptBox["\[Zeta]", "k", 
          RowBox[{"(", "c", ")"}]], "\[InvisibleSpace]", 
         SubsuperscriptBox["\[Zeta]", 
          RowBox[{"k", "'"}], 
          RowBox[{"(", "c", ")"}]]}]}]}]}]},
    {
     RowBox[{
      SubscriptBox["tr", "2"], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", "k", "\[InvisibleSpace]"], 
       "\[VeryThinSpace] ", 
       RowBox[{
        SubscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox["A", 
           RowBox[{"j", "\[InvisibleSpace]"}], 
           RowBox[{
            RowBox[{"(", "c", ")"}], "-", "2"}]], ")"}], 
         RowBox[{"k", "\[InvisibleSpace]", "k"}]], " ", 
        FractionBox["1", 
         SubsuperscriptBox["\[Alpha]", "k", 
          RowBox[{"(", 
           RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", 
           SuperscriptBox[
            RowBox[{
             SubsuperscriptBox["\[Alpha]", "k", 
              RowBox[{"(", 
               RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], "(", 
             SubsuperscriptBox["\[Zeta]", "k", 
              RowBox[{"(", "c", ")"}]], ")"}], "2"]}], "+", "1"}], ")"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8840166490551577`*^9, 3.884016958573533*^9}, {
  3.884016990575309*^9, 3.8840170556773357`*^9}, {3.884017148717054*^9, 
  3.88401719474749*^9}, {3.8840915162104*^9, 
  3.884091535097062*^9}},ExpressionUUID->"0de4cd3c-23a1-4e03-9172-\
98d214537413"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["T", 
    RowBox[{"i", "\[InvisibleSpace]", "j"}]], " ", "=", " ", 
   RowBox[{
    FractionBox[
     SubscriptBox["S", 
      RowBox[{"i", "\[InvisibleSpace]", "j"}]], "2"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["M", 
        RowBox[{"-", "1"}]], "\[CircleDot]", 
       SubsuperscriptBox["\[CapitalSigma]", "j", 
        RowBox[{"-", "1"}]]}], " ", "-", 
      FractionBox[
       RowBox[{
        SubscriptBox["tr", "1"], " ", "+", " ", 
        SubscriptBox["tr", "2"]}], "2"]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8839614154026337`*^9, 3.883961429277893*^9}, {
   3.883961491215919*^9, 3.883961517329463*^9}, {3.883961741541788*^9, 
   3.883961767669779*^9}, {3.883966367201498*^9, 3.883966376145944*^9}, {
   3.8839664166279573`*^9, 3.883966485377162*^9}, 3.8840131891350594`*^9, 
   3.8840132194707317`*^9, {3.884014128005224*^9, 3.884014150144354*^9}, {
   3.884016557027027*^9, 3.8840165723357697`*^9}, 3.8840166452005444`*^9, {
   3.884017293045588*^9, 3.884017308905819*^9}, {3.884085750291944*^9, 
   3.8840857684784527`*^9}, {3.88409167306773*^9, 3.8840917094009113`*^9}, {
   3.884091740882421*^9, 
   3.884091748880534*^9}},ExpressionUUID->"8fbc3d82-c391-46f4-9c2b-\
b2db0c390199"],

Cell[TextData[{
 "and if we squint we can kinda see how this reduces to the previous form if ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalSigma]", "i"], TraditionalForm]],
  CellChangeTimes->{{3.88384740674933*^9, 3.883847408513365*^9}, {
   3.883853378968896*^9, 3.883853439863595*^9}, {3.883853800701524*^9, 
   3.8838538132781153`*^9}},ExpressionUUID->
  "64f048b9-d59a-4ed6-84cd-fa4be3f80c34"],
 " is diagonal with diagonal entries ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1", "/", "2"}], "\[VeryThinSpace]", 
    SubsuperscriptBox["\[Alpha]", "k", 
     RowBox[{"(", "i", ")"}]]}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "5cd48f33-f507-455f-b580-409cc2affd92"],
 " and similarly with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalSigma]", "j"], TraditionalForm]],
  CellChangeTimes->{{3.88384740674933*^9, 3.883847408513365*^9}, {
   3.883853378968896*^9, 3.883853439863595*^9}, {3.883853800701524*^9, 
   3.8838538132781153`*^9}},ExpressionUUID->
  "4ca5eb7b-9798-4bf2-9aec-09fcbd2cc45e"],
 "."
}], "ExpositoryText",
 CellChangeTimes->{{3.8840173113755627`*^9, 3.8840173495888233`*^9}, {
  3.8840178379543247`*^9, 3.884017839024065*^9}, {3.884085774920232*^9, 
  3.884085776036392*^9}, {3.884272426881892*^9, 3.8842724298763638`*^9}, {
  3.884272840942011*^9, 3.8842728496045437`*^9}, {3.884277107325683*^9, 
  3.884277107471053*^9}},ExpressionUUID->"1d38455f-dcbc-4138-9ca2-\
c3127a81cca5"],

Cell[TextData[{
 StyleBox["NOTE",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 ": I\[CloseCurlyQuote]m off by a factor of two here I think \[Rule] check \
the code for the correct result"
}], "ExpositoryText",
 CellChangeTimes->{{3.884875291259781*^9, 
  3.884875308741708*^9}},ExpressionUUID->"496b981a-c83a-4e59-b5f8-\
2173b1d4df59"],

Cell[TextData[{
 "Expanding that idea out, noting that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "c"], " ", "=", " ", "I"}], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "ec734862-1048-4391-8e35-58f2fb541361"],
 ", we get"
}], "ExpositoryText",
 CellChangeTimes->{{3.8842724317901*^9, 3.88427243593113*^9}, {
  3.884272852959737*^9, 3.884272865569935*^9}, {3.884277114973343*^9, 
  3.884277115546329*^9}},ExpressionUUID->"2a5eeb34-e1ea-4adf-84ef-\
900e0a7ce4ab"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox["A", 
         RowBox[{"j", "\[InvisibleSpace]"}], 
         RowBox[{
          RowBox[{"(", "c", ")"}], "-", "2"}]], ")"}], 
       RowBox[{"k", "\[InvisibleSpace]", 
        RowBox[{"k", "'"}]}]], " ", "=", " ", 
      SubscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["\[CapitalSigma]", "j", 
          RowBox[{"-", "1"}]], 
         SuperscriptBox["M", 
          RowBox[{"-", "1"}]], 
         SubsuperscriptBox["\[CapitalSigma]", "j", 
          RowBox[{"-", "1"}]]}], ")"}], 
       RowBox[{"k", "\[InvisibleSpace]", 
        RowBox[{"k", "'"}]}]]}]},
    {
     RowBox[{"=", " ", 
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"2", 
          SubsuperscriptBox["\[Alpha]", "k", 
           RowBox[{"(", "j", ")"}]]}], ")"}], "2"], 
       SubscriptBox["m", "k"]]}]},
    {
     RowBox[{
      SubscriptBox["tr", "1"], "=", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"k", ">", 
           RowBox[{"k", "'"}]}], "\[InvisibleSpace]"], "\[VeryThinSpace] ", 
         RowBox[{
          SubscriptBox[
           RowBox[{"(", 
            SubsuperscriptBox["A", 
             RowBox[{"j", "\[InvisibleSpace]"}], 
             RowBox[{
              RowBox[{"(", "c", ")"}], "-", "2"}]], ")"}], 
           RowBox[{"k", "\[InvisibleSpace]", 
            RowBox[{"k", "'"}]}]], "\[InvisibleSpace]", 
          SubsuperscriptBox["\[Zeta]", "k", 
           RowBox[{"(", "c", ")"}]], "\[InvisibleSpace]", 
          SubsuperscriptBox["\[Zeta]", 
           RowBox[{"k", "'"}], 
           RowBox[{"(", "c", ")"}]]}]}]}], " ", "=", " ", "0"}]}]},
    {
     RowBox[{
      SubscriptBox["tr", "2"], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", "k", "\[InvisibleSpace]"], 
       "\[VeryThinSpace]  ", 
       RowBox[{
        FractionBox[
         RowBox[{"4", 
          SuperscriptBox[
           SubsuperscriptBox["\[Alpha]", "k", 
            RowBox[{"(", "j", ")"}]], "2"]}], 
         RowBox[{
          SubscriptBox["m", "k"], 
          SubsuperscriptBox["\[Alpha]", "k", 
           RowBox[{"(", 
            RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]]}]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", 
           SuperscriptBox[
            RowBox[{
             SubsuperscriptBox["\[Alpha]", "k", 
              RowBox[{"(", 
               RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], "(", 
             SubsuperscriptBox["\[Zeta]", "k", 
              RowBox[{"(", "c", ")"}]], ")"}], "2"]}], "+", "1"}], ")"}]}]}]}]}
