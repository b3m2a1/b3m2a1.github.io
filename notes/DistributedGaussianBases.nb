 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["M", "1", 
       RowBox[{"(", 
        RowBox[{"i", ",", "j"}], ")"}]], " ", "=", " ", "1"}]},
    {
     RowBox[{
      SubsuperscriptBox["M", "2", 
       RowBox[{"(", 
        RowBox[{"i", ",", "j"}], ")"}]], " ", "=", " ", 
      RowBox[{"1", "-", 
       FractionBox[
        SuperscriptBox[
         SubsuperscriptBox["p", "s", 
          RowBox[{"(", 
           RowBox[{"i", ",", "j"}], ")"}]], "2"], 
        RowBox[{"2", "\[InvisibleSpace]", 
         SubsuperscriptBox["\[Alpha]", "s", 
          RowBox[{"(", 
           RowBox[{"i", ",", "j"}], ")"}]]}]]}]}]},
    {
     RowBox[{
      SubsuperscriptBox["M", "3", 
       RowBox[{"(", 
        RowBox[{"i", ",", "j"}], ")"}]], " ", "=", " ", 
      RowBox[{"3", "-", 
       FractionBox[
        SuperscriptBox[
         SubsuperscriptBox["p", "s", 
          RowBox[{"(", 
           RowBox[{"i", ",", "j"}], ")"}]], "2"], 
        RowBox[{"2", "\[InvisibleSpace]", 
         SubsuperscriptBox["\[Alpha]", "s", 
          RowBox[{"(", 
           RowBox[{"i", ",", "j"}], ")"}]]}]]}]}]},
    {
     RowBox[{
      SubsuperscriptBox["M", "4", 
       RowBox[{"(", 
        RowBox[{"i", ",", "j"}], ")"}]], " ", "=", " ", 
      RowBox[{"3", "-", 
       FractionBox[
        RowBox[{"6", 
         SuperscriptBox[
          SubsuperscriptBox["p", "s", 
           RowBox[{"(", 
            RowBox[{"i", ",", "j"}], ")"}]], "2"]}], 
        RowBox[{"\[InvisibleSpace]", 
         RowBox[{"2", 
          SubsuperscriptBox["\[Alpha]", "s", 
           RowBox[{"(", 
            RowBox[{"i", ",", "j"}], ")"}]]}]}]], "+", 
       FractionBox[
        SuperscriptBox[
         SubsuperscriptBox["p", "s", 
          RowBox[{"(", 
           RowBox[{"i", ",", "j"}], ")"}]], "4"], 
        RowBox[{"4", "\[InvisibleSpace]", 
         SubsuperscriptBox["\[Alpha]", "s", 
          RowBox[{"(", 
           RowBox[{"i", ",", "j"}], ")"}]]}]]}]}]}
