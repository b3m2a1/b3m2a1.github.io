  3.914176232417345*^9}},ExpressionUUID->"baefaf1e-4708-46ce-9698-\
21b2be49b87e"]
}, Closed]],

Cell[CellGroupData[{

Cell["Old Pretranspose Note ;___;", "Subsubsubsubsubsection",
 CellChangeTimes->{{3.914166352804349*^9, 
  3.91416636135126*^9}},ExpressionUUID->"04b79672-710a-4549-ac0a-\
0e63c4cb6ef5"],

Cell["\<\
One nice thing to note here is that we get no contribution from anything of \
the form\
\>", "ExpositoryText",
 CellChangeTimes->{{3.9141216492926188`*^9, 3.9141216576519423`*^9}, {
  3.9141216970020857`*^9, 
  3.914121701259666*^9}},ExpressionUUID->"630af780-a175-4714-ad69-\
fcf90c69e7fa"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["S", "1"], "\[CircleTimes]", 
   SubscriptBox["S", "2"]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9141216595340443`*^9, 
  3.91412167747157*^9}},ExpressionUUID->"553a9efb-ea3b-4538-8b80-\
e624419d8e6c"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "1"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "c59e395e-a3c9-4d3d-9691-6c141816613b"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "2"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "3d7efd0d-3126-44ef-9a6e-586324a0e638"],
 " are symmetric matrices, because the total Coriolis contribution is \
antisymmetric"
}], "ExpositoryText",
 CellChangeTimes->{{3.9141216786196938`*^9, 
  3.914121721151758*^9}},ExpressionUUID->"ac5c68e5-97cd-497a-89cc-\
c301c2e64980"],

Cell["That means we only pick up a contribution from", "ExpositoryText",
 CellChangeTimes->{{3.9141217224514103`*^9, 
  3.914121728848929*^9}},ExpressionUUID->"b3862111-8cc8-4bab-8928-\
d1772241cca6"],

Cell[BoxData[
 FormBox[
  StyleBox[
   TemplateBox[{"\"(\"", 
     TemplateBox[{"\[Xi]", 
       TemplateBox[{"\"(\"", "c", "\")\""}, "RowDefault"]}, "Superscript", 
      SyntaxForm -> SuperscriptBox], "\"\[CircleTimes]\"", 
     TemplateBox[{"\"(\"", "\[CapitalIota]", "\"\[CircleTimes]\"", 
       TemplateBox[{
         TemplateBox[{"\[CapitalSigma]", 
           TemplateBox[{"\"(\"", "d", "\")\""}, "RowDefault"]}, "Superscript",
           SyntaxForm -> SuperscriptBox], "\"\[CapitalDelta]\""}, 
        "RowDefault"], "\")\""}, "RowDefault"], "\")\""},
    "RowDefault"],
   StripOnInput->False,
   ShowStringCharacters->False,
   FontSize->18], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.914121734304538*^9, 
  3.9141217348083773`*^9}},ExpressionUUID->"9075b537-d524-471d-aaca-\
4184f611adfa"],

Cell[TextData[{
 "and even then the contribution is incredibly sparse, as the ",
 Cell[BoxData[
  FormBox["I", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "ceb42f36-9a94-4f5b-8ec7-aac10c1bbd0d"],
 " in the center is only non-zero for Coriolis terms that share the middle \
indices, i.e. of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Zeta]", 
     RowBox[{"i", "\[InvisibleSpace]", "j"}], "\[Alpha]"], 
    SubsuperscriptBox["\[Zeta]", 
     RowBox[{"j", "\[InvisibleSpace]", "k"}], "\[Alpha]"]}], 
   TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "bc15c7f3-b1d3-4ae7-8529-da533e85c982"],
 " and that is only non-zero when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "\[NotEqual]", "j"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "071b8999-c5d3-401a-8508-35b64d6d4aa5"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "\[NotEqual]", "j"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "faa39b2c-e7c1-42e4-a6a4-04b9287d274d"],
 ", although ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "=", "k"}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "32804c85-0ee8-4c84-bbb3-4fb1328f6006"],
 " is fine, giving us ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SuperscriptBox[
     SubsuperscriptBox["\[Zeta]", 
      RowBox[{"i", "\[InvisibleSpace]", "j"}], "\[Alpha]"], "2"]}], 
   TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "11f49d53-4d27-438b-a751-ccf6174b5874"],
 ", and in fact we also know that we\[CloseCurlyQuote]ll double up on the \
other terms, since (by two antisymmetries)"
}], "ExpositoryText",
 CellChangeTimes->{{3.914121738227167*^9, 3.9141217844116287`*^9}, {
  3.914121823551292*^9, 3.914121885374176*^9}, {3.9141229896553993`*^9, 
  3.91412304601827*^9}},ExpressionUUID->"cdba4fe0-0b67-4a46-b6e8-\
1d585fb15c76"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[Zeta]", 
     RowBox[{"i", "\[InvisibleSpace]", "j"}], "\[Alpha]"], 
    SubsuperscriptBox["\[Zeta]", 
     RowBox[{"j", "\[InvisibleSpace]", "k"}], "\[Alpha]"]}], " ", "=", " ", 
   RowBox[{
    SubsuperscriptBox["\[Zeta]", 
     RowBox[{"k", "\[InvisibleSpace]", "j"}], "\[Alpha]"], 
    SubsuperscriptBox["\[Zeta]", 
     RowBox[{"j", "\[InvisibleSpace]", "i"}], "\[Alpha]"]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9141230347047033`*^9, 
  3.914123056711529*^9}},ExpressionUUID->"887ae20f-5f69-45f7-962c-\
96f1dcb302b6"],

Cell["Finally, let\[CloseCurlyQuote]s unroll some notation,", "ExpositoryText",
 CellChangeTimes->{{3.9141231340752087`*^9, 
  3.9141231607793007`*^9}},ExpressionUUID->"0e006adc-222b-462f-aeb0-\
add5bf15df3d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["\[CapitalSigma]", 
     RowBox[{"(", "d", ")"}]], "\[CapitalDelta]"}], " ", "=", " ", 
   RowBox[{
    SuperscriptBox["\[CapitalSigma]", 
     SuperscriptBox[
      RowBox[{"(", "j", ")"}], 
      RowBox[{"-", "1"}]]], 
    SuperscriptBox["\[CapitalSigma]", 
     RowBox[{"(", "c", ")"}]], 
    RowBox[{
     SuperscriptBox["\[CapitalSigma]", 
      SuperscriptBox[
       RowBox[{"(", "i", ")"}], 
       RowBox[{"-", "1"}]]], "(", 
     RowBox[{
      SuperscriptBox["\[Xi]", 
       RowBox[{"(", "i", ")"}]], "-", 
      SuperscriptBox["\[Xi]", 
       RowBox[{"(", "j", ")"}]]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.91412314430715*^9, 3.914123214431793*^9}, {
  3.914123261252643*^9, 
  3.914123288836413*^9}},ExpressionUUID->"b350d07d-4787-4ade-b16a-\
e646fd4b009c"],

Cell["Therefore we end up with", "ExpositoryText",
 CellChangeTimes->{{3.914123058345417*^9, 
  3.914123070052898*^9}},ExpressionUUID->"82f6b207-930e-4891-9046-\
d3c0d95949d3"],

Cell[BoxData[
 FormBox[
  RowBox[{"-", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{"n", ",", "k", ",", "m"}]], " ", 
    RowBox[{
     SubsuperscriptBox["\[Zeta]", 
      RowBox[{"n", "\[InvisibleSpace]", "k"}], "\[Alpha]"], 
     SubscriptBox[
      RowBox[{
       SubsuperscriptBox["\[Zeta]", 
        RowBox[{"k", "\[InvisibleSpace]", "m"}], "\[Alpha]"], "(", 
       SuperscriptBox["\[Xi]", 
        RowBox[{"(", "c", ")"}]], ")"}], "n"], 
     SubscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["\[CapitalSigma]", 
         SuperscriptBox[
          RowBox[{"(", "j", ")"}], 
          RowBox[{"-", "1"}]]], 
        SuperscriptBox["\[CapitalSigma]", 
         RowBox[{"(", "c", ")"}]], 
        RowBox[{
         SuperscriptBox["\[CapitalSigma]", 
          SuperscriptBox[
           RowBox[{"(", "i", ")"}], 
           RowBox[{"-", "1"}]]], "(", 
         RowBox[{
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", "i", ")"}]], "-", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", "j", ")"}]]}], ")"}]}], ")"}], "m"]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.914122940645288*^9, 3.914122958260008*^9}, {
   3.91412307956153*^9, 3.914123111305431*^9}, {3.914123272827894*^9, 
   3.914123357292695*^9}, 3.914123439260004*^9, 
   3.914127036684414*^9},ExpressionUUID->"f6551e6e-2232-4c80-a001-\
697999f6f6a7"],

Cell[TextData[{
 "which in turn has some nice simplifications, in particular we can do ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", " ", ">", " ", "m"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "5e18c32b-4255-44b8-8d60-a3398b36e862"],
 " and double and then do the squaring for the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "m"}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "1bb50ed9-0928-4835-a085-04b3b313ca01"],
 " case, but all of that seems like details given that this is already \
symmetric...wait no it\[CloseCurlyQuote]s antisymetric...which suggests it \
cancels something else..."
}], "ExpositoryText",
 CellChangeTimes->{{3.914123358872336*^9, 3.914123375057865*^9}, {
  3.914123440859907*^9, 3.914123468969936*^9}, {3.9141261516060057`*^9, 
  3.914126155231647*^9}, {3.91412622087472*^9, 3.914126243543152*^9}, {
  3.914126282107708*^9, 3.9141262825550957`*^9}, {3.9141270486019297`*^9, 
  3.9141270566566477`*^9}},ExpressionUUID->"173c79ac-66eb-4261-9a6e-\
996ea2cc9d45"]
}, Closed]],

