Cell["\<\
and as a final note, this can be made more useful by considering that\
\>", "ExpositoryText",
 CellChangeTimes->{{3.884107601027686*^9, 3.884107602073223*^9}, {
  3.914977816374708*^9, 
  3.91497783247859*^9}},ExpressionUUID->"3b924509-5eb1-4ce0-a79f-\
5cc9a5148a97"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"det", "(", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[CapitalSigma]", "i"], "+", 
          SubscriptBox["\[CapitalSigma]", "j"]}], ")"}], 
        RowBox[{"-", "1"}]], ")"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"det", "(", 
        SuperscriptBox[
         SubscriptBox["\[CapitalSigma]", "i"], 
         RowBox[{"-", "1"}]], ")"}], 
       RowBox[{"det", "(", 
        SubscriptBox["\[CapitalSigma]", "c"], ")"}], 
       RowBox[{"det", "(", 
        SuperscriptBox[
         SubscriptBox["\[CapitalSigma]", "j"], 
         RowBox[{"-", "1"}]], ")"}]}]}]},
    {
     RowBox[{
      RowBox[{"\[Implies]", " ", 
       RowBox[{"det", "(", 
        SubscriptBox["\[CapitalSigma]", "c"], ")"}]}], " ", "=", " ", 
      FractionBox[
       RowBox[{"det", "(", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[CapitalSigma]", "i"], "+", 
           SubscriptBox["\[CapitalSigma]", "j"]}], ")"}], 
         RowBox[{"-", "1"}]], ")"}], 
       RowBox[{
        RowBox[{"det", "(", 
         SuperscriptBox[
          SubscriptBox["\[CapitalSigma]", "i"], 
          RowBox[{"-", "1"}]], ")"}], 
        RowBox[{"det", "(", 
         SuperscriptBox[
          SubscriptBox["\[CapitalSigma]", "j"], 
          RowBox[{"-", "1"}]], ")"}]}]]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.884107604595756*^9, 3.884107646162459*^9}, {
  3.884108150528174*^9, 3.884108174667344*^9}, {3.884222589075369*^9, 
  3.884222596038597*^9}},ExpressionUUID->"e80443f1-f6db-495c-bc54-\
27a98febb377"],

Cell[TextData[{
 "And to confirm we\[CloseCurlyQuote]re on the right track, we can note that \
in the case that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalSigma]", "i"], TraditionalForm]],
  CellChangeTimes->{{3.88384740674933*^9, 3.883847408513365*^9}, {
   3.883853378968896*^9, 3.883853439863595*^9}, {3.883853800701524*^9, 
   3.8838538132781153`*^9}},ExpressionUUID->
  "cf94862f-ce7f-49b8-ba95-3865f7ad1ddd"],
 " is diagonal with diagonal entries ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1", "/", "2"}], "\[VeryThinSpace]", 
    SubsuperscriptBox["\[Alpha]", "k", 
     RowBox[{"(", "i", ")"}]]}], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"ca6a041b-f999-46aa-87bf-db66b40422ff"],
 " and similarly with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalSigma]", "j"], TraditionalForm]],
  CellChangeTimes->{{3.88384740674933*^9, 3.883847408513365*^9}, {
   3.883853378968896*^9, 3.883853439863595*^9}, {3.883853800701524*^9, 
   3.8838538132781153`*^9}},ExpressionUUID->
  "1edbb00a-e25b-460b-a05a-e7d5b0885897"],
 " we get"
}], "ExpositoryText",
 CellChangeTimes->{{3.884023770349765*^9, 3.884023819737399*^9}, {
  3.884023860555401*^9, 3.884023866732956*^9}, {3.884057606520034*^9, 
  3.884057615789604*^9}, {3.884087290795803*^9, 
  3.884087297300268*^9}},ExpressionUUID->"8c696d0e-befd-4de4-8007-\
b0f8114d8dbd"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"W", "(", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[CapitalSigma]", "i"], "+", 
         SubscriptBox["\[CapitalSigma]", "j"]}], ",", " ", 
        RowBox[{
         SubscriptBox["\[Xi]", "i"], "-", 
         SubscriptBox["\[Xi]", "j"]}]}], ")"}], " ", "=", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          FractionBox["1", 
           SuperscriptBox["\[Pi]", "d"]], 
          RowBox[{
           UnderscriptBox["\[Product]", "k"], " ", 
           RowBox[{"2", 
            RowBox[{"(", 
             FractionBox[
              RowBox[{
               SubsuperscriptBox["\[Alpha]", "k", 
                RowBox[{"(", "i", ")"}]], 
               SubsuperscriptBox["\[Alpha]", "k", 
                RowBox[{"(", "j", ")"}]]}], 
              RowBox[{
               SubsuperscriptBox["\[Alpha]", "k", 
                RowBox[{"(", "i", ")"}]], "+", 
               SubsuperscriptBox["\[Alpha]", "k", 
                RowBox[{"(", "j", ")"}]]}]], ")"}]}]}]}], ")"}], 
        RowBox[{"1", "/", "4"}]], 
       RowBox[{
        UnderscriptBox["\[Product]", "k"], " ", 
        RowBox[{"exp", "(", 
         RowBox[{
          RowBox[{"-", 
           FractionBox[
            RowBox[{
             SubsuperscriptBox["\[Alpha]", "k", 
              RowBox[{"(", "i", ")"}]], 
             SubsuperscriptBox["\[Alpha]", "k", 
              RowBox[{"(", "j", ")"}]]}], 
            RowBox[{
             SubsuperscriptBox["\[Alpha]", "k", 
              RowBox[{"(", "i", ")"}]], "+", 
             SubsuperscriptBox["\[Alpha]", "k", 
              RowBox[{"(", "j", ")"}]]}]]}], 
          StyleBox[
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              SubsuperscriptBox["\[Xi]", "k", 
               RowBox[{"(", "i", ")"}]], "-", "\[VeryThinSpace]", 
              SubsuperscriptBox["\[Xi]", "k", 
               RowBox[{"(", "j", ")"}]]}], ")"}], "2"],
           FontSize->14]}], 
         StyleBox[")",
          FontSize->14]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox["2", "\[Pi]"], ")"}], 
        RowBox[{"d", "/", "4"}]], 
       RowBox[{
        UnderscriptBox["\[Product]", "k"], " ", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            RowBox[{
             SubsuperscriptBox["\[Alpha]", "k", 
              RowBox[{"(", "i", ")"}]], 
             SubsuperscriptBox["\[Alpha]", "k", 
              RowBox[{"(", "j", ")"}]]}], 
            RowBox[{
             SubsuperscriptBox["\[Alpha]", "k", 
              RowBox[{"(", "i", ")"}]], "+", 
             SubsuperscriptBox["\[Alpha]", "k", 
              RowBox[{"(", "j", ")"}]]}]], ")"}], 
          RowBox[{"1", "/", "4"}]], 
         RowBox[{"exp", "(", 
          RowBox[{
           RowBox[{"-", 
            StyleBox[
             FractionBox[
              RowBox[{
               SubsuperscriptBox["\[Alpha]", "k", 
                RowBox[{"(", "i", ")"}]], 
               SubsuperscriptBox["\[Alpha]", "k", 
                RowBox[{"(", "j", ")"}]]}], 
              RowBox[{
               SubsuperscriptBox["\[Alpha]", "k", 
                RowBox[{"(", "i", ")"}]], "+", 
               SubsuperscriptBox["\[Alpha]", "k", 
                RowBox[{"(", "j", ")"}]]}]],
             FontSize->14]}], 
           StyleBox[
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               SubsuperscriptBox["\[Xi]", "k", 
                RowBox[{"(", "i", ")"}]], "-", "\[VeryThinSpace]", 
               SubsuperscriptBox["\[Xi]", "k", 
                RowBox[{"(", "j", ")"}]]}], ")"}], "2"],
            FontSize->14]}], 
          StyleBox[")",
           FontSize->14]}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.884023882692585*^9, 3.884023882708694*^9}, {
   3.8840239186935797`*^9, 3.884024022328162*^9}, {3.884024063976097*^9, 
   3.884024086653542*^9}, {3.884024128910924*^9, 3.88402415098384*^9}, {
