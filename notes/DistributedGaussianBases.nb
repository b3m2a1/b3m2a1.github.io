   RowBox[{
    FractionBox["1", 
     SqrtBox[
      RowBox[{"n", "!"}]]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"\[Lambda]", "\[VeryThinSpace]", "=", "0"}], "n"], 
     "\[VeryThinSpace]\[VeryThinSpace]", 
     SuperscriptBox[
      RowBox[{
       SubsuperscriptBox["P", 
        RowBox[{"n", ",", "\[Lambda]"}], 
        RowBox[{"(", "i", ")"}]], "(", 
       RowBox[{"x", 
        StyleBox["\[VeryThinSpace] ",
         FontSize->14], 
        StyleBox["-",
         FontSize->14], 
        StyleBox[" ",
         FontSize->14], 
        SuperscriptBox["\[Xi]", 
         RowBox[{"(", 
          RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]]}], ")"}], 
      "\[Lambda]"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8860956515298634`*^9, 3.8860956734250174`*^9}, {
   3.886095718728961*^9, 3.886095755584618*^9}, {3.886095804302402*^9, 
