   3.907554957836288*^9},ExpressionUUID->"2006596c-4c1a-4dcd-81ee-\
9a5b6fed1971"],

Cell["\<\
and now I have to do some gymnastics to figure out how everything cancels, in \
particular I guess I have something like\
\>", "ExpositoryText",
 CellChangeTimes->{{3.907552422313036*^9, 3.9075524293743668`*^9}, {
  3.907552465438161*^9, 3.907552480552826*^9}, {3.907552743006906*^9, 
  3.907552745091707*^9}},ExpressionUUID->"f87aa247-c0db-43eb-a14a-\
a9b400520672"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       UnderscriptBox["\[Sum]", "k"], " ", 
       FractionBox[
        SubsuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubsuperscriptBox["\[CapitalSigma]", "j", 
            RowBox[{"-", "1"}]], 
           SuperscriptBox["L", "T"]}], ")"}], 
         RowBox[{"n", "\[InvisibleSpace]", "k"}], "2"], 
        SubsuperscriptBox["\[Alpha]", "k", 
         RowBox[{"(", "c", ")"}]]]}], " ", "=", " ", 
      RowBox[{
       SubscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["\[CapitalSigma]", "j", 
          RowBox[{"-", "1"}]], ")"}], 
        RowBox[{"n", ":"}]], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["L", "T"], 
         SubsuperscriptBox["A", "c", 
          RowBox[{"-", "1"}]], "L"}], ")"}], 
       SubscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["\[CapitalSigma]", "j", 
          RowBox[{"-", "1"}]], ")"}], 
        RowBox[{":", "n"}]]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SubscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["\[CapitalSigma]", "j", 
          RowBox[{"-", "1"}]], ")"}], 
        RowBox[{"n", ":"}]], 
       SubscriptBox[
        RowBox[{
         SubscriptBox["\[CapitalSigma]", "c"], "(", 
         SubsuperscriptBox["\[CapitalSigma]", "j", 
          RowBox[{"-", "1"}]], ")"}], 
        RowBox[{":", "n"}]]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SubscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["\[CapitalSigma]", "j", 
          RowBox[{"-", "1"}]], ")"}], 
        RowBox[{"n", ":"}]], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox["\[CapitalSigma]", "i", 
           RowBox[{"-", "1"}]], "+", 
          SubsuperscriptBox["\[CapitalSigma]", "j", 
           RowBox[{"-", "1"}]]}], ")"}], 
        RowBox[{"-", "1"}]], 
       SubscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["\[CapitalSigma]", "j", 
          RowBox[{"-", "1"}]], ")"}], 
        RowBox[{":", "n"}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.907554451453363*^9, 3.907554543689467*^9}, {
  3.907554829911407*^9, 3.90755488057736*^9}, {3.907554955000598*^9, 
  3.907554991362665*^9}, {3.907555181150929*^9, 3.9075552394762897`*^9}, {
  3.907555297057481*^9, 3.907555335001177*^9}, {3.9075554369830008`*^9, 
  3.907555437273491*^9}},ExpressionUUID->"ce1300ad-b76e-4793-8a35-\
f21f1f621cff"],

Cell["Next we\[CloseCurlyQuote]ll use the Woodbury identity to write", \
"ExpositoryText",
 CellChangeTimes->{{3.907555439278661*^9, 
  3.907555449338365*^9}},ExpressionUUID->"d43b47ae-743b-4714-b6cb-\
f0b7af5e764d"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["\[CapitalSigma]", "i", 
          RowBox[{"-", "1"}]], "+", 
         SubsuperscriptBox["\[CapitalSigma]", "j", 
          RowBox[{"-", "1"}]]}], ")"}], 
       RowBox[{"-", "1"}]], " ", "=", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SuperscriptBox["L", 
           RowBox[{"(", "i", ")"}]], 
          SubscriptBox["A", "i"], 
          SuperscriptBox[
           SuperscriptBox["L", 
            RowBox[{"(", "i", ")"}]], "T"]}], "+", 
         SubsuperscriptBox["\[CapitalSigma]", "j", 
          RowBox[{"-", "1"}]]}], ")"}], 
       RowBox[{"-", "1"}]]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SubscriptBox["\[CapitalSigma]", "j"], " ", "-", " ", 
       RowBox[{
        SubscriptBox["\[CapitalSigma]", "j"], " ", 
        SuperscriptBox[
         RowBox[{
          SuperscriptBox["L", 
           RowBox[{"(", "i", ")"}]], "(", 
          RowBox[{
           SubsuperscriptBox["A", "i", 
            RowBox[{"-", "1"}]], " ", "+", " ", 
           RowBox[{
            SuperscriptBox[
             SuperscriptBox["L", 
              RowBox[{"(", "i", ")"}]], "T"], 
            SubscriptBox["\[CapitalSigma]", "j"], 
            SuperscriptBox["L", 
             RowBox[{"(", "i", ")"}]]}]}], ")"}], 
         RowBox[{"-", "1"}]], 
        SuperscriptBox[
         SuperscriptBox["L", 
          RowBox[{"(", "i", ")"}]], "T"], 
        SubscriptBox["\[CapitalSigma]", "j"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9075555330319138`*^9, 3.907555588615505*^9}, {
  3.907555620271371*^9, 3.907555698827649*^9}, {3.9075559284310627`*^9, 
  3.907555940821553*^9}},ExpressionUUID->"97499170-9d08-429f-a6c2-\
fdcbcff4f8e5"],

Cell["which seems nasty, but we\[CloseCurlyQuote]ll note that", \
"ExpositoryText",
 CellChangeTimes->{{3.907555714636321*^9, 
  3.9075557288753767`*^9}},ExpressionUUID->"e8245aff-e63e-4af4-988f-\
6d898d035b66"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["A", "i", 
        RowBox[{"-", "1"}]], " ", "+", " ", 
       RowBox[{
        SuperscriptBox["L", 
         RowBox[{"(", "i", ")"}]], 
        SubscriptBox["\[CapitalSigma]", "j"], 
        SuperscriptBox[
         SuperscriptBox["L", 
          RowBox[{"(", "i", ")"}]], "T"]}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         SuperscriptBox["L", 
          RowBox[{"(", "i", ")"}]], "T"], 
        SubscriptBox["\[CapitalSigma]", "i"], 
        SuperscriptBox["L", 
         RowBox[{"(", "i", ")"}]]}], " ", "+", " ", 
       RowBox[{
        SuperscriptBox[
         SuperscriptBox["L", 
          RowBox[{"(", "i", ")"}]], "T"], 
        SubscriptBox["\[CapitalSigma]", "j"], 
        SuperscriptBox["L", 
         RowBox[{"(", "i", ")"}]]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         SuperscriptBox["L", 
          RowBox[{"(", "i", ")"}]], "T"], "(", 
        RowBox[{
         SubscriptBox["\[CapitalSigma]", "i"], "+", 
         SubscriptBox["\[CapitalSigma]", "j"]}], ")"}], 
       SuperscriptBox["L", 
        RowBox[{"(", "i", ")"}]]}]}]},
    {
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SuperscriptBox[
           SuperscriptBox["L", 
            RowBox[{"(", "i", ")"}]], "T"], "(", 
          RowBox[{
           SubscriptBox["\[CapitalSigma]", "i"], "+", 
           SubscriptBox["\[CapitalSigma]", "j"]}], ")"}], 
         SuperscriptBox["L", 
          RowBox[{"(", "i", ")"}]]}], ")"}], 
       RowBox[{"-", "1"}]], " ", "=", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{
         SuperscriptBox[
          SuperscriptBox["L", 
           RowBox[{"(", "i", ")"}]], "T"], "(", 
         RowBox[{
          SubscriptBox["\[CapitalSigma]", "i"], "+", 
          SubscriptBox["\[CapitalSigma]", "j"]}], ")"}], 
        RowBox[{"-", "1"}]], 
       SuperscriptBox["L", 
        RowBox[{"(", "i", ")"}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.907555722217861*^9, 3.907555842752862*^9}, {
  3.9075558768420553`*^9, 3.907555908175251*^9}, {3.9075559463051243`*^9, 
