ee610985c84c"],

Cell["and the momentum contributions add, giving us", "ExpositoryText",
 CellChangeTimes->{{3.9161700754713078`*^9, 3.916170077598207*^9}, {
  3.916170145044446*^9, 
  3.9161701576869793`*^9}},ExpressionUUID->"50734440-65f1-44cd-b3af-\
d340aea60843"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"\[Integral]", "..."}], "."}], 
       SubsuperscriptBox["X", "0", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]]], "=", 
      RowBox[{
       RowBox[{
        UnderscriptBox["\[Sum]", "s"], " ", 
        FractionBox[
         RowBox[{
          SubsuperscriptBox["V", "n", 
           RowBox[{"(", "1", ")"}]], "\[InvisibleSpace]", 
          RowBox[{
           RowBox[{
            SubsuperscriptBox["L", "s", 
             RowBox[{"(", 
              RowBox[{"i", ",", "j"}], ")"}]], "\[Transpose]"}], 
           "\[CircleTimes]", 
           SubsuperscriptBox["V", "m", 
            RowBox[{"(", "2", ")"}]]}], "\[InvisibleSpace]", 
          RowBox[{
           SubsuperscriptBox["L", "t", 
            RowBox[{"(", 
             RowBox[{"i", ",", "j"}], ")"}]], "\[Transpose]"}]}], 
         RowBox[{"2", 
          SubsuperscriptBox["\[Alpha]", "s", 
           RowBox[{"(", 
            RowBox[{"i", ",", "j"}], ")"}]]}]]}], " ", "-", " ", 
       RowBox[{
        UnderscriptBox["\[Sum]", "s"], 
        RowBox[{
         FractionBox[
          RowBox[{
           SubsuperscriptBox["V", "n", 
            RowBox[{"(", "1", ")"}]], "\[InvisibleSpace]", 
           RowBox[{
            SubsuperscriptBox["L", "s", 
             RowBox[{"(", 
              RowBox[{"i", ",", "j"}], ")"}]], "\[Transpose]"}], 
           SubsuperscriptBox["p", "s", 
            RowBox[{"(", 
             RowBox[{"i", ",", "j"}], ")"}]]}], 
          RowBox[{"2", 
           SubsuperscriptBox["\[Alpha]", "s", 
            RowBox[{"(", 
             RowBox[{"i", ",", "j"}], ")"}]]}]], 
         RowBox[{
          UnderscriptBox["\[Sum]", "t"], " ", 
          FractionBox[
           RowBox[{
            SubsuperscriptBox["V", "m", 
             RowBox[{"(", "2", ")"}]], "\[InvisibleSpace]", 
            RowBox[{
             SubsuperscriptBox["L", "t", 
              RowBox[{"(", 
               RowBox[{"i", ",", "j"}], ")"}]], "\[Transpose]"}], 
            SubsuperscriptBox["p", "t", 
             RowBox[{"(", 
              RowBox[{"i", ",", "j"}], ")"}]]}], 
           RowBox[{"2", 
            SubsuperscriptBox["\[Alpha]", "t", 
             RowBox[{"(", 
              RowBox[{"i", ",", "j"}], ")"}]]}]]}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SubscriptBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["V", 
           RowBox[{"(", "1", ")"}]], "\[InvisibleSpace]", 
          SuperscriptBox["\[CapitalSigma]", 
           RowBox[{"(", 
            RowBox[{"i", ",", "j"}], ")"}]], "\[InvisibleSpace]", 
          SuperscriptBox["V", 
           RowBox[{"(", "2", ")"}]]}], ")"}], 
        RowBox[{"n", "\[InvisibleSpace]", "m"}]], " ", "-", " ", 
       RowBox[{
        SubscriptBox[
         RowBox[{"(", "\[InvisibleSpace]", 
          RowBox[{
           SuperscriptBox["V", 
            RowBox[{"(", "1", ")"}]], "\[InvisibleSpace]", 
           SuperscriptBox["\[Rho]", 
            RowBox[{"(", 
             RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], "n"], 
        SubscriptBox[
         RowBox[{"(", "\[InvisibleSpace]", 
          RowBox[{
           SuperscriptBox["V", 
            RowBox[{"(", "2", ")"}]], "\[InvisibleSpace]", 
           SuperscriptBox["\[Rho]", 
            RowBox[{"(", 
             RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], "m"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
