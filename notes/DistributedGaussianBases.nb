7548a2416e6a"],

Cell["\<\
and for exactly the same reason as above this will be anti-symmetric, since \
\[CapitalDelta] is\
\>", "ExpositoryText",
 CellChangeTimes->{{3.9162848024174137`*^9, 
  3.916284820276237*^9}},ExpressionUUID->"b7f16985-aaf1-47f6-8e9b-\
d6c535206cb9"],

Cell[TextData[{
 "So in total, taking ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "J"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "fd5efc00-494e-4b8f-b9c5-c0d6651c2e8e"],
 " from above we get"
}], "ExpositoryText",
