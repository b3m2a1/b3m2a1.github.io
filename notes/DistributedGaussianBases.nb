  3.886775788627327*^9}},ExpressionUUID->"57becae4-c94e-40c3-b2ab-\
351b6ad4c82a"],

Cell["\<\
and in the case that we have perfect decoupling of translation and vibration \
we get\
\>", "ExpositoryText",
 CellChangeTimes->{{3.886775793654125*^9, 
  3.8867758072156677`*^9}},ExpressionUUID->"b47d35ba-77c9-4897-8105-\
e7b17d9568d4"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox["\[Xi]", 
       RowBox[{"(", "c", ")"}]], " ", "=", " ", 
      RowBox[{
       SuperscriptBox["\[CapitalSigma]", 
        RowBox[{"(", "c", ")"}]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SuperscriptBox[
           SuperscriptBox["\[CapitalSigma]", 
            RowBox[{"(", "i", ")"}]], 
           RowBox[{"-", "1"}]], "\[InvisibleSpace]", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", "i", ")"}]]}], " ", "+", " ", 
         RowBox[{
          SuperscriptBox[
           SuperscriptBox["\[CapitalSigma]", 
            RowBox[{"(", "j", ")"}]], 
           RowBox[{"-", "1"}]], "\[InvisibleSpace]", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", "j", ")"}]]}]}], ")"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SuperscriptBox["\[CapitalSigma]", 
        RowBox[{"(", "c", ")"}]], "(", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          RowBox[{"L", "(", 
           SuperscriptBox["\[CapitalLambda]", 
            RowBox[{"(", "i", ")"}]], ")"}], 
          RowBox[{"-", "1"}]], 
         SuperscriptBox["L", 
          StyleBox["T",
           FontSize->9,
           FontSlant->"Plain"]], 
         SuperscriptBox["\[Xi]", 
          RowBox[{"(", "i", ")"}]]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"L", "(", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"R", "(", 
             SuperscriptBox["\[CapitalLambda]", 
              RowBox[{"(", "j", ")"}]], ")"}], 
            RowBox[{"-", "1"}]], 
           SuperscriptBox["R", 
            StyleBox["T",
             FontSize->9,
             FontSlant->"Plain"]]}], ")"}], 
         SuperscriptBox["L", 
          StyleBox["T",
           FontSize->9,
           FontSlant->"Plain"]], 
         SuperscriptBox["\[Xi]", 
          RowBox[{"(", "j", ")"}]]}]}], ")"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8838473346089563`*^9, 3.8838473971907187`*^9}, {
  3.884087072420064*^9, 3.884087114362184*^9}, {3.884222365479918*^9, 
  3.884222366230082*^9}, {3.886774151152071*^9, 3.886774198980187*^9}, {
  3.8867755797373962`*^9, 3.886775585705434*^9}, {3.88677568330079*^9, 
  3.886775690038781*^9}, {3.886775723413805*^9, 3.886775735234928*^9}, {
  3.886775786169845*^9, 
  3.886775788627327*^9}},ExpressionUUID->"9ca47e86-dcbb-4137-8656-\
3bd4387286e3"]
}, Closed]],

Cell[CellGroupData[{

Cell["Initializing Runs", "Section",
 CellChangeTimes->{{3.885897669374407*^9, 
  3.885897671650408*^9}},ExpressionUUID->"322a18f4-97b2-4b11-82ad-\
28fe03f774b7"],

Cell["\<\
A common thing we\[CloseCurlyQuote]ll want to do is put some amount of \
vibrational energy into the different normal modes to start a calculation. \
Given that these modes are linear combinations of the various internals, it\
\[CloseCurlyQuote]s not entirely obvious how to do this. \
\>", "ExpositoryText",
 CellChangeTimes->{{3.885897672875001*^9, 
  3.885897743809812*^9}},ExpressionUUID->"7308bcbf-19aa-48b9-bae8-\
7024cb669070"],

Cell[TextData[{
 "Assume we\[CloseCurlyQuote]re given some energy partition, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox["E", "i"], "}"}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "a9f84f9a-b2d4-4b0f-88bc-e2834a57414e"],
 ", dictating how much kinetic energy to put into the modes, and a \
transformation from the Cartesian coordinates to the normal modes ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "9c9d725c-0525-4012-b5b1-9a112c4649ca"],
 ". First off, we know classically that"
}], "ExpositoryText",
 CellChangeTimes->{{3.885897747297257*^9, 3.885897850639888*^9}, {
  3.885898017358716*^9, 
  3.885898025943489*^9}},ExpressionUUID->"b6f70f4c-25bc-40cb-900b-\
231536bf3f31"],

Cell[BoxData[
 FormBox[
  RowBox[{"T", " ", "=", " ", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "1"}], 
      RowBox[{"3", "\[InvisibleSpace]", "N"}]], "\[VeryThinSpace]", 
     RowBox[{
      SubscriptBox["m", "k"], "\[InvisibleSpace]", 
      SuperscriptBox[
       SubscriptBox["v", "k"], "2"]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8858980278047323`*^9, 3.885898066080958*^9}, 
   3.8858983476735764`*^9, {3.88589889557975*^9, 
   3.8858989145319853`*^9}},ExpressionUUID->"1a6da1e0-8514-4c59-8166-\
6c878004ebf7"],

Cell["which we can view in matrix form as", "ExpositoryText",
 CellChangeTimes->{{3.885898078344445*^9, 
  3.8858980866497803`*^9}},ExpressionUUID->"62bb4b3b-db31-4d71-acad-\
a82c1297ce2c"],

Cell[BoxData[
 FormBox[
  RowBox[{"T", " ", "=", " ", 
   RowBox[{
    FractionBox["1", "2"], 
    SuperscriptBox["v", 
     StyleBox["T",
      FontSize->9,
      FontSlant->"Plain"]], "\[InvisibleSpace]", "M", "\[VeryThinSpace]\[InvisibleSpace]",
     "v"}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8858980278047323`*^9, 3.8858981573462467`*^9}, {
   3.885898260958255*^9, 3.8858982624633837`*^9}, 
   3.885898348558073*^9},ExpressionUUID->"034229bc-4caf-49e9-8017-\
a79b6594372f"],

Cell[TextData[{
 "use ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]], "ExpositoryMath", "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "dbc9c61a-df39-41c9-ac81-6e156275207c"],
 " to express this in terms of our vibrational coordinates as"
}], "ExpositoryText",
 CellChangeTimes->{{3.8858981900783033`*^9, 
  3.88589823497888*^9}},ExpressionUUID->"5c9182fe-41a6-4eb3-a8f2-\
abfff6d83cfb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"2", "\[InvisibleSpace]", "T"}], " ", "=", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"L", "\[InvisibleSpace]", "v"}], ")"}], 
     StyleBox["T",
      FontSize->9,
      FontSlant->"Plain"]], "\[InvisibleSpace]", 
    RowBox[{"(", 
     RowBox[{"L", "\[InvisibleSpace]", "M", "\[InvisibleSpace]", 
      SuperscriptBox["L", 
       StyleBox["T",
        FontSize->9,
        FontSlant->"Plain"]]}], ")"}], "\[VeryThinSpace]\[InvisibleSpace]", 
    RowBox[{"(", 
     RowBox[{"L", "\[InvisibleSpace]", "v"}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.885898239518375*^9, 3.885898307300125*^9}, {
  3.885898350457271*^9, 
  3.885898354095524*^9}},ExpressionUUID->"35837149-f009-49c5-882d-\
d382848bb2fc"],

Cell[TextData[{
 "and now our ",
 StyleBox["goal",
  FontSlant->"Italic"],
 " is to be able to put a certain amount of energy into each vibration \
specifically. The difficulty is that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", " ", "=", " ", 
    RowBox[{"L", "\[InvisibleSpace]", "M", "\[InvisibleSpace]", 
     SuperscriptBox["L", 
      StyleBox["T",
       FontSize->9,
       FontSlant->"Plain"]]}]}], TraditionalForm]],
  CellChangeTimes->{{3.885898239518375*^9, 3.885898307300125*^9}, {
   3.885898350457271*^9, 3.885898354095524*^9}},ExpressionUUID->
  "dfc966b9-97c2-47a2-97ed-b5ccfbb65f1c"],
 " is not necessarily diagonal, and so we can a few things"
}], "ExpositoryText",
 CellChangeTimes->{{3.885898365502722*^9, 3.885898451266428*^9}, {
  3.8858986274455757`*^9, 3.885898788039617*^9}, {3.885899051173904*^9, 
  3.885899056128735*^9}},ExpressionUUID->"6ea1b758-50ce-4a02-93e0-\
b1fd647b7388"],

Cell[CellGroupData[{

Cell["Case 1:  ignore all coupling between vibrational modes", \
"Subsubsubsubsubsection",
 CellChangeTimes->{{3.885899069393466*^9, 
  3.885899076881036*^9}},ExpressionUUID->"6b0db08f-4928-4942-8853-\
40dd71999f93"],

Cell[TextData[{
 "This corresponds to just treating ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "279c7736-ad7b-4b06-a737-8f590a49b86e"],
 " as diagonal and using these diagonal elements as effective masses. To get \
the correct total energy, though, we need to account for what\
\[CloseCurlyQuote]s missing. This means we will calculate the kinetic \
deficit, "
}], "ExpositoryText",
 CellChangeTimes->{{3.8858991192105*^9, 3.885899145772129*^9}, {
  3.8859056821591053`*^9, 
  3.885905770039508*^9}},ExpressionUUID->"aa764eaf-e0ff-45b4-a577-\
62d9a037ee1c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"2", "\[InvisibleSpace]", 
    SubscriptBox["T", "def"]}], " ", "=", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"L", "\[InvisibleSpace]", "v"}], ")"}], 
     StyleBox["T",
      FontSize->9,
      FontSlant->"Plain"]], "\[InvisibleSpace]", 
    RowBox[{
     SubscriptBox["G", "off"], "\[VeryThinSpace]\[InvisibleSpace]", "(", 
     RowBox[{"L", "\[InvisibleSpace]", "v"}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.885898239518375*^9, 3.885898307300125*^9}, {
  3.885898350457271*^9, 3.885898354095524*^9}, {3.8859057904378643`*^9, 
  3.8859057956887197`*^9}, {3.885906486113063*^9, 
  3.8859064908688307`*^9}},ExpressionUUID->"52668087-9641-4fbe-91e6-\
07e0cd44b187"],

Cell[TextData[{
 "and then we want a new set of velocities, ",
 Cell[BoxData[
  FormBox["u", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "9034ad66-c436-4267-82cf-35857e39005c"],
 ", so that "
}], "ExpositoryText",
 CellChangeTimes->{{3.88590644477879*^9, 
  3.8859064731658297`*^9}},ExpressionUUID->"66e401cc-516a-49ee-b197-\
5b3c7200a3d2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"2", "\[InvisibleSpace]", "T"}], " ", "=", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"L", "\[InvisibleSpace]", "u"}], ")"}], 
     StyleBox["T",
      FontSize->9,
      FontSlant->"Plain"]], "\[InvisibleSpace]", 
    RowBox[{"G", "\[VeryThinSpace]\[InvisibleSpace]", "(", 
     RowBox[{"L", "\[InvisibleSpace]", "u"}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.885898239518375*^9, 3.885898307300125*^9}, {
  3.885898350457271*^9, 3.885898354095524*^9}, {3.8859057904378643`*^9, 
  3.8859057956887197`*^9}, {3.885906476085805*^9, 
  3.8859064803384438`*^9}},ExpressionUUID->"7b4300d3-f046-4bc1-9c6d-\
3161585316b9"],

Cell["\<\
gives us our target total energy and we want the relative energies per mode \
to follow the same distribution as before, therefore we\[CloseCurlyQuote]ll \
have\
\>", "ExpositoryText",
 CellChangeTimes->{{3.885906481935206*^9, 3.885906532609727*^9}, {
  3.885906597269136*^9, 3.885906617611248*^9}, {3.885906847837606*^9, 
  3.885906849909525*^9}},ExpressionUUID->"554751f9-42a6-42f3-a9df-\
bd6b032ec529"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"L", "\[InvisibleSpace]", "u"}], ")"}], 
     StyleBox["T",
      FontSize->9,
      FontSlant->"Plain"]], "\[InvisibleSpace]", 
    RowBox[{"G", "\[VeryThinSpace]\[InvisibleSpace]", "(", 
     RowBox[{"L", "\[InvisibleSpace]", "u"}], ")"}]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"L", "\[InvisibleSpace]", "v"}], ")"}], 
      StyleBox["T",
       FontSize->9,
       FontSlant->"Plain"]], "\[InvisibleSpace]", 
     RowBox[{"G", "\[VeryThinSpace]\[InvisibleSpace]", "(", 
      RowBox[{"L", "\[InvisibleSpace]", "v"}], ")"}]}], " ", "-", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"L", "\[InvisibleSpace]", "v"}], ")"}], 
      StyleBox["T",
       FontSize->9,
       FontSlant->"Plain"]], "\[InvisibleSpace]", 
     RowBox[{
      SubscriptBox["G", "off"], "\[VeryThinSpace]\[InvisibleSpace]", "(", 
      RowBox[{"L", "\[InvisibleSpace]", "v"}], ")"}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.88590685492234*^9, 
  3.8859068992204103`*^9}},ExpressionUUID->"af7b4226-9df9-40a9-8c26-\
6b53c8a60295"],

Cell[TextData[{
 "which can be handled like case (2) by diagonalizing ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "ccb01904-2124-4daf-a2cd-011ea4d4c387"],
 " to get a transformation ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "8b4fe5ed-7075-4d7d-96e0-b026cee8b6c9"],
 ", and a set of effective masses ",
 Cell[BoxData[
  FormBox["\[Gamma]", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "80f9611c-8f31-4bc2-83f6-70804050f99d"],
 ", and with that we get"
}], "ExpositoryText",
 CellChangeTimes->{{3.885906970796792*^9, 3.88590702320755*^9}, {
  3.885907069930811*^9, 3.885907088603838*^9}, {3.885907137832264*^9, 
  3.885907156502316*^9}},ExpressionUUID->"41d2f6cb-d4ed-46d7-be16-\
eee463d5f00a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"j", "=", "1"}], 
     RowBox[{
      RowBox[{"3", "\[InvisibleSpace]", "N"}], "-", "6"}]], 
    SuperscriptBox[
     SubscriptBox[
      RowBox[{
       SubscriptBox["\[Gamma]", "j"], "\[InvisibleSpace]", "(", 
       RowBox[{"QL", "\[InvisibleSpace]", "u"}], ")"}], "j"], "2"]}], " ", 
   "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"j", "=", "1"}], 
     RowBox[{
      RowBox[{"3", "\[InvisibleSpace]", "N"}], "-", "6"}]], 
    SuperscriptBox[
     SubscriptBox[
      RowBox[{
       SubscriptBox["g", 
        RowBox[{"j", "\[InvisibleSpace]", "j"}]], "\[InvisibleSpace]", "(", 
       RowBox[{"L", "\[InvisibleSpace]", "v"}], ")"}], "j"], "2"]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.885898239518375*^9, 3.885898307300125*^9}, {
  3.885898350457271*^9, 3.885898354095524*^9}, {3.885898876309935*^9, 
  3.8858989741604033`*^9}, {3.8859071238078938`*^9, 
  3.8859071851118*^9}},ExpressionUUID->"29f846d9-b596-4798-8392-46b34c76bdf3"],

Cell["\<\
and assuming we\[CloseCurlyQuote]ve maximized the similarity between our new \
and old modes, we\[CloseCurlyQuote]ll get...\
\>", "ExpositoryText",
 CellChangeTimes->{{3.885907201270824*^9, 3.885907222797155*^9}, {
  3.885908790417006*^9, 
  3.8859087909480877`*^9}},ExpressionUUID->"fa309c6e-2e14-4a6d-acd6-\
39735aadf459"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Case 2:  diagonalize ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "0b714303-1a62-41d0-bf90-c320ea36df89"]
}], "Subsubsubsubsubsection",
 CellChangeTimes->{{3.885899069393466*^9, 3.885899113955349*^9}, {
  3.885906987458314*^9, 
  3.885906987573077*^9}},ExpressionUUID->"2ad20a7a-34ef-4f27-83c7-\
7469d5b31ba6"],

Cell["\<\
We will then that put the appropriate amount of kinetic energy into the modes \
 most closely resembles our mode of interest.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.885899108158252*^9, 3.885899115969078*^9}, 
   3.8859093111529417`*^9},ExpressionUUID->"1a4be0b2-be9c-442b-9418-\
d35e7bfee9c4"],

Cell[TextData[{
 "In terms of minimizing the surprise factor, (2) is likely the best option, \
and so by diagonalizing ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "838bb515-350c-4b2b-8656-b8cc7a72a5bd"],
 " we get a transformation ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "02f5fc95-3b87-491d-87b5-79c5c052f41a"],
 ", and a set of effective masses ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "8216f77a-b1ab-4f91-b9b2-c0a45af82a12"],
 ", and with that, writing ",
 Cell[BoxData[
  FormBox[
   RowBox[{"u", " ", "=", "\[VeryThinSpace]", 
    RowBox[{"Q", "\[InvisibleSpace]", "L", "\[InvisibleSpace]", "v"}]}], 
   TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "c8e5dd10-7f99-4140-aee4-1a33bf99558e"],
 ", we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.885898793733384*^9, 3.885898870071773*^9}, {
  3.885898999601321*^9, 
  3.8858990043394747`*^9}},ExpressionUUID->"100b842a-8e90-4221-a1a9-\
8added853660"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"2", "\[InvisibleSpace]", "T"}], " ", "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"j", "=", "1"}], 
     RowBox[{
      RowBox[{"3", "\[InvisibleSpace]", "N"}], "-", "6"}]], 
    "\[VeryThinSpace]", 
    RowBox[{
     SubscriptBox["g", "j"], "\[InvisibleSpace]", 
     SuperscriptBox[
      SubscriptBox["u", "j"], "2"], " "}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.885898239518375*^9, 3.885898307300125*^9}, {
  3.885898350457271*^9, 3.885898354095524*^9}, {3.885898876309935*^9, 
  3.8858989741604033`*^9}},ExpressionUUID->"27280374-c1b6-4c1b-ae8d-\
828266448710"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Multi-Harmonic Basis", "Section",
 CellChangeTimes->{{3.886093760909811*^9, 
  3.886093767986939*^9}},ExpressionUUID->"ca5cce0c-aa83-4b0b-be31-\
b9c7d3fa582e"],

Cell[TextData[{
 "The general distributed Gaussian formulae can be adapted to deal with \
arbitrary Harmonic basis functions by recalling that the ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "ef456dfc-a27e-49bb-9c5d-4449c787ebd9"],
 "-th harmonic oscillator wave function is given by"
}], "ExpositoryText",
 CellChangeTimes->{{3.886093769704502*^9, 
  3.8860938201215057`*^9}},ExpressionUUID->"b9fc5419-7c59-4c5d-914d-\
48ee1654c9fc"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["\[CurlyPhi]", "n", 
        RowBox[{"(", "i", ")"}]], "(", "x", ")"}], " ", "=", " ", 
      RowBox[{
       FractionBox["1", 
        SqrtBox[
         RowBox[{
          SuperscriptBox["2", "n"], 
          RowBox[{"n", "!"}]}]]], 
       RowBox[{
        SubscriptBox["H", "n"], "(", 
        RowBox[{
         SqrtBox[
          RowBox[{"2", "\[VeryThinSpace]\[InvisibleSpace]", 
           SuperscriptBox["\[Alpha]", 
            RowBox[{"(", "i", ")"}]]}]], "\[InvisibleSpace]", 
         RowBox[{"(", 
          RowBox[{"x", 
           StyleBox["\[VeryThinSpace]",
            FontSize->14], "-", "\[VeryThinSpace]", 
           SuperscriptBox["\[Xi]", 
            RowBox[{"(", "i", ")"}]]}], ")"}]}], ")"}], 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{"2", 
           SuperscriptBox["\[Alpha]", 
            RowBox[{"(", "i", ")"}]]}], "\[Pi]"], ")"}], 
        RowBox[{"1", "/", "4"}]], 
       SuperscriptBox["e", 
        StyleBox[
         RowBox[{"-", 
          SuperscriptBox[
           RowBox[{
            SuperscriptBox["\[Alpha]", 
             RowBox[{"(", "i", ")"}]], "\[InvisibleSpace]\[VeryThinSpace]", 
            "(", 
            RowBox[{"x", 
             StyleBox["\[VeryThinSpace]",
              FontSize->14], "-", "\[VeryThinSpace]", 
             SuperscriptBox["\[Xi]", 
              RowBox[{"(", "i", ")"}]]}], ")"}], "2"]}],
         FontSize->14]]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       FractionBox["1", 
        SqrtBox[
         RowBox[{
          SuperscriptBox["2", "n"], 
          RowBox[{"n", "!"}]}]]], 
       RowBox[{
        SubscriptBox["H", "n"], "(", 
        RowBox[{
         SqrtBox[
          RowBox[{"2", "\[VeryThinSpace]\[InvisibleSpace]", 
           SuperscriptBox["\[Alpha]", 
            RowBox[{"(", "i", ")"}]]}]], "\[InvisibleSpace]", 
         RowBox[{"(", 
          RowBox[{"x", 
           StyleBox["\[VeryThinSpace]",
            FontSize->14], "-", "\[VeryThinSpace]", 
           SuperscriptBox["\[Xi]", 
            RowBox[{"(", "i", ")"}]]}], ")"}]}], ")"}], 
       RowBox[{
        SuperscriptBox["\[Phi]", 
         RowBox[{"(", "i", ")"}]], "(", "x", ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8860938952699203`*^9, 3.886094006076379*^9}, {
   3.886094068055743*^9, 3.886094226800633*^9}, 3.886094649464032*^9, {
   3.8860946855570927`*^9, 3.886094700062945*^9}, {3.886094824703714*^9, 
   3.886094834364015*^9}, {3.886095074468067*^9, 3.8860951157495327`*^9}, {
   3.886095153327483*^9, 3.8860951979168673`*^9}, {3.886095254186141*^9, 
   3.886095272936174*^9}, {3.886095464954545*^9, 3.886095498735468*^9}, {
   3.886095558373417*^9, 3.8860955885649347`*^9}, {3.886095629900608*^9, 
   3.886095640044075*^9}},ExpressionUUID->"364c1bde-8e1f-48d5-8680-\
25e802ef5139"],

Cell["\<\
where we\[CloseCurlyQuote]ll simplify the polynomial prefactor by using what \
we worked out before with\
\>", "ExpositoryText",
