Cell[BoxData[{
 RowBox[{
  RowBox[{"$colorMap", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\"\<n\>\"", "->", 
      RowBox[{"Darker", "[", 
       RowBox[{"Darker", "[", "Red", "]"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<u\>\"", "\[Rule]", 
      RowBox[{"Darker", "[", 
       RowBox[{"Orange", ",", "0.2"}], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<m\>\"", "\[Rule]", 
      RowBox[{"Darker", "[", "Blue", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<v\>\"", "\[Rule]", 
      RowBox[{"Darker", "[", "Green", "]"}]}]}], "\[IndentingNewLine]", " ", 
    "|>"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Clear", "[", "cellFmt", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cellFmt", "[", "c_Cell", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"sigBox", "=", 
        RowBox[{"SuperscriptBox", "[", 
         RowBox[{"\"\<\[CapitalSigma]\>\"", ",", 
          RowBox[{"RowBox", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<(\>\"", ",", 
             RowBox[{"RowBox", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<i\>\"", ",", "\"\<,\>\"", ",", "\"\<j\>\""}], 
               "}"}], "]"}], ",", "\"\<)\>\""}], "}"}], "]"}]}], "]"}]}], ",",
        "\[IndentingNewLine]", 
       RowBox[{"indBox", "=", 
        RowBox[{"Alternatives", "@@", 
         RowBox[{"Keys", "[", "$colorMap", "]"}]}]}]}], "\[IndentingNewLine]",
       "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"c", "/.", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"StyleBox", "[", 
           RowBox[{
            RowBox[{"s", ":", "indBox"}], ",", " ", "__"}], "]"}], "|", 
          RowBox[{"s", ":", "indBox"}]}], ":>", "\[IndentingNewLine]", 
         RowBox[{"StyleBox", "[", 
          RowBox[{"s", ",", " ", "14", ",", " ", 
           RowBox[{"$colorMap", "[", "s", "]"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"\"\<j\>\"", "|", 
          RowBox[{"StyleBox", "[", 
           RowBox[{"\"\<j\>\"", ",", " ", "___"}], "]"}]}], "->", 
         RowBox[{"StyleBox", "[", 
          RowBox[{"\"\<j\>\"", ",", " ", "13", ",", "Purple"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"\"\<i\>\"", "|", 
          RowBox[{"StyleBox", "[", 
           RowBox[{"\"\<i\>\"", ",", " ", "___"}], "]"}]}], "->", 
         RowBox[{"StyleBox", "[", 
          RowBox[{"\"\<i\>\"", ",", "13", ",", " ", "Pink"}], "]"}]}]}], 
       "\[IndentingNewLine]", "}"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cellFmt", "[", "c_CellObject", "]"}], ":=", 
   RowBox[{"NotebookWrite", "[", 
    RowBox[{"c", ",", 
     RowBox[{"cellFmt", "[", 
      RowBox[{"NotebookRead", "[", "c", "]"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cellFmt", "[", "]"}], ":=", 
  RowBox[{"cellFmt", "[", 
