Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", "x"], 
    FractionBox[
     RowBox[{"d", "(", 
      RowBox[{"x", ",", " ", 
       SuperscriptBox["\[Xi]", 
        RowBox[{"(", "j", ")"}]], ",", " ", 
       RowBox[{
        RowBox[{"p", "/", "2"}], "+", "1"}]}], ")"}], 
     RowBox[{
      UnderscriptBox["\[Sum]", "j"], " ", 
      RowBox[{"d", "(", 
       RowBox[{"x", ",", " ", 
        SuperscriptBox["\[Xi]", 
         RowBox[{"(", "j", ")"}]], ",", " ", 
        RowBox[{"p", "/", "2"}]}], ")"}]}]]}], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", "k"], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x", "-", 
       SuperscriptBox["\[Xi]", 
        RowBox[{"(", "k", ")"}]]}], ")"}], 
     RowBox[{"(", 
      RowBox[{"p", "+", "2"}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Delta]", 
        RowBox[{"k", "\[InvisibleSpace]", "j"}]], "-", 
       FractionBox[
        RowBox[{"d", "(", 
         RowBox[{"x", ",", " ", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", "j", ")"}]], ",", " ", 
          RowBox[{
           RowBox[{"p", "/", "2"}], "+", "1"}]}], ")"}], 
        RowBox[{
         UnderscriptBox["\[Sum]", "j"], " ", 
         RowBox[{"d", "(", 
          RowBox[{"x", ",", " ", 
           SuperscriptBox["\[Xi]", 
            RowBox[{"(", "j", ")"}]], ",", " ", 
           RowBox[{"p", "/", "2"}]}], ")"}]}]]}], ")"}], 
     FractionBox[
      RowBox[{"d", "(", 
       RowBox[{"x", ",", " ", 
        SuperscriptBox["\[Xi]", 
         RowBox[{"(", "j", ")"}]], ",", " ", 
        RowBox[{
         RowBox[{"p", "/", "2"}], "+", "2"}]}], ")"}], 
      RowBox[{
       UnderscriptBox["\[Sum]", "j"], " ", 
       RowBox[{"d", "(", 
        RowBox[{"x", ",", " ", 
         SuperscriptBox["\[Xi]", 
          RowBox[{"(", "j", ")"}]], ",", " ", 
         RowBox[{"p", "/", "2"}]}], ")"}]}]], "  "}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.915808594228397*^9, 3.915808739581458*^9}, {
  3.9158088039993343`*^9, 
  3.915808868896433*^9}},ExpressionUUID->"f5cdb6a9-ae0c-4538-89fc-\
a67241dd8cb8"],

Cell["Now we can generalize fully, letting", "ExpositoryText",
 CellChangeTimes->{{3.915808936737431*^9, 
  3.915808942981505*^9}},ExpressionUUID->"e8c415c3-1b3a-4983-8241-\
cc02655fc79a"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SuperscriptBox["\[CapitalGamma]", 
        RowBox[{"(", "i", ")"}]], "(", 
       RowBox[{"p", ",", "n"}], ")"}], " ", "=", " ", 
      FractionBox[
       RowBox[{"d", "(", 
        RowBox[{"x", ",", " ", 
         SuperscriptBox["\[Xi]", 
          RowBox[{"(", "j", ")"}]], ",", " ", 
         RowBox[{
          RowBox[{"p", "/", "2"}], "+", "n"}]}], ")"}], 
       RowBox[{
        UnderscriptBox["\[Sum]", "j"], " ", 
        RowBox[{"d", "(", 
         RowBox[{"x", ",", " ", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", "j", ")"}]], ",", " ", 
          RowBox[{"p", "/", "2"}]}], ")"}]}]]}]},
    {
     RowBox[{"=", 
      FractionBox[
       SuperscriptBox[
        RowBox[{"\[LeftBracketingBar]", 
         RowBox[{"x", "-", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", "i", ")"}]]}], "\[RightBracketingBar]"}], 
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"p", "+", 
           RowBox[{"2", "\[InvisibleSpace]", "n"}]}], ")"}]}]], 
       RowBox[{
        UnderscriptBox["\[Sum]", "j"], " ", 
        SuperscriptBox[
         RowBox[{"\[LeftBracketingBar]", 
          RowBox[{"x", "-", 
           SuperscriptBox["\[Xi]", 
            RowBox[{"(", "i", ")"}]]}], "\[RightBracketingBar]"}], 
         RowBox[{"-", "p"}]]}]]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9158089478285923`*^9, 3.915809008372526*^9}, {
  3.915816466157276*^9, 3.9158165091394997`*^9}, {3.9158165557883663`*^9, 
  3.915816565119031*^9}, {3.915816633102771*^9, 
  3.915816707588211*^9}},ExpressionUUID->"d3e8659d-f366-464b-a15b-\
22605c007ba8"],

Cell["We have", "ExpositoryText",
 CellChangeTimes->{{3.915808981191057*^9, 
  3.915808982095027*^9}},ExpressionUUID->"cec6d05b-ef48-4a77-9bd1-\
4aafc4d0606c"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"V", "(", "x", ")"}], " ", "=", " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "i"], " ", 
       RowBox[{
        RowBox[{"V", "(", 
         RowBox[{"x", ";", " ", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", "i", ")"}]]}], ")"}], 
        RowBox[{
         SuperscriptBox["\[CapitalGamma]", 
          RowBox[{"(", "i", ")"}]], "(", 
         RowBox[{"p", ",", "n"}], ")"}]}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "x"], 
       RowBox[{
        SuperscriptBox["\[CapitalGamma]", 
         RowBox[{"(", "i", ")"}]], "(", 
        RowBox[{"p", ",", "n"}], ")"}]}], " ", "=", 
      RowBox[{
       UnderscriptBox["\[Sum]", "j"], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", "j", ")"}]]}], ")"}], 
        RowBox[{"(", 
         RowBox[{"p", "+", "n", "+", "1"}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Delta]", 
           RowBox[{"i", "\[InvisibleSpace]", "j"}]], "-", 
          RowBox[{
           SuperscriptBox["\[CapitalGamma]", 
            RowBox[{"(", "i", ")"}]], "(", 
           RowBox[{"p", ",", "n"}], ")"}]}], ")"}], 
        RowBox[{
         SuperscriptBox["\[CapitalGamma]", 
          RowBox[{"(", "j", ")"}]], "(", 
         RowBox[{"p", ",", 
          RowBox[{"n", "+", "1"}]}], ")"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.915472316532776*^9, 3.915472348409555*^9}, {
  3.915805249539295*^9, 3.9158052500107183`*^9}, {3.915805438795442*^9, 
  3.9158054415388727`*^9}, {3.915805525224991*^9, 3.9158055273157043`*^9}, {
