Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"W", "(", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[CapitalSigma]", "i"], "+", 
      SubscriptBox["\[CapitalSigma]", "j"]}], ",", " ", 
     RowBox[{
      SubscriptBox["\[Xi]", "i"], "-", 
      SubscriptBox["\[Xi]", "j"]}]}], ")"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"N", "(", 
     RowBox[{
      SuperscriptBox["\[CapitalSigma]", 
       RowBox[{"(", "i", ")"}]], "+", 
      SuperscriptBox["\[CapitalSigma]", 
