Cell[TextData[{
 "Shifting to a full tensor algebra form, letting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalGamma]", "(", 
      RowBox[{"p", ",", "n"}], ")"}], " ", "=", " ", 
     SubscriptBox[
      RowBox[{"{", 
       RowBox[{
        SuperscriptBox["\[CapitalGamma]", 
         RowBox[{"(", "i", ")"}]], "(", 
        RowBox[{"p", ",", "n"}], ")"}], "}"}], "i"]}], ",", " ", 
    RowBox[{"\[CapitalDelta]", "=", 
     RowBox[{"{", 
      RowBox[{"(", 
       RowBox[{"x", "-", 
        SuperscriptBox["\[Xi]", 
         RowBox[{"(", "i", ")"}]]}], ")"}], "}"}]}]}], TraditionalForm]],
  CellChangeTimes->{{3.915472316532776*^9, 3.915472348409555*^9}, {
   3.915805249539295*^9, 3.9158052500107183`*^9}, {3.915805438795442*^9, 
