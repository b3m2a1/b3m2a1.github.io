   3.8839585819920273`*^9}},ExpressionUUID->"ea0d12ef-5d91-4a69-b4fc-\
f750f1aa6c52"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Equivalence to Taylor Series", "Subsubsection",
 CellChangeTimes->{{3.8839409254896317`*^9, 
  3.883940931182275*^9}},ExpressionUUID->"c5931540-9f40-42ae-a41e-\
4bdbab0cc05e"],

Cell[TextData[{
 "We\[CloseCurlyQuote]ll try to show the Taylor Series expression is \
identical by evaluating it at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Xi]", "k", 
     RowBox[{"(", 
      RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], " ", "=", " ", 
    SubscriptBox["\[Zeta]", "k"]}], TraditionalForm]], "ExpositoryTextInline",
  
  FormatType->TraditionalForm,ExpressionUUID->
  "611b272b-9335-4dfe-857e-b1855674ecf2"],
 ", meaning all summed terms with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "k"], " ", "\[NotEqual]", " ", 
    RowBox[{"2", "\[InvisibleSpace]", "l"}]}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "5af646b6-36eb-47ff-96c2-3085a8db3cb4"],
 " vanish (which eliminates all ",
 "odd",
 "-order terms)"
}], "ExpositoryText",
 CellChangeTimes->{{3.8839409353994417`*^9, 3.883940943828184*^9}, {
  3.883941609954069*^9, 
  3.883941677090667*^9}},ExpressionUUID->"6db7231b-84cd-4137-904b-\
15a0088a67cd"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["V", 
       RowBox[{"i", "\[InvisibleSpace]", "j"}]], " ", "=", 
      " \[AlignmentMarker]", 
      RowBox[{
       SubscriptBox["S", 
        RowBox[{"i", "\[InvisibleSpace]", "j"}]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"m", "=", "0"}], "M"], 
        RowBox[{
         FractionBox["1", 
          RowBox[{
           SqrtBox[
            SuperscriptBox["2", "m"]], "\[InvisibleSpace]"}]], 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"p", "\[Element]", 
            RowBox[{"P", "(", "m", ")"}]}], "\[InvisibleSpace]"], 
          RowBox[{
           FractionBox["1", 
            RowBox[{
             SubscriptBox["W", "p"], "\[InvisibleSpace]"}]], 
           FractionBox[
            RowBox[{"\[PartialD]", 
             RowBox[{"V", "(", 
              StyleBox["\[Zeta]",
               FontWeight->"Bold"], ")"}]}], 
            RowBox[{
             RowBox[{
              RowBox[{"\[PartialD]", 
               SubsuperscriptBox["x", 
                RowBox[{"\[VeryThinSpace]", "1"}], 
                SubscriptBox["p", "1"]]}], "..."}], 
             RowBox[{"\[PartialD]", 
              SubsuperscriptBox["x", 
               RowBox[{"\[VeryThinSpace]", 
                RowBox[{"3", "\[InvisibleSpace]", "N"}]}], 
               SubscriptBox["p", 
                RowBox[{"\[VeryThinSpace]", 
                 RowBox[{"3", "\[InvisibleSpace]", "N"}]}]]]}]}]], 
           RowBox[{
            UnderoverscriptBox["\[Product]", 
             RowBox[{"k", "\[VeryThinSpace]", "=", "\[VeryThinSpace]", "1"}], 
             
             RowBox[{"3", "\[InvisibleSpace]", "N"}]], " ", 
            RowBox[{
             FractionBox["1", 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox["\[Alpha]", "k", 
                 RowBox[{"(", 
                  RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], ")"}], 
               SubscriptBox["p", 
                RowBox[{"k", "/", "2"}]]]], 
             RowBox[{
              UnderoverscriptBox["\[Sum]", 
               RowBox[{"l", "=", "0"}], 
               TemplateBox[{
                 RowBox[{
                   SubscriptBox["p", "k"], "/", "2"}]},
                "Floor"]], 
              RowBox[{
               RowBox[{"f", "(", 
                RowBox[{
                 SubscriptBox["p", "k"], ",", " ", "l"}], "\[ThinSpace]", 
                ")"}], 
               FractionBox[
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   SubsuperscriptBox["\[Xi]", "k", 
                    RowBox[{"(", 
                    RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], "-", 
                   SubscriptBox["\[Zeta]", "k"]}], ")"}], 
                 RowBox[{
                  SubscriptBox["p", "k"], "-", 
                  RowBox[{"2", "\[InvisibleSpace]", "l"}]}]], 
                SuperscriptBox["2", 
                 RowBox[{
                  RowBox[{"2", "\[InvisibleSpace]", "l"}], "-", 
                  RowBox[{
                   SubscriptBox["p", "k"], "/", "2"}]}]]]}]}]}]}]}]}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SubscriptBox["S", 
        RowBox[{"i", "\[InvisibleSpace]", "j"}]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"m", "=", "0"}], "M"], 
        RowBox[{
         FractionBox["1", 
          RowBox[{
           SqrtBox[
            SuperscriptBox["2", "m"]], "\[InvisibleSpace]"}]], 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"p", "\[Element]", 
            RowBox[{"P", "(", "m", ")"}]}], "\[InvisibleSpace]"], 
          RowBox[{
           FractionBox["1", 
            RowBox[{
             SubscriptBox["W", "p"], "\[InvisibleSpace]"}]], 
           FractionBox[
            RowBox[{"\[PartialD]", 
             RowBox[{"V", "(", 
              StyleBox["\[Zeta]",
               FontWeight->"Bold"], ")"}]}], 
            RowBox[{
             RowBox[{
              RowBox[{"\[PartialD]", 
               SubsuperscriptBox["x", 
                RowBox[{"\[VeryThinSpace]", "1"}], 
                SubscriptBox["p", "1"]]}], "..."}], 
             RowBox[{"\[PartialD]", 
              SubsuperscriptBox["x", 
               RowBox[{"\[VeryThinSpace]", 
                RowBox[{"3", "\[InvisibleSpace]", "N"}]}], 
               SubscriptBox["p", 
                RowBox[{"\[VeryThinSpace]", 
                 RowBox[{"3", "\[InvisibleSpace]", "N"}]}]]]}]}]], 
           RowBox[{
            UnderoverscriptBox["\[Product]", 
             RowBox[{"k", "\[VeryThinSpace]", "=", "\[VeryThinSpace]", "1"}], 
             
             RowBox[{"3", "\[InvisibleSpace]", "N"}]], " ", 
            RowBox[{
             FractionBox["1", 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox["\[Alpha]", "k", 
                 RowBox[{"(", 
                  RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], ")"}], 
               SubscriptBox["p", 
                RowBox[{"k", "/", "2"}]]]], 
             RowBox[{
              UnderoverscriptBox["\[Sum]", 
               RowBox[{"l", "=", "0"}], 
               TemplateBox[{
                 RowBox[{
                   SubscriptBox["p", "k"], "/", "2"}]},
                "Floor"]], 
              RowBox[{
               RowBox[{"f", "(", 
                RowBox[{
                 SubscriptBox["p", "k"], ",", " ", "l"}], "\[ThinSpace]", 
                ")"}], 
               FractionBox[
                SuperscriptBox[
                 RowBox[{"(", "0", ")"}], 
                 RowBox[{
                  SubscriptBox["p", "k"], "-", 
                  RowBox[{"2", "\[InvisibleSpace]", "l"}]}]], 
                SuperscriptBox["2", 
                 RowBox[{
                  RowBox[{"2", "\[InvisibleSpace]", "l"}], "-", 
                  RowBox[{
                   SubscriptBox["p", "k"], "/", "2"}]}]]]}]}]}]}]}]}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SubscriptBox["S", 
        RowBox[{"i", "\[InvisibleSpace]", "j"}]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"m", "=", "0"}], "M"], 
        RowBox[{
         FractionBox["1", 
          RowBox[{
           SqrtBox[
            SuperscriptBox["2", "m"]], "\[InvisibleSpace]"}]], 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"p", "\[Element]", 
            RowBox[{"P", "(", "m", ")"}]}], "\[InvisibleSpace]"], 
          RowBox[{
           FractionBox["1", 
            RowBox[{
             SubscriptBox["W", "p"], "\[InvisibleSpace]"}]], 
           FractionBox[
            RowBox[{"\[PartialD]", 
             RowBox[{"V", "(", 
              StyleBox["\[Zeta]",
               FontWeight->"Bold"], ")"}]}], 
            RowBox[{
             RowBox[{
              RowBox[{"\[PartialD]", 
               SubsuperscriptBox["x", 
                RowBox[{"\[VeryThinSpace]", "1"}], 
                SubscriptBox["p", "1"]]}], "..."}], 
             RowBox[{"\[PartialD]", 
              SubsuperscriptBox["x", 
               RowBox[{"\[VeryThinSpace]", 
                RowBox[{"3", "\[InvisibleSpace]", "N"}]}], 
               SubscriptBox["p", 
                RowBox[{"\[VeryThinSpace]", 
                 RowBox[{"3", "\[InvisibleSpace]", "N"}]}]]]}]}]], 
           RowBox[{
            UnderoverscriptBox["\[Product]", 
             RowBox[{"k", "\[VeryThinSpace]", "=", "\[VeryThinSpace]", "1"}], 
             
             RowBox[{"3", "\[InvisibleSpace]", "N"}]], " ", 
            RowBox[{
             FractionBox["1", 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox["\[Alpha]", "k", 
                 RowBox[{"(", 
                  RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], ")"}], 
               SubscriptBox["p", 
                RowBox[{"k", "/", "2"}]]]], 
             FractionBox[
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   SubscriptBox["p", "k"], "/", "2"}], "+", "1"}], ",", " ", 
                 SubscriptBox["p", "k"]}], ")"}], "!"}], 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  SubscriptBox["p", "k"], "-", 
                  RowBox[{"2", "\[InvisibleSpace]", 
                   RowBox[{
                    SubscriptBox["p", "k"], "/", "2"}]}]}], ")"}], "!"}], 
               SuperscriptBox["2", 
                RowBox[{
                 RowBox[{"2", "\[InvisibleSpace]", 
                  RowBox[{"(", 
                   RowBox[{
                    SubscriptBox["p", "k"], "/", "2"}], ")"}]}], "-", 
                 RowBox[{
                  SubscriptBox["p", "k"], "/", "2"}]}]]}]]}]}]}]}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SubscriptBox["S", 
        RowBox[{"i", "\[InvisibleSpace]", "j"}]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"m", "=", "0"}], "M"], 
        RowBox[{
         FractionBox["1", 
          RowBox[{
           SqrtBox[
            SuperscriptBox["2", "m"]], "\[InvisibleSpace]"}]], 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"p", "\[Element]", 
            RowBox[{"P", "(", "m", ")"}]}], "\[InvisibleSpace]"], 
          RowBox[{
           FractionBox["1", 
            RowBox[{
             SubscriptBox["W", "p"], "\[InvisibleSpace]"}]], 
           FractionBox[
            RowBox[{"\[PartialD]", 
             RowBox[{"V", "(", 
              StyleBox["\[Zeta]",
               FontWeight->"Bold"], ")"}]}], 
            RowBox[{
             RowBox[{
              RowBox[{"\[PartialD]", 
               SubsuperscriptBox["x", 
                RowBox[{"\[VeryThinSpace]", "1"}], 
                SubscriptBox["p", "1"]]}], "..."}], 
             RowBox[{"\[PartialD]", 
              SubsuperscriptBox["x", 
               RowBox[{"\[VeryThinSpace]", 
                RowBox[{"3", "\[InvisibleSpace]", "N"}]}], 
               SubscriptBox["p", 
                RowBox[{"\[VeryThinSpace]", 
                 RowBox[{"3", "\[InvisibleSpace]", "N"}]}]]]}]}]], 
           RowBox[{
            UnderoverscriptBox["\[Product]", 
             RowBox[{"k", "\[VeryThinSpace]", "=", "\[VeryThinSpace]", "1"}], 
             
             RowBox[{"3", "\[InvisibleSpace]", "N"}]], " ", 
            RowBox[{
             FractionBox["1", 
              SuperscriptBox[
               RowBox[{"(", 
                SubsuperscriptBox["\[Alpha]", "k", 
                 RowBox[{"(", 
                  RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], ")"}], 
