  3.8865208112979403`*^9}},ExpressionUUID->"27ca8794-b450-4324-8e6c-\
9d166f5fccc3"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["T", 
       RowBox[{"i", "\[InvisibleSpace]", "j"}]], " ", "=", " ", 
      RowBox[{"-", 
       RowBox[{
        SubscriptBox["\[Integral]", 
         SuperscriptBox["\[DoubleStruckCapitalR]", "N"]], 
        RowBox[{
         SubsuperscriptBox["P", 
          StyleBox["n",
           FontWeight->"Bold"], 
          RowBox[{"(", "i", ")"}]], 
         RowBox[{
          SuperscriptBox["\[Phi]", 
           RowBox[{"(", "i", ")"}]], "(", 
          StyleBox["x",
           FontWeight->"Bold"], ")"}], 
         RowBox[{
          FractionBox[
           SuperscriptBox["\[Del]", "2"], 
           RowBox[{
            StyleBox["2",
             FontWeight->"Plain"], 
            StyleBox["\[InvisibleSpace]",
             FontWeight->"Bold"], 
            StyleBox["\[Mu]",
             FontWeight->"Bold"]}]], 
          SubsuperscriptBox["P", 
           StyleBox["m",
            FontWeight->"Bold"], 
           RowBox[{"(", "j", ")"}]]}], 
         RowBox[{
          SuperscriptBox["\[Phi]", 
           RowBox[{"(", "j", ")"}]], "(", 
          StyleBox["x",
           FontWeight->"Bold"], ")"}], 
         RowBox[{"\[DifferentialD]", 
          StyleBox["x",
           FontWeight->"Bold"]}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "k"], 
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", 
          RowBox[{"2", 
           SubscriptBox["\[Mu]", "k"]}]]}], 
        RowBox[{
         SubscriptBox["\[Integral]", 
          SuperscriptBox["\[DoubleStruckCapitalR]", "N"]], 
         RowBox[{
          SubsuperscriptBox["P", 
           StyleBox["n",
            FontWeight->"Bold"], 
           RowBox[{"(", "i", ")"}]], 
          RowBox[{
           SuperscriptBox["\[Phi]", 
            RowBox[{"(", "i", ")"}]], "(", 
           StyleBox["x",
            FontWeight->"Bold"], ")"}], 
          RowBox[{
           FractionBox[
            SuperscriptBox["\[PartialD]", "2"], 
            RowBox[{"\[PartialD]", 
             SubsuperscriptBox["x", "k", "2"]}]], 
           SubsuperscriptBox["P", 
            StyleBox["m",
             FontWeight->"Bold"], 
            RowBox[{"(", "j", ")"}]]}], 
          RowBox[{
           SuperscriptBox["\[Phi]", 
            RowBox[{"(", "j", ")"}]], "(", 
           StyleBox["x",
            FontWeight->"Bold"], ")"}], 
          RowBox[{"\[DifferentialD]", 
           StyleBox["x",
            FontWeight->"Bold"]}]}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
