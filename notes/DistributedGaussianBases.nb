         RowBox[{"-", "1"}]], 
        SuperscriptBox["L", 
         StyleBox["T",
          FontSize->9,
          FontSlant->"Plain"]]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"L", "(", 
         RowBox[{
          SuperscriptBox["L", 
           StyleBox["T",
            FontSize->9,
            FontSlant->"Plain"]], 
          SuperscriptBox[
           RowBox[{"L", "\[InvisibleSpace]"}], 
           RowBox[{"(", "j", ")"}]], 
          SuperscriptBox[
           RowBox[{"(", 
            SuperscriptBox["\[CapitalLambda]", 
             RowBox[{"(", "j", ")"}]], ")"}], 
           RowBox[{"-", "1"}]], 
          SuperscriptBox[
           SuperscriptBox[
            RowBox[{"L", "\[InvisibleSpace]"}], 
            RowBox[{"(", "j", ")"}]], 
           StyleBox["T",
            FontSize->9,
            FontSlant->"Plain"]], "L"}], ")"}], 
        SuperscriptBox["L", 
         StyleBox["T",
          FontSize->9,
          FontSlant->"Plain"]]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{"L", "(", " ", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           SuperscriptBox["\[CapitalLambda]", 
            RowBox[{"(", "i", ")"}]], ")"}], 
          RowBox[{"-", "1"}]], "+", " ", 
