       RowBox[{"\[PartialD]", 
        SubsuperscriptBox["x", "k", "2"]}]], 
      RowBox[{
       SuperscriptBox["\[Phi]", 
        RowBox[{"(", "j", ")"}]], "(", 
       StyleBox["x",
        FontWeight->"Bold"], ")"}]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
