Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"integrateTerm2", ",", " ", "integrateFull2"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"integrateTerm2", "[", 
    RowBox[{"t_", ",", " ", "i_", ",", " ", "j_", ",", " ", "alphas_"}], 
    "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"t", "*", 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{"Times", "@@", 
      RowBox[{"KeyValueMap", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"#2", "!=", "1"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"gaussianPolyIntegral", "[", 
             RowBox[{"#2", ",", " ", 
              RowBox[{"alphas", "[", 
               RowBox[{"[", "#", "]"}], "]"}]}], "]"}], "/", 
            "\[IndentingNewLine]", 
            RowBox[{"gaussianPolyIntegral", "[", 
             RowBox[{"0", ",", " ", 
              RowBox[{"alphas", "[", 
               RowBox[{"[", "#", "]"}], "]"}]}], "]"}]}], ",", 
           "\[IndentingNewLine]", "0"}], "\[IndentingNewLine]", "]"}], "&"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"Counts", "[", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "j"}], "}"}], "]"}]}], "\[IndentingNewLine]",
