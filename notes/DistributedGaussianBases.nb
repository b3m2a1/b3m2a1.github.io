  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gsN", "[", 
     RowBox[{
      RowBox[{"\[Phi]", "[", "i_", "]"}], ",", " ", 
      RowBox[{"\[Phi]", "[", "j_", "]"}]}], "]"}], "/;", 
    RowBox[{"j", "<", "i"}]}], ":=", 
   RowBox[{"gsN", "[", 
    RowBox[{
     RowBox[{"\[Phi]", "[", "j", "]"}], ",", " ", 
     RowBox[{"\[Phi]", "[", "i", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gsN", "[", 
    RowBox[{
     RowBox[{"a", ":", 
      RowBox[{"Except", "[", "_\[Phi]", "]"}]}], ",", " ", "b_"}], "]"}], ":=", 
   RowBox[{"a", "/.", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"g_gsN", ":>", "g"}], ",", "\[IndentingNewLine]", 
      RowBox[{"f_\[Phi]", ":>", 
       RowBox[{"gsN", "[", 
        RowBox[{"f", ",", " ", "b"}], "]"}]}]}], "\[IndentingNewLine]", 
     "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gsN", "[", 
    RowBox[{"a_\[Phi]", ",", " ", 
     RowBox[{"b", ":", 
      RowBox[{"Except", "[", "_\[Phi]", "]"}]}]}], "]"}], ":=", 
   RowBox[{"b", "/.", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"g_gsN", ":>", "g"}], ",", "\[IndentingNewLine]", 
      RowBox[{"f_\[Phi]", ":>", 
       RowBox[{"gsN", "[", 
        RowBox[{"a", ",", " ", "f"}], "]"}]}]}], "\[IndentingNewLine]", 
     "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Format", "[", 
    RowBox[{"gsN", "[", 
     RowBox[{
      RowBox[{"\[Phi]", "[", "i_", "]"}], ",", " ", 
      RowBox[{"\[Phi]", "[", "j_", "]"}]}], "]"}], "]"}], ":=", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Row", "@", 
      RowBox[{"{", 
       RowBox[{"\"\<\[LeftAngleBracket]\>\"", ",", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\[Phi]", ",", " ", "i"}], "]"}], ",", " ", "\"\<|\>\"", ",",
         " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\[Phi]", ",", " ", "j"}], "]"}], ",", " ", 
        "\"\<\[RightAngleBracket]\>\""}], "}"}]}], ",", " ", 
     RowBox[{"ShowStringCharacters", "->", "False"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gsV", "[", 
    RowBox[{"\[Phi]", "[", "j_", "]"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gsV", "[", 
     RowBox[{"\[Phi]", "[", "j", "]"}], "]"}], "=", 
    RowBox[{
     RowBox[{"\[Phi]", "[", "j", "]"}], "-", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"gsN", "[", 
         RowBox[{
          RowBox[{"\[Phi]", "[", "i", "]"}], ",", " ", 
          RowBox[{"\[Phi]", "[", "j", "]"}]}], "]"}], "*", 
        RowBox[{"\[Phi]", "[", "i", "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
