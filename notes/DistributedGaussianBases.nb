         },
         GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
       SuperscriptBox[
        RowBox[{"(", " ", 
         RowBox[{
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", 
            RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], "-", 
          "\[VeryThinSpace]", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", "i", ")"}]]}], ")"}], 
        RowBox[{"n", "-", 
         RowBox[{"2", "\[InvisibleSpace]", "l"}], "-", "\[Lambda]"}]], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", 
          StyleBox["\[VeryThinSpace] ",
           FontSize->14], 
          StyleBox["-",
           FontSize->14], 
          StyleBox[" ",
           FontSize->14], 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", 
            RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]]}], ")"}], 
