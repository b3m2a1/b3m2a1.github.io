Cell[BoxData[{
 RowBox[{
  RowBox[{"f1", "=", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "-", "u1"}], ")"}], ".", 
      RowBox[{"(", 
       RowBox[{"s1", ".", 
        RowBox[{"(", 
         RowBox[{"x", "-", "u1"}], ")"}]}], ")"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f2", "=", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "-", "u2"}], ")"}], ".", 
      RowBox[{"(", 
       RowBox[{"s2", ".", 
        RowBox[{"(", 
         RowBox[{"x", "-", "u2"}], ")"}]}], ")"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testWatson", "[", 
    RowBox[{
    "f1_", ",", " ", "f2_", ",", " ", "x_", ",", " ", "uc_", ",", " ", 
     "ijkl_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"i", "=", 
        RowBox[{"ijkl", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
       RowBox[{"j", "=", 
        RowBox[{"ijkl", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
       RowBox[{"k", "=", 
        RowBox[{"ijkl", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
       RowBox[{"l", "=", 
        RowBox[{"ijkl", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"f1", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "-", 
        RowBox[{"uc", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "*", 
      RowBox[{"D", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"x", "[", 
            RowBox[{"[", "k", "]"}], "]"}], "-", 
           RowBox[{"uc", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], ")"}], "*", 
         RowBox[{"D", "[", 
          RowBox[{"f2", ",", " ", 
           RowBox[{"x", "[", 
            RowBox[{"[", "l", "]"}], "]"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"x", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}], "\[IndentingNewLine]", "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"watsonZeta", "[", 
    RowBox[{"i_", ",", "j_", ",", "k_", ",", "l_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"i", "==", "j"}], "||", 
      RowBox[{"k", "==", "l"}]}], ",", " ", "\[IndentingNewLine]", "0", ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"j", "<", "i"}], ",", 
        RowBox[{"-", "1"}], ",", " ", "1"}], "]"}], "*", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"l", "<", "k"}], ",", 
        RowBox[{"-", "1"}], ",", " ", "1"}], "]"}], "*", 
      "\[IndentingNewLine]", 
      RowBox[{"(", 
       RowBox[{"\[FormalZ]", "@@", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Sort", "@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sort", "@", 
             RowBox[{"{", 
              RowBox[{"i", ",", "j"}], "}"}]}], ",", 
            RowBox[{"Sort", "@", 
             RowBox[{"{", 
              RowBox[{"k", ",", " ", "l"}], "}"}]}]}], "}"}]}], "]"}]}], 
       ")"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.907551062106731*^9, 3.907551208020762*^9}, {
