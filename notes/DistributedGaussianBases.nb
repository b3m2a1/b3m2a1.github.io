Cell[TextData[{
 "we could do the extra trick from the previous version where we noted that \
we\[CloseCurlyQuote]re summing over every possible version of these indices, \
so there will ",
 StyleBox["also",
  FontSlant->"Italic"],
 " be a term where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "\[LeftRightArrow]", "m"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "7cf9ca07-7797-425d-be57-3278037eb8ee"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"u", "\[LeftRightArrow]", "v"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "63f88775-7a77-4374-99fb-995414dbc22b"]
}], "ExpositoryText",
 CellChangeTimes->{{3.9164128889307337`*^9, 3.9164129089731197`*^9}, {
