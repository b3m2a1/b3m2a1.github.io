  3.9161663960234413`*^9}},ExpressionUUID->"3109f9d3-fd0d-4a54-a038-\
1aebd1aeb19e"],

Cell[TextData[{
 "and the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Phi]", 
     RowBox[{"(", "i", ")"}]], 
    SuperscriptBox["\[Phi]", 
     RowBox[{"(", "j", ")"}]]}], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"b36deb39-59ab-4d66-9217-eed3c71e5f1f"],
 " component will provide the Gaussian axes and all the usual data such that"
}], "ExpositoryText",
 CellChangeTimes->{{3.9161096190862017`*^9, 3.916109656715333*^9}, {
  3.916109703077693*^9, 
