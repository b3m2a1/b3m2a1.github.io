Cell[TextData[{
 "where letting ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", " ", "=", " ", 
    RowBox[{"c", " ", "+", " ", 
     RowBox[{"1", "/", "2"}]}]}], TraditionalForm]], "ExpositoryTextInline",
