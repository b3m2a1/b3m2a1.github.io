     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"j", "<", "i"}], ",", 
        RowBox[{"-", "1"}], ",", " ", "1"}], "]"}], "*", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"l", "<", "k"}], ",", 
