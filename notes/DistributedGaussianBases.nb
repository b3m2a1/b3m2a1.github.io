   3.9075527181364317`*^9}},ExpressionUUID->"041fec28-961a-4304-8493-\
935cb64ac35a"],

Cell["and when we evaluate the proper Laplacian we have", "ExpositoryText",
 CellChangeTimes->{{3.9075517128321753`*^9, 
  3.907551730512788*^9}},ExpressionUUID->"b187e6d5-d96b-4a37-b03b-\
4f2f0e48c285"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Tr", "(", 
    RowBox[{
     SuperscriptBox["M", 
      RowBox[{"-", "1"}]], 
     SubscriptBox["\[ScriptCapitalT]", "j"]}], ")"}], " ", "=", " ", 
   RowBox[{
    UnderscriptBox["\[Sum]", "n"], " ", 
    RowBox[{
     FractionBox["1", 
      SubscriptBox["m", "n"]], "[", " ", 
     RowBox[{
      SuperscriptBox[
       SubscriptBox[
        RowBox[{"[", 
         RowBox[{
          SubsuperscriptBox["\[CapitalSigma]", "j", 
           RowBox[{"-", "1"}]], 
          SuperscriptBox["L", "T"], "\[InvisibleSpace]", "q"}], "]"}], "n"], 
       "2"], " ", "+", " ", 
      SuperscriptBox[
       SubscriptBox[
        RowBox[{"[", 
         RowBox[{
          SubsuperscriptBox["\[CapitalSigma]", "j", 
           RowBox[{"-", "1"}]], 
          SubscriptBox["\[CapitalSigma]", "c"], 
          RowBox[{
           SuperscriptBox[
            SubscriptBox["\[CapitalSigma]", "i"], 
            RowBox[{"-", "1"}]], "(", 
           RowBox[{
            SubscriptBox["\[Xi]", "i"], "-", "\[InvisibleSpace]", 
            SubscriptBox["\[Xi]", "j"]}], ")"}]}], "]"}], "n"], "2"], " ", 
      "-", " ", 
      SubscriptBox[
       SubsuperscriptBox["\[CapitalSigma]", "j", 
        RowBox[{"-", "1"}]], 
       RowBox[{"n", "\[InvisibleSpace]", "n"}]]}], " ", "]"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.907551727736822*^9, 3.907551838758285*^9}, {
