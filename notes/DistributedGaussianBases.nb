Cell["Normal Mode Gaussians", "Section",
 CellChangeTimes->{{3.896005184751998*^9, 
  3.896005188226486*^9}},ExpressionUUID->"50a0cab6-a977-4399-ad7e-\
c0a28779efd2"],

Cell["I want my basis functions to look like", "ExpositoryText",
 CellChangeTimes->{{3.896005193182032*^9, 
  3.8960052088930683`*^9}},ExpressionUUID->"1f6d83f0-495e-40a8-ac7e-\
59bc58b2359d"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"\[CurlyPhi]", "(", 
       RowBox[{"x", ",", " ", "\[Xi]", ",", " ", "\[Alpha]"}], ")"}], " ", 
      "=", " ", 
      RowBox[{"\[Phi]", "(", 
       RowBox[{
        RowBox[{"q", "(", "x", ")"}], ",", " ", 
        RowBox[{"q", "(", "\[Xi]", ")"}], ",", " ", "\[Alpha]"}], ")"}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{"\[Phi]", "(", 
       RowBox[{"x", ",", " ", "\[Xi]", ",", " ", "\[CapitalSigma]"}], 
       ")"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.896005210060195*^9, 3.896005218431807*^9}, {
  3.896005267374317*^9, 3.896005288896693*^9}, {3.896005321574095*^9, 
  3.896005322759451*^9}, {3.896005471575678*^9, 
  3.8960054938324947`*^9}},ExpressionUUID->"9e9ac6fd-5eff-44ec-b810-\
03c038cbe4e3"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox["q", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "95414083-f796-40cc-8273-2aeac404226a"],
 " is the set of normal modes or reaction path normal modes evaluated at \
point ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "123b4962-3a2c-4f7c-9142-d55b7aa97a58"]
}], "ExpositoryText",
 CellChangeTimes->{{3.896005230663864*^9, 3.896005265268649*^9}, {
  3.896005331515541*^9, 
  3.89600534002561*^9}},ExpressionUUID->"caa69b87-d2d7-4ba9-bd00-\
81543e28c4ea"],

Cell["\<\
It should be noted that there\[CloseCurlyQuote]s a Coriolis-type term left \
out here, since formally we really have a product of a DGB along the \
vibrational coordinates and a rotational ground state wave function for the \
rotational coordinates and the averages along the rotational coordinates will \
change as a function of the configuration.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8960089388235073`*^9, 
  3.896009009487194*^9}},ExpressionUUID->"9a9253ad-8177-4488-9e60-\
6cf6ac21eb36"],

Cell["Then when evaluating ", "ExpositoryText",
 CellChangeTimes->{{3.896005358704678*^9, 
  3.8960053629710817`*^9}},ExpressionUUID->"e00c8aaa-acb8-4629-bcb1-\
2c3d3caff533"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["T", 
    RowBox[{"i", "\[InvisibleSpace]", "j"}]], " ", "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], 
    RowBox[{
     UnderscriptBox["\[Sum]", "k"], 
     RowBox[{
      FractionBox["1", 
       SubscriptBox["m", "k"]], 
      RowBox[{
       SubscriptBox["\[Integral]", "x"], " ", 
       RowBox[{
        RowBox[{"\[Phi]", "(", 
         RowBox[{"x", ",", " ", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", "i", ")"}]], ",", " ", 
          SuperscriptBox["\[CapitalSigma]", 
           RowBox[{"(", "i", ")"}]]}], ")"}], 
        RowBox[{
         FractionBox[
          SuperscriptBox["\[PartialD]", "2"], 
          RowBox[{"\[PartialD]", 
           SubsuperscriptBox["x", "k", "2"]}]], 
         RowBox[{"\[Phi]", "(", 
          RowBox[{"x", ",", " ", 
           SuperscriptBox["\[Xi]", 
            RowBox[{"(", "j", ")"}]], ",", " ", 
           SuperscriptBox["\[CapitalSigma]", 
            RowBox[{"(", "j", ")"}]]}], ")"}]}], 
        RowBox[{"\[DifferentialD]", "x"}]}]}]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.896005364641543*^9, 3.8960054329124107`*^9}, {
  3.896005588740328*^9, 
  3.896005634401161*^9}},ExpressionUUID->"dc5000f9-59c4-48a5-91dd-\
d7dc7040cb96"],

Cell["we get a kinetic polynomial from the derivative term", "ExpositoryText",
 CellChangeTimes->{{3.896009063532481*^9, 
  3.896009088796914*^9}},ExpressionUUID->"047fc810-e665-47d2-97a4-\
5e2afb9b098a"],

