Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       FractionBox[
        SuperscriptBox["\[PartialD]", "\[Nu]"], 
        RowBox[{"\[PartialD]", 
         SubsuperscriptBox["x", "k", "\[Nu]"]}]], 
       SubsuperscriptBox["P", 
        StyleBox["n",
         FontWeight->"Bold"], 
        RowBox[{"(", "i", ")"}]]}], " ", "=", " ", 
      RowBox[{
       SqrtBox[
        FractionBox["1", 
         RowBox[{
          StyleBox["n",
           FontWeight->"Bold"], 
          StyleBox["!",
           FontWeight->"Plain"]}]]], "\[InvisibleSpace]", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["P",
          FontWeight->"Bold"], 
         StyleBox["n",
          FontWeight->"Bold"], 
         RowBox[{"(", "i", ")"}]], "\[CircleDot]", 
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           SuperscriptBox["\[PartialD]", "\[Nu]"], 
           RowBox[{"\[PartialD]", 
            SubsuperscriptBox["x", "k", "\[Nu]"]}]], 
          SuperscriptBox["\[Chi]", 
           StyleBox["n",
            FontWeight->"Bold"]]}], ")"}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SqrtBox[
        FractionBox["1", 
         RowBox[{
          StyleBox["n",
           FontWeight->"Bold"], 
          StyleBox["!",
           FontWeight->"Plain"]}]]], "\[InvisibleSpace]", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["P",
          FontWeight->"Bold"], 
         StyleBox["n",
          FontWeight->"Bold"], 
         RowBox[{"(", "i", ")"}]], "\[CircleDot]", 
        RowBox[{"(", 
         RowBox[{
          UnderscriptBox["\[CircleTimes]", "k"], 
          RowBox[{
           FractionBox[
            SuperscriptBox["\[PartialD]", "\[Nu]"], 
            RowBox[{"\[PartialD]", 
             SubsuperscriptBox["x", "k", "\[Nu]"]}]], 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["x", "k"], 
              StyleBox["\[VeryThinSpace] ",
               FontSize->14], 
              StyleBox["-",
               FontSize->14], 
              StyleBox[" ",
               FontSize->14], 
              SubsuperscriptBox["\[Xi]", "k", 
               RowBox[{"(", 
                RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]]}], ")"}], 
            SubscriptBox[
             StyleBox["n",
              FontWeight->"Bold"], 
             StyleBox["k",
              FontWeight->"Bold"]]]}]}], ")"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
