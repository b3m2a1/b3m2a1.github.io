   3.907554962245205*^9},ExpressionUUID->"8995d0be-0732-4f17-abeb-\
76864b90a746"],

Cell["so in total we have", "ExpositoryText",
 CellChangeTimes->{{3.907552233072557*^9, 3.907552234567094*^9}, {
  3.907552360980798*^9, 
  3.907552362642891*^9}},ExpressionUUID->"5bcd3ffb-dada-4d60-9607-\
b96b0961f03a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     SuperscriptBox["\[DoubleStruckCapitalR]", "d"], " "], 
    RowBox[{
     RowBox[{"\[Phi]", "(", 
      RowBox[{"x", ",", " ", 
       SubscriptBox["\[Xi]", "c"], ",", " ", 
       SubscriptBox["\[CapitalSigma]", "c"]}], ")"}], 
     RowBox[{"Tr", "(", 
      RowBox[{
       SuperscriptBox["M", 
        RowBox[{"-", "1"}]], 
       SubscriptBox["\[ScriptCapitalT]", "j"]}], ")"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], " ", "=", " ", 
   RowBox[{
    UnderscriptBox["\[Sum]", "n"], " ", 
    RowBox[{
     FractionBox["1", 
      SubscriptBox["m", "n"]], "[", " ", 
     RowBox[{
      RowBox[{
       UnderscriptBox["\[Sum]", "k"], " ", 
       FractionBox[
        SubsuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubsuperscriptBox["\[CapitalSigma]", "j", 
            RowBox[{"-", "1"}]], 
           SuperscriptBox["L", "T"]}], ")"}], 
         RowBox[{"n", "\[InvisibleSpace]", "k"}], "2"], 
        RowBox[{"\[InvisibleSpace]\[InvisibleSpace]", 
         SubsuperscriptBox["\[Alpha]", "k", 
          RowBox[{"(", "c", ")"}]]}]]}], " ", "+", " ", 
      SuperscriptBox[
       SubscriptBox[
        RowBox[{"[", 
         RowBox[{
          SubsuperscriptBox["\[CapitalSigma]", "j", 
           RowBox[{"-", "1"}]], 
          SubscriptBox["\[CapitalSigma]", "c"], 
          RowBox[{
           SuperscriptBox[
            SubscriptBox["\[CapitalSigma]", "i"], 
            RowBox[{"-", "1"}]], "(", 
           RowBox[{
            SubscriptBox["\[Xi]", "i"], "-", "\[InvisibleSpace]", 
            SubscriptBox["\[Xi]", "j"]}], ")"}]}], "]"}], "n"], "2"], " ", 
      "-", " ", 
      SubscriptBox[
       SubsuperscriptBox["\[CapitalSigma]", "j", 
        RowBox[{"-", "1"}]], 
       RowBox[{"n", "\[InvisibleSpace]", "n"}]]}], "]"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9075523018970547`*^9, 3.907552322643999*^9}, 
   3.907552371803788*^9, 3.907552490189231*^9, {3.907552727586402*^9, 
