Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["X", "0", 
       RowBox[{"(", 
        RowBox[{"i", ",", "j"}], ")"}]], " ", "=", " ", 
      RowBox[{
       SubsuperscriptBox["S", "0", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]], "\[InvisibleSpace]", 
       RowBox[{"exp", "(", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "2"]}], 
         SuperscriptBox["J", 
          RowBox[{"(", 
           RowBox[{"i", ",", "j"}], ")"}]], 
         SuperscriptBox["\[CapitalSigma]", 
          RowBox[{"(", 
           RowBox[{"i", ",", "j"}], ")"}]], 
         RowBox[{
          SuperscriptBox["J", 
           RowBox[{"(", 
            RowBox[{"i", ",", "j"}], ")"}]], "\[Transpose]"}]}], ")"}], 
       RowBox[{"exp", "(", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["\[DoubleStruckI]\[Xi]", 
           RowBox[{"(", 
            RowBox[{"i", ",", "j"}], ")"}]]}], "\[CenterDot]", 
         SuperscriptBox["J", 
          RowBox[{"(", 
           RowBox[{"i", ",", "j"}], ")"}]]}], ")"}]}]}]},
    {
     RowBox[{
      SuperscriptBox["p", 
       RowBox[{"(", 
        RowBox[{"i", ",", "j"}], ")"}]], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["J", 
           RowBox[{"(", "i", ")"}]], " ", "-", " ", 
          SuperscriptBox["J", 
           RowBox[{"(", "j", ")"}]]}], ")"}], 
        RowBox[{
         SuperscriptBox["L", 
          RowBox[{"(", 
           RowBox[{"i", ",", "j"}], ")"}]], "\[Transpose]"}]}], " ", "=", " ", 
       RowBox[{
        SuperscriptBox["J", 
         RowBox[{"(", 
          RowBox[{"i", ",", "j"}], ")"}]], 
        RowBox[{
         SuperscriptBox["L", 
          RowBox[{"(", 
           RowBox[{"i", ",", "j"}], ")"}]], "\[Transpose]"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916164935859263*^9, 3.916164936385347*^9}, {
