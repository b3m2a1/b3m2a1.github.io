           RowBox[{"arg", ",", " ", "q"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"Sequence", "@@", "#"}], "]"}], "]"}]}], "&"}], "/@", 
       RowBox[{"Permutations", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", "3", "}"}], "~", "Join", "~", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"1", ",", " ", 
           RowBox[{
            RowBox[{"Length", "@", "q"}], "-", "1"}]}], "]"}]}], 
        "\[IndentingNewLine]", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"poly", "=", 
      RowBox[{
       RowBox[{"int", "/.", 
