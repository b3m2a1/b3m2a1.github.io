1be2d954d6d7"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox["J", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}], "+"}]], " ", "=", " ", 
      RowBox[{
       SuperscriptBox["p", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"i", ",", "j"}], ")"}], "+"}]], "\[InvisibleSpace]", "L", 
       " "}]}]},
    {
     RowBox[{
      RowBox[{"\[Implies]", " ", 
       SuperscriptBox["p", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"i", ",", "j"}], ")"}], "+"}]]}], " ", "=", " ", 
      RowBox[{
       SuperscriptBox["J", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"i", ",", "j"}], ")"}], "+"}]], 
       SuperscriptBox["L", "T"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916114563740815*^9, 3.916114596610208*^9}, {
  3.9161146379379053`*^9, 3.9161146718294764`*^9}, {3.9161147075108557`*^9, 
  3.916114716898829*^9}, {3.916114807120183*^9, 3.91611480734803*^9}, {
  3.9161149229947147`*^9, 
  3.916114949091598*^9}},ExpressionUUID->"8093a7d5-4292-4195-b527-\
1a8692f8c42e"],

Cell["and so we could write", "ExpositoryText",
 CellChangeTimes->{{3.916114809624628*^9, 
  3.916114811943359*^9}},ExpressionUUID->"8d2f571a-087e-459b-921a-\
03b2cba59871"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox[
       RowBox[{
        SuperscriptBox["\[CapitalSigma]", 
         RowBox[{
          RowBox[{"-", "1"}], 
          RowBox[{"(", 
           RowBox[{"i", ",", "j"}], ")"}]}]], "(", 
        SuperscriptBox["J", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"i", ",", "j"}], ")"}], "+"}]], ")"}], "T"], " ", "=", " ", 
      RowBox[{
       SuperscriptBox["L", "T"], 
       FractionBox["1", 
        RowBox[{"2", 
         SuperscriptBox["\[Alpha]", 
          RowBox[{"(", 
           RowBox[{"i", ",", "j"}], ")"}]]}]], "L", "\[InvisibleSpace]", 
       SuperscriptBox["L", "T"]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       SuperscriptBox["L", "T"], "(", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"2", 
          SuperscriptBox["\[Alpha]", 
           RowBox[{"(", 
            RowBox[{"i", ",", "j"}], ")"}]]}]], 
        SuperscriptBox["p", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"i", ",", "j"}], ")"}], "+"}]]}], ")"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916114819669573*^9, 3.916114912705879*^9}, {
  3.916114964615767*^9, 
  3.916115016561652*^9}},ExpressionUUID->"3d3f6f9d-421d-471d-9eff-\
aae91165d03f"],

Cell["and therefore", "ExpositoryText",
 CellChangeTimes->{{3.916115022973469*^9, 
  3.9161150300734*^9}},ExpressionUUID->"5d7dd22c-4b9a-4adc-bca9-32118b3b9571"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[Sum]", "s"], " ", 
    RowBox[{
     FractionBox[
      RowBox[{
       SubscriptBox["B", "m"], "\[InvisibleSpace]", 
       RowBox[{
        SubsuperscriptBox["L", "s", 
         RowBox[{"(", 
          RowBox[{"i", ",", "j"}], ")"}]], "\[Transpose]"}]}], 
      RowBox[{"2", 
       SubsuperscriptBox["\[Alpha]", "s", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]]}]], "\[InvisibleSpace]", 
     SubsuperscriptBox["p", "s", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"i", ",", "j"}], ")"}], "+"}]]}]}], " ", "=", " ", 
   RowBox[{
    SubscriptBox["B", "m"], 
    SuperscriptBox["\[CapitalSigma]", 
     RowBox[{"(", 
      RowBox[{"i", ",", "j"}], ")"}]], "\[InvisibleSpace]", 
    SuperscriptBox[
     SuperscriptBox["J", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"i", ",", "j"}], ")"}], "+"}]], "T"]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9161150311333647`*^9, 3.916115032221281*^9}, {
  3.916115080409645*^9, 3.9161150995634623`*^9}, {3.91614639756649*^9, 
  3.916146400615334*^9}},ExpressionUUID->"084a5120-50cc-4de2-9b92-\
fceb8e3a42d0"],

Cell["\<\
and the covariance-phase vector will show up so often it deserves a name, we\
\[CloseCurlyQuote]ll call it\
\>", "ExpositoryText",
