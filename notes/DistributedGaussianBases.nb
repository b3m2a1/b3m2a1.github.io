Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        SuperscriptBox["\[CapitalSigma]", 
         RowBox[{"(", "c", ")"}]], ")"}], 
       RowBox[{"-", "1"}]], " ", "=", " ", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"L", "(", 
          SuperscriptBox["\[CapitalLambda]", 
