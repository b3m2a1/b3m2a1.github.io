  3.88396398813708*^9}},ExpressionUUID->"40099e20-44ac-469c-975c-\
cbe5ed481e6d"],

Cell["leading to", "ExpositoryText",
 CellChangeTimes->{{3.883867762358687*^9, 
  3.883867763902996*^9}},ExpressionUUID->"b6a6052e-a431-4227-a554-\
d3b536774576"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"\[Phi]", "(", 
       RowBox[{"x", ",", " ", 
        SubscriptBox["\[Xi]", "c"], ",", " ", 
        SubscriptBox["\[CapitalSigma]", "c"]}], ")"}], " ", "=", " ", 
      RowBox[{"\[Phi]", "(", 
       RowBox[{"q", ",", " ", 
        SubscriptBox["\[Zeta]", "c"], ",", " ", 
        SubscriptBox["\[CapitalLambda]", "c"]}], ")"}]}]},
    {
     RowBox[{
      SubscriptBox["\[Zeta]", "c"], " ", "=", " ", 
      RowBox[{
       SubscriptBox["L", "c"], "(", 
       RowBox[{
        SubscriptBox["\[Xi]", "c"], "-", 
        SubscriptBox["\[Xi]", "j"]}], ")"}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SubscriptBox["L", "c"], 
       RowBox[{
        SubscriptBox["\[CapitalSigma]", "c"], "(", 
        RowBox[{
         RowBox[{
          SuperscriptBox[
           SubscriptBox["\[CapitalSigma]", "i"], 
           RowBox[{"-", "1"}]], "\[InvisibleSpace]", 
          SubscriptBox["\[Xi]", "i"]}], " ", "+", " ", 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["\[CapitalSigma]", "j"], 
           RowBox[{"-", "1"}]], "\[InvisibleSpace]", 
          SubscriptBox["\[Xi]", "j"]}], " ", "-", " ", 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["\[CapitalSigma]", "c"], 
           RowBox[{"-", "1"}]], 
          SubscriptBox["\[Xi]", "j"]}]}], ")"}]}]}]},
    {
     RowBox[{" ", 
      RowBox[{"=", " ", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          SubscriptBox["\[CapitalLambda]", "c"], ")"}], 
         RowBox[{"-", "1"}]], 
        RowBox[{
         SuperscriptBox[
          SubscriptBox["L", "c"], 
          StyleBox["T",
           FontSize->9,
           FontSlant->"Plain"]], "(", 
         RowBox[{
          RowBox[{
           SuperscriptBox[
            SubscriptBox["\[CapitalSigma]", "i"], 
            RowBox[{"-", "1"}]], "\[InvisibleSpace]", 
           SubscriptBox["\[Xi]", "i"]}], " ", "+", " ", 
          RowBox[{
           SuperscriptBox[
            SubscriptBox["\[CapitalSigma]", "j"], 
            RowBox[{"-", "1"}]], "\[InvisibleSpace]", 
           SubscriptBox["\[Xi]", "j"]}], " ", "-", " ", 
          RowBox[{
           SuperscriptBox[
            SubscriptBox["\[CapitalSigma]", "c"], 
            RowBox[{"-", "1"}]], 
           SubscriptBox["\[Xi]", "j"]}]}], ")"}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SubscriptBox["\[CapitalLambda]", "c"], ")"}], 
        RowBox[{"-", "1"}]], 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["L", "c"], 
         StyleBox["T",
          FontSize->9,
          FontSlant->"Plain"]], "(", 
        RowBox[{
         SuperscriptBox[
          SubscriptBox["\[CapitalSigma]", "i"], 
          RowBox[{"-", "1"}]], "(", 
         RowBox[{
          SubscriptBox["\[Xi]", "i"], " ", "-", " ", 
          SubscriptBox["\[Xi]", "j"]}], ")"}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.883867804574575*^9, 3.883867805850523*^9}, {
   3.883867863555655*^9, 3.883867934766034*^9}, {3.883867969607089*^9, 
   3.8838680214392853`*^9}, 3.883868207763274*^9, {3.883868439404769*^9, 
   3.8838684495087547`*^9}, {3.8838687239810467`*^9, 3.883868752493073*^9}, {
   3.883874404562653*^9, 3.8838744150286207`*^9}, {3.883963990206623*^9, 
