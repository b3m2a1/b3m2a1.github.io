     "\[IndentingNewLine]", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"testMat2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"#", ".", 
      RowBox[{"Transpose", "[", "#", "]"}]}], "&"}], "@", 
    RowBox[{"BlockRandom", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"SeedRandom", "[", "1", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", "}"}], ",", " ", 
        RowBox[{"{", 
