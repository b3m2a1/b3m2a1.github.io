bbe1226539b5"],

Cell["which is of course our original expression.", "ExpositoryText",
 CellChangeTimes->{{3.884051281752636*^9, 
  3.884051290316655*^9}},ExpressionUUID->"0ff2143f-a187-466a-8698-\
01473a3c2d8a"],

Cell[TextData[{
 "Finally, by diagonalizing ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[CapitalSigma]", "c"], 
    RowBox[{"-", "1"}]], TraditionalForm]],
  CellChangeTimes->{{3.8838473346089563`*^9, 3.8838473971907187`*^9}},
  ExpressionUUID->"c78207d5-96fe-47c4-b17f-7bd7aa513262"],
 " we can get a new set of normal effective modes and alphas, returning to a \
decoupled form, with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Alpha]", 
     RowBox[{"(", "c", ")"}]], " ", "=", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SuperscriptBox["\[CapitalLambda]", 
        RowBox[{"(", "c", ")"}]], ")"}], 
      RowBox[{"-", "1"}]], "/", "2"}]}], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "8b61dd82-3bec-4f9b-bdb7-606d65ecbb68"],
 " for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalLambda]", 
    RowBox[{"(", "c", ")"}]], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"96089354-03b2-46d1-ab7b-3dfac93d6d05"],
 " the vector of eigenvalues"
}], "ExpositoryText",
 CellChangeTimes->{{3.883847433657187*^9, 3.883847466894005*^9}, {
  3.883853839992737*^9, 3.883853864984901*^9}, {3.884023765082852*^9, 
