341fe0856922"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"\[Integral]", 
         RowBox[{
          SubscriptBox[
           RowBox[{"(", 
            RowBox[{"B", "\[InvisibleSpace]", 
             SuperscriptBox["L", "T"], "\[InvisibleSpace]\[InvisibleSpace]", 
             "R"}], ")"}], "m"], 
          SuperscriptBox["\[CurlyPhi]", 
           RowBox[{"(", "i", ")"}]], 
          SuperscriptBox["\[CurlyPhi]", 
           RowBox[{"(", "j", ")"}]]}]}], " ", ")"}], "+"], " ", "=", " ", 
      RowBox[{
       SubsuperscriptBox["X", "0", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]], " ", 
       FractionBox[
        RowBox[{"sin", "(", 
         RowBox[{
          SuperscriptBox["p", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"i", ",", "j"}], ")"}], "+"}]], "\[CenterDot]", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", 
            RowBox[{"i", ",", "j"}], ")"}]]}], "\[InvisibleSpace]", ")"}], 
        "2"], " ", 
       SubscriptBox["B", "m"], 
       SuperscriptBox["\[Rho]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"i", ",", "j"}], ")"}], "+"}]]}]}]},
    {
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"\[Integral]", 
         RowBox[{
          SubscriptBox[
           RowBox[{"(", 
            RowBox[{"B", "\[InvisibleSpace]", 
             SuperscriptBox["L", "T"], "\[InvisibleSpace]\[InvisibleSpace]", 
             "R"}], ")"}], "m"], 
          SuperscriptBox["\[CurlyPhi]", 
           RowBox[{"(", "i", ")"}]], 
          SuperscriptBox["\[Gamma]", 
           RowBox[{"(", "j", ")"}]]}]}], " ", ")"}], "+"], " ", "=", " ", 
      RowBox[{
       SubsuperscriptBox["X", "0", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]], " ", 
       FractionBox[
        RowBox[{"cos", "(", 
         RowBox[{
          SuperscriptBox["p", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"i", ",", "j"}], ")"}], "+"}]], "\[CenterDot]", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", 
            RowBox[{"i", ",", "j"}], ")"}]]}], "\[InvisibleSpace]", ")"}], 
        "2"], " ", 
       SubscriptBox["B", "m"], 
       SuperscriptBox["\[Rho]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"i", ",", "j"}], ")"}], "+"}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
