Cell[TextData[{
 "and now we want to gather terms by their order in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", 
    StyleBox["\[VeryThinSpace] ",
     FontSize->14], 
    StyleBox["-",
     FontSize->14], 
    StyleBox[" ",
     FontSize->14], 
    SuperscriptBox["\[Xi]", 
     RowBox[{"(", 
      RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]]}], TraditionalForm]],
  CellChangeTimes->{{3.8860956515298634`*^9, 3.8860956734250174`*^9}, {
    3.886095718728961*^9, 3.886095755584618*^9}, {3.886095804302402*^9, 
    3.8860959248370247`*^9}, {3.886095963218287*^9, 3.886096017882414*^9}, {
    3.88609670020415*^9, 3.886096700818387*^9}, {3.886531053589839*^9, 
    3.886531159251886*^9}, {3.886531279682233*^9, 3.886531571824119*^9}, {
    3.886531686548986*^9, 3.8865316941538963`*^9}, 3.886541475199724*^9, {
    3.8865418515471697`*^9, 3.886542018788939*^9}, {3.886542056026785*^9, 
    3.8865420685824537`*^9}, {3.886542117155126*^9, 3.886542188224058*^9}, {
    3.886542451613285*^9, 3.886542452766871*^9}, {3.886542542508514*^9, 
    3.8865425588297863`*^9}, {3.8865426111861553`*^9, 3.886542744333531*^9}, 
    3.886542822035034*^9},ExpressionUUID->
  "acd6f3b4-3765-4ebe-ad00-44c01a737fef"],
 " so we can have one coefficient per order. "
}], "ExpositoryText",
 CellChangeTimes->{{3.886542901281962*^9, 
  3.8865429633070393`*^9}},ExpressionUUID->"392dc697-7b12-4849-b29f-\
49eca1b63ac6"],

Cell[TextData[{
 "To do this we note that the maximum order possible is ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "7c22d0b9-2424-4d1d-975f-336bbc6fa3a9"],
 ", so we will perform our summation up to order ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "d505ded3-1a9a-43b9-8dc4-5affbceb1f03"],
 " as"
}], "ExpositoryText",
 CellChangeTimes->{{3.886542966544589*^9, 3.88654298314254*^9}, {
