   3.913903006544195*^9, {3.9139033753233557`*^9, 
   3.913903399111044*^9}},ExpressionUUID->"79463ef7-3aa1-4540-9cf8-\
8c786d3f6801"],

Cell["and we assume higher up that this turns into", "ExpositoryText",
 CellChangeTimes->{{3.913902292716601*^9, 3.913902336745756*^9}, {
  3.913902402221146*^9, 
  3.913902408516725*^9}},ExpressionUUID->"50bb1fae-df18-44b7-84bf-\
3181ded54126"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SqrtBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"2", "\[Pi]"}], ")"}], 
          RowBox[{"(", 
           RowBox[{"d", "-", "k"}], ")"}]], 
         FractionBox[
          RowBox[{
          "\[LeftBracketingBar]", "\[VeryThinSpace]", "\[CapitalSigma]", 
           "\[RightBracketingBar]"}], 
          RowBox[{"\[LeftBracketingBar]", 
           SubscriptBox["\[CapitalSigma]", "\[Delta]"], 
           "\[RightBracketingBar]"}]]}]], 
       RowBox[{"\[Integral]", 
        RowBox[{
         RowBox[{"V", "(", "r", ")"}], 
         SuperscriptBox["e", 
          RowBox[{"-", 
           RowBox[{
            StyleBox["(",
             FontSize->12], 
            RowBox[{
             SuperscriptBox[
              StyleBox["\[Delta]",
               FontSize->12,
               FontWeight->"Bold"], "T"], 
             SuperscriptBox[
              SubscriptBox[
               StyleBox["\[CapitalSigma]",
                FontSize->12], "\[Delta]"], 
              RowBox[{"-", "1"}]], 
             StyleBox["\[InvisibleSpace]",
              FontSize->12], 
             StyleBox["\[Delta]",
              FontSize->12,
              FontWeight->"Bold"]}], 
            StyleBox[")",
             FontSize->12]}]}]], "d", "\[InvisibleSpace]", 
         StyleBox["\[Delta]",
          FontWeight->"Bold"]}]}]}], 
      StyleBox[" ",
       FontWeight->"Bold"], "=", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", "\[VeryThinSpace]", 
         RowBox[{"det", "(", 
          RowBox[{"2", "\[Pi]", "\[VeryThinSpace]", 
           SubscriptBox["\[CapitalSigma]", "c"]}], ")"}], ")"}], 
        RowBox[{"1", "/", "4"}]], " ", "..."}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"2", "\[Pi]"}], "\[VeryThinSpace]", ")"}], 
        RowBox[{"d", "/", "4"}]], "|", 
       SubscriptBox["\[CapitalSigma]", "c"], 
       SuperscriptBox["|", 
        RowBox[{"1", "/", "4"}]], " ", "..."}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.913902398883069*^9, 3.9139024589517527`*^9}, {
  3.91390252282736*^9, 3.913902526913643*^9}, {3.913903431258998*^9, 
