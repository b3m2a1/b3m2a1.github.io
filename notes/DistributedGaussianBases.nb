Cell[BoxData[
 TagBox[GridBox[{
    {
     InterpretationBox[
      StyleBox[
       RowBox[{"-", 
        TemplateBox[{"\"(\"", 
          TemplateBox[{"\"(\"", 
            RowBox[{"Q", "-", 
