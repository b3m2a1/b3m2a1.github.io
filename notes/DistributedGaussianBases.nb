         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Power", "[", 
           RowBox[{"_\[FormalQ]", ",", 
            RowBox[{"n_", "?", "OddQ"}]}], "]"}], ":>", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"_\[FormalQ]", ":>", "0"}]}], "\[IndentingNewLine]", 
        "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"norm", "=", 
      RowBox[{"Apply", "[", 
       RowBox[{"Times", ",", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"\[Pi]", "/", "alphas"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"poly", "*", "exp"}], ",", "\[IndentingNewLine]", "prefac", 
       ",", " ", "\[IndentingNewLine]", "alphas", ",", "\[IndentingNewLine]", 
       "poly", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Exp", "[", "prefac", "]"}], "*", 
        RowBox[{"Apply", "[", 
         RowBox[{"Times", ",", " ", 
          RowBox[{"Sqrt", "[", 
