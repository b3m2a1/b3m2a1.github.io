Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["G", "N"], "(", 
    RowBox[{"\[Alpha]", ",", " ", "p", ",", " ", "k", ",", " ", "b"}], ")"}], 
   " ", "=", " ", 
   RowBox[{
    FractionBox[
     SuperscriptBox["2", 
      RowBox[{"\[LeftCeiling]", 
       RowBox[{"k", "/", "2"}], "\[RightCeiling]"}]], 
     SqrtBox["\[Pi]"]], " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"n", "=", "0"}], "k"], " ", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", 
         FractionBox["1", 
          RowBox[{"2", "\[InvisibleSpace]"}]]}], ")"}], "n"], 
      FractionBox[
       RowBox[{"\[CapitalGamma]", "(", 
        RowBox[{"b", "+", "m"}], ")"}], 
       SubscriptBox[
        RowBox[{"(", "b", ")"}], 
        RowBox[{"(", "n", ")"}]]], "\[VeryThinSpace]", 
      RowBox[{"(", GridBox[{
         {"m"},
         {"n"}
        },
        GridBoxAlignment->{"Columns" -> {Center}}], ")"}], "\[VeryThinSpace]\[VeryThinSpace]", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox[
         SuperscriptBox["p", 
          RowBox[{"2", "\[InvisibleSpace]"}]], 
         RowBox[{"2", "\[Alpha]"}]], ")"}], "n"]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
