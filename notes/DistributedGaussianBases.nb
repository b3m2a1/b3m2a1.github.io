Cell[BoxData[
 RowBox[{
  RowBox[{"hermy", "[", 
   RowBox[{"n_", ",", "x_"}], "]"}], ":=", 
  RowBox[{
   SqrtBox[
    FractionBox["\[Pi]", "2"]], 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      SuperscriptBox["\[Alpha]", 
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "\[InvisibleSpace]", "n"}], "+", "1"}], ")"}]}]], 
      RowBox[{"2", "\[Pi]"}]], ")"}], 
    RowBox[{"1", "/", "4"}]], 
   RowBox[{"Total", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"n", "!"}], " ", 
        SuperscriptBox["x", 
         RowBox[{"n", "-", 
          RowBox[{"2", " ", "m"}]}]]}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"m", "!"}], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", "-", 
             RowBox[{"2", " ", "m"}]}], ")"}], "!"}]}], ")"}], " ", 
        SuperscriptBox["2", 
         RowBox[{
          RowBox[{"2", " ", "m"}], "-", "1"}]]}]], ",", 
      RowBox[{"{", 
