073533068948"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox[
        RowBox[{
         RowBox[{"\[CapitalGamma]", "(", 
          RowBox[{"b", "+", "k"}], ")"}], 
         "\[VeryThinSpace]\[InvisibleSpace]"}], "1"], "\[InvisibleSpace]", 
       RowBox[{
        SubscriptBox["F", "1"], "(", 
        RowBox[{
         RowBox[{"b", "+", "k"}], ";", " ", "b", ";", " ", "x"}], ")"}]}], 
      " ", "=", " ", 
      RowBox[{
       RowBox[{"\[CapitalGamma]", "(", 
        RowBox[{"b", "+", "k"}], ")"}], 
       FractionBox[
        RowBox[{"\[CapitalGamma]", "(", "b", ")"}], 
        RowBox[{"\[CapitalGamma]", "(", 
         RowBox[{"b", "+", "k"}], ")"}]], 
       SuperscriptBox["e", "x"], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"n", "=", "0"}], "k"], " ", 
        RowBox[{
         SubscriptBox[
          RowBox[{
           RowBox[{"(", GridBox[{
              {
               RowBox[{"k", "+", "b", "-", "1"}]},
              {
               RowBox[{"k", "-", "n"}]}
             },
             GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
           "\[VeryThinSpace]", "[", "k", "]"}], 
          RowBox[{"(", 
           RowBox[{"k", "-", "n"}], ")"}]], 
         SuperscriptBox["x", "n"]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SuperscriptBox["e", "x"], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"n", "=", "0"}], "k"], " ", 
        RowBox[{
         SubscriptBox[
          RowBox[{
           FractionBox[
            RowBox[{
             RowBox[{"\[CapitalGamma]", "(", "b", ")"}], 
             RowBox[{"\[CapitalGamma]", "(", 
              RowBox[{"k", "+", "b"}], ")"}]}], 
            RowBox[{
             RowBox[{"\[CapitalGamma]", "(", 
              RowBox[{"k", "-", "n", "+", "1"}], ")"}], 
             RowBox[{"\[CapitalGamma]", "(", 
              RowBox[{"n", "+", "b"}], ")"}]}]], "\[VeryThinSpace]", "[", "k",
            "]"}], 
          RowBox[{"(", 
           RowBox[{"k", "-", "n"}], ")"}]], 
         SuperscriptBox["x", "n"]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SuperscriptBox["e", "x"], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"n", "=", "0"}], "k"], " ", 
        RowBox[{
         FractionBox[
          RowBox[{
           RowBox[{"\[CapitalGamma]", "(", "b", ")"}], 
           RowBox[{"\[CapitalGamma]", "(", 
            RowBox[{"k", "+", "b"}], ")"}]}], 
          RowBox[{"\[CapitalGamma]", "(", 
           RowBox[{"n", "+", "b"}], ")"}]], "\[VeryThinSpace]", 
         FractionBox[
          RowBox[{"\[CapitalGamma]", "(", 
           RowBox[{"k", "+", "1"}], ")"}], 
          RowBox[{
           RowBox[{"\[CapitalGamma]", "(", 
            RowBox[{"k", "-", "n", "+", "1"}], ")"}], 
           RowBox[{"\[CapitalGamma]", "(", 
            RowBox[{"n", "+", "1"}], ")"}]}]], 
         SuperscriptBox["x", "n"]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SuperscriptBox["e", "x"], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"n", "=", "0"}], "k"], " ", 
        RowBox[{
         FractionBox[
          RowBox[{
           RowBox[{"\[CapitalGamma]", "(", "b", ")"}], 
           RowBox[{"\[CapitalGamma]", "(", 
            RowBox[{"b", "+", "k"}], ")"}]}], 
          RowBox[{"\[CapitalGamma]", "(", 
           RowBox[{"n", "+", "b"}], ")"}]], "\[VeryThinSpace]", 
         RowBox[{"(", GridBox[{
            {"k"},
            {"n"}
           },
           GridBoxAlignment->{"Columns" -> {Center}}], ")"}], "\[VeryThinSpace]\[VeryThinSpace]", 
         SuperscriptBox["x", "n"]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916057402731289*^9, 3.916057413462357*^9}, {
