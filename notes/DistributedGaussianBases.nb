       RowBox[{"i", ",", "j"}], ")"}]], " ", 
     SubscriptBox[
      RowBox[{"(", 
       SuperscriptBox["J", 
        RowBox[{"(", "j", ")"}]], ")"}], "m"]}]}], " ", "=", " ", 
   SubscriptBox[
    RowBox[{
