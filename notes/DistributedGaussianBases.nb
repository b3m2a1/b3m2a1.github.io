       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{"normalize", ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Exp", "[", "prefac", "]"}], "*", 
            RowBox[{"Apply", "[", 
             RowBox[{"Times", ",", " ", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"\[Pi]", "/", "alphas"}], "]"}]}], "]"}]}], ",", 
           "\[IndentingNewLine]", "1"}], "\[IndentingNewLine]", "]"}], "*", 
         "\[IndentingNewLine]", "poly"}], "/.", 
        RowBox[{
         RowBox[{"Power", "[", 
          RowBox[{
           RowBox[{"\[FormalQ]", "[", "i_", "]"}], ",", " ", "k_"}], "]"}], ":>", 
         RowBox[{"(", "\[IndentingNewLine]", 
          RowBox[{
