Cell["Generic Shifted Integral", "Subsubsection",
 CellChangeTimes->{{3.916022568344323*^9, 
  3.916022571947913*^9}},ExpressionUUID->"d3c6f1f3-62d9-46f7-bb71-\
4b88f08707bf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"baseShiftedIntegral", "=", "\[IndentingNewLine]", 
  RowBox[{"Assuming", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"a", ">", "0"}], "&&", 
     RowBox[{"p", ">", "0"}], "&&", 
     RowBox[{"k", ">", "0"}], "&&", 
     RowBox[{"k", "\[Element]", "Integers"}], "&&", 
     RowBox[{"c", "\[Element]", "Reals"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"q", "^", "k"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "a"}], " ", 
          SuperscriptBox["q", "2"]}], " ", "+", " ", 
         RowBox[{"I", " ", "p", " ", 
          RowBox[{"(", 
           RowBox[{"q", "-", "c"}], ")"}]}]}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"q", ",", " ", 
        RowBox[{"-", "\[Infinity]"}], ",", " ", "\[Infinity]"}], "}"}]}], 
     "]"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.9160139436442966`*^9, 3.916013943808165*^9}, {
   3.916014044339932*^9, 3.916014050302993*^9}, {3.916014150011304*^9, 
   3.916014152103916*^9}, {3.9160153744323063`*^9, 3.916015375101864*^9}, 
   3.916022549929492*^9},
 CellLabel->
