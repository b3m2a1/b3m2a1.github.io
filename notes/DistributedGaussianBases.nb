0c05ec5121af"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["P", "n", 
     RowBox[{"(", "i", ")"}]], "(", "x", ")"}], " ", "=", " ", 
   RowBox[{
    FractionBox["1", 
     SqrtBox[
      RowBox[{"n", "!"}]]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"\[Lambda]", "\[VeryThinSpace]", "=", "0"}], "n"], 
     "\[VeryThinSpace]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"l", "=", "0"}], 
       RowBox[{
        TemplateBox[{
          RowBox[{"n", "-", 
            RowBox[{"\[Lambda]", "/", "2"}]}]},
         "Floor"], " ", "+", " ", "1"}]], 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "l"], 
       SuperscriptBox[
        RowBox[{
         SubsuperscriptBox["\[Eta]", "l", "n"], "\[VeryThinSpace]", "(", 
         RowBox[{"2", "\[InvisibleSpace]", 
          SqrtBox[
           SuperscriptBox["\[Alpha]", 
            RowBox[{"(", "i", ")"}]]]}], ")"}], 
        RowBox[{"n", "-", 
         RowBox[{"2", "\[InvisibleSpace]", "l"}]}]], 
       RowBox[{"(", GridBox[{
          {
           RowBox[{"n", "-", 
            RowBox[{"2", "\[InvisibleSpace]", "l"}]}]},
          {
           RowBox[{"\[InvisibleSpace]", "\[Lambda]"}]}
         },
         GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
       SuperscriptBox[
        RowBox[{"(", " ", 
         RowBox[{
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", 
            RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], "-", 
          "\[VeryThinSpace]", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", "i", ")"}]]}], ")"}], 
        RowBox[{"n", "-", 
         RowBox[{"2", "\[InvisibleSpace]", "l"}], "-", "\[Lambda]"}]], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", 
          StyleBox["\[VeryThinSpace] ",
           FontSize->14], 
          StyleBox["-",
           FontSize->14], 
          StyleBox[" ",
           FontSize->14], 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", 
            RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]]}], ")"}], 
        "\[Lambda]"]}]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
