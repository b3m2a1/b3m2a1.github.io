Cell[CellGroupData[{

Cell["Linear Terms", "Subsubsubsection",
 CellChangeTimes->{{3.916089092090995*^9, 
  3.916089095305929*^9}},ExpressionUUID->"fc8db730-0af0-441e-851b-\
78ed76f53b16"],

Cell["We\[CloseCurlyQuote]ll have things like", "ExpositoryText",
 CellChangeTimes->{{3.9160890986834087`*^9, 3.916089104301445*^9}, {
  3.916112493849195*^9, 
  3.916112496136105*^9}},ExpressionUUID->"34e6884a-3b5f-4e32-a377-\
fe41fdcc72ec"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["\[Integral]", 
        RowBox[{"-", "\[Infinity]"}], 
        RowBox[{"\[VeryThinSpace]", "\[Infinity]"}]], 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["V", "n", 
          RowBox[{"(", "1", ")"}]], "(", 
         RowBox[{"Q", "-", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", 
            RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], 
        SuperscriptBox["\[CurlyPhi]", 
         RowBox[{"(", "i", ")"}]], 
        SuperscriptBox["\[CurlyPhi]", 
         RowBox[{"*", 
          RowBox[{"(", "j", ")"}]}]]}]}], " ", "=", 
      RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", 
       SubsuperscriptBox["X", "0", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]], "\[InvisibleSpace]", 
       RowBox[{
        UnderscriptBox["\[Sum]", "s"], 
        RowBox[{
         FractionBox[
          SubscriptBox[
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["V", 
              RowBox[{"(", "1", ")"}]], "\[InvisibleSpace]", 
             RowBox[{"L", "\[Transpose]"}]}], ")"}], 
           RowBox[{"n", "\[InvisibleSpace]", "s"}]], 
          RowBox[{"2", 
           SubsuperscriptBox["\[Alpha]", "s", 
            RowBox[{"(", 
             RowBox[{"i", ",", "j"}], ")"}]]}]], 
         SubsuperscriptBox["p", "s", 
          RowBox[{"(", 
           RowBox[{"i", ",", "j"}], ")"}]]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", 
       SubsuperscriptBox["X", "0", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]], 
       RowBox[{
        UnderscriptBox["\[Sum]", "s"], 
        RowBox[{
         SubscriptBox[
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["V", 
             RowBox[{"(", "1", ")"}]], "\[InvisibleSpace]", 
            RowBox[{"L", "\[Transpose]"}]}], ")"}], 
          RowBox[{"n", "\[InvisibleSpace]", "s"}]], 
         SubscriptBox[
          RowBox[{
           SubsuperscriptBox["\[CapitalLambda]", 
            RowBox[{"s", "\[InvisibleSpace]", "s"}], 
            RowBox[{"(", 
             RowBox[{"i", ",", "j"}], ")"}]], "(", 
           RowBox[{
            SuperscriptBox["J", 
             RowBox[{"(", 
              RowBox[{"i", ",", "j"}], ")"}]], 
            RowBox[{"L", "\[Transpose]"}]}], ")"}], "s"]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", 
       SubsuperscriptBox["X", "0", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]], "\[InvisibleSpace]", 
       RowBox[{
        UnderscriptBox["\[Sum]", "s"], 
        RowBox[{
         SubscriptBox[
          RowBox[{
           SubsuperscriptBox["V", "n", 
            RowBox[{"(", "1", ")"}]], "(", "\[InvisibleSpace]", 
           RowBox[{"L", "\[Transpose]"}], ")"}], 
          RowBox[{":", "\[InvisibleSpace]", "s"}]], 
         SubscriptBox[
          RowBox[{
           SubsuperscriptBox["\[CapitalLambda]", 
            RowBox[{"s", "\[InvisibleSpace]", "s"}], 
            RowBox[{"(", 
             RowBox[{"i", ",", "j"}], ")"}]], "(", "L", ")"}], 
          RowBox[{"s", ":"}]], 
         RowBox[{
          SuperscriptBox["J", 
           RowBox[{"(", 
            RowBox[{"i", ",", "j"}], ")"}]], "\[Transpose]"}]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", 
       SubsuperscriptBox["X", "0", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]], 
       SubsuperscriptBox["V", "n", 
        RowBox[{"(", "1", ")"}]], 
       SuperscriptBox["\[CapitalSigma]", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]], 
       RowBox[{
        SuperscriptBox["J", 
         RowBox[{"(", 
          RowBox[{"i", ",", "j"}], ")"}]], "\[Transpose]"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916065891914401*^9, 3.916065913384111*^9}, {
