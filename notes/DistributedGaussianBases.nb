Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Integral]", 
        SuperscriptBox["\[DoubleStruckCapitalR]", "N"]], 
       RowBox[{
        RowBox[{"V", "(", "\[InvisibleSpace]", 
         StyleBox["x",
          FontWeight->"Bold"], ")"}], "\[AlignmentMarker]", 
        RowBox[{
         UnderoverscriptBox["\[Product]", 
          RowBox[{"k", "\[VeryThinSpace]", "=", "\[VeryThinSpace]", "1"}], 
          RowBox[{"3", "\[InvisibleSpace]", "N"}]], " ", 
         RowBox[{
          RowBox[{"\[Phi]", "(", 
           RowBox[{
            RowBox[{
             SubscriptBox["x", 
              RowBox[{"k", ","}]], "\[AlignmentMarker]", 
             FractionBox[
              RowBox[{
               RowBox[{
                SubscriptBox["\[Alpha]", "i"], 
                SubsuperscriptBox["\[Xi]", "k", 
                 RowBox[{"(", "i", ")"}]]}], "+", 
               RowBox[{
                SubscriptBox["\[Alpha]", "j"], 
                SubsuperscriptBox["\[Xi]", "k", 
                 RowBox[{"(", "j", ")"}]]}]}], 
              RowBox[{
               SubscriptBox["\[Alpha]", "i"], "+", 
               SubscriptBox["\[Alpha]", "j"]}]]}], ",", " ", 
            RowBox[{
             SubscriptBox["\[Alpha]", "i"], "+", 
             SubscriptBox["\[Alpha]", "j"]}]}], ")"}], 
          RowBox[{"\[DifferentialD]", 
           StyleBox["x",
            FontWeight->"Bold"]}]}]}]}]}], 
      StyleBox[" ",
       FontWeight->"Bold"], "="}]},
    {
     RowBox[{"\[AlignmentMarker]", 
      RowBox[{
       SubscriptBox["S", 
        RowBox[{"i", "\[InvisibleSpace]", "j"}]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"m", "=", "0"}], "M"], " ", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"p", "\[Element]", 
           RowBox[{
            SubscriptBox["P", "E"], "(", "m", ")"}]}], "\[InvisibleSpace]"], 
         RowBox[{
          FractionBox["1", 
           RowBox[{
            SubscriptBox["W", "p"], 
            SqrtBox[
             SuperscriptBox["2", "m"]], "\[InvisibleSpace]"}]], 
          FractionBox[
           RowBox[{"\[PartialD]", 
            RowBox[{"V", "(", 
             StyleBox["\[Zeta]",
              FontWeight->"Bold"], ")"}]}], 
           RowBox[{
            RowBox[{
             RowBox[{"\[PartialD]", 
              SubsuperscriptBox["x", 
               RowBox[{"\[VeryThinSpace]", "1"}], 
               SubscriptBox["p", "1"]]}], "..."}], 
            RowBox[{"\[PartialD]", 
             SubsuperscriptBox["x", 
              RowBox[{"\[VeryThinSpace]", 
               RowBox[{"3", "\[InvisibleSpace]", "N"}]}], 
              SubscriptBox["p", 
               RowBox[{"\[VeryThinSpace]", 
                RowBox[{"3", "\[InvisibleSpace]", "N"}]}]]]}]}]], 
          RowBox[{
           UnderoverscriptBox["\[Product]", 
            RowBox[{"k", "=", "1"}], 
            RowBox[{"3", "\[InvisibleSpace]", "N"}]], " ", 
           RowBox[{
            FractionBox["1", 
             SuperscriptBox[
              SubscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubscriptBox["\[Alpha]", "i"], "+", 
                 SubscriptBox["\[Alpha]", "j"]}], ")"}], "k"], 
              StyleBox[
               RowBox[{
                SubscriptBox["p", "k"], "/", "2"}],
               FontSize->14]]], 
            RowBox[{
             UnderoverscriptBox["\[Product]", 
              RowBox[{"l", "=", "1"}], 
              RowBox[{
               SubscriptBox["p", "k"], "/", "2"}]], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", "\[InvisibleSpace]", "l"}], "-", "1"}], 
              ")"}]}]}]}]}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCenteredManuallyAligned",
 CellChangeTimes->{{3.883128607300531*^9, 3.883128641256111*^9}, {
