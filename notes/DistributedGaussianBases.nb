  3.91411980772649*^9}},ExpressionUUID->"9796b516-0396-426f-a039-\
8d33ac02122b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "dQ", ",", " ", "\[CapitalTau]Q", ",", "\[CapitalTau]Qsimp", ",", " ", 
    "nQ", ",", " ", "watSimp", ",", " ", "watFmt", ",", "wrapPlusRecursive"}],
    "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dQ", "[", 
    RowBox[{"\[Phi]", "[", "j", "]"}], "]"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"\[CapitalSigma]", "[", "j", "]"}], "**", 
       RowBox[{"Q", "[", 
        RowBox[{"\[Xi]", "[", "j", "]"}], "]"}]}]}], ")"}], "*", 
    RowBox[{"\[Phi]", "[", "j", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dQ", "[", 
    RowBox[{"NonCommutativeMultiply", "[", 
     RowBox[{"a_", ",", " ", "b_"}], "]"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"dQ", "[", "a", "]"}], "**", "b"}], "+", 
    RowBox[{"a", "**", 
     RowBox[{"dQ", "[", "b", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dQ", "[", 
    RowBox[{"CircleTimes", "[", 
     RowBox[{"a_", ",", " ", "b_"}], "]"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"dQ", "[", "a", "]"}], "\[CircleTimes]", "b"}], "+", 
    RowBox[{"\[CapitalTau]Q", "[", 
     RowBox[{
      RowBox[{"a", "\[CircleTimes]", 
       RowBox[{"dQ", "[", "b", "]"}]}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"nQ", "[", "a", "]"}], "+", "1"}], "->", "1"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dQ", "[", 
    RowBox[{
     RowBox[{"HoldPattern", "[", "Plus", "]"}], "[", "x__", "]"}], "]"}], ":=", 
   RowBox[{"Plus", "@@", 
