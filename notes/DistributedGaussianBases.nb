Cell[BoxData["\<\"From above we get three classes of terms (I dropped a \
negative on part of the third expression initially and a 1/2 on the \
second...)\\n\\\\begin{equation}\\\\left(\\\\Sigma ^{(c)}+\\\\xi \
^{(c)}\\\\otimes \\\\xi ^{(c)}\\\\right){}_{nm}\\\\left(\\\\Delta \\\\xi \
\\\\otimes \\\\Delta \\\\xi -\\\\Sigma \
^+\\\\right){}_{uv}\\\\end{equation}\\n\\\\begin{equation}-\\\\frac{1}{2}\\\\\
left(\\\\Gamma_{nv}^{(j)}\\\\Gamma_{mu}^{(i)} + \
\\\\Gamma_{nu}^{(j)}\\\\Gamma_{mv}^{(i)}\\\\right)\\\\end{equation}\\n\\\\\
begin{equation}-\\\\Sigma_n^{(c)}\\\\left(\\\\Delta \
\\\\Sigma_v\\\\xi_u^{(c)}+\\\\Delta \
\\\\Sigma_u\\\\xi_v^{(c)}\\\\right)\\\\Delta \
\\\\xi_m\\\\end{equation}\\nwhere\\n\\\\begin{align}\\n  \\\\Sigma ^+ =& \
\\\\left(\\\\Sigma ^{(i)}+\\\\Sigma ^{(j)}\\\\right)^{-1} \\\\\\\\\\n \
\\\\Delta \\\\xi  =& \\\\Sigma ^+\\\\left(\\\\xi ^{(i)}-\\\\xi \
^{(j)}\\\\right) \\\\\\\\\\n \\\\Gamma ^{(i)} =& \\\\Sigma ^{(c)}\\\\Sigma \
^{(i)^{-1}} \\\\\\\\\\n \\\\Delta \\\\Sigma  =& \\\\Sigma \
^{(i)^{-1}}-\\\\Sigma ^{(j)^{-1}} \\\\\\\\\\n\\\\end{align}\"\>"], "Print",
 CellChangeTimes->{3.9676333512638197`*^9},
 CellLabel->"",ExpressionUUID->"359d2015-c9de-4d8f-916f-6ce251019f94"]
}, Open  ]]
}, Open  ]],

