   3.9149759772670193`*^9}},ExpressionUUID->"749d6973-b7de-43a8-99e1-\
06d1c2e41d13"],

Cell[TextData[{
 "we\[CloseCurlyQuote]ll note that we are off from the standard Gaussian \
normalization by a factor of  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["2", 
     RowBox[{
      RowBox[{"\[Minus]", "d"}], "/", "2"}]], 
    RowBox[{"N", "(", "\[CapitalSigma]", ")"}]}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "5200cd9d-7ae8-4f35-9a1b-9bb0cb02b686"]
}], "ExpositoryText",
