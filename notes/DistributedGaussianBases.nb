a94539636bb0"],

Cell[TextData[{
 "where we pick ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "E"], "(", "m", ")"}], TraditionalForm]],
  CellChangeTimes->{{3.883128607300531*^9, 3.883128641256111*^9}, {
    3.8831287540205917`*^9, 3.883128817485443*^9}, 3.8839302295180407`*^9, {
