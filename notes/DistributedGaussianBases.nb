Cell[CellGroupData[{

Cell["General Term", "Subsubsubsection",
 CellChangeTimes->{{3.916167734762999*^9, 
  3.916167738239917*^9}},ExpressionUUID->"4986f709-2152-4abb-bf94-\
28a542eb03e1"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      FractionBox[
       RowBox[{
        SubsuperscriptBox["\[Integral]", 
         RowBox[{"-", "\[Infinity]"}], 
         RowBox[{"\[VeryThinSpace]", "\[Infinity]"}]], " ", 
        RowBox[{
         RowBox[{"[", 
          RowBox[{
           UnderoverscriptBox["\[Product]", 
            RowBox[{"n", "=", "1"}], "d"], " \[AlignmentMarker]", 
           RowBox[{
            SubsuperscriptBox["V", 
             SubscriptBox["b", "n"], 
             RowBox[{"(", 
              SubscriptBox["a", "n"], ")"}]], "(", 
            RowBox[{"Q", "-", 
             SuperscriptBox["\[Xi]", 
              RowBox[{"(", 
               RowBox[{"i", ",", "j"}], ")"}]]}], ")"}]}], "]"}], 
         SuperscriptBox["\[CurlyPhi]", 
          RowBox[{"(", "i", ")"}]], 
         SuperscriptBox["\[CurlyPhi]", 
          RowBox[{"(", "j", ")"}]]}]}], 
       SubsuperscriptBox["X", "0", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]]], "="}]},
    {
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{"k", "\[Element]", 
        RowBox[{"\[ScriptCapitalP]", "(", "d", ")"}]}]], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         UnderscriptBox["\[Sum]", 
          RowBox[{"s", "=", 
           RowBox[{"\[ScriptCapitalD]", "(", "k", ")"}]}]], " ", 
         RowBox[{"(", 
          RowBox[{
           UnderoverscriptBox["\[Product]", 
            RowBox[{"n", "=", "1"}], "d"], 
           RowBox[{
            SubsuperscriptBox["V", 
             SubscriptBox["b", "n"], 
             RowBox[{"(", 
              SubscriptBox["a", "n"], ")"}]], "\[InvisibleSpace]", 
            RowBox[{
             SubsuperscriptBox["L", 
              SubscriptBox["s", "n"], 
              RowBox[{"(", 
               RowBox[{"i", ",", "j"}], ")"}]], "\[Transpose]"}]}]}], ")"}]}],
         ")"}], "\[AlignmentMarker] ", 
       RowBox[{
        UnderoverscriptBox["\[Product]", 
         RowBox[{"m", "=", "1"}], "d"], " ", 
        RowBox[{
         FractionBox[
          SubsuperscriptBox["X", "0", 
           RowBox[{"(", 
            RowBox[{"i", ",", "j"}], ")"}]], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"2", 
             SubsuperscriptBox["\[Alpha]", "m", 
              RowBox[{"(", 
               RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], 
           RowBox[{"\[LeftCeiling]", 
            RowBox[{"k", "/", "2"}], "\[RightCeiling]"}]]], " ", 
         TagBox[GridBox[{
            {"\[Piecewise]", GridBox[{
               {
                RowBox[{" ", 
                 RowBox[{"\[DoubleStruckI]", "\[InvisibleSpace]\[VeryThinSpace]", 
                  SubsuperscriptBox["p", "m", 
                   RowBox[{"(", 
                    RowBox[{"i", ",", "j"}], ")"}]], "\[InvisibleSpace]", 
                  SubsuperscriptBox["M", "m", 
                   SubscriptBox["k", "m"]]}]}], 
                RowBox[{
                 SubscriptBox["k", "m"], " ", "odd"}]},
               {
                SubsuperscriptBox["M", "m", 
                 SubscriptBox["k", "m"]], 
                RowBox[{
                 SubscriptBox["k", "m"], " ", "even"}]}
              },
              AllowedDimensions->{2, Automatic},
              Editable->True,
              
              GridBoxAlignment->{
               "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
                "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
              
              GridBoxItemSize->{
               "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, 
