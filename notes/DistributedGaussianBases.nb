Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"BlockRandom", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"SeedRandom", "[", "10", "]"}], ";", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"L1", "=", 
      RowBox[{
       RowBox[{"RotationMatrix", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"\[Pi]", "/", "5"}], ",", "\[IndentingNewLine]", 
         RowBox[{"RandomInteger", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", " ", "3"}], 
          "]"}]}], "\[IndentingNewLine]", "]"}], "//", "N"}]}], ";"}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{"L1", "=", 
    RowBox[{"IdentityMatrix", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"a", "=", 
    RowBox[{"RandomInteger", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "5"}], "}"}], ",", " ", "n"}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"s1", "=", 
    RowBox[{
     RowBox[{"Transpose", "[", "L1", "]"}], ".", 
     RowBox[{"DiagonalMatrix", "[", "a", "]"}], ".", "L1"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"u1", "=", 
    RowBox[{"RandomReal", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", ".5"}], ",", " ", ".5"}], "}"}], ",", " ", 
      RowBox[{"{", "n", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"L2", "=", 
    RowBox[{"Eigenvectors", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"#", ".", 
        RowBox[{"Transpose", "[", "#", "]"}]}], "&"}], "@", 
      "\[IndentingNewLine]", 
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "n"}], "}"}]}], "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"L2", "=", 
      RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ";"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"a", "=", 
    RowBox[{"RandomInteger", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "5"}], "}"}], ",", " ", "n"}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"s2", "=", 
    RowBox[{
     RowBox[{"Transpose", "[", "L2", "]"}], ".", 
     RowBox[{"DiagonalMatrix", "[", "a", "]"}], ".", "L2"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"u2", "=", 
    RowBox[{"RandomReal", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", ".5"}], ",", " ", ".5"}], "}"}], ",", " ", 
      RowBox[{"{", "n", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"sc", "=", 
    RowBox[{"s1", " ", "+", " ", "s2"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ac", ",", " ", "L"}], "}"}], "=", 
    RowBox[{"Eigensystem", "[", "sc", "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"uc", " ", "=", " ", 
    RowBox[{
     RowBox[{"Inverse", "[", 
      RowBox[{"s1", " ", "+", " ", "s2"}], "]"}], ".", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"s1", ".", "u1"}], " ", "+", " ", 
       RowBox[{"s2", ".", "u2"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"m", "=", 
    RowBox[{"RandomInteger", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "5"}], "}"}], ",", " ", 
      RowBox[{"{", "n", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"z", "=", 
    RowBox[{"RandomReal", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", " ", "n"}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"x", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Symbol", "[", 
       RowBox[{"\"\<x\>\"", "<>", 
        RowBox[{"ToString", "@", "i"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "n"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
