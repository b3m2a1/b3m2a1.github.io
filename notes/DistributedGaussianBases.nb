 CellChangeTimes->{
  3.914168053498*^9},ExpressionUUID->"b42f7aea-865b-419c-8fbd-efe4717959b1"],

Cell[TextData[{
 "Once again, symmetry is our friend, we have the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "1"], "\[CircleTimes]", 
    SubscriptBox["S", "2"]}], TraditionalForm]],
  CellChangeTimes->{{3.9141216595340443`*^9, 3.91412167747157*^9}},
  ExpressionUUID->"14aecb26-e6aa-4303-88e2-0391b06fd9f8"],
 " property from above, but we also have the fact that if we have both "
}], "ExpositoryText",
 CellChangeTimes->{{3.9141219325961027`*^9, 3.914121966342533*^9}, {
  3.914122043097948*^9, 
  3.914122117061034*^9}},ExpressionUUID->"07ad2613-8333-41aa-861a-\
ddd19658541b"],

