   3.88395849529467*^9}},ExpressionUUID->"119b266e-b966-49d4-8ed3-\
9b0b33e5460b"],

Cell[TextData[{
 "which we can also make proportional to contribution from the overlap, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["S", 
     RowBox[{"i", "\[InvisibleSpace]", "j"}], 
     RowBox[{"(", "k", ")"}]], "=", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", 
       RowBox[{"\[Pi]", "/", "\[Alpha]"}]}], ")"}], 
     RowBox[{"1", "/", "4"}]]}], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"90feb901-06f5-4551-92cb-c3bae26ef0ff"]
}], "ExpositoryText",
 CellChangeTimes->{{3.8839288399075947`*^9, 3.8839288628974037`*^9}, {
  3.883941991090406*^9, 
  3.883942031929023*^9}},ExpressionUUID->"6cc16fa6-661f-4330-8701-\
cc71ca55caf3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"\[Phi]", "(", 
      RowBox[{
       RowBox[{
        SubscriptBox["x", 
         RowBox[{"k", ","}]], "0"}], ",", " ", "\[Alpha]"}], ")"}], 
     SuperscriptBox[
      SubscriptBox["x", 
       RowBox[{"\[VeryThinSpace]", "k"}]], 
      SubscriptBox["p", "k"]]}]}], " ", "=", " ", 
   RowBox[{
    FractionBox[
     SubsuperscriptBox["S", 
      RowBox[{"i", "\[InvisibleSpace]", "j"}], 
      RowBox[{"(", "k", ")"}]], 
     RowBox[{"\[InvisibleSpace]", 
      SqrtBox[
       RowBox[{
        SuperscriptBox["2", 
         StyleBox[
          SubscriptBox["p", "k"],
          FontSize->14]], 
        SuperscriptBox["\[Alpha]", 
         StyleBox[
          SubscriptBox["p", "k"],
          FontSize->14]]}]]}]], 
    RowBox[{
     UnderoverscriptBox["\[Product]", 
      RowBox[{"m", "=", "1"}], 
      RowBox[{
       SubscriptBox["p", "k"], "/", "2"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "\[InvisibleSpace]", "m"}], "-", "1"}], ")"}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.883928727750029*^9, 3.8839287465429897`*^9}, {
   3.8839287776397038`*^9, 3.883928837325186*^9}, 3.8839299050383673`*^9, {
