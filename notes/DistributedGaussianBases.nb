Cell[CellGroupData[{

Cell["Complex Phase Quadrature", "Subsection",
 CellChangeTimes->{{3.916432630379958*^9, 3.916432633234953*^9}, {
  3.916433285312392*^9, 
  3.916433286974431*^9}},ExpressionUUID->"759bece6-ca87-47ab-950f-\
8dcfe2fcca31"],

Cell["\<\
We know from the work on projections that we can reduce the integrals down to \
the form\
\>", "ExpositoryText",
 CellChangeTimes->{{3.91643328939345*^9, 3.916433299108368*^9}, {
  3.916498151102539*^9, 
  3.9164981563529463`*^9}},ExpressionUUID->"1daac386-5979-4cbe-85d7-\
0afdb4ebca75"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Integral]", 
   RowBox[{
    RowBox[{"V", "(", "\[Delta]", ")"}], 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          SubscriptBox["\[CapitalSigma]", "\[Delta]"], ")"}], 
         RowBox[{"-", "1"}]], "\[CircleDot]", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["q", "\[Delta]"], "-", 
           SubscriptBox["\[Mu]", "\[Delta]"]}], ")"}], "2"]}]}], " ", "+", 
      " ", 
      RowBox[{
       RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", "(", 
        RowBox[{
         SubscriptBox["\[CapitalSigma]", "\[Delta]"], "\[VeryThinSpace]", 
         "p"}], ")"}], "\[CenterDot]", 
       SubscriptBox["q", "\[Delta]"]}]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9164321968973503`*^9, 3.9164323208293867`*^9}, {
   3.916433329597685*^9, 3.916433347469716*^9}, {3.916434430279275*^9, 
   3.916434431235528*^9}, 
   3.916434474334475*^9},ExpressionUUID->"9d3c76d7-128b-494e-837a-\
6c75530ea46a"],

Cell["\<\
and by expanding the product (and doing some shifts by \[Mu]) we get\
\>", "ExpositoryText",
 CellChangeTimes->{{3.916433788015881*^9, 3.9164337903607693`*^9}, {
  3.916434202616043*^9, 
  3.916434215699009*^9}},ExpressionUUID->"5c0acb66-3830-4f9d-8173-\
84931fc89f04"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"V", "(", "\[Delta]", ")"}], 
     RowBox[{"exp", "(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", "2"]}], 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           SubscriptBox["\[CapitalSigma]", "\[Delta]"], ")"}], 
          RowBox[{"-", "1"}]], "\[CircleDot]", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["q", "\[Delta]"], "-", 
            SubscriptBox["\[Mu]", "\[Delta]"]}], ")"}], "2"]}]}], " ", "+", 
       " ", 
       RowBox[{
        RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", "(", 
         RowBox[{
          SubscriptBox["\[CapitalSigma]", "\[Delta]"], "\[VeryThinSpace]", 
          "p"}], ")"}], "\[CenterDot]", 
        SubscriptBox["q", "\[Delta]"]}]}], ")"}]}]}], " ", "=", 
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"V", "(", 
      RowBox[{"\[Delta]", "+", "\[Mu]"}], ")"}], 
     RowBox[{"exp", "(", 
      RowBox[{
       RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", "(", 
        RowBox[{
         SubscriptBox["\[CapitalSigma]", "\[Delta]"], "\[VeryThinSpace]", 
         "p"}], ")"}], "\[CenterDot]", 
       RowBox[{"(", 
        RowBox[{"\[Delta]", "+", "\[Mu]"}], ")"}]}], ")"}], 
     RowBox[{"exp", "(", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          SubscriptBox["\[CapitalSigma]", "\[Delta]"], ")"}], 
         RowBox[{"-", "1"}]], "\[CircleDot]", 
        SuperscriptBox["\[Delta]", "2"]}]}], ")"}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9164321968973503`*^9, 3.9164323208293867`*^9}, {
  3.916433329597685*^9, 3.916433347469716*^9}, {3.9164337992828693`*^9, 
  3.916433819348482*^9}, {3.916434218825214*^9, 3.916434231193322*^9}, {
  3.916434433080632*^9, 3.916434435493432*^9}, {3.916491580753085*^9, 
  3.916491581133762*^9}, {3.9164980347530813`*^9, 
  3.916498042139256*^9}},ExpressionUUID->"002e6470-a918-4457-b844-\
c96a1147adea"],

Cell[TextData[{
 "where can evaluate the inner integral by Gauss Hermite quadrature, although \
we will first diagonalize ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalSigma]", "\[Delta]"], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "fc103268-01af-4f7a-bd61-7a8b29cf2505"],
 " and use the transformation to write ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "k"], " ", "=", " ", 
    RowBox[{
     SubscriptBox["L", "k"], "(", 
     RowBox[{"q", "\[Minus]", "\[Mu]"}], ")"}]}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "755527ec-3901-4385-8eb5-e9462a811226"]
}], "ExpositoryText",
 CellChangeTimes->{{3.916433835499408*^9, 3.916433918262629*^9}, {
  3.916434009133081*^9, 3.916434033059441*^9}, {3.91643425605375*^9, 
  3.916434261093668*^9}, {3.91643429824741*^9, 3.916434331934421*^9}, {
  3.916497689525599*^9, 3.916497696083579*^9}, {3.91649803113202*^9, 
  3.916498031463278*^9}},ExpressionUUID->"201e26d0-a563-40f4-acb7-\
a5378f142da7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"V", "(", 
      RowBox[{"\[Delta]", "-", "\[Mu]"}], ")"}], 
     RowBox[{"exp", "(", 
      RowBox[{
       RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", "(", 
        RowBox[{
         SubscriptBox["\[CapitalSigma]", "\[Delta]"], "\[VeryThinSpace]", 
         "p"}], ")"}], "\[CenterDot]", "\[Delta]"}], ")"}], 
     RowBox[{"exp", "(", 
      RowBox[{"-", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          SubscriptBox["\[CapitalSigma]", "\[Delta]"], ")"}], 
         RowBox[{"-", "1"}]], "\[CircleDot]", 
        SuperscriptBox["\[Delta]", "2"]}]}], ")"}]}]}], " ", "=", " ", 
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"V", "(", "\[Delta]", ")"}], " ", 
     RowBox[{
      UnderscriptBox["\[Product]", "k"], " ", 
      RowBox[{
       RowBox[{"exp", "(", 
        RowBox[{
         RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", "(", 
          RowBox[{
           SubscriptBox["\[CapitalSigma]", "\[Delta]"], "\[VeryThinSpace]", 
           "p"}], ")"}], "\[CenterDot]", 
         SubscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"L", "\[Transpose]"}], "\[InvisibleSpace]", "y"}], ")"}], 
          "k"]}], ")"}], " ", 
       RowBox[{"exp", "(", 
        RowBox[{
         RowBox[{"-", 
          SubscriptBox["\[Alpha]", "k"]}], 
         SuperscriptBox[
          SubscriptBox["y", "k"], "2"]}], ")"}]}]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916434037690825*^9, 3.9164340383800898`*^9}, {
  3.916434102322691*^9, 3.916434184864221*^9}, {3.9164342731982*^9, 
  3.916434289104602*^9}, {3.9164343352790813`*^9, 3.9164343886872168`*^9}, {
  3.916434421227537*^9, 3.916434450451356*^9}, {3.9164347334693403`*^9, 
  3.916434738373413*^9}},ExpressionUUID->"e9d63d8f-728f-40c2-8c3a-\
647a75695588"],

Cell[TextData[{
 "taking the appropriate direct product of 1D quadrature points and weights \
to get (for vector ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "4012a261-a69a-4744-b849-049c1bcc0bd3"],
 ")"
}], "ExpositoryText",
 CellChangeTimes->{
  3.9164340135024967`*^9},ExpressionUUID->"435922e7-63f6-4247-8069-\
1f1aeeebe96e"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"\[Integral]", 
       RowBox[{
        RowBox[{"V", "(", "\[Delta]", ")"}], 
        RowBox[{"exp", "(", 
         RowBox[{
          RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", "(", 
           RowBox[{
            SubscriptBox["\[CapitalSigma]", "\[Delta]"], "\[VeryThinSpace]", 
            "p"}], ")"}], "\[CenterDot]", "\[Delta]"}], ")"}], 
        RowBox[{"exp", "(", 
         RowBox[{"-", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             SubscriptBox["\[CapitalSigma]", "\[Delta]"], ")"}], 
            RowBox[{"-", "1"}]], "\[CircleDot]", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"\[Delta]", "-", 
              SubscriptBox["\[Mu]", "\[Delta]"]}], ")"}], "2"]}]}], ")"}]}]}],
       " ", "=", " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "x"], " ", 
       RowBox[{
        SubscriptBox["w", "x"], "\[InvisibleSpace]", 
        RowBox[{"V", "(", "x", ")"}], 
        RowBox[{"exp", "(", 
         RowBox[{
          RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", "(", 
           RowBox[{
            SubscriptBox["\[CapitalSigma]", "\[Delta]"], "\[VeryThinSpace]", 
            "p"}], ")"}], "\[CenterDot]", 
          RowBox[{"(", 
           RowBox[{"x", "-", "\[Mu]"}], ")"}]}], ")"}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "x"], " ", 
       RowBox[{
        SubscriptBox["w", "x"], "\[InvisibleSpace]", 
        RowBox[{"V", "(", "x", ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"cos", "(", "\[VeryThinSpace]", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["\[CapitalSigma]", "\[Delta]"], "\[VeryThinSpace]",
               "p"}], ")"}], "\[CenterDot]", "x"}], ")"}], " ", "+", " ", 
          RowBox[{"\[DoubleStruckI]", " ", 
           RowBox[{"sin", "(", "\[VeryThinSpace]", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               SubscriptBox["\[CapitalSigma]", "\[Delta]"], 
               "\[VeryThinSpace]", "p"}], ")"}], "\[CenterDot]", "x"}], 
            ")"}]}]}], ")"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9164321968973503`*^9, 3.9164323208293867`*^9}, {
  3.916433329597685*^9, 3.916433347469716*^9}, {3.9164337992828693`*^9, 
  3.916433819348482*^9}, {3.91643386370684*^9, 3.916433887716092*^9}, {
  3.9164339267968082`*^9, 3.916433992676917*^9}, {3.916441575014015*^9, 
  3.916441576142714*^9}},ExpressionUUID->"039f55f9-80df-4017-8f9d-\
485856f4d42c"],

Cell[TextData[{
 "and upon rephasing, we will take the \[PlusMinus] combinations of the ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", "sin", 
    RowBox[{"(", "\[VeryThinSpace]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[CapitalSigma]", "\[Delta]"], "\[VeryThinSpace]", 
        "p"}], ")"}], "\[CenterDot]", "x"}], ")"}]}], ")"}]],
  CellChangeTimes->{{3.9164321968973503`*^9, 3.9164323208293867`*^9}, {
   3.916433329597685*^9, 3.916433347469716*^9}, {3.9164337992828693`*^9, 
   3.916433819348482*^9}, {3.91643386370684*^9, 3.916433887716092*^9}, {
   3.9164339267968082`*^9, 3.916433992676917*^9}, {3.916441575014015*^9, 
   3.916441576142714*^9}},ExpressionUUID->
  "3a9f5d6e-7bd6-4f22-98f4-02e933d0a808"],
 " terms to recover entirely real eigenvalues, and therefore can omit those \
terms in the calculations"
}], "ExpositoryText",
 CellChangeTimes->{{3.916441538648202*^9, 3.916441611497653*^9}, {
  3.916488479630973*^9, 
  3.916488479996876*^9}},ExpressionUUID->"9bc4ef6e-325d-491d-a035-\
e633523dbdd9"]
}, Open  ]]
}, Closed]],

