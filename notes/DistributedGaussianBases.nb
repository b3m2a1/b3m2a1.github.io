       FontSize->18],
      -CircleTimes[
        $CellContext`Q[
         $CellContext`\[Xi][$CellContext`c]], 
        $CellContext`\[CapitalTau]Q[
         CircleTimes[
          $CellContext`Q[
           $CellContext`\[Xi][$CellContext`c]], 
          $CellContext`\[CapitalSigma][$CellContext`j]], 2 -> 1]]]},
    {
     InterpretationBox[
      StyleBox[
       RowBox[{"-", 
