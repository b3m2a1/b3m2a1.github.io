Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox[
      SuperscriptBox["\[PartialD]", "2"], 
      RowBox[{"\[PartialD]", 
       SubsuperscriptBox["x", "k", "2"]}]], 
     SubsuperscriptBox["P", 
      StyleBox["m",
       FontWeight->"Bold"], 
      RowBox[{"(", "j", ")"}]]}], 
    RowBox[{
     SubscriptBox["\[CurlyPhi]", "j"], "(", 
     StyleBox["x",
      FontWeight->"Bold"], ")"}]}], " ", "=", "\[VeryThinSpace]", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        SuperscriptBox["\[PartialD]", "2"], 
        RowBox[{"\[PartialD]", 
         SubsuperscriptBox["x", "k", "2"]}]], 
       SubsuperscriptBox["P", 
        StyleBox["m",
         FontWeight->"Bold"], 
        RowBox[{"(", "j", ")"}]]}], ")"}], 
     RowBox[{
      SuperscriptBox["\[Phi]", 
       RowBox[{"(", "j", ")"}]], "(", 
      StyleBox["x",
       FontWeight->"Bold"], ")"}]}], " ", "+", " ", 
    RowBox[{"2", 
     RowBox[{
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", 
