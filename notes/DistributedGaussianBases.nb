      RowBox[{"1", "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "k"]}], ")"}], " ", 
     SqrtBox["a"], " ", 
     RowBox[{"Gamma", "[", 
      FractionBox[
       RowBox[{"1", "+", "k"}], "2"], "]"}], " ", 
     RowBox[{"Hypergeometric1F1", "[", 
      RowBox[{
       FractionBox[
        RowBox[{"1", "+", "k"}], "2"], ",", 
       FractionBox["1", "2"], ",", 
       RowBox[{"-", 
        FractionBox[
         SuperscriptBox["p", "2"], 
