Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["x", "2"]], 
    SuperscriptBox["w", 
     RowBox[{"(", "i", ")"}]]}], " ", "=", " ", 
   RowBox[{
    SubscriptBox["\[Del]", "x"], 
    RowBox[{"(", 
     RowBox[{
      UnderscriptBox["\[Sum]", "j"], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", "-", 
         SuperscriptBox["\[Xi]", 
          RowBox[{"(", "j", ")"}]]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[Delta]", 
          RowBox[{"j", "\[InvisibleSpace]", "i"}]], "-", 
         SuperscriptBox["w", 
          RowBox[{"(", "i", ")"}]]}], ")"}], "p", "\[InvisibleSpace] ", 
       FractionBox[
        RowBox[{"d", "(", 
         RowBox[{"x", ",", " ", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", "j", ")"}]], ",", " ", 
          RowBox[{
           RowBox[{"p", "/", "2"}], "+", "1"}]}], ")"}], 
        RowBox[{
         UnderscriptBox["\[Sum]", "k"], " ", 
         RowBox[{"d", "(", 
          RowBox[{"x", ",", " ", 
           SuperscriptBox["\[Xi]", 
            RowBox[{"(", "k", ")"}]], ",", " ", 
           RowBox[{"p", "/", "2"}]}], ")"}]}]]}]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.91580833718707*^9, 3.915808355407236*^9}, {
