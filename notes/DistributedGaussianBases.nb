  FormatType->TraditionalForm,ExpressionUUID->
  "b41700d6-16ae-4f30-9cc9-cd9e69ae8a19"],
 " we can obviously orthogonalize this system by writing"
}], "ExpositoryText",
 CellChangeTimes->{{3.9132252115124483`*^9, 
  3.913225269957884*^9}},ExpressionUUID->"3dca2eed-f9cd-4abc-a932-\
6411d7598de0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[CurlyPhi]", "2"], " ", "=", " ", 
   RowBox[{
    SubscriptBox["\[Phi]", "2"], " ", "-", " ", 
    RowBox[{
     TemplateBox[{
       RowBox[{
