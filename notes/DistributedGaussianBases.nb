5a39e59f9150"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["G", "b", "k"], "(", 
    RowBox[{"\[Alpha]", ",", " ", "p"}], ")"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"\[CapitalGamma]", "(", 
     RowBox[{"b", "+", 
      RowBox[{"\[LeftFloor]", 
       RowBox[{"k", "/", "2"}], "\[RightFloor]"}]}], ")"}], 
    RowBox[{
     SubscriptBox["F", "1"], "(", 
     RowBox[{
      RowBox[{"b", "+", 
       RowBox[{"\[LeftFloor]", 
        RowBox[{"k", "/", "2"}], "\[RightFloor]"}]}], ";", " ", 
      RowBox[{"b", "+", 
       RowBox[{"\[LeftFloor]", 
        RowBox[{"k", "/", "2"}], "\[RightFloor]"}]}], ";", " ", 
      RowBox[{"-", 
       FractionBox[
        SuperscriptBox["p", "2"], 
        RowBox[{"4", "\[InvisibleSpace]", "\[Alpha]"}]]}]}], ")"}], " "}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916068938290694*^9, 3.916069036942236*^9}, {
