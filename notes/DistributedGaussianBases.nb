Cell[CellGroupData[{

Cell["Nearest Modes", "Section",
 CellChangeTimes->{{3.91704558902075*^9, 
  3.9170455910684843`*^9}},ExpressionUUID->"1ec2f880-5e23-464c-92a8-\
1deaa98784e5"],

Cell[TextData[{
 "Mostly for plotting, we want to find the minimal linear combination of \
normal modes that puts atom ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "7c9368f7-7b1b-4d2d-8e84-02a382a949db"],
 " at position ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "1d5285f4-dd8b-40ee-a2b5-e73053263146"],
 ", mathematically, we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.9170455967717953`*^9, 3.9170456161355677`*^9}, {
  3.917045648003426*^9, 
  3.917045719131329*^9}},ExpressionUUID->"f5214f9a-28d5-44cc-ba6a-\
510f8a827823"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"L", "\[InvisibleSpace]", "q"}], " ", "+", " ", 
      SubscriptBox["x", 
       RowBox[{"\[VeryThinSpace]", "0"}]]}], ")"}], "i"], " ", "=", " ", 
   "p"}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9170457036805143`*^9, 3.9170457596198177`*^9}, {
  3.917055444636958*^9, 
  3.917055445837399*^9}},ExpressionUUID->"e0374503-59e1-4fe7-a8a8-\
2a78339dd2df"],

Cell[TextData[{
 "we just need to use least squares to get ",
 Cell[BoxData[
  FormBox["q", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "9e54bd36-f86f-4016-8a5f-07222f456274"]
}], "ExpositoryText",
 CellChangeTimes->{{3.9170457663492203`*^9, 
  3.917045780725152*^9}},ExpressionUUID->"7ec24b8c-4672-4bde-a81e-\
366808cddada"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Quadratic Forms", "Section",
 CellChangeTimes->{{3.9168976524700537`*^9, 3.916897654968931*^9}, {
  3.917045657248971*^9, 
  3.9170456689626837`*^9}},ExpressionUUID->"b1eb9499-fe71-4638-988e-\
d95dbc08d130"],

Cell[CellGroupData[{

Cell["Completing the Square", "Subsubsubsection",
 CellChangeTimes->{{3.917014661608838*^9, 
  3.9170146649742317`*^9}},ExpressionUUID->"4dd73cff-6931-4983-97d8-\
30930458b8d0"],

Cell["The key trick to all of this is just the recognition that ", \
"ExpositoryText",
 CellChangeTimes->{{3.917014666604197*^9, 
  3.917014674547764*^9}},ExpressionUUID->"6f779083-5d3f-4b85-a79f-\
0678ecba741b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"x", "\[Transpose]"}], "\[InvisibleSpace]", "A", "\[VeryThinSpace]\[InvisibleSpace]", 
     RowBox[{"x", "\[Transpose]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"b", "\[Transpose]"}], "\[InvisibleSpace]", "x"}]}], " ", "=", 
   " ", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "-", 
        RowBox[{
         SuperscriptBox["A", 
          RowBox[{"-", "1"}]], "\[InvisibleSpace]", "b"}]}], ")"}], 
      "\[Transpose]"}], "\[InvisibleSpace]", 
     RowBox[{"A", "\[InvisibleSpace]", "(", 
      RowBox[{"x", "-", 
       RowBox[{
        SuperscriptBox["A", 
         RowBox[{"-", "1"}]], "\[InvisibleSpace]", "b"}]}], ")"}]}], " ", "-",
     " ", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"b", "\[Transpose]"}], "\[InvisibleSpace]", 
     SuperscriptBox["A", 
      RowBox[{"-", "1"}]], "\[InvisibleSpace]", "b"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9170146785637903`*^9, 
  3.917014812850273*^9}},ExpressionUUID->"b44da920-9f0c-4462-b1bc-\
9b36b95b477d"],

Cell["\<\
which is the multivariate generalization of the completing the square trick \
we all learned for dealing with univariate quadratic equations\
\>", "ExpositoryText",
 CellChangeTimes->{{3.917014814786729*^9, 
  3.917014850044259*^9}},ExpressionUUID->"fdf9b318-0b8a-4a4c-a0c2-\
67ac28e0a39c"],

Cell["\<\
From this we can also simply read off the minimum position and value\
\>", "ExpositoryText",
 CellChangeTimes->{{3.917014977215371*^9, 
  3.917014995090014*^9}},ExpressionUUID->"c2a0be78-d931-41c9-a054-\
5f34bee3a6f8"],

Cell[TextData[{
 "Note that ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "7f385338-a9fc-439d-b916-2519e78788df"],
 " could be given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", " ", "=", " ", 
    RowBox[{"y", " ", "\[Minus]", " ", "\[Xi]"}]}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "252427bd-fd41-4e11-a7e4-9f3f8b4ca47f"],
 ", in which case the minimum position in ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "81608b4c-7092-4c51-b802-f674165b1415"],
 " space would be ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "0"], " ", "=", " ", 
    RowBox[{
     RowBox[{
      SuperscriptBox["A", 
       RowBox[{"-", "1"}]], "\[InvisibleSpace]", "b"}], " ", "+", " ", 
     "\[Xi]"}]}], TraditionalForm]],
  CellChangeTimes->{{3.9170146785637903`*^9, 3.917014812850273*^9}},
  ExpressionUUID->"e4a89573-4201-484d-a512-7d9b12010603"],
 " but the minimum value wouldn\[CloseCurlyQuote]t change"
}], "ExpositoryText",
 CellChangeTimes->{{3.917015004855707*^9, 
  3.917015099767173*^9}},ExpressionUUID->"c21e82f8-1270-4394-a1b1-\
dee45aa306ad"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Partial Minimization", "Subsubsubsection",
 CellChangeTimes->{{3.9171103425038548`*^9, 
  3.917110346892308*^9}},ExpressionUUID->"0e526868-8948-422a-b074-\
f748575b816a"],

Cell["Given the quadratic form", "ExpositoryText",
 CellChangeTimes->{{3.9171103494212227`*^9, 
  3.917110358623941*^9}},ExpressionUUID->"1639cb21-f6a9-4f61-ab9d-\
2ca5f5ea4a17"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"x", "\[Transpose]"}], "\[InvisibleSpace]", "A", "\[VeryThinSpace]\[InvisibleSpace]", 
     RowBox[{"x", "\[Transpose]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"b", "\[Transpose]"}], "\[InvisibleSpace]", "x"}]}], " ", "=", 
   " ", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "-", 
        RowBox[{
         SuperscriptBox["A", 
          RowBox[{"-", "1"}]], "\[InvisibleSpace]", "b"}]}], ")"}], 
      "\[Transpose]"}], "\[InvisibleSpace]", 
     RowBox[{"A", "\[InvisibleSpace]", "(", 
      RowBox[{"x", "-", 
       RowBox[{
        SuperscriptBox["A", 
         RowBox[{"-", "1"}]], "\[InvisibleSpace]", "b"}]}], ")"}]}], " ", "-",
     " ", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"b", "\[Transpose]"}], "\[InvisibleSpace]", 
     SuperscriptBox["A", 
      RowBox[{"-", "1"}]], "\[InvisibleSpace]", "b"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9170146785637903`*^9, 
  3.917014812850273*^9}},ExpressionUUID->"c480a7ad-1e17-4fbd-bc8e-\
2d8f9558bb3a"],

Cell[TextData[{
 "if we are interested in minimizing with respect to some subset of \
coordinates ",
 Cell[BoxData[
  FormBox["S", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "06da29ad-594c-419a-9be4-a58eeb0f4e6e"],
 ", we just need to account for the energy shift from the minimum in those \
coordinates and then can take the remainder submatrix in ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "4418a1db-e107-47b7-81a4-8248dbfa849e"],
 " and ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "25e5fc56-6b07-4546-b886-149c3df95409"]
}], "ExpositoryText",
 CellChangeTimes->{{3.917110370781928*^9, 3.917110428297845*^9}, {
  3.91711065206609*^9, 
  3.917110775970772*^9}},ExpressionUUID->"61ebd1f2-bca6-48f8-aa9b-\
0cd34fd7d20e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Sum of Forms", "Subsubsubsection",
 CellChangeTimes->{{3.917014658194125*^9, 3.917014660008094*^9}, {
  3.917110382440913*^9, 
  3.9171103834330378`*^9}},ExpressionUUID->"843c3f7a-7484-469a-87c3-\
33ea7d920eb7"],

Cell["\<\
Most of the properties of Gaussian integrals are really properties of the \
sums of quadratic forms, e.g. the product of two Gaussians turns into a \
question over sums of forms\
\>", "ExpositoryText",
 CellChangeTimes->{{3.916897656488935*^9, 
  3.916897717261125*^9}},ExpressionUUID->"f610c812-4532-4eb9-a5fd-\
3bdbc3ad4a28"],

Cell[BoxData[{
 FormBox[
  RowBox[{
   RowBox[{"exp", "(", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"q", "-", 
        SuperscriptBox["\[Xi]", 
         RowBox[{"(", "i", ")"}]]}], ")"}], "T"], 
     RowBox[{
      SuperscriptBox["\[CapitalSigma]", 
       RowBox[{
        RowBox[{"(", "i", ")"}], "-", "1"}]], "(", 
      RowBox[{"q", "-", 
       SuperscriptBox["\[Xi]", 
        RowBox[{"(", "i", ")"}]]}], ")"}]}], ")"}], 
   RowBox[{"exp", "(", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"q", "-", 
        SuperscriptBox["\[Xi]", 
         RowBox[{"(", "j", ")"}]]}], ")"}], "T"], 
     RowBox[{
      SuperscriptBox["\[CapitalSigma]", 
       RowBox[{
        RowBox[{"(", "j", ")"}], "-", "1"}]], "(", 
      RowBox[{"q", "-", 
       SuperscriptBox["\[Xi]", 
        RowBox[{"(", "j", ")"}]]}], ")"}]}], ")"}]}], 
  TraditionalForm], "\[IndentingNewLine]", 
 FormBox[
  RowBox[{
   RowBox[{"\[Implies]", " ", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"q", "-", 
         SuperscriptBox["\[Xi]", 
          RowBox[{"(", "i", ")"}]]}], ")"}], "T"], 
      RowBox[{
       SuperscriptBox["\[CapitalSigma]", 
        RowBox[{
         RowBox[{"(", "i", ")"}], "-", "1"}]], "(", 
       RowBox[{"q", "-", 
        SuperscriptBox["\[Xi]", 
         RowBox[{"(", "i", ")"}]]}], ")"}]}], "  ", "+", " ", 
     RowBox[{
      SuperscriptBox[
