            RowBox[{"(", "i", ")"}]], 
           RowBox[{"-", "1"}]], "(", 
          RowBox[{"q", "-", 
           SuperscriptBox["\[Xi]", 
            RowBox[{"(", "i", ")"}]]}], ")"}]}], " ", "-", " ", 
        RowBox[{"\[DoubleStruckI]", "\[InvisibleSpace]\[VeryThinSpace]", 
         SuperscriptBox["J", 
          RowBox[{"(", "i", ")"}]], "\[VeryThinSpace]", "q"}]}], " ", 
       ")"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916349103943473*^9, 
  3.916349141590981*^9}},ExpressionUUID->"bcd9db08-8bbf-49fe-831f-\
2fc9cef7329c"],

Cell["and then we\[CloseCurlyQuote]ll let", "ExpositoryText",
 CellChangeTimes->{{3.916349164599421*^9, 
  3.91634916693202*^9}},ExpressionUUID->"fc6c7e15-f3ff-4e66-8f66-\
a6080c9cb3e9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["\[CurlyPhi]", 
    RowBox[{"(", "i", ")"}]], " ", "=", " ", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[CurlyPhi]", 
       RowBox[{
        RowBox[{"(", "i", ")"}], "+"}]], " ", "+", " ", 
      SuperscriptBox["\[CurlyPhi]", 
       RowBox[{
        RowBox[{"(", "i", ")"}], "-"}]]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916349168205234*^9, 
  3.916349181516624*^9}},ExpressionUUID->"42ba4822-3433-41cc-b5a1-\
82325ae34684"],

Cell["\<\
Then when we evaluate integrals involving a linear operator \[ScriptCapitalL] \
(involving derivatives, polynomials, multiplicative factors, etc.) we will \
have\
\>", "ExpositoryText",
 CellChangeTimes->{{3.916349144199493*^9, 3.916349154792234*^9}, {
  3.916349185169669*^9, 3.916349196077634*^9}, {3.916349235195609*^9, 
  3.916349303557691*^9}},ExpressionUUID->"322753da-6c85-4be4-9fc4-\
fde9143d13e1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Integral]", 
    RowBox[{
     SuperscriptBox["\[CurlyPhi]", 
      RowBox[{"(", "i", ")"}]], 
     SuperscriptBox["\[ScriptCapitalL]\[CurlyPhi]", 
      RowBox[{
       RowBox[{"(", "j", ")"}], "*"}]], 
     RowBox[{"\[DifferentialD]", "q"}]}]}], " ", "=", " ", 
   RowBox[{
    FractionBox["1", "4"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Integral]", 
       RowBox[{
        SuperscriptBox["\[CurlyPhi]", 
         RowBox[{
          RowBox[{"(", "i", ")"}], "+"}]], 
        SuperscriptBox["\[ScriptCapitalL]\[CurlyPhi]", 
         RowBox[{
          RowBox[{"(", "j", ")"}], "+", "*"}]]}]}], " ", "+", " ", 
      RowBox[{"\[Integral]", 
       RowBox[{
        SuperscriptBox["\[CurlyPhi]", 
         RowBox[{
          RowBox[{"(", "i", ")"}], "+"}]], 
        SuperscriptBox["\[ScriptCapitalL]\[CurlyPhi]", 
         RowBox[{
          RowBox[{"(", "j", ")"}], "-", "*"}]]}]}], " ", "+", " ", 
      RowBox[{"\[Integral]", 
       RowBox[{
        SuperscriptBox["\[CurlyPhi]", 
         RowBox[{
          RowBox[{"(", "i", ")"}], "-"}]], 
        SuperscriptBox["\[ScriptCapitalL]\[CurlyPhi]", 
         RowBox[{
          RowBox[{"(", "j", ")"}], "+", "*"}]]}]}], " ", "+", " ", 
      RowBox[{"\[Integral]", 
       RowBox[{
        SuperscriptBox["\[CurlyPhi]", 
         RowBox[{
          RowBox[{"(", "i", ")"}], "-"}]], 
        SuperscriptBox["\[ScriptCapitalL]\[CurlyPhi]", 
         RowBox[{
          RowBox[{"(", "j", ")"}], "-", "*"}]]}]}]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916349255680532*^9, 3.916349264066906*^9}, {
  3.9163493151802177`*^9, 
  3.9163493749405317`*^9}},ExpressionUUID->"1695e8da-f807-418c-a777-\
1200ce169318"],

Cell[TextData[{
 "and considering a generic polynomial of order ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "a1f5f7ac-211a-41e2-8270-f04f652db65a"],
 " to start, the standard form of these integrals will be"
}], "ExpositoryText",
 CellChangeTimes->{{3.916364506015126*^9, 3.916364522870229*^9}, {
  3.916364919896925*^9, 3.916364940818932*^9}, {3.9163649935814734`*^9, 
  3.916364996802685*^9}},ExpressionUUID->"811cede2-8a0f-4cc4-b756-\
2c5ae8e0b66c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Integral]", 
    RowBox[{
     SuperscriptBox["\[CurlyPhi]", 
      RowBox[{
       RowBox[{"(", "i", ")"}], "\[PlusMinus]"}]], 
     SuperscriptBox["\[ScriptCapitalL]\[CurlyPhi]", 
      RowBox[{
       RowBox[{"(", "j", ")"}], "\[PlusMinus]", "*"}]]}]}], " ", "=", " ", 
   RowBox[{
    SubsuperscriptBox["X", "0", 
     RowBox[{"(", 
      RowBox[{"i", ",", "j"}], ")"}]], "(", 
    RowBox[{
     SuperscriptBox["\[DoubleStruckI]", "n"], " ", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{"x", "\[Element]", 
        RowBox[{"\[ScriptCapitalP]", "(", "n", ")"}]}]], 
      RowBox[{
       SubscriptBox["c", "x"], " ", 
       RowBox[{
        UnderscriptBox["\[Product]", "k"], " ", 
        SubsuperscriptBox["\[Rho]", "k", 
         SubscriptBox["x", "k"]]}]}]}]}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916349721785927*^9, 3.9163497278653507`*^9}, {
   3.916362645504055*^9, 3.916362647129719*^9}, {3.916364092713649*^9, 
   3.916364110369779*^9}, {3.916364159460722*^9, 3.916364176636785*^9}, {
   3.9163643419135113`*^9, 3.9163643577209578`*^9}, 3.916364472887396*^9, {
   3.916364947005649*^9, 3.916365100483562*^9}, {3.916365148762253*^9, 
   3.9163651651322613`*^9}, 
   3.916365864076516*^9},ExpressionUUID->"546ffead-800e-406b-a486-\
05c26c239117"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalP]", "(", "n", ")"}], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "7e6538bd-2d40-44e1-8215-a5f2b7fe2223"],
 " is the set of permutations of integer partitions of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "2f2ae462-a734-4dec-b4e8-8fe779f21746"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"o", "(", "x", ")"}], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"fc710078-3122-4897-9770-8cbf185ce889"],
 " is the order of the permutation and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "x"], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"1625b1d6-faef-4f0c-bd7e-6164c3c06f0c"],
 " is the appropriate coefficient from the polynomial \[ScriptCapitalL], and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[VeryThinSpace]", 
    RowBox[{"\[Rho]", " ", "=", " ", 
     RowBox[{
      SuperscriptBox["\[CapitalSigma]", 
       RowBox[{"(", 
        RowBox[{"i", ",", "j"}], ")"}]], "\[InvisibleSpace]", 
      SuperscriptBox["J", 
       RowBox[{"(", 
        RowBox[{"i", ",", "j"}], ")"}]]}]}]}], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "ff1fed2b-8672-4bfd-af2e-144fdf4bc79c"]
}], "ExpositoryText",
 CellChangeTimes->{{3.91636510270394*^9, 3.916365135476275*^9}, {
  3.916365168005742*^9, 3.9163652520115128`*^9}, {3.916365478120805*^9, 
  3.9163654848094187`*^9}},ExpressionUUID->"f91318e7-74a2-4fe8-b0c3-\
a6c1de393935"],

Cell["Then recalling that ", "ExpositoryText",
 CellChangeTimes->{{3.91636533547148*^9, 
  3.91636536494914*^9}},ExpressionUUID->"b0ddb18c-c1bd-4f80-80f9-\
1180af37d4e8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["X", "0", 
    RowBox[{"(", 
     RowBox[{"i", ",", "j"}], ")"}]], " ", "=", " ", 
   RowBox[{
    SqrtBox[
     RowBox[{
      SuperscriptBox["\[Pi]", "d"], 
      RowBox[{"\[LeftBracketingBar]", 
       SuperscriptBox["\[CapitalSigma]", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]], "\[RightBracketingBar]"}]}]], 
    "\[InvisibleSpace]", 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], 
      SuperscriptBox["J", 
       RowBox[{"(", 
        RowBox[{"i", ",", "j"}], ")"}]], 
      SuperscriptBox["\[CapitalSigma]", 
       RowBox[{"(", 
        RowBox[{"i", ",", "j"}], ")"}]], 
      RowBox[{
       SuperscriptBox["J", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]], "\[Transpose]"}]}], ")"}], 
    RowBox[{"exp", "(", 
     RowBox[{
      SuperscriptBox["\[DoubleStruckI]\[Xi]", 
       RowBox[{"(", 
        RowBox[{"i", ",", "j"}], ")"}]], "\[CenterDot]", 
      SuperscriptBox["J", 
       RowBox[{"(", 
        RowBox[{"i", ",", "j"}], ")"}]]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.91636537510819*^9, 3.9163653758786*^9}, 
   3.916782290603508*^9},ExpressionUUID->"3e79acb9-8b94-4e25-ac16-\
95281825920e"],

Cell["We will now consider first just the pair", "ExpositoryText",
 CellChangeTimes->{{3.916365379711091*^9, 3.9163653967362337`*^9}, {
  3.916365439774723*^9, 
  3.916365440180091*^9}},ExpressionUUID->"9d117b83-66e9-485a-a7f8-\
56cf799fdd6d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Integral]", 
    RowBox[{
     SuperscriptBox["\[CurlyPhi]", 
      RowBox[{
       RowBox[{"(", "i", ")"}], "+"}]], 
     SuperscriptBox["\[ScriptCapitalL]\[CurlyPhi]", 
      RowBox[{
       RowBox[{"(", "j", ")"}], "+", "*"}]]}]}], " ", "+", " ", 
   RowBox[{"\[Integral]", 
    RowBox[{
     SuperscriptBox["\[CurlyPhi]", 
      RowBox[{
       RowBox[{"(", "i", ")"}], "-"}]], 
     SuperscriptBox["\[ScriptCapitalL]\[CurlyPhi]", 
      RowBox[{
       RowBox[{"(", "j", ")"}], "-", "*"}]]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916365401186015*^9, 3.9163654074790773`*^9}, {
  3.916365547230142*^9, 
  3.916365551600349*^9}},ExpressionUUID->"e83e7c89-0380-4325-9786-\
033a876a5110"],

Cell[TextData[{
 "and note that this is equivalent to considering replacing ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["J", 
    RowBox[{"(", 
     RowBox[{"i", ",", "j"}], ")"}]], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "6122389a-ce3c-43ad-9d8a-f0daab539bfd"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Minus]", 
    SuperscriptBox["J", 
     RowBox[{"(", 
      RowBox[{"i", ",", "j"}], ")"}]]}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "0a0dd26b-8b60-4588-8bdd-9edb638b6d11"],
 " "
}], "ExpositoryText",
 CellChangeTimes->{{3.916365451797426*^9, 
  3.9163654990175257`*^9}},ExpressionUUID->"76573df1-eb3a-4f50-b01e-\
79908846c408"],

Cell[TextData[{
 "Doing that, letting ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", " ", "=", " ", 
    RowBox[{
     SuperscriptBox["\[Xi]", 
      RowBox[{"(", 
       RowBox[{"i", ",", "j"}], ")"}]], "\[CenterDot]", 
     SuperscriptBox["J", 
      RowBox[{"(", 
       RowBox[{"i", ",", "j"}], ")"}]]}]}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "28ae43ec-8890-4695-8096-10de2e0ce534"],
 ", we\[CloseCurlyQuote]ll consider that"
}], "ExpositoryText",
 CellChangeTimes->{{3.9163655092629137`*^9, 3.916365511439104*^9}, {
  3.916365579332836*^9, 3.916365602108862*^9}, {3.916365659221855*^9, 
  3.916365662211972*^9}},ExpressionUUID->"89cb837a-0e07-4179-804c-\
2afa2293c326"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"exp", "(", 
       RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", "v"}], ")"}], " ", "=",
       " ", 
      RowBox[{
       RowBox[{"cos", "(", "v", ")"}], " ", "+", " \[InvisibleSpace]", 
       RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", 
        RowBox[{"sin", "(", "v", ")"}]}]}]}]},
    {
     RowBox[{
      RowBox[{"exp", "(", 
       RowBox[{
        RowBox[{"-", "\[DoubleStruckI]"}], "\[VeryThinSpace]", "v"}], ")"}], 
      " ", "=", " ", 
      RowBox[{
       RowBox[{"cos", "(", "v", ")"}], " ", "-", " \[InvisibleSpace]", 
       RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", 
        RowBox[{"sin", "(", "v", ")"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916365665526514*^9, 3.9163657081657047`*^9}, {
  3.9167822938065968`*^9, 
  3.9167822987299623`*^9}},ExpressionUUID->"5daeaafc-be12-4fa3-b587-\
e928b7e70525"],

Cell["\<\
so splitting this into cases, first the cos terms come out to\
\>", "ExpositoryText",
 CellChangeTimes->{{3.916365724586873*^9, 
  3.916365741595792*^9}},ExpressionUUID->"194a20b2-fba3-4cac-b2bd-\
96a25cf99693"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      FractionBox[
       SuperscriptBox[
        RowBox[{"[", 
         RowBox[{
          RowBox[{"\[Integral]", 
           RowBox[{
            SuperscriptBox["\[CurlyPhi]", 
             RowBox[{
              RowBox[{"(", "i", ")"}], "+"}]], 
            SuperscriptBox["\[ScriptCapitalL]\[CurlyPhi]", 
             RowBox[{
              RowBox[{"(", "j", ")"}], "+", "*"}]]}]}], "+", 
          RowBox[{
           SuperscriptBox["\[CurlyPhi]", 
            RowBox[{
             RowBox[{"(", "i", ")"}], "-"}]], 
           SuperscriptBox["\[ScriptCapitalL]\[CurlyPhi]", 
            RowBox[{
             RowBox[{"(", "j", ")"}], "-", "*"}]]}]}], "]"}], 
        RowBox[{"(", "cos", ")"}]], 
       RowBox[{"cos", "(", "v", ")"}]], " ", "=", " ", 
      RowBox[{
       SuperscriptBox["\[DoubleStruckI]", "n"], " ", 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"x", "\[Element]", 
          RowBox[{"\[ScriptCapitalP]", "(", "n", ")"}]}]], 
        RowBox[{
         SubscriptBox["c", "x"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            UnderscriptBox["\[Product]", "k"], " ", 
            SubsuperscriptBox["\[Rho]", "k", 
             SubscriptBox["x", "k"]]}], "+", 
           RowBox[{
            UnderscriptBox["\[Product]", "k"], " ", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"-", "1"}], ")"}], 
              SubscriptBox["x", "k"]], " ", 
             SubsuperscriptBox["\[Rho]", "k", 
              SubscriptBox["x", "k"]]}]}]}], ")"}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SuperscriptBox["\[DoubleStruckI]", "n"], " ", 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"x", "\[Element]", 
          RowBox[{"\[ScriptCapitalP]", "(", "n", ")"}]}]], 
        RowBox[{
         SubscriptBox["c", "x"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            UnderscriptBox["\[Product]", "k"], " ", 
            SubsuperscriptBox["\[Rho]", "k", 
             SubscriptBox["x", "k"]]}], "+", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "n"], 
            RowBox[{
             UnderscriptBox["\[Product]", "k"], "  ", 
             SubsuperscriptBox["\[Rho]", "k", 
              SubscriptBox["x", "k"]]}]}]}], ")"}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], "n"]}], ")"}], 
       SuperscriptBox["\[DoubleStruckI]", "n"], " ", 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"x", "\[Element]", 
          RowBox[{"\[ScriptCapitalP]", "(", "n", ")"}]}]], 
        RowBox[{
         SubscriptBox["c", "x"], "(", 
         RowBox[{
          UnderscriptBox["\[Product]", "k"], "  ", 
          SubsuperscriptBox["\[Rho]", "k", 
           SubscriptBox["x", "k"]]}], ")"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916365742994677*^9, 3.9163658187249823`*^9}, 
   3.9163658590954027`*^9, {3.916365889897085*^9, 3.91636589309929*^9}, {
   3.916366114849328*^9, 3.9163661189287357`*^9}, {3.916366176144539*^9, 
   3.916366200174685*^9}, {3.916366237122367*^9, 
   3.9163662789349127`*^9}},ExpressionUUID->"b377a2b9-93f0-406d-821c-\
f077a9a9c38e"],

Cell[TextData[{
 "by the fact that, being an integer partition permutation, the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "k"], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"065ed9cd-f30d-4714-9a40-8628d4a9a02a"],
 " add up to ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "67136332-fa70-43a6-8d1d-af71c867b523"],
 ", and so this vanishes for odd ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "55d6eae2-bc88-43bc-a359-3f169a9b1c98"],
 ". By a directly analogous argument, the sin terms vanish for even ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "96fc056c-deda-40e2-8ea1-aa0ee9d8efdf"],
 ", and the imaginary prefactor gets multiplied by the extra \[DoubleStruckI] \
from the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", 
    RowBox[{"sin", "(", "v", ")"}]}], TraditionalForm]],
  CellChangeTimes->{{3.916779507588238*^9, 3.916779522917715*^9}},
  ExpressionUUID->"db9529d9-265f-4e12-a8a1-4173654f7f43"],
 " term"
}], "ExpositoryText",
 CellChangeTimes->{{3.916366124933195*^9, 3.916366233645863*^9}, {
  3.916366284038363*^9, 3.9163662949206657`*^9}, {3.91636633233895*^9, 
  3.916366402484296*^9}, {3.916779494260022*^9, 
  3.916779531936664*^9}},ExpressionUUID->"e105fdaf-a08b-4558-9860-\
240993ec40db"],

Cell[TextData[{
 "This was applied for the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CurlyPhi]", 
     RowBox[{
      RowBox[{"(", "i", ")"}], "+"}]], 
    SuperscriptBox["\[CurlyPhi]", 
     RowBox[{
      RowBox[{"(", "j", ")"}], "+", "*"}]]}], TraditionalForm]],
  CellChangeTimes->{{3.916365742994677*^9, 3.9163658187249823`*^9}, 
    3.9163658590954027`*^9, {3.916365889897085*^9, 3.91636589309929*^9}, {
    3.916366114849328*^9, 3.9163661189287357`*^9}, {3.916366176144539*^9, 
    3.916366200174685*^9}, {3.916366237122367*^9, 3.9163662789349127`*^9}},
  ExpressionUUID->"f9e170d6-0c5d-4ba7-9d33-74bb40ff635d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CurlyPhi]", 
     RowBox[{
      RowBox[{"(", "i", ")"}], "-"}]], 
    SuperscriptBox["\[CurlyPhi]", 
     RowBox[{
      RowBox[{"(", "j", ")"}], "-", "*"}]]}], TraditionalForm]],
  CellChangeTimes->{{3.916365742994677*^9, 3.9163658187249823`*^9}, 
    3.9163658590954027`*^9, {3.916365889897085*^9, 3.91636589309929*^9}, {
    3.916366114849328*^9, 3.9163661189287357`*^9}, {3.916366176144539*^9, 
    3.916366200174685*^9}, {3.916366237122367*^9, 3.9163662789349127`*^9}},
  ExpressionUUID->"b696ffd4-55b9-4a4f-96c9-1e07c6a5045e"],
 ", but it should be clear the same argument applies to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CurlyPhi]", 
     RowBox[{
      RowBox[{"(", "i", ")"}], "+"}]], 
    SuperscriptBox["\[CurlyPhi]", 
     RowBox[{
      RowBox[{"(", "j", ")"}], "-", "*"}]]}], TraditionalForm]],
  CellChangeTimes->{{3.916365742994677*^9, 3.9163658187249823`*^9}, 
    3.9163658590954027`*^9, {3.916365889897085*^9, 3.91636589309929*^9}, {
    3.916366114849328*^9, 3.9163661189287357`*^9}, {3.916366176144539*^9, 
    3.916366200174685*^9}, {3.916366237122367*^9, 3.9163662789349127`*^9}},
  ExpressionUUID->"f4e2d043-86fd-401b-aa8d-53d0d5dd1cb2"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CurlyPhi]", 
     RowBox[{
      RowBox[{"(", "i", ")"}], "-"}]], 
    SuperscriptBox["\[CurlyPhi]", 
     RowBox[{
      RowBox[{"(", "j", ")"}], "+", "*"}]]}], TraditionalForm]],
  CellChangeTimes->{{3.916365742994677*^9, 3.9163658187249823`*^9}, 
    3.9163658590954027`*^9, {3.916365889897085*^9, 3.91636589309929*^9}, {
    3.916366114849328*^9, 3.9163661189287357`*^9}, {3.916366176144539*^9, 
    3.916366200174685*^9}, {3.916366237122367*^9, 3.9163662789349127`*^9}},
  ExpressionUUID->"97167b49-023d-413d-b72d-29e710c1436d"],
 " although the terms will differ in value"
}], "ExpositoryText",
 CellChangeTimes->{{3.916366405490457*^9, 3.91636648087915*^9}, {
  3.916456219155702*^9, 
  3.916456219532751*^9}},ExpressionUUID->"7afd0ed5-abc3-4e6c-a2dd-\
eb9a2d9765b6"],

Cell["Generically, then we can write", "ExpositoryText",
 CellChangeTimes->{{3.916456223509941*^9, 
  3.916456234780463*^9}},ExpressionUUID->"f925d22e-b96a-4c3f-9995-\
95ed20c73928"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"\[Integral]", 
      RowBox[{
       SuperscriptBox["\[CurlyPhi]", 
        RowBox[{
         RowBox[{"(", "i", ")"}], "+"}]], 
       SuperscriptBox["\[ScriptCapitalL]\[CurlyPhi]", 
        RowBox[{
         RowBox[{"(", "j", ")"}], "+", "*"}]]}]}]}], "+", 
    RowBox[{
     SuperscriptBox["\[CurlyPhi]", 
      RowBox[{
       RowBox[{"(", "i", ")"}], "-"}]], 
     SuperscriptBox["\[ScriptCapitalL]\[CurlyPhi]", 
      RowBox[{
       RowBox[{"(", "j", ")"}], "-", "*"}]]}]}], " ", "=", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], "n"], " ", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"x", "\[Element]", 
       RowBox[{"\[ScriptCapitalP]", "(", "n", ")"}]}]], 
     RowBox[{
      RowBox[{
       SubscriptBox["c", "x"], "(", 
       RowBox[{
        UnderscriptBox["\[Product]", "k"], "  ", 
        SubsuperscriptBox["\[Rho]", "k", 
         SubscriptBox["x", "k"]]}], ")"}], 
      TagBox[GridBox[{
         {"\[Piecewise]", GridBox[{
            {
             RowBox[{"sin", "(", "v", ")"}], 
             RowBox[{"n", " ", "odd"}]},
            {
             RowBox[{"cos", "(", "v", ")"}], 
             RowBox[{"n", " ", "even"}]}
           },
           AllowedDimensions->{2, Automatic},
           Editable->True,
           
           GridBoxAlignment->{
            "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
             "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
           
           GridBoxItemSize->{
            "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, 
             "Rows" -> {{1.}}, "RowsIndexed" -> {}},
           GridBoxSpacings->{"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.84]}, 
               Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}, "RowsIndexed" -> {}},
           Selectable->True]}
        },
        GridBoxAlignment->{
         "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
          "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
        GridBoxItemSize->{
         "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}},
           "RowsIndexed" -> {}},
        GridBoxSpacings->{"Columns" -> {
            Offset[0.27999999999999997`], {
             Offset[0.35]}, 
            Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, 
          "Rows" -> {
            Offset[0.2], {
             Offset[0.4]}, 
            Offset[0.2]}, "RowsIndexed" -> {}}],
       "Piecewise",
       DeleteWithContents->True,
       Editable->False,
       SelectWithContents->True,
       Selectable->False,
       StripWrapperBoxes->True]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9164562416802588`*^9, 3.916456243081788*^9}, {
  3.916456674008072*^9, 3.9164567537966337`*^9}, {3.916456983223735*^9, 
  3.916456994914216*^9}},ExpressionUUID->"e459c326-e708-432a-8091-\
6b490bcb05dc"],

Cell[TextData[{
 "A similar argument may be applied to the Coriolis and kinetic terms. There \
the relevant expansion is in both ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[VeryThinSpace]", "\[Rho]"}], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "a20989a7-e1c1-4546-86a2-c09b856da77b"],
 " and ",
 Cell[BoxData[
  SuperscriptBox["J", 
   RowBox[{"(", "+", ")"}]]],
  CellChangeTimes->{{3.916284841187529*^9, 3.916284871365149*^9}, {
    3.916284948560882*^9, 3.916284951149582*^9}, 3.916285109536965*^9, {
    3.91631187687687*^9, 3.916311888220605*^9}, {3.916349533637693*^9, 
    3.916349539888589*^9}, {3.916366589200801*^9, 3.91636658942268*^9}, 
    3.916366653130617*^9},ExpressionUUID->
  "b344cee2-872d-4622-ac72-094df200bd55"],
 ", but noting that"
}], "ExpositoryText",
 CellChangeTimes->{{3.916366528233083*^9, 3.91636662789614*^9}, {
  3.9163666589465103`*^9, 
  3.916366665526861*^9}},ExpressionUUID->"9d33ac81-c647-4ca6-966c-\
63497ebd93cb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["J", 
    RowBox[{"(", "+", ")"}]], " ", "=", " ", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["J", 
       RowBox[{"(", "i", ")"}]], "+", 
      SuperscriptBox["J", 
       RowBox[{"(", "j", ")"}]], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["\[CapitalSigma]", 
          SuperscriptBox[
           RowBox[{"(", "j", ")"}], 
           RowBox[{"-", "1"}]]], "-", " ", 
         SuperscriptBox["\[CapitalSigma]", 
          SuperscriptBox[
           RowBox[{"(", "i", ")"}], 
           RowBox[{"-", "1"}]]]}], ")"}], 
       SuperscriptBox["\[CapitalSigma]", 
        RowBox[{"(", "c", ")"}]], 
       SuperscriptBox["J", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]]}]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916284841187529*^9, 3.916284871365149*^9}, {
   3.916284948560882*^9, 3.916284951149582*^9}, 3.916285109536965*^9, {
   3.91631187687687*^9, 3.916311888220605*^9}, {3.916349533637693*^9, 
   3.916349539888589*^9}, {3.916366589200801*^9, 3.91636658942268*^9}, 
   3.916366653130617*^9},ExpressionUUID->"51ce0cce-98d7-4091-a240-\
449e589b70e5"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SuperscriptBox["J", 
    RowBox[{"(", "+", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.916284841187529*^9, 3.916284871365149*^9}, {
    3.916284948560882*^9, 3.916284951149582*^9}, 3.916285109536965*^9, {
    3.91631187687687*^9, 3.916311888220605*^9}, {3.916349533637693*^9, 
    3.916349539888589*^9}, {3.916366589200801*^9, 3.91636658942268*^9}},
  ExpressionUUID->"c0c16cfb-2ef2-47dc-baf4-d5d0f49380ec"],
 " will clearly flip sign when both ",
 Cell[BoxData[
  SuperscriptBox["J", 
   RowBox[{"(", "i", ")"}]]],
  CellChangeTimes->{{3.916284841187529*^9, 3.916284871365149*^9}, {
    3.916284948560882*^9, 3.916284951149582*^9}, 3.916285109536965*^9, {
    3.91631187687687*^9, 3.916311888220605*^9}, {3.916349533637693*^9, 
    3.916349539888589*^9}, {3.916366589200801*^9, 3.91636658942268*^9}, 
    3.916366653130617*^9},ExpressionUUID->
  "94a93908-f524-415a-bd60-fe9113b1f2da"],
 "and ",
 Cell[BoxData[
  SuperscriptBox["J", 
   RowBox[{"(", "j", ")"}]]],
  CellChangeTimes->{{3.916284841187529*^9, 3.916284871365149*^9}, {
    3.916284948560882*^9, 3.916284951149582*^9}, 3.916285109536965*^9, {
    3.91631187687687*^9, 3.916311888220605*^9}, {3.916349533637693*^9, 
    3.916349539888589*^9}, {3.916366589200801*^9, 3.91636658942268*^9}, 
    3.916366653130617*^9},ExpressionUUID->
  "9e4ebeec-5ed4-46e4-85a7-ce3e43bca239"],
 " flip"
}], "ExpositoryText",
 CellChangeTimes->{{3.916366637793992*^9, 
  3.916366683644342*^9}},ExpressionUUID->"b0a97d15-2fbb-4104-b00b-\
19ee37b8f736"],

Cell["\<\
Note that this means we need a slightly different normalization, as now\
\>", "ExpositoryText",
 CellChangeTimes->{{3.916422203770955*^9, 3.916422213136112*^9}, {
   3.916422271798999*^9, 3.916422314935051*^9}, 
   3.916456845729643*^9},ExpressionUUID->"0c2416df-0874-4bb7-88a0-\
06ce9a6a5f5e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Integral]", 
    RowBox[{
     SuperscriptBox["\[CurlyPhi]", 
      RowBox[{"(", "i", ")"}]], 
     SuperscriptBox["\[ScriptCapitalL]\[CurlyPhi]", 
      RowBox[{
       RowBox[{"(", "i", ")"}], "*"}]], 
     RowBox[{"\[DifferentialD]", "q"}]}]}], " ", "=", " ", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{
       RowBox[{"cos", "(", 
        RowBox[{"2", 
         RowBox[{
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", "i", ")"}]], "\[CenterDot]", 
          SuperscriptBox["J", 
           RowBox[{"(", "i", ")"}]]}]}], ")"}], 
       RowBox[{"exp", "(", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["J", 
           RowBox[{"(", "i", ")"}]]}], 
         SuperscriptBox["\[CapitalSigma]", 
          RowBox[{"(", "i", ")"}]], 
         RowBox[{
          SuperscriptBox["J", 
           RowBox[{"(", "i", ")"}]], "\[Transpose]"}]}], ")"}]}]}], ")"}]}]}],
   TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916422308267433*^9, 3.9164224215696497`*^9}, {
   3.9164224574535017`*^9, 3.916422503880603*^9}, {3.916422551654498*^9, 
   3.9164225785035067`*^9}, 3.9164226265908957`*^9, {3.9164226606186457`*^9, 
   3.916422663404867*^9}},ExpressionUUID->"1ca574d2-def6-4202-9109-\
d404ede98d46"],

Cell["\<\
and so we need to divide out the square root of this term in the normalization\
\>", "ExpositoryText",
 CellChangeTimes->{{3.9164226136685753`*^9, 3.9164226445780582`*^9}, {
  3.9164228565846233`*^9, 
  3.916422865459353*^9}},ExpressionUUID->"afadd3f6-4d4c-4c76-a482-\
ba3c99f53986"],

Cell[CellGroupData[{

Cell["Comparison to Product Form", "Subsubsection",
 CellChangeTimes->{{3.91677804330085*^9, 
  3.916778055460514*^9}},ExpressionUUID->"143c66a2-53ae-4f77-ac6b-\
5ac655e25ef0"],

Cell["\<\
There\[CloseCurlyQuote]s an obvious discrepancy between the form of the \
integrals we provide here as\
\>", "ExpositoryText",
 CellChangeTimes->{{3.916778058056006*^9, 
  3.916778077723505*^9}},ExpressionUUID->"51404e5e-b04e-4384-9176-\
dd76322687e9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"\[Integral]", 
      RowBox[{
       SuperscriptBox["\[CurlyPhi]", 
        RowBox[{
         RowBox[{"(", "i", ")"}], "+"}]], 
       SuperscriptBox["\[ScriptCapitalL]\[CurlyPhi]", 
        RowBox[{
         RowBox[{"(", "j", ")"}], "+", "*"}]]}]}]}], "+", 
    RowBox[{
     SuperscriptBox["\[CurlyPhi]", 
      RowBox[{
       RowBox[{"(", "i", ")"}], "-"}]], 
     SuperscriptBox["\[ScriptCapitalL]\[CurlyPhi]", 
      RowBox[{
       RowBox[{"(", "j", ")"}], "-", "*"}]]}]}], " ", "=", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], "n"], " ", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"x", "\[Element]", 
       RowBox[{"\[ScriptCapitalP]", "(", "n", ")"}]}]], 
     RowBox[{
      RowBox[{
       SubscriptBox["c", "x"], "(", 
       RowBox[{
        UnderscriptBox["\[Product]", "k"], "  ", 
        SubsuperscriptBox["\[Rho]", "k", 
         SubscriptBox["x", "k"]]}], ")"}], 
      TagBox[GridBox[{
         {"\[Piecewise]", GridBox[{
            {
             RowBox[{"sin", "(", "v", ")"}], 
             RowBox[{"n", " ", "odd"}]},
            {
             RowBox[{"cos", "(", "v", ")"}], 
             RowBox[{"n", " ", "even"}]}
           },
           AllowedDimensions->{2, Automatic},
           Editable->True,
           
           GridBoxAlignment->{
            "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
             "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
           
           GridBoxItemSize->{
            "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, 
             "Rows" -> {{1.}}, "RowsIndexed" -> {}},
           GridBoxSpacings->{"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.84]}, 
               Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
