Cell["and we\[CloseCurlyQuote]ll shorthand momentum correlation vector as", \
"ExpositoryText",
 CellChangeTimes->{{3.916170274463868*^9, 
  3.9161703008900213`*^9}},ExpressionUUID->"4ffeae16-ce41-4de1-9420-\
fb1e94dadb5a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["\[Rho]", 
    RowBox[{"(", 
     RowBox[{"i", ",", "j"}], ")"}]], " ", "=", " ", 
   RowBox[{
    SuperscriptBox["\[CapitalSigma]", 
     RowBox[{"(", 
