  3.916614056481782*^9}},ExpressionUUID->"5008ddce-21bd-4701-937b-\
862c1eccd7e5"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "12569336-aac1-491b-b105-d8db89a51619"],
 " is the transformation that diagonalizes ",
 Cell[BoxData[
  FormBox["\[CapitalSigma]", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "ded00df1-ae2f-4303-9d16-7cf8a24b8fea"],
 " and ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "62268166-e652-441e-bed4-95b85d85dc55"],
 " are the momenta we want along the actual Gaussian axes"
}], "ExpositoryText",
