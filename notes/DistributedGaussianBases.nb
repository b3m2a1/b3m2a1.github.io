   3.884052097099481*^9}},ExpressionUUID->
  "6558ef0c-faae-40a3-ad09-45bac651ada6"],
 " are diagonal with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1", "/", "2"}], 
    SubsuperscriptBox["\[Alpha]", "k", 
     RowBox[{"(", "i", ")"}]]}], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"cd8f4905-e307-4232-836b-31a00c19e99d"],
 " we get"
}], "ExpositoryText",
