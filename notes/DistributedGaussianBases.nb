Cell[CellGroupData[{

Cell["Most Stable (Direct) Computation", "Subsubsubsection",
 CellChangeTimes->{{3.8865321399092817`*^9, 3.88653215620363*^9}, 
   3.886532528509302*^9},ExpressionUUID->"491837be-2aea-43b8-8665-\
5a2b00ead8a7"],

Cell["For direct evaluation we can expand things out, noting that", \
"ExpositoryText",
 CellChangeTimes->{{3.88653215881846*^9, 3.886532178253831*^9}, 
   3.886532306211279*^9},ExpressionUUID->"428427d2-df64-4f77-9a2e-\
61c61fef0d8c"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{" ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", GridBox[{
           {"n"},
           {
            RowBox[{"2", "\[InvisibleSpace]", "m"}]}
          },
          GridBoxAlignment->{"Columns" -> {Center}}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           UnderoverscriptBox["\[Product]", 
            RowBox[{"i", "=", "1"}], "m"], "\[VeryThinSpace] ", 
           RowBox[{"2", "\[InvisibleSpace]", "i"}]}], "-", "1"}], ")"}]}], 
       " ", "=", "  ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          UnderoverscriptBox["\[Product]", 
           RowBox[{"i", "=", "1"}], 
           RowBox[{"2", "\[InvisibleSpace]", "m"}]], "\[VeryThinSpace]", 
          FractionBox[
           RowBox[{"n", "+", "\[InvisibleSpace]", "1", "-", "i"}], "i"]}], 
         ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           UnderoverscriptBox["\[Product]", 
            RowBox[{"i", "=", "1"}], "m"], "\[VeryThinSpace]", 
           RowBox[{"2", "\[InvisibleSpace]", "i"}]}], "-", "1"}], ")"}]}]}]}]},
    {
     RowBox[{"=", "  ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         UnderoverscriptBox["\[Product]", 
          RowBox[{"i", "=", 
           RowBox[{"m", "+", "1"}]}], 
          RowBox[{"2", "\[InvisibleSpace]", "m"}]], "\[VeryThinSpace]", 
         FractionBox[
          RowBox[{"n", "+", "\[InvisibleSpace]", "1", "-", "i"}], "i"]}], 
        ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         UnderoverscriptBox["\[Product]", 
          RowBox[{"i", "=", "1"}], "m"], "\[VeryThinSpace] ", 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", "+", "\[InvisibleSpace]", "1", "-", "i"}], ")"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "\[InvisibleSpace]", "i"}], "\[InvisibleSpace]", 
             "-", "1"}], ")"}]}], "i"]}], ")"}]}]}]},
    {
     RowBox[{"=", "  ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         UnderoverscriptBox["\[Product]", 
          RowBox[{"i", "=", "1"}], 
          RowBox[{"\[InvisibleSpace]", "m"}]], "\[VeryThinSpace]", 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", "-", "m"}], ")"}], "+", "\[InvisibleSpace]", "1", 
           "-", "i"}], 
          RowBox[{"m", "+", "i"}]]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         UnderoverscriptBox["\[Product]", 
          RowBox[{"i", "=", "1"}], "m"], "\[VeryThinSpace] ", 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", "+", "\[InvisibleSpace]", "1", "-", "i"}], ")"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "\[InvisibleSpace]", "i"}], "\[InvisibleSpace]", 
             "-", "1"}], ")"}]}], "i"]}], ")"}]}]}]},
    {
     RowBox[{"=", "  ", 
      RowBox[{"(", 
       RowBox[{
        UnderoverscriptBox["\[Product]", 
         RowBox[{"i", "=", "1"}], "m"], "\[VeryThinSpace] ", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"n", "-", "m", "+", "\[InvisibleSpace]", "1", "-", "i"}], 
           ")"}], 
          RowBox[{"(", 
           RowBox[{"n", "+", "\[InvisibleSpace]", "1", "-", "i"}], ")"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "\[InvisibleSpace]", "i"}], "\[InvisibleSpace]", "-",
             "1"}], ")"}]}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"m", "+", "i"}], ")"}], "i"}]]}], ")"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.886532179242941*^9, 3.886532262787443*^9}, {
   3.8865324069059277`*^9, 3.886532457277431*^9}, {3.886532552944393*^9, 
   3.886532607249446*^9}, {3.8865328673279133`*^9, 3.8865328946360893`*^9}, {
   3.886539363539318*^9, 3.8865393776446047`*^9}, {3.886539609176511*^9, 
   3.8865396354525843`*^9}, 3.886539861927136*^9, {3.8865409113175983`*^9, 
   3.886540925004438*^9}},ExpressionUUID->"e676e688-53c5-41a3-9c30-\
210743ca8fb9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Connection to Hermite Polynomials", "Subsubsubsection",
 CellChangeTimes->{{3.886527367576707*^9, 
  3.886527371843232*^9}},ExpressionUUID->"48a43a78-eef1-4a6d-a4f7-\
fac14a979230"],

Cell[TextData[{
 "We will note that with this form we have a very direct connection to the \
Hermite polynomials. Denoting the ",
 Cell[BoxData[
  FormBox["l", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "ad232c34-d30b-48eb-9630-f6b73470ef40"],
 "-th coefficient of the ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "dd2d9465-5a43-46e7-9c60-4e8edbbfe358"],
 "-th Hermite polynomial in ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "d6bba20f-449b-4bb7-abac-58052c9b189b"],
 " as ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["H", 
    RowBox[{"\[InvisibleSpace]", "l"}], "n"], TraditionalForm]],
  ExpressionUUID->"ec70342a-a0e3-45c4-875b-44a9271df845"],
 ", we get"
}], "ExpositoryText",
 CellChangeTimes->{{3.8865273736358843`*^9, 
  3.886527470636383*^9}},ExpressionUUID->"64bd1295-0d15-4da7-b01f-\
ca624b65ae92"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["H", 
    RowBox[{"\[InvisibleSpace]", "k"}], "n"], " ", "=", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     TemplateBox[{
       RowBox[{
         RowBox[{"(", 
           RowBox[{"n", "-", "k"}], "\[VeryThinSpace]", ")"}], 
         "\[VeryThinSpace]", "/", "\[VeryThinSpace]", "2"}]},
      "Floor"]], " ", 
    SuperscriptBox["2", "n"], 
    RowBox[{"(", GridBox[{
       {"n"},
       {
        RowBox[{"\[InvisibleSpace]", 
         RowBox[{"n", "-", "k", "\[VeryThinSpace]"}]}]}
      },
      GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
    RowBox[{
     UnderoverscriptBox["\[Product]", 
      RowBox[{"i", "=", "1"}], 
      TemplateBox[{
        RowBox[{
          RowBox[{"(", 
            RowBox[{"n", "-", "k"}], "\[VeryThinSpace]", ")"}], 
          "\[VeryThinSpace]", "/", "\[VeryThinSpace]", "2"}]},
       "Floor"]], 
     RowBox[{"(", "\[VeryThinSpace]\[InvisibleSpace]", 
      RowBox[{"i", "-", 
       FractionBox["1", "2"]}], ")"}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8865274717678013`*^9, 3.886527503673438*^9}, {
   3.886527556582059*^9, 3.886527589810277*^9}, {3.886527637329039*^9, 
   3.886527654212845*^9}, {3.8865281033073397`*^9, 3.88652811754963*^9}, {
   3.886528367078273*^9, 3.886528383055921*^9}, 3.886528428754738*^9, {
   3.886530039733918*^9, 3.8865300461044273`*^9}, {3.886530188389338*^9, 
   3.88653019587597*^9}, {3.8865318577197723`*^9, 3.8865318819578257`*^9}, {
   3.886533238669362*^9, 
   3.886533250787592*^9}},ExpressionUUID->"c413edeb-e075-4e94-a720-\
cd31bc833f90"],

Cell["and so", "ExpositoryText",
 CellChangeTimes->{{3.8865300508558702`*^9, 
  3.886530051521599*^9}},ExpressionUUID->"66058afa-089a-4745-8903-\
f1b13b473ec4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["H", 
    RowBox[{"\[InvisibleSpace]", 
     RowBox[{
      SubscriptBox["p", "k"], "-", 
      RowBox[{"2", "\[InvisibleSpace]", "l"}]}]}], 
    SubscriptBox["p", "k"]], " ", "=", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], "l"], 
    SuperscriptBox["2", 
     RowBox[{"\[InvisibleSpace]", 
      RowBox[{
       SubscriptBox["p", "k"], "-", "\[InvisibleSpace]", "l"}]}]], " ", 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["p", "k"]},
       {
        RowBox[{"2", "\[InvisibleSpace]", "l"}]}
      },
      GridBoxAlignment->{"Columns" -> {Center}}], ")"}], " ", 
    RowBox[{
     UnderoverscriptBox["\[Product]", 
      RowBox[{"i", "=", "1"}], "l"], 
     RowBox[{"(", "\[VeryThinSpace]", 
      RowBox[{
       RowBox[{"2", "\[InvisibleSpace]", "i"}], "-", "1"}], ")"}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.886530062067494*^9, 3.886530095257717*^9}, {
   3.886530138631668*^9, 3.886530152321535*^9}, {3.8865302217500887`*^9, 
   3.886530238859947*^9}, {3.886530317823534*^9, 3.88653032692916*^9}, {
   3.8865332149204683`*^9, 3.886533235279356*^9}, 3.886539673354993*^9, {
   3.886541130201576*^9, 
   3.8865411474349613`*^9}},ExpressionUUID->"6b9c5947-557c-47a9-b231-\
4aa3d3117d49"],

Cell["Meaning we can evaluate Hermite polynomial coefficients by", \
"ExpositoryText",
 CellChangeTimes->{{3.8865330151271276`*^9, 
  3.886533027471834*^9}},ExpressionUUID->"fc8d7820-bd86-48fc-8632-\
2d8bccc27a8e"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["H", 
       RowBox[{"\[InvisibleSpace]", 
        RowBox[{
         SubscriptBox["p", "k"], "-", 
         RowBox[{"2", "\[InvisibleSpace]", "l"}]}]}], 
       SubscriptBox["p", "k"]], " ", "=", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "l"], " ", 
       SuperscriptBox["2", 
        RowBox[{"\[InvisibleSpace]", 
         RowBox[{
          SubscriptBox["p", "k"], "-", "\[InvisibleSpace]", "l"}]}]], "\[VeryThinSpace]\[InvisibleSpace]", 
       RowBox[{"(", 
        RowBox[{
         UnderoverscriptBox["\[Product]", 
          RowBox[{"i", "=", "1"}], 
          RowBox[{
           SubscriptBox["p", "k"], "-", 
           RowBox[{"2", "\[InvisibleSpace]", "l"}]}]], "\[VeryThinSpace] ", 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SubscriptBox["p", "k"], "-", "l", "+", "\[InvisibleSpace]", "1", 
             "-", "i"}], ")"}], 
           RowBox[{"(", 
            RowBox[{
             SubscriptBox["p", "k"], "+", "\[InvisibleSpace]", "1", "-", 
             "i"}], ")"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "\[InvisibleSpace]", "i"}], "\[InvisibleSpace]", 
             "-", "1"}], ")"}]}], 
          RowBox[{
           RowBox[{"(", "\[InvisibleSpace]", 
            RowBox[{"l", "+", "i"}], ")"}], "i"}]]}], ")"}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "l"], 
       SuperscriptBox["2", 
        RowBox[{
         SubscriptBox["p", "k"], "-", "l"}]], 
       SubsuperscriptBox["\[Eta]", "l", 
        SubscriptBox["p", "k"]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.886533034238306*^9, 3.886533137595317*^9}, {
   3.8865333178850203`*^9, 3.886533426746526*^9}, 3.886539675178225*^9, {
   3.886540232095155*^9, 3.886540254588088*^9}, {3.886540445801221*^9, 
   3.886540459715239*^9}, 3.886540951516988*^9, {3.886541314173933*^9, 
   3.886541352070917*^9}, {3.886541512756768*^9, 3.886541513732376*^9}, {
   3.886541551774868*^9, 
   3.886541552388866*^9}},ExpressionUUID->"4244d235-1f13-4572-97af-\
d6c29f14a630"],

Cell["with the full polynomial given by", "ExpositoryText",
 CellChangeTimes->{{3.886540277990652*^9, 3.886540279898608*^9}, {
  3.886541236327653*^9, 
  3.8865412411548347`*^9}},ExpressionUUID->"43b3b6eb-f130-4ad3-807b-\
f46ebdb41907"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["H", 
        SubscriptBox["p", "k"]], "(", "x", ")"}], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"l", "=", "0"}], 
        FormBox[
         TemplateBox[{
           RowBox[{
             SubscriptBox["p", "k"], "/", "2"}]},
          "Floor"],
         TraditionalForm]], 
       RowBox[{
        SubsuperscriptBox["H", 
         RowBox[{"\[InvisibleSpace]", 
          RowBox[{
           SubscriptBox["p", "k"], "-", 
           RowBox[{"2", "\[InvisibleSpace]", "l"}]}]}], 
         SubscriptBox["p", "k"]], 
        SuperscriptBox["x", 
         RowBox[{"\[VeryThinSpace]", 
          RowBox[{
           SubscriptBox["p", "k"], "-", 
           RowBox[{"2", "\[InvisibleSpace]", "l"}]}]}]]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"l", "=", "0"}], 
        FormBox[
         TemplateBox[{
           RowBox[{
             SubscriptBox["p", "k"], "/", "2"}]},
          "Floor"],
         TraditionalForm]], 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "l"], 
        SuperscriptBox["2", 
         RowBox[{
          SubscriptBox["p", "k"], "-", "l"}]], 
        SubsuperscriptBox["\[Eta]", "l", 
         SubscriptBox["p", "k"]], 
        SuperscriptBox["x", 
         RowBox[{"\[VeryThinSpace]", 
          RowBox[{
           SubscriptBox["p", "k"], "-", 
           RowBox[{"2", "\[InvisibleSpace]", "l"}]}]}]]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.886533034238306*^9, 3.886533137595317*^9}, {
   3.8865333178850203`*^9, 3.886533426746526*^9}, 3.886539675178225*^9, {
   3.886540232095155*^9, 3.886540393544043*^9}, {3.886541367641011*^9, 
