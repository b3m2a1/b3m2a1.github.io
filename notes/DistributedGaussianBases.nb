Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["\[ScriptCapitalT]", "j"], " ", "=", "\[AlignmentMarker] ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "n"], " ", 
       SuperscriptBox[
        SubscriptBox[
         RowBox[{"[", 
          RowBox[{
           SubsuperscriptBox["\[CapitalSigma]", "j", 
            RowBox[{"-", "1"}]], 
           SuperscriptBox["L", "T"], "\[InvisibleSpace]", "q"}], "]"}], "n"], 
        "2"]}]}]},
    {
     RowBox[{"\[AlignmentMarker] ", 
      RowBox[{
       RowBox[{
        RowBox[{"+", " ", 
         RowBox[{"[", 
          RowBox[{
           SubsuperscriptBox["\[CapitalSigma]", "j", 
            RowBox[{"-", "1"}]], 
           SubscriptBox["\[CapitalSigma]", "c"], 
           RowBox[{
            SuperscriptBox[
             SubscriptBox["\[CapitalSigma]", "i"], 
             RowBox[{"-", "1"}]], "(", 
            RowBox[{
             SubscriptBox["\[Xi]", "i"], "-", "\[InvisibleSpace]", 
             SubscriptBox["\[Xi]", "j"]}], ")"}]}], "]"}]}], "\[CircleTimes]", 
        RowBox[{"[", 
         RowBox[{
          SubsuperscriptBox["\[CapitalSigma]", "j", 
           RowBox[{"-", "1"}]], 
          SubscriptBox["\[CapitalSigma]", "c"], 
          RowBox[{
           SuperscriptBox[
            SubscriptBox["\[CapitalSigma]", "i"], 
            RowBox[{"-", "1"}]], "(", 
           RowBox[{
            SubscriptBox["\[Xi]", "i"], "-", "\[InvisibleSpace]", 
            SubscriptBox["\[Xi]", "j"]}], ")"}]}], "]"}]}], " ", "-", " ", 
       SubsuperscriptBox["\[CapitalSigma]", "j", 
        RowBox[{"-", "1"}]]}]}]},
    {
     RowBox[{"\[AlignmentMarker] ", 
      RowBox[{
       RowBox[{"+", " ", "linear"}], " ", "terms"}]}]}
   }], TraditionalForm]], "ExpositoryMathCenteredManuallyAligned",
 CellChangeTimes->{{3.907550614979806*^9, 3.907550689001914*^9}, {
   3.907550778214072*^9, 3.907550858180683*^9}, {3.9075515366776752`*^9, 
