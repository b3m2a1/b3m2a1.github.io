Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"matDerivPerms", "[", 
    RowBox[{
    "A_", ",", " ", "B_", ",", " ", "a_", ",", " ", "b_", ",", " ", "o_", ",",
      " ", "s_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"With", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"base", "=", 
        RowBox[{"prod", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"s", "==", "0"}], ",", " ", "A", ",", " ", 
            RowBox[{"DM", "[", 
             RowBox[{"A", ",", " ", "s"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"s", "==", "o"}], ",", " ", "B", ",", " ", 
            RowBox[{"DM", "[", 
             RowBox[{"B", ",", " ", 
              RowBox[{"o", "-", "s"}]}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"a", "+", "s"}], ",", " ", 
          RowBox[{"b", "+", 
           RowBox[{"(", 
            RowBox[{"o", "-", "s"}], ")"}]}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"nAPos", "=", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Ordering", "[", 
           RowBox[{"#", ",", " ", 
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"o", "-", "s"}], ")"}]}]}], "]"}], "&"}], "/@", 
         "\[IndentingNewLine]", 
         RowBox[{"Permutations", "@", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"ConstantArray", "[", 
             RowBox[{"1", ",", " ", 
              RowBox[{"o", "-", "s"}]}], "]"}], ",", " ", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"0", ",", " ", "s"}], "]"}]}], "]"}]}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"nAs", " ", "=", " ", 
        RowBox[{
         RowBox[{"rank", "[", "A", "]"}], "+", 
         RowBox[{"Range", "[", 
          RowBox[{"(", 
           RowBox[{"o", "-", "s"}], ")"}], "]"}]}]}]}], "\[IndentingNewLine]",
       "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"transp", "[", "\[IndentingNewLine]", 
        RowBox[{"base", ",", "\[IndentingNewLine]", 
         RowBox[{"Flatten", "@", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"ReplacePart", "[", 
              RowBox[{
               RowBox[{"Range", "[", "o", "]"}], ",", " ", 
               RowBox[{"Thread", "[", 
                RowBox[{"#", "->", "nAs"}], "]"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"Range", "[", "o", "]"}]}], "\[IndentingNewLine]", "}"}],
            "]"}]}]}], "\[IndentingNewLine]", "]"}], "&"}], "/@", "nAPos"}]}],
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
