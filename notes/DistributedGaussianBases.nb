Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "x"], 
       RowBox[{"V", "(", "x", ")"}]}], " \[AlignmentMarker]", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", "x"], 
         RowBox[{"V", "(", 
          RowBox[{"x", ";", " ", 
           SuperscriptBox["\[Xi]", 
            RowBox[{"(", ".", ")"}]]}], ")"}]}], "\[CircleDot]", 
        SuperscriptBox["w", 
         RowBox[{"(", ".", ")"}]]}], " ", "+", " ", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", "x"], 
         SuperscriptBox["w", 
          RowBox[{"(", ".", ")"}]]}], "\[CircleDot]", 
        RowBox[{"V", "(", 
         RowBox[{"x", ";", " ", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", ".", ")"}]]}], ")"}]}]}]}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "x"], "V"}], 
       RowBox[{"(", "x", ")"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "x"], 
        RowBox[{"V", "(", 
         RowBox[{"x", ";", " ", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", ".", ")"}]]}], ")"}]}], "\[CircleDot]", 
       SuperscriptBox["w", 
        RowBox[{"(", ".", ")"}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
