Cell["\<\
In particular, this generates scaled variants of the Hermite polynomials with \
entirely positive (or negative) coefficients. \
\>", "ExpositoryText",
 CellChangeTimes->{{3.883934072856647*^9, 3.883934124189313*^9}, {
   3.883934857116016*^9, 3.883934899361883*^9}, 3.883950770993987*^9, {
