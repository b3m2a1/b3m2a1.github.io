  3.883853960549357*^9, 
  3.8838539961698914`*^9}},ExpressionUUID->"454ba863-d95d-423d-8dd2-\
d9ebf6206ac3"],

Cell["where for now we\[CloseCurlyQuote]ll say", "ExpositoryText",
 CellChangeTimes->{{3.8838541522147007`*^9, 
  3.883854157116194*^9}},ExpressionUUID->"0540030c-7b65-4077-95f0-\
e6d4d78ee8be"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[ScriptCapitalT]", " ", "=", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Del]", 
        StyleBox["x",
         FontSize->12]], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["\[CapitalSigma]", 
          RowBox[{"-", "1"}]], "\[CircleDot]", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "-", "\[Xi]"}], ")"}], "2"]}], ")"}]}], ")"}], "2"], 
    " ", "-", " ", 
    RowBox[{
     SubscriptBox["\[Del]", 
      SuperscriptBox[
       StyleBox["x",
        FontSize->12], "2"]], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalSigma]", 
        RowBox[{"-", "1"}]], "\[CircleDot]", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "-", "\[Xi]"}], ")"}], "2"]}], ")"}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8838541626466007`*^9, 3.883854173006967*^9}, {
  3.883854251376935*^9, 
  3.883854260401363*^9}},ExpressionUUID->"d7f5e06e-3d4e-451c-8080-\
f339db0f168c"],

Cell["and so in total we have", "ExpositoryText",
 CellChangeTimes->{{3.883854220431611*^9, 
  3.883854222990018*^9}},ExpressionUUID->"b85e3cb6-1d78-458b-b5e8-\
180c93daa1ec"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["T", 
       RowBox[{"i", "\[InvisibleSpace]", "j"}]], "=", 
      RowBox[{"-", 
       RowBox[{
        SubsuperscriptBox["\[Integral]", 
         SuperscriptBox["\[DoubleStruckCapitalR]", "d"], " "], 
        RowBox[{
         RowBox[{"\[Phi]", "(", 
          RowBox[{"x", ",", " ", 
           SubscriptBox["\[Xi]", "i"], ",", " ", 
           SubscriptBox["\[CapitalSigma]", "i"]}], ")"}], 
         RowBox[{
          FractionBox[
           SuperscriptBox["\[Del]", "2"], 
           RowBox[{"2", "\[InvisibleSpace]", "m"}]], 
          RowBox[{"\[Phi]", "(", 
           RowBox[{"x", ",", " ", 
            SubscriptBox["\[Xi]", "j"], ",", " ", 
            SubscriptBox["\[CapitalSigma]", "j"]}], ")"}]}], 
         RowBox[{"\[DifferentialD]", "x"}]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{"-", 
       RowBox[{
        SubsuperscriptBox["\[Integral]", 
         SuperscriptBox["\[DoubleStruckCapitalR]", "d"], " "], 
        RowBox[{
         RowBox[{"\[Phi]", "(", 
          RowBox[{"x", ",", " ", 
           SubscriptBox["\[Xi]", "i"], ",", " ", 
           SubscriptBox["\[CapitalSigma]", "i"]}], ")"}], 
         RowBox[{"\[Phi]", "(", 
          RowBox[{"x", ",", " ", 
           SubscriptBox["\[Xi]", "j"], ",", " ", 
           SubscriptBox["\[CapitalSigma]", "j"]}], ")"}], 
         RowBox[{"Tr", "(", 
          RowBox[{
           SuperscriptBox["M", 
            RowBox[{"-", "1"}]], 
           SubscriptBox["\[ScriptCapitalT]", "j"]}], ")"}], 
         RowBox[{"\[DifferentialD]", "x"}]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"W", "(", 
         RowBox[{
          RowBox[{
           SubscriptBox["\[CapitalSigma]", "i"], "+", 
           SubscriptBox["\[CapitalSigma]", "j"]}], ",", " ", 
          RowBox[{
           SubscriptBox["\[Xi]", "i"], "-", 
           SubscriptBox["\[Xi]", "j"]}]}], ")"}]}], 
       RowBox[{
        SubsuperscriptBox["\[Integral]", 
         SuperscriptBox["\[DoubleStruckCapitalR]", "d"], " "], 
        RowBox[{
         RowBox[{"\[Phi]", "(", 
          RowBox[{"x", ",", " ", 
           SubscriptBox["\[Xi]", "c"], ",", " ", 
           SubscriptBox["\[CapitalSigma]", "c"]}], ")"}], 
         RowBox[{"Tr", "(", 
          RowBox[{
           SuperscriptBox["M", 
            RowBox[{"-", "1"}]], 
           SubscriptBox["\[ScriptCapitalT]", "j"]}], ")"}], 
         RowBox[{"\[DifferentialD]", "x", " "}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.883849746778249*^9, 3.883849773339202*^9}, {
  3.883849859019339*^9, 3.883849904608474*^9}, {3.8838542289689817`*^9, 
  3.883854267719841*^9}, {3.883854308517304*^9, 3.8838543496232853`*^9}, {
