   3.9161996849902143`*^9}},ExpressionUUID->"7f35d352-0e8d-4429-a807-\
ec93cc794d20"],

Cell["\<\
which is just a binomial coefficient times the appropriate falling factorial \
in odd numbers\
\>", "ExpositoryText",
 CellChangeTimes->{{3.9161996972344313`*^9, 
  3.916199726173407*^9}},ExpressionUUID->"15bbc1ff-daa1-44df-acf8-\
308fa65573d1"],

Cell["This means the generic integral form is", "ExpositoryText",
 CellChangeTimes->{{3.916199855825055*^9, 
  3.916199861154189*^9}},ExpressionUUID->"bbb625f1-3fc9-4cad-b8b4-\
d70ab08e68b6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "\[Infinity]"}], 
     RowBox[{"\[VeryThinSpace]", "\[Infinity]"}]], 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["q", "s"], "-", 
        SubsuperscriptBox["\[Xi]", "s", 
         RowBox[{"(", 
          RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], "k"], 
     SuperscriptBox["\[CurlyPhi]", 
      RowBox[{"(", "i", ")"}]], 
     SuperscriptBox["\[CurlyPhi]", 
      RowBox[{"*", 
       RowBox[{"(", "j", ")"}]}]]}]}], " ", "=", " ", 
   RowBox[{
    FractionBox[
     SubsuperscriptBox["X", "0", 
      RowBox[{"(", 
       RowBox[{"i", ",", "j"}], ")"}]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", 
        SubsuperscriptBox["\[Alpha]", "s", 
         RowBox[{"(", 
          RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], 
      RowBox[{"\[LeftCeiling]", 
       RowBox[{"k", "/", "2"}], "\[RightCeiling]"}]]], 
    RowBox[{"(", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"n", "=", "0"}], 
       RowBox[{"\[LeftFloor]", 
        RowBox[{"k", "/", "2"}], "\[RightFloor]"}]], " ", 
      SuperscriptBox[
       RowBox[{
        SubsuperscriptBox["\[Mu]", 
         RowBox[{"n", " "}], 
         RowBox[{"(", "k", ")"}]], "(", 
        FractionBox[
         SuperscriptBox[
          SubsuperscriptBox["p", "s", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"i", ",", "j"}], ")"}], "\[InvisibleSpace]"}]], "2"], 
         RowBox[{"2", 
          SubsuperscriptBox["\[Alpha]", "s", 
           RowBox[{"(", 
            RowBox[{"i", ",", "j"}], ")"}]]}]], ")"}], "n"]}], ")"}], 
    TagBox[GridBox[{
       {"\[Piecewise]", GridBox[{
          {
           RowBox[{"\[DoubleStruckI]", "\[InvisibleSpace]\[VeryThinSpace]", 
            SuperscriptBox["p", 
             RowBox[{"(", 
              RowBox[{"i", ",", "j"}], ")"}]]}], 
           RowBox[{"k", " ", "odd"}]},
          {"1", 
           RowBox[{"k", " ", "even"}]}
         },
         AllowedDimensions->{2, Automatic},
         Editable->True,
         GridBoxAlignment->{
          "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
           "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
         GridBoxItemSize->{
          "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, 
           "Rows" -> {{1.}}, "RowsIndexed" -> {}},
         GridBoxSpacings->{"Columns" -> {
             Offset[0.27999999999999997`], {
              Offset[0.84]}, 
             Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
             Offset[0.2], {
              Offset[0.4]}, 
             Offset[0.2]}, "RowsIndexed" -> {}},
         Selectable->True]}
      },
      GridBoxAlignment->{
       "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
        "RowsIndexed" -> {}},
      GridBoxItemSize->{
       "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}}, 
