    {
     RowBox[{
      RowBox[{
       SuperscriptBox["\[CapitalTheta]", 
        RowBox[{"(", "i", ")"}]], 
       SuperscriptBox["\[CapitalTheta]", 
        RowBox[{"(", "j", ")"}]]}], " ", "=", " \[AlignmentMarker]", 
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"exp", "(", 
          RowBox[{
           RowBox[{
           "\[DoubleStruckI]", "\[InvisibleSpace]\[VeryThinSpace]", "(", 
            RowBox[{
             SuperscriptBox["J", 
              RowBox[{"(", "i", ")"}]], "-", 
             SuperscriptBox["J", 
              RowBox[{"(", "j", ")"}]]}], ")"}], "\[VeryThinSpace]", "q"}], 
