       "\[IndentingNewLine]", 
       RowBox[{"\"\<Ji\>\"", "->", "\[Rho]i"}], ",", 
       RowBox[{"\"\<Jj\>\"", "->", "\[Rho]j"}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<Jc\>\"", "->", 
        RowBox[{"\[Rho]i", "-", "\[Rho]j"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<\[Rho]c\>\"", "->", 
        RowBox[{"\[CapitalSigma]c", ".", 
