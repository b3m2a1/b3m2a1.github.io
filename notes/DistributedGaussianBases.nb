             RowBox[{"\[CapitalDelta]", "[", 
              RowBox[{"i", ",", " ", "j"}], "]"}]}]}], ")"}]}]}], 
        "\[IndentingNewLine]", "}"}], "]"}]}], "//", "watSimp"}], "//", 
    "watSimp"}]}], ";"}], "\[IndentingNewLine]", 
