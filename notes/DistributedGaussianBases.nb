  3.914122228706917*^9}},ExpressionUUID->"8f3ad48e-8adf-4f47-9d75-\
a46c58afd9d9"],

Cell[TextData[{
 "Therefore from this we ",
 StyleBox["only",
  FontSlant->"Italic"],
 " end up with"
}], "ExpositoryText",
 CellChangeTimes->{{3.91412228156775*^9, 
  3.914122288772335*^9}},ExpressionUUID->"ef1dd06a-22e6-47af-96cd-\
3557ba2f7686"],

Cell[BoxData[
 FormBox[
  InterpretationBox[
   StyleBox[
    TemplateBox[{"\"(\"", 
      TemplateBox[{"\"(\"", 
        RowBox[{"Q", "-", 
          TemplateBox[{"\[Xi]", 
            TemplateBox[{"\"(\"", "c", "\")\""}, "RowDefault"]}, 
           "Superscript", SyntaxForm -> SuperscriptBox]}], "\")\""}, 
       "RowDefault"], "\"\[CircleTimes]\"", 
      TemplateBox[{"\"(\"", "\[CapitalIota]", "\"\[CircleTimes]\"", 
        TemplateBox[{
          TemplateBox[{"\[CapitalSigma]", 
            TemplateBox[{"\"(\"", "j", "\")\"", 
              StyleBox[
               AdjustmentBox["-1", BoxBaselineShift -> -1.5], 11, 
               StripOnInput -> False]}, "RowDefault"]}, "Superscript", 
           SyntaxForm -> SuperscriptBox], 
          TemplateBox[{"\"(\"", 
            RowBox[{"Q", "-", 
              TemplateBox[{"\[Xi]", 
                TemplateBox[{"\"(\"", "c", "\")\""}, "RowDefault"]}, 
               "Superscript", SyntaxForm -> SuperscriptBox]}], "\")\""}, 
           "RowDefault"]}, "RowDefault"], "\")\""}, "RowDefault"], "\")\""},
     "RowDefault"],
    StripOnInput->False,
    ShowStringCharacters->False,
    FontSize->18],
   CircleTimes[
    $CellContext`Q[
     $CellContext`\[Xi][$CellContext`c]], 
    CircleTimes[$CellContext`\[CapitalIota], 
     NonCommutativeMultiply[
      $CellContext`\[CapitalSigma][$CellContext`j], 
      $CellContext`Q[
       $CellContext`\[Xi][$CellContext`c]]]]]], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.914122332569778*^9, 
  3.914122333222509*^9}},ExpressionUUID->"56fc7f4d-3d4d-47b7-a7ea-\
27cf1bd5ec1f"],

Cell[TextData[{
 "which ",
 StyleBox["again",
  FontSlant->"Italic"],
 " forces us into the case that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Zeta]", 
