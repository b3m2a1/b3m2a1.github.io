Cell[CellGroupData[{

Cell["Full Integration (old)", "Subsubsubsubsection",
 CellChangeTimes->{{3.914122663184111*^9, 3.914122666782036*^9}, {
  3.9141686570118027`*^9, 3.914168658937667*^9}, {3.914179256081478*^9, 
  3.914179257308363*^9}},ExpressionUUID->"5d45c4c8-be1e-4f5b-8e23-\
e22073bb711e"],

Cell[CellGroupData[{

Cell["Bad Symmetry, Good Math", "Subsubsubsubsubsection",
 CellChangeTimes->{{3.914168661546702*^9, 
  3.914168667679018*^9}},ExpressionUUID->"68db3d08-fd5f-4977-a420-\
be98db1e77ce"],

Cell[TextData[{
 "We are therefore left with ",
 StyleBox["only two terms",
  FontSlant->"Italic"],
 " that survive the purge"
}], "ExpositoryText",
 CellChangeTimes->{{3.914122668170019*^9, 
  3.914122700964965*^9}},ExpressionUUID->"4300c317-1181-4c2e-a2c2-\
0c87ae1fd389"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SubscriptBox["\[Phi]", "n"]},
        "Bra"], " ", 
       RowBox[{
        SubsuperscriptBox["I", "\[Alpha]", 
         RowBox[{"-", "1"}]], "(", 
        RowBox[{
         SuperscriptBox["\[Zeta]", "\[Alpha]"], "\[CircleTimes]", 
         SuperscriptBox["\[Zeta]", "\[Alpha]"]}], ")"}], "\[AlignmentMarker]",
        "Q", "\[InvisibleSpace]", "PQ", "\[InvisibleSpace]\[InvisibleSpace]\[InvisibleSpace]",
        "P", " ", 
       TemplateBox[{
         SubscriptBox["\[Phi]", "m"]},
        "Ket"]}], " ", "=", " "}]},
    {
     RowBox[{"\[AlignmentMarker]", 
      RowBox[{
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"n", ",", "m", ",", "k"}]], 
        RowBox[{
         SubscriptBox[
          RowBox[{
           RowBox[{
            SubsuperscriptBox["I", "\[Alpha]", 
             RowBox[{"-", "1"}]], "(", 
            RowBox[{
             SuperscriptBox["\[Zeta]", "\[Alpha]"], "\[CircleTimes]", 
             SuperscriptBox["\[Zeta]", "\[Alpha]"]}], ")"}], 
           "\[AlignmentMarker]"}], 
          RowBox[{
          "n", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "k", 
           "\[InvisibleSpace]", "m"}]], "\[AlignmentMarker]", 
         RowBox[{"\[Integral]", 
          RowBox[{
           SubscriptBox[
            RowBox[{"(", 
             RowBox[{"Q", "-", 
              SuperscriptBox["\[Xi]", 
               RowBox[{"(", "c", ")"}]]}], ")"}], "n"], 
           SubscriptBox[
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["\[CapitalSigma]", 
               SuperscriptBox[
                RowBox[{"(", "j", ")"}], 
                RowBox[{"-", "1"}]]], "(", 
              RowBox[{"Q", "-", 
               SuperscriptBox["\[Xi]", 
                RowBox[{"(", "c", ")"}]]}], ")"}], ")"}], "m"], 
           SuperscriptBox["\[Phi]", 
            RowBox[{"(", "c", ")"}]]}]}]}]}], " ", "-", " ", "const"}]}]}
   }], TraditionalForm]], "ExpositoryMathCenteredManuallyAligned",
 CellChangeTimes->{{3.90688556245709*^9, 3.906885584889862*^9}, {
   3.907559247274458*^9, 3.907559254675674*^9}, {3.914122747965912*^9, 
   3.914122881918532*^9}, {3.9141234837136993`*^9, 3.914123505950858*^9}, {
   3.914123574528597*^9, 3.914123575402603*^9}, {3.914124370218074*^9, 
   3.914124371097322*^9}, {3.914124524395935*^9, 3.9141245306272*^9}, 
   3.914127118488791*^9, {3.9141717940626173`*^9, 
   3.9141717982549467`*^9}},ExpressionUUID->"be19b65a-9444-474c-8fb0-\
5a1cf243f142"],

Cell["Now to integrate that first term we\[CloseCurlyQuote]ll write", \
"ExpositoryText",
 CellChangeTimes->{{3.914123922205246*^9, 
  3.91412393020578*^9}},ExpressionUUID->"3522e6d6-76c9-44de-b0e5-\
05221c97d919"],

Cell[BoxData[
 FormBox[
  RowBox[{"R", " ", "=", " ", 
   RowBox[{"L", "\[InvisibleSpace]", "(", 
    RowBox[{"Q", "-", 
     SuperscriptBox["\[Xi]", 
      RowBox[{"(", "c", ")"}]]}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9141239404655333`*^9, 3.914123989981751*^9}, {
  3.914129399488599*^9, 3.91412939994492*^9}, {3.914129801589901*^9, 
  3.914129801899732*^9}},ExpressionUUID->"29c434f2-b198-4a0e-b408-\
1df3ecf9a607"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "cfa6a943-58e6-4297-9ad3-c7d8fd665b07"],
 " diagonalizes ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalSigma]", 
    RowBox[{"(", "c", ")"}]], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "07f49104-b355-4592-800e-5103bafd36a8"],
 " as usual with"
}], "ExpositoryText",
 CellChangeTimes->{{3.914123969023486*^9, 3.914123980484634*^9}, {
  3.914124770011272*^9, 
  3.9141247706243362`*^9}},ExpressionUUID->"0d7433db-85bb-4e56-ab32-\
c8beb0c26790"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"L", " ", 
    SuperscriptBox["\[CapitalSigma]", 
     RowBox[{"(", "c", ")"}]], 
    SuperscriptBox["L", "T"]}], " ", "=", " ", 
   SuperscriptBox["A", 
    RowBox[{"(", "c", ")"}]]}], TraditionalForm]], "ExpositoryMathCentered",
