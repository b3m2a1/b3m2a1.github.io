  3.886776664966269*^9}},ExpressionUUID->"309b69ec-6d5f-44bf-b1b2-\
544f78cc25ec"],

Cell[TextData[{
 "and then our final transform between ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SuperscriptBox["\[CapitalSigma]", 
      RowBox[{"(", "c", ")"}]], ")"}], 
    RowBox[{"-", "1"}]], TraditionalForm]],
  CellChangeTimes->{{3.88571610646173*^9, 3.885716114293036*^9}, {
    3.88571616107841*^9, 3.885716227906139*^9}, {3.88571746260404*^9, 
