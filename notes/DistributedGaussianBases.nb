   3.883950939971223*^9}},ExpressionUUID->"8d48ee5c-254d-451b-a1ba-\
049fb1df2b4a"],

Cell["\<\
Therefore we can modify the explicit generating function of the Hermite \
polynomials to have\
\>", "ExpositoryText",
 CellChangeTimes->{{3.883934072856647*^9, 3.883934124189313*^9}, {
   3.883934857116016*^9, 3.883934899361883*^9}, 3.883950770993987*^9, {
   3.88395092018299*^9, 
   3.883950922889189*^9}},ExpressionUUID->"ae9a9f4d-0401-4aa9-93c1-\
e6a3b02a0910"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["I", "n"], "(", 
       RowBox[{"\[Xi]", ",", " ", "\[Alpha]"}], ")"}], "=", " ", 
      RowBox[{
       FractionBox["1", 
        SqrtBox["2"]], 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          SuperscriptBox["\[Alpha]", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "\[InvisibleSpace]", "n"}], "+", "1"}], ")"}]}]], 
          RowBox[{"2", "\[Pi]"}]], ")"}], 
        RowBox[{"1", "/", "4"}]], 
       FractionBox[
        RowBox[{
         SqrtBox["\[Pi]"], 
         RowBox[{"n", "!"}]}], 
        SuperscriptBox["2", 
         RowBox[{"n", "-", "1"}]]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"m", "=", "0"}], 
         TemplateBox[{
           RowBox[{"n", "/", "2"}]},
          "Floor"]], 
        RowBox[{
         FractionBox[
          SuperscriptBox["2", 
           RowBox[{"n", "-", 
            RowBox[{"2", "\[InvisibleSpace]", "m"}]}]], 
          RowBox[{
           RowBox[{"m", "!"}], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"n", "-", 
              RowBox[{"2", "\[InvisibleSpace]", "m"}]}], ")"}], "!"}]}]], 
         SuperscriptBox["\[CapitalXi]", 
          RowBox[{"n", "-", 
           RowBox[{"2", "\[InvisibleSpace]", "m"}]}]]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       SqrtBox[
        FractionBox["\[Pi]", "2"]], 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          SuperscriptBox["\[Alpha]", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "\[InvisibleSpace]", "n"}], "+", "1"}], ")"}]}]], 
          RowBox[{"2", "\[Pi]"}]], ")"}], 
        RowBox[{"1", "/", "4"}]], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"m", "=", "0"}], 
         TemplateBox[{
           RowBox[{"n", "/", "2"}]},
          "Floor"]], 
        RowBox[{
         FractionBox[
          RowBox[{"n", "!"}], 
          RowBox[{
           RowBox[{"m", "!"}], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"n", "-", 
              RowBox[{"2", "\[InvisibleSpace]", "m"}]}], ")"}], "!"}]}]], 
         FractionBox[
          SuperscriptBox["2", 
           RowBox[{"n", "-", 
            RowBox[{"2", "\[InvisibleSpace]", "m"}]}]], 
          SuperscriptBox["2", 
           RowBox[{"n", "-", "1"}]]], 
         SuperscriptBox["\[CapitalXi]", 
          RowBox[{"n", "-", 
           RowBox[{"2", "\[InvisibleSpace]", "m"}]}]]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SqrtBox[
        FractionBox["\[Pi]", "2"]], 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          SuperscriptBox["\[Alpha]", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "\[InvisibleSpace]", "n"}], "+", "1"}], ")"}]}]], 
          RowBox[{"2", "\[Pi]"}]], ")"}], 
        RowBox[{"1", "/", "4"}]], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"m", "=", "0"}], 
         TemplateBox[{
           RowBox[{"n", "/", "2"}]},
          "Floor"]], 
        RowBox[{
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"max", "(", 
               RowBox[{"m", ",", " ", 
                RowBox[{"n", "-", 
                 RowBox[{"2", "\[InvisibleSpace]", "m"}]}]}], ")"}], "+", 
              "1"}], ",", " ", "n"}], ")"}], "!"}], 
          RowBox[{
           RowBox[{"min", "(", 
            RowBox[{"m", ",", " ", 
             RowBox[{"n", "-", 
              RowBox[{"2", "\[InvisibleSpace]", "m"}]}]}], ")"}], "!"}]], 
         FractionBox[
          SuperscriptBox["\[CapitalXi]", 
           RowBox[{"n", "-", 
            RowBox[{"2", "\[InvisibleSpace]", "m"}]}]], 
          SuperscriptBox["2", 
           RowBox[{
            RowBox[{"2", "\[InvisibleSpace]", "m"}], "-", "1"}]]]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
