Cell[BoxData[
 FormBox[
  RowBox[{
   SqrtBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", "\[Pi]"}], ")"}], 
      RowBox[{"(", 
       RowBox[{"d", "-", "k"}], ")"}]], 
     FractionBox[
      RowBox[{
      "\[LeftBracketingBar]", "\[VeryThinSpace]", "\[CapitalSigma]", 
       "\[RightBracketingBar]"}], 
