Cell["For a quadratic expansion this becomes", "ExpositoryText",
 CellChangeTimes->{{3.883930340820636*^9, 3.8839303558730927`*^9}, {
  3.883930862164578*^9, 
  3.883930869992652*^9}},ExpressionUUID->"743af9ce-6e89-4c77-94ff-\
bf9c72d57905"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox["\[Xi]", 
       RowBox[{"(", 
        RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], " ", "=", " ", 
      FractionBox[
       RowBox[{
        RowBox[{
         SuperscriptBox["\[Alpha]", 
          RowBox[{"(", "i", ")"}]], 
         SubsuperscriptBox["\[Xi]", "k", 
          RowBox[{"(", "i", ")"}]]}], "+", 
        RowBox[{
         SuperscriptBox["\[Alpha]", 
          RowBox[{"(", "j", ")"}]], 
         SubsuperscriptBox["\[Xi]", "k", 
          RowBox[{"(", "j", ")"}]]}]}], 
       RowBox[{
        SuperscriptBox["\[Alpha]", 
         RowBox[{"(", "i", ")"}]], "+", 
        SuperscriptBox["\[Alpha]", 
         RowBox[{"(", "j", ")"}]]}]]}]},
    {
     RowBox[{
      SuperscriptBox["\[Alpha]", 
       RowBox[{"(", 
        RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], " ", "=", " ", 
      RowBox[{
       SuperscriptBox["\[Alpha]", 
        RowBox[{"(", "i", ")"}]], "+", 
       SuperscriptBox["\[Alpha]", 
        RowBox[{"(", "j", ")"}]]}]}]},
    {
     RowBox[{
      SubscriptBox["V", 
       RowBox[{"i", "\[InvisibleSpace]", "j"}]], " ", "=", 
      " \[AlignmentMarker]", 
      RowBox[{
       SubscriptBox["S", 
        RowBox[{"i", "\[InvisibleSpace]", "j"}]], "(", 
       RowBox[{
        RowBox[{"V", "(", 
         SuperscriptBox[
          StyleBox["\[Xi]",
           FontWeight->"Bold"], 
          RowBox[{"(", 
           RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], ")"}], " ", "+", 
        RowBox[{
         FractionBox["1", "4"], " ", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"k", "=", "1"}], 
           RowBox[{"3", "\[InvisibleSpace]", "N"}]], 
          RowBox[{
           FractionBox["1", 
            SubsuperscriptBox["\[Alpha]", "k", 
             RowBox[{"(", 
              RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]]], 
           RowBox[{
            FractionBox[
             SuperscriptBox["\[PartialD]", "2"], 
             RowBox[{"\[PartialD]", 
              SubsuperscriptBox["x", 
               RowBox[{"\[VeryThinSpace]", "k"}], "2"]}]], 
            RowBox[{"V", "(", 
             StyleBox["\[Zeta]",
              FontWeight->"Bold"], ")"}]}]}]}]}]}], ")"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8839303735319*^9, 3.883930671158495*^9}, {
   3.8839394809077463`*^9, 3.8839394820770187`*^9}, 3.8839423374341593`*^9, 
