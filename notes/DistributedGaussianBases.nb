     RowBox[{"n", "\[InvisibleSpace]", "u"}]], 
    SubscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[Xi]", 
       RowBox[{"(", "c", ")"}]], ")"}], 
     RowBox[{"v", "\[InvisibleSpace]"}]], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalSigma]", 
        RowBox[{"(", "d", ")"}]], 
       SuperscriptBox["\[CapitalDelta]", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], "m"]}], " ", "=", " ", 
   RowBox[{
    RowBox[{"-", 
     SubscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["\[CapitalSigma]", 
         RowBox[{"(", "c", ")"}]], 
        SuperscriptBox[
         SuperscriptBox["\[CapitalSigma]", 
          RowBox[{"(", "i", ")"}]], 
         RowBox[{"-", "1"}]]}], ")"}], 
      RowBox[{"n", "\[InvisibleSpace]", "u"}]]}], 
    SubscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[Xi]", 
       RowBox[{"(", "c", ")"}]], ")"}], 
     RowBox[{"v", "\[InvisibleSpace]"}]], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalSigma]", 
        RowBox[{"(", "d", ")"}]], 
       SuperscriptBox["\[CapitalDelta]", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], "m"]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9142051678609858`*^9, 3.914205168819395*^9}, {
   3.914205202035424*^9, 3.914205226108972*^9}, 
   3.9142058546429863`*^9},ExpressionUUID->"1025405f-5a06-4c1c-80e4-\
22eb777d5591"],

Cell[TextData[{
 "by the exact same argument as before, ",
 StyleBox["and then",
  FontSlant->"Italic"],
 " we note that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalDelta]", 
     RowBox[{"(", 
      RowBox[{"i", ",", "j"}], ")"}]], " ", "=", " ", 
    RowBox[{"-", 
     SuperscriptBox["\[CapitalDelta]", 
      RowBox[{"(", 
       RowBox[{"j", ",", "i"}], ")"}]]}]}], TraditionalForm]],
  CellChangeTimes->{{3.9142051678609858`*^9, 3.914205168819395*^9}, {
   3.914205202035424*^9, 3.914205226108972*^9}},ExpressionUUID->
  "07783d51-d289-401e-aab2-691cf9dd6bd6"],
 " and so"
}], "ExpositoryText",
 CellChangeTimes->{{3.91420522752927*^9, 
  3.9142052695266027`*^9}},ExpressionUUID->"3017cf91-eea0-4085-b50f-\
b0a284d21ff7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", "2"}], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalSigma]", 
        RowBox[{"(", "c", ")"}]], 
       SuperscriptBox["\[CapitalSigma]", 
        SuperscriptBox[
         RowBox[{"(", "j", ")"}], 
         RowBox[{"-", "1"}]]]}], "\[InvisibleSpace]", ")"}], 
     RowBox[{"n", "\[InvisibleSpace]", "u"}]], 
    SubscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[Xi]", 
       RowBox[{"(", "c", ")"}]], ")"}], 
     RowBox[{"v", "\[InvisibleSpace]"}]], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalSigma]", 
        RowBox[{"(", "d", ")"}]], 
       SuperscriptBox["\[CapitalDelta]", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], "m"]}], " ", "=", " ", 
   RowBox[{
    RowBox[{"-", "2"}], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalSigma]", 
        RowBox[{"(", "c", ")"}]], 
       SuperscriptBox[
        SuperscriptBox["\[CapitalSigma]", 
         RowBox[{"(", "i", ")"}]], 
        RowBox[{"-", "1"}]]}], ")"}], 
     RowBox[{"n", "\[InvisibleSpace]", "u"}]], 
    SubscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[Xi]", 
       RowBox[{"(", "c", ")"}]], ")"}], 
     RowBox[{"v", "\[InvisibleSpace]"}]], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalSigma]", 
        RowBox[{"(", "d", ")"}]], 
       SuperscriptBox["\[CapitalDelta]", 
        RowBox[{"(", 
         RowBox[{"j", ",", "i"}], ")"}]]}], ")"}], "m"]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9142051678609858`*^9, 3.914205168819395*^9}, {
  3.914205202035424*^9, 3.914205226108972*^9}, {3.9142052744450207`*^9, 
  3.914205277554954*^9}, {3.914205863027287*^9, 
  3.914205869473611*^9}},ExpressionUUID->"150338d8-c738-499a-be6b-\
4c783ad28663"],

Cell["which gives us the symmetry we need", "ExpositoryText",
 CellChangeTimes->{{3.914205279736505*^9, 3.9142052847494307`*^9}, {
  3.914206293671605*^9, 3.914206332131707*^9}, {3.914206382074423*^9, 
  3.914206382220542*^9}},ExpressionUUID->"f8770ff6-6ee0-4071-9426-\
c7c56174fc80"],

Cell[TextData[{
 "We\[CloseCurlyQuote]ll handle the other term by first swapping ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "->", "u"}], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"c6ee0eb8-3034-43b4-a3ce-a48019419196"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "\[Rule]", "v"}], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"bc4eb5c6-27f4-4677-a760-60cb0c6d49f6"],
 " which doesn\[CloseCurlyQuote]t change the sign, this means we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.914205293924693*^9, 
  3.914205335668716*^9}},ExpressionUUID->"3978ef70-a0c8-4d0b-8d69-\
e79cc9bdacef"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[Xi]", 
       RowBox[{"(", "c", ")"}]], ")"}], "u"], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalSigma]", 
        RowBox[{"(", "d", ")"}]], 
       SuperscriptBox["\[CapitalDelta]", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], "m"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Delta]", 
       RowBox[{"n", "\[InvisibleSpace]", "v", " "}]], "-", 
      RowBox[{"2", 
       SubscriptBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["\[CapitalSigma]", 
           RowBox[{"(", "c", ")"}]], 
          SuperscriptBox["\[CapitalSigma]", 
           SuperscriptBox[
            RowBox[{"(", "j", ")"}], 
            RowBox[{"-", "1"}]]]}], "\[InvisibleSpace]", ")"}], 
        RowBox[{"n", "\[InvisibleSpace]", "v"}]]}]}], ")"}]}], " ", "=", " ", 
   
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[Xi]", 
       RowBox[{"(", "c", ")"}]], ")"}], "u"], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalSigma]", 
        RowBox[{"(", "d", ")"}]], 
       SuperscriptBox["\[CapitalDelta]", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], "m"], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{"I", "-", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["\[CapitalSigma]", 
           RowBox[{"(", "c", ")"}]], 
          SuperscriptBox["\[CapitalSigma]", 
           SuperscriptBox[
            RowBox[{"(", "j", ")"}], 
            RowBox[{"-", "1"}]]]}], "\[InvisibleSpace]", ")"}]}]}], ")"}], 
     RowBox[{"n", "\[InvisibleSpace]", "v"}]]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.914205878521447*^9, 3.914205923316128*^9}, {
  3.914205953618546*^9, 3.9142059892334414`*^9}, {3.9142060358879642`*^9, 
  3.9142060397088423`*^9}},ExpressionUUID->"e2a9de03-eeef-40bd-906a-\
0f2c9de530c3"],

Cell["\<\
which isn\[CloseCurlyQuote]t exactly the pattern we had before, but here\
\[CloseCurlyQuote]s a mind-blowing fact\
\>", "ExpositoryText",
 CellChangeTimes->{{3.914206041071959*^9, 
  3.9142060944877033`*^9}},ExpressionUUID->"1660e482-783c-46e9-84c1-\
915a849ddaed"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"2", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[CapitalSigma]", 
       RowBox[{"(", "c", ")"}]], 
      SuperscriptBox["\[CapitalSigma]", 
       SuperscriptBox[
        RowBox[{"(", "j", ")"}], 
        RowBox[{"-", "1"}]]]}], "\[InvisibleSpace]", ")"}]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     SuperscriptBox["\[CapitalSigma]", 
      RowBox[{"(", "c", ")"}]], 
     SuperscriptBox["\[CapitalSigma]", 
      SuperscriptBox[
       RowBox[{"(", "j", ")"}], 
       RowBox[{"-", "1"}]]]}], "\[InvisibleSpace] ", "+", " ", 
    RowBox[{
     SuperscriptBox["\[CapitalSigma]", 
      RowBox[{"(", "c", ")"}]], 
     SuperscriptBox["\[CapitalSigma]", 
      SuperscriptBox[
       RowBox[{"(", "j", ")"}], 
       RowBox[{"-", "1"}]]], "\[InvisibleSpace]"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.914206071878071*^9, 
  3.914206080908229*^9}},ExpressionUUID->"f185d989-4d0a-42e0-a9f6-\
19932aba64ad"],

Cell["\<\
and so we can use the first copy to perform the previous trick\
\>", "ExpositoryText",
 CellChangeTimes->{{3.914206097330386*^9, 
  3.9142061086990843`*^9}},ExpressionUUID->"ea898497-b964-4808-bc26-\
e6297b81157a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"I", " ", "-", " ", 
    RowBox[{
     SuperscriptBox["\[CapitalSigma]", 
      RowBox[{"(", "c", ")"}]], 
     SuperscriptBox["\[CapitalSigma]", 
      SuperscriptBox[
       RowBox[{"(", "j", ")"}], 
       RowBox[{"-", "1"}]]]}]}], " ", "=", " ", 
   RowBox[{
    SuperscriptBox["\[CapitalSigma]", 
     RowBox[{"(", "c", ")"}]], 
    SuperscriptBox["\[CapitalSigma]", 
     SuperscriptBox[
      RowBox[{"(", "i", ")"}], 
      RowBox[{"-", "1"}]]]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.914206112745636*^9, 
  3.9142061293707523`*^9}},ExpressionUUID->"f2d4ec18-00d0-4b6e-8825-\
fa6b5ee00cf8"],

Cell["\<\
and so we get to do the same double negative as before, giving us\
\>", "ExpositoryText",
 CellChangeTimes->{{3.914206148378456*^9, 3.914206150066716*^9}, {
  3.91420618820221*^9, 
  3.9142062024044533`*^9}},ExpressionUUID->"d3132b98-861a-4de7-a708-\
e706b39fb88b"],

