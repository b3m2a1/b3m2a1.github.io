  3.916789644096245*^9, 
  3.9167896537486467`*^9}},ExpressionUUID->"a16af54d-d5f5-4df3-8fec-\
23777a32bb33"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{"T", " ", "=", " ", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], 
       RowBox[{
        UnderscriptBox["\[Sum]", "k"], " ", 
        RowBox[{
         FractionBox["1", 
          SubscriptBox["m", "k"]], 
         RowBox[{"(", 
          RowBox[{
           SubsuperscriptBox["\[CapitalDelta]J", "k", "2"], " ", "-", " ", 
           SubsuperscriptBox["\[CapitalSigma]", 
            RowBox[{"k", "\[InvisibleSpace]", "k"}], "+"]}], ")"}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], 
       RowBox[{
        UnderscriptBox["\[Sum]", "k"], " ", 
        RowBox[{
         FractionBox["1", 
          SubscriptBox["m", "k"]], 
         RowBox[{"(", 
          RowBox[{
           SubsuperscriptBox["\[CapitalDelta]", "k", "2"], " ", "-", " ", 
           SubsuperscriptBox["\[CapitalSigma]", 
            RowBox[{"k", "\[InvisibleSpace]", "k"}], "+"], " ", "-", " ", 
           SuperscriptBox[
            SubsuperscriptBox["J", 
             RowBox[{"k", "\[InvisibleSpace]"}], "+"], "2"], " ", "-", " ", 
           RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]\[VeryThinSpace]", 
            SubscriptBox["\[CapitalDelta]", "k"], "\[InvisibleSpace]", 
            SubsuperscriptBox["J", 
             RowBox[{"k", "\[InvisibleSpace]"}], "+"]}]}], " ", 
          ")"}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCenteredNumbered",
