               SubscriptBox["p", 
                RowBox[{"k", "/", "2"}]]]], 
             RowBox[{
              UnderoverscriptBox["\[Sum]", 
               RowBox[{"l", "=", "0"}], 
               TemplateBox[{
                 RowBox[{
                   SubscriptBox["p", "k"], "/", "2"}]},
                "Floor"]], 
              RowBox[{
