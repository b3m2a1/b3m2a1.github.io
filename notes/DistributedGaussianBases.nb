   SubscriptBox["W", "N"], " ", "=", " ", 
   RowBox[{
    FractionBox["1", 
     SqrtBox[
      RowBox[{
       SuperscriptBox["2", "d"], 
       SuperscriptBox["\[Pi]", "d"], 
       RowBox[{"\[LeftBracketingBar]", 
