Cell[CellGroupData[{

Cell["Interpolations", "Section",
 CellChangeTimes->{{3.915472148824388*^9, 
  3.915472150684614*^9}},ExpressionUUID->"3031b706-d5c4-44f8-aabc-\
63a5312152a0"],

Cell["\<\
The simplest treatment for the interpolation of the potential is the \
inverse-distance weighted interpolation, given by\
\>", "ExpositoryText",
 CellChangeTimes->{{3.915472152415533*^9, 3.915472152654009*^9}, {
  3.915472257373645*^9, 
  3.915472315170624*^9}},ExpressionUUID->"469b6ca3-edd3-4482-9ab6-\
3e1fa5ae0bd2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"V", "(", "x", ")"}], " ", "=", " ", 
   FractionBox[
    RowBox[{
     RowBox[{
      UnderscriptBox["\[Sum]", "i"], " ", 
      RowBox[{"V", "(", 
       SuperscriptBox["\[Xi]", 
        RowBox[{"(", "i", ")"}]], ")"}]}], "|", 
     RowBox[{"x", "-", 
      SuperscriptBox["\[Xi]", 
       RowBox[{"(", "i", ")"}]]}], 
     SuperscriptBox["|", 
      RowBox[{"-", "p"}]]}], 
    RowBox[{
     UnderscriptBox["\[Sum]", "i"], " ", 
     RowBox[{"|", 
      RowBox[{"x", "-", 
       SuperscriptBox["\[Xi]", 
        RowBox[{"(", "i", ")"}]]}], 
      SuperscriptBox["|", 
       RowBox[{"-", "p"}]]}]}]]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.915472316532776*^9, 3.915472348409555*^9}, {
  3.9158052795200863`*^9, 3.9158052823979263`*^9}, {3.91580552031388*^9, 
  3.9158055227695847`*^9}, {3.9158066441081543`*^9, 
  3.915806673700666*^9}},ExpressionUUID->"81b5ad90-e499-469d-b704-\
9a938e28b1df"],

Cell["\<\
We will take advantage of the fact, however, that at every point we have a \
local quadratic expansion, i.e. we can write\
\>", "ExpositoryText",
 CellChangeTimes->{{3.91547239791046*^9, 3.915472503844145*^9}, {
  3.9158050662529383`*^9, 
  3.915805078236897*^9}},ExpressionUUID->"eb643412-dbdc-4473-b45f-\
248db80295ff"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"V", "(", 
    RowBox[{"x", ";", " ", 
     SuperscriptBox["\[Xi]", 
      RowBox[{"(", "i", ")"}]]}], ")"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"V", "(", 
     SuperscriptBox["\[Xi]", 
      RowBox[{"(", "i", ")"}]], ")"}], " ", "+", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Del]", "x"], 
      RowBox[{"V", "(", 
       SuperscriptBox["\[Xi]", 
        RowBox[{"(", "i", ")"}]], ")"}]}], "\[CircleDot]", 
     RowBox[{"(", 
      RowBox[{"x", "-", 
       SuperscriptBox["\[Xi]", 
        RowBox[{"(", "i", ")"}]]}], ")"}]}], " ", "+", " ", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "x"], 
       RowBox[{"V", "(", 
        SuperscriptBox["\[Xi]", 
         RowBox[{"(", "i", ")"}]], ")"}]}], "\[CircleDot]", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "-", 
         SuperscriptBox["\[Xi]", 
          RowBox[{"(", "i", ")"}]]}], ")"}], "2"]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.915472513329344*^9, 3.915472516152842*^9}, {
  3.915805079975333*^9, 
  3.9158051462017*^9}},ExpressionUUID->"98d1a62f-c043-4011-98d4-c62f769320f3"],

Cell[TextData[{
 "where \[CircleDot] is a total contraction and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"x", "-", 
      SuperscriptBox["\[Xi]", 
       RowBox[{"(", "i", ")"}]]}], ")"}], "2"], TraditionalForm]],
  CellChangeTimes->{{3.915472513329344*^9, 3.915472516152842*^9}, {
   3.915805079975333*^9, 3.9158051462017*^9}},ExpressionUUID->
  "f1566ecd-db32-4a56-b7ae-113ca03a2722"],
 " is the outer product of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"x", "-", 
     SuperscriptBox["\[Xi]", 
      RowBox[{"(", "i", ")"}]]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.915472513329344*^9, 3.915472516152842*^9}, {
   3.915805079975333*^9, 3.9158051462017*^9}},ExpressionUUID->
  "54844987-60ea-4fa8-80c8-59111f437acb"],
 " with itself."
}], "ExpositoryText",
 CellChangeTimes->{{3.91580515714294*^9, 
  3.915805210357182*^9}},ExpressionUUID->"2f7c489b-2ee9-4f5e-940f-\
e91e5fd013b7"],

Cell["\<\
Now we can do an inverse distance weighting of these Taylor series to give\
\>", "ExpositoryText",
 CellChangeTimes->{{3.915805232141231*^9, 
  3.915805243781046*^9}},ExpressionUUID->"43f693e6-fa39-42f8-b1cd-\
d99b05a5b4fc"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"V", "(", "x", ")"}], " ", "=", " ", 
   FractionBox[
    RowBox[{
     RowBox[{
      UnderscriptBox["\[Sum]", "i"], " ", 
      RowBox[{"V", "(", 
       RowBox[{"x", ";", " ", 
        SuperscriptBox["\[Xi]", 
         RowBox[{"(", "i", ")"}]]}], ")"}]}], "|", 
     RowBox[{"x", "-", 
      SuperscriptBox["\[Xi]", 
       RowBox[{"(", "i", ")"}]]}], 
     SuperscriptBox["|", 
      RowBox[{"-", "p"}]]}], 
    RowBox[{
     UnderscriptBox["\[Sum]", "i"], " ", 
     RowBox[{"|", 
      RowBox[{"x", "-", 
       SuperscriptBox["\[Xi]", 
        RowBox[{"(", "i", ")"}]]}], 
      SuperscriptBox["|", 
       RowBox[{"-", "p"}]]}]}]]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.915472316532776*^9, 3.915472348409555*^9}, {
  3.915805249539295*^9, 3.9158052500107183`*^9}, {3.915805438795442*^9, 
  3.9158054415388727`*^9}, {3.915805525224991*^9, 3.9158055273157043`*^9}, {
  3.9158069766351013`*^9, 3.915806978145073*^9}, {3.926233128885562*^9, 
  3.926233138546479*^9}},ExpressionUUID->"74f8bbeb-afb2-4e25-9549-\
72e85b15a8f2"],

Cell[CellGroupData[{

Cell["Derivatives", "Subsection",
 CellChangeTimes->{{3.915988141241832*^9, 
  3.915988144624629*^9}},ExpressionUUID->"eef0fcf3-da65-4f6c-9593-\
7107c91b0e94"],

Cell["\<\
Unfortunately, derivatives of this interpolation are formally quite messy as \
we have\
\>", "ExpositoryText",
 CellChangeTimes->{{3.915805263552229*^9, 
  3.915805285105712*^9}},ExpressionUUID->"60ed206b-ebe9-442a-9ded-\
3f37f03807ea"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", "x"], 
    RowBox[{"V", "(", "x", ")"}]}], " ", "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", "i"], " ", 
    RowBox[{"(", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "x"], 
        RowBox[{"V", "(", 
         RowBox[{"x", ";", " ", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", "i", ")"}]]}], ")"}]}], 
       SuperscriptBox["w", 
        RowBox[{"(", "i", ")"}]]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"V", "(", 
        RowBox[{"x", ";", " ", 
         SuperscriptBox["\[Xi]", 
          RowBox[{"(", "i", ")"}]]}], ")"}], 
       RowBox[{
        SubscriptBox["\[Del]", "x"], 
        SuperscriptBox["w", 
         RowBox[{"(", "i", ")"}]]}]}]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9158052866991167`*^9, 
  3.9158053839033957`*^9}},ExpressionUUID->"b568e094-9fd3-4341-874e-\
61bd92f90092"],

Cell["where", "ExpositoryText",
 CellChangeTimes->{{3.9158053864597692`*^9, 
  3.9158053869139967`*^9}},ExpressionUUID->"3a0c6777-e5bf-45d6-a7d7-\
e58671e84ed8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", "x"], 
    SuperscriptBox["w", 
     RowBox[{"(", "i", ")"}]]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", "x"], "|", "x"}], "-", 
        SuperscriptBox["\[Xi]", 
         RowBox[{"(", "i", ")"}]]}], 
       SuperscriptBox["|", 
        RowBox[{"-", "p"}]]}], 
      RowBox[{
       UnderscriptBox["\[Sum]", "j"], " ", 
       RowBox[{"|", 
        RowBox[{"x", "-", 
         SuperscriptBox["\[Xi]", 
          RowBox[{"(", "j", ")"}]]}], 
        SuperscriptBox["|", 
         RowBox[{"-", "p"}]], " "}]}]], " ", "+"}], " ", "|", 
    RowBox[{"x", "-", 
     SuperscriptBox["\[Xi]", 
      RowBox[{"(", "i", ")"}]]}], 
    SuperscriptBox["|", 
     RowBox[{"-", "p"}]], 
    RowBox[{
     SubscriptBox["\[Del]", "x"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        UnderscriptBox["\[Sum]", "j"], " ", 
        RowBox[{"|", 
         RowBox[{"x", "-", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", "j", ")"}]]}], 
         SuperscriptBox["|", 
          RowBox[{"-", "p"}]]}]}], ")"}], 
      RowBox[{"-", "1"}]]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.915805390587254*^9, 3.9158055559111443`*^9}, {
   3.915805893163144*^9, 3.91580589758665*^9}, {3.915805958215369*^9, 
   3.915806010082955*^9}, {3.915806046403885*^9, 3.9158060491288013`*^9}, 
   3.915806256122815*^9, {3.915806485431593*^9, 3.915806491212864*^9}, {
   3.9158065973229437`*^9, 3.915806632955048*^9}, {3.915806678846736*^9, 
   3.91580670172963*^9}, 3.915806737124139*^9, {3.915806991357603*^9, 
   3.915807012772336*^9}, {3.9158172457191*^9, 
   3.915817248160404*^9}},ExpressionUUID->"d1421a48-e03d-4ddd-8999-\
e03e93b02272"],

Cell["For later convenience, we will write", "ExpositoryText",
 CellChangeTimes->{{3.915807014452499*^9, 
  3.915807020869897*^9}},ExpressionUUID->"e0214a8f-8519-4102-8ddf-\
f2b2c06a1f79"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"d", "(", 
       RowBox[{"x", ",", " ", 
        SuperscriptBox["\[Xi]", 
         RowBox[{"(", "i", ")"}]], ",", " ", "m"}], ")"}], " ", "=", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x", "-", 
           SuperscriptBox["\[Xi]", 
            RowBox[{"(", "i", ")"}]]}], ")"}], "\[CenterDot]", 
         RowBox[{"(", 
          RowBox[{"x", "-", 
           SuperscriptBox["\[Xi]", 
            RowBox[{"(", "i", ")"}]]}], ")"}]}], ")"}], 
       RowBox[{"-", "m"}]]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{"|", 
       RowBox[{"(", 
        RowBox[{"x", "-", 
         SuperscriptBox["\[Xi]", 
          RowBox[{"(", "i", ")"}]]}], ")"}], 
       SuperscriptBox["|", 
        RowBox[{
         RowBox[{"-", "2"}], "\[InvisibleSpace]", "m"}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9158070218043203`*^9, 3.915807043939836*^9}, 
   3.915816477353348*^9, {3.915816513598378*^9, 3.915816534624963*^9}, {
   3.915816568716977*^9, 3.915816575079074*^9}, {3.915816606294701*^9, 
   3.915816609849847*^9}},ExpressionUUID->"b361f46d-849c-4a30-bd38-\
70b761b8dcef"],

Cell["and so we have", "ExpositoryText",
 CellChangeTimes->{{3.915807047316704*^9, 
  3.915807049022649*^9}},ExpressionUUID->"4ed5d87f-1f3e-4490-9f8f-\
1d60fbb05912"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", "x"], "|", "x"}], "-", 
        SuperscriptBox["\[Xi]", 
         RowBox[{"(", "i", ")"}]]}], 
       SuperscriptBox["|", 
        RowBox[{"-", "p"}]]}], " ", "=", " ", 
      RowBox[{
       SubscriptBox["\[Del]", "x"], "\[VeryThinSpace]", 
       RowBox[{"d", "(", 
        RowBox[{"x", ",", " ", 
         SuperscriptBox["\[Xi]", 
          RowBox[{"(", "i", ")"}]], ",", " ", 
         RowBox[{"p", "/", "2"}]}], ")"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{"p", " ", 
       RowBox[{"(", 
        RowBox[{"x", "-", 
         SuperscriptBox["\[Xi]", 
          RowBox[{"(", "i", ")"}]]}], ")"}], 
       RowBox[{"d", "(", 
        RowBox[{"x", ",", " ", 
         SuperscriptBox["\[Xi]", 
          RowBox[{"(", "i", ")"}]], ",", " ", 
         RowBox[{
          RowBox[{"p", "/", "2"}], "+", "1"}]}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9158070548095284`*^9, 3.9158070564349957`*^9}, {
