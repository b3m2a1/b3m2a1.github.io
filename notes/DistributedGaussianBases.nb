  3.886548887827321*^9}},ExpressionUUID->"9a1090d7-dd28-45af-93c3-\
79c30530a7fe"],

Cell["\<\
which can be used directly with prior code to evaluate local series \
expansions, giving us\
\>", "ExpositoryText",
 CellChangeTimes->{{3.886517979072164*^9, 3.88651798750745*^9}, {
  3.886518034839796*^9, 3.886518090079566*^9}, {3.886520555967927*^9, 
  3.88652055891206*^9}},ExpressionUUID->"07862697-2e3f-44c6-a843-\
f2572043a51d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["S", 
    RowBox[{"i", "\[InvisibleSpace]", "j"}]], " ", "=", " ", 
   RowBox[{
    FractionBox[
     SubsuperscriptBox["S", 
      RowBox[{"i", "\[InvisibleSpace]", "j"}], 
      RowBox[{"(", "0", ")"}]], 
     SqrtBox[
      RowBox[{
       RowBox[{
        StyleBox["n",
         FontWeight->"Bold"], "!"}], "\[VeryThinSpace]", 
       RowBox[{
        StyleBox["m",
         FontWeight->"Bold"], "!"}]}]]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"\[Omega]", "=", "0"}], "\[CapitalOmega]"], " ", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"p", "\[Element]", 
        RowBox[{
         SubscriptBox["P", "E"], "(", "\[Omega]", ")"}]}], 
       "\[InvisibleSpace]"], 
      RowBox[{
       FractionBox["1", 
        RowBox[{
         SqrtBox[
          SuperscriptBox["2", "\[Omega]"]], "\[InvisibleSpace]"}]], 
       SubscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          StyleBox["K",
           FontWeight->"Bold"], "\[Omega]", 
          RowBox[{"(", 
           RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], ")"}], "p"], 
       RowBox[{
        UnderoverscriptBox["\[Product]", 
         RowBox[{"k", "=", "1"}], 
         RowBox[{"3", "\[InvisibleSpace]", "N"}]], " ", 
        RowBox[{
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"(", 
            SubsuperscriptBox["\[Alpha]", "k", 
             RowBox[{"(", 
              RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], ")"}], 
           StyleBox[
            RowBox[{
             SubscriptBox["p", "k"], "/", "2"}],
            FontSize->14]]], 
         RowBox[{
          UnderoverscriptBox["\[Product]", 
           RowBox[{"l", "=", "1"}], 
           RowBox[{
            SubscriptBox["p", "k"], "/", "2"}]], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "\[InvisibleSpace]", "l"}], "-", "1"}], 
           ")"}]}]}]}]}]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.88651826560773*^9, 3.886518325210574*^9}, {
