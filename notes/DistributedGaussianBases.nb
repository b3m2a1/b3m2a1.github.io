      "=", " ", 
      FractionBox["a", 
       RowBox[{"\[LeftBracketingBar]", "a", "\[RightBracketingBar]"}]]}]},
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["\[Del]", "a", 
        RowBox[{"(", "2", ")"}]], 
       RowBox[{"\[LeftBracketingBar]", "a", "\[RightBracketingBar]"}]}], " ", 
      "=", " ", 
