           StyleBox[")",
            FontSize->14]}]}]]}]}]}]},
    {
     RowBox[{"\[AlignmentMarker]", 
      RowBox[{"=", " ", 
       RowBox[{
        SuperscriptBox["2", 
         RowBox[{"d", "/", "2"}]], 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox[
           RowBox[{"\[LeftBracketingBar]", 
            SuperscriptBox["\[CapitalSigma]", 
             RowBox[{"(", "c", ")"}]], "\[RightBracketingBar]"}], 
           RowBox[{"\[LeftBracketingBar]", 
