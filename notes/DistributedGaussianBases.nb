0e9ee7bda6f3"],

Cell["so we get", "ExpositoryText",
 CellChangeTimes->{{3.91617030945251*^9, 
  3.916170311340015*^9}},ExpressionUUID->"9433ed31-92b2-4011-b801-\
68785a03bbed"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "\[Infinity]"}], 
     RowBox[{"\[VeryThinSpace]", "\[Infinity]"}]], 
    RowBox[{
     RowBox[{
      SuperscriptBox["V", 
       RowBox[{"(", "1", ")"}]], "(", 
      RowBox[{"Q", "-", 
       SuperscriptBox["\[Xi]", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], 
     SuperscriptBox["\[CurlyPhi]", 
      RowBox[{"(", "i", ")"}]], 
     SuperscriptBox["\[CurlyPhi]", 
      RowBox[{"*", 
       RowBox[{"(", "j", ")"}]}]]}]}], " ", "=", " ", 
   RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", 
    SubsuperscriptBox["X", "0", 
     RowBox[{"(", 
      RowBox[{"i", ",", "j"}], ")"}]], 
    SubsuperscriptBox["V", "n", 
     RowBox[{"(", "1", ")"}]], 
    SuperscriptBox["\[Rho]", 
