             "}"}], "]"}], "]"}]}], "&"}], "@", 
        RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
         RowBox[{"sortIJKL", "[", 
          RowBox[{"i", ",", " ", "j", ",", " ", "k", ",", " ", "l"}], "]"}], 
         "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", ")"}]}]}], 
