   3.8831243184944553`*^9, 3.883124318496667*^9}, 
   3.883129150956181*^9},ExpressionUUID->"b8ace96a-1d1b-4919-b530-\
1e56b615e6f3"],

Cell["Requires designating a reference point to expand about", "Item",
 CellChangeTimes->{{3.8831242212307873`*^9, 
  3.883124233888556*^9}},ExpressionUUID->"3792e22e-e9ca-4b43-880a-\
3e68b04354ca"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Local Expansions", "Subsubsection",
 CellChangeTimes->{{3.8831242212307873`*^9, 3.8831242804471416`*^9}, {
  3.883124320289752*^9, 
  3.883124345548809*^9}},ExpressionUUID->"1ce3c53b-8bd6-4543-9d24-\
cb4eca318d51"],

Cell["\<\
The local expansion context is largely the same as the Taylor series context, \
except instead of picking one point to expand about, we expand locally around \
every integration point, i.e. we choose\
\>", "ExpositoryText",
 CellChangeTimes->{{3.883129262750042*^9, 3.883129304968569*^9}, {
  3.8831293455676126`*^9, 
  3.883129361343203*^9}},ExpressionUUID->"b1c9ef6a-124d-4d2b-9864-\
ba482ba0bba2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Zeta]", "k"], " ", "=", " ", 
   FractionBox[
    RowBox[{
     RowBox[{
      SubscriptBox["\[Alpha]", "i"], 
      SubsuperscriptBox["\[Xi]", "k", 
       RowBox[{"(", "i", ")"}]]}], "+", 
     RowBox[{
      SubscriptBox["\[Alpha]", "j"], 
      SubsuperscriptBox["\[Xi]", "k", 
       RowBox[{"(", "j", ")"}]]}]}], 
    RowBox[{
     SubscriptBox["\[Alpha]", "i"], "+", 
     SubscriptBox["\[Alpha]", "j"]}]]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.883129362247034*^9, 
  3.883129374550992*^9}},ExpressionUUID->"41c39b3e-1fee-42e5-a14d-\
1bd4a3c3aa0c"],

Cell["which means our final integrals end up as", "ExpositoryText",
 CellChangeTimes->{{3.8831293778408623`*^9, 
  3.883129416703878*^9}},ExpressionUUID->"b774c7a2-affa-43cb-97a0-\
7dd0cb8133d8"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Integral]", 
        SuperscriptBox["\[DoubleStruckCapitalR]", "N"]], 
       RowBox[{
        UnderoverscriptBox["\[Product]", 
         RowBox[{"k", "\[VeryThinSpace]", "=", "\[VeryThinSpace]", "1"}], 
         RowBox[{"3", "\[InvisibleSpace]", "N"}]], " \[AlignmentMarker]", 
        RowBox[{
         RowBox[{"\[Phi]", "(", 
          RowBox[{
           RowBox[{
            SubscriptBox["x", 
             RowBox[{"k", ","}]], 
            FractionBox[
             RowBox[{
              RowBox[{
               SubscriptBox["\[Alpha]", "i"], 
               SubsuperscriptBox["\[Xi]", "k", 
                RowBox[{"(", "i", ")"}]]}], "+", 
              RowBox[{
               SubscriptBox["\[Alpha]", "j"], 
               SubsuperscriptBox["\[Xi]", "k", 
                RowBox[{"(", "j", ")"}]]}]}], 
             RowBox[{
              SubscriptBox["\[Alpha]", "i"], "+", 
              SubscriptBox["\[Alpha]", "j"]}]]}], ",", " ", 
           RowBox[{
            SubscriptBox["\[Alpha]", "i"], "+", 
            SubscriptBox["\[Alpha]", "j"]}]}], ")"}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["x", 
             RowBox[{"\[VeryThinSpace]", "k"}]], "-", 
            SubscriptBox["\[Zeta]", "k"]}], ")"}], 
          SubscriptBox["p", "k"]], 
         RowBox[{"\[DifferentialD]", 
          StyleBox["x",
           FontWeight->"Bold"]}]}]}]}], 
      StyleBox[" ",
       FontWeight->"Bold"], "="}]},
    {
     RowBox[{"\[AlignmentMarker]", 
      RowBox[{
       UnderoverscriptBox["\[Product]", 
        RowBox[{"k", "\[VeryThinSpace]", "=", "\[VeryThinSpace]", "1"}], 
        RowBox[{"3", "\[InvisibleSpace]", "N"}]], " ", 
       RowBox[{"\[Integral]", 
        RowBox[{"\[Phi]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            SubscriptBox["x", 
             RowBox[{"k", ","}]], "0"}], ",", " ", 
           RowBox[{
            SubscriptBox["\[Alpha]", "i"], "+", 
            SubscriptBox["\[Alpha]", "j"]}]}], ")"}], 
         SuperscriptBox[
          SubscriptBox["x", 
           RowBox[{"\[VeryThinSpace]", "k"}]], 
          SubscriptBox["p", "k"]], 
         RowBox[{"\[DifferentialD]", 
          SubscriptBox["x", "k"]}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCenteredManuallyAligned",
 CellChangeTimes->{{3.883128847374857*^9, 3.883128886564599*^9}, {
  3.8831298703773317`*^9, 
  3.8831298797292023`*^9}},ExpressionUUID->"0dac3928-b155-4ba0-82c8-\
e4f036957153"],

Cell["which is easy to integrate", "ExpositoryText",
 CellChangeTimes->{{3.883129435447736*^9, 3.883129460503167*^9}, {
  3.8831298512164097`*^9, 3.883129853916511*^9}, {3.88312988721593*^9, 
  3.883129892102618*^9}},ExpressionUUID->"082e41d9-8d1f-41b9-b223-\
e918fc8c15a8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"baseInt", "=", 
  RowBox[{"Assuming", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"n", "\[Element]", "Integers"}], "&&", 
     RowBox[{"n", ">=", "0"}], "&&", 
     RowBox[{"\[Alpha]", ">", "0"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"DGB", "[", 
         RowBox[{"0", ",", " ", "\[Alpha]"}], "]"}], "[", "x", "]"}], 
       SuperscriptBox["x", "n"]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", 
        RowBox[{"-", "\[Infinity]"}], ",", " ", "\[Infinity]"}], "}"}]}], 
     "]"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.883129495542716*^9, 3.883129544644114*^9}, {
   3.883129835368803*^9, 3.8831298463499327`*^9}, {3.883129896037806*^9, 
   3.8831299016791*^9}, {3.883927536031272*^9, 3.883927539805067*^9}, {
   3.8839418037374372`*^9, 3.883941836054357*^9}, 3.8839438750207243`*^9, {
   3.883957689780484*^9, 3.883957691103827*^9}},
 CellLabel->
  "In[1695]:=",ExpressionUUID->"65bbf53f-445b-4b54-9dfb-1f0126f1d669"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "+", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "n"]}], ")"}], " ", 
   SuperscriptBox["\[Alpha]", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "4"]}], "-", 
     FractionBox["n", "2"]}]], " ", 
   RowBox[{"Gamma", "[", 
    FractionBox[
     RowBox[{"1", "+", "n"}], "2"], "]"}]}], 
  RowBox[{
   SuperscriptBox["2", 
    RowBox[{"3", "/", "4"}]], " ", 
   SuperscriptBox["\[Pi]", 
    RowBox[{"1", "/", "4"}]]}]]], "Output",
 CellChangeTimes->{3.883957693665884*^9},
 CellLabel->
  "Out[1695]=",ExpressionUUID->"e428cd12-a948-4a25-a349-0b3176759691"]
}, Open  ]],

