Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Integral]", "B"], " ", 
       RowBox[{"exp", "(", "\[AlignmentMarker]", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           SuperscriptBox["\[CapitalSigma]", 
            RowBox[{"-", "1"}]], "\[CircleDot]", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"q", "-", "\[Mu]"}], ")"}], "2"]}]}], " ", "+", " ", 
         RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", 
          RowBox[{"p", "\[CenterDot]", "q"}]}]}], ")"}]}], " ", "=", " "}]},
    {
     RowBox[{"\[AlignmentMarker]", 
      RowBox[{
       SubscriptBox["S", "B"], 
       RowBox[{"exp", "(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", "2"]}], 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             SubscriptBox["\[CapitalSigma]", "A"], ")"}], 
            RowBox[{"-", "1"}]], "\[CircleDot]", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["q", "A"], "-", 
              SubscriptBox["\[Mu]", "A"]}], ")"}], "2"]}]}], " ", "+", " ", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"\[DoubleStruckI]", "(", 
            SubscriptBox["\[CapitalSigma]", "A"], ")"}], 
           RowBox[{"-", "1"}]], 
          SubscriptBox[
           RowBox[{"(", 
            RowBox[{"\[CapitalSigma]", "\[InvisibleSpace]", "p"}], ")"}], 
           "A"]}]}], ")"}], 
       RowBox[{"exp", "(", 
        RowBox[{
         FractionBox["1", "2"], "\[VeryThinSpace]", 
         RowBox[{
          RowBox[{"(", 
           SubscriptBox["\[CapitalSigma]", "A"], ")"}], "\[VeryThinSpace]", 
          "\[CircleDot]", 
          SuperscriptBox[
           SubscriptBox[
            RowBox[{"(", 
             RowBox[{"\[CapitalSigma]", "\[VeryThinSpace]", "p"}], ")"}], 
            "A"], "2"]}]}], ")"}], 
       RowBox[{"exp", "(", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox[
           RowBox[{"\[DoubleStruckI]", "(", 
            SubscriptBox["\[CapitalSigma]", "A"], ")"}], 
           RowBox[{"-", "1"}]]}], 
         RowBox[{
          SubscriptBox[
           RowBox[{"(", 
            RowBox[{
            "\[CapitalSigma]", "\[InvisibleSpace]\[InvisibleSpace]", "p"}], 
            ")"}], "A"], "\[CenterDot]", "\[InvisibleSpace]", 
          SubscriptBox["\[Mu]", "A"]}]}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCenteredManuallyAligned",
 CellChangeTimes->{{3.91651982883311*^9, 3.916519845993264*^9}, {
   3.916519893741906*^9, 3.916519952857551*^9}, 3.916520848020708*^9, 
