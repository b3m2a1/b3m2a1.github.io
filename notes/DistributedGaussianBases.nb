  3.91677809918019*^9}},ExpressionUUID->"03fae1c9-a1a2-4ea8-9d9c-\
31af71f00aa7"],

Cell["and the form one obtains by writing", "ExpositoryText",
 CellChangeTimes->{{3.916778104560235*^9, 
  3.9167781326295156`*^9}},ExpressionUUID->"51da3510-f69d-41a3-80e6-\
19a915faacf6"]
