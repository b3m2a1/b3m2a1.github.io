Cell[CellGroupData[{

Cell["Subindices in A Rotated Basis", "Section",
 CellChangeTimes->{{3.885715662139924*^9, 
  3.885715669338593*^9}},ExpressionUUID->"bc44d4df-1e79-4845-a2c9-\
43b592d4e39e"],

Cell[TextData[{
 "Consider two rotated Gaussians with covariances ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalSigma]", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"3f7984c6-30aa-42cd-914b-7ac7c20ec058"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalSigma]", 
    RowBox[{"(", "j", ")"}]], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"62df3157-222d-4d01-8a62-445a6fbf64c8"],
 ". Sometimes we only want to consider some subset of the ",
 StyleBox["rotated",
  FontSlant->"Italic"],
 " coordinates, particularly in the case of removing the effect of rotations \
and translations."
}], "ExpositoryText",
 CellChangeTimes->{{3.885715671860821*^9, 
  3.885715826477138*^9}},ExpressionUUID->"bf6cfb5e-aba2-4431-ad32-\
fdca130c175a"],

Cell["\<\
The issue is that these modes, particularly the rotations, are not constant \
as a function of the Cartesian coordinates.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.885715829103078*^9, 3.8857158509050083`*^9}, {
   3.8857159085233917`*^9, 3.885715946273781*^9}, {3.8857162471131077`*^9, 
   3.8857162587832403`*^9}, 
   3.885717510571787*^9},ExpressionUUID->"3ddcff03-80ba-4907-9ba1-\
28ef54367ec8"],

Cell["Therefore, when we compute ", "ExpositoryText",
 CellChangeTimes->{{3.885715829103078*^9, 3.8857158509050083`*^9}, {
  3.8857159085233917`*^9, 
  3.885715946273781*^9}},ExpressionUUID->"d7d21156-d1a2-4c64-8479-\
31b34bccfd4a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     SuperscriptBox["\[CapitalSigma]", 
      RowBox[{"(", "c", ")"}]], ")"}], 
    RowBox[{"-", "1"}]], " ", "=", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[CapitalSigma]", 
       RowBox[{"(", "i", ")"}]], ")"}], 
     RowBox[{"-", "1"}]], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[CapitalSigma]", 
       RowBox[{"(", "j", ")"}]], ")"}], 
     RowBox[{"-", "1"}]]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.884087132367393*^9, 3.8840871346681356`*^9}, {
  3.884087180380094*^9, 3.884087262975683*^9}, {3.8840873150154552`*^9, 
  3.88408733476435*^9}, {3.884222535689636*^9, 3.884222536445917*^9}, {
  3.885715984526937*^9, 3.885716005492544*^9}, {3.885716066327858*^9, 
  3.885716096829727*^9}},ExpressionUUID->"39262d4d-465e-4b3a-8e00-\
b8eb05c73c6b"],

Cell[TextData[{
 "this can be expressed in the diagonal basis of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalSigma]", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.884087132367393*^9, 3.8840871346681356`*^9}, {
   3.884087180380094*^9, 3.884087262975683*^9}, {3.8840873150154552`*^9, 
   3.88408733476435*^9}, {3.884222535689636*^9, 3.884222536445917*^9}, {
   3.885715984526937*^9, 3.885716005492544*^9}, {3.885716066327858*^9, 
   3.885716096829727*^9}},ExpressionUUID->
  "34c5b9c7-eb42-4602-a7d7-9776184187d9"],
 " as"
}], "ExpositoryText",
