Cell[TextData[{
 "By supplying a full covariance matrix we can use everything developed by \
the statistics community in arbitrary dimensions. Given a covariance matrix \
",
 Cell[BoxData[
  FormBox["\[CapitalSigma]", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "b0edd831-dbe3-4ede-add7-9385dfd16568"],
 ", which will be by default the diagonal matrix with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1", "/", "2"}], "\[InvisibleSpace]\[VeryThinSpace]", 
    SubscriptBox["\[Alpha]", "i"]}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "c637768b-7940-4c8f-96a7-d24a8da0098f"],
 " as its values, we have"
}], "ExpositoryText",
