 SuperscriptBox["\[ExponentialE]", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "2"}], " ", 
    SuperscriptBox["q1", "2"]}], "-", 
   RowBox[{"2", " ", 
    SuperscriptBox["q2", "2"]}], "-", 
   RowBox[{"2", " ", 
    SuperscriptBox["q3", "2"]}]}]]], "Output",
 CellChangeTimes->{3.89930906127556*^9},
