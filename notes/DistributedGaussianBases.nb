Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "x"], 
       RowBox[{"V", "(", "x", ")"}]}], " \[AlignmentMarker]", "=", 
      RowBox[{
       RowBox[{
        UnderscriptBox["\[Sum]", "i"], " ", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[Del]", "x"], 
          RowBox[{"V", "(", 
           RowBox[{"x", ";", " ", 
            SuperscriptBox["\[Xi]", 
             RowBox[{"(", "i", ")"}]]}], ")"}]}], 
         SuperscriptBox["w", 
          RowBox[{"(", "i", ")"}]]}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"V", "(", 
         RowBox[{"x", ";", " ", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", "i", ")"}]]}], ")"}], 
        RowBox[{
         SubscriptBox["\[Del]", "x"], 
         SuperscriptBox["w", 
          RowBox[{"(", "i", ")"}]]}]}]}]}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox["x", "2"]], "V"}], 
       RowBox[{"(", "x", ")"}]}], " \[AlignmentMarker]", "=", " ", 
      RowBox[{
       RowBox[{
        UnderscriptBox["\[Sum]", "i"], " ", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[Del]", 
           SuperscriptBox["x", "2"]], 
          RowBox[{"V", "(", 
           RowBox[{"x", ";", " ", 
            SuperscriptBox["\[Xi]", 
             RowBox[{"(", "i", ")"}]]}], ")"}]}], 
         SuperscriptBox["w", 
