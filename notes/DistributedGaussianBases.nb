  3.907553838905179*^9}},ExpressionUUID->"306eeee0-2a7d-4ac1-a9d6-\
33e6506c1e25"],

Cell["\<\
This is again, not manifestly symmetric, but we\[CloseCurlyQuote]ll consider \
the integration here where since the linear terms vanish we get\
\>", "ExpositoryText",
 CellChangeTimes->{{3.907551878628042*^9, 3.907551897566004*^9}, {
  3.907552349808916*^9, 
  3.907552356785615*^9}},ExpressionUUID->"2a71f020-cc74-4af8-a403-\
05c60c8a74cf"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Integral]", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox[
       RowBox[{"[", 
        RowBox[{
         SubsuperscriptBox["\[CapitalSigma]", "j", 
          RowBox[{"-", "1"}]], 
         SuperscriptBox["L", "T"], "\[InvisibleSpace]", "q"}], "]"}], "n"], 
      "2"], 
     RowBox[{
      SubscriptBox["\[Phi]", "c"], "(", "q", ")"}]}]}], " ", "=", " ", 
   RowBox[{
    SuperscriptBox["S", 
     RowBox[{"(", "c", ")"}]], " ", 
    RowBox[{
     UnderscriptBox["\[Sum]", "k"], " ", 
     FractionBox[
      SubsuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["\[CapitalSigma]", "j", 
          RowBox[{"-", "1"}]], 
         SuperscriptBox["L", "T"]}], ")"}], 
       RowBox[{"n", "\[InvisibleSpace]", "k"}], "2"], 
      RowBox[{"\[InvisibleSpace]\[InvisibleSpace]", 
       SubsuperscriptBox["\[Alpha]", "k", 
        RowBox[{"(", "c", ")"}]]}]]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.886522245056069*^9, 3.88652224599587*^9}, {
   3.886522305210848*^9, 3.8865223063513203`*^9}, {3.886522440836446*^9, 
