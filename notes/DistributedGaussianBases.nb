Cell[CellGroupData[{

Cell["A Note on Polynomial Evaluation", "Section",
 CellChangeTimes->{{3.91403813876624*^9, 3.914038145338339*^9}, 
   3.916345003167485*^9},ExpressionUUID->"577d0ccc-59d2-48d3-b542-\
c99ef887be4c"],

Cell["We often have something like", "ExpositoryText",
 CellChangeTimes->{{3.914038171227118*^9, 
  3.914038174657111*^9}},ExpressionUUID->"fbfe02b8-9ef1-44e8-b6c8-\
95f097179565"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Phi]", "(", 
    RowBox[{"x", ",", " ", 
     SuperscriptBox["\[Xi]", 
      RowBox[{"(", "j", ")"}]], ",", " ", 
     SuperscriptBox["\[CapitalSigma]", 
      RowBox[{"(", "j", ")"}]]}], ")"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"N", "(", 
     SuperscriptBox["\[CapitalSigma]", 
      RowBox[{"(", "j", ")"}]], ")"}], 
    SuperscriptBox["e", 
     RowBox[{
      StyleBox[
       RowBox[{"-", 
        FractionBox["1", "2"]}],
       FontSize->14], 
      RowBox[{
       StyleBox["(",
        FontSize->14], 
       RowBox[{
        SuperscriptBox[
         SuperscriptBox["\[CapitalSigma]", 
          RowBox[{"(", "j", ")"}]], 
         RowBox[{"-", "1"}]], 
        StyleBox["\[CircleDot]",
         FontSize->14], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", 
           StyleBox[
            SuperscriptBox["\[Xi]", 
             RowBox[{"(", "j", ")"}]],
            FontSize->14]}], ")"}], "2"]}], 
       StyleBox[")",
        FontSize->14]}]}]]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.88312577108033*^9, 3.883125840914456*^9}, {
  3.883125964807105*^9, 3.8831259738727627`*^9}, {3.8831261286523533`*^9, 
  3.883126129033146*^9}, {3.8838465712648497`*^9, 3.8838466067583323`*^9}, {
  3.8838527660822697`*^9, 3.883852768950453*^9}, {3.914038198094651*^9, 
  3.9140382203647757`*^9}},ExpressionUUID->"fe39a11e-e4c3-45a1-839a-\
3cb559766ed3"],

Cell[TextData[{
 "that gets modified by some polynomial generator, ",
 Cell[BoxData[
  FormBox["P", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "43f9ab83-6462-4cbe-bd14-fe6c428b300d"],
 ", and then we shift to some center position ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Xi]", 
    RowBox[{"(", "j", ")"}]], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "66c27683-42c5-40d9-a4a8-af026195e819"]
}], "ExpositoryText",
 CellChangeTimes->{{3.914038184323394*^9, 3.914038193031555*^9}, {
  3.914038225161859*^9, 
  3.914038241701457*^9}},ExpressionUUID->"b0bfb3bc-4aa9-43c1-a322-\
8cf32f6eb66a"],

Cell[TextData[{
 "As shifts are the most expensive operation we have to do, it makes sense to \
avoid them altogether by doing one shift by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["\[Xi]", 
      RowBox[{"(", "j", ")"}]], " ", "\[Minus]", " ", 
     SuperscriptBox["\[Xi]", 
      RowBox[{"(", "c", ")"}]]}], ")"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "c3e06af7-a682-4c53-a269-ed95c7441b24"],
 " on the induced polynomial in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalSigma]", 
    RowBox[{"(", "j", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.88312577108033*^9, 3.883125840914456*^9}, {
   3.883125964807105*^9, 3.8831259738727627`*^9}, {3.8831261286523533`*^9, 
   3.883126129033146*^9}, {3.8838465712648497`*^9, 3.8838466067583323`*^9}, {
   3.8838527660822697`*^9, 3.883852768950453*^9}, {3.914038198094651*^9, 
   3.9140382203647757`*^9}},ExpressionUUID->
  "56ac0e75-770b-49b1-8a1f-cf2a3259c694"],
 " and one shift by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Xi]", 
    RowBox[{"(", "c", ")"}]], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"ee8738dd-d40e-452a-abf2-19e72db09d98"],
 " on any necessary generators"
}], "ExpositoryText",
 CellChangeTimes->{{3.914038248265675*^9, 
  3.9140383473664703`*^9}},ExpressionUUID->"45f7ed32-5695-4ab9-9612-\
69ce97ac93fe"]
}, Closed]],

Cell[CellGroupData[{

Cell["A Note on Alpha Choice", "Section",
 CellChangeTimes->{{3.884874735701844*^9, 3.884874739959149*^9}, 
   3.906641887658358*^9},ExpressionUUID->"1c87d192-2c88-4aa3-880d-\
668cfce4a072"],

Cell[TextData[{
 "On a point-by-point basis for local quadratic expansions, assuming a \
diagonal ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalSigma]", 
    RowBox[{"-", "1"}]], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"d77fc5c7-3f58-45f5-8349-812f7fc18133"],
 " matrix with diagonal elements ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubscriptBox["\[Alpha]", "i"]}], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "969a2966-7b5a-432c-997c-d97000f765c6"]
}], "ExpositoryText",
 InitializationCell->True,
 CellChangeTimes->{{3.8848747412402143`*^9, 3.8848747480796337`*^9}, {
  3.884874867749494*^9, 3.88487487242153*^9}, {3.884875000569346*^9, 
  3.8848750529018784`*^9}},ExpressionUUID->"010f18c6-6825-4df8-8550-\
612de21a54e0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"H", "(", 
    SubscriptBox["\[Phi]", "i"], ")"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"V", "(", 
     SuperscriptBox["\[Xi]", 
      RowBox[{"(", "i", ")"}]], ")"}], " ", "+", " ", 
    RowBox[{
     UnderscriptBox["\[Sum]", "k"], "\[VeryThinSpace]", 
     FractionBox[
      SubsuperscriptBox["\[Alpha]", "k", 
       RowBox[{"(", "i", ")"}]], 
      RowBox[{"\[InvisibleSpace]", 
       RowBox[{"2", 
        SubscriptBox["m", "k"]}]}]]}], "+", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"4", 
       SubsuperscriptBox["\[Alpha]", "k", 
        RowBox[{"(", "i", ")"}]]}]], 
     RowBox[{
      FractionBox[
       SuperscriptBox["\[PartialD]", "2"], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox[
         SubscriptBox["x", 
          RowBox[{"\[VeryThinSpace]", "k"}]], "2"]}]], 
      RowBox[{"V", "(", 
       SuperscriptBox["\[Xi]", 
        RowBox[{"(", "i", ")"}]], ")"}]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.884874752305766*^9, 3.8848748906300163`*^9}, {
  3.884874989057259*^9, 3.8848749979504004`*^9}, {3.884875060852047*^9, 
  3.884875167327108*^9}, {3.884876920874744*^9, 
  3.884876921198441*^9}},ExpressionUUID->"3d2db779-3e53-46cd-999d-\
d80f75974e9d"],

Cell[TextData[{
 "and if we want Virial to hold, letting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"V", "(", 
     SuperscriptBox["\[Xi]", 
      RowBox[{"(", "i", ")"}]], ")"}], " ", "=", " ", 
    RowBox[{"0", " ", "+", " ", 
     RowBox[{
      RowBox[{"V", "''"}], 
      RowBox[{"(", 
       SuperscriptBox["\[Xi]", 
        RowBox[{"(", "i", ")"}]], ")"}], 
      SuperscriptBox["x", "2"]}]}]}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "7bfdf716-801b-431a-8c4d-5afcd15edb7e"]
}], "ExpositoryText",
 CellChangeTimes->{{3.884877302984208*^9, 3.884877316687129*^9}, {
  3.884877363926201*^9, 3.8848773682553368`*^9}, {3.907776269117872*^9, 
  3.907776291068862*^9}},ExpressionUUID->"5a1a143d-3ad7-4f9f-bc2b-\
a0e22a1251ad"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    SubsuperscriptBox["\[Alpha]", "k", 
     RowBox[{"(", "i", ")"}]], 
    RowBox[{"\[InvisibleSpace]", 
     RowBox[{"2", 
      SubscriptBox["m", "k"]}]}]], " ", "=", " ", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"8", 
      SubsuperscriptBox["\[Alpha]", "k", 
       RowBox[{"(", "i", ")"}]]}]], 
    RowBox[{
     FractionBox[
      SuperscriptBox["\[PartialD]", "2"], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox[
        SubscriptBox["x", 
         RowBox[{"\[VeryThinSpace]", "k"}]], "2"]}]], 
     RowBox[{"V", "(", 
      SuperscriptBox["\[Xi]", 
       RowBox[{"(", "i", ")"}]], ")"}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.884877319543666*^9, 3.8848773276740847`*^9}, {
  3.884879282039817*^9, 
  3.884879313790805*^9}},ExpressionUUID->"2ce06401-3bf6-436a-9526-\
ecddd2073ec0"],

Cell["and so", "ExpositoryText",
 CellChangeTimes->{{3.884877418117016*^9, 
  3.8848774198045683`*^9}},ExpressionUUID->"a8bdfa54-d14f-4516-b01a-\
92ebd66f2eec"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["\[Alpha]", "k", 
       RowBox[{"(", "i", ")"}]], " ", "=", " ", 
      RowBox[{
       FractionBox["1", "4"], 
       SqrtBox[
        RowBox[{
         SubscriptBox["m", "k"], 
         RowBox[{
          FractionBox[
           SuperscriptBox["\[PartialD]", "2"], 
           RowBox[{"\[PartialD]", 
            SuperscriptBox[
             SubscriptBox["x", 
              RowBox[{"\[VeryThinSpace]", "k"}]], "2"]}]], 
          RowBox[{"V", "(", 
           SuperscriptBox["\[Xi]", 
            RowBox[{"(", "i", ")"}]], ")"}]}]}]]}]}]},
    {
     RowBox[{"=", " ", 
      FractionBox[
       RowBox[{
        SubscriptBox["m", "k"], 
        SubscriptBox["\[Omega]", "k"]}], "4"]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8848774226343613`*^9, 3.8848774627635717`*^9}, {
   3.884879338237639*^9, 3.884879343992581*^9}, 
   3.907777427754571*^9},ExpressionUUID->"83e33de5-ef94-4894-b4c3-\
924732e7c302"],

Cell["or expressed in local modes", "ExpositoryText",
 CellChangeTimes->{{3.9077774333439703`*^9, 
  3.907777437111623*^9}},ExpressionUUID->"5654c310-543f-485b-8185-\
5a73885e2be8"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["\[Alpha]", "k", 
       RowBox[{"(", "i", ")"}]], " ", "=", " ", 
      RowBox[{
       FractionBox["1", "4"], 
       SqrtBox[
        RowBox[{
         FractionBox["1", 
          SubscriptBox["g", 
           RowBox[{"k", "\[InvisibleSpace]", "k"}]]], 
         RowBox[{
          FractionBox[
           SuperscriptBox["\[PartialD]", "2"], 
           RowBox[{"\[PartialD]", 
            SuperscriptBox[
             SubscriptBox["x", 
              RowBox[{"\[VeryThinSpace]", "k"}]], "2"]}]], 
          RowBox[{"V", "(", 
           SuperscriptBox["\[Xi]", 
            RowBox[{"(", "i", ")"}]], ")"}]}]}]]}]}]},
    {
     RowBox[{"=", " ", 
      FractionBox[
       RowBox[{
        SubscriptBox["m", "k"], 
        SubscriptBox["\[Omega]", "k"]}], "4"]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8848774226343613`*^9, 3.8848774627635717`*^9}, {
  3.884879338237639*^9, 3.884879343992581*^9}, {3.907777427754571*^9, 
  3.907777446025475*^9}},ExpressionUUID->"24d3dc0c-a382-4b9c-a689-\
d5225ab41ee3"]
}, Closed]],

Cell[CellGroupData[{

Cell["Evaluation of Properties", "Section",
 CellChangeTimes->{{3.883123631211008*^9, 3.883123634696031*^9}, {
  3.883123974134593*^9, 
  3.88312398028975*^9}},ExpressionUUID->"cec65f5a-c344-4f92-bc83-\
14af5f9525b2"],

Cell["\<\
Our final wavefunctions are expressed as a linear combination of the DGB \
functions\
\>", "Text",
 InitializationCell->True,
 CellChangeTimes->{{3.883123642893393*^9, 3.883123650831029*^9}, {
  3.8831239085358133`*^9, 3.883123964770487*^9}, {3.883130257717201*^9, 
  3.883130263625373*^9}},ExpressionUUID->"d4efc4b2-9083-45b6-8c57-\
82879d713008"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Psi]", "n"], "(", 
    StyleBox["x",
     FontWeight->"Bold"], ")"}], " ", "=", " ", 
   RowBox[{
    UnderscriptBox["\[Sum]", "i"], "\[VeryThinSpace]\[ThinSpace]", 
    RowBox[{
     SubsuperscriptBox["c", "i", 
      RowBox[{"(", "n", ")"}]], "\[VeryThinSpace]", 
     RowBox[{
      SubscriptBox["\[CurlyPhi]", "i"], "(", 
      StyleBox["x",
       FontWeight->"Bold"], ")"}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.883123638630678*^9, 3.883123748444726*^9}, {
  3.883123788266418*^9, 
  3.883123791734668*^9}},ExpressionUUID->"a578b87e-ea18-4b1e-a1a6-\
a9a836f0e23d"],

Cell["\<\
Meaning we can apply the same ideas to evaluating properties that we used for \
integrating the potential.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.883131570485968*^9, 
  3.883131640049367*^9}},ExpressionUUID->"4e50bd2f-f0a8-4d1a-91f7-\
0083757ede72"]
}, Closed]],

Cell[CellGroupData[{

Cell["Projections", "Section",
 CellChangeTimes->{{3.883123631211008*^9, 3.883123634696031*^9}, {
  3.883123974134593*^9, 3.88312398028975*^9}, {3.8831316460139227`*^9, 
  3.883131647585582*^9}},ExpressionUUID->"18f7464c-aab1-4f48-8584-\
2998c0813bfe"],

Cell[CellGroupData[{

Cell["Standard Basis", "Subsection",
 CellChangeTimes->{{3.885332369813163*^9, 
  3.8853323724719257`*^9}},ExpressionUUID->"5ffb91a1-6f7e-47c2-a9cd-\
a5eeebe25c7c"],

Cell["If we want to integrate out a DOF we have", "ExpositoryText",
 CellChangeTimes->{{3.883132058761264*^9, 3.8831320845233707`*^9}, {
  3.883132202588297*^9, 
  3.883132225261589*^9}},ExpressionUUID->"248fda23-2f8b-4516-8e5b-\
f8e65a0d3a4a"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"\[Integral]", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Psi]", "n"], "(", 
         StyleBox["x",
          FontWeight->"Bold"], ")"}], 
        RowBox[{"\[DifferentialD]", 
         SubscriptBox["x", "k"]}]}]}], " ", "=", " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "i"], "\[VeryThinSpace]\[ThinSpace]", 
       RowBox[{
        SubsuperscriptBox["c", "i", 
         RowBox[{"(", "n", ")"}]], "\[VeryThinSpace]", 
        RowBox[{"\[Integral]", 
         RowBox[{
          RowBox[{
           SubscriptBox["\[CurlyPhi]", "i"], "(", 
           StyleBox["x",
            FontWeight->"Bold"], ")"}], 
          RowBox[{"\[DifferentialD]", 
           SubscriptBox["x", "k"]}]}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "i"], "\[VeryThinSpace]\[ThinSpace]", 
       RowBox[{
        SubsuperscriptBox["c", "i", 
         RowBox[{"(", "n", ")"}]], "\[VeryThinSpace]", 
        RowBox[{
         SubscriptBox["\[CurlyPhi]", "i"], "(", 
         StyleBox["y",
          FontWeight->"Bold"], ")"}], 
        RowBox[{"\[Integral]", 
         RowBox[{
          RowBox[{
           SubscriptBox["\[Phi]", "i"], "(", 
           SubscriptBox["x", "k"], ")"}], 
          RowBox[{"\[DifferentialD]", 
           SubscriptBox["x", "k"]}]}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "i"], "\[VeryThinSpace]\[ThinSpace]", 
       RowBox[{
        SqrtBox[
         FractionBox["2", 
          RowBox[{"N", "(", 
           SubscriptBox["\[Alpha]", "i"], ")"}]]], 
        SubsuperscriptBox["c", "i", 
         RowBox[{"(", "n", ")"}]], "\[VeryThinSpace]", 
        RowBox[{
         SubscriptBox["\[CurlyPhi]", "i"], "(", 
         StyleBox["y",
          FontWeight->"Bold"], ")"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8831320963940907`*^9, 3.8831320991663113`*^9}, {
  3.883132226723178*^9, 3.883132366260953*^9}, {3.883132407181263*^9, 
  3.8831324173082438`*^9}, {3.883132463973206*^9, 3.8831324708257637`*^9}, {
  3.883132612999209*^9, 
  3.883132616614336*^9}},ExpressionUUID->"66d2d1ef-5f23-4f2f-87fd-\
db738fb9d953"],

Cell[TextData[{
 "and so if we have ",
 Cell[BoxData[
  FormBox["K", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "122b9527-7146-426f-88bb-ad2c7b4d50e8"],
 " degrees of freedom ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox["k", "m"], "}"}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "4dab1ec9-8ca4-422d-94e0-f98a50423194"],
 "to project out we end up with"
}], "ExpositoryText",
 CellChangeTimes->{{3.883132480886478*^9, 
  3.883132517101365*^9}},ExpressionUUID->"f187e02d-82cf-4a57-a3f3-\
161baa911cd5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Psi]", "n"], "(", 
    StyleBox["y",
     FontWeight->"Bold"], ")"}], " ", "=", " ", 
   RowBox[{
    UnderscriptBox["\[Sum]", "i"], "\[VeryThinSpace]\[ThinSpace]", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SqrtBox[
        FractionBox["2", 
         RowBox[{"N", "(", 
          SubscriptBox["\[Alpha]", "i"], ")"}]]], ")"}], "K"], 
     SubsuperscriptBox["c", "i", 
      RowBox[{"(", "n", ")"}]], "\[VeryThinSpace]", 
     RowBox[{
      SubscriptBox["\[CurlyPhi]", "i"], "(", 
      StyleBox["y",
       FontWeight->"Bold"], ")"}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.883132523437457*^9, 3.8831325955782013`*^9}, {
   3.883132629009839*^9, 3.88313263831211*^9}, 
   3.883148906209465*^9},ExpressionUUID->"951473cb-a3ab-4c5b-884d-\
e31b3e064a94"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Rotated Basis", "Subsection",
 CellChangeTimes->{{3.885332363366255*^9, 
  3.885332365375847*^9}},ExpressionUUID->"9cc954a1-a03d-44c2-b85e-\
e72c33e5394d"],

Cell["\<\
If we want to apply projections in the rotated basis, we still have\
\>", "ExpositoryText",
 CellChangeTimes->{{3.885332377245472*^9, 3.885332427062501*^9}, {
  3.885332478636642*^9, 
  3.885332479875329*^9}},ExpressionUUID->"ab382a00-606b-47f2-bf41-\
a74d19b061e7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Psi]", "n"], "(", 
      StyleBox["x",
       FontWeight->"Bold"], ")"}], 
     RowBox[{"\[DifferentialD]", 
      SubscriptBox["x", "k"]}]}]}], " ", "=", " ", 
   RowBox[{
    UnderscriptBox["\[Sum]", "i"], "\[VeryThinSpace]\[ThinSpace]", 
    RowBox[{
     SubsuperscriptBox["c", "i", 
      RowBox[{"(", "n", ")"}]], "\[VeryThinSpace]", 
     RowBox[{"\[Integral]", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[CurlyPhi]", "i"], "(", 
        StyleBox["x",
         FontWeight->"Bold"], ")"}], 
       RowBox[{"\[DifferentialD]", 
        SubscriptBox["x", "k"]}]}]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8853324660342693`*^9, 
  3.88533247721593*^9}},ExpressionUUID->"72234d08-1db7-4d5b-8981-\
969b8cdc612c"],

Cell["but now", "ExpositoryText",
 CellChangeTimes->{{3.8853324829888487`*^9, 
  3.885332501754326*^9}},ExpressionUUID->"3c2487e5-20d5-4e4e-b961-\
20fcd7384e7d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CurlyPhi]", "i"], "(", 
    StyleBox["x",
     FontWeight->"Bold"], ")"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"\[Phi]", "(", 
     RowBox[{"x", ",", " ", 
      SuperscriptBox["\[Xi]", 
       RowBox[{"(", "i", ")"}]], ",", " ", 
      SuperscriptBox["\[CapitalSigma]", 
       RowBox[{"(", "i", ")"}]]}], ")"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"N", "(", 
      SuperscriptBox["\[CapitalSigma]", 
       RowBox[{"(", "i", ")"}]], ")"}], 
     SuperscriptBox["e", 
      RowBox[{
       StyleBox[
        RowBox[{"-", 
         FractionBox["1", "2"]}],
        FontSize->14], 
       RowBox[{
        StyleBox["(",
         FontSize->14], 
        RowBox[{
         StyleBox[
          SuperscriptBox["\[CapitalSigma]", 
           RowBox[{"-", "1"}]],
          FontSize->14], 
         StyleBox["\[CircleDot]",
          FontSize->14], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "-", 
            SuperscriptBox["\[Xi]", 
             RowBox[{"(", "i", ")"}]]}], ")"}], "2"]}], 
        StyleBox[")",
         FontSize->14]}]}]]}]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.88312577108033*^9, 3.883125840914456*^9}, {
  3.883125964807105*^9, 3.8831259738727627`*^9}, {3.8831261286523533`*^9, 
  3.883126129033146*^9}, {3.8838465712648497`*^9, 3.8838466067583323`*^9}, {
  3.8838527660822697`*^9, 3.883852768950453*^9}, {3.885332505296574*^9, 
  3.885332527014564*^9}},ExpressionUUID->"2663c83d-7b1e-4856-9052-\
76ef76e6e7ba"],

Cell[TextData[{
 "But here we can once again take a page from probability people and note \
that integrating out some set of degrees of freedom is called taking the ",
 StyleBox["marginal",
  FontSlant->"Italic"],
 " probability distribution, and it\[CloseCurlyQuote]s well known in that \
community that if we have a projected space ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "e8c59bf1-0214-43be-94e4-63d9b4b900d6"],
 " and its complement ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "8362ecf5-8618-47d5-906e-25b8dd7f2f07"]
}], "ExpositoryText",
 CellChangeTimes->{{3.885340307379779*^9, 3.88534038099459*^9}, 
   3.916431878490491*^9},ExpressionUUID->"2197ecd5-af98-4249-8004-\
447c20efb7fc"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["\[CapitalSigma]", "new"], " ", "=", " ", 
      SubscriptBox["\[CapitalSigma]", "A"]}]},
    {
     RowBox[{
      SubsuperscriptBox["\[Xi]", "new", 
       RowBox[{"(", "i", ")"}]], " ", "=", " ", 
      SubsuperscriptBox["\[Xi]", "A", 
       RowBox[{"(", "i", ")"}]]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.885340382773061*^9, 3.8853404521791563`*^9}, {
  3.885340633770352*^9, 
  3.885340636360486*^9}},ExpressionUUID->"a1688e2b-e6cd-4bcd-b142-\
a3dc1685c59c"],

Cell["\<\
where we just get to throw out all the extraneous info. Admittedly we do need \
to scale our values a bit, since the normalization of the marginal Gaussian \
is different from the normalization of the full Gaussian.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.885340454450553*^9, 3.885340482663474*^9}, {
  3.885340640975256*^9, 
  3.885340703446744*^9}},ExpressionUUID->"004b2bb2-570f-4a9c-829e-\
f7db2eda02a2"],

Cell[TextData[{
 "The bigger problem of course is that we really want ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[CapitalSigma]", "A"], 
    RowBox[{"-", "1"}]], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"adfc5509-df8c-4dfb-9b2f-9ab9249d7381"],
 " for how we evaluate these things, and in particular we want the \
eigensystem of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[CapitalSigma]", "A"], 
    RowBox[{"-", "1"}]], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"766c5a01-5935-4e5a-9348-09796c4eea5c"],
 ". Unfortunately that\[CloseCurlyQuote]s not trivial to compute, so we\
\[CloseCurlyQuote]ll construct"
}], "ExpositoryText",
 CellChangeTimes->{{3.8853405141085043`*^9, 3.8853405677872543`*^9}, {
  3.885340706762259*^9, 3.88534071221384*^9}, {3.885340995925847*^9, 
  3.885341006325075*^9}, {3.885342178069149*^9, 
  3.885342190739863*^9}},ExpressionUUID->"9b8e88f2-34d6-4d78-bbc4-\
48bdf74496c8"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[CapitalSigma]", " ", "=", " ", 
   RowBox[{
    SuperscriptBox["L", "T"], "\[CapitalLambda]", "\[VeryThinSpace]\[InvisibleSpace]",
     "L"}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.885340588563539*^9, 3.885340609118886*^9}, {
  3.885340966165448*^9, 3.885340968901072*^9}, {3.885341014872484*^9, 
  3.885341021702709*^9}},ExpressionUUID->"eed6504a-ada6-4e17-94fa-\
21f0ba9e705a"],

Cell[TextData[{
 "and then diagonalize ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalSigma]", "A"], TraditionalForm]],
  CellChangeTimes->{{3.885340382773061*^9, 3.8853404521791563`*^9}, {
   3.885340633770352*^9, 3.885340636360486*^9}},ExpressionUUID->
  "40e30909-aed5-44c3-b8fc-663fdbf7919f"],
 " as the same eigensystem (mostly) works"
}], "ExpositoryText",
 CellChangeTimes->{{3.885342193206263*^9, 
  3.8853422179479713`*^9}},ExpressionUUID->"683f9299-1d95-4920-80b1-\
c1a2cb7bebf6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Complex Phase", "Subsection",
 CellChangeTimes->{{3.9164316705236464`*^9, 
  3.916431673404797*^9}},ExpressionUUID->"e40c6530-6b84-48f8-a64b-\
e340636fc0f6"],

Cell["\<\
To handle projections with a complex phase, we note that we start with a \
function of the form\
\>", "ExpositoryText",
 CellChangeTimes->{{3.91643167527558*^9, 
  3.916431712188178*^9}},ExpressionUUID->"426e50ed-34ce-4849-b5b9-\
e49b0ff7e0be"],

Cell[BoxData[
 FormBox[
  RowBox[{"exp", "(", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], 
     RowBox[{
      SuperscriptBox["\[CapitalSigma]", 
       RowBox[{"-", "1"}]], "\[CircleDot]", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"q", "-", "\[Mu]"}], ")"}], "2"]}]}], " ", "+", " ", 
    RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", 
     RowBox[{"p", "\[CenterDot]", "q"}]}]}], ")"}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916431692494286*^9, 3.916431694553788*^9}, 
   3.916431725284355*^9, {3.91643183651202*^9, 3.916431856466525*^9}, {
   3.916431906279518*^9, 3.9164319212142773`*^9}, {3.916432026889991*^9, 
   3.916432027436749*^9}, {3.916518911342766*^9, 
   3.916518912417766*^9}},ExpressionUUID->"65f10272-ea74-4f3c-a69b-\
5013f2d3afd8"],

Cell["\<\
and since we can easily do projections with a proper quadratic form we\
\[CloseCurlyQuote]ll note that\
\>", "ExpositoryText",
 CellChangeTimes->{{3.9164318582961187`*^9, 3.9164318646677923`*^9}, {
  3.9164319230574303`*^9, 3.916431931148498*^9}, {3.9164320104850616`*^9, 
  3.9164320113574343`*^9}},ExpressionUUID->"5053dac3-85a0-4204-b776-\
29944b566214"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", "2"]}], 
        RowBox[{
         SuperscriptBox["\[CapitalSigma]", 
          RowBox[{"-", "1"}]], "\[CircleDot]", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"q", "-", "\[Mu]"}], ")"}], "2"]}]}], " ", "+", " ", 
       RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", 
        RowBox[{"p", "\[CenterDot]", "q"}]}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{".", 
         RowBox[{"-", 
          FractionBox["1", "2"]}]}], 
        RowBox[{
         SuperscriptBox["\[CapitalSigma]", 
          RowBox[{"-", "1"}]], "\[CircleDot]", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"q", "-", "\[Mu]"}], ")"}], "2"]}]}], " ", "+", " ", 
       RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", 
        RowBox[{"p", "\[CenterDot]", 
         RowBox[{"(", 
          RowBox[{"q", "-", "\[Mu]"}], ")"}]}]}], " ", "+", " ", 
       RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", 
        RowBox[{"p", "\[CenterDot]", "\[Mu]"}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", "2"]}], 
        RowBox[{
         SuperscriptBox["\[CapitalSigma]", 
          RowBox[{"-", "1"}]], "\[CircleDot]", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"q", "-", 
            RowBox[{"(", 
             RowBox[{"\[Mu]", "+", 
              RowBox[{
              "\[DoubleStruckI]", "\[VeryThinSpace]", "\[CapitalSigma]", 
               "\[VeryThinSpace]", "p"}]}], ")"}]}], ")"}], "2"]}]}], " ", 
       "-", " ", 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"\[CapitalSigma]", "\[CircleDot]", "\[VeryThinSpace]", 
         SuperscriptBox["p", "2"]}]}], " ", "+", " ", 
       RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", 
        RowBox[{"p", "\[CenterDot]", "\[Mu]"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916432015874392*^9, 3.916432061723855*^9}, {
   3.916432182908718*^9, 3.916432185515457*^9}, {3.916432551099309*^9, 
   3.91643256231568*^9}, {3.916518917879455*^9, 3.916518950447534*^9}, {
   3.916519000581334*^9, 3.9165190020918694`*^9}, {3.916519046107342*^9, 
   3.9165190923398533`*^9}, 
   3.916520844453731*^9},ExpressionUUID->"2af76ae0-1573-486c-9aa2-\
1dd9146d4557"],

Cell["\<\
which is of course the source of the prefactors we see in the integrals\
\>", "ExpositoryText",
 CellChangeTimes->{{3.916519120597134*^9, 
  3.916519143781437*^9}},ExpressionUUID->"9591e464-b53d-480f-8c14-\
174705cf708e"],

Cell["\<\
Then we can integrate d.o.fs out from this like a normal Gaussian because of \
the surprising fact that Gaussian integrals are independent of the mean being \
complex (this can be seen by taking limits of contour integrals that converge \
to the real line), giving us\
\>", "ExpositoryText",
 CellChangeTimes->{{3.916432063544629*^9, 3.916432160805175*^9}, {
  3.916519145400215*^9, 3.916519157284277*^9}, {3.916519821294001*^9, 
  3.916519822463621*^9}},ExpressionUUID->"93d628d7-e84e-4eb7-a010-\
05cf3db5fa29"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Integral]", "B"], " ", 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{
        SuperscriptBox["\[CapitalSigma]", 
         RowBox[{"-", "1"}]], "\[CircleDot]", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"q", "-", "\[Mu]"}], ")"}], "2"]}]}], " ", "+", " ", 
      RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", 
       RowBox[{"p", "\[CenterDot]", "q"}]}]}], ")"}]}], " ", "=", " ", 
   RowBox[{
    SubscriptBox["S", "B"], 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SubscriptBox["\[CapitalSigma]", "A"], ")"}], 
        RowBox[{"-", "1"}]], "\[CircleDot]", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["q", "A"], "-", 
          SubscriptBox[
           RowBox[{"(", 
            RowBox[{"\[Mu]", "+", 
             RowBox[{
             "\[DoubleStruckI]", "\[VeryThinSpace]", "\[CapitalSigma]", 
              "\[VeryThinSpace]", "p"}]}], ")"}], "A"]}], ")"}], "2"]}]}], 
     ")"}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.91651982883311*^9, 3.916519845993264*^9}, {
   3.916519893741906*^9, 3.916519952857551*^9}, 3.916520848020708*^9, 
   3.916521096030016*^9},ExpressionUUID->"7fb0b357-a3db-4271-806d-\
ca4feed96859"],

Cell["where", "ExpositoryText",
 CellChangeTimes->{{3.91643232298428*^9, 
  3.9164323233983097`*^9}},ExpressionUUID->"0a76d77a-8c0d-48bd-bf98-\
400b0c780302"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["S", "B"], " ", "=", " ", 
   RowBox[{
    SqrtBox[
     RowBox[{
      SuperscriptBox["\[Pi]", "d"], 
      RowBox[{
      "\[LeftBracketingBar]", "\[CapitalSigma]", "\[RightBracketingBar]"}]}]], 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], 
      RowBox[{"\[CapitalSigma]", "\[CircleDot]", "\[VeryThinSpace]", 
       SuperscriptBox["p", "2"]}]}], ")"}], 
    RowBox[{"exp", "(", 
     RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", 
      RowBox[{"p", "\[CenterDot]", "\[Mu]"}]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.91643232456713*^9, 3.916432330728736*^9}, {
   3.916432398452396*^9, 3.916432403142029*^9}, {3.916432441985182*^9, 
   3.9164324512412987`*^9}, {3.916432570127709*^9, 3.916432577957636*^9}, {
   3.916519184006467*^9, 3.9165191864769697`*^9}, 
   3.916519850993863*^9},ExpressionUUID->"d7830039-dbcb-4446-a739-\
6b330bd85e2a"],

Cell[TextData[{
 "is the standard norm contribution in ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "280e2c03-4065-4140-80e5-b456ea0df94f"],
 " space"
}], "ExpositoryText",
