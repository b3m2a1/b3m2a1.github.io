  3.8865447978091784`*^9}},ExpressionUUID->"b18dee20-e6bb-4168-af17-\
46007136bd03"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["P", "n", 
     RowBox[{"(", "i", ")"}]], "(", "x", ")"}], " ", "=", " ", 
   RowBox[{
    FractionBox["1", 
     SqrtBox[
      RowBox[{"n", "!"}]]], 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["P",
       FontWeight->"Bold"], "n", 
      RowBox[{"(", "i", ")"}]], "\[CircleDot]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"x", 
        StyleBox["\[VeryThinSpace] ",
         FontSize->14], 
        StyleBox["-",
         FontSize->14], 
        StyleBox[" ",
         FontSize->14], 
        SuperscriptBox["\[Xi]", 
         RowBox[{"(", 
          RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]]}], ")"}], 
      StyleBox["n",
       FontWeight->"Bold"]]}]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.886544528391317*^9, 3.88654456921605*^9}, {
