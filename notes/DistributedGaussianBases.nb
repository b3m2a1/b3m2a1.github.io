Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"phaseGauss", "[", 
    RowBox[{"a_", ",", " ", "p_", ",", " ", "c_"}], "]"}], "[", "q_", "]"}], ":=",
   "\[IndentingNewLine]", 
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "a"}], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"q", "-", "c"}], ")"}], "2"]}], " ", "+", " ", 
    RowBox[{"I", " ", "p", " ", 
     RowBox[{"(", "q", ")"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.916084666569005*^9, 
  3.916084687714526*^9}},ExpressionUUID->"5f33ccb7-fb68-4b66-bb6f-\
0507a9cf3d86"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"phaseGauss", "[", 
      RowBox[{"a1", ",", " ", "p1", ",", " ", "c1"}], "]"}], "[", "q", "]"}], 
    ")"}], "*", "\[IndentingNewLine]", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"phaseGauss", "[", 
       RowBox[{"a2", ",", " ", "p2", ",", " ", "c2"}], "]"}], "[", "q", "]"}],
      ",", " ", 
     RowBox[{"{", 
      RowBox[{"q", ",", " ", "2"}], "}"}]}], "]"}]}], "//", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.9160854334258337`*^9, 3.916085494921029*^9}, {
  3.916085694513846*^9, 3.9160857593115873`*^9}},
