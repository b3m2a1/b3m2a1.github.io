Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{"\[CapitalSigma]", " ", "=", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["\[CapitalSigma]", 
           RowBox[{
            RowBox[{"(", "i", ")"}], "-", "1"}]], " ", "+", " ", 
          SuperscriptBox["\[CapitalSigma]", 
           RowBox[{
            RowBox[{"(", "j", ")"}], "-", "1"}]]}], ")"}], 
        RowBox[{"-", "1"}]], " ", "\[TildeEqual]", " ", 
       RowBox[{
        FractionBox["1", "2"], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[Alpha]", "i"], "+", 
           SubscriptBox["\[Alpha]", "j"]}], ")"}], 
         RowBox[{"-", "1"}]]}]}]}]},
    {
     RowBox[{
      SuperscriptBox["\[CapitalSigma]", "+"], " ", "=", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["\[CapitalSigma]", 
           RowBox[{"(", "i", ")"}]], " ", "+", " ", 
          SuperscriptBox["\[CapitalSigma]", 
           RowBox[{"(", "j", ")"}]]}], ")"}], 
        RowBox[{"-", "1"}]], " ", "\[TildeEqual]", " ", 
       RowBox[{"2", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           FractionBox["1", 
            SubscriptBox["\[Alpha]", "i"]], "+", 
           FractionBox["1", 
            SubscriptBox["\[Alpha]", "j"]]}], ")"}], 
         RowBox[{"-", "1"}]]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916802572297854*^9, 
  3.916802687311829*^9}},ExpressionUUID->"c213a827-e526-4b24-86e5-\
2d4b8ad7b691"]
}, Closed]],

