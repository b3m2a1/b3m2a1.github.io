   3.8839585346083*^9}},ExpressionUUID->"cff6c21e-f60a-456d-9fbb-\
bda6b0f6041f"],

Cell[TextData[{
 "Then expanding back out we get (for entirely even ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "k"], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"8023b7be-534e-407d-9dbe-5fb85402593b"],
 " w/ ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Sum]", 
      RowBox[{"\[VeryThinSpace]", "k"}]], 
     SubscriptBox["p", "k"]}], " ", "=", " ", "m"}], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "76274b2d-1fd4-4649-b584-0db78fd17a4b"],
 ")"
}], "ExpositoryText",
 CellChangeTimes->{{3.8839297324101048`*^9, 3.883929736141737*^9}, {
  3.883930145426498*^9, 3.883930151451364*^9}, {3.883941311676609*^9, 
  3.883941349630024*^9}},ExpressionUUID->"d956f5ce-9ee8-4fce-b157-\
f3135e77b98a"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Integral]", 
        SuperscriptBox["\[DoubleStruckCapitalR]", "N"]], 
       RowBox[{
        UnderoverscriptBox["\[Product]", 
         RowBox[{"k", "\[VeryThinSpace]", "=", "\[VeryThinSpace]", "1"}], 
         RowBox[{"3", "\[InvisibleSpace]", "N"}]], " ", 
        RowBox[{
         RowBox[{"\[Phi]", "(", 
          RowBox[{
           RowBox[{
            SubscriptBox["x", 
             RowBox[{"k", ","}]], "0"}], ",", " ", 
           RowBox[{
            SubscriptBox["\[Alpha]", "i"], "+", 
            SubscriptBox["\[Alpha]", "j"]}]}], ")"}], 
         SuperscriptBox[
          SubscriptBox["x", 
           RowBox[{"\[VeryThinSpace]", "k"}]], 
          SubscriptBox["p", "k"]]}]}]}], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Product]", 
        RowBox[{"k", "\[VeryThinSpace]", "=", "\[VeryThinSpace]", "1"}], 
        RowBox[{"3", "\[InvisibleSpace]", "N"}]], "\[VeryThinSpace]", 
       RowBox[{
        FractionBox[
         SubsuperscriptBox["S", 
          RowBox[{"i", "\[InvisibleSpace]", "j"}], 
          RowBox[{"(", "k", ")"}]], 
         SqrtBox[
          RowBox[{
           SuperscriptBox["2", 
            StyleBox[
             SubscriptBox["p", "k"],
             FontSize->14]], 
           SuperscriptBox[
            SubscriptBox[
             RowBox[{"(", 
              RowBox[{
               SubscriptBox["\[Alpha]", "i"], "+", 
               SubscriptBox["\[Alpha]", "j"]}], ")"}], "k"], 
            StyleBox[
             SubscriptBox["p", "k"],
             FontSize->14]]}]]], 
        RowBox[{
         UnderoverscriptBox["\[Product]", 
          RowBox[{"l", "=", "1"}], 
          RowBox[{
           SubscriptBox["p", "k"], "/", "2"}]], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "\[InvisibleSpace]", "l"}], "-", "1"}], ")"}]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       FractionBox[
        SubscriptBox["S", 
         RowBox[{"i", "\[InvisibleSpace]", "j"}]], 
        SqrtBox[
         SuperscriptBox["2", "m"]]], " ", 
       RowBox[{
        UnderoverscriptBox["\[Product]", 
