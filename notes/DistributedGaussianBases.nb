Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sortIJKL", "[", 
    RowBox[{"i_", ",", "j_", ",", "k_", ",", "l_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"counts", "=", 
       RowBox[{"Counts", "[", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "j", ",", " ", "k", ",", " ", "l"}], "}"}], 
        "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Map", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"SortBy", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"counts", "[", "#", "]"}], ",", " ", "#"}], "}"}], "&"}], 
        "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Sort", "@", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sort", "[", 
           RowBox[{"{", 
            RowBox[{"i", ",", "j"}], "}"}], "]"}], ",", 
          RowBox[{"Sort", "@", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", "l"}], "}"}]}]}], "}"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"watsonZeta2", "[", 
