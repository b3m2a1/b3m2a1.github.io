  "A", "\[CircleTimes]", "B", "\[CircleTimes]", "C", "\[CircleTimes]", "D"}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.914122076062728*^9, 
  3.914122110202471*^9}},ExpressionUUID->"b725ddb8-3c7c-43cd-a520-\
b94f632a7e9e"],

Cell["we can cancel anything of the form", "ExpositoryText",
 CellChangeTimes->{{3.914122126888688*^9, 
  3.91412213207887*^9}},ExpressionUUID->"97ac17e5-b8b2-491d-b568-\
120625d10080"],

Cell[BoxData[
 FormBox[
  RowBox[{
  "A", "\[CircleTimes]", "B", "\[CircleTimes]", "D", "\[CircleTimes]", "C"}], 
