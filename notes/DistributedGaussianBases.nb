50b17526e89c"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", 
     StyleBox["n",
      FontWeight->"Bold"]], "(", "x", ")"}], TraditionalForm]],
  CellChangeTimes->{{3.88312577108033*^9, 3.883125840914456*^9}, {
   3.883125964807105*^9, 3.8831259738727627`*^9}, {3.8831261286523533`*^9, 
   3.883126129033146*^9}, {3.8838465712648497`*^9, 3.8838466067583323`*^9}, {
   3.8838527660822697`*^9, 3.883852768950453*^9}, {3.895337017287459*^9, 
   3.895337060141142*^9}},ExpressionUUID->
  "4baa8faf-8251-4703-baa4-aa7081e82950"],
 " are polynomial coefficients in ",
 Cell[BoxData[
  FormBox["q", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "b0ee4f55-0ce5-4eb7-89f2-e1a864092ae6"],
 "-basis, defined as the basis that diagonalizes \[CapitalSigma], which we \
will then choose to express in the Cartesian basis through the inverse \
transformation....which works ",
 StyleBox["even though",
  FontSlant->"Italic"],
 " that inverse isn\[CloseCurlyQuote]t formally well-defined because we will \
never have any coefficient along one of the 6 translation/rotation coordinates"
}], "ExpositoryText",
 CellChangeTimes->{{3.895337052433563*^9, 3.8953371025416527`*^9}, {
  3.895338176674185*^9, 3.895338176939128*^9}, {3.895338306803738*^9, 
  3.895338407550473*^9}, {3.895339970713991*^9, 
  3.8953399707140827`*^9}},ExpressionUUID->"f4eb5b3e-c2f0-4917-9097-\
d77157e2aed0"],

Cell[CellGroupData[{

Cell["Products and Overlaps", "Subsection",
 CellChangeTimes->{{3.8953382940899982`*^9, 3.8953382976955547`*^9}, {
  3.895865531480253*^9, 
  3.895865533386243*^9}},ExpressionUUID->"12fc63cc-af3a-4c7b-8639-\
d23e71239ff4"],

Cell["A product of two augmented DGBs, ", "ExpositoryText",
 CellChangeTimes->{{3.895338299673964*^9, 3.895338302896154*^9}, {
  3.8953398937961187`*^9, 
  3.895339915263939*^9}},ExpressionUUID->"1603ce08-e95c-4bbf-9f83-\
f6268983a32d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox["\[CurlyPhi]", 
      RowBox[{"(", "1", ")"}]], "(", "x", ")"}], 
    RowBox[{
     SuperscriptBox["\[CurlyPhi]", 
      RowBox[{"(", "2", ")"}]], "(", "x", ")"}]}], "=", " ", 
   RowBox[{
    RowBox[{
     SubscriptBox["P", 
      SuperscriptBox["n", 
       RowBox[{"(", "1", ")"}]]], "(", "x", ")"}], 
    RowBox[{
     SubscriptBox["P", 
      SuperscriptBox["n", 
       RowBox[{"(", "2", ")"}]]], "(", "x", ")"}], 
    RowBox[{"\[Phi]", "(", 
     RowBox[{"x", ",", " ", 
      SuperscriptBox["\[Xi]", 
       RowBox[{"(", "1", ")"}]], ",", " ", 
      SuperscriptBox["\[CapitalSigma]", 
       RowBox[{"(", "1", ")"}]]}], ")"}], 
    RowBox[{"\[Phi]", "(", 
     RowBox[{"x", ",", " ", 
      SuperscriptBox["\[Xi]", 
       RowBox[{"(", "2", ")"}]], ",", " ", 
      SuperscriptBox["\[CapitalSigma]", 
       RowBox[{"(", "2", ")"}]]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.895339918867917*^9, 3.895339952724946*^9}, {
  3.895340001381736*^9, 3.895340014970666*^9}, {3.895340056560666*^9, 
  3.8953400892177353`*^9}},ExpressionUUID->"6d6ef244-3fea-4a77-a9bd-\
89e758d80058"],

Cell["is simple-enough to implement given that we can multiply", \
"ExpositoryText",
 CellChangeTimes->{{3.8953399546955433`*^9, 
  3.895339990603393*^9}},ExpressionUUID->"b897096b-68e3-42ba-86bb-\
af8dafde25e5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", 
     SuperscriptBox["n", 
      RowBox[{"(", "c", ")"}]]], "(", "x", ")"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["P", 
       SuperscriptBox["n", 
        RowBox[{"(", "1", ")"}]]], 
      SubscriptBox["P", 
       SuperscriptBox["n", 
        RowBox[{"(", "2", ")"}]]]}], ")"}], 
    RowBox[{"(", "x", ")"}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.895339993668169*^9, 
  3.8953400174918528`*^9}},ExpressionUUID->"33b1ede0-dab8-4714-993d-\
853946f091d5"],

Cell["through a convolution", "ExpositoryText",
 CellChangeTimes->{{3.895340019718672*^9, 
  3.895340022520523*^9}},ExpressionUUID->"b1b514f7-b2fe-4429-bb54-\
e0a0771d4f7f"],

Cell["\<\
The overlap can be obtained by then just integrating like a potential\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8958655362349863`*^9, 
  3.895865568303577*^9}},ExpressionUUID->"e1f03016-b2d0-4ba6-b255-\
6113cf3a9b20"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Shifts", "Subsection",
 CellChangeTimes->{{3.886695761631825*^9, 
  3.886695762880357*^9}},ExpressionUUID->"cfee4ab3-82fe-434f-942b-\
a37d016823a9"],

Cell["\<\
DEPENDING ON CONTEXT, CONVOLUTION-BASED ALGORITHMS MAY WORK BETTER\
\>", "Text",
 CellChangeTimes->{{3.89533820601095*^9, 3.895338219663946*^9}, {
  3.9139974258016*^9, 
  3.913997445702375*^9}},ExpressionUUID->"0929d097-3984-4997-9686-\
59fbc0123736"],

Cell[CellGroupData[{

Cell["Direct", "Subsubsection",
 CellChangeTimes->{{3.9139973820221157`*^9, 3.91399738580541*^9}, {
   3.9139974191061773`*^9, 3.913997419937098*^9}, 
   3.922962177409213*^9},ExpressionUUID->"f2ae036e-7483-464b-ab0b-\
30dfc37c41f8"],

Cell[TextData[{
 "To change the expansion point to a point ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", " ", "+", " ", "\[Delta]"}], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "340ee7ed-200f-4dff-995b-90279bf61545"],
 ", we will write"
}], "ExpositoryText",
 CellChangeTimes->{{3.886695765652861*^9, 3.886695771688971*^9}, {
  3.887203709751994*^9, 3.887203747675256*^9}, {3.8872038248845387`*^9, 
  3.88720386718861*^9}},ExpressionUUID->"7c8a9c8d-2b9d-47b8-a50b-\
f094d4502f7f"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "n"], "(", "x", ")"}], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Omega]", "=", "0"}], "n"], 
       "\[VeryThinSpace]\[VeryThinSpace]", 
       RowBox[{
        SuperscriptBox["K", 
         RowBox[{"(", "\[Omega]", ")"}]], "\[CircleDot]", 
        SuperscriptBox["x", 
         RowBox[{"(", "\[Omega]", ")"}]]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Omega]", "=", "0"}], "n"], 
       "\[VeryThinSpace]\[VeryThinSpace]", 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"p", "\[Element]", 
          RowBox[{"P", "(", "\[Omega]", ")"}]}]], 
        "\[VeryThinSpace]\[VeryThinSpace]", 
        RowBox[{
         SubscriptBox[
          RowBox[{"(", 
           SuperscriptBox["K", 
            RowBox[{"(", "\[Omega]", ")"}]], ")"}], "p"], 
         RowBox[{
          UnderscriptBox["\[Product]", "k"], 
          "\[VeryThinSpace]\[VeryThinSpace]", 
          SubsuperscriptBox["x", "k", 
           SubscriptBox["p", "k"]]}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Omega]", "=", "0"}], "n"], 
       "\[VeryThinSpace]\[VeryThinSpace]", 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"p", "\[Element]", 
          RowBox[{"P", "(", "\[Omega]", ")"}]}]], 
        "\[VeryThinSpace]\[VeryThinSpace]", 
        RowBox[{
         SubscriptBox[
          RowBox[{"(", 
           SuperscriptBox["K", 
            RowBox[{"(", "\[Omega]", ")"}]], ")"}], "p"], 
         RowBox[{
          UnderscriptBox["\[Product]", "k"], 
          "\[VeryThinSpace]\[VeryThinSpace]", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             SubscriptBox["x", "k"], "+", 
             SubscriptBox["\[Delta]", "k"], "-", 
             SubscriptBox["\[Delta]", "k"]}], ")"}], 
           SubscriptBox["p", "k"]]}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.886695157409348*^9, 3.886695207702034*^9}, 
   3.8866952455639677`*^9, {3.886695775656103*^9, 3.886695787644288*^9}, {
   3.886695844734208*^9, 3.886695854226121*^9}, {3.887203565868725*^9, 
   3.88720364503086*^9}, {3.887203752665262*^9, 3.887203753026288*^9}, {
   3.8872037900759974`*^9, 3.8872038168672113`*^9}, {3.8872038717803993`*^9, 
   3.887203874185627*^9}},ExpressionUUID->"4c213180-56b8-4962-9266-\
dc97c97ee973"],

Cell["and then by binomial properties we can write", "ExpositoryText",
 CellChangeTimes->{{3.8872038794718533`*^9, 
  3.8872038862961693`*^9}},ExpressionUUID->"3b9cb252-1e49-4f2e-95b8-\
88db0b5de49e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["x", "k"], "+", 
      SubscriptBox["\[Delta]", "k"], "-", 
      SubscriptBox["\[Delta]", "k"]}], ")"}], 
    SubscriptBox["p", "k"]], " ", "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"j", "=", "0"}], 
     SubscriptBox["p", "k"]], " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{
       SubscriptBox["p", "k"], "-", "j"}]], 
     RowBox[{"(", GridBox[{
        {
         SubscriptBox["p", "k"]},
        {
         RowBox[{"\[InvisibleSpace]", "j"}]}
       },
       GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
     SuperscriptBox[
      RowBox[{
       SubsuperscriptBox["\[Delta]", "k", 
        RowBox[{
         SubscriptBox["p", "k"], "-", "j"}]], "(", 
       RowBox[{
        SubscriptBox["x", "k"], "+", 
        SubscriptBox["\[Delta]", "k"]}], ")"}], "j"]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8872038915986*^9, 3.887203979066533*^9}, {
  3.887204151062681*^9, 
  3.887204153091712*^9}},ExpressionUUID->"3fa337f7-5422-4024-90c2-\
58459ea28d51"],

Cell["where by convolution-sum properties we can write", "ExpositoryText",
 CellChangeTimes->{{3.887204056548952*^9, 
  3.887204065284844*^9}},ExpressionUUID->"b36d9edc-2eaf-4289-a8ea-\
ca22db4a60ad"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[Product]", "k"], "\[VeryThinSpace]\[VeryThinSpace]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["x", "k"], "+", 
       SubscriptBox["\[Delta]", "k"], "-", 
       SubscriptBox["\[Delta]", "k"]}], ")"}], 
     SubscriptBox["p", "k"]]}], " ", "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"\[Gamma]", "=", "0"}], "\[Omega]"], "\[VeryThinSpace]", 
    RowBox[{
     SuperscriptBox["D", 
      RowBox[{"(", 
       RowBox[{"p", ",", "\[Gamma]"}], ")"}]], "\[CircleDot]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"x", "+", "\[Delta]"}], ")"}], 
      RowBox[{"(", "\[Gamma]", ")"}]]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.887204402766658*^9, 3.887204463814867*^9}, {
  3.8872044959734383`*^9, 3.887204503918654*^9}, {3.887204707491582*^9, 
  3.8872047124035387`*^9}, {3.887210231207946*^9, 3.88721023146421*^9}, {
  3.887473640738041*^9, 
  3.887473649662705*^9}},ExpressionUUID->"9ce1102d-84eb-4420-bfa5-\
07d54f9a1366"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", " ", "=", " ", 
    RowBox[{
     UnderscriptBox["\[Sum]", "k"], " ", 
     SubscriptBox["p", "k"]}]}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "0ecb5b26-ca0a-4b64-b94e-02e97a98eb2b"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["D", 
    RowBox[{"(", 
     RowBox[{"p", ",", "\[Gamma]"}], ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.887204402766658*^9, 3.887204463814867*^9}, {
   3.8872044959734383`*^9, 3.887204503918654*^9}, {3.887204707491582*^9, 
   3.8872047124035387`*^9}, {3.887210231207946*^9, 3.88721023146421*^9}, {
   3.887473640738041*^9, 3.887473649662705*^9}},ExpressionUUID->
  "06c42b44-576f-450d-a399-2fe324d78a19"],
 " comprising products of terms of the form"
}], "ExpositoryText",
 CellChangeTimes->{{3.8874736587902117`*^9, 3.887473701820767*^9}, {
  3.887473762547276*^9, 3.887473762940927*^9}, {3.8874738037742577`*^9, 
  3.887473848199581*^9}},ExpressionUUID->"b56e5d0a-0c39-46ef-908a-\
0a6c9f4fc044"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox["D", 
       RowBox[{"(", 
        RowBox[{"p", ",", "\[Gamma]"}], ")"}]], " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        UnderscriptBox["\[Product]", "k"], 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], 
          RowBox[{
           SubscriptBox["p", "k"], "-", 
           SubscriptBox["r", "k"]}]], 
         RowBox[{"(", GridBox[{
            {
             SubscriptBox["p", "k"]},
            {
             RowBox[{"\[InvisibleSpace]", 
              SubscriptBox["r", "k"]}]}
           },
           GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
         RowBox[{
          SubsuperscriptBox["\[Delta]", "k", 
           RowBox[{
            SubscriptBox["p", "k"], "-", 
            SubscriptBox["r", "k"]}]], ":", 
          RowBox[{"r", "\[Element]", 
           RowBox[{"P", "(", "\[Gamma]", ")"}]}]}]}]}], "}"}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{"\[Omega]", "-", "\[Gamma]"}]], 
       RowBox[{"{", 
        RowBox[{
         UnderscriptBox["\[Product]", "k"], 
         RowBox[{
          RowBox[{"(", GridBox[{
             {
              SubscriptBox["p", "k"]},
             {
              RowBox[{"\[InvisibleSpace]", 
               SubscriptBox["r", "k"]}]}
            },
            GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
          RowBox[{
           SubsuperscriptBox["\[Delta]", "k", 
            RowBox[{
             SubscriptBox["p", "k"], "-", 
             SubscriptBox["r", "k"]}]], ":", 
           RowBox[{"r", "\[Element]", 
            RowBox[{"P", "(", "\[Gamma]", ")"}]}]}]}]}], "}"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8874738597435417`*^9, 3.887473899713414*^9}, {
   3.8874743295366077`*^9, 3.8874743307142677`*^9}, {3.887474390303011*^9, 
   3.8874744052579937`*^9}, {3.887474661908454*^9, 3.8874747087221527`*^9}, 
   3.887474832100803*^9},ExpressionUUID->"be839df1-45d1-454b-b2ac-\
5096f8351639"],

Cell[TextData[{
 "Next we can consider the tensor of all such ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["D", 
    RowBox[{"(", 
     RowBox[{"p", ",", "\[Gamma]"}], ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.8874738597435417`*^9, 3.887473899713414*^9}, {
    3.8874743295366077`*^9, 3.8874743307142677`*^9}, {3.887474390303011*^9, 
    3.8874744052579937`*^9}, {3.887474661908454*^9, 3.8874747087221527`*^9}, 
    3.887474832100803*^9},ExpressionUUID->
  "7f7b168f-683d-49b2-bac0-b3f8fc5c771d"],
 ", which we\[CloseCurlyQuote]ll call"
}], "ExpositoryText",
 CellChangeTimes->{{3.8874737177296553`*^9, 3.887473728898774*^9}, {
  3.887474847836863*^9, 
  3.887474858729445*^9}},ExpressionUUID->"5b7cf099-3616-4c15-b007-\
f9cf826641f7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["D", 
    RowBox[{"(", 
     RowBox[{"\[Omega]", ",", "\[Gamma]"}], ")"}]], " ", "=", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"\[Omega]", "-", "\[Gamma]"}]], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       UnderscriptBox["\[Product]", "k"], 
       RowBox[{
        RowBox[{"(", GridBox[{
           {
            SubscriptBox["p", "k"]},
           {
            RowBox[{"\[InvisibleSpace]", 
             SubscriptBox["r", "k"]}]}
          },
          GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
        RowBox[{
         SubsuperscriptBox["\[Delta]", "k", 
          RowBox[{
           SubscriptBox["p", "k"], "-", 
           SubscriptBox["r", "k"]}]], ":", 
         RowBox[{"p", "\[Element]", 
          RowBox[{"P", "(", "\[Omega]", ")"}]}]}]}]}], ",", 
      RowBox[{"r", "\[Element]", 
       RowBox[{"P", "(", "\[Gamma]", ")"}]}]}], "}"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.887473708623686*^9, 3.887473732798861*^9}, {
  3.88747486162846*^9, 3.8874748656572943`*^9}, {3.8874749368474913`*^9, 
  3.887474952249401*^9}},ExpressionUUID->"054609da-ffe4-43a8-a980-\
c95656faa1eb"],

Cell["and it\[CloseCurlyQuote]s possible to recognize", "ExpositoryText",
 CellChangeTimes->{{3.887476047062337*^9, 
  3.887476051230369*^9}},ExpressionUUID->"c398bfc2-6952-444c-98f3-\
4b6331da2800"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Delta]", 
    RowBox[{"(", "\[Gamma]", ")"}], 
    RowBox[{"(", "\[Omega]", ")"}]], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      UnderscriptBox["\[Product]", "k"], "\[VeryThinSpace]", 
      RowBox[{
       SubsuperscriptBox["\[Delta]", "k", 
        RowBox[{
         SubscriptBox["p", "k"], "-", 
         SubscriptBox["r", "k"]}]], ":", 
       RowBox[{"p", "\[Element]", 
        RowBox[{"P", "(", "\[Omega]", ")"}]}]}]}], ",", 
     RowBox[{"r", "\[Element]", 
      RowBox[{"P", "(", "\[Gamma]", ")"}]}]}], "}"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.887476054808257*^9, 3.887476075790184*^9}, {
  3.887476133534679*^9, 
  3.887476148223755*^9}},ExpressionUUID->"23196da4-e7ea-42d7-bb36-\
022a8c932e79"],

Cell["\<\
in an easy-to-compute form, as it only requires removing some factors in the \
expansion\
\>", "ExpositoryText",
 CellChangeTimes->{{3.887476078101034*^9, 
  3.887476116173542*^9}},ExpressionUUID->"f434aca4-ff02-440e-ae77-\
e548b6f8a609"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["\[Delta]", 
    RowBox[{"(", "\[Omega]", ")"}]], "=", 
   RowBox[{
   "\[Delta]", "\[CircleTimes]", "\[Ellipsis]", "\[CircleTimes]", 
    "\[Delta]"}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.887476117420513*^9, 
  3.8874761764401693`*^9}},ExpressionUUID->"9d3c2083-e181-4ae6-abd1-\
f8eb25df2c2d"],

Cell[TextData[{
 "corresponding to the appropriate elements of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "\[Element]", 
    RowBox[{"P", "(", "\[Gamma]", ")"}]}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "f219f332-545f-42bd-8955-668bdc3d89d9"]
}], "ExpositoryText",
 CellChangeTimes->{{3.887476188848805*^9, 3.8874762041221743`*^9}, {
  3.8876460603124647`*^9, 
  3.8876460628554583`*^9}},ExpressionUUID->"43cb5e32-4558-4b60-ba80-\
301eb045750b"],

Cell[TextData[{
 "For example, for ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Delta]", 
    RowBox[{"(", "2", ")"}], 
    RowBox[{"(", "5", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.887476117420513*^9, 3.8874761764401693`*^9}},
  ExpressionUUID->"e8ee7a3c-4915-4628-b8b8-0244d2233a65"],
 ", we would have"
}], "ExpositoryText",
 CellChangeTimes->{{3.887646065008732*^9, 
  3.887646088181285*^9}},ExpressionUUID->"c49dc67e-07b4-4b14-937e-\
91d33044cdb3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Delta]", 
    RowBox[{"(", "2", ")"}], 
    RowBox[{"(", "5", ")"}]], " ", "=", " ", 
   RowBox[{
   "\[Delta]", "\[CircleTimes]", "\[Delta]", "\[CircleTimes]", "\[Delta]", 
    "\[CircleTimes]", 
    RowBox[{"\[Delta]", "'"}], "\[CircleTimes]", 
    RowBox[{"\[Delta]", "'"}]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.887646089519823*^9, 3.887646137104663*^9}, 
   3.887646353459073*^9, {3.8876464195226603`*^9, 3.887646437619752*^9}, {
   3.887646474765903*^9, 
   3.887646482399353*^9}},ExpressionUUID->"2711b75e-fd45-4d0b-83b2-\
17f712edffdc"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "'"}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "303a9662-e2fa-4862-aad4-185293f60df0"],
 " is a 2D tensor defined by"
}], "ExpositoryText",
 CellChangeTimes->{{3.887646484031687*^9, 3.88764648927925*^9}, {
  3.887646546002638*^9, 
  3.8876465539483356`*^9}},ExpressionUUID->"a348cea4-ad0f-49f1-a04d-\
ccb24c771de3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{"\[Delta]", "'"}], ")"}], 
    RowBox[{"i", "\[InvisibleSpace]", "j"}]], " ", "=", " ", 
   TagBox[GridBox[{
      {"\[Piecewise]", GridBox[{
         {
          SubscriptBox["\[Delta]", "j"], 
          RowBox[{"i", "\[NotEqual]", "j"}]},
         {"1", "else"}
        },
        AllowedDimensions->{2, Automatic},
        Editable->True,
        GridBoxAlignment->{
         "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
          "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
        GridBoxItemSize->{
         "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}},
           "RowsIndexed" -> {}},
        GridBoxSpacings->{"Columns" -> {
            Offset[0.27999999999999997`], {
             Offset[0.84]}, 
            Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, 
          "Rows" -> {
            Offset[0.2], {
             Offset[0.4]}, 
            Offset[0.2]}, "RowsIndexed" -> {}},
        Selectable->True]}
     },
     GridBoxAlignment->{
      "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
       "RowsIndexed" -> {}},
     GridBoxItemSize->{
      "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}}, 
       "RowsIndexed" -> {}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.35]}, 
         Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}, "RowsIndexed" -> {}}],
    "Piecewise",
    DeleteWithContents->True,
    Editable->False,
    SelectWithContents->True,
    Selectable->False,
    StripWrapperBoxes->True]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.887646495345355*^9, 
  3.887646540227479*^9}},ExpressionUUID->"4e021508-556a-4e26-b7eb-\
768e955f43c4"],

Cell[TextData[{
 "and so we can update this recursively by writing (for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", " ", ">", " ", "0"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "1a147e00-9dd5-4e60-8453-0d25c3ba5de0"],
 ")"
}], "ExpositoryText",
 CellChangeTimes->{{3.887646582947797*^9, 3.8876465936034203`*^9}, {
  3.887646865240943*^9, 
  3.887646871358026*^9}},ExpressionUUID->"98a6f59a-7b6f-46b0-9a32-\
848a7a264a3e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Delta]", 
    RowBox[{"(", "\[Gamma]", ")"}], 
    RowBox[{"(", "\[Omega]", ")"}]], " ", "=", " ", 
   RowBox[{
    SubsuperscriptBox["\[Delta]", 
     RowBox[{"(", 
      RowBox[{"\[Gamma]", "-", "1"}], ")"}], 
     RowBox[{"(", 
      RowBox[{"\[Omega]", "-", "1"}], ")"}]], "\[CircleTimes]", 
    RowBox[{"\[Delta]", "'"}]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.887646595008614*^9, 
  3.887646619312751*^9}},ExpressionUUID->"5db2cff8-4b2b-40cc-b90f-\
1102352847a0"],

Cell[TextData[{
 "Unfortunately the binomial term is a bit more annoying, although we can \
clean it up a bit by defining the subsequence ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "83e6d073-adb3-48ff-aba6-512abddbf4b8"],
 " where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "m"], " ", ">", " ", "0"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "d9e6c815-b9c1-4804-b202-e5bfdcb2aae1"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "m"], " ", ">", " ", "1"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "6339d480-955b-4ed3-a120-5b0115dfa0f3"],
 ", giving us"
}], "ExpositoryText",
 CellChangeTimes->{{3.887476209780375*^9, 3.887476212278757*^9}, {
  3.887477940966236*^9, 3.887477955094904*^9}, {3.8874781931000223`*^9, 
  3.887478215502412*^9}, {3.887479030291543*^9, 3.8874790405648746`*^9}, {
  3.887479077374837*^9, 3.8874790829799*^9}, {3.887644481462617*^9, 
  3.887644519667544*^9}},ExpressionUUID->"c9f50683-8699-4c67-8fac-\
981e300a03f1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[Product]", "k"], 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["p", "k"]},
       {
        RowBox[{"\[InvisibleSpace]", 
         SubscriptBox["r", "k"]}]}
      },
      GridBoxAlignment->{"Columns" -> {Center}}], ")"}]}], " ", "=", " ", 
   RowBox[{
    UnderscriptBox["\[Product]", "m"], " ", 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["p", "m"]},
       {
        RowBox[{"\[InvisibleSpace]", 
         SubscriptBox["r", "m"]}]}
      },
      GridBoxAlignment->{"Columns" -> {Center}}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.887478216687964*^9, 3.887478256785385*^9}, {
  3.887479048067902*^9, 
  3.887479087437508*^9}},ExpressionUUID->"a18ebda9-db1e-4911-a43d-\
71fb44038c9b"],

Cell[TextData[{
 "Moreover, we can drop a number of these terms when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Exists]", "k"], "\[VeryThinSpace]", 
    RowBox[{
     SubscriptBox["p", "k"], "<", 
     SubscriptBox["r", "k"]}]}], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"7015fdc1-b66a-461f-a346-c20953afcf92"],
 ", and by precomputing Pascal\[CloseCurlyQuote]s triangle we can generate it \
efficiently enough using indexing tricks with a layer of permutation fuckery \
stacked on top."
}], "ExpositoryText",
 CellChangeTimes->{{3.887917662259514*^9, 
  3.887917679684492*^9}},ExpressionUUID->"6faacb47-dd1b-41e0-9add-\
9d9b7cc91673"],

Cell["Therefore, we have", "ExpositoryText",
 CellChangeTimes->{{3.887204627818026*^9, 
  3.887204675856896*^9}},ExpressionUUID->"0fec14e8-04f1-4de9-a2c2-\
cc24351d5141"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "n"], "(", "y", ")"}], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Omega]", "=", "0"}], "n"], 
       "\[VeryThinSpace]\[VeryThinSpace]", 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"p", "\[Element]", 
          RowBox[{"P", "(", "\[Omega]", ")"}]}]], 
        "\[VeryThinSpace]\[VeryThinSpace]", 
        RowBox[{
         SubscriptBox[
          RowBox[{"(", 
           SuperscriptBox["K", 
            RowBox[{"(", "\[Omega]", ")"}]], ")"}], "p"], 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"\[Gamma]", "=", "0"}], "\[Omega]"], "\[VeryThinSpace] ", 
          RowBox[{
           SuperscriptBox["D", 
            RowBox[{"(", 
             RowBox[{"p", ",", "\[Gamma]"}], ")"}]], "\[CircleDot]", 
           SuperscriptBox["y", 
            RowBox[{"(", "\[Gamma]", ")"}]]}]}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Omega]", "=", "0"}], "n"], 
       "\[VeryThinSpace]\[VeryThinSpace]", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"\[Gamma]", "=", "0"}], "\[Omega]"], 
        "\[VeryThinSpace]\[VeryThinSpace]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           UnderscriptBox["\[Sum]", 
            RowBox[{"p", "\[Element]", 
             RowBox[{"P", "(", "\[Omega]", ")"}]}]], 
           "\[VeryThinSpace]\[VeryThinSpace]", 
           RowBox[{
            SubscriptBox[
             RowBox[{"(", 
              SuperscriptBox["K", 
               RowBox[{"(", "\[Omega]", ")"}]], ")"}], "p"], "\[VeryThinSpace] ", 
            SuperscriptBox["D", 
             RowBox[{"(", 
              RowBox[{"p", ",", "\[Gamma]"}], ")"}]]}]}], ")"}], 
         "\[CircleDot]", 
         SuperscriptBox["y", 
          RowBox[{"(", "\[Gamma]", ")"}]]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Omega]", "=", "0"}], "n"], 
       "\[VeryThinSpace]\[VeryThinSpace]", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"\[Gamma]", "=", "0"}], "\[Omega]"], 
        "\[VeryThinSpace]\[VeryThinSpace]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["K", 
            RowBox[{"(", "\[Omega]", ")"}]], "\[CircleDot]", 
           SuperscriptBox["D", 
            RowBox[{"(", 
             RowBox[{"\[Omega]", ",", "\[Gamma]"}], ")"}]]}], ")"}], 
         "\[CircleDot]", 
         SuperscriptBox["y", 
          RowBox[{"(", "\[Gamma]", ")"}]]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.887204636189991*^9, 3.887204645943728*^9}, {
  3.887204677318203*^9, 3.887204716937958*^9}, {3.8872048124985456`*^9, 
  3.887204823427597*^9}, {3.8872101422130613`*^9, 3.887210154194518*^9}, {
  3.887210707201192*^9, 3.88721072062169*^9}, {3.887210771482682*^9, 
  3.8872107882965517`*^9}, {3.88721086611403*^9, 3.887210872775284*^9}, {
  3.887210950747064*^9, 3.887210954433049*^9}, {3.887397588459811*^9, 
  3.887397644310067*^9}, {3.887644585206653*^9, 
  3.887644649531639*^9}},ExpressionUUID->"91bd6ba3-8ab2-481f-b4d5-\
96fc6362ac72"],

Cell[TextData[{
 "then we\[CloseCurlyQuote]ll note that ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", 
    RowBox[{"(", "0", ")"}]], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "7c4b9ad5-54a8-4ff0-826c-c8f98d787e5a"],
 " will appear in this sum for every ",
 Cell[BoxData[
  FormBox["\[Omega]", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "b84803fb-e518-497f-b693-3f7fbe9feeec"],
 ", while ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", 
    RowBox[{"(", "n", ")"}]], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "56d2f161-e5af-4a9e-ba78-51bea2777b22"],
 " will only appear once, indicating that we can rewrite this as"
}], "ExpositoryText",
 CellChangeTimes->{{3.8872109561771517`*^9, 3.887211019008285*^9}, {
  3.8873972755098658`*^9, 3.887397295046089*^9}, {3.8873976696291447`*^9, 
  3.8873976790641403`*^9}},ExpressionUUID->"43f0d630-8a9a-477a-8286-\
fca7a62098b4"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "n"], "(", "y", ")"}], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Omega]", "=", "0"}], "n"], 
       "\[VeryThinSpace]\[VeryThinSpace]", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"\[Gamma]", "=", "0"}], "\[Omega]"], 
        "\[VeryThinSpace]\[VeryThinSpace]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["K", 
            RowBox[{"(", "\[Omega]", ")"}]], "\[CircleDot]", 
           SuperscriptBox["D", 
            RowBox[{"(", 
             RowBox[{"\[Omega]", ",", "\[Gamma]"}], ")"}]]}], ")"}], 
         "\[CircleDot]", 
         SuperscriptBox["y", 
          RowBox[{"(", "\[Gamma]", ")"}]]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Gamma]", "=", "0"}], "n"], 
       "\[VeryThinSpace]\[VeryThinSpace]\[VeryThinSpace]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"\[Omega]", "=", "\[Gamma]"}], "n"], 
          "\[VeryThinSpace]\[VeryThinSpace]\[VeryThinSpace]", 
          RowBox[{
           SuperscriptBox["K", 
            RowBox[{"(", "\[Omega]", ")"}]], "\[CircleDot]", 
           SuperscriptBox["D", 
            RowBox[{"(", 
             RowBox[{"\[Omega]", ",", "\[Gamma]"}], ")"}]]}]}], ")"}], 
        "\[CircleDot]", 
        SuperscriptBox["y", 
         RowBox[{"(", "\[Gamma]", ")"}]]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8873973012305717`*^9, 3.8873973020031137`*^9}, {
  3.8873973359656982`*^9, 3.887397338313361*^9}, {3.8873973809201603`*^9, 
  3.887397400094502*^9}, {3.8873976868446712`*^9, 3.887397692154243*^9}, {
  3.8873977609078503`*^9, 3.887397775820435*^9}, {3.887397818273334*^9, 
  3.8873978366210537`*^9}, {3.887397884117565*^9, 3.887397889172812*^9}, {
  3.88764466732129*^9, 
  3.887644687005871*^9}},ExpressionUUID->"ef1018e5-9d3d-42e1-83e8-\
6aa7b7416a01"],

Cell["and so by defining", "ExpositoryText",
 CellChangeTimes->{{3.8876446933560333`*^9, 
  3.887644695846445*^9}},ExpressionUUID->"1312058a-5e0b-4469-a8da-\
4886c04233ca"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["K", "\[Delta]", 
    RowBox[{"(", "\[Gamma]", ")"}]], " ", "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"\[Omega]", "=", "\[Gamma]"}], "n"], 
    RowBox[{
     SuperscriptBox["K", 
      RowBox[{"(", "\[Omega]", ")"}]], "\[CircleDot]", 
     SuperscriptBox["D", 
      RowBox[{"(", 
       RowBox[{"\[Omega]", ",", "\[Gamma]"}], ")"}]]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.887644699051746*^9, 
  3.887644706903901*^9}},ExpressionUUID->"13b5c993-07c6-49db-bd29-\
d883d6d54501"],

Cell["we have a new polynomial expression", "ExpositoryText",
 CellChangeTimes->{{3.8876447091943483`*^9, 3.887644721287442*^9}, 
   3.887644765824123*^9},ExpressionUUID->"393931db-65aa-46b0-8eb1-\
f13fc42a16c8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", "n"], "(", "y", ")"}], " ", "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"\[Gamma]", "=", "0"}], "n"], " ", 
    RowBox[{
     SubsuperscriptBox["K", "\[Delta]", 
      RowBox[{"(", "\[Gamma]", ")"}]], "\[CircleDot]", 
     SuperscriptBox["y", 
      RowBox[{"(", "\[Gamma]", ")"}]]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.887397933080998*^9, 
  3.8873979523974257`*^9}},ExpressionUUID->"c0460a30-1be2-4a47-9b32-\
6ff713250cca"]
}, Closed]],

Cell[CellGroupData[{

Cell["Sparse Shifts", "Subsubsection",
 CellChangeTimes->{{3.922962178638708*^9, 
  3.922962180293944*^9}},ExpressionUUID->"782e3574-221a-439f-8156-\
40c516be04ac"],

Cell["\<\
We\[CloseCurlyQuote]ll assume we have a very limited number of polynomial \
terms, in which case it makes sense to simply treat the polynomial \
term-by-term\
\>", "ExpositoryText",
 CellChangeTimes->{{3.9229621811756687`*^9, 3.922962206929865*^9}, {
  3.9229625446969233`*^9, 
  3.9229625464733963`*^9}},ExpressionUUID->"754dd02f-f41a-4e01-88bb-\
27d52d6aef65"],

Cell[TextData[{
 "For this we\[CloseCurlyQuote]ll consider the transformation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Xi]", "i"], " ", "=", " ", 
    RowBox[{
     SubscriptBox["x", "i"], " ", "+", " ", 
     SubscriptBox["\[Delta]", "i"]}]}], TraditionalForm]],
  CellChangeTimes->{{3.9229622176656713`*^9, 3.922962255020823*^9}, {
   3.922962308323122*^9, 3.9229623145131197`*^9}},ExpressionUUID->
  "cd6a5655-a8e1-4f55-8fb9-1303b30aa2a1"],
 " for only one term of the form "
}], "ExpositoryText",
 CellChangeTimes->{{3.9229622086764803`*^9, 3.92296221655431*^9}, {
  3.922962258807523*^9, 3.9229623271511087`*^9}, {3.9229624190165977`*^9, 
  3.9229624195175867`*^9}, {3.922962955055962*^9, 
  3.922962957732926*^9}},ExpressionUUID->"4cb455b7-d76b-4db4-961a-\
778f7229a4d0"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       UnderscriptBox["\[Product]", "i"], " ", 
       SuperscriptBox[
        SubscriptBox["\[Xi]", "i"], 
        SubscriptBox["p", "i"]]}], " ", "=", " ", 
      RowBox[{
       UnderscriptBox["\[Product]", "i"], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Xi]", "i"], " ", "+", " ", 
          SubscriptBox["\[Delta]", "i"]}], ")"}], 
        SubscriptBox["p", "i"]]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderscriptBox["\[Product]", "i"], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], 
         SubscriptBox["p", "i"]], " ", 
        RowBox[{
         RowBox[{"(", GridBox[{
            {
             SubscriptBox["p", "i"]},
            {
             RowBox[{"\[InvisibleSpace]", "j"}]}
           },
           GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
         SuperscriptBox[
          RowBox[{
           SubsuperscriptBox["\[Delta]", "i", 
            RowBox[{
             SubscriptBox["p", "i"], "-", "j"}]], "(", 
           SubscriptBox["x", "i"], ")"}], "j"]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9229622176656713`*^9, 3.922962255020823*^9}, {
  3.922962308323122*^9, 3.9229623633781*^9}, {3.922962398235943*^9, 
  3.9229624311113043`*^9}, {3.922962959685298*^9, 
  3.922962972115963*^9}},ExpressionUUID->"109eb6ac-567f-495b-b900-\
61bfc6b9a6ff"],

Cell[TextData[{
 "to make the implementation more convenient we will move the product inside \
the summation by noting that we are sampling over a tensor with dimensions \
given by ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "4ac0eee1-37d6-496d-b3c8-1c4c460a829c"]
}], "ExpositoryText",
 CellChangeTimes->{{3.922962592584282*^9, 3.922962620150338*^9}, {
  3.922962698741222*^9, 3.9229627475686417`*^9}, {3.922962847963215*^9, 
  3.9229628495277653`*^9}},ExpressionUUID->"8de5f03c-9a93-4e01-8a81-\
7f080cd8fb46"],

Cell[TextData[{
 "Letting ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Nu]", "(", "p", ")"}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "fb139d1b-c049-4db7-850f-f1660f4be6c7"],
 " be the tensor of indices induced by ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "3e408b57-d501-4c23-a00a-45ef060cbafb"],
 ", we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.9229627526146107`*^9, 
  3.92296282626189*^9}},ExpressionUUID->"c70d30bb-45bf-43f1-895d-\
e8e3fedc47ee"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[Product]", "i"], " ", 
    SuperscriptBox[
     SubscriptBox["\[Xi]", "i"], 
     SubscriptBox["p", "i"]]}], " ", "=", " ", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{"r", "\[Element]", 
      RowBox[{"\[Nu]", "(", "p", ")"}]}]], 
    RowBox[{
     UnderscriptBox["\[Product]", "i"], 
     RowBox[{
      RowBox[{"(", GridBox[{
         {
          SubscriptBox["p", "i"]},
         {
          RowBox[{"\[InvisibleSpace]", 
           SubscriptBox["r", "i"]}]}
        },
        GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
      SuperscriptBox[
       RowBox[{
        SubsuperscriptBox["\[Delta]", "i", 
         RowBox[{
          SubscriptBox["p", "i"], "-", 
          SubscriptBox["r", "i"]}]], "(", 
        SubscriptBox["x", "i"], ")"}], 
       SubscriptBox["r", "i"]]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9229628311089077`*^9, 3.922962914453537*^9}, {
  3.922962979319614*^9, 
  3.922962981126103*^9}},ExpressionUUID->"470d3ade-fba2-4d7b-b01d-\
c8aadc1ebb8b"],

Cell["\<\
and assuming a sparse treatment, we can simply add these contributions over \
every term\
\>", "ExpositoryText",
 CellChangeTimes->{{3.9229629881182547`*^9, 3.922963012289404*^9}, {
  3.922987174781322*^9, 
  3.922987175062991*^9}},ExpressionUUID->"270cb964-889b-4894-83d1-\
941d569e2f11"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Kinetic Energy", "Subsection",
 CellChangeTimes->{{3.895338226347392*^9, 
  3.895338228256076*^9}},ExpressionUUID->"6f1b18da-2db4-4991-a3bc-\
dc56f25a72d1"],

Cell["Our derivatives pick up some extra terms as we have", "ExpositoryText",
 CellChangeTimes->{{3.895340590914185*^9, 
  3.89534060002812*^9}},ExpressionUUID->"e8fe700d-f2c7-4e23-94fd-\
7b2ba73ed842"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        StyleBox["x",
         FontSize->12]], 
       RowBox[{
        SubscriptBox["\[CurlyPhi]", "n"], "(", 
        RowBox[{"x", ",", " ", "\[Xi]", ",", " ", "\[CapitalSigma]"}], 
        ")"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        SubscriptBox["P", "n"], "(", "x", ")"}], 
       RowBox[{"\[Phi]", "(", 
        RowBox[{"x", ",", " ", "\[Xi]", ",", " ", "\[CapitalSigma]"}], 
        ")"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Del]", 
           StyleBox["x",
            FontSize->12]], 
          RowBox[{
           SubscriptBox["P", "n"], "(", "x", ")"}]}], ")"}], 
        RowBox[{"\[Phi]", "(", 
         RowBox[{"x", ",", " ", "\[Xi]", ",", " ", "\[CapitalSigma]"}], 
         ")"}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{
         SubscriptBox["P", "n"], "(", "x", ")"}], 
        RowBox[{
         SubscriptBox["\[Del]", 
          StyleBox["x",
           FontSize->12]], 
         RowBox[{"\[Phi]", "(", 
          RowBox[{"x", ",", " ", "\[Xi]", ",", " ", "\[CapitalSigma]"}], 
          ")"}]}]}]}]}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox[
          StyleBox["x",
           FontSize->12], "2"]], 
        SubscriptBox["\[CurlyPhi]", "n"]}], 
       RowBox[{"(", 
        RowBox[{"x", ",", " ", "\[Xi]", ",", " ", "\[CapitalSigma]"}], 
        ")"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Del]", 
           SuperscriptBox[
            StyleBox["x",
             FontSize->12], "2"]], 
          RowBox[{
           SubscriptBox["P", "n"], "(", "x", ")"}]}], ")"}], 
        RowBox[{"\[Phi]", "(", 
         RowBox[{"x", ",", " ", "\[Xi]", ",", " ", "\[CapitalSigma]"}], 
         ")"}]}], " ", "+", " ", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Del]", 
           StyleBox["x",
            FontSize->12]], 
          RowBox[{
           SubscriptBox["P", "n"], "(", "x", ")"}]}], ")"}], 
        RowBox[{
         SubscriptBox["\[Del]", 
          StyleBox["x",
           FontSize->12]], 
         RowBox[{"\[Phi]", "(", 
          RowBox[{"x", ",", " ", "\[Xi]", ",", " ", "\[CapitalSigma]"}], 
          ")"}]}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{
         SubscriptBox["P", "n"], "(", "x", ")"}], 
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox[
           StyleBox["x",
            FontSize->12], "2"]], 
         RowBox[{"\[Phi]", "(", 
          RowBox[{"x", ",", " ", "\[Xi]", ",", " ", "\[CapitalSigma]"}], 
          ")"}], " "}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.895340601114107*^9, 
  3.895340730553722*^9}},ExpressionUUID->"d64034cf-ad20-4780-917c-\
f7a699756582"],

Cell["And as before, we have", "ExpositoryText",
 CellChangeTimes->{{3.895338242114304*^9, 3.895338275582098*^9}, {
  3.8953407533692913`*^9, 
  3.8953407537757473`*^9}},ExpressionUUID->"23f65291-06c1-429a-b0c9-\
b9d0cfbb54d2"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        StyleBox["x",
         FontSize->12]], 
       RowBox[{"\[Phi]", "(", 
        RowBox[{"x", ",", " ", "\[Xi]", ",", " ", "\[CapitalSigma]"}], 
        ")"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], 
       RowBox[{
        SubscriptBox["\[Del]", 
         StyleBox["x",
          FontSize->12]], 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["\[CapitalSigma]", 
           RowBox[{"-", "1"}]], "\[CircleDot]", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"x", "-", "\[Xi]"}], ")"}], "2"]}], ")"}]}], 
       RowBox[{"\[Phi]", "(", 
        RowBox[{"x", ",", " ", "\[Xi]", ",", " ", "\[CapitalSigma]"}], 
        ")"}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox[
         StyleBox["x",
          FontSize->12], "2"]], 
       RowBox[{"\[Phi]", "(", 
        RowBox[{"x", ",", " ", "\[Xi]", ",", " ", "\[CapitalSigma]"}], 
        ")"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", "2"]}], 
          RowBox[{
           SubscriptBox["\[Del]", 
            SuperscriptBox[
             StyleBox["x",
              FontSize->12], "2"]], 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["\[CapitalSigma]", 
              RowBox[{"-", "1"}]], "\[CircleDot]", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"x", "-", "\[Xi]"}], ")"}], "2"]}], ")"}]}]}], " ", 
         "+", " ", 
         RowBox[{
          FractionBox["1", "4"], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             SubscriptBox["\[Del]", 
              StyleBox["x",
               FontSize->12]], 
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox["\[CapitalSigma]", 
                RowBox[{"-", "1"}]], "\[CircleDot]", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"x", "-", "\[Xi]"}], ")"}], "2"]}], ")"}]}], ")"}], 
           "2"]}]}], ")"}], 
       RowBox[{"\[Phi]", "(", 
        RowBox[{"x", ",", " ", "\[Xi]", ",", " ", "\[CapitalSigma]"}], 
        ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8838503791562767`*^9, 3.883850400959786*^9}, {
   3.883850438382978*^9, 3.883850532700453*^9}, {3.883853972868636*^9, 
   3.883853977121108*^9}, {3.8838752237264433`*^9, 3.883875238365087*^9}, 
   3.895341010443742*^9, 
   3.89589234943322*^9},ExpressionUUID->"472f2e62-1dbd-41ff-816e-\
de2568aec01a"],

Cell["and so we can introduce a \[OpenCurlyDoubleQuote]kinetic\
\[CloseCurlyDoubleQuote] polynomial", "ExpositoryText",
 CellChangeTimes->{{3.895340767669611*^9, 
  3.895340812136117*^9}},ExpressionUUID->"ddcd950a-f72b-4cb1-88c1-\
f4e17e7d32a6"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["K", "n"], "\[AlignmentMarker]", "(", 
       RowBox[{"x", ",", " ", "\[Xi]", ",", " ", "\[CapitalSigma]"}], ")"}], 
      " ", "=", " "}]},
    {
     RowBox[{"\[AlignmentMarker]", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox[
          StyleBox["x",
           FontSize->12], "2"]], 
        RowBox[{
         SubscriptBox["P", "n"], "(", "x", ")"}]}], " ", "-", " ", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", 
          StyleBox["x",
           FontSize->12]], 
         SubscriptBox["P", "n"]}], 
        RowBox[{"(", "x", ")"}], 
        RowBox[{
         SubscriptBox["\[Del]", 
          StyleBox["x",
           FontSize->12]], 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["\[CapitalSigma]", 
            RowBox[{"-", "1"}]], "\[CircleDot]", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"x", "-", "\[Xi]"}], ")"}], "2"]}], ")"}]}]}], " ", "+", 
       " ", 
       RowBox[{
        SubscriptBox["P", "n"], 
        RowBox[{"(", "x", ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], 
           RowBox[{
            SubscriptBox["\[Del]", 
             SuperscriptBox[
              StyleBox["x",
               FontSize->12], "2"]], 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["\[CapitalSigma]", 
               RowBox[{"-", "1"}]], "\[CircleDot]", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"x", "-", "\[Xi]"}], ")"}], "2"]}], ")"}]}]}], " ", 
          "+", " ", 
          RowBox[{
           FractionBox["1", "4"], 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["\[Del]", 
               StyleBox["x",
                FontSize->12]], 
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox["\[CapitalSigma]", 
                 RowBox[{"-", "1"}]], "\[CircleDot]", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"x", "-", "\[Xi]"}], ")"}], "2"]}], ")"}]}], ")"}], 
            "2"]}]}], ")"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCenteredManuallyAligned",
 CellChangeTimes->{{3.895340791260661*^9, 3.895340838029517*^9}, {
  3.895340928332635*^9, 
  3.895341048061809*^9}},ExpressionUUID->"6d77300d-420a-4c2b-ae54-\
e89576d3ca8b"],

Cell[TextData[{
 "where the coefficients for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalSigma]", 
     RowBox[{"\[Minus]", "1"}]], "\[CircleDot]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "\[Minus]", "\[Xi]"}], ")"}], "2"]}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "0d4eca6d-4edf-46d0-ac30-fd406f18b396"],
 " are expressed by applying a polynomial shift by ",
 Cell[BoxData[
  FormBox["\[Xi]", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "95430075-fb7a-4c4e-951a-d83dedcd434f"],
 " to the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalSigma]", 
    RowBox[{"\[Minus]", "1"}]], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"d03380c0-43c2-4e69-bf1c-9d7db5719cf5"],
 " coefficients"
}], "ExpositoryText",
 CellChangeTimes->{{3.895341146555335*^9, 3.895341147125742*^9}, {
   3.8953411863302298`*^9, 3.895341288987361*^9}, {3.895345122998723*^9, 
   3.895345190331244*^9}, 
   3.8953456975313463`*^9},ExpressionUUID->"f0a8131f-ef0d-49f6-bda0-\
667099391041"],

Cell["Therefore, in total we have", "ExpositoryText",
 CellChangeTimes->{{3.895344732910882*^9, 
  3.8953447390639973`*^9}},ExpressionUUID->"7791ec52-4582-4f89-b22e-\
6a612177abb7"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["T", 
       RowBox[{"i", "\[InvisibleSpace]", "j"}]], "=", 
      RowBox[{"-", 
       RowBox[{
        SubsuperscriptBox["\[Integral]", 
         SuperscriptBox["\[DoubleStruckCapitalR]", "d"], " "], 
        RowBox[{
         RowBox[{
          SuperscriptBox["\[CurlyPhi]", 
           RowBox[{"(", "i", ")"}]], "(", "x", ")"}], 
         RowBox[{
          FractionBox[
           SuperscriptBox["\[Del]", "2"], 
           RowBox[{"2", "\[InvisibleSpace]", "m"}]], 
          RowBox[{
           SuperscriptBox["\[CurlyPhi]", 
            RowBox[{"(", "j", ")"}]], "(", "x", ")"}]}], 
         RowBox[{"\[DifferentialD]", "x"}]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], 
       RowBox[{
        SubsuperscriptBox["\[Integral]", 
         SuperscriptBox["\[DoubleStruckCapitalR]", "d"], " "], 
        RowBox[{
         RowBox[{
          SuperscriptBox["\[Phi]", 
           RowBox[{"(", "c", ")"}]], "(", "x", ")"}], 
         RowBox[{"Tr", "(", 
          RowBox[{
           SuperscriptBox["M", 
            RowBox[{"-", "1"}]], 
           RowBox[{
            SuperscriptBox["K", 
             RowBox[{"(", "j", ")"}]], "(", "x", ")"}]}], ")"}], 
         RowBox[{"\[DifferentialD]", "x"}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8953450024568853`*^9, 3.895345066499599*^9}, {
  3.895345444430481*^9, 3.8953454497162848`*^9}, {3.895345566738648*^9, 
  3.8953456079241753`*^9}},ExpressionUUID->"c8eca48a-7b4b-4e5e-a7cb-\
51879a50c43d"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Tr", "(", 
    RowBox[{
     SuperscriptBox["M", 
      RowBox[{"-", "1"}]], 
     RowBox[{
      SuperscriptBox["K", 
       RowBox[{"(", "j", ")"}]], "(", "x", ")"}]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.8953450024568853`*^9, 3.895345066499599*^9}, {
   3.895345444430481*^9, 3.8953454497162848`*^9}, {3.895345566738648*^9, 
   3.8953456079241753`*^9}},ExpressionUUID->
  "c392cd18-f3ed-41f3-b45a-84d40f581def"],
 " should be relatively straightforward to implement assuming that we can \
figure out which diagonals it should be treating \[LongDash] given that the \
trace will only operate on a subset of the coordinates, I guess technically \
we\[CloseCurlyQuote]d have"
}], "ExpositoryText",
 CellChangeTimes->{{3.895345705018948*^9, 3.895345711806473*^9}, {
  3.895345778167646*^9, 3.895345833227507*^9}, {3.895345886024728*^9, 
