Cell[CellGroupData[{

Cell["Dealing with Watson Modes", "Subsection",
 CellChangeTimes->{{3.912009291891891*^9, 3.9120093035015287`*^9}, {
  3.912153527162665*^9, 
  3.912153531822596*^9}},ExpressionUUID->"e86fa36d-cd27-40a3-be48-\
1c24c1ee890c"],

Cell[TextData[{
 "When working with Gaussians constructed from Cartesian-displacement normal \
modes the approach above won\[CloseCurlyQuote]t work as specified, since even \
though we have proper Gaussians in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"3", "\[InvisibleSpace]", "N"}], "\[Minus]", "6"}], ")"}], 
   TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "13acd5f8-65a2-41dc-906f-7f512b6e7e05"],
 "-dimensional normal modes space, we don\[CloseCurlyQuote]t have them in \
proper ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[InvisibleSpace]", "N"}], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "e05c605c-1bed-4d57-8fbc-75f218803701"],
 " space as that would require a singular covariance matrix"
}], "ExpositoryText",
 CellChangeTimes->{{3.91215353946349*^9, 3.9121535709499903`*^9}, {
  3.912153672993301*^9, 
  3.912153787538641*^9}},ExpressionUUID->"49df6be1-efc8-4610-a3a4-\
bda7174f6ed9"],

Cell[TextData[{
 "The difficulty is then to figure out how many modes we can construct that \
",
 StyleBox["don\[CloseCurlyQuote]t",
  FontSlant->"Italic"],
 " change the bond length, this is equivalent to finding the set of solutions \
",
 Cell[BoxData[
  FormBox["W", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "19191ed8-e0d3-46e1-ae55-1d53327acfbb"],
 " such that"
}], "ExpositoryText",
 CellChangeTimes->{{3.912362434993041*^9, 3.912362459876206*^9}, {
  3.9123628548074007`*^9, 
  3.912362884476054*^9}},ExpressionUUID->"43c8837b-c7a7-4be1-843e-\
a08ce58b6c11"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{"L", "\[InvisibleSpace]", 
      SubscriptBox["W", "P"]}], ")"}], "1"], " ", "=", " ", 
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{"L", "\[InvisibleSpace]", 
      SubscriptBox["W", "P"]}], ")"}], "2"]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.912362461711546*^9, 3.912362482370482*^9}, {
  3.912362849702379*^9, 3.91236289633645*^9}, {3.912669901087237*^9, 
  3.9126699032865753`*^9}},ExpressionUUID->"da1d998a-b061-43a6-b268-\
0be5881a4fe9"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{"L", "\[InvisibleSpace]", 
      SubscriptBox["W", "P"]}], ")"}], "1"], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "237a0b25-8c68-430c-abb7-9b00f255a290"],
 " is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"3", "\[InvisibleSpace]", "N"}], "\[Minus]", "6"}], ")"}]}], 
   TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "c279085c-1783-48d2-a92b-4c41b12a7aae"],
 " matrix encoding how the Cartesian coordinates of atom 1 change and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "2"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "fb0457eb-61c5-4a9d-9810-1660d449268b"],
 " is the corresponding matrix for atom 2"
}], "ExpositoryText",
 CellChangeTimes->{{3.9123624834378138`*^9, 3.912362545336371*^9}, {
  3.912362584900423*^9, 3.912362589470326*^9}, {3.91236266266297*^9, 
  3.912362685186811*^9}, {3.912362901734735*^9, 3.912362919578154*^9}, {
  3.912669908484552*^9, 
  3.912669908783958*^9}},ExpressionUUID->"1875875b-d4d0-40ce-a5bb-\
b2e13c07b81d"],

Cell["This implies that", "ExpositoryText",
 CellChangeTimes->{{3.9123629316351547`*^9, 
  3.912362934609005*^9}},ExpressionUUID->"be44925c-142e-4334-827a-\
859e19cccc43"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{"L", "\[InvisibleSpace]", 
       SubscriptBox["W", "P"]}], ")"}], "1"], " ", "-", " ", 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{"L", "\[InvisibleSpace]", 
       SubscriptBox["W", "P"]}], ")"}], "2"]}], " ", "=", " ", "0"}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.912362461711546*^9, 3.912362482370482*^9}, {
  3.912362849702379*^9, 3.91236289633645*^9}, {3.912362939949918*^9, 
  3.912362943383903*^9}, {3.912669919030588*^9, 
  3.912669924778697*^9}},ExpressionUUID->"964d6042-6386-4c92-9519-\
1ace98295b1b"],

Cell[TextData[{
 "but we also know that (using the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "\[Delta]"], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"f9609b77-b38d-40b5-ba5f-7927b4b3e845"],
 " from above)"
}], "ExpositoryText",
 CellChangeTimes->{{3.912362950218704*^9, 3.912362977030693*^9}, {
  3.912363015741888*^9, 3.912363018744306*^9}, {3.912423264144794*^9, 
  3.912423270639249*^9}},ExpressionUUID->"76264eac-c386-4087-a25c-\
7723d8f85a23"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox[
        RowBox[{"(", 
         RowBox[{"L", "\[InvisibleSpace]", 
          SubscriptBox["W", "P"]}], ")"}], "1"], " ", "-", " ", 
       SubscriptBox[
        RowBox[{"(", 
         RowBox[{"L", "\[InvisibleSpace]", 
          SubscriptBox["W", "P"]}], ")"}], "2"]}], " ", "=", " ", 
      RowBox[{
       SubscriptBox["A", "\[Delta]"], "L", "\[InvisibleSpace]", 
       SubscriptBox["W", "P"]}]}]},
    {
     RowBox[{"=", " ", "0"}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.912362461711546*^9, 3.912362482370482*^9}, {
  3.912362849702379*^9, 3.91236289633645*^9}, {3.912362939949918*^9, 
  3.912362943383903*^9}, {3.912363033947887*^9, 3.912363062557891*^9}, {
  3.912363147051559*^9, 3.912363149191156*^9}, {3.912669921896819*^9, 
  3.9126699264490843`*^9}},ExpressionUUID->"9b92df62-71a2-4eb8-8aa5-\
e630ee852012"],

Cell[TextData[{
 "therefore ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["W", "P"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "8f97a51a-ebfd-4f5f-a569-6456db70fd60"],
 " is simply a basis for the nullspace of ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["A", "\[Delta]"], "L"}]],
  CellChangeTimes->{{3.912362461711546*^9, 3.912362482370482*^9}, {
   3.912362849702379*^9, 3.91236289633645*^9}, {3.912362939949918*^9, 
   3.912362943383903*^9}, {3.912363033947887*^9, 3.912363062557891*^9}, {
   3.912363147051559*^9, 3.912363149191156*^9}},ExpressionUUID->
  "4e51c079-2ea4-46a1-9052-f3280a43f949"],
 " and the total transformation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["W", "P"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "4efbb7b2-0343-462c-84db-0de87405be3e"],
 " we are truly interested"
}], "ExpositoryText",
 CellChangeTimes->{{3.9123631526571417`*^9, 3.912363171770072*^9}, {
  3.912423243671804*^9, 3.9124232823444843`*^9}, {3.912669883082206*^9, 
  3.912669883082304*^9}, {3.912669932132674*^9, 
  3.912669933476776*^9}},ExpressionUUID->"6450a939-762a-4dc0-b09a-\
a194c5edd857"],

Cell[TextData[{
 "We can recognize now that this is equivalent to computing the SVD of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["A", "\[Delta]"], "L", "\[InvisibleSpace]"}], 
   TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "fb9d32a0-8ad5-4abe-9c23-329ce135750f"],
 " as"
}], "ExpositoryText",
 CellChangeTimes->{{3.912423065327289*^9, 
  3.912423116469109*^9}},ExpressionUUID->"eba0368e-2d25-4007-a746-\
350710e42ab4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"V", "\[InvisibleSpace]", "S", "\[InvisibleSpace]", "W"}], " ", 
   "=", " ", 
   RowBox[{
    SubscriptBox["A", "\[Delta]"], "L", "\[InvisibleSpace]"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.91242309670814*^9, 3.912423103509994*^9}, {
   3.9124231596653757`*^9, 3.912423180688388*^9}, 3.9124232859159603`*^9, 
   3.912669936094006*^9},ExpressionUUID->"bb9b2b40-3ad0-4bfb-ba4e-\
69130358f414"],

Cell[TextData[{
 "where we will have ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "5cdf77fc-d30a-45fd-a658-121ce7580084"],
 " (up to 3) non-zero singular values corresponding to the columns of ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "68d8e239-3fc0-4903-8550-43d0f73733ab"],
 " that change the bond length (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["W", "\[Delta]"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "02ef9c5d-c0bc-4ca5-be62-c9dc3bd51bd5"],
 ") and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"3", "\[InvisibleSpace]", "N"}], "\[Minus]", "6", "\[Minus]", 
    "k"}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "f6a11291-a92c-4345-a2ea-ce15be9a794c"],
 " columns of ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "2b69d36f-fad5-489f-a089-4de7434252ff"],
 " that correspond to the dimensions that do not change the bond length (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["W", "P"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "32437da4-335f-4d84-925a-6a1dac800fb7"],
 ")"
}], "ExpositoryText",
 InitializationCell->True,
 CellChangeTimes->{{3.912423185037363*^9, 3.912423242619122*^9}, {
  3.912423293650041*^9, 3.91242337136001*^9}, {3.912669946794643*^9, 
  3.9126699630299673`*^9}},ExpressionUUID->"f6024c7c-ec7e-4263-8273-\
baec4f8425f3"],

Cell[TextData[{
 "Moreover, to actually determine how the bond lengths change, given a set of \
",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "561735fd-74a5-45b7-98b5-7bf1c4f974df"],
 " displacements along these new modes, ",
 Cell[BoxData[
  FormBox[
   StyleBox["q",
    FontWeight->"Bold"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "875ce7d5-8676-424d-980b-39fead4ec7bb"],
 ", we can note that we\[CloseCurlyQuote]ll have an initial set of ",
 Cell[BoxData[
  FormBox["\[Delta]", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "317f3daa-453a-44c0-9637-624fc92d2291"],
 " coordinates given by"
}], "ExpositoryText",
 CellChangeTimes->{{3.912668964451865*^9, 3.912669063097542*^9}, {
  3.912669220284939*^9, 
  3.912669221848976*^9}},ExpressionUUID->"65e7b30c-66cb-4b4a-872e-\
15e1f3889ed3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Delta]",
     FontWeight->"Bold"], "0"], " ", "=", " ", 
   RowBox[{
    SubscriptBox["A", "\[Delta]"], "\[InvisibleSpace]", 
    StyleBox["c",
     FontWeight->"Bold"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.91266905544571*^9, 3.912669089996394*^9}, {
   3.9126692239284487`*^9, 3.912669224250407*^9}, 
   3.912669264018394*^9},ExpressionUUID->"2219ff4d-439d-470d-989f-\
60aee0f6a27f"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   StyleBox["c",
    FontWeight->"Bold"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "f429683e-17e8-4d38-8c22-f20519ec3dd5"],
 " is the vector of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[InvisibleSpace]", "N"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "16074bc5-24de-4175-b4eb-ae166b6f1208"],
 " coordinates and to get the change in these coordinates we simply note that \
the unit change is given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["A", "\[Delta]"], "L", "\[InvisibleSpace]", 
    SubscriptBox["W", "\[Delta]"]}], TraditionalForm]],ExpressionUUID->
  "35c52e9d-4887-4fe7-8cf0-7da65bf4691c"],
 " and so in total we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.912669227770276*^9, 3.9126692772700233`*^9}, {
  3.912669985761606*^9, 3.912670008778604*^9}, {3.9126700419915524`*^9, 
  3.912670052090315*^9}},ExpressionUUID->"0dc5fcb7-6c2d-4f5d-a477-\
1e362c9e8611"],

Cell[BoxData[
 FormBox[
  RowBox[{"r", " ", "=", " ", 
   RowBox[{"\[LeftBracketingBar]", "\[VeryThinSpace]", 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Delta]",
       FontWeight->"Bold"], "0"], "+", 
     RowBox[{
      SubscriptBox["A", "\[Delta]"], "L", "\[InvisibleSpace]", 
      SubscriptBox["W", "\[Delta]"], "\[InvisibleSpace]", 
      StyleBox["q",
       FontWeight->"Bold"]}]}], "\[RightBracketingBar]"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.912669405188936*^9, 3.912669407191834*^9}, {
  3.9126694652472258`*^9, 3.912669504427706*^9}, {3.9126695612919683`*^9, 
  3.9126695657988167`*^9}, {3.912669854629052*^9, 3.912669863764729*^9}, {
  3.912670055651476*^9, 
  3.912670056947894*^9}},ExpressionUUID->"1d9a320f-3d56-4676-9d22-\
324b9ab2bd68"],

Cell[TextData[{
 "and then to get derivatives with respect to the normal modes we start by \
writing ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[Delta]",
     FontWeight->"Bold"], " ", "=", " ", 
    RowBox[{
     SubscriptBox["A", "\[Delta]"], "L", "\[InvisibleSpace]", 
     SubscriptBox["W", "\[Delta]"], "\[InvisibleSpace]", 
     StyleBox["q",
      FontWeight->"Bold"]}]}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "1841e691-ff7d-40da-b09b-0865901a9bd4"],
 " because we already have formulae for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox[
      StyleBox["\[Delta]",
       FontWeight->"Bold"], "n"]], "r"}], TraditionalForm]],
  CellChangeTimes->{{3.912670948106488*^9, 3.912670970158511*^9}},
  ExpressionUUID->"a47fd436-574a-4bd6-94e1-340730f66f26"],
 ", and so we know"
}], "ExpositoryText",
 CellChangeTimes->{{3.912669644308897*^9, 3.91266964474074*^9}, {
  3.912669760044142*^9, 3.9126698060614967`*^9}, {3.912671353479005*^9, 
  3.9126713945684443`*^9}},ExpressionUUID->"9c5f0b9e-4fcb-4af5-87b6-\
2588a7837c06"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["q", "n"]], "r"}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "q"], "\[Delta]"}], " ", 
       SuperscriptBox["\[CircleDot]", "n"], " ", 
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox[
          StyleBox["\[Delta]",
           FontWeight->"Bold"], "n"]], "r"}]}]}]},
    {
     RowBox[{" ", 
      RowBox[{"=", " ", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["A", "\[Delta]"], "L", "\[InvisibleSpace]", 
           SubscriptBox["W", "\[Delta]"]}], ")"}], "T"], " ", 
        SuperscriptBox["\[CircleDot]", "n"], " ", 
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox[
           StyleBox["\[Delta]",
            FontWeight->"Bold"], "n"]], "r"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.912670948106488*^9, 3.912670970158511*^9}, {
  3.9126712917799997`*^9, 3.912671320496016*^9}, {3.912671407102693*^9, 
  3.912671434551174*^9}, {3.912672097376099*^9, 
  3.912672101436227*^9}},ExpressionUUID->"af3256e4-37ce-4bc8-b784-\
13bb1d656443"],

Cell["\<\
and then to get back to the normal mode derivatives we can write\
\>", "ExpositoryText",
 CellChangeTimes->{{3.912672111977066*^9, 
  3.912672139369398*^9}},ExpressionUUID->"be5142ed-3397-41ae-a334-\
7c29fd093a94"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["l", "n"]], "r"}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "L"], "\[Delta]"}], " ", 
       SuperscriptBox["\[CircleDot]", "n"], " ", 
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox[
          StyleBox["\[Delta]",
           FontWeight->"Bold"], "n"]], "r"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "L"], "q"}], 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", "q"], "\[Delta]"}], " ", 
        SuperscriptBox["\[CircleDot]", "n"], " ", 
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox[
           StyleBox["\[Delta]",
            FontWeight->"Bold"], "n"]], "r"}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SuperscriptBox[
        SubscriptBox["W", "\[Delta]"], 
        RowBox[{"-", "1"}]], 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["A", "\[Delta]"], "L", "\[InvisibleSpace]", 
           SubscriptBox["W", "\[Delta]"]}], ")"}], "T"], " ", 
        SuperscriptBox["\[CircleDot]", "n"], " ", 
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox[
           StyleBox["\[Delta]",
            FontWeight->"Bold"], "n"]], "r"}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["A", "\[Delta]"], "L"}], ")"}], "T"], " ", 
       SuperscriptBox["\[CircleDot]", "n"], " ", 
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox[
          StyleBox["\[Delta]",
           FontWeight->"Bold"], "n"]], "r"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.912672128563805*^9, 
  3.9126721968010283`*^9}},ExpressionUUID->"cfa9a35f-1076-4577-abdd-\
8c1f09b89a17"],

Cell[TextData[{
 "which is actually something we could have known without needing the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["W", "\[Delta]"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "d8919c66-c363-4f37-821b-8273815b65a8"],
 " step but oh well..."
}], "ExpositoryText",
 CellChangeTimes->{{3.912672241898099*^9, 
  3.91267227031709*^9}},ExpressionUUID->"c56ada56-7322-4c69-a313-\
f26aba67110e"],

Cell["Then to get what we really need,", "ExpositoryText",
 CellChangeTimes->{{3.91348715069633*^9, 
  3.913487157781521*^9}},ExpressionUUID->"555bd1e1-03b0-4db6-8837-\
9a7f99e75c1e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["l", "n"]], 
    RowBox[{"f", "(", "r", ")"}]}], " ", "=", " ", 
   RowBox[{"T", "(", 
    RowBox[{
     RowBox[{"[", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "l"], "r"}], ",", " ", 
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox["l", "2"]], "r"}], ",", " ", "..."}], "]"}], ",", " ", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "r"], "f"}], ",", " ", 
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox["r", "2"]], "f"}], ",", " ", "..."}], "]"}]}], 
    ")"}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9134871628612328`*^9, 3.913487254756221*^9}, 
   3.913487562361117*^9},ExpressionUUID->"97fa5d5b-68f0-47f9-b04f-\
051457db316f"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "1dafb7e8-a357-4752-84ed-0ba62ee90c18"],
 " is just a standard tensor derivative conversion obtained by mapping out \
all of the necessary transformations"
}], "ExpositoryText",
 CellChangeTimes->{{3.913487246707584*^9, 
  3.913487276162405*^9}},ExpressionUUID->"f95278b8-dd85-4403-a017-\
2acf9decd968"],

Cell[CellGroupData[{

Cell["Alternate Derivative Issues", "Subsubsubsection",
 CellChangeTimes->{{3.914483919810066*^9, 
  3.914483927197948*^9}},ExpressionUUID->"31236a35-6ec5-405d-b432-\
158b0a6b8b48"],

Cell["We really have", "ExpositoryText",
 CellChangeTimes->{{3.91448393107259*^9, 
  3.914483935218227*^9}},ExpressionUUID->"04fe4359-bc1a-49ce-8dff-\
f1db37a0051e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["A", "\[Delta]"], "L"}], " ", "=", " ", 
   RowBox[{
    SubscriptBox["\[Del]", "\[Delta]"], "q"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9144838125560083`*^9, 3.9144838208399897`*^9}, {
  3.914483940463142*^9, 
  3.914483948819085*^9}},ExpressionUUID->"686cfde0-9810-46df-995d-\
8d7e682276c3"],

Cell["but can we say ", "ExpositoryText",
 CellChangeTimes->{{3.914483975183474*^9, 
  3.914483977417863*^9}},ExpressionUUID->"13b212f9-4052-4124-91d5-\
a1c0f06c43f2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Angles", "Subsubsection",
 CellChangeTimes->{{3.9127063355191393`*^9, 
  3.912706338770029*^9}},ExpressionUUID->"d318bf20-d410-4dd7-b711-\
dc590513fab4"],

Cell["Angles are given by", "ExpositoryText",
 CellChangeTimes->{{3.912706385715355*^9, 
  3.9127063877975903`*^9}},ExpressionUUID->"5724ebfe-bf30-49ff-93c7-\
99c2cbbb970b"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["\[Theta]", 
       RowBox[{"i", "\[VeryThinSpace]", "j", "\[VeryThinSpace]", "k"}]], "=", 
      
      RowBox[{
       SuperscriptBox["tan", 
        RowBox[{"-", "1"}]], "(", 
       RowBox[{
        FractionBox[
         RowBox[{"\[LeftBracketingBar]", 
          RowBox[{"a", "\[Times]", "b"}], "\[RightBracketingBar]"}], 
         RowBox[{
          RowBox[{"\[LeftBracketingBar]", "a", "\[RightBracketingBar]"}], 
          RowBox[{"\[LeftBracketingBar]", "b", "\[RightBracketingBar]"}]}]], 
        ",", " ", 
        FractionBox[
         RowBox[{"a", "\[CenterDot]", "b"}], 
         RowBox[{
          RowBox[{"\[LeftBracketingBar]", "a", "\[RightBracketingBar]"}], 
          RowBox[{"\[LeftBracketingBar]", "b", "\[RightBracketingBar]"}]}]]}],
        ")"}]}], 
     RowBox[{
      RowBox[{"where", " ", "a"}], "=", 
      RowBox[{
       RowBox[{
        SubscriptBox["x", "j"], "-", 
        RowBox[{
         SubscriptBox["x", "i"], " ", "and", " ", "b"}]}], "=", 
       RowBox[{
        SubscriptBox["x", "k"], "-", 
        SubscriptBox["x", "i"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.812576777871045*^9, 
  3.8125767830519953`*^9}},ExpressionUUID->"151a83d9-4bdd-41e2-b8dc-\
b62bf18ccee6"],

Cell[TextData[{
 "Therefore to get a change we either need a change in ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["a", "^"], TraditionalForm]],
  CellChangeTimes->{{3.9127084878065777`*^9, 3.9127084899488363`*^9}},
  ExpressionUUID->"46cd8a1c-6d97-42d5-acf0-af451a8c60fc"],
 " or ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["b", "^"], TraditionalForm]],
  CellChangeTimes->{{3.9127084878065777`*^9, 3.9127084899488363`*^9}},
  ExpressionUUID->"33a5ecbe-4d5a-4acd-bef7-587aca8b0c66"],
 ", which means to ",
 StyleBox["avoid",
  FontSlant->"Italic"],
 " changing the bond length we need to either shift every coordinate by the \
same amount or we need to displace along ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["a", "^"], TraditionalForm]],
  CellChangeTimes->{{3.9127084878065777`*^9, 3.9127084899488363`*^9}},
  ExpressionUUID->"592ff04d-98e3-4676-89bc-a48fa9791947"],
 " or ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["b", "^"], TraditionalForm]],
  CellChangeTimes->{{3.9127084878065777`*^9, 3.9127084899488363`*^9}},
  ExpressionUUID->"668b5220-162a-4a83-a523-ca1a3c1bae07"],
 ", we can set up a simple basis for this by taking every possible vector we \
can think of that doesn\[CloseCurlyQuote]t change the angle and \
orthogonalizing this, leading in general to a basis of about 5 vectors that \
don\[CloseCurlyQuote]t change the angle"
}], "ExpositoryText",
 CellChangeTimes->{{3.912706432239624*^9, 3.9127064449092693`*^9}, {
  3.912706481105516*^9, 3.912706512611384*^9}, {3.912708419659511*^9, 
  3.9127085311982822`*^9}, {3.912708684192919*^9, 3.9127087070237217`*^9}, {
  3.9127087444389668`*^9, 3.9127087772011757`*^9}, {3.912710026411899*^9, 
  3.912710026623843*^9}, {3.912718279532631*^9, 3.912718302911909*^9}, {
  3.9127183451184387`*^9, 
  3.912718383679769*^9}},ExpressionUUID->"af2dd983-882e-4e8f-980e-\
44f7a41fcbcc"],

Cell[TextData[{
 "We can then project this basis ",
 StyleBox["out",
  FontSlant->"Italic"],
 " of the normal modes and compute the nullspace for this to find both the \
proper angle-changing modes and the corresponding complement"
}], "ExpositoryText",
 CellChangeTimes->{{3.912718392861108*^9, 
  3.912718447237804*^9}},ExpressionUUID->"9b215c1d-ec1d-41b7-9349-\
85e9d7da1121"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Generic Form", "Subsubsection",
 CellChangeTimes->{{3.9127730978662243`*^9, 
  3.9127730994657793`*^9}},ExpressionUUID->"4c11f085-28e8-4656-9f36-\
0e4a88f59180"],

Cell["If we have some internal coordinate \[Rho], which ", "ExpositoryText",
 CellChangeTimes->{{3.912773101518218*^9, 
  3.912773114324264*^9}},ExpressionUUID->"3d46116a-4300-4cc3-924a-\
89ab5ce56fa2"]
}, Closed]],

Cell[CellGroupData[{

Cell["Tests", "Subsubsection",
 CellChangeTimes->{{3.912154998586544*^9, 
  3.912154999320958*^9}},ExpressionUUID->"6a612d70-9782-4c93-aba1-\
b080808dacea"],

Cell[CellGroupData[{

Cell["Setup", "Subsubsubsection",
 CellChangeTimes->{{3.912156143557905*^9, 
  3.912156144361821*^9}},ExpressionUUID->"90a065c1-36e3-4b72-8bd9-\
5666c734119a"],

Cell[CellGroupData[{

Cell["Data", "Subsubsubsubsection",
 CellChangeTimes->{{3.9121563367738733`*^9, 
  3.912156337331175*^9}},ExpressionUUID->"05547a2d-92cb-4cc7-bc60-\
ac1c504fbb5c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"h2oCoords", "=", 
   RowBox[{"ImportString", "[", 
    RowBox[{
    "\"\<[[-5.91645679e-31,  0.00000000e+00,  2.25076607e-01],\n              \
 [-3.15544362e-30,  1.43714391e+00, -9.00306427e-01],\n               \
[-1.75999369e-16, -1.43714391e+00, -9.00306427e-01]]\>\"", ",", 
     "\"\<JSON\>\""}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.912446198067099*^9, 3.912446219224503*^9}, {
  3.9124462499704247`*^9, 3.912446256267948*^9}},
 CellLabel->
  "In[1278]:=",ExpressionUUID->"0b08c7a3-7738-44d4-ad80-83e2efa2b6ac"],

Cell[BoxData[
 RowBox[{
  RowBox[{"h2o2DStretchCoords", "=", 
   RowBox[{
    RowBox[{
