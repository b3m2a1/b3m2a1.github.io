  3.885727349973639*^9}},ExpressionUUID->"4d48ee9a-7749-436d-881a-\
4dad59299777"],

Cell[TextData[{
 "Then if we want to work ",
 StyleBox["only",
  FontSlant->"Italic"],
 " in the vibrational coordinates we can simply drop the translation-rotation \
components (given how marginal distributions of multivariate Gaussians work)"
}], "ExpositoryText",
 CellChangeTimes->{{3.88572741103476*^9, 
  3.885727454287676*^9}},ExpressionUUID->"50d4e2e7-5e5d-4d41-9043-\
732d17f0f21c"],

Cell["\<\
We also need to work out how the center will shift. We start by expressing \
the centroid coordinates in the vibrational coordinates\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8867740799693003`*^9, 3.886774091918995*^9}, {
  3.8867756208431263`*^9, 
  3.886775631954977*^9}},ExpressionUUID->"ad602dc5-d5f4-4c5f-985c-\
c79f9d8f49e9"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox["\[Xi]", 
       RowBox[{"(", "c", ")"}]], " ", "=", " ", 
      RowBox[{
       SuperscriptBox["\[CapitalSigma]", 
        RowBox[{"(", "c", ")"}]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SuperscriptBox[
           SuperscriptBox["\[CapitalSigma]", 
            RowBox[{"(", "i", ")"}]], 
           RowBox[{"-", "1"}]], "\[InvisibleSpace]", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", "i", ")"}]]}], " ", "+", " ", 
         RowBox[{
          SuperscriptBox[
           SuperscriptBox["\[CapitalSigma]", 
            RowBox[{"(", "j", ")"}]], 
           RowBox[{"-", "1"}]], "\[InvisibleSpace]", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", "j", ")"}]]}]}], ")"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SuperscriptBox["\[CapitalSigma]", 
        RowBox[{"(", "c", ")"}]], "(", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          RowBox[{"L", "(", 
           SuperscriptBox["\[CapitalLambda]", 
            RowBox[{"(", "i", ")"}]], ")"}], 
          RowBox[{"-", "1"}]], 
         SuperscriptBox["L", 
          StyleBox["T",
           FontSize->9,
           FontSlant->"Plain"]], 
         SuperscriptBox["\[Xi]", 
          RowBox[{"(", "i", ")"}]]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"L", "(", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"R", "(", 
             SuperscriptBox["\[CapitalLambda]", 
              RowBox[{"(", "j", ")"}]], ")"}], 
            RowBox[{"-", "1"}]], 
           SuperscriptBox["R", 
            StyleBox["T",
             FontSize->9,
             FontSlant->"Plain"]]}], ")"}], 
         SuperscriptBox["L", 
          StyleBox["T",
           FontSize->9,
           FontSlant->"Plain"]], 
         SuperscriptBox["\[Xi]", 
          RowBox[{"(", "j", ")"}]]}]}], ")"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8838473346089563`*^9, 3.8838473971907187`*^9}, {
  3.884087072420064*^9, 3.884087114362184*^9}, {3.884222365479918*^9, 
