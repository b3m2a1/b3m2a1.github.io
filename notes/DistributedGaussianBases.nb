       "BraKet"], " ", "=", " ", 
      FractionBox[
       TemplateBox[{
         RowBox[{"\[VeryThinSpace]", 
           SubscriptBox["\[CurlyPhi]", "i"], "\[VeryThinSpace]"}], 
         RowBox[{" ", 
           SubscriptBox["\[Phi]", "k"], "\[ThinSpace]"}]},
        "BraKet"], 
       TemplateBox[{
         RowBox[{"\[VeryThinSpace]", 
           SubscriptBox["\[CurlyPhi]", "i"], "\[VeryThinSpace]"}], 
         RowBox[{" ", 
