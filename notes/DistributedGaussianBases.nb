Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"f", "(", 
    RowBox[{"n", ",", " ", "m"}], ")"}], " ", "=", " ", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"max", "(", 
          RowBox[{"m", ",", " ", 
           RowBox[{"n", "-", 
            RowBox[{"2", "\[InvisibleSpace]", "m"}]}]}], ")"}], "+", "1"}], 
        ",", " ", "n"}], ")"}], "!"}], 
     RowBox[{
      RowBox[{"min", "(", 
       RowBox[{"m", ",", " ", 
        RowBox[{"n", "-", 
         RowBox[{"2", "\[InvisibleSpace]", "m"}]}]}], ")"}], "!"}]], " ", "=",
     " ", 
    TagBox[GridBox[{
       {"\[Piecewise]", GridBox[{
          {
           FractionBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"n", "-", 
                RowBox[{"2", "\[InvisibleSpace]", "m"}], "+", "1"}], ",", " ",
                "n"}], ")"}], "!"}], 
            RowBox[{"m", "!"}]], 
           RowBox[{"m", " ", "<", " ", 
            RowBox[{"n", "/", "3"}]}]},
          {
           FractionBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"m", "+", "1"}], ",", " ", "n"}], ")"}], "!"}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"n", "-", 
               RowBox[{"2", "\[InvisibleSpace]", "m"}]}], ")"}], "!"}]], 
           "else"}
         },
