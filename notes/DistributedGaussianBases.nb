  3.9075560029490147`*^9}},ExpressionUUID->"5a8735d8-61a9-4622-8d84-\
f9c2e43e077b"],

Cell["and so", "ExpositoryText",
 CellChangeTimes->{{3.907556006040833*^9, 
  3.907556006913261*^9}},ExpressionUUID->"e70cdccf-4caa-4806-bec8-\
1ae83fdad962"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[CapitalSigma]", "c"], " ", "=", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["\[CapitalSigma]", "i", 
        RowBox[{"-", "1"}]], "+", 
