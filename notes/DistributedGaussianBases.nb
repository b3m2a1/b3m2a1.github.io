  3.916089003392981*^9}},ExpressionUUID->"1851b45d-5c33-4649-a416-\
f8238df70895"],

Cell["\<\
We can integrate along the rotated coordinates, but it is perhaps more useful \
to have expressions in terms of the covariance matrices\
\>", "ExpositoryText",
 CellChangeTimes->{{3.9160888775997753`*^9, 
  3.916088928603924*^9}},ExpressionUUID->"bbba0928-4481-41bc-9f64-\
2432bcebef96"],

Cell["The basic form of the integrals will be, e.g.,", "ExpositoryText",
 CellChangeTimes->{{3.9161095655256367`*^9, 3.9161095891093493`*^9}, {
  3.916166391669931*^9, 
  3.916166391894664*^9}},ExpressionUUID->"4ab094e8-c8bb-4957-84db-\
cda59a7cb122"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Integral]", 
   RowBox[{
    RowBox[{"A", "\[InvisibleSpace]", "(", 
     RowBox[{"Q", "-", 
      SuperscriptBox["\[Xi]", 
       RowBox[{"(", 
        RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], 
    SuperscriptBox["\[CurlyPhi]", 
     RowBox[{"(", "i", ")"}]], 
    SuperscriptBox["\[CurlyPhi]", 
     RowBox[{"*", 
      RowBox[{"(", "j", ")"}]}]]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916109573374482*^9, 3.916109606575232*^9}, {
