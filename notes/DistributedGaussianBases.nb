  3.8865473590721397`*^9}},ExpressionUUID->"c7590199-e1bb-47f9-aca4-\
2e2eccb9290f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["P", 
     StyleBox["n",
      FontWeight->"Bold"], 
     RowBox[{"(", "i", ")"}]], "(", "x", ")"}], "=", 
   RowBox[{
    SqrtBox[
     FractionBox["1", 
      RowBox[{
       StyleBox["n",
        FontWeight->"Bold"], 
       StyleBox["!",
        FontWeight->"Plain"]}]]], "\[InvisibleSpace]", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["P",
       FontWeight->"Bold"], 
      StyleBox["n",
       FontWeight->"Bold"], 
      RowBox[{"(", "i", ")"}]], "\[CircleDot]", 
     SuperscriptBox["\[Chi]", 
      StyleBox["n",
