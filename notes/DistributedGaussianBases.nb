       RowBox[{"i", ",", "j"}], ")"}]], "(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[CapitalSigma]", 
        SuperscriptBox[
         RowBox[{"(", "j", ")"}], 
         RowBox[{"-", "1"}]]], 
       SuperscriptBox["\[CapitalSigma]", 
        RowBox[{"(", "c", ")"}]], 
       SuperscriptBox["J", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]]}], " ", "+", " ", 
