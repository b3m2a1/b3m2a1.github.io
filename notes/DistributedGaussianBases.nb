        SubscriptBox["x", 
         RowBox[{"k", ","}]], "0"}], ",", " ", "\[Alpha]"}], ")"}], 
     SuperscriptBox[
      SubscriptBox["x", 
       RowBox[{"\[VeryThinSpace]", "k"}]], 
      SubscriptBox["p", "k"]]}]}], " ", "=", " ", 
   TagBox[GridBox[{
      {"\[Piecewise]", GridBox[{
         {
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox[
              RowBox[{"2", 
               SuperscriptBox["\[Alpha]", 
                RowBox[{"-", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"2", 
                    SubscriptBox["p", "k"]}], "+", "1"}], ")"}]}]]}], 
              "\[Pi]"], ")"}], 
            RowBox[{"1", "/", "4"}]], 
           RowBox[{"\[CapitalGamma]", "(", 
            FractionBox[
             RowBox[{
              SubscriptBox["p", "k"], "+", "1"}], "2"], ")"}], " "}], 
          RowBox[{
           SubscriptBox["p", "k"], " ", "even"}]},
         {"0", "else"}
        },
