  3.914165314384892*^9}},ExpressionUUID->"613dcc83-1475-40d2-a0e9-\
8392effc539b"],

Cell["\<\
We can then make use of the symmetries of the Coriolis constants to rearrange \
this, in particular we know\
\>", "ExpositoryText",
 CellChangeTimes->{{3.914119552890585*^9, 
  3.9141196818925467`*^9}},ExpressionUUID->"2d7c99a4-c18a-4b64-bd27-\
81865a0f95f6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[Zeta]", 
     RowBox[{"i", "\[InvisibleSpace]", "j"}], "\[Alpha]"], 
    SubsuperscriptBox["\[Zeta]", 
     RowBox[{"k", "\[InvisibleSpace]", "l"}], "\[Alpha]"]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Zeta]", 
      RowBox[{"k", "\[InvisibleSpace]", "l"}], "\[Alpha]"], 
     SubsuperscriptBox["\[Zeta]", 
      RowBox[{"i", "\[InvisibleSpace]", "j"}], "\[Alpha]"]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"-", 
      SubsuperscriptBox["\[Zeta]", 
       RowBox[{"i", "\[InvisibleSpace]", "j"}], "\[Alpha]"]}], 
     SubsuperscriptBox["\[Zeta]", 
      RowBox[{"l", "\[InvisibleSpace]", "k"}], "\[Alpha]"]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.914119621793619*^9, 3.9141196218175373`*^9}, {
