Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DGB", "[", 
     RowBox[{"\[Alpha]_", ",", " ", "\[Xi]_"}], "]"}], "[", 
    "\"\<Normalization\>\"", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"2", " ", 
      RowBox[{"\[Alpha]", " ", "/", " ", "\[Pi]"}]}], ")"}], "^", 
    RowBox[{"(", 
     RowBox[{"1", "/", "4"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DGB", "[", 
     RowBox[{"\[Alpha]_", ",", " ", "\[Xi]_"}], "]"}], "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", " ", 
       RowBox[{"\[Alpha]", " ", "/", " ", "\[Pi]"}]}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"1", "/", "4"}], ")"}]}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "\[Alpha]"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", "-", "\[Xi]"}], ")"}], "^", "2"}]}], "]"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.8958804824850073`*^9, 3.895880540773081*^9}, {
