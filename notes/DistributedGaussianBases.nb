 CellChangeTimes->{{3.884357961325452*^9, 
  3.884357999602421*^9}},ExpressionUUID->"2ced672c-bf53-4565-b59e-\
4e97bf14970c"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Integral]", 
        SuperscriptBox["\[DoubleStruckCapitalR]", "N"]], 
       RowBox[{
        FractionBox["1", "W"], 
        RowBox[{
         RowBox[{
          SubscriptBox["\[Del]", 
           SuperscriptBox["X", "m"]], "\[AlignmentMarker]", 
          RowBox[{"V", "(", "\[Zeta]", ")"}]}], "\[CircleDot]", 
         SuperscriptBox[
          RowBox[{"(", "x", ")"}], "m"]}], "\[AlignmentMarker] ", 
        RowBox[{"\[Phi]", "(", 
         RowBox[{"x", ",", " ", 
          RowBox[{
           SubscriptBox["\[Xi]", "c"], "-", "\[Zeta]"}], ",", " ", 
          SubscriptBox["\[CapitalSigma]", "c"]}], ")"}], 
        RowBox[{"\[DifferentialD]", 
         StyleBox["x",
          FontWeight->"Bold"]}]}]}], 
      StyleBox[" ",
       FontWeight->"Bold"], "=", " "}]},
    {
     RowBox[{"\[AlignmentMarker]", 
      RowBox[{"=", " ", 
       RowBox[{
        SubscriptBox["\[Integral]", 
         SuperscriptBox["\[DoubleStruckCapitalR]", "N"]], 
        RowBox[{
         FractionBox["1", "W"], 
         RowBox[{
          RowBox[{
           SubscriptBox["\[Del]", 
            SuperscriptBox["Q", "m"]], 
           RowBox[{"V", "(", 
            StyleBox["\[Zeta]",
             FontWeight->"Bold"], ")"}]}], "\[CircleDot]", 
          SuperscriptBox[
           RowBox[{"(", "q", ")"}], "m"]}], "\[AlignmentMarker] ", 
         RowBox[{"\[Phi]", "(", 
          RowBox[{"q", ",", " ", 
           RowBox[{
            SubscriptBox[
             RowBox[{"L", "\[InvisibleSpace]"}], "c"], 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["\[Xi]", "c"], "-", "\[Zeta]"}], ")"}]}], ",", " ", 
           SubscriptBox["\[CapitalLambda]", "c"]}], ")"}], 
         RowBox[{"\[DifferentialD]", 
          StyleBox["q",
           FontWeight->"Bold"]}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCenteredManuallyAligned",
 CellChangeTimes->{{3.8843580164872828`*^9, 3.884358025850543*^9}, {
  3.8843599384600058`*^9, 3.884359944574727*^9}, {3.8843600878849897`*^9, 
  3.884360152283752*^9}, {3.8843603231431303`*^9, 3.884360387456635*^9}, {
  3.884361626574113*^9, 
  3.884361750080554*^9}},ExpressionUUID->"c4a74be9-51ab-4ade-b0a6-\
f6025e294b6f"],

Cell[TextData[{
 "which can be evaluated using what we did previously after recognizing that \
we have a linear transformation between ",
 Cell[BoxData[
  FormBox[
   StyleBox["q",
    FontWeight->"Bold"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "bc58c7f1-65f8-4110-a0db-77fc086115cd"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["x",
    FontWeight->"Bold"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "65cc4afe-f758-4d35-a45e-21df3cbb2421"],
 " and so"
}], "ExpositoryText",
 CellChangeTimes->{{3.8843619025629187`*^9, 
  3.884361926538348*^9}},ExpressionUUID->"6ce2f9fe-d929-4b0e-a080-\
7378ecc85d22"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["Q", "m"]], 
    RowBox[{"V", "(", 
     StyleBox["\[Zeta]",
      FontWeight->"Bold"], ")"}]}], " ", "=", " ", 
   RowBox[{
    SubscriptBox["L", "c"], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"2", ",", " ", "m"}], "\[RightAngleBracket]"}], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["L", "c"], 
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{"2", ",", " ", "m"}], "\[RightAngleBracket]"}], 
      RowBox[{"(", 
       RowBox[{"...", 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["L", "c"], 
          RowBox[{"\[LeftAngleBracket]", 
           RowBox[{"2", ",", " ", "m"}], "\[RightAngleBracket]"}], 
          RowBox[{
           SubscriptBox["\[Del]", 
            SuperscriptBox["X", "m"]], 
           RowBox[{"V", "(", 
            StyleBox["\[Zeta]",
             FontWeight->"Bold"], ")"}]}]}], ")"}]}], ")"}]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.884361758931106*^9, 3.884361761086817*^9}, {
  3.884361807934321*^9, 
  3.884361882215866*^9}},ExpressionUUID->"2e094053-cb43-4400-adee-\
4e3bac770b27"],

Cell["\<\
which is equivalent to just rotating the derivatives as claimed previously\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8843616718960543`*^9, 3.884361674671565*^9}, {
  3.884361888665514*^9, 
  3.884361945043182*^9}},ExpressionUUID->"41f4304d-2c42-4fc8-be94-\
e9bed10558fc"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Internal Coordinates", "Section",
 CellChangeTimes->{{3.906640045780553*^9, 
  3.906640048533656*^9}},ExpressionUUID->"7e20dd4d-65ff-4d9e-9b05-\
49fffd981785"],

Cell["\<\
We likely will want to work in internals at some point, for which we have\
\>", "ExpositoryText",
 CellChangeTimes->{{3.906640049676742*^9, 
  3.906640080715673*^9}},ExpressionUUID->"10ee2373-dd2d-4152-9a4e-\
37232b70f1ad"],

Cell[BoxData[
 FormBox[
  RowBox[{"H", " ", "=", " ", 
   RowBox[{
    RowBox[{"p", "\[InvisibleSpace]", "G", "\[InvisibleSpace]", "p"}], " ", 
    "+", " ", 
    RowBox[{"V", "(", "r", ")"}], " ", "+", " ", 
    RowBox[{
     RowBox[{"V", "'"}], "\[InvisibleSpace]", 
     RowBox[{"(", "r", ")"}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.906640082518629*^9, 
  3.906640117434265*^9}},ExpressionUUID->"c1ed8dae-230c-4457-9718-\
274abe6ed086"],

Cell[TextData[{
 "The integrals induced by ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "ec7a59a5-0ca3-44d8-91ba-4459cfd7fa47"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", "'"}], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"33bc1436-0f25-4b84-b91a-372a6416bc4a"],
 " now require some thought"
}], "ExpositoryText",
 CellChangeTimes->{{3.906640223417899*^9, 3.906640244817259*^9}, {
  3.9066403489271317`*^9, 3.906640392647031*^9}, {3.906641543835762*^9, 
  3.906641571041185*^9}},ExpressionUUID->"9aef3a99-f960-4c20-99c7-\
bbd927dae991"],

Cell["Considering just one matrix element, we get", "ExpositoryText",
 CellChangeTimes->{{3.906640223417899*^9, 3.906640244817259*^9}, {
  3.9066403489271317`*^9, 3.906640392647031*^9}, {3.906641543835762*^9, 
  3.906641575519599*^9}},ExpressionUUID->"1f81c778-dc92-48a3-b50d-\
25077fa32b34"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SubscriptBox["\[Phi]", "i"]},
        "Bra"], "T", 
       TemplateBox[{
         SubscriptBox["\[Phi]", "j"]},
        "Ket"]}], " ", "=", " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{"a", ",", "b"}]], " ", 
       RowBox[{
        TemplateBox[{
          SubscriptBox["\[Phi]", "i"]},
         "Bra"], " ", 
        SubscriptBox[
         RowBox[{"p", "\[InvisibleSpace]"}], "a"], "\[InvisibleSpace]", 
        SubscriptBox["G", 
         RowBox[{"a", "\[InvisibleSpace]", "b"}]], "\[VeryThinSpace]\[InvisibleSpace]", 
        SubscriptBox["p", "b"], " ", 
        TemplateBox[{
          SubscriptBox["\[Phi]", "j"]},
         "Ket"], " "}]}]}]},
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SubscriptBox["\[Phi]", "i"]},
        "Bra"], " ", 
       SubscriptBox[
        RowBox[{"p", "\[InvisibleSpace]"}], "a"], "\[InvisibleSpace]", 
       SubscriptBox["G", 
        RowBox[{"a", "\[InvisibleSpace]", "b"}]], "\[VeryThinSpace]\[InvisibleSpace]", 
       SubscriptBox["p", "b"], " ", 
       TemplateBox[{
         SubscriptBox["\[Phi]", "j"]},
        "Ket"]}], "  ", "=", " ", 
      RowBox[{"\[Integral]", " ", 
       RowBox[{
        RowBox[{
         SubscriptBox["G", 
          RowBox[{"a", "\[InvisibleSpace]", "b"}]], "(", "r", ")"}], 
        RowBox[{
         SubscriptBox["\[Phi]", "i"], "(", "r", ")"}], 
        SubscriptBox[
         RowBox[{"p", "\[InvisibleSpace]"}], "a"], "\[InvisibleSpace]\[VeryThinSpace]\[InvisibleSpace]", 
        SubscriptBox["p", "b"], " ", 
        RowBox[{
         SubscriptBox["\[Phi]", "j"], "(", "r", ")"}], " "}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.906640408876895*^9, 3.906640567378027*^9}, {
  3.9066406131111298`*^9, 3.906640623606306*^9}, {3.906640671335153*^9, 
  3.906640715717622*^9}, {3.9066413165229*^9, 3.906641353523387*^9}, {
  3.906641488017379*^9, 
  3.906641529678171*^9}},ExpressionUUID->"b80f29f9-c659-41e3-985b-\
d3d3c9d0ca18"],

Cell[TextData[{
 "where we have assumed the internal coordinates live on the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     RowBox[{"-", "\[Infinity]"}], ",", " ", "\[Infinity]"}], "]"}], 
   TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "f1eef104-fcbc-4012-8942-50a310f06dfe"],
 " range, ignoring the considerations given in Section IV of Frederick and \
Woywood"
}], "ExpositoryText",
 CellChangeTimes->{{3.906641297144883*^9, 3.906641300915001*^9}, {
  3.906641355778839*^9, 3.906641404524761*^9}, {3.9066414425752974`*^9, 
  3.9066414613509407`*^9}},ExpressionUUID->"736ec4c5-68fa-4d37-9420-\
6ca0375f4b72"],

Cell[TextData[{
 "Such integrals are very difficult to handle generically, but we can \
approximate them by again doing local expansions of the ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "4d62e849-4803-41eb-ba1c-674c9db4aa9d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", "'"}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "47310972-f7be-45d1-bcf1-ead09de7405a"],
 " terms"
}], "ExpositoryText",
 CellChangeTimes->{{3.9066414772026443`*^9, 3.906641480074711*^9}, {
  3.906641593584786*^9, 3.906641688188345*^9}, {3.906641754934901*^9, 
  3.9066417551210546`*^9}},ExpressionUUID->"e5e43f73-2f47-4046-93d1-\
d0807193f644"],

Cell[CellGroupData[{

Cell["Rotations", "Subsection",
 CellChangeTimes->{{3.906641788152191*^9, 
  3.9066417901056547`*^9}},ExpressionUUID->"ef1747e7-4c64-4b40-a761-\
c84da008848c"],

Cell["\<\
It is straightforward to use the ideas developed previously for a rotated \
basis in this context, as these are all just polynomial and \
polynomial-product integrals.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.906641794903783*^9, 
  3.9066418275371304`*^9}},ExpressionUUID->"be6dfe90-dec0-471c-8f69-\
50cfe1e55096"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Watson Coordinates", "Section",
 CellChangeTimes->{{3.906640008474597*^9, 3.9066400402849607`*^9}, {
   3.9066419451716537`*^9, 3.9066419469247923`*^9}, 3.914380781042235*^9, 
   3.916348457697234*^9},ExpressionUUID->"6c47517a-1dd7-448b-ae5c-\
191749724ad8"],

Cell["\<\
An alternative to proper internal coordinates is to use a rotated \
Cartesian-displacement normal mode coordinates. To start, \
we\[CloseCurlyQuote]ll note that these coordinates can be expressed as\
\>", "ExpositoryText",
 CellChangeTimes->{{3.906640019421216*^9, 3.9066400201084013`*^9}, {
  3.906640055162553*^9, 3.9066400560424337`*^9}, {3.9066417611867113`*^9, 
  3.9066417841075687`*^9}, {3.906641835144627*^9, 3.906641864050206*^9}, {
  3.9066419489184523`*^9, 
  3.906641967195025*^9}},ExpressionUUID->"d88b4fd7-413c-41c4-87d4-\
dffd69aa6a56"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["q", "i"], " ", "=", " ", 
   RowBox[{
    UnderscriptBox["\[Sum]", "n"], " ", 
    RowBox[{
     SubscriptBox["L", 
      RowBox[{"i", "\[InvisibleSpace]", "n"}]], "\[CapitalDelta]", 
     "\[InvisibleSpace]", 
     SubscriptBox["x", "n"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.906641865301291*^9, 
  3.906641897345193*^9}},ExpressionUUID->"41fd7626-44c5-47ab-b0f9-\
d6508215c85d"],

Cell["\<\
and their overlaps may be computed just like any Gaussian product basis\
\>", "ExpositoryText",
 CellChangeTimes->{{3.9066420045187893`*^9, 3.906642023912513*^9}, {
  3.906880436642387*^9, 
  3.9068804501204357`*^9}},ExpressionUUID->"3a7874c9-06be-462a-a2ac-\
a3d8fd832358"],

Cell["\<\
The difficulty arises in integrating the kinetic energy, where we have\
\>", "ExpositoryText",
 CellChangeTimes->{{3.9068804520444603`*^9, 
  3.906880462491399*^9}},ExpressionUUID->"6c85077c-881e-47c0-b175-\
227891bc4be1"],

Cell[BoxData[
 FormBox[
  RowBox[{"T", " ", "=", " ", 
   RowBox[{
    SuperscriptBox["P", "2"], " ", "+", " ", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{
      UnderscriptBox["\[Sum]", "\[Alpha]"], " ", 
      RowBox[{
       SubsuperscriptBox["I", "\[Alpha]", 
        RowBox[{"-", "1"}]], 
       SuperscriptBox[
        SubscriptBox["p", "\[Alpha]"], "2"]}]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.906880464173218*^9, 3.906880465519929*^9}, {
  3.906881563266612*^9, 3.906881608477417*^9}, {3.906881704165535*^9, 
  3.9068817814218483`*^9}, {3.90688220728264*^9, 3.9068822678898363`*^9}, {
  3.906883985422103*^9, 
  3.906883985786618*^9}},ExpressionUUID->"8cde7a47-8984-4dd9-9642-\
26e6a581b260"],

Cell["for", "ExpositoryText",
 CellChangeTimes->{{3.906881784238551*^9, 
  3.906881785000802*^9}},ExpressionUUID->"1e61c0e8-3db2-44ef-a5ab-\
37cef3d03f64"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["p", "\[Alpha]"], " ", "=", " ", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{"r", ",", "s"}]], " ", 
    RowBox[{
     SubsuperscriptBox["\[Zeta]", 
      RowBox[{"r", "\[InvisibleSpace]", "s"}], "\[Alpha]"], "(", 
     RowBox[{
      RowBox[{
       SubscriptBox["Q", "r"], "\[InvisibleSpace]", 
       SubscriptBox["P", "s"]}], "-", 
      RowBox[{
       SubscriptBox["Q", "s"], "\[InvisibleSpace]", 
       SubscriptBox["P", "r"]}]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.906881789176012*^9, 3.906881823010481*^9}, {
   3.906882368170149*^9, 3.906882380708997*^9}, {3.906883194159746*^9, 
   3.906883236588901*^9}, 3.9068845945833483`*^9, 
   3.906884724059597*^9},ExpressionUUID->"ee88aa1e-3d26-40c1-8ca5-\
c9b4ebcb8a81"],

Cell["where", "ExpositoryText",
 CellChangeTimes->{{3.906883247144606*^9, 
  3.9068832476090508`*^9}},ExpressionUUID->"a78005f8-546c-43ed-b1a7-\
c060bc4f85a2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Zeta]", 
    RowBox[{"r", "\[InvisibleSpace]", "s"}], "\[Alpha]"], " ", "=", " ", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"\[VeryThinSpace]", "\[Beta]"}]], " ", 
     RowBox[{
      UnderscriptBox["\[Sum]", "k"], " ", 
      RowBox[{
       SubscriptBox["L", 
        RowBox[{"r", " ", 
         RowBox[{"(", 
          RowBox[{"k", ",", "\[Beta]"}], ")"}]}]], 
       SubscriptBox["L", 
        RowBox[{"s", " ", 
         RowBox[{"(", 
          RowBox[{"k", ",", "\[Gamma]"}], ")"}]}]]}]}]}], " ", "-", " ", 
    RowBox[{
     SubscriptBox["L", 
      RowBox[{"r", " ", 
       RowBox[{"(", 
        RowBox[{"k", ",", "\[Gamma]"}], ")"}]}]], 
     SubscriptBox["L", 
      RowBox[{"s", " ", 
       RowBox[{"(", 
        RowBox[{"k", ",", "\[Beta]"}], ")"}]}]]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.906881789176012*^9, 3.906881823010481*^9}, {
   3.906882368170149*^9, 3.906882380708997*^9}, {3.906883194159746*^9, 
   3.9068832555947237`*^9}, 3.906883295875146*^9, {3.90688342819773*^9, 
   3.906883439645666*^9}, 3.906883494316102*^9, {3.906883527996385*^9, 
   3.906883609023731*^9}, {3.906883657770183*^9, 3.9068836708872547`*^9}, {
   3.906883751927638*^9, 3.9068837549275227`*^9}, {3.906883841853363*^9, 
   3.9068839053595333`*^9}, {3.948461863049687*^9, 
   3.948461886361124*^9}},ExpressionUUID->"f31b61d3-3a85-4ac6-9379-\
41d3fd8ee782"],

Cell[TextData[{
 "for the cyclic permutations ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[VeryThinSpace]", 
    RowBox[{
     RowBox[{"\[Beta]", " ", "=", " ", 
      RowBox[{"\[Alpha]", "+", 
       RowBox[{"1", " ", "mod", " ", "3"}]}]}], ",", " ", 
     RowBox[{"\[Gamma]", " ", "=", " ", 
      RowBox[{"\[Alpha]", "+", 
       RowBox[{"2", " ", "mod", " ", "3"}]}]}]}]}], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "da768dca-a1fe-497a-b213-5c890b2909ae"]
}], "ExpositoryText",
 CellChangeTimes->{{3.90688361204706*^9, 
  3.906883652121645*^9}},ExpressionUUID->"74ce3246-095a-498b-8405-\
dee4b568dbc9"],

Cell["\<\
This is clearly coming from the a cross-product like term (this is \
classically expressed with the Levi Cevita symbol), which is basically just a \
generator of rotation\
\>", "ExpositoryText",
 CellChangeTimes->{{3.906883917634465*^9, 
  3.906883967666217*^9}},ExpressionUUID->"286e9246-9515-45ce-8810-\
9faae2820354"],

Cell["Notably,", "ExpositoryText",
 CellChangeTimes->{{3.907603933375888*^9, 
  3.9076039342888613`*^9}},ExpressionUUID->"bf0e7fc1-ad69-42ea-aee7-\
2a840d1527f5"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["\[Zeta]", 
       RowBox[{"s", "\[InvisibleSpace]", "r"}], "\[Alpha]"], " ", "=", " ", 
      RowBox[{"-", 
       SubsuperscriptBox["\[Zeta]", 
        RowBox[{"r", "\[InvisibleSpace]", "s"}], "\[Alpha]"]}]}]},
    {
     RowBox[{
      SubsuperscriptBox["\[Zeta]", 
       RowBox[{"r", "\[InvisibleSpace]", "r"}], "\[Alpha]"], " ", "=", " ", 
      "0"}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9076039375037813`*^9, 
  3.907603970147592*^9}},ExpressionUUID->"a0aabe75-91ab-46b9-a344-\
bab50e1639c6"],

Cell["This gives us", "ExpositoryText",
 CellChangeTimes->{{3.9068839916461687`*^9, 
  3.9068839937885647`*^9}},ExpressionUUID->"84bf9b31-bb9b-44d0-bf4e-\
c90e5948565c"],

Cell[BoxData[
 FormBox[
  RowBox[{"T", " ", "=", " ", 
   RowBox[{
    SuperscriptBox["P", "2"], " ", "+", " ", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{"i", ",", "j", ",", "k", ",", "l"}]], " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "\[Alpha]"], " ", 
       RowBox[{
        SubsuperscriptBox["I", "\[Alpha]", 
         RowBox[{"-", "1"}]], 
        SubsuperscriptBox["\[Zeta]", 
         RowBox[{"i", "\[InvisibleSpace]", "j"}], "\[Alpha]"], 
        SubsuperscriptBox["\[Zeta]", 
         RowBox[{"k", "\[InvisibleSpace]", "l"}], "\[Alpha]"], 
        SubscriptBox["Q", "i"], "\[InvisibleSpace]", 
        SubscriptBox["P", "j"], 
        SubscriptBox["Q", "k"], "\[InvisibleSpace]", 
        SubscriptBox["P", "l"]}]}]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.906880464173218*^9, 3.906880465519929*^9}, {
  3.906881563266612*^9, 3.906881608477417*^9}, {3.906881704165535*^9, 
  3.9068817814218483`*^9}, {3.90688220728264*^9, 3.9068822678898363`*^9}, {
  3.906883985422103*^9, 3.906883985786618*^9}, {3.906884619670518*^9, 
  3.9068846445655937`*^9}, {3.906884699684016*^9, 
  3.9068847368561373`*^9}},ExpressionUUID->"27b2bb1a-9a3b-4c1d-b28a-\
edf0e4e03f50"],

Cell[TextData[{
 "We will note that under our approximation, ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "2753f073-bdec-412f-9705-d0f019511324"],
 " is ",
 StyleBox["definitional",
  FontSlant->"Italic"],
 ", which is to say our choice of ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "33229b76-0b58-47b6-ade3-4a61847543c5"],
 " will not change no matter what value of ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "ceeb23c0-b4d7-41ab-9c58-d381070554e6"],
 " we choose. Therefore"
}], "ExpositoryText",
 CellChangeTimes->{{3.906885452010932*^9, 3.90688556003903*^9}, {
  3.906885882799917*^9, 
  3.9068858967365513`*^9}},ExpressionUUID->"0f16ab73-9d19-451b-90c8-\
6a5e1b64fa8b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SubscriptBox["\[Phi]", "n"]},
     "Bra"], " ", 
    SubsuperscriptBox["I", "\[Alpha]", 
     RowBox[{"-", "1"}]], 
    SubsuperscriptBox["\[Zeta]", 
     RowBox[{"i", "\[InvisibleSpace]", "j"}], "\[Alpha]"], 
    SubsuperscriptBox["\[Zeta]", 
     RowBox[{"k", "\[InvisibleSpace]", "l"}], "\[Alpha]"], 
    SubscriptBox["Q", "i"], "\[InvisibleSpace]", 
    SubscriptBox["P", "j"], 
    SubscriptBox["Q", "k"], "\[InvisibleSpace]", 
    SubscriptBox["P", "l"], " ", 
    TemplateBox[{
      SubscriptBox["\[Phi]", "m"]},
     "Ket"]}], " ", "=", " ", 
   RowBox[{
    SubsuperscriptBox["\[Zeta]", 
     RowBox[{"i", "\[InvisibleSpace]", "j"}], "\[Alpha]"], 
    SubsuperscriptBox["\[Zeta]", 
     RowBox[{"k", "\[InvisibleSpace]", "l"}], "\[Alpha]"], 
    TemplateBox[{
      SubscriptBox["\[Phi]", "n"]},
     "Bra"], " ", 
    SubsuperscriptBox["I", "\[Alpha]", 
     RowBox[{"-", "1"}]], 
    SubscriptBox["Q", "i"], "\[InvisibleSpace]", 
    SubscriptBox["P", "j"], 
    SubscriptBox["Q", "k"], "\[InvisibleSpace]", 
    SubscriptBox["P", "l"], " ", 
    TemplateBox[{
      SubscriptBox["\[Phi]", "m"]},
     "Ket"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.90688556245709*^9, 3.906885584889862*^9}, {
  3.907559247274458*^9, 
  3.907559254675674*^9}},ExpressionUUID->"9c915a0e-d3a4-4e36-8052-\
5bc6cb23c89e"],

Cell[TextData[{
 "and then for simplicity, we will also assume ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["I", "\[Alpha]", 
    RowBox[{"\[Minus]", "1"}]], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"d447f0a7-1bf5-4d9f-97cd-ce0c63d5f60b"],
 " is independent of ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "acfc0c59-fd3c-4218-8317-64504b5d69d1"],
 ", although this is simply an approximation (I think)"
}], "ExpositoryText",
 CellChangeTimes->{{3.906885608006983*^9, 3.906885680021597*^9}, {
  3.906885861602385*^9, 3.906885867543494*^9}, {3.906885899125699*^9, 
  3.906885907219901*^9}},ExpressionUUID->"b355127b-3004-4eff-b9d9-\
473621edb13e"],

Cell["This gives us a 4D tensor described by", "ExpositoryText",
 CellChangeTimes->{{3.907166000563151*^9, 
  3.907166009297093*^9}},ExpressionUUID->"f0cccd2c-24ca-40cf-a42a-\
91803e4ddfb5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
   "Q", "\[VeryThinSpace]\[InvisibleSpace]", "P", "\[VeryThinSpace]", "Q", 
    "\[InvisibleSpace]", "P", " ", 
    TemplateBox[{
      SubscriptBox["\[Phi]", "j"]},
     "Ket"]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     SubscriptBox["K", "j"], "(", "q", ")"}], 
    TemplateBox[{
      SubscriptBox["\[Phi]", "j"]},
     "Ket"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.907166015617021*^9, 
  3.9071660565451803`*^9}},ExpressionUUID->"e666aeeb-e5c2-49f5-ac7d-\
52b997e959d1"],

Cell["which we then element-wise multiply into", "ExpositoryText",
 CellChangeTimes->{{3.9071660617885103`*^9, 
  3.907166069674769*^9}},ExpressionUUID->"b9166a6b-6757-47c1-bf46-\
4849b5c6cd4a"],

Cell[BoxData[
 FormBox[
  RowBox[{"Z", " ", "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", "\[Alpha]"], " ", 
    RowBox[{
     SubsuperscriptBox["I", "\[Alpha]", 
      RowBox[{"-", "1"}]], "(", 
     RowBox[{
      SuperscriptBox["\[Zeta]", "\[Alpha]"], "\[CircleTimes]", 
      SuperscriptBox["\[Zeta]", "\[Alpha]"]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9071660736218033`*^9, 
  3.907166143809733*^9}},ExpressionUUID->"1bd9964d-a5a3-4f15-8342-\
ca6df8029694"],

Cell[TextData[{
 "and then we can integrate the tensor expansion induced by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Z", "\[SmallCircle]", 
    SubscriptBox["K", "j"]}], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"b94c3895-04cf-4eb4-bbd3-3c77ea5d88eb"]
}], "ExpositoryText",
 CellChangeTimes->{
  3.907166124632382*^9, {3.907166195136663*^9, 3.907166222495063*^9}, {
   3.907610806344202*^9, 
   3.9076108151633463`*^9}},ExpressionUUID->"a8c71a48-e6f2-4ae3-8b4b-\
60fadec6d095"],

