Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalGamma]", "(", 
     RowBox[{"b", "+", "m"}], ")"}], 
    RowBox[{
     SubscriptBox["F", "1"], "(", 
     RowBox[{
      RowBox[{"b", "+", "m"}], ";", " ", 
      RowBox[{"b", "+", "m"}], ";", " ", 
      RowBox[{"-", 
       FractionBox[
        SuperscriptBox["p", "2"], 
        RowBox[{"4", " ", "a"}]]}]}], ")"}]}], " ", "=", " ", 
   RowBox[{"\[CapitalGamma]", "(", 
    RowBox[{"b", "+", "m"}], ")"}]}], 
