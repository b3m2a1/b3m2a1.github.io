Cell[CellGroupData[{

Cell["Generic Algorithm", "Subsubsubsubsection",
 CellChangeTimes->{{3.916205534500242*^9, 
  3.916205537335065*^9}},ExpressionUUID->"c1910e3c-f84b-4cfa-bd68-\
a246b57d14fa"],

Cell[TextData[StyleBox["NOTE: WE ONLY REALLY NEEDED TO DO THIS FOR THE REAL \
CASE SINCE THE COMPLEX CASE IS THEN JUST ENUMERATING ALL THE LATTICE PATHS OF \
THE FORM \[CapitalSigma]+\[DoubleStruckI]\[VeryThinSpace]\[Rho]",
 FontColor->RGBColor[1, 0, 0]]], "ExpositoryText",
 CellChangeTimes->{{3.916805002004779*^9, 3.916805002841916*^9}, {
  3.916805038938835*^9, 3.9168051398454533`*^9}, {3.916806226773932*^9, 
  3.9168062283458443`*^9}},ExpressionUUID->"a53dcd1e-ff32-49d8-887f-\
214e5e28e9aa"],

Cell[TextData[{
 "Take all integer partitions of ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "1a5ad4d4-d58c-42ad-850a-bf5c41f9f65e"],
 " with maximum element at most 2"
}], "ExpositoryText",
 CellChangeTimes->{{3.91620555864944*^9, 
  3.916205592230254*^9}},ExpressionUUID->"27679169-d675-45c8-80c8-\
b1e90bf1c0a2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Select", "[", 
  RowBox[{
   RowBox[{"IntegerPartitions", "[", "4", "]"}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Max", "[", "#", "]"}], "<=", "2"}], "&"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.916205595062521*^9, 3.916205609814752*^9}},
 CellLabel->
  "In[339]:=",ExpressionUUID->"3b482ee4-e8ac-432c-bc89-69a378a554d3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.916205610302189*^9},
 CellLabel->
  "Out[339]=",ExpressionUUID->"2a986070-fc76-49c4-8a33-f1f76aa9eb73"]
}, Open  ]],

Cell["\<\
The sign of the contribution will depend on the length of the partition\
\>", "ExpositoryText",
 CellChangeTimes->{{3.9162056244463873`*^9, 
  3.9162056524311943`*^9}},ExpressionUUID->"a03d1dae-03d2-400d-addd-\
2c0babfab48e"],

Cell["\<\
These will be our \[OpenCurlyDoubleQuote]bucket \
sizes\[CloseCurlyDoubleQuote], we\[CloseCurlyQuote]ll split the indices we \
have into these buckets\
\>", "ExpositoryText",
 CellChangeTimes->{{3.9162057054395*^9, 
  3.916205756235599*^9}},ExpressionUUID->"9e850242-6b4a-441d-83f1-\
b342771893ce"],

Cell[TextData[{
 "Finally, we\[CloseCurlyQuote]ll do successive swaps between the buckets to \
get unique permutations. This final step is a bit tricky, but for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", " ", "\[LessEqual]", " ", "6"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "ffac2f65-6db9-48c1-9cfb-5e6f03b6e050"],
 " we can do it quickly as there are only ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"6", "!"}], " ", "=", " ", "720"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "31c3440f-0b20-47a4-8aae-f0ba0a6e8a8b"],
 " possible permutations to filter over."
}], "ExpositoryText",
 CellChangeTimes->{{3.9162057588491383`*^9, 3.916205867539497*^9}, {
  3.916237991212727*^9, 
  3.916237991740818*^9}},ExpressionUUID->"071635a5-6365-442c-9954-\
6be6eacea53f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Implementation", "Subsubsubsubsection",
 CellChangeTimes->{{3.916238177229089*^9, 
  3.9162381789919147`*^9}},ExpressionUUID->"12f93928-7e6f-4968-8678-\
1f4f39984659"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"genericIntEval", ",", " ", "giIntegral"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"giBuckets", "[", "k_", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"IntegerPartitions", "[", "k", "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Max", "[", "#", "]"}], "<=", "2"}], "&"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"giPermFilter", "[", 
    RowBox[{"perms_", ",", " ", "bucket_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"DeleteDuplicates", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Sort", "@", 
       RowBox[{
        RowBox[{"Map", "[", "Sort", "]"}], "@", 
        RowBox[{"TakeList", "[", 
         RowBox[{"#", ",", " ", "bucket"}], "]"}]}]}], "&"}], "/@", 
     "\[IndentingNewLine]", "perms"}], "\[IndentingNewLine]", "]"}]}], 
