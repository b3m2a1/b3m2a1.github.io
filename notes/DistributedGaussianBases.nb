Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "\[Infinity]"}], 
     RowBox[{"\[VeryThinSpace]", "\[Infinity]"}]], 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["q", "s"], "-", 
        SubsuperscriptBox["\[Xi]", "s", 
         RowBox[{"(", 
          RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], "k"], 
     SuperscriptBox["\[CurlyPhi]", 
      RowBox[{"(", "i", ")"}]], 
     SuperscriptBox["\[CurlyPhi]", 
      RowBox[{"*", 
       RowBox[{"(", "j", ")"}]}]]}]}], " ", "=", " ", 
   RowBox[{
    FractionBox[
     SubsuperscriptBox["X", "0", 
      RowBox[{"(", 
       RowBox[{"i", ",", "j"}], ")"}]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", 
        SubsuperscriptBox["\[Alpha]", "s", 
         RowBox[{"(", 
          RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], 
      RowBox[{"\[LeftCeiling]", 
       RowBox[{"k", "/", "2"}], "\[RightCeiling]"}]]], 
    TagBox[GridBox[{
       {"\[Piecewise]", GridBox[{
          {
           RowBox[{" ", 
            RowBox[{"\[DoubleStruckI]", "\[InvisibleSpace]\[VeryThinSpace]", 
             SuperscriptBox["p", 
              RowBox[{"(", 
               RowBox[{"i", ",", "j"}], ")"}]], "\[InvisibleSpace]", 
             RowBox[{
              SubsuperscriptBox["M", 
               RowBox[{"3", "/", "2"}], "k"], "(", 
              RowBox[{
               SubsuperscriptBox["\[Alpha]", "s", 
                RowBox[{"(", 
                 RowBox[{"i", ",", "j"}], ")"}]], ",", " ", 
               SubsuperscriptBox["p", "s", 
                RowBox[{"(", 
                 RowBox[{"i", ",", "j"}], ")"}]]}], ")"}]}]}], 
           RowBox[{"k", " ", "odd"}]},
          {
           RowBox[{
            SubsuperscriptBox["M", 
             RowBox[{"1", "/", "2"}], "k"], "(", 
            RowBox[{
             SubsuperscriptBox["\[Alpha]", "s", 
              RowBox[{"(", 
               RowBox[{"i", ",", "j"}], ")"}]], ",", " ", 
             SubsuperscriptBox["p", "s", 
              RowBox[{"(", 
