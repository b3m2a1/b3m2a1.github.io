Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"\[CapitalGamma]", "(", 
     RowBox[{"b", "+", "k"}], ")"}], 
    SubscriptBox[
     RowBox[{"(", "b", ")"}], 
     RowBox[{"(", "n", ")"}]]], " ", "=", 
   RowBox[{
    FractionBox[
     SqrtBox["\[Pi]"], 
     SuperscriptBox["2", 
      RowBox[{"c", "+", "k", "-", "n"}]]], "\[InvisibleSpace]", 
    FractionBox[
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", 
          RowBox[{"(", 
           RowBox[{"c", "+", "k"}], ")"}]}], "-", "1"}], ")"}], "!!"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "\[InvisibleSpace]", "c"}], "-", "1"}], ")"}], "!!"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "\[InvisibleSpace]", 
         RowBox[{"(", 
          RowBox[{"n", "+", "c"}], ")"}]}], "-", "1"}], ")"}], "!!"}]]}]}], 
