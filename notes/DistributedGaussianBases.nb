Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "x"], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          UnderscriptBox["\[Sum]", "j"], " ", 
          RowBox[{"|", 
           RowBox[{"x", "-", 
            SuperscriptBox["\[Xi]", 
             RowBox[{"(", "j", ")"}]]}], 
           SuperscriptBox["|", 
            RowBox[{"-", "p"}]]}]}], " ", ")"}], 
        RowBox[{"-", "1"}]]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             UnderscriptBox["\[Sum]", "j"], " ", 
             RowBox[{"|", 
              RowBox[{"x", "-", 
               SuperscriptBox["\[Xi]", 
                RowBox[{"(", "j", ")"}]]}], 
              SuperscriptBox["|", 
               RowBox[{"-", "p"}]]}]}], ")"}], 
           RowBox[{"-", "2"}]]}], 
         RowBox[{
          UnderscriptBox["\[Sum]", "j"], " ", 
          RowBox[{
           SubscriptBox["\[Del]", "x"], "|", "x"}]}]}], "-", 
        SuperscriptBox["\[Xi]", 
         RowBox[{"(", "j", ")"}]]}], 
       SuperscriptBox["|", 
        RowBox[{"-", "p"}]]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           UnderscriptBox["\[Sum]", "j"], " ", 
           RowBox[{"|", 
            RowBox[{"x", "-", 
             SuperscriptBox["\[Xi]", 
              RowBox[{"(", "j", ")"}]]}], 
            SuperscriptBox["|", 
             RowBox[{"-", "p"}]]}]}], ")"}], 
         RowBox[{"-", "2"}]]}], 
       RowBox[{
        UnderscriptBox["\[Sum]", "j"], " ", 
        RowBox[{"p", " ", 
         RowBox[{"(", 
          RowBox[{"x", "-", 
           SuperscriptBox["\[Xi]", 
            RowBox[{"(", "j", ")"}]]}], ")"}], " ", 
         RowBox[{"d", "(", 
          RowBox[{"x", ",", " ", 
           SuperscriptBox["\[Xi]", 
            RowBox[{"(", "j", ")"}]], ",", " ", 
           RowBox[{
            RowBox[{"p", "/", "2"}], "+", "1"}]}], ")"}], " "}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.915806239973918*^9, 3.915806276026444*^9}, {
