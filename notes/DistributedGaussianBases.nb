   3.8112887581844893`*^9}, {3.811294417146367*^9, 3.8112945080629787`*^9}, {
   3.811294611102447*^9, 3.811294742633875*^9}, {3.811294794359651*^9, 
   3.811294829651923*^9}, {3.811294902248225*^9, 3.811294939772603*^9}, 
   3.811295097345562*^9, {3.811295143903736*^9, 3.811295151678769*^9}, {
   3.811295486909441*^9, 3.811295570296576*^9}, 3.811295790754738*^9, {
   3.811295942050109*^9, 3.811295957269919*^9}, {3.8112960009376574`*^9, 
   3.811296018916873*^9}, 3.8112961243307047`*^9, {3.811296173088591*^9, 
   3.811296236778126*^9}, {3.811296439974661*^9, 3.811296461153002*^9}, {
   3.811296550723423*^9, 3.8112966141771307`*^9}, {3.8112968032606287`*^9, 
   3.81129680636027*^9}, {3.81129819880342*^9, 3.81129824840131*^9}, {
   3.811298283799028*^9, 3.811298288174634*^9}, {3.811298763481085*^9, 
   3.8112987751361313`*^9}, 3.8113003554273157`*^9, {3.833111518842099*^9, 
   3.83311154830272*^9}},ExpressionUUID->"054bcfda-d8a4-4b8a-a9b5-\
510caa5cc0b5"],

Cell[TextData[{
 "and then when computing the derivatives of the moments of inertia, letting ",
 Cell[BoxData[
  FormBox["P", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "90a125b7-d46e-4d31-ba90-0f17abce79e7"],
 " be the transformation to the principal axis frame and",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SubsuperscriptBox["\[Mu]", "0", 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "a55f00a5-bb6a-44eb-b3c6-c7fd8c833590"],
 " be the moments of inertia expressed as"
}], "ExpositoryText",
 CellChangeTimes->{{3.91690642698279*^9, 3.916906443172708*^9}, {
  3.916906524211347*^9, 3.916906577352908*^9}, {3.91690662597899*^9, 
  3.916906673115233*^9}},ExpressionUUID->"f0e2e9af-065a-4272-8088-\
54a09e19b0b9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Mu]", "0", 
    RowBox[{"-", "1"}]], " ", "=", " ", 
   RowBox[{
    SuperscriptBox["P", "T"], "\[InvisibleSpace]", 
    SubscriptBox["I", "0"], "P"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9169066305286016`*^9, 3.916906640594983*^9}, 
   3.9169066781188097`*^9},ExpressionUUID->"b84f6164-3eff-42d2-843a-\
c6d50dde55ec"],

Cell["\<\
we know from properties of derivatives of eigenvalues that (letting \
multiplication here stand in for multiplication along the proper axes)\
\>", "ExpositoryText",
 CellChangeTimes->{{3.916906680097155*^9, 3.916906688944932*^9}, {
  3.916906841590438*^9, 
  3.916906860893635*^9}},ExpressionUUID->"70e99da3-a3c6-4433-9e08-\
3a6a2ddc7b10"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "Y"], "\[VeryThinSpace]", 
       SubscriptBox["\[Mu]", "0"]}], " ", "=", " ", 
      RowBox[{
       SubscriptBox["\[Del]", "Y"], "\[VeryThinSpace]", 
       SuperscriptBox[
        RowBox[{"(", 
         SuperscriptBox[
          SubscriptBox["\[Mu]", "0"], 
          RowBox[{"-", "1"}]], ")"}], 
        RowBox[{"-", "1"}]]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         SubscriptBox["\[Mu]", "0"], "\[InvisibleSpace]", "(", 
         RowBox[{
          SubscriptBox["\[Del]", "Y"], 
          SuperscriptBox[
           SubscriptBox["\[Mu]", "0"], 
           RowBox[{"-", "1"}]]}], ")"}]}], 
       SubscriptBox["\[Mu]", "0"]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         SubscriptBox["\[Mu]", "0"], "(", 
         RowBox[{
          SuperscriptBox["P", "T"], " ", 
          RowBox[{
           SubscriptBox["\[Del]", "Y"], 
           SubscriptBox["I", "0"]}], "P"}], ")"}]}], 
       SubscriptBox["\[Mu]", "0"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916906444706324*^9, 3.9169066187462463`*^9}, {
  3.916906697431266*^9, 3.916906707921133*^9}, {3.916906752375288*^9, 
  3.916906831245528*^9}, {3.9169068710333757`*^9, 
  3.916906871643716*^9}},ExpressionUUID->"ae6075af-293d-4ee3-9b4d-\
053dad0a8127"],

Cell[TextData[{
 "and so we can actually get clean forms for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", "Y"], "\[VeryThinSpace]", 
    SubscriptBox["\[Mu]", "0"]}], TraditionalForm]],
  CellChangeTimes->{{3.916906444706324*^9, 3.9169066187462463`*^9}, {
   3.916906697431266*^9, 3.916906707921133*^9}, {3.916906752375288*^9, 
   3.916906831245528*^9}, {3.9169068710333757`*^9, 3.916906871643716*^9}},
  ExpressionUUID->"a106dae9-c8a2-47af-bf6c-0ef3c7eb9976"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["Y", "2"]], "\[VeryThinSpace]", 
    SubscriptBox["\[Mu]", "0"]}], TraditionalForm]],
  CellChangeTimes->{{3.916906444706324*^9, 3.9169066187462463`*^9}, {
   3.916906697431266*^9, 3.916906707921133*^9}, {3.916906752375288*^9, 
   3.916906831245528*^9}, {3.9169068710333757`*^9, 3.916906871643716*^9}},
  ExpressionUUID->"d62a5b93-72c1-4cd1-a70d-f6398d53cf07"],
 " which could be used to improve our kinetic energy if we wanted"
}], "ExpositoryText",
 CellChangeTimes->{{3.916906895918057*^9, 
  3.9169069651084833`*^9}},ExpressionUUID->"85f6f402-02d4-4943-980f-\
0f4d3c8b134b"]
}, Open  ]]
}, Open  ]]
},
