  3.8865474763219767`*^9}},ExpressionUUID->"a8240d7e-fb61-4bfc-aeae-\
1e865d82c4e1"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["\[CurlyPhi]", 
        StyleBox["n",
         FontWeight->"Bold"], 
        RowBox[{"(", "i", ")"}]], 
       SubsuperscriptBox["\[CurlyPhi]", 
        StyleBox["m",
         FontWeight->"Bold"], 
        RowBox[{"(", "j", ")"}]]}], " ", "=", " ", 
      RowBox[{
       SubsuperscriptBox["P", 
        StyleBox["n",
         FontWeight->"Bold"], 
        RowBox[{"(", "i", ")"}]], 
       SubsuperscriptBox["P", 
        StyleBox["m",
         FontWeight->"Bold"], 
        RowBox[{"(", "j", ")"}]], 
       SuperscriptBox["W", 
        RowBox[{"(", 
         RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], 
       SuperscriptBox["\[Phi]", 
        RowBox[{"(", 
         RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       FractionBox[
        SuperscriptBox["W", 
         RowBox[{"(", 
          RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], 
        SqrtBox[
         RowBox[{
          RowBox[{
           StyleBox["n",
            FontWeight->"Bold"], "!"}], "\[VeryThinSpace]", 
          RowBox[{
           StyleBox["m",
            FontWeight->"Bold"], "!"}]}]]], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox[
           StyleBox["P",
            FontWeight->"Bold"], 
           StyleBox["n",
            FontWeight->"Bold"], 
           RowBox[{"(", "i", ")"}]], "\[CircleTimes]", 
          SubsuperscriptBox[
           StyleBox["P",
            FontWeight->"Bold"], 
           StyleBox["m",
            FontWeight->"Bold"], 
           RowBox[{"(", "j", ")"}]]}], ")"}], "\[CircleDot]", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["\[Chi]", 
           StyleBox["n",
            FontWeight->"Bold"]], "\[CircleTimes]", 
          SuperscriptBox["\[Chi]", 
           StyleBox["m",
            FontWeight->"Bold"]]}], ")"}]}], 
       SuperscriptBox["\[Phi]", 
        RowBox[{"(", 
         RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.886442542531756*^9, 3.8864425803437138`*^9}, {
  3.886442739268886*^9, 3.886442742098936*^9}, {3.886542510755692*^9, 
  3.886542513558363*^9}, {3.886544705732213*^9, 3.886544741228569*^9}, {
  3.8865448496734*^9, 3.886544859687188*^9}, {3.886547582167334*^9, 
  3.8865475852581177`*^9}},ExpressionUUID->"01ae47b4-73b4-4852-9d2f-\
810d77d2af1a"],

Cell[TextData[{
 "Next we will want to express this as a series of summations for each order. \
For this we will note that the maximum order is given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalOmega]", " ", "=", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Sum]", 
       RowBox[{"\[VeryThinSpace]", "k"}]], 
      SubscriptBox["n", "k"]}], "+", 
     SubscriptBox["m", "k"]}]}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "5b881a04-8a32-49e9-9724-107d5e59a14a"],
 ", so our summation will be"
}], "ExpositoryText",
 CellChangeTimes->{{3.886547603887004*^9, 3.886547626429158*^9}, {
  3.88654835308244*^9, 3.886548414142413*^9}, {3.88654845776023*^9, 
  3.886548462205102*^9}, {3.886548566998981*^9, 
  3.8865486232895737`*^9}},ExpressionUUID->"ce528c10-baec-4fbf-9765-\
1d10d2fad937"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["\[CurlyPhi]", 
        StyleBox["n",
         FontWeight->"Bold"], 
        RowBox[{"(", "i", ")"}]], 
       SubsuperscriptBox["\[CurlyPhi]", 
        StyleBox["m",
         FontWeight->"Bold"], 
        RowBox[{"(", "j", ")"}]]}], " ", "=", " ", 
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox["W", 
          RowBox[{"(", 
           RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], 
         SuperscriptBox["\[Phi]", 
          RowBox[{"(", 
           RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]]}], 
        SqrtBox[
         RowBox[{
          RowBox[{
           StyleBox["n",
            FontWeight->"Bold"], "!"}], "\[VeryThinSpace]", 
          RowBox[{
           StyleBox["m",
            FontWeight->"Bold"], "!"}]}]]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"\[Omega]", "=", "0"}], "\[CapitalOmega]"], 
        "\[VeryThinSpace]", 
        RowBox[{
         SubsuperscriptBox[
          StyleBox["K",
           FontWeight->"Bold"], "\[Omega]", 
          RowBox[{"(", 
           RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], "\[CircleDot]", 
         SuperscriptBox[
          RowBox[{"(", "\[VeryThinSpace]\[VeryThinSpace]", 
           SuperscriptBox["\[Chi]", 
            RowBox[{"(", 
             RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], ")"}], 
          StyleBox["\[Omega]",
           FontWeight->"Bold"]]}]}]}]}]},
    {" "}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.886548629626631*^9, 3.886548729822372*^9}, {
  3.886548809122283*^9, 
  3.886548814965398*^9}},ExpressionUUID->"161c25f7-4976-4898-907e-\
d30e0bf55daf"],

Cell["where ", "ExpositoryText",
 CellChangeTimes->{{3.886548698982525*^9, 
  3.886548699576586*^9}},ExpressionUUID->"1121909b-642a-4c19-ac12-\
8e743c955bc3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["K",
     FontWeight->"Bold"], "\[Omega]", 
    RowBox[{"(", 
     RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], "=", " ", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["P", 
         StyleBox["n",
          FontWeight->"Bold"], 
         RowBox[{"(", "i", ")"}]], "\[CircleTimes]", 
        SubsuperscriptBox["P", 
         StyleBox["m",
          FontWeight->"Bold"], 
         RowBox[{"(", "j", ")"}]]}], ")"}], "p"], ":", 
     RowBox[{"p", "\[Element]", 
      RowBox[{"P", "(", "\[Omega]", ")"}]}]}], "}"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8865487049204903`*^9, 
  3.88654878028001*^9}},ExpressionUUID->"4b02d578-552f-4199-9c6f-\
705e1033cfb5"],

Cell[CellGroupData[{

Cell["Overlaps", "Subsubsection",
 CellChangeTimes->{{3.886442478882243*^9, 
  3.886442479855711*^9}},ExpressionUUID->"1bdf536c-9ab2-4b83-8fd0-\
63dd5faa45e7"],

Cell["\<\
With this expression for the product of our basis functions we have\
\>", "ExpositoryText",
 CellChangeTimes->{{3.886548828419983*^9, 
  3.886548841099029*^9}},ExpressionUUID->"6befb3a5-2cab-47a0-b66a-\
64977ef3f95e"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["S", 
       RowBox[{"i", "\[InvisibleSpace]", "j"}]], " ", "=", " ", 
      RowBox[{
       SuperscriptBox["W", 
        RowBox[{"(", 
         RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], 
       RowBox[{"\[Integral]", 
        RowBox[{
         SubsuperscriptBox["P", 
          StyleBox["n",
           FontWeight->"Bold"], 
          RowBox[{"(", "i", ")"}]], "\[InvisibleSpace]", 
         SubsuperscriptBox["P", 
          StyleBox["m",
           FontWeight->"Bold"], 
          RowBox[{"(", "j", ")"}]], 
         SuperscriptBox["\[Phi]", 
          RowBox[{"(", 
           RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]]}]}]}]}]},
    {
     RowBox[{" ", 
      RowBox[{"=", " ", 
       RowBox[{
        FractionBox[
         SuperscriptBox["W", 
          RowBox[{"(", 
           RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], 
         SqrtBox[
          RowBox[{
           RowBox[{
            StyleBox["n",
             FontWeight->"Bold"], "!"}], "\[VeryThinSpace]", 
           RowBox[{
            StyleBox["m",
             FontWeight->"Bold"], "!"}]}]]], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"\[Omega]", "=", "0"}], "\[CapitalOmega]"], 
         RowBox[{"\[Integral]", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SubsuperscriptBox[
              StyleBox["K",
               FontWeight->"Bold"], "\[Omega]", 
              RowBox[{"(", 
               RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], 
             "\[CircleDot]", 
             SuperscriptBox[
              RowBox[{"(", "\[VeryThinSpace]", 
               SuperscriptBox["\[Chi]", 
                RowBox[{"(", 
                 RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]], ")"}], 
              StyleBox["\[Omega]",
               FontWeight->"Bold"]]}], ")"}], 
           SuperscriptBox["\[Phi]", 
            RowBox[{"(", 
             RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]]}]}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.88644278468294*^9, 3.8864429446658907`*^9}, {
