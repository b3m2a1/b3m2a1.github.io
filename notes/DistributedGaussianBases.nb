d2c5db552615"],

Cell[TextData[{
 "Why is this nice? Well by defining ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["P",
      FontWeight->"Bold"], "n", 
     RowBox[{"(", "i", ")"}]], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SubsuperscriptBox["P", 
        RowBox[{"n", ",", "\[Lambda]"}], 
        RowBox[{"(", "i", ")"}]], ":", "\[Lambda]"}], "=", 
      RowBox[{
       RowBox[{"0", "..."}], "\[InvisibleSpace]", "n"}]}], "}"}]}], 
   TraditionalForm]],
  CellChangeTimes->{{3.886544528391317*^9, 3.88654456921605*^9}, {
   3.886544615229396*^9, 3.886544616099657*^9}},ExpressionUUID->
  "6159a4c7-549b-42c3-9edc-766b11d0529e"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ThinSpace]", 
    RowBox[{
     SuperscriptBox["\[Chi]", 
      StyleBox["n",
       FontWeight->"Bold"]], "\[VeryThinSpace]", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "\[VeryThinSpace] ", "\[Minus]", " ", 
           SuperscriptBox["\[Xi]", 
            RowBox[{"(", 
             RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]]}], ")"}], 
         "\[Lambda]"], ":", "\[Lambda]"}], "=", 
       RowBox[{
        RowBox[{"0", "..."}], "\[InvisibleSpace]", "n"}]}], "}"}]}]}], 
   TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "20e995a6-b633-4790-9230-dcf094d21d8c"]
}], "ExpositoryText",
 CellChangeTimes->{{3.8865444554992456`*^9, 3.886544462341978*^9}, {
