   3.916521335423088*^9, 3.916521344172933*^9}, 
   3.9165214115834017`*^9},ExpressionUUID->"302ef5de-fa2a-4df6-ae3d-\
ca924ad9534d"],

Cell[TextData[{
 "and the last pieces there come directly out of the norm of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"exp", "(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SubscriptBox["\[CapitalSigma]", "A"], ")"}], 
        RowBox[{"-", "1"}]], "\[CircleDot]", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["q", "A"], "-", 
          SubscriptBox["\[Mu]", "A"]}], ")"}], "2"]}]}], " ", "+", " ", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"\[DoubleStruckI]", "(", 
        SubscriptBox["\[CapitalSigma]", "A"], ")"}], 
       RowBox[{"-", "1"}]], 
      SubscriptBox[
       RowBox[{"(", 
        RowBox[{"\[CapitalSigma]", "\[InvisibleSpace]", "p"}], ")"}], 
       "A"]}]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.91651982883311*^9, 3.916519845993264*^9}, {
    3.916519893741906*^9, 3.916519952857551*^9}, 3.916520848020708*^9, 
    3.916521096030016*^9, {3.9165211764064283`*^9, 3.91652129617583*^9}, {
    3.916521335423088*^9, 3.916521344172933*^9}, 3.9165214115834017`*^9},
  ExpressionUUID->"8e42eba8-1c1f-4c76-89d0-962fee76296b"],
 " and so we end up with"
}], "ExpositoryText",
 CellChangeTimes->{{3.916521419218977*^9, 
  3.916521442030855*^9}},ExpressionUUID->"9f841362-e622-45a5-99ce-\
82189db416ad"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Integral]", "B"], " ", 
    RowBox[{"exp", "(", "\[AlignmentMarker]", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{
        SuperscriptBox["\[CapitalSigma]", 
         RowBox[{"-", "1"}]], "\[CircleDot]", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"q", "-", "\[Mu]"}], ")"}], "2"]}]}], " ", "+", " ", 
      RowBox[{"\[DoubleStruckI]", "\[VeryThinSpace]", 
       RowBox[{"p", "\[CenterDot]", "q"}]}]}], ")"}]}], " ", "=", " ", 
   RowBox[{
    SubscriptBox["S", "B"], 
    SuperscriptBox[
     SubscriptBox["S", "A"], 
     RowBox[{"-", "1"}]], 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          SubscriptBox["\[CapitalSigma]", "A"], ")"}], 
         RowBox[{"-", "1"}]], "\[CircleDot]", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["q", "A"], "-", 
           SubscriptBox["\[Mu]", "A"]}], ")"}], "2"]}]}], " ", "+", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"\[DoubleStruckI]", "(", 
         SubscriptBox["\[CapitalSigma]", "A"], ")"}], 
        RowBox[{"-", "1"}]], 
       SubscriptBox[
        RowBox[{"(", 
         RowBox[{"\[CapitalSigma]", "\[InvisibleSpace]", "p"}], ")"}], 
        "A"]}]}], ")"}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.916521447077949*^9, 
  3.916521481965378*^9}},ExpressionUUID->"641da31e-da11-40dd-b2f3-\
fa29d390b6a9"],

Cell[TextData[{
 "which, with the exception of the ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     SubscriptBox["\[CapitalSigma]", "A"], ")"}], 
    RowBox[{"-", "1"}]], 
   SubscriptBox["\[CapitalSigma]", 
    RowBox[{"A", ":"}]]}]],
  CellChangeTimes->{{3.91651997416127*^9, 3.91651997498003*^9}, {
   3.916520017791975*^9, 3.916520018164873*^9}, {3.916520162841563*^9, 
   3.916520263813739*^9}},ExpressionUUID->
  "98078f4e-3bce-4908-b455-c1e6f0b83436"],
 " is identical to the no-momentum case, but tells us we just need to adjust \
our momentum and everything else is as normal"
}], "ExpositoryText",
 CellChangeTimes->{{3.916521484897162*^9, 3.916521524697722*^9}, {
  3.916521598936884*^9, 3.916521616494274*^9}, {3.916613137288156*^9, 
  3.916613137289459*^9}},ExpressionUUID->"88dcd90b-b90f-4b3a-9d16-\
5bef0114e385"],

Cell[TextData[{
 "It should be noted that in the case that ",
 Cell[BoxData[
  FormBox["\[CapitalSigma]", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "67186ec7-4d2d-4194-b5d5-6f38340030e2"],
 " is diagonal, ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     SubscriptBox["\[CapitalSigma]", "A"], ")"}], 
    RowBox[{"-", "1"}]], 
   SubscriptBox["\[CapitalSigma]", 
    RowBox[{"A", ":"}]]}]],
  CellChangeTimes->{{3.91651997416127*^9, 3.91651997498003*^9}, {
   3.916520017791975*^9, 3.916520018164873*^9}, {3.916520162841563*^9, 
   3.916520263813739*^9}},ExpressionUUID->
  "93c65dc1-c855-421d-ba9b-84267da616a2"],
 " simply has the effect of taking only the momenta corresponding to the \
coordinates ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "ba9061e7-de3c-4686-af0d-16e391e9bd28"],
 ", moreover, in our derivations and in the implementation we generally work \
with"
}], "ExpositoryText",
 CellChangeTimes->{{3.916613127114153*^9, 3.916613236438634*^9}, {
  3.916613396367659*^9, 3.9166133969341583`*^9}, {3.9166140304938726`*^9, 
  3.916614065113311*^9}},ExpressionUUID->"a11e0c40-d871-46c2-9e20-\
db924896918e"],

