Cell["\<\
We\[CloseCurlyQuote]ll then take the different phases on the momentum to \
ensure real matrices, by letting\
\>", "ExpositoryText",
 CellChangeTimes->{{3.916070021194992*^9, 
  3.916070051977953*^9}},ExpressionUUID->"a662dac3-5158-4c6a-a0b1-\
971b66f7a3fc"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox["\[CurlyPhi]", 
       RowBox[{"(", "i", ")"}]], " ", "=", " ", 
      RowBox[{
       SuperscriptBox["\[Phi]", 
        RowBox[{"(", "i", ")"}]], 
       SuperscriptBox["\[CapitalTheta]", 
        RowBox[{"(", "i", ")"}]]}]}]},
    {
     RowBox[{
      SuperscriptBox["\[CapitalTheta]", 
       RowBox[{"(", "i", ")"}]], "=", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"exp", "(", 
           RowBox[{"\[DoubleStruckI]", "\[InvisibleSpace]\[VeryThinSpace]", 
            SuperscriptBox["J", 
             RowBox[{"(", "i", ")"}]], "\[VeryThinSpace]", "q"}], ")"}], " ", 
          "+", " ", 
          RowBox[{"exp", "(", 
           RowBox[{
            RowBox[{"-", "\[DoubleStruckI]"}], "\[InvisibleSpace]\[VeryThinSpace]", 
            SuperscriptBox["J", 
             RowBox[{"(", "i", ")"}]], "\[VeryThinSpace]", "q"}], ")"}]}], 
         " ", ")"}]}], " ", "+", " ", 
       RowBox[{
        FractionBox["\[DoubleStruckI]", "2"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"exp", "(", 
           RowBox[{"\[DoubleStruckI]", "\[InvisibleSpace]\[VeryThinSpace]", 
            SuperscriptBox["J", 
             RowBox[{"(", "i", ")"}]], "\[VeryThinSpace]", "q"}], ")"}], " ", 
          "-", " ", 
          RowBox[{"exp", "(", 
           RowBox[{
            RowBox[{"-", "\[DoubleStruckI]"}], "\[InvisibleSpace]\[VeryThinSpace]", 
            SuperscriptBox["J", 
             RowBox[{"(", "i", ")"}]], "\[VeryThinSpace]", "q"}], ")"}]}], 
         " ", ")"}]}]}]}]},
    {
     RowBox[{"[", 
      RowBox[{"=", " ", 
       RowBox[{
        RowBox[{"cos", "(", 
         RowBox[{
          SuperscriptBox["J", 
           RowBox[{"(", "i", ")"}]], "\[VeryThinSpace]", "q"}], ")"}], " ", 
        "-", " ", 
        RowBox[{"sin", "(", 
         RowBox[{
          SuperscriptBox["J", 
           RowBox[{"(", "i", ")"}]], "\[VeryThinSpace]", "q"}], ")"}]}]}], 
      "]"}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.915997446265327*^9, 3.91599745240898*^9}, {
