Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["M", "b", "k"], "(", 
    RowBox[{"\[Alpha]", ",", " ", "p"}], ")"}], " ", "=", " ", 
   RowBox[{
    FractionBox[
     SuperscriptBox["2", 
      RowBox[{"\[LeftCeiling]", 
       RowBox[{"k", "/", "2"}], "\[RightCeiling]"}]], 
     SqrtBox["\[Pi]"]], " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"n", "=", "0"}], 
      RowBox[{"\[LeftFloor]", 
       RowBox[{"k", "/", "2"}], "\[RightFloor]"}]], " ", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", 
         FractionBox["1", 
          RowBox[{"2", "\[InvisibleSpace]"}]]}], ")"}], "n"], 
      FractionBox[
       RowBox[{"\[CapitalGamma]", "(", 
        RowBox[{"b", "+", 
         RowBox[{"\[LeftFloor]", 
          RowBox[{"k", "/", "2"}], "\[RightFloor]"}]}], ")"}], 
       SubscriptBox[
        RowBox[{"(", "b", ")"}], 
        RowBox[{"(", "n", ")"}]]], "\[VeryThinSpace]", 
      RowBox[{"(", GridBox[{
         {
          RowBox[{"\[LeftFloor]", 
           RowBox[{"k", "/", "2"}], "\[RightFloor]"}]},
         {"n"}
        },
        GridBoxAlignment->{"Columns" -> {Center}}], ")"}], "\[VeryThinSpace]\[VeryThinSpace]", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox[
         SuperscriptBox["p", 
          RowBox[{"2", "\[InvisibleSpace]"}]], 
         RowBox[{"2", "\[Alpha]"}]], ")"}], "n"]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
