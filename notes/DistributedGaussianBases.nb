    RowBox[{"subGSN", "[", "sMat_", "]"}], "[", "expr_", "]"}], ":=", 
   RowBox[{"subGSN", "[", 
    RowBox[{"expr", ",", " ", "sMat"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gsCoeff", "[", "expr_", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"expr", "//", "Expand"}], "//", 
      RowBox[{"ReplaceAll", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"g_gsN", ":>", "g"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Phi]", "[", "k_", "]"}], ":>", 
          RowBox[{"Power", "[", 
           RowBox[{"\[Phi]", ",", " ", "k"}], "]"}]}]}], 
        "\[IndentingNewLine]", "}"}], "]"}]}], "//", 
     RowBox[{
      RowBox[{"CoefficientList", "[", 
       RowBox[{"#", ",", " ", "\[Phi]"}], "]"}], "&"}]}], "//", "Rest"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gsSimp", "[", "expr_", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Block", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"norms", "=", 
       RowBox[{"DeleteDuplicates", "@", 
        RowBox[{"Cases", "[", "\[IndentingNewLine]", 
         RowBox[{
         "expr", ",", "\[IndentingNewLine]", "_gsN", ",", 
          "\[IndentingNewLine]", "Infinity"}], "\[IndentingNewLine]", 
         "]"}]}]}], ",", "\[IndentingNewLine]", "syms", ",", 
      "\[IndentingNewLine]", "simpExpr", ",", "\[IndentingNewLine]", 
      RowBox[{"normsMap", "=", 
       RowBox[{"<|", "|>"}]}]}], "\[IndentingNewLine]", "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"syms", "=", 
      RowBox[{"norms", "/.", 
       RowBox[{
        RowBox[{"g", ":", 
         RowBox[{"gsN", "[", 
          RowBox[{
           RowBox[{"\[Phi]", "[", "i_", "]"}], ",", " ", 
           RowBox[{"\[Phi]", "[", "j_", "]"}]}], "]"}]}], ":>", 
        "\[IndentingNewLine]", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"s", "=", 
            RowBox[{"Symbol", "[", 
             RowBox[{"\"\<\[FormalS]\>\"", "<>", 
              RowBox[{"ToString", "[", "i", "]"}], "<>", 
              RowBox[{"ToString", "[", "j", "]"}]}], "]"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"normsMap", "[", "s", "]"}], "=", "g"}], ";", 
           "\[IndentingNewLine]", "s"}]}], "\[IndentingNewLine]", "]"}]}]}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"simpExpr", "=", 
      RowBox[{"expr", "/.", 
       RowBox[{
        RowBox[{"gsN", "[", 
         RowBox[{
          RowBox[{"\[Phi]", "[", "i_", "]"}], ",", " ", 
          RowBox[{"\[Phi]", "[", "j_", "]"}]}], "]"}], ":>", 
        RowBox[{"Symbol", "[", 
         RowBox[{"\"\<\[FormalS]\>\"", "<>", 
          RowBox[{"ToString", "[", "i", "]"}], "<>", 
          RowBox[{"ToString", "[", "j", "]"}]}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Assuming", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"And", "@@", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{"GreaterThan", "[", "0", "]"}], ",", " ", "syms"}], 
          "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Expand", "[", "simpExpr", "]"}], "//", "FullSimplify"}]}], 
       "\[IndentingNewLine]", "]"}], "//", 
      RowBox[{"ReplaceAll", "[", 
       RowBox[{"s_Symbol", ":>", 
        RowBox[{"Lookup", "[", 
         RowBox[{"normsMap", ",", " ", "s", ",", " ", "s"}], "]"}]}], 
       "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
