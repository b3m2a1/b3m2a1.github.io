  3.9164130419944897`*^9}},ExpressionUUID->"c6e92355-2adb-4280-9e0f-\
8d014840c53b"],

Cell[TextData[{
 "And by doing that swap only on the terms involving ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["u",
     LineColor->RGBColor[0.8, 0.4, 0.],
     FrontFaceColor->RGBColor[0.8, 0.4, 0.],
     BackFaceColor->RGBColor[0.8, 0.4, 0.],
     GraphicsColor->RGBColor[0.8, 0.4, 0.],
     FontSize->14,
     FontColor->RGBColor[0.8, 0.4, 0.]]], TraditionalForm]],
  CellChangeTimes->{{3.916413203060418*^9, 3.9164132038686657`*^9}, 
    3.916413257558743*^9},ExpressionUUID->
  "50355f5a-f69d-45db-a979-fe9465d87b98"],
 " we get"
}], "ExpositoryText",
