Cell[TextData[{
 "and then just to confirm that this makes sense, in the case that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalSigma]", "i"], TraditionalForm]],
  CellChangeTimes->{{3.884051561434238*^9, 3.884051647233899*^9}, {
