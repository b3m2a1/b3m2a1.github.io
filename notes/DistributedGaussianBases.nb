Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "phaseGauss", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"phaseGauss", "[", 
    RowBox[{"a_", ",", " ", "p_", ",", " ", "c_", ",", " ", 
     RowBox[{"prefac_", ":", "1"}]}], "]"}], "[", " ", "q_", "]"}], ":=", 
  RowBox[{"prefac", "*", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "a"}], " ", 
      SuperscriptBox[
       RowBox[{"(", 
