Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"\[CapitalGamma]", "(", 
     RowBox[{
      RowBox[{"1", "/", "2"}], "+", "k"}], ")"}], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "/", "2"}], ")"}], 
     RowBox[{"(", "n", ")"}]]], " ", "=", 
   RowBox[{
    FractionBox[
     SqrtBox["\[Pi]"], 
     SuperscriptBox["2", 
      RowBox[{"k", "-", "n"}]]], "\[InvisibleSpace]", 
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "k"}], "-", "1"}], ")"}], "!!"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "\[InvisibleSpace]", "n"}], "-", "1"}], ")"}], 
      "!!"}]]}]}], TraditionalForm]], "ExpositoryMathCentered",
