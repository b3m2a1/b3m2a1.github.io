addc1d1acf64"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "x"], 
       SuperscriptBox["w", 
        RowBox[{"(", "i", ")"}]]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", "i", ")"}]]}], ")"}], 
        FractionBox[
         RowBox[{"p", " ", 
          RowBox[{"d", "(", 
           RowBox[{"x", ",", " ", 
            SuperscriptBox["\[Xi]", 
             RowBox[{"(", "i", ")"}]], ",", " ", 
            RowBox[{
             RowBox[{"p", "/", "2"}], "+", "1"}]}], ")"}]}], 
         RowBox[{
          UnderscriptBox["\[Sum]", "j"], " ", 
          RowBox[{"|", 
           RowBox[{"x", "-", 
            SuperscriptBox["\[Xi]", 
             RowBox[{"(", "i", ")"}]]}], 
           SuperscriptBox["|", 
            RowBox[{"-", "p"}]], " "}]}]]}], " ", "-", " ", 
       RowBox[{
        FractionBox[
         RowBox[{"|", 
          RowBox[{"x", "-", 
           SuperscriptBox["\[Xi]", 
            RowBox[{"(", "i", ")"}]]}], 
          SuperscriptBox["|", 
           RowBox[{"-", "p"}]]}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            UnderscriptBox["\[Sum]", "j"], " ", 
            RowBox[{"|", 
             RowBox[{"x", "-", 
              SuperscriptBox["\[Xi]", 
               RowBox[{"(", "i", ")"}]]}], 
             SuperscriptBox["|", 
              RowBox[{"-", "p"}]]}]}], ")"}], "2"]], 
        RowBox[{
         UnderscriptBox["\[Sum]", "j"], " ", 
         RowBox[{"p", " ", 
          RowBox[{"(", 
           RowBox[{"x", "-", 
            SuperscriptBox["\[Xi]", 
             RowBox[{"(", "j", ")"}]]}], ")"}], " ", 
          RowBox[{"d", "(", 
           RowBox[{"x", ",", " ", 
            SuperscriptBox["\[Xi]", 
             RowBox[{"(", "j", ")"}]], ",", " ", 
            RowBox[{
             RowBox[{"p", "/", "2"}], "+", "1"}]}], ")"}], " "}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       FractionBox["1", 
        RowBox[{
         UnderscriptBox["\[Sum]", "j"], " ", 
         RowBox[{"|", 
          RowBox[{"x", "-", 
           SuperscriptBox["\[Xi]", 
            RowBox[{"(", "i", ")"}]]}], 
          SuperscriptBox["|", 
           RowBox[{"-", "p"}]]}]}]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "-", 
            SuperscriptBox["\[Xi]", 
             RowBox[{"(", "i", ")"}]]}], ")"}], "p", " ", 
          RowBox[{"d", "(", 
           RowBox[{"x", ",", " ", 
            SuperscriptBox["\[Xi]", 
             RowBox[{"(", "i", ")"}]], ",", " ", 
            RowBox[{
             RowBox[{"p", "/", "2"}], "+", "1"}]}], ")"}]}], " ", "-", " ", 
         RowBox[{
          SuperscriptBox["w", 
           RowBox[{"(", "i", ")"}]], 
          RowBox[{
           UnderscriptBox["\[Sum]", "j"], " ", 
           RowBox[{"p", " ", 
            RowBox[{"(", 
             RowBox[{"x", "-", 
              SuperscriptBox["\[Xi]", 
               RowBox[{"(", "j", ")"}]]}], ")"}], " ", 
            RowBox[{"d", "(", 
             RowBox[{"x", ",", " ", 
              SuperscriptBox["\[Xi]", 
               RowBox[{"(", "j", ")"}]], ",", " ", 
              RowBox[{
               RowBox[{"p", "/", "2"}], "+", "1"}]}], ")"}]}]}]}]}], " ", 
        ")"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "k"], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", 
          SuperscriptBox["\[Xi]", 
           RowBox[{"(", "j", ")"}]]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Delta]", 
           RowBox[{"k", "\[InvisibleSpace]", "i"}]], "-", 
          SuperscriptBox["w", 
           RowBox[{"(", "i", ")"}]]}], ")"}], "p", "\[InvisibleSpace] ", 
        FractionBox[
         RowBox[{"d", "(", 
          RowBox[{"x", ",", " ", 
           SuperscriptBox["\[Xi]", 
            RowBox[{"(", "j", ")"}]], ",", " ", 
           RowBox[{
            RowBox[{"p", "/", "2"}], "+", "1"}]}], ")"}], 
         RowBox[{
          UnderscriptBox["\[Sum]", "j"], " ", 
          RowBox[{"d", "(", 
           RowBox[{"x", ",", " ", 
            SuperscriptBox["\[Xi]", 
             RowBox[{"(", "j", ")"}]], ",", " ", 
            RowBox[{"p", "/", "2"}]}], ")"}]}]]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.915805390587254*^9, 3.9158055559111443`*^9}, {
   3.915805893163144*^9, 3.91580589758665*^9}, {3.915805958215369*^9, 
