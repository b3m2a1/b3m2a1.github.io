 "with the appropriate transformation from diagonalizing ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubsuperscriptBox["\[CapitalSigma]", "vib", 
     RowBox[{"(", "eff", ")"}]], 
    RowBox[{"-", "1"}]], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"f315c4e7-cfe1-428f-a257-b5efb04bce7b"]
