Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DGBN", "[", 
     RowBox[{"\[Xi]_List", ",", " ", "\[Alpha]_List"}], "]"}], "[", 
    "\"\<Normalization\>\"", "]"}], ":=", 
   RowBox[{"Times", "@@", 
    RowBox[{"(", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", "*", 
        RowBox[{"\[Alpha]", "/", "\[Pi]"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"1", "/", "4"}], ")"}]], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DGBN", "[", 
     RowBox[{"\[Xi]_List", ",", " ", "\[Alpha]_List"}], "]"}], "[", "vars__", 
    "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"DGBN", "[", 
      RowBox[{"\[Xi]", ",", " ", "\[Alpha]"}], "]"}], "[", 
     "\"\<Normalization\>\"", "]"}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      RowBox[{"Total", "[", 
       RowBox[{"\[Alpha]", "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"{", "vars", "}"}], "-", "\[Xi]"}], ")"}], "^", "2"}]}], 
       "]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"DGBN", "/:", 
  RowBox[{"Times", "[", 
   RowBox[{
    RowBox[{"DGBN", "[", 
     RowBox[{"\[Xi]1_List", ",", " ", "\[Alpha]1_List"}], "]"}], ",", " ", 
    RowBox[{"DGBN", "[", 
     RowBox[{"\[Xi]2_List", ",", " ", "\[Alpha]2_List"}], "]"}]}], "]"}], ":=",
   "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"DGBN", "[", 
     RowBox[{"\[Xi]1", ",", " ", 
      RowBox[{"\[Alpha]1", "*", 
       RowBox[{"\[Alpha]2", "/", 
        RowBox[{"(", 
         RowBox[{"\[Alpha]1", "+", "\[Alpha]2"}], ")"}]}]}]}], " ", "]"}], 
    "[", 
    RowBox[{"Sequence", "@@", "\[Xi]2"}], "]"}], "*", "\[IndentingNewLine]", 
   RowBox[{"DGBN", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Alpha]1", "*", "\[Xi]1"}], " ", "+", " ", 
        RowBox[{"\[Alpha]2", "*", "\[Xi]2"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"\[Alpha]1", "+", "\[Alpha]2"}], ")"}]}], ",", " ", 
     RowBox[{"(", 
      RowBox[{"\[Alpha]1", "+", "\[Alpha]2"}], ")"}]}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"augDGBN", "[", 
    RowBox[{"n_List", ",", " ", "\[Xi]_List", ",", " ", "\[Alpha]_List"}], 
    "]"}], "[", "vars__", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"DGBN", "[", 
     RowBox[{"\[Xi]", ",", " ", "\[Alpha]"}], "]"}], "[", "vars", "]"}], "*", 
   
   RowBox[{"Apply", "[", 
    RowBox[{"Times", ",", "\[IndentingNewLine]", 
     RowBox[{"MapThread", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"HermiteH", "[", 
          RowBox[{"#", ",", "  ", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{"2", " ", "#2"}], "]"}], 
            RowBox[{"(", 
             RowBox[{"#3", "-", "#4"}], ")"}]}]}], "]"}], "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"2", "^", "#"}], " ", "*", " ", 
           RowBox[{"#", "!"}]}], "]"}]}], "&"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "\[Alpha]", ",", " ", 
         RowBox[{"{", "vars", "}"}], ",", " ", "\[Xi]"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
    "]"}]}]}]}], "Input",
