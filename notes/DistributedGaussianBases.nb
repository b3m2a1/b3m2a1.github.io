 FormBox[
  RowBox[{
   RowBox[{"\[Phi]", "(", 
    RowBox[{"x", ",", " ", "\[Xi]", ",", " ", "\[CapitalSigma]"}], ")"}], " ",
    "=", " ", 
   RowBox[{
    RowBox[{"N", "(", "\[CapitalSigma]", ")"}], 
    SuperscriptBox["e", 
     StyleBox[
      RowBox[{
       RowBox[{"-", 
