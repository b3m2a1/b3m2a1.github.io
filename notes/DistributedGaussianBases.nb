0abb109e51fd"],

Cell["\<\
This also extends to the multidimensional case where one will have\
\>", "ExpositoryText",
 CellChangeTimes->{{3.886544897194998*^9, 3.8865448981591578`*^9}, {
  3.886545378780328*^9, 3.8865454031975117`*^9}, {3.8865456192729816`*^9, 
