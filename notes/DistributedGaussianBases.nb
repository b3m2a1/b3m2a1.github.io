Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["\[Integral]", 
        RowBox[{"-", "\[Infinity]"}], 
        RowBox[{"\[VeryThinSpace]", "\[Infinity]"}]], 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["q", "s"], "-", 
           SubsuperscriptBox["\[Xi]", "s", 
            RowBox[{"(", 
             RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], "k"], 
        SuperscriptBox["\[CurlyPhi]", 
         RowBox[{"(", "i", ")"}]], 
        SuperscriptBox["\[CurlyPhi]", 
         RowBox[{"(", "j", ")"}]]}]}], " ", "=", 
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["X", 
          RowBox[{"k", ",", "s"}], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"i", ",", "j"}], ")"}], "+"}]], "+", 
         SubsuperscriptBox["X", 
          RowBox[{"k", ",", "s"}], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"i", ",", "j"}], ")"}], "-"}]]}], ")"}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["\[Integral]", 
        RowBox[{"-", "\[Infinity]"}], 
        RowBox[{"\[VeryThinSpace]", "\[Infinity]"}]], 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["q", "s"], "-", 
           SubsuperscriptBox["\[Xi]", "s", 
            RowBox[{"(", 
             RowBox[{"i", ",", "j"}], ")"}]]}], ")"}], "k"], 
        SuperscriptBox["\[CurlyPhi]", 
         RowBox[{"(", "i", ")"}]], 
        SuperscriptBox["\[CurlyPhi]", 
         RowBox[{"(", "j", ")"}]]}]}], " ", "=", " ", 
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["Y", 
          RowBox[{"k", ",", "s"}], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"i", ",", "j"}], ")"}], "+"}]], "+", 
         SubsuperscriptBox["Y", 
          RowBox[{"k", ",", "s"}], 
