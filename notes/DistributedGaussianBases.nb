     }], ")"}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.885724873647048*^9, 
  3.8857248905749607`*^9}},ExpressionUUID->"38338962-4dcc-4166-ae10-\
