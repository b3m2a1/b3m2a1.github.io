Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["P", "n", 
     RowBox[{"(", "i", ")"}]], "(", "x", ")"}], " ", "=", " ", 
   RowBox[{
    FractionBox["1", 
     SqrtBox[
      RowBox[{"n", "!"}]]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"l", "\[VeryThinSpace]", "=", "0"}], 
      TemplateBox[{
        RowBox[{"n", "/", "2"}]},
       "Floor"]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"\[Lambda]", "=", "0"}], 
       RowBox[{"n", "-", 
        RowBox[{"2", "\[InvisibleSpace]", "l"}]}]], 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "l"], 
       SuperscriptBox[
