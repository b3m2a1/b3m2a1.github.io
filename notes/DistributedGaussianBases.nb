Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      TemplateBox[{
        SubscriptBox["\[CurlyPhi]", 
         RowBox[{"i", " "}]], 
        RowBox[{" ", 
          SubscriptBox["\[CurlyPhi]", "j"]}]},
       "BraKet"], " ", "=", " ", 
      RowBox[{"\[Integral]", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["P", 
          RowBox[{"n", "\[InvisibleSpace]", "m"}], 
          RowBox[{"(", 
           RowBox[{"i", ",", "j"}], ")"}]], "(", "x", ")"}], 
        RowBox[{
         SuperscriptBox["\[Phi]", 
          RowBox[{"(", "i", ")"}]], "(", "x", ")"}], 
        RowBox[{
         SuperscriptBox["\[Phi]", 
          RowBox[{"(", "j", ")"}]], "(", "x", ")"}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SuperscriptBox["W", 
        RowBox[{"(", 
         RowBox[{"i", ",", "j"}], ")"}]], 
       RowBox[{"\[Integral]", 
        RowBox[{"\[Phi]", "(", 
         RowBox[{"x", ",", " ", 
          FractionBox[
           RowBox[{
            RowBox[{
             SubscriptBox["\[Alpha]", "i"], "\[InvisibleSpace]", 
             SubscriptBox["\[Xi]", "i"]}], "+", 
            RowBox[{
             SubscriptBox["\[Alpha]", "j"], "\[InvisibleSpace]", 
             SubscriptBox["\[Xi]", "j"]}]}], 
           RowBox[{
            SubscriptBox["\[Alpha]", "i"], "+", 
            SubscriptBox["\[Alpha]", "j"]}]], ",", " ", 
          RowBox[{
           SubscriptBox["\[Alpha]", "i"], "+", 
           SubscriptBox["\[Alpha]", "j"]}]}], ")"}]}]}]}]},
    {
     RowBox[{"=", " ", 
      SuperscriptBox[
       RowBox[{
        SuperscriptBox["W", 
         RowBox[{"(", 
          RowBox[{"i", ",", "j"}], ")"}]], "(", 
        FractionBox[
         RowBox[{"2", "\[Pi]"}], 
         RowBox[{
          SubscriptBox["\[Alpha]", "i"], "+", 
          SubscriptBox["\[Alpha]", "j"]}]], ")"}], 
       RowBox[{"1", "/", "4"}]]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{"2", 
           FractionBox[
            RowBox[{
             SubscriptBox["\[Alpha]", "i"], 
             SubscriptBox["\[Alpha]", "j"]}], 
            RowBox[{
             SubscriptBox["\[Alpha]", "i"], "+", 
             SubscriptBox["\[Alpha]", "j"]}]]}], "\[Pi]"], ")"}], 
        RowBox[{"1", "/", "4"}]], 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{"2", "\[Pi]"}], 
          RowBox[{
           SubscriptBox["\[Alpha]", "i"], "+", 
           SubscriptBox["\[Alpha]", "j"]}]], ")"}], 
        RowBox[{"1", "/", "4"}]], 
       RowBox[{"exp", "(", 
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{
            SubscriptBox["\[Alpha]", "i"], 
            SubscriptBox["\[Alpha]", "j"]}], 
           RowBox[{
            SubscriptBox["\[Alpha]", "i"], "+", 
            SubscriptBox["\[Alpha]", "j"]}]]}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Xi]", "i"], "-", 
            SubscriptBox["\[Xi]", "j"]}], ")"}], "2"]}], ")"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{"4", " ", 
           SubscriptBox["\[Alpha]", "i"], 
           SubscriptBox["\[Alpha]", "j"]}], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             SubscriptBox["\[Alpha]", "i"], "+", 
             SubscriptBox["\[Alpha]", "j"]}], ")"}], "2"]], ")"}], 
        RowBox[{"1", "/", "4"}]], 
       RowBox[{"exp", "(", 
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{
            SubscriptBox["\[Alpha]", "i"], 
            SubscriptBox["\[Alpha]", "j"]}], 
           RowBox[{
            SubscriptBox["\[Alpha]", "i"], "+", 
            SubscriptBox["\[Alpha]", "j"]}]]}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Xi]", "i"], "-", 
            SubscriptBox["\[Xi]", "j"]}], ")"}], "2"]}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.886157648268393*^9, 3.88615769112752*^9}, {
   3.886158206958311*^9, 3.886158211023197*^9}, {3.8861582418736477`*^9, 
   3.8861583818224792`*^9}, 3.886158425717664*^9, {3.88615847013835*^9, 
   3.886158474214525*^9}},ExpressionUUID->"a9aef0e0-c38d-4407-9fcb-\
c46a87086b5a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Using Mass-Weighted Coordinates", "Section",
 CellChangeTimes->{{3.909335435146256*^9, 3.909335439416601*^9}, {
  3.909335811594283*^9, 
  3.909335817059079*^9}},ExpressionUUID->"38c41fff-c67c-4d86-b8d5-\
414c6872a1f6"],

Cell["We note initially that the normal modes may be expressed as", \
"ExpositoryText",
 CellChangeTimes->{{3.909335818621441*^9, 
  3.909335840391841*^9}},ExpressionUUID->"2f35968b-f913-494c-95a7-\
3930523b5562"],

Cell[BoxData[
 FormBox[
  RowBox[{"L", " ", "=", " ", 
   RowBox[{
    SuperscriptBox["G", 
     RowBox[{"1", "/", "2"}]], 
    SubscriptBox["Q", "FG"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.909335842511517*^9, 
  3.909335851034122*^9}},ExpressionUUID->"aeab3428-498d-4252-95b2-\
29fc458a2f02"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Q", "FG"], TraditionalForm]],
  CellChangeTimes->{{3.909335842511517*^9, 3.909335851034122*^9}},
  ExpressionUUID->"ca30d78c-051b-42c2-a1f9-65a516cf3705"],
 " is the unitary matrix that diagonalizes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["G", 
     RowBox[{"1", "/", "2"}]], "\[InvisibleSpace]", "F", "\[VeryThinSpace]\[InvisibleSpace]", 
    SuperscriptBox["G", 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "27cd7407-53e1-4a78-b0b5-c25fa95efcae"],
 " "
}], "ExpositoryText",
 InitializationCell->True,
 CellChangeTimes->{{3.909335854986598*^9, 
  3.9093359077120113`*^9}},ExpressionUUID->"cacc947d-1422-488f-8c9c-\
41c177a9ed4c"],

Cell["\<\
Therefore when we do integrals in this coordinate system we have\
\>", "ExpositoryText",
 CellChangeTimes->{{3.909335925580475*^9, 
  3.909335945038775*^9}},ExpressionUUID->"262b173a-d9bf-42c4-b195-\
f031b1dd20b3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"f", "(", 
      StyleBox["x",
       FontWeight->"Bold"], ")"}], 
     RowBox[{"\[DifferentialD]", 
      StyleBox["x",
       FontWeight->"Bold"]}]}]}], " ", "=", " ", 
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"f", "(", 
      StyleBox["q",
       FontWeight->"Bold"], ")"}], 
     RowBox[{"\[LeftBracketingBar]", "L", "\[RightBracketingBar]"}], 
     RowBox[{"\[DifferentialD]", "q"}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9093359377181597`*^9, 3.909336033549362*^9}, {
  3.9093369608261747`*^9, 
  3.909336961202691*^9}},ExpressionUUID->"a9dbca1d-88ae-4146-b958-\
b9010466fc8f"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", "L", "\[RightBracketingBar]"}], " ", "=", 
    " ", 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", "G", "\[RightBracketingBar]"}], 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "a6d3a6b2-8034-4f8e-9896-74ba26c24601"],
 ", here it should be noted that ",
 Cell[BoxData[
  FormBox[
   StyleBox["x",
    FontWeight->"Bold"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "432688b4-de4f-498c-939e-4c1d540ba071"],
 " need not be proper Cartesian coordinates"
}], "ExpositoryText",
 CellChangeTimes->{{3.9093360362168713`*^9, 3.9093360486718693`*^9}, {
  3.909336963638089*^9, 
  3.909336985947054*^9}},ExpressionUUID->"b9e55593-f919-4b9a-a4a3-\
a42d4b31b0cb"],

Cell["\<\
And so for every linear transformation we have we need to multiply by the \
determinant of the transformation\
\>", "ExpositoryText",
 CellChangeTimes->{{3.909337584410099*^9, 
  3.9093376242159*^9}},ExpressionUUID->"531c2c76-262c-4425-9459-ce6c6d4b9bcc"],

Cell["\<\
DOESN\[CloseCurlyDoubleQuote]T FUCKING MATTER SINCE WE INTEGRATE ALONG THE \
AXES DEFINED BY COMPUTING EIGENVALUES OF THE COVARIANCE MATRIX \[Rule] THIS \
IS ALWAYS UNITARY\
\>", "ExpositoryText",
 CellChangeTimes->{{3.909339253798505*^9, 3.9093392962418003`*^9}},
 FontColor->RGBColor[
  1, 0, 0],ExpressionUUID->"614b88cc-dc18-4a91-88d1-67cd9dc89eb8"]
}, Closed]],

Cell[CellGroupData[{

Cell["Integration of the Potential (Non-Rotated)", "Section",
 CellChangeTimes->{{3.883123992551524*^9, 3.8831239930406933`*^9}, {
   3.883124042832305*^9, 3.883124075000765*^9}, 
   3.883927303310082*^9},ExpressionUUID->"d6ae988c-6904-49d2-a12c-\
008ef85ccc24"],

Cell[TextData[{
 "We start with our multivariate Gaussian basis function centered around a \
point ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Xi]", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "434ba74e-19df-4b26-9be9-0df2a8783cf6"]
}], "ExpositoryText",
 CellChangeTimes->{{3.883124356730083*^9, 3.8831243942580442`*^9}, {
  3.8831244648190002`*^9, 
  3.883124467853714*^9}},ExpressionUUID->"8dbb19d5-0c75-44dd-96f6-\
d0b4bf8eecb8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CurlyPhi]", "i"], "(", 
    StyleBox["x",
     FontWeight->"Bold"], ")"}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Product]", 
     RowBox[{"j", "\[VeryThinSpace]", "=", "\[VeryThinSpace]", "1"}], 
     RowBox[{"3", "\[InvisibleSpace]", "N"}]], " ", 
    RowBox[{"\[Phi]", "(", 
     RowBox[{
      RowBox[{
       SubscriptBox["x", 
        RowBox[{"j", ","}]], 
       SubsuperscriptBox["\[Xi]", "j", 
        RowBox[{"(", "i", ")"}]]}], ",", " ", 
      SubscriptBox["\[Alpha]", "i"]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.883123758929969*^9, 3.883123814163766*^9}, {
  3.8831238444687757`*^9, 3.883123896321591*^9}, {3.88312614649897*^9, 
  3.8831261524609327`*^9}},ExpressionUUID->"dbfff558-1087-4a1a-908c-\
0dba9e6d15bc"],

Cell["the integral we then want to evaluate is", "ExpositoryText",
 CellChangeTimes->{{3.883124401756212*^9, 
  3.883124410627383*^9}},ExpressionUUID->"f0d0fb4e-e814-4f5c-b903-\
05633733898b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Integral]", 
    SuperscriptBox["\[DoubleStruckCapitalR]", "N"]], 
   RowBox[{
    RowBox[{
     SubscriptBox["\[CurlyPhi]", "i"], "(", 
     StyleBox["x",
      FontWeight->"Bold"], ")"}], 
    RowBox[{"V", "(", 
     StyleBox["x",
      FontWeight->"Bold"], ")"}], 
    RowBox[{
     SubscriptBox["\[CurlyPhi]", "j"], "(", 
     StyleBox["x",
      FontWeight->"Bold"], ")"}], 
    RowBox[{"\[DifferentialD]", 
     StyleBox["x",
      FontWeight->"Bold"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8831244119780197`*^9, 
  3.8831244966482286`*^9}},ExpressionUUID->"4a358a31-4dde-4490-9231-\
0b42ebc0779d"],

Cell["where then ", "ExpositoryText",
 CellChangeTimes->{{3.8831261689770107`*^9, 
  3.883126177583562*^9}},ExpressionUUID->"67327a8e-39d4-408a-95ad-\
822e0f09a201"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[CurlyPhi]", "i"], "(", 
        StyleBox["x",
         FontWeight->"Bold"], ")"}], 
       RowBox[{
        SubscriptBox["\[CurlyPhi]", "j"], "(", 
        StyleBox["x",
         FontWeight->"Bold"], ")"}]}], "=", 
      RowBox[{
       UnderoverscriptBox["\[Product]", 
        RowBox[{"k", "\[VeryThinSpace]", "=", "\[VeryThinSpace]", "1"}], 
        RowBox[{"3", "\[InvisibleSpace]", "N"}]], " ", 
       RowBox[{
        RowBox[{"\[Phi]", "(", 
         RowBox[{
          RowBox[{
           SubscriptBox["x", 
            RowBox[{"k", ","}]], 
           SubsuperscriptBox["\[Xi]", "k", 
            RowBox[{"(", "i", ")"}]]}], ",", " ", 
          SubscriptBox["\[Alpha]", "i"]}], ")"}], 
        RowBox[{"\[Phi]", "(", 
         RowBox[{
          RowBox[{
           SubscriptBox["x", 
            RowBox[{"k", ","}]], 
           SubsuperscriptBox["\[Xi]", "k", 
            RowBox[{"(", "j", ")"}]]}], ",", " ", 
          SubscriptBox["\[Alpha]", "j"]}], ")"}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderoverscriptBox["\[Product]", 
        RowBox[{"k", "\[VeryThinSpace]", "=", "\[VeryThinSpace]", "1"}], 
        RowBox[{"3", "\[InvisibleSpace]", "N"}]], " ", 
       RowBox[{
        RowBox[{"W", "(", 
         RowBox[{
          FractionBox[
           RowBox[{
            SubscriptBox["\[Alpha]", "i"], 
            SubscriptBox["\[Alpha]", "j"]}], 
           RowBox[{
            SubscriptBox["\[Alpha]", "i"], "+", 
            SubscriptBox["\[Alpha]", "j"]}]], ",", " ", 
          RowBox[{
           SubsuperscriptBox["\[Xi]", "k", 
            RowBox[{"(", "i", ")"}]], "-", 
           SubsuperscriptBox["\[Xi]", "k", 
            RowBox[{"(", "j", ")"}]]}]}], ")"}], 
        RowBox[{
         UnderoverscriptBox["\[Product]", 
          RowBox[{"k", "\[VeryThinSpace]", "=", "\[VeryThinSpace]", "1"}], 
          RowBox[{"3", "\[InvisibleSpace]", "N"}]], " ", 
         RowBox[{"\[Phi]", "(", 
          RowBox[{
           RowBox[{
            SubscriptBox["x", 
             RowBox[{"k", ","}]], 
            FractionBox[
             RowBox[{
              RowBox[{
               SubscriptBox["\[Alpha]", "i"], 
               SubsuperscriptBox["\[Xi]", "k", 
                RowBox[{"(", "i", ")"}]]}], "+", 
              RowBox[{
               SubscriptBox["\[Alpha]", "j"], 
               SubsuperscriptBox["\[Xi]", "k", 
                RowBox[{"(", "j", ")"}]]}]}], 
             RowBox[{
              SubscriptBox["\[Alpha]", "i"], "+", 
              SubscriptBox["\[Alpha]", "j"]}]]}], ",", " ", 
           RowBox[{
            SubscriptBox["\[Alpha]", "i"], "+", 
            SubscriptBox["\[Alpha]", "j"]}]}], ")"}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.883123758929969*^9, 3.883123814163766*^9}, {
  3.8831238444687757`*^9, 3.883123896321591*^9}, {3.88312614649897*^9, 
  3.8831261524609327`*^9}, {3.883126201966607*^9, 3.8831262048748617`*^9}, {
  3.883126311874861*^9, 3.883126425352859*^9}, {3.883127837204975*^9, 
  3.8831278453242493`*^9}},ExpressionUUID->"1e77bedb-8a85-4e64-a172-\
4953faa5801b"],

Cell["and so", "ExpositoryText",
 CellChangeTimes->{{3.883127864861682*^9, 
  3.8831278655214*^9}},ExpressionUUID->"9996ddf2-50f2-48f5-a444-d4dbb68b5cdb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Integral]", 
     SuperscriptBox["\[DoubleStruckCapitalR]", "N"]], 
    RowBox[{
     RowBox[{
      SubscriptBox["\[CurlyPhi]", "i"], "(", 
      StyleBox["x",
       FontWeight->"Bold"], ")"}], 
     RowBox[{"V", "(", 
      StyleBox["x",
       FontWeight->"Bold"], ")"}], 
     RowBox[{
      SubscriptBox["\[CurlyPhi]", "j"], "(", 
      StyleBox["x",
       FontWeight->"Bold"], ")"}], 
     RowBox[{"\[DifferentialD]", 
      StyleBox["x",
       FontWeight->"Bold"]}]}]}], 
   StyleBox[" ",
    FontWeight->"Bold"], 
   StyleBox["=",
    FontWeight->"Bold"], 
   StyleBox[" ",
    FontWeight->"Bold"], 
   RowBox[{
    UnderoverscriptBox["\[Product]", 
     RowBox[{"k", "\[VeryThinSpace]", "=", "\[VeryThinSpace]", "1"}], 
     RowBox[{"3", "\[InvisibleSpace]", "N"}]], " ", 
    RowBox[{
     RowBox[{"W", "(", 
      RowBox[{
       FractionBox[
        RowBox[{
         SubscriptBox["\[Alpha]", "i"], 
         SubscriptBox["\[Alpha]", "j"]}], 
        RowBox[{
         SubscriptBox["\[Alpha]", "i"], "+", 
         SubscriptBox["\[Alpha]", "j"]}]], ",", " ", 
       RowBox[{
        SubsuperscriptBox["\[Xi]", "k", 
         RowBox[{"(", "i", ")"}]], "-", 
        SubsuperscriptBox["\[Xi]", "k", 
         RowBox[{"(", "j", ")"}]]}]}], ")"}], 
     RowBox[{
      SubscriptBox["\[Integral]", 
       SuperscriptBox["\[DoubleStruckCapitalR]", "N"]], 
      RowBox[{
       RowBox[{"V", "(", "\[InvisibleSpace]", 
        StyleBox["x",
         FontWeight->"Bold"], ")"}], 
       RowBox[{
        UnderoverscriptBox["\[Product]", 
         RowBox[{"k", "\[VeryThinSpace]", "=", "\[VeryThinSpace]", "1"}], 
         RowBox[{"3", "\[InvisibleSpace]", "N"}]], " ", 
        RowBox[{
         RowBox[{"\[Phi]", "(", 
          RowBox[{
           RowBox[{
            SubscriptBox["x", 
             RowBox[{"k", ","}]], 
            FractionBox[
             RowBox[{
              RowBox[{
               SubscriptBox["\[Alpha]", "i"], 
               SubsuperscriptBox["\[Xi]", "k", 
                RowBox[{"(", "i", ")"}]]}], "+", 
              RowBox[{
               SubscriptBox["\[Alpha]", "j"], 
               SubsuperscriptBox["\[Xi]", "k", 
                RowBox[{"(", "j", ")"}]]}]}], 
             RowBox[{
              SubscriptBox["\[Alpha]", "i"], "+", 
              SubscriptBox["\[Alpha]", "j"]}]]}], ",", " ", 
           RowBox[{
            SubscriptBox["\[Alpha]", "i"], "+", 
            SubscriptBox["\[Alpha]", "j"]}]}], ")"}], 
         RowBox[{"\[DifferentialD]", 
          StyleBox["x",
           FontWeight->"Bold"], 
          StyleBox[" ",
           FontWeight->"Bold"]}]}]}]}]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8831244119780197`*^9, 3.8831244966482286`*^9}, {
  3.8831278764971848`*^9, 
  3.883127905878129*^9}},ExpressionUUID->"1f0fba32-8c3f-4eea-b36f-\
1da692cda2c6"],

Cell["\<\
When evaluating this final integral, we then have a few approaches\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8831240767686768`*^9, 3.8831241142902937`*^9}, {
  3.88312416273335*^9, 3.883124163219351*^9}, {3.8831262659792423`*^9, 
  3.883126277646923*^9}},ExpressionUUID->"ab2e7a3d-08d8-4b09-8f79-\
9d82bffc46d0"],

Cell[CellGroupData[{

Cell["Quadrature", "Subsection",
 CellChangeTimes->{{3.883124166447246*^9, 
  3.8831241677900476`*^9}},ExpressionUUID->"ab5e140b-6edc-4498-8917-\
9686e32ea630"],

Cell["Straightforward", "Item",
 CellChangeTimes->{{3.883124171205138*^9, 
  3.883124176015588*^9}},ExpressionUUID->"6106d09f-570b-44fe-8a94-\
305cd5521df3"],

Cell[TextData[{
 "The relevant Gauss-Hermite quadrature weights are built into ",
 StyleBox["scipy", "Input"]
}], "Item",
 CellChangeTimes->{{3.883124171205138*^9, 
  3.883124191240909*^9}},ExpressionUUID->"d6716541-e188-440e-a424-\
9607c6c79ce8"],

Cell["Scales poorly with dimension", "Item",
 CellChangeTimes->{{3.883124171205138*^9, 
  3.8831241987300043`*^9}},ExpressionUUID->"af316408-6ece-4908-93c5-\
c5590f3c80da"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Expansions", "Subsection",
 CellChangeTimes->{{3.883124213569124*^9, 
  3.8831242148358*^9}},ExpressionUUID->"9896706d-fe24-43c6-9d7f-3f923a775b22"],

Cell[CellGroupData[{

Cell["Taylor Series", "Subsubsection",
 CellChangeTimes->{{3.883124217425473*^9, 
  3.883124219359178*^9}},ExpressionUUID->"a3b38a9f-6a1e-45dd-be45-\
a66ddfdb2a16"],

Cell[TextData[{
 "We expand the potential up to some order ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "8b07b525-a304-4a51-ae2b-acc8d530103c"],
 " about some point \[Zeta] as"
}], "ExpositoryText",
 CellChangeTimes->{{3.883127923572064*^9, 3.883127927310117*^9}, {
  3.8831279939117603`*^9, 3.883128004784255*^9}, {3.883128170429634*^9, 
  3.883128189595727*^9}},ExpressionUUID->"78798d4c-d4fd-4bf8-8d84-\
9747fdb95814"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"V", "(", 
    StyleBox["x",
     FontWeight->"Bold"], ")"}], " ", "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"m", "=", "0"}], "M"], " ", 
    RowBox[{
     FractionBox["1", "W"], 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["X", "m"]], 
       RowBox[{"V", "(", 
        StyleBox["\[Zeta]",
         FontWeight->"Bold"], ")"}]}], "\[CircleDot]", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "-", "\[Zeta]"}], ")"}], "m"]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8831279284975986`*^9, 3.8831281673787746`*^9}, {
  3.883128229307835*^9, 3.883128251627759*^9}, {3.88394449724827*^9, 
  3.883944512113727*^9}},ExpressionUUID->"88e201dd-75a3-4463-86fd-\
642cef6e8e3d"],

Cell[TextData[{
 "where \[CircleDot] signifies a complete contraction of the tensors and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"x", "-", "\[Zeta]"}], ")"}], "m"], TraditionalForm]],
  CellChangeTimes->{{3.88312827110246*^9, 3.883128294301681*^9}},
  ExpressionUUID->"2a37c315-bfc6-4231-97c1-5effa39b17f7"],
 " is the ",
 StyleBox["m",
  FontSlant->"Italic"],
 "th-order outer product"
}], "ExpositoryText",
 CellChangeTimes->{{3.883128224113007*^9, 3.883128266728222*^9}, {
  3.8831283125167227`*^9, 
  3.883128324667981*^9}},ExpressionUUID->"03173bf5-6140-4d68-aed7-\
737a7cc900b1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"x", "-", "\[Zeta]"}], ")"}], "m"], " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"x", "-", "\[Zeta]"}], ")"}], "\[CircleTimes]", "\[Ellipsis]", 
    "\[CircleTimes]", 
    RowBox[{"(", 
