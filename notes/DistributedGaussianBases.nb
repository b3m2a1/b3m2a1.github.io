Cell[BoxData[
 RowBox[{
  RowBox[{"mk", "[", "k_", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"b", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"EvenQ", "[", "k", "]"}], ",", " ", 
         RowBox[{"1", "/", "2"}], ",", " ", 
         RowBox[{"3", "/", "2"}]}], "]"}]}], ",", " ", 
      RowBox[{"m", "=", 
       RowBox[{"Floor", "[", 
        RowBox[{"k", "/", "2"}], "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     FractionBox[
      RowBox[{"2", "^", "m"}], 
      RowBox[{"Sqrt", "[", "\[Pi]", "]"}]], 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "/", "2"}], ")"}], "^", "n"}], " ", 
        RowBox[{
         RowBox[{"Gamma", "[", 
          RowBox[{"b", "+", "m"}], "]"}], "/", 
         RowBox[{"Pochhammer", "[", 
          RowBox[{"b", ",", " ", "n"}], "]"}]}], "*", 
        RowBox[{"Binomial", "[", 
         RowBox[{"m", ",", " ", "n"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "0", ",", " ", "m"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9161747865186253`*^9, 3.916174865307804*^9}, {
