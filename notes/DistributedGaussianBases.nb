Cell[BoxData[
 RowBox[{
  RowBox[{"distVector", "[", 
   RowBox[{"coords_", ",", " ", "i_", ",", " ", "j_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", "=", 
      RowBox[{"Norm", "[", 
       RowBox[{
        RowBox[{"coords", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "-", 
        RowBox[{"coords", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Flatten", "@", 
     RowBox[{"ReplacePart", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"Dimensions", "[", "coords", "]"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"i", "->", 
          RowBox[{
           RowBox[{"coords", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "-", 
           RowBox[{"coords", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"j", "->", 
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"coords", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "-", 
             RowBox[{"coords", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}]}]}], 
        "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
