b2831c2ba698"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["P", 
     StyleBox["n",
      FontWeight->"Bold"], 
     RowBox[{"(", "i", ")"}]], "(", "x", ")"}], " ", "=", " ", 
   RowBox[{
    UnderscriptBox["\[Product]", "k"], 
    RowBox[{
     FractionBox["1", 
      SqrtBox[
       RowBox[{
        SubscriptBox["n", "k"], "!"}]]], 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["P",
        FontWeight->"Bold"], 
       SubscriptBox["n", "k"], 
       RowBox[{"(", "i", ")"}]], "\[CircleDot]", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["x", "k"], 
         StyleBox["\[VeryThinSpace] ",
          FontSize->14], 
         StyleBox["-",
          FontSize->14], 
         StyleBox[" ",
          FontSize->14], 
         SubsuperscriptBox["\[Xi]", "k", 
          RowBox[{"(", 
           RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]]}], ")"}], 
       SubscriptBox[
        StyleBox["n",
         FontWeight->"Bold"], 
        StyleBox["k",
         FontWeight->"Bold"]]]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8865456303381042`*^9, 
  3.886545674332477*^9}},ExpressionUUID->"2b03e37b-125e-4a87-b0bb-\
a1ff41dcc529"],

Cell["which we can write as a single expansion by defining", "ExpositoryText",
 CellChangeTimes->{{3.886545770567957*^9, 3.886545823255168*^9}, {
  3.8865458567105618`*^9, 3.886545871255575*^9}, {3.886545959649672*^9, 
  3.886545961928405*^9}, {3.8865473963174133`*^9, 
  3.886547400767968*^9}},ExpressionUUID->"3f604993-7f94-4030-a1e8-\
c312b3ba9a7f"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox[
       StyleBox["P",
        FontWeight->"Bold"], 
       StyleBox["n",
        FontWeight->"Bold"], 
       RowBox[{"(", "i", ")"}]], " ", "=", " ", 
      RowBox[{
       UnderscriptBox["\[CircleTimes]", "k"], 
       SubsuperscriptBox[
        StyleBox["P",
         FontWeight->"Bold"], 
        SubscriptBox["n", "k"], 
        RowBox[{"(", "i", ")"}]]}]}]},
    {
     RowBox[{
      SuperscriptBox["\[Chi]", 
       StyleBox["n",
        FontWeight->"Bold"]], "=", " ", 
      RowBox[{
       UnderscriptBox["\[CircleTimes]", "k"], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["x", "k"], 
          StyleBox["\[VeryThinSpace] ",
           FontSize->14], 
          StyleBox["-",
           FontSize->14], 
          StyleBox[" ",
           FontSize->14], 
          SubsuperscriptBox["\[Xi]", "k", 
           RowBox[{"(", 
            RowBox[{"i", "\[InvisibleSpace]", "j"}], ")"}]]}], ")"}], 
        SubscriptBox[
         StyleBox["n",
          FontWeight->"Bold"], 
         StyleBox["k",
          FontWeight->"Bold"]]]}]}]},
    {
     RowBox[{
      RowBox[{
       StyleBox["n",
        FontWeight->"Bold"], 
       StyleBox["!",
        FontWeight->"Plain"]}], 
      StyleBox[" ",
       FontWeight->"Plain"], 
      StyleBox["=",
       FontWeight->"Plain"], 
      StyleBox[" ",
       FontWeight->"Plain"], 
      RowBox[{
       UnderscriptBox["\[Product]", "k"], 
       FractionBox["1", 
        RowBox[{
         SubscriptBox["n", "k"], "!"}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.886545963823099*^9, 3.88654596450168*^9}, {
  3.886546078106954*^9, 3.886546079237685*^9}, {3.886547331376244*^9, 
