 RowBox[{
  RowBox[{"rotIntData", "[", "\[IndentingNewLine]", 
   RowBox[{
   "\[CapitalSigma]Ii_", ",", " ", "\[CapitalSigma]Ij_", ",", 
    "\[IndentingNewLine]", "\[Rho]i_", ",", " ", "\[Rho]j_", ",", 
    "\[IndentingNewLine]", "\[Xi]i_", ",", " ", "\[Xi]j_"}], 
   "\[IndentingNewLine]", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Block", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[CapitalSigma]Ic", "=", 
       RowBox[{"\[CapitalSigma]Ii", "+", "\[CapitalSigma]Ij"}]}], ",", 
      "\[IndentingNewLine]", "\[CapitalSigma]c", ",", "\[Xi]c", ",", 
      "\[CapitalSigma]p", ",", "\[IndentingNewLine]", 
      RowBox[{"\[CapitalDelta]\[CapitalSigma]", "=", 
       RowBox[{"\[CapitalSigma]Ii", "-", "\[CapitalSigma]Ij"}]}], ",", 
      "\[IndentingNewLine]", "\[CapitalGamma]j", ",", "\[CapitalGamma]i", ",",
       "\[IndentingNewLine]", "\[CapitalDelta]\[Xi]"}], "\[IndentingNewLine]",
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[CapitalSigma]c", "=", 
      RowBox[{"Inverse", "[", "\[CapitalSigma]Ic", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Xi]c", "=", 
      RowBox[{"\[CapitalSigma]c", ".", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[CapitalSigma]Ii", ".", "\[Xi]i"}], "+", 
         RowBox[{"\[CapitalSigma]Ij", ".", "\[Xi]j"}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[CapitalSigma]p", "=", 
      RowBox[{"Inverse", "[", 
       RowBox[{
        RowBox[{"Inverse", "[", "\[CapitalSigma]Ii", "]"}], "+", 
        RowBox[{"Inverse", "[", "\[CapitalSigma]Ij", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[CapitalGamma]j", "=", 
      RowBox[{"\[CapitalSigma]c", ".", "\[CapitalSigma]Ij"}]}], ";", 
     RowBox[{"\[CapitalGamma]i", "=", 
      RowBox[{"\[CapitalSigma]c", ".", "\[CapitalSigma]Ii"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[CapitalDelta]\[Xi]", "=", 
      RowBox[{
      "\[CapitalSigma]Ij", ".", "\[CapitalSigma]c", ".", "\[CapitalSigma]Ii", 
       ".", 
       RowBox[{"(", 
        RowBox[{"\[Xi]i", "-", "\[Xi]j"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\"\<\[Xi]c\>\"", "->", "\[Xi]c"}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<\[CapitalDelta]\[Xi]\>\"", "->", "\[CapitalDelta]\[Xi]"}],
        ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<\[CapitalSigma]c\>\"", "->", "\[CapitalSigma]c"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<\[CapitalSigma]+\>\"", "->", "\[CapitalSigma]p"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<\[CapitalGamma]i\>\"", "->", "\[CapitalGamma]j"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<\[CapitalGamma]j\>\"", "->", "\[CapitalGamma]i"}], ",", 
       "\[IndentingNewLine]", 
