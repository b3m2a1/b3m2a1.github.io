Cell["\<\
and introducing a n-th function, the orthogonalization is obvious but the \
normalization comes out to\
\>", "ExpositoryText",
 CellChangeTimes->{{3.913227592827304*^9, 3.913227610200446*^9}, {
  3.9132280691866007`*^9, 
  3.913228071412326*^9}},ExpressionUUID->"85acaf69-a9ba-41d3-90c6-\
0a14278d5b37"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     RowBox[{
       SubscriptBox["\[CurlyPhi]", "3"], "\[VeryThinSpace]"}], 
     RowBox[{" ", 
       SubscriptBox["\[CurlyPhi]", "3"]}]},
    "BraKet"], " ", "=", " ", 
   RowBox[{"1", " ", "-", " ", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"i", "<", "4"}]], 
     SuperscriptBox[
      TemplateBox[{
        RowBox[{
          SubscriptBox["\[Phi]", "i"], "\[VeryThinSpace]\[VeryThinSpace]"}], 
        RowBox[{" ", 
          SubscriptBox["\[Phi]", "4"]}]},
       "BraKet"], "2"]}], " ", "+", " ", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"j", "<", "4"}]], "\[VeryThinSpace]", 
     RowBox[{
      TemplateBox[{
        RowBox[{
          SubscriptBox["\[Phi]", "i"], "\[VeryThinSpace]"}], 
        RowBox[{" ", 
          SubscriptBox["\[Phi]", "4"]}]},
       "BraKet"], 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{"i", "<", "4", "\[NotEqual]", "j"}]], " ", 
       RowBox[{
        TemplateBox[{
          RowBox[{
            SubscriptBox["\[Phi]", "j"], "\[VeryThinSpace]\[VeryThinSpace]"}], 
          RowBox[{" ", 
            SubscriptBox["\[Phi]", "4"]}]},
         "BraKet"], 
        TemplateBox[{
          RowBox[{
            SubscriptBox["\[Phi]", "i"], "\[VeryThinSpace]\[VeryThinSpace]"}], 
          RowBox[{" ", 
            SubscriptBox["\[Phi]", "j"], "\[ThinSpace]"}]},
         "BraKet"]}]}]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.913227186008411*^9, 3.913227201319365*^9}, {
  3.913227302278181*^9, 3.913227478912817*^9}, {3.9132275176939373`*^9, 
  3.913227530013719*^9}, {3.913227621817424*^9, 3.913227776246922*^9}, {
