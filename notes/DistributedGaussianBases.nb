         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"\[CapitalIota]", "|", "\[FormalCapitalI]"}], "->", 
            RowBox[{"IdentityMatrix", "[", 
             RowBox[{"Length", "@", "sig1"}], "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"J", "[", "j", "]"}], "->", 
            RowBox[{"rd", "[", "\"\<Jj\>\"", "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"J", "[", "i", "]"}], "->", 
            RowBox[{"rd", "[", "\"\<Ji\>\"", "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"\[Xi]", "[", "c", "]"}], "->", 
            RowBox[{"rd", "[", "\"\<\[Xi]c\>\"", "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"\[CapitalSigma]", "[", "j", "]"}], "->", 
