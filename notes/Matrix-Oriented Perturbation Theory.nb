Cell[CellGroupData[{

Cell["G-Matrix Derivatives", "Section",
 CellChangeTimes->{{3.792767635692697*^9, 3.7927676440229387`*^9}, {
  3.812230555753623*^9, 
  3.812230561906101*^9}},ExpressionUUID->"341422ee-aa25-42d8-aad2-\
f6aa7f440b77"],

Cell[CellGroupData[{

Cell["Helpful Notes", "Subsection",
 CellChangeTimes->{{3.792767711217198*^9, 
  3.792767714413887*^9}},ExpressionUUID->"668753e0-ee58-4707-8d21-\
e9a192fad26f"],

Cell[TextData[{
 "When reading ",
 StyleBox["Wilson, Decius, & Cross",
  FontSlant->"Italic"],
 " (WDC) the authors introduce some odd terminology at least according to \
modern notation. First off, they define their internal coordinates by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "i"], TraditionalForm]],ExpressionUUID->
  "0a8273e7-c168-4c52-85e4-bf880fcfb108"],
 " which, like, fine. I\[CloseCurlyQuote]m gonna use ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "i"], TraditionalForm]],ExpressionUUID->
  "0bf3ea5d-1616-4b99-9646-c9ba8a0a5ab1"],
 ", because that\[CloseCurlyQuote]s more in line with that we do."
}], "Text",
 CellChangeTimes->{{3.792767719669285*^9, 3.792767772917045*^9}, {
  3.792767808831398*^9, 3.792767842558897*^9}, {3.792767877920217*^9, 
  3.792767914434022*^9}, {3.792768925060734*^9, 3.7927689250635843`*^9}, {
  3.810990020497322*^9, 
  3.810990041221101*^9}},ExpressionUUID->"90b2234f-897e-4c1f-b882-\
ce9070b6be2f"],

Cell[TextData[{
 "Then given a reference structure which I\[CloseCurlyQuote]ll call ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S",
     FontWeight->"Bold"], "e"], TraditionalForm]],ExpressionUUID->
  "bae8326b-cf89-4bc8-ae07-25886331241c"],
 " and whose existence they allow to be implicit, they approximate the \
internals up to first order by Cartesians by an equation that they write as"
}], "Text",
 CellChangeTimes->{{3.792767719669285*^9, 3.792767772917045*^9}, {
  3.792767808831398*^9, 3.792767842558897*^9}, {3.792767877920217*^9, 
  3.792768005172995*^9}, {3.792768056459895*^9, 3.792768056956216*^9}, {
  3.7927681313439903`*^9, 
  3.7927681363442087`*^9}},ExpressionUUID->"796ca363-bdc0-4d75-8fff-\
d045034f0e28"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["S", "t"], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], "N"], 
     RowBox[{
      SubscriptBox["B", 
       RowBox[{"t", "\[InvisibleSpace]", "i"}]], 
      SubscriptBox["\[Xi]", "i"]}]}]}], " ", ",", " ", 
   RowBox[{"t", " ", "=", "1"}], ",", " ", "2", ",", " ", "\[Ellipsis]", ",", 
   " ", "M"}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.792768007135517*^9, 3.792768049915793*^9}, {
  3.7927681073958883`*^9, 3.792768119119953*^9}, {3.792774162125766*^9, 
  3.792774176277423*^9}},ExpressionUUID->"37079717-2726-41e8-8210-\
abcc7cf85937"],

Cell[TextData[{
 "where ",
 StyleBox["N",
  FontSlant->"Italic"],
 " and ",
 StyleBox["M",
  FontSlant->"Italic"],
 " are the number of Cartesian coordinates and number of respective internal \
coordinates"
}], "ExpositoryText",
 CellChangeTimes->{{3.79277417881313*^9, 
  3.792774199077642*^9}},ExpressionUUID->"9ee6317a-eb94-45a6-98e6-\
3bdf2c7535c5"],

Cell[TextData[{
 "Here we have ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Xi]", "i"], TraditionalForm]],
  CellChangeTimes->{{3.792768007135517*^9, 3.792768049915793*^9}, {
   3.7927681073958883`*^9, 3.792768119119953*^9}},ExpressionUUID->
  "41dcb6b6-11eb-4ceb-835a-79857f8bc5f8"],
 " being the Cartesian displacement. I\[CloseCurlyQuote]d usually call it ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", 
    SubscriptBox["x", "i"]}], TraditionalForm]],ExpressionUUID->
  "acfa37fe-8c60-4ef6-a8af-1bd683384949"],
 ". And the ",
 StyleBox["B",
  FontSlant->"Italic"],
 " term is just the derivative of the internal with respect to the \
Cartesians. This can be much stated more cleanly by saying that we\
\[CloseCurlyQuote]ll ",
 StyleBox["represent",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "t"], TraditionalForm]],ExpressionUUID->
  "cee61383-e163-44f3-b6d1-f253c632097d"],
 " as"
}], "Text",
 CellChangeTimes->{{3.7927689478344393`*^9, 
  3.792769029234089*^9}},ExpressionUUID->"dc55ac6f-afb2-4d80-b00e-\
70af7e25ecad"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["S", "t"], ":", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["S", "t"]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", "1"]}]], "\[CapitalDelta]", "\[InvisibleSpace]", 
       SubscriptBox["x", "1"]}], ",", " ", 
      RowBox[{
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["S", "t"]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", 
          RowBox[{"\[VeryThinSpace]", "2"}]]}]], "\[CapitalDelta]", 
       "\[InvisibleSpace]", 
       SubscriptBox["x", 
        RowBox[{"\[VeryThinSpace]", "2"}]]}], ",", " ", "\[Ellipsis]", ",", 
      " ", 
      RowBox[{
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["S", "t"]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", 
          RowBox[{"\[VeryThinSpace]", 
           RowBox[{"3", "\[InvisibleSpace]", "N"}]}]]}]], "\[CapitalDelta]", 
       "\[InvisibleSpace]", 
       SubscriptBox["x", 
        RowBox[{"\[VeryThinSpace]", 
         RowBox[{"3", "\[InvisibleSpace]", "N"}]}]]}]}], ")"}]}], " ", "=", 
   " ", 
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", 
        SubscriptBox["S", "t"]}], 
       RowBox[{"\[PartialD]", 
        SubscriptBox["x", "i"]}]], "\[CapitalDelta]", "\[InvisibleSpace]", 
      SubscriptBox["x", "i"]}], ")"}], 
    RowBox[{
     RowBox[{"i", "=", "1"}], ",", "\[Ellipsis]"}]]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.7927680918808537`*^9, 3.792768104883374*^9}, {
  3.792768150769684*^9, 3.792768168065117*^9}, {3.7927682045216503`*^9, 
  3.792768337944633*^9}, {3.7927740848153753`*^9, 
  3.792774086231617*^9}},ExpressionUUID->"e7c47dd7-10ac-46a9-9a8a-\
e3bf0324d6c9"],

Cell[TextData[{
 "This is saying that we\[CloseCurlyQuote]ll linearly approximate our \
internal as a Cartesian displacement. We won\[CloseCurlyQuote]t actually use \
this definition to evaluate the our internals, but these derivatives are \
important as this is how we get the ",
 StyleBox["B",
  FontSlant->"Italic"],
 " matrix that is implicitly referred to in the text"
}], "Text",
 CellChangeTimes->{{3.792769038333015*^9, 3.7927691135961637`*^9}, {
  3.792769148008779*^9, 
  3.792769186321493*^9}},ExpressionUUID->"bd9b5d77-2ca2-4358-b0b8-\
4f6ae514b545"],

Cell[BoxData[
 FormBox[
  RowBox[{"B", "=", 
   RowBox[{"(", GridBox[{
      {
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["S", 
          RowBox[{"\[VeryThinSpace]", "1"}]]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", "1"]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["S", 
          RowBox[{"\[VeryThinSpace]", "1"}]]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", 
          RowBox[{"\[VeryThinSpace]", "2"}]]}]], "\[Ellipsis]", 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["S", 
          RowBox[{"\[VeryThinSpace]", "1"}]]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", "N"]}]]},
      {
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["S", 
          RowBox[{"\[VeryThinSpace]", "2"}]]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", 
          RowBox[{"\[VeryThinSpace]", "1"}]]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["S", 
          RowBox[{"\[VeryThinSpace]", "2"}]]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", 
          RowBox[{"\[VeryThinSpace]", "2"}]]}]], " ", " "},
      {"\[VerticalEllipsis]", " ", "\[DescendingEllipsis]", 
       "\[VerticalEllipsis]"},
      {
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["S", "M"]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", 
          RowBox[{"\[VeryThinSpace]", "1"}]]}]], " ", "\[Ellipsis]", 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["S", "M"]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", "N"]}]]}
     },
     GridBoxAlignment->{"Columns" -> {{Center}}}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.792768376011013*^9, 3.792768522291877*^9}, {
  3.792774090993988*^9, 
  3.792774127978675*^9}},ExpressionUUID->"73b8c35d-f6f2-4111-83f7-\
9142b90622d4"],

Cell[TextData[{
 "For anyone who\[CloseCurlyQuote]s taken intro calc or ever transformed from \
Cartesian to polar coordinates to do an integral, this is just the Jacobian \
matrix and I\[CloseCurlyQuote]m not sure why ",
 StyleBox["WDC",
  FontSlant->"Italic"],
 " don\[CloseCurlyQuote]t refer to it as such."
}], "Text",
 CellChangeTimes->{{3.792768618962439*^9, 
  3.7927686866022587`*^9}},ExpressionUUID->"4ef35315-73e7-4ff9-a066-\
5f31869198c6"],

Cell["\<\
Returning to the notation that I prefer (and introducing a slightly odd \
gradient notation), we have \
\>", "Text",
 CellChangeTimes->{{3.79276890731499*^9, 3.792768917379649*^9}, {
  3.79276919218701*^9, 3.792769231991621*^9}, {3.7927696973871183`*^9, 
  3.7927697105073423`*^9}},ExpressionUUID->"230c41e9-7e43-4e2c-b996-\
f632d490d031"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", 
     StyleBox["X",
      FontSlant->"Plain"]], 
    StyleBox["R",
     FontSlant->"Plain"]}], "=", 
   RowBox[{"(", GridBox[{
      {
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["r", 
          RowBox[{"\[VeryThinSpace]", "1"}]]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", "1"]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["r", 
          RowBox[{"\[VeryThinSpace]", "1"}]]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", 
          RowBox[{"\[VeryThinSpace]", "2"}]]}]], "\[Ellipsis]", 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["r", 
          RowBox[{"\[VeryThinSpace]", "1"}]]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", 
          RowBox[{"\[VeryThinSpace]", "N"}]]}]]},
      {
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["r", 
          RowBox[{"\[VeryThinSpace]", "2"}]]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", 
          RowBox[{"\[VeryThinSpace]", "1"}]]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["r", 
          RowBox[{"\[VeryThinSpace]", "2"}]]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", 
          RowBox[{"\[VeryThinSpace]", "2"}]]}]], " ", " "},
      {"\[VerticalEllipsis]", " ", "\[DescendingEllipsis]", 
       "\[VerticalEllipsis]"},
      {
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["r", "M"]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", 
          RowBox[{"\[VeryThinSpace]", "1"}]]}]], " ", "\[Ellipsis]", 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["r", "M"]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", 
          RowBox[{"\[VeryThinSpace]", "N"}]]}]]}
     },
     GridBoxAlignment->{"Columns" -> {{Center}}}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.792768376011013*^9, 3.792768522291877*^9}, {
   3.792769207896205*^9, 3.7927692172561207`*^9}, {3.792769713641324*^9, 
   3.792769722306731*^9}, {3.792770498978512*^9, 3.7927705111684227`*^9}, 
   3.792774098599304*^9, {3.792774138033946*^9, 
   3.792774156273677*^9}},ExpressionUUID->"09b65f5c-3441-4910-b527-\
0960752da099"],

Cell["\<\
Next, in this notation we\[CloseCurlyQuote]re given that the G-matrix is \
defined as\
\>", "Text",
 CellChangeTimes->{{3.792769243786111*^9, 
  3.792769263873661*^9}},ExpressionUUID->"e53f6e54-0eb7-4c6f-871e-\
b5d012c9d8e6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["G", 
    RowBox[{"i", "\[InvisibleSpace]", "j"}]], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"\[Alpha]", "=", "1"}], "N"], 
    RowBox[{
     FractionBox["1", 
      SubscriptBox["m", "\[Alpha]"]], 
     RowBox[{
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", 
        SubscriptBox["x", "\[Alpha]"]}]], 
      SubscriptBox["r", "i"]}], 
     RowBox[{
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", 
        SubscriptBox["x", "\[Alpha]"]}]], 
      SubscriptBox["r", "j"]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.792767659085104*^9, 3.792767684330935*^9}, {
   3.792768762958074*^9, 3.79276878644915*^9}, {3.792768823805715*^9, 
   3.792768825887085*^9}, {3.7927688636189413`*^9, 3.792768875629446*^9}, 
   3.79276927695639*^9, {3.7927741342628717`*^9, 
   3.7927741348790407`*^9}},ExpressionUUID->"0fa3c9d0-f66b-4302-afc5-\
f19bdc3f8012"],

Cell["\<\
This is all well and good, but we can write this in a more intuitive way. \
Letting \
\>", "Text",
 CellChangeTimes->{{3.792769283360804*^9, 
  3.792769308143152*^9}},ExpressionUUID->"91af4f84-bc42-4870-8d79-\
65a0bc59f7d9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", 
     StyleBox["X",
      FontSlant->"Plain"]], 
    SubscriptBox["r", "i"]}], "=", " ", 
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", 
        SubscriptBox["r", "i"]}], 
       RowBox[{"\[PartialD]", 
        SubscriptBox["x", 
         RowBox[{"\[InvisibleSpace]", "\[Alpha]"}]]}]], "\[CapitalDelta]", 
      "\[InvisibleSpace]", 
      SubscriptBox["x", 
       RowBox[{"\[InvisibleSpace]", "\[Alpha]"}]]}], ")"}], 
    RowBox[{
     RowBox[{"\[Alpha]", "=", "1"}], ",", "\[Ellipsis]", ",", 
     RowBox[{"3", "\[InvisibleSpace]", "N"}]}]]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.7927693111893044`*^9, 3.792769370662322*^9}, {
  3.792769460650931*^9, 3.792769478435019*^9}, {3.792770527975759*^9, 
  3.792770529528*^9}},ExpressionUUID->"4b0f04ce-386e-4661-8d02-911175723716"],

Cell["we\[CloseCurlyQuote]ll define a mass-weighted form of this by ", "Text",
 CellChangeTimes->{{3.7927693835535793`*^9, 
  3.7927694148495617`*^9}},ExpressionUUID->"3d5f612a-3511-4265-88ca-\
65fe39d4ba06"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", 
     StyleBox["Y",
      FontSlant->"Plain"]], 
    SubscriptBox["r", "i"]}], "=", " ", 
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", 
       SqrtBox[
        SubscriptBox["m", "\[Alpha]"]]], 
      FractionBox[
       RowBox[{"\[PartialD]", 
        SubscriptBox["r", "i"]}], 
       RowBox[{"\[PartialD]", 
        SubscriptBox["x", 
         RowBox[{"\[InvisibleSpace]", "\[Alpha]"}]]}]], "\[CapitalDelta]", 
      "\[InvisibleSpace]", 
      SubscriptBox["x", 
       RowBox[{"\[InvisibleSpace]", "\[Alpha]"}]]}], ")"}], 
    RowBox[{
     RowBox[{"\[Alpha]", "=", "1"}], ",", "\[Ellipsis]", ",", 
     RowBox[{"3", "\[InvisibleSpace]", "N"}]}]]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.792769424521513*^9, 3.792769445673414*^9}, {
  3.792769480690885*^9, 3.7927694835944967`*^9}, {3.792770533883256*^9, 
  3.792770535015798*^9}},ExpressionUUID->"ff9dccc3-b791-430d-9f8f-\
4b56a40083a2"],

Cell["\<\
the notation for which is motivated by the mass-weighted Coordinate \
transformation\
\>", "Text",
 CellChangeTimes->{{3.792769449688344*^9, 
  3.792769518687503*^9}},ExpressionUUID->"502a320b-75c1-43ad-969e-\
e0c6616e94c4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["y", "\[Alpha]"], "=", 
   RowBox[{
    SqrtBox[
     SubscriptBox["m", "\[Alpha]"]], 
    SubscriptBox["x", "\[Alpha]"]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.792769497610178*^9, 
  3.7927695120563087`*^9}},ExpressionUUID->"4b648632-8be6-407b-b443-\
7c9dde13903d"],

Cell["taking all of this together we get", "Text",
 CellChangeTimes->{{3.79276952842003*^9, 
  3.792769550531857*^9}},ExpressionUUID->"1afb77a9-3f73-45aa-8d60-\
b99ee99e19b5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["G", 
    RowBox[{"i", "\[InvisibleSpace]", "j"}]], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", 
      StyleBox["Y",
       FontSlant->"Plain"]], 
     SubscriptBox["r", "i"]}], " ", "\[CenterDot]", " ", 
    RowBox[{
     SubscriptBox["\[Del]", 
      StyleBox["Y",
       FontSlant->"Plain"]], 
     SubscriptBox["r", "j"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.792769553751485*^9, 3.792769573859453*^9}, {
  3.792770540635187*^9, 
  3.7927705424117517`*^9}},ExpressionUUID->"b93a64a0-5aad-4572-949a-\
15c6325c853e"],

Cell[TextData[{
 "This type of definition of a matrix element ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["vector", "i"], " ", "\[CenterDot]", " ", 
     SubscriptBox["vector", "j"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "2d94032c-7c7a-467c-9506-11ddacff5a48"],
 " tells us that our matrix can be constructed by a matrix multiplication. In \
this case we have"
}], "Text",
 CellChangeTimes->{{3.79276957965065*^9, 3.792769687115374*^9}, {
  3.7927697415146*^9, 
  3.79276974236313*^9}},ExpressionUUID->"ccf4e8e0-c74a-416c-a1a4-\
b32387c7c1e0"],

Cell[BoxData[
 FormBox[
  RowBox[{"G", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Del]", 
        StyleBox["Y",
         FontSlant->"Plain"]], 
       StyleBox["R",
        FontSlant->"Plain"]}], ")"}], "\[Transpose]"}], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Del]", 
       StyleBox["Y",
        FontSlant->"Plain"]], 
      StyleBox["R",
       FontSlant->"Plain"]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.7927697477254143`*^9, 3.7927698092412777`*^9}, {
  3.792770544683473*^9, 3.792770552027453*^9}, {3.803863757582617*^9, 
  3.803863759214753*^9}, {3.804595863369678*^9, 3.8045958664497557`*^9}, {
  3.8046260451101847`*^9, 
  3.804626050679161*^9}},ExpressionUUID->"469e50a7-d422-46f7-b4b0-\
25f9e9a6c15d"],

Cell[TextData[{
 "where we can build ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", 
     StyleBox["Y",
      FontSlant->"Plain"]], 
    StyleBox["R",
     FontSlant->"Plain"]}], TraditionalForm]],
  CellChangeTimes->{{3.7927698719433117`*^9, 3.792769962723073*^9}, {
   3.792770558323461*^9, 3.79277056070446*^9}, {3.792770677203453*^9, 
   3.792770690714623*^9}},ExpressionUUID->
  "250edfb7-6dc4-4229-80cd-b8ac80add827"],
 " by"
}], "Text",
 CellChangeTimes->{{3.792769851900127*^9, 3.792769870068591*^9}, {
  3.793570393933288*^9, 
  3.7935703973702707`*^9}},ExpressionUUID->"eb2553fe-4741-4d76-8eb5-\
99532aa1418f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", 
     StyleBox["Y",
      FontSlant->"Plain"]], 
    StyleBox["R",
     FontSlant->"Plain"]}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Del]", 
       StyleBox["X",
        FontSlant->"Plain"]], 
      StyleBox["R",
       FontSlant->"Plain"]}], ")"}], 
    SuperscriptBox[
     StyleBox["M",
      FontSlant->"Plain"], 
     RowBox[{"-", 
      FractionBox["1", "2"]}]]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.7927698719433117`*^9, 3.792769962723073*^9}, {
  3.792770558323461*^9, 3.79277056070446*^9}, {3.792770677203453*^9, 
  3.792770690714623*^9}, {3.793570982443698*^9, 
  3.7935710213733873`*^9}},ExpressionUUID->"7166e71e-de15-4d62-911e-\
93b5617621bd"],

Cell["with", "Text",
 CellChangeTimes->{{3.793571003741067*^9, 
  3.79357103495815*^9}},ExpressionUUID->"1ab92893-ed7a-4619-9974-\
3701d2de31f9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["M",
    FontSlant->"Plain"], "=", 
   RowBox[{"(", GridBox[{
      {
       SubscriptBox[
        RowBox[{"m", "\[InvisibleSpace]"}], 
        RowBox[{"\[VeryThinSpace]", "1"}]], " ", " ", " "},
      {" ", 
       SubscriptBox[
        RowBox[{"m", "\[InvisibleSpace]"}], 
        RowBox[{"\[VeryThinSpace]", "2"}]], " ", " "},
      {" ", " ", "\[DescendingEllipsis]", " "},
      {" ", " ", " ", 
       SubscriptBox[
        RowBox[{"m", "\[InvisibleSpace]"}], 
        RowBox[{"\[VeryThinSpace]", 
         RowBox[{"3", "\[InvisibleSpace]", "N"}]}]]}
     }], ")"}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.7935710100073233`*^9, 
  3.793571036709854*^9}},ExpressionUUID->"fddcb6d9-577f-483c-9b2f-\
c888c375fd18"],

Cell[CellGroupData[{

Cell["Sample Transform if G initially in internals", "Subsubsubsection",
 CellChangeTimes->{{3.844116314639739*^9, 
  3.844116329186489*^9}},ExpressionUUID->"d4e6ac9c-4686-4860-ad8d-\
52164762c688"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["G", 
       RowBox[{"i", "\[InvisibleSpace]", "j"}]], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Alpha]", "=", "1"}], "N"], 
       RowBox[{
        FractionBox["1", 
         SubscriptBox["m", "\[Alpha]"]], 
        RowBox[{
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
           SubscriptBox["x", "\[Alpha]"]}]], 
         SubscriptBox["q", "i"]}], 
        RowBox[{
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
           SubscriptBox["x", "\[Alpha]"]}]], 
         SubscriptBox["q", "j"]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Alpha]", "=", "1"}], "N"], 
       RowBox[{
        FractionBox["1", 
         SubscriptBox["m", "\[Alpha]"]], 
        RowBox[{
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
           SubscriptBox["x", "\[Alpha]"]}]], 
         RowBox[{"(", 
          RowBox[{
           UnderscriptBox["\[Sum]", "k"], 
           RowBox[{
            SubsuperscriptBox["c", "k", 
             RowBox[{"(", "i", ")"}]], 
            SubscriptBox["r", "k"]}]}], ")"}]}], 
        RowBox[{
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
           SubscriptBox["x", "\[Alpha]"]}]], 
         RowBox[{"(", 
          RowBox[{
           UnderscriptBox["\[Sum]", "l"], 
           RowBox[{
            SubsuperscriptBox["c", "l", 
             RowBox[{"(", "j", ")"}]], 
            SubscriptBox["r", "l"]}]}], ")"}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Alpha]", "=", "1"}], "N"], 
       RowBox[{
        FractionBox["1", 
         SubscriptBox["m", "\[Alpha]"]], 
        RowBox[{"(", 
         RowBox[{
          UnderscriptBox["\[Sum]", "k"], 
          RowBox[{
           SubsuperscriptBox["c", "k", 
            RowBox[{"(", "i", ")"}]], 
           RowBox[{
            FractionBox["\[PartialD]", 
             RowBox[{"\[PartialD]", 
              SubscriptBox["x", "\[Alpha]"]}]], 
            SubscriptBox["r", "k"]}]}]}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          UnderscriptBox["\[Sum]", "l"], 
          RowBox[{
           SubsuperscriptBox["c", "l", 
            RowBox[{"(", "j", ")"}]], 
           RowBox[{
            FractionBox["\[PartialD]", 
             RowBox[{"\[PartialD]", 
              SubscriptBox["x", "\[Alpha]"]}]], 
            SubscriptBox["r", "l"]}]}]}], ")"}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "k"], 
       RowBox[{
        UnderscriptBox["\[Sum]", "l"], 
        RowBox[{
         SubsuperscriptBox["c", "k", 
          RowBox[{"(", "i", ")"}]], 
         RowBox[{
          SubsuperscriptBox["c", "l", 
           RowBox[{"(", "j", ")"}]], "(", " ", 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"\[Alpha]", "=", "1"}], "N"], 
           RowBox[{
            FractionBox["1", 
             SubscriptBox["m", "\[Alpha]"]], 
            RowBox[{
             FractionBox["\[PartialD]", 
              RowBox[{"\[PartialD]", 
               SubscriptBox["x", "\[Alpha]"]}]], 
             SubscriptBox["r", "k"]}], 
            RowBox[{
             FractionBox["\[PartialD]", 
              RowBox[{"\[PartialD]", 
               SubscriptBox["x", "\[Alpha]"]}]], 
             SubscriptBox["r", "l"]}]}]}], ")"}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "k"], 
       RowBox[{
        UnderscriptBox["\[Sum]", "l"], 
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox["c", "k", 
           RowBox[{"(", "i", ")"}]], 
          RowBox[{
           SubsuperscriptBox["c", "l", 
            RowBox[{"(", "j", ")"}]], "\[CenterDot]", 
           SubsuperscriptBox["G", 
            RowBox[{"k", "\[InvisibleSpace]", "l"}], 
            RowBox[{"(", "r", ")"}]]}]}], ")"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.792767659085104*^9, 3.792767684330935*^9}, {
   3.792768762958074*^9, 3.79276878644915*^9}, {3.792768823805715*^9, 
   3.792768825887085*^9}, {3.7927688636189413`*^9, 3.792768875629446*^9}, 
   3.79276927695639*^9, {3.7927741342628717`*^9, 3.7927741348790407`*^9}, {
   3.844114279556563*^9, 3.84411433233386*^9}, {3.84411438283354*^9, 
   3.844114530390662*^9}, {3.844116236692449*^9, 
   3.8441162579373198`*^9}},ExpressionUUID->"9dbb6bcb-913f-4535-a26a-\
6f83094a40e2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["GF Analysis", "Subsubsection",
 CellChangeTimes->{{3.793625616777625*^9, 
  3.793625620481434*^9}},ExpressionUUID->"7a5032c1-f969-41b3-9fa7-\
b8721bd01d58"],

Cell[TextData[{
 "one fun thing to note is that in our usual construction, we find normal \
modes and frequencies by finding the eigenvalue and eigenvectors of GF, where \
F is the Hessian. Since both F and G and real-symmetric, this is equivalent \
to finding the ",
 StyleBox["generalized",
  FontSlant->"Italic"],
 " eigenvectors of F and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["G",
     FontSlant->"Plain"], 
    RowBox[{"-", "1"}]], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"851e95cd-8c11-4605-ada5-f4763c9d5727"],
 ", i.e. solving"
}], "ExpositoryText",
 CellChangeTimes->{{3.793624988755525*^9, 
  3.793625081855529*^9}},ExpressionUUID->"45de86d7-2482-4291-83d7-\
bb7b647710c5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["F",
     FontSlant->"Plain"], 
    StyleBox["\[VeryThinSpace]",
     FontSlant->"Italic"], 
    StyleBox["v",
     FontSlant->"Italic"]}], "=", 
   RowBox[{"\[Lambda]", "\[VeryThinSpace]", 
    SuperscriptBox[
     StyleBox["G",
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]], "\[VeryThinSpace]", "v"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.7936250833538523`*^9, 3.793625088415307*^9}, {
  3.793625120481523*^9, 
  3.793625133167789*^9}},ExpressionUUID->"3a9e7951-e56e-411d-9c14-\
bed6febc83ab"],

Cell[TextData[{
 "which can be done nicely by ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"scipy", ".", "linalg", ".", "eigh"}], "Code",
    FontColor->Hue[0, 0.5, 0.6]], TraditionalForm]],ExpressionUUID->
  "f03186ed-e5a6-4ac6-b9e9-10c4e9047c34"]
}], "Text",
 CellChangeTimes->{{3.79362513822486*^9, 3.7936251475927*^9}, {
  3.793625245642138*^9, 
  3.793625248745392*^9}},ExpressionUUID->"02730dbc-ce44-48a8-8978-\
3025df8ea38e"],

Cell["Note that this means that", "Text",
 CellChangeTimes->{{3.7936254593989153`*^9, 
  3.79362551793541*^9}},ExpressionUUID->"247098a3-16c7-4f22-9dfb-\
b595f4b94367"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["GV",
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]], 
    StyleBox["FV",
     FontSlant->"Plain"]}], 
   StyleBox["=",
    FontSlant->"Plain"], 
   StyleBox["\[CapitalLambda]",
    FontSlant->"Plain"]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.793625488672813*^9, 3.793625491598278*^9}, {
  3.793625525207691*^9, 3.793625539431285*^9}, {3.793625575714321*^9, 
  3.793625585330188*^9}},ExpressionUUID->"03bfb7f8-7d75-4017-b128-\
3ec920a66990"],

Cell["where V are the normal modes", "Text",
 CellChangeTimes->{{3.793625590305627*^9, 
  3.793625602017231*^9}},ExpressionUUID->"7e206122-1e1d-439a-939a-\
6dac5f6e6d8b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Derivatives", "Subsection",
 CellChangeTimes->{{3.792767716832398*^9, 3.7927677182957373`*^9}, {
  3.793624977690035*^9, 
  3.793624981467999*^9}},ExpressionUUID->"04a62e24-7971-478d-986a-\
fbf6fc2d030f"],

Cell["\<\
Since we use it so often, we let the mass-weighted Jacobian be\
\>", "Text",
 CellChangeTimes->{{3.792768893148239*^9, 3.792768902748588*^9}, {
  3.7927702949584312`*^9, 3.7927703450699797`*^9}, {3.793571107861575*^9, 
  3.793571118786359*^9}},ExpressionUUID->"14095f9e-2a46-4b61-ade2-\
54f5459269ea"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["J",
    FontSlant->"Plain"], "=", 
   RowBox[{
    SubscriptBox["\[Del]", 
     StyleBox["Y",
      FontSlant->"Plain"]], 
    StyleBox["R",
     FontSlant->"Plain"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.792770325147958*^9, 3.792770343812579*^9}, 
   3.792770569083057*^9, {3.793571083662538*^9, 
   3.7935710937338743`*^9}},ExpressionUUID->"fc25a9d1-163f-45a4-93c7-\
05678db74b9e"],

Cell["With this, the G matrix is given", "Text",
 CellChangeTimes->{{3.792767648425272*^9, 3.792767664998494*^9}, {
  3.792768884348078*^9, 3.792768891828763*^9}, {3.792770298373877*^9, 
  3.792770307678748*^9}, {3.792770349752295*^9, 3.7927703529735622`*^9}, {
  3.793571105598722*^9, 
  3.793571124229501*^9}},ExpressionUUID->"d1e721a1-de00-4714-8afa-\
2d2748814743"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["G",
    FontSlant->"Plain"], "=", 
   RowBox[{
    RowBox[{
     StyleBox["J",
      FontSlant->"Plain"], "\[Transpose]"}], 
    StyleBox["J",
     FontSlant->"Plain"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.792767659085104*^9, 3.792767684330935*^9}, {
   3.792768762958074*^9, 3.79276878644915*^9}, {3.792768823805715*^9, 
   3.792768825887085*^9}, {3.7927688636189413`*^9, 3.792768875629446*^9}, 
   3.792770292849674*^9, {3.7927705657636147`*^9, 3.7927705678284903`*^9}, {
   3.793571127408613*^9, 3.793571136244618*^9}, {3.803863766227626*^9, 
   3.8038637671650763`*^9}, {3.8045959211387653`*^9, 3.804595923066847*^9}, {
   3.804626784600765*^9, 
   3.8046267876073627`*^9}},ExpressionUUID->"b479230e-88fa-4f28-a0eb-\
cb6d21c5c54e"],

Cell[TextData[{
 "Next let\[CloseCurlyQuote]s say we want the derivatives of the G matrix \
with respect to a new set of coordinates, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox["Q", "n"], "}"}], TraditionalForm]],ExpressionUUID->
  "7eea7714-104b-4430-892b-bf212cec6a6b"],
 ". "
}], "Text",
 CellChangeTimes->{{3.7927703622768908`*^9, 3.792770401532867*^9}, 
   3.792770628654776*^9},ExpressionUUID->"2efea155-c846-43d7-8d3d-\
2beffbde5cbb"],

Cell["Going back to prior notes on tensor derivates, we had ", "Text",
 CellChangeTimes->{{3.7927703622768908`*^9, 3.792770401532867*^9}, {
  3.792770629666937*^9, 
  3.792770653674624*^9}},ExpressionUUID->"f27e89e8-813a-466e-bca4-\
33de23b30ffe"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", 
     StyleBox["Q",
      FontSlant->"Plain"]], 
    StyleBox["V",
     FontSlant->"Plain"]}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", 
      StyleBox["Q",
       FontSlant->"Plain"]], 
     StyleBox["x",
      FontSlant->"Plain"]}], 
    RowBox[{
     SubscriptBox["\[Del]", 
      StyleBox["x",
       FontSlant->"Plain"]], 
     StyleBox["V",
      FontSlant->"Plain"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.79277064740132*^9, 3.792770654828594*^9}, 
   3.804626908157901*^9},ExpressionUUID->"027084d9-df5e-456f-b307-\
646434a5c094"],

Cell[TextData[{
 "where V was our potential function in Cartesian coordinates, Q was our \
internal coordinate set, and \[CircleDot] represents a generalized matrix \
multiplication to tensors (implemented in ",
 Cell[BoxData[
  FormBox[
   StyleBox["numpy", "Code",
    FontColor->Hue[0.05, 1, 0.6]], TraditionalForm]],ExpressionUUID->
  "7a853f28-d9ff-446a-9533-799fde472e34"],
 " via ",
 Cell[BoxData[
  FormBox[
   StyleBox["tensordot", "Code",
    FontColor->Hue[0.05, 1, 0.6]], TraditionalForm]],ExpressionUUID->
  "3cc2d392-4da0-473d-99c2-ad4cb0139715"],
 ")."
}], "Text",
 CellChangeTimes->{{3.792770669699175*^9, 3.792770672210133*^9}, {
  3.792770750744495*^9, 3.7927707885381823`*^9}, {3.792770857070732*^9, 
  3.7927709423429613`*^9}},ExpressionUUID->"a6cb1144-4233-41af-b796-\
534b3aaadfd1"],

Cell["\<\
Correspondingly since J is defined in our R coordinates, this means that\
\>", "Text",
 CellChangeTimes->{{3.792770669699175*^9, 3.792770672210133*^9}, {
  3.792770750744495*^9, 3.792770795072294*^9}, {3.792770839334465*^9, 
  3.792770845919088*^9}, {3.792771104382086*^9, 
  3.792771117502244*^9}},ExpressionUUID->"be3ef9ad-3c89-49df-9829-\
891cb948339a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", 
     StyleBox["Q",
      FontSlant->"Plain"]], 
    StyleBox["J",
     FontSlant->"Plain"]}], 
   StyleBox["=",
    FontSlant->"Plain"], 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", 
      StyleBox["Q",
       FontSlant->"Plain"]], 
     StyleBox["R",
      FontSlant->"Plain"]}], 
    RowBox[{
     SubscriptBox["\[Del]", 
      StyleBox["R",
       FontSlant->"Plain"]], 
     StyleBox["J",
      FontSlant->"Plain"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.7927708010178337`*^9, 3.792770805914391*^9}, {
   3.792770848398306*^9, 3.7927708525063953`*^9}, 3.792771084398081*^9, {
   3.79277113008105*^9, 3.792771142062718*^9}, 
   3.8046269149426003`*^9},ExpressionUUID->"e24f970f-2162-4dad-8bdc-\
40b538e84ee3"],

Cell[TextData[{
 "the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", 
     StyleBox["Q",
      FontSlant->"Plain"]], 
    StyleBox["R",
     FontSlant->"Plain"]}], TraditionalForm]],
  CellChangeTimes->{{3.7927708010178337`*^9, 3.792770805914391*^9}, {
    3.792770848398306*^9, 3.7927708525063953`*^9}, 3.792771084398081*^9, {
    3.79277113008105*^9, 3.792771142062718*^9}},ExpressionUUID->
  "2890d38a-c19c-468b-aec0-0f63929a90ca"],
 " term is the Jacobian for going from the Q coordinate set to the R \
coordinate set. In the special case the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Q", "i"], TraditionalForm]],ExpressionUUID->
  "ba3e0c5e-dbce-4630-815a-e816571f05fb"],
 " are defined as linear combinations of the R coordinates defined by some \
transformation matrix L, this reduces to being simply"
}], "Text",
 CellChangeTimes->{{3.792774068447707*^9, 3.792774069031727*^9}, {
   3.792774210628684*^9, 3.792774358200057*^9}, {3.79277487338157*^9, 
   3.792774906304558*^9}, 
   3.8046269575650167`*^9},ExpressionUUID->"21231fdd-270b-4b2d-94b0-\
467146eef88d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", 
     StyleBox["Q",
      FontSlant->"Plain"]], 
    StyleBox["R",
     FontSlant->"Plain"]}], 
   StyleBox[" ",
    FontSlant->"Plain"], 
   StyleBox["=",
    FontSlant->"Plain"], 
   StyleBox[" ",
    FontSlant->"Plain"], 
   SuperscriptBox[
    StyleBox["L",
     FontSlant->"Plain"], 
    RowBox[{"-", "1"}]]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.792774329484213*^9, 
  3.7927743324324627`*^9}},ExpressionUUID->"ae189d9f-8735-4dc9-84aa-\
16a1bcebaa03"],

Cell[TextData[{
 "Next we have the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", 
     StyleBox["R",
      FontSlant->"Plain"]], 
    StyleBox["J",
     FontSlant->"Plain"]}], TraditionalForm]],
  CellChangeTimes->{{3.7927708010178337`*^9, 3.792770805914391*^9}, {
    3.792770848398306*^9, 3.7927708525063953`*^9}, 3.792771084398081*^9, {
    3.79277113008105*^9, 3.792771142062718*^9}},ExpressionUUID->
  "72023827-caaf-41ed-94cf-dbd05056320a"],
 " term, a three dimensional tensor whose elements look like"
}], "Text",
 CellChangeTimes->{{3.792774369278758*^9, 3.792774386014633*^9}, {
  3.792774442647266*^9, 3.792774447727689*^9}, {3.7927744916247272`*^9, 
  3.7927745248707457`*^9}},ExpressionUUID->"9ae0ce61-9719-46ed-a19d-\
deec7b74af45"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Del]", 
       StyleBox["R",
        FontSlant->"Plain"]], 
      StyleBox["J",
       FontSlant->"Plain"]}], 
     StyleBox[")",
      FontSlant->"Plain"]}], 
    RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]], "=", 
   RowBox[{
    RowBox[{
     FractionBox["\[PartialD]", 
      RowBox[{"\[PartialD]", 
       SubscriptBox["r", "i"]}]], 
     RowBox[{"(", 
      FractionBox[
       RowBox[{"\[PartialD]", 
        SubscriptBox["r", 
         RowBox[{"\[VeryThinSpace]", "j"}]]}], 
       RowBox[{"\[PartialD]", 
        SubscriptBox["x", 
         RowBox[{"\[VeryThinSpace]", "k"}]]}]], ")"}]}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SuperscriptBox[
        SubscriptBox["r", 
         RowBox[{"\[VeryThinSpace]", "j"}]], "2"]}], 
      RowBox[{
       RowBox[{"\[PartialD]", 
        SubscriptBox["r", "i"]}], 
       RowBox[{"\[PartialD]", 
        SubscriptBox["x", 
         RowBox[{"\[VeryThinSpace]", "k"}]]}]}]], "=", 
     RowBox[{
      RowBox[{
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", 
          RowBox[{"\[VeryThinSpace]", "k"}]]}]], 
       RowBox[{"(", 
        FractionBox[
         RowBox[{"\[PartialD]", 
          SubscriptBox["r", 
           RowBox[{"\[VeryThinSpace]", "j"}]]}], 
         RowBox[{"\[PartialD]", 
          SubscriptBox["r", "i"]}]], ")"}]}], "=", 
      RowBox[{
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["r", 
          RowBox[{"\[VeryThinSpace]", "j"}]]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", 
          RowBox[{"\[VeryThinSpace]", "k"}]]}]], 
       SubscriptBox["\[Delta]", 
        RowBox[{"i", "\[InvisibleSpace]", "j"}]]}]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.792774534269929*^9, 3.792774579518034*^9}, {
  3.792774626677308*^9, 
  3.792774694868684*^9}},ExpressionUUID->"1313ec55-7100-404c-b9c3-\
0364f83bbb09"],

Cell["\<\
which means this is just a nice block-diagonal tensor. This fact can be \
convenient when implementing this.\
\>", "Text",
 CellChangeTimes->{{3.792774805041703*^9, 3.792774807289631*^9}, {
  3.792774849173108*^9, 3.7927748579802237`*^9}, {3.7927749125764313`*^9, 
  3.792774933015154*^9}},ExpressionUUID->"f37138c4-ed64-4e18-b569-\
ad7ea9017749"],

Cell[CellGroupData[{

Cell["G-matrix Derivatives", "Subsubsection",
 CellChangeTimes->{{3.792790439202426*^9, 
  3.7927904515538473`*^9}},ExpressionUUID->"4cd37960-0f63-4d93-b5d6-\
259ac72f4a6e"],

Cell[CellGroupData[{

Cell["First", "Subsubsubsection",
 CellChangeTimes->{{3.812287483654078*^9, 
  3.8122874844227867`*^9}},ExpressionUUID->"6d0a2464-483f-4f5c-b0dc-\
ceb39e4ed64e"],

Cell["We\[CloseCurlyQuote]ll try to rearrange", "ExpositoryText",
 CellChangeTimes->{{3.8122306625270977`*^9, 3.812230662970433*^9}, {
  3.812230907788006*^9, 3.812230928954878*^9}, {3.812231446330101*^9, 
  3.812231456071123*^9}},ExpressionUUID->"fe845e8b-5eb0-46b8-82a7-\
4b3fcf59de6f"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        StyleBox["Q",
         FontSlant->"Plain"]], 
       RowBox[{"(", 
        StyleBox[
         RowBox[{
          RowBox[{"J", "\[Transpose]"}], "J"}],
         FontSlant->"Plain"], "\[VeryThinSpace]", ")"}]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Del]", 
           StyleBox["Q",
            FontSlant->"Plain"]], 
          StyleBox[
           RowBox[{"J", "\[Transpose]"}],
           FontSlant->"Plain"]}], 
         StyleBox[")",
          FontSlant->"Plain"]}], 
        StyleBox["J",
