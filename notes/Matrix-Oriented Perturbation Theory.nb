         RowBox[{
          UnderscriptBox["\[Sum]", 
           RowBox[{"d", "\[Element]", 
            SuperscriptBox["D", 
             RowBox[{"(", 
              RowBox[{"a", "+", "1"}], ")"}]]}]], 
          RowBox[{
           SubsuperscriptBox["E", "d", 
            RowBox[{"(", "a", ")"}]], 
