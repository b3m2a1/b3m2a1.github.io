     "BraKet"]}], " ", "=", " ", 
   RowBox[{"-", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], 
      RowBox[{"k", "-", "1"}]], 
     TemplateBox[{
       RowBox[{
