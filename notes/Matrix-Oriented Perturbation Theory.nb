   RowBox[{
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], " ", 
     SuperscriptBox["H", 
      RowBox[{"(", 
       RowBox[{"k", "+", "a"}], ")"}]]}], "+", 
