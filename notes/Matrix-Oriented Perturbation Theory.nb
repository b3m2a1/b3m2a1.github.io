        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "\[InvisibleSpace]", 
           RowBox[{"(", 
            RowBox[{"n", "+", "1"}], ")"}]}], "-", "2"}], ")"}]}]}]}]},
    {
     SubscriptBox[
      RowBox[{
       RowBox[{
        SubscriptBox[
