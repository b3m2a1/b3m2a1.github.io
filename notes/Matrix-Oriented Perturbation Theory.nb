Cell["\<\
we can also use this in principle, as if we have a coordinate set where the \
anharmonicity is entirely in the kinetic energy, we can transform to any \
other set by saying\
\>", "ExpositoryText",
 CellChangeTimes->{{3.921340852105145*^9, 3.9213409088239727`*^9}, {
  3.9213409538480597`*^9, 
  3.921340963951108*^9}},ExpressionUUID->"e10bed8c-5167-4cb4-924b-\
0e312b2288cb"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[Del]", 
            SuperscriptBox["Q", "2"]], "R"}], "\[InvisibleSpace]", ")"}], 
         RowBox[{"j", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "i"}]], 
        SubscriptBox["\[Omega]", "i"]}], " ", "+", " ", 
       RowBox[{
        SubscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[Del]", 
            SuperscriptBox["Q", "2"]], "R"}], "\[InvisibleSpace]", ")"}], 
         RowBox[{"i", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "j"}]], 
        SubscriptBox["\[Omega]", "j"]}], " ", "+", " ", 
       RowBox[{
        SubscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[Del]", 
            SuperscriptBox["Q", "2"]], "R"}], "\[InvisibleSpace]", ")"}], 
         RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]], 
        SubscriptBox["\[Omega]", "k"]}]}], " ", "=", " ", "0"}]},
    {
     RowBox[{
      RowBox[{"\[Implies]", " ", 
       SubscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Del]", 
           SuperscriptBox["Q", "2"]], "R"}], "\[InvisibleSpace]", ")"}], 
        RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]]}], 
      " ", "=", " ", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox[
           RowBox[{"(", 
            RowBox[{
             SubscriptBox["\[Del]", 
              SuperscriptBox["Q", "2"]], "R"}], "\[InvisibleSpace]", ")"}], 
           RowBox[{"j", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "i"}]], 
          FractionBox[
           SubscriptBox["\[Omega]", "i"], 
           SubscriptBox["\[Omega]", "k"]]}], " ", "+", " ", 
         RowBox[{
          SubscriptBox[
           RowBox[{"(", 
            RowBox[{
             SubscriptBox["\[Del]", 
              SuperscriptBox["Q", "2"]], "R"}], "\[InvisibleSpace]", ")"}], 
           RowBox[{"i", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "j"}]], 
          FractionBox[
           SubscriptBox["\[Omega]", "j"], 
           SubscriptBox["\[Omega]", "k"]]}]}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.921340959054481*^9, 3.921340960302722*^9}, {
  3.921340993603421*^9, 
  3.9213410322801943`*^9}},ExpressionUUID->"d5a2e32d-9210-430d-9c3e-\
9c3832ce96e7"],

Cell[TextData[{
 "which allows us to say, try to decouple problematic modes by zeroing out ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Del]", 
       SuperscriptBox["Q", "2"]], "R"}], "\[InvisibleSpace]", ")"}], 
    RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]], 
   TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "7a0e53d6-036e-4bcf-b987-702bc26b5bb0"],
 " for a given ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", ",", " ", "j", ",", " ", 
    RowBox[{"and", " ", "k"}]}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
