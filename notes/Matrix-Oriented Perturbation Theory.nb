c986c5d84a9f"],

Cell[TextData[{
 "meaning that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[ForAll]", "i"], " ", 
     SubsuperscriptBox["J", "0", 
      RowBox[{"(", 
       RowBox[{"k", ",", "i"}], ")"}]]}], "=", "\[DoubleStruckZero]"}], 
   TraditionalForm]],
  CellChangeTimes->{{3.825821464090979*^9, 3.825821464855678*^9}},
  ExpressionUUID->"0d881d21-5802-4884-98c0-ab2986f05f15"]
}], "ExpositoryText",
