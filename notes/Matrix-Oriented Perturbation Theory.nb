38eaeceb5ce5"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["P", "b", "a"], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "b"], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          UnderoverscriptBox["\[Product]", 
           RowBox[{"j", "=", "0"}], "i"], " ", 
          RowBox[{"(", 
           RowBox[{"z", "+", "j"}], ")"}]}], ")"}], 
        RowBox[{
         SubsuperscriptBox["P", 
          RowBox[{"b", "-", "i"}], 
          RowBox[{"a", "-", "1"}]], "(", "n", ")"}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "b"], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], "i"], " ", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], 
          RowBox[{"(", 
           RowBox[{"i", "-", "j"}], ")"}]], "\[InvisibleSpace]", 
         RowBox[{
          SubscriptBox["S", "1"], "(", 
          RowBox[{"i", ",", " ", "j"}], ")"}], 
         SuperscriptBox["z", 
          RowBox[{"j", "+", "1"}]], 
         RowBox[{
          SubsuperscriptBox["P", 
           RowBox[{"b", "-", "i"}], 
           RowBox[{"a", "-", "1"}]], "(", "n", ")"}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.889624389820703*^9, 3.889624395725329*^9}, {
