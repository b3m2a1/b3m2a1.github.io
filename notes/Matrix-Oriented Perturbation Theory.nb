         RowBox[{"(", 
          RowBox[{"n", "+", 
           RowBox[{"(", 
            RowBox[{"a", "-", "i"}], ")"}], "-", "1"}], ")"}]}]}], 
       "\[RightBracketingBar]"}], 
      RowBox[{"i", "=", 
       RowBox[{"a", "-", "1"}]}]]},
    {
     RowBox[{
      SubsuperscriptBox["P", "2", "2"], "=", " ", 
