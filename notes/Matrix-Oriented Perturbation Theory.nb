       RowBox[{"\[LeftAngleBracket]", "3", "\[RightAngleBracket]"}], 
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox["X", "3"]], "V"}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox["Q", "2"]], "X"}], 
       RowBox[{"\[LeftAngleBracket]", "2", "\[RightAngleBracket]"}], 
       RowBox[{
        SubscriptBox["\[Del]", "Q"], "X"}], 
       RowBox[{"\[LeftAngleBracket]", "3", "\[RightAngleBracket]"}], 
       RowBox[{
        SubscriptBox["\[Del]", "Q"], "X"}], 
       RowBox[{"\[LeftAngleBracket]", "3", "\[RightAngleBracket]"}], 
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox["X", "3"]], "V"}]}]}]},
    {
     RowBox[{"=", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[Del]", "Q"], "X"}], 
         RowBox[{"\[LeftAngleBracket]", "3", "\[RightAngleBracket]"}], 
         RowBox[{
          SubscriptBox["\[Del]", 
           SuperscriptBox["Q", "2"]], "X"}], 
         RowBox[{"\[LeftAngleBracket]", "2", "\[RightAngleBracket]"}], 
         RowBox[{
          SubscriptBox["\[Del]", "Q"], "X"}], 
         RowBox[{"\[LeftAngleBracket]", "3", "\[RightAngleBracket]"}], 
         RowBox[{
          SubscriptBox["\[Del]", 
           SuperscriptBox["X", "3"]], "V"}]}], ")"}], 
       RowBox[{"3", ":", "1"}]]}]},
    {
     RowBox[{"=", 
      SuperscriptBox[
       RowBox[{"(", 
        SubscriptBox["V", 
         RowBox[{"3", ",", "old"}]], ")"}], 
       RowBox[{"3", ":", "1"}]]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        RowBox[{
         SuperscriptBox["Q", "2"], "QQ"}]], 
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox["X", "3"]], "V"}]}], "=", 
      RowBox[{
       SuperscriptBox[
        SubscriptBox["V", "3"], 
        RowBox[{"4", ":", "1"}]], "+", 
       SuperscriptBox[
        SubscriptBox["V", "3"], 
        RowBox[{"4", ":", "2"}]], "+", 
       SuperscriptBox[
        SubscriptBox["V", "3"], 
        RowBox[{
         RowBox[{"3", ":", "1"}], ",", 
         RowBox[{"4", ":", "3"}]}]], "+", 
       SuperscriptBox[
        SubscriptBox["V", "3"], 
        RowBox[{"4", ":", "2"}]], "+", 
       SuperscriptBox[
        SubscriptBox["V", "3"], 
        RowBox[{
         RowBox[{"4", ":", "3"}], ",", 
         RowBox[{"1", ":", "2"}]}]], "+", 
       SuperscriptBox[
        SubscriptBox["V", "3"], 
        RowBox[{
         RowBox[{"3", ":", "1"}], ",", 
         RowBox[{"1", ":", "4"}]}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811673002407215*^9, 3.811673003252087*^9}, {
