Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["P", "b", "a"], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "b"], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          UnderoverscriptBox["\[Product]", 
           RowBox[{"j", "=", "0"}], "i"], " ", 
          RowBox[{"(", 
           RowBox[{"z", "+", "j"}], ")"}]}], ")"}], 
        RowBox[{
         SubsuperscriptBox["P", 
          RowBox[{"b", "-", "i"}], 
          RowBox[{"a", "-", "1"}]], "(", "n", ")"}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "b"], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], "i"], " ", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], 
          RowBox[{"(", 
           RowBox[{"i", "-", "j"}], ")"}]], "\[InvisibleSpace]", 
         RowBox[{
          SubscriptBox["S", "1"], "(", 
          RowBox[{"i", ",", " ", "j"}], ")"}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[Eta]", "+", "\[CapitalDelta]"}], ")"}], 
          RowBox[{"j", "+", "1"}]], 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"k", "=", "0"}], 
           RowBox[{"b", "-", "i"}]], " ", 
          SuperscriptBox[
           RowBox[{
            SubsuperscriptBox["c", "k", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"a", "-", "1"}], ",", " ", 
               RowBox[{"b", "-", "i"}]}], ")"}]], "(", 
            RowBox[{"\[Eta]", "-", "\[CapitalDelta]"}], ")"}], "k"]}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "b"], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], "i"], " ", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"k", "=", "0"}], 
          RowBox[{"b", "-", "i"}]], " ", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}], 
           RowBox[{"(", 
            RowBox[{"i", "-", "j"}], ")"}]], "\[InvisibleSpace]", 
          RowBox[{
           SubscriptBox["S", "1"], "(", 
           RowBox[{"i", ",", " ", "j"}], ")"}], " ", 
          RowBox[{
           SubsuperscriptBox["c", "k", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"a", "-", "1"}], ",", 
              RowBox[{"b", "-", "i"}]}], ")"}]], "(", " ", 
           RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{"y", "=", "0"}], 
             RowBox[{"j", "+", "1"}]], " ", 
            RowBox[{
             RowBox[{"(", GridBox[{
                {
                 RowBox[{"j", "+", "1"}]},
                {"y"}
               },
               GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
             SuperscriptBox["\[CapitalDelta]", 
              RowBox[{"j", "+", "1", "-", "y"}]], " ", 
             SuperscriptBox["\[Eta]", "j"]}]}], " ", ")"}], 
          RowBox[{"(", 
           RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{"x", "=", "0"}], "k"], "\[VeryThinSpace]", 
            RowBox[{
             RowBox[{"(", GridBox[{
                {"k"},
                {"x"}
               },
               GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"-", "1"}], ")"}], 
              RowBox[{"k", "-", "x"}]], 
             SuperscriptBox["\[CapitalDelta]", 
              RowBox[{"k", "-", "x"}]], 
             SuperscriptBox["\[Eta]", "x"]}]}], ")"}]}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "b"], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], "i"], " ", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"k", "=", "0"}], 
          RowBox[{"b", "-", "i"}]], " ", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}], 
           RowBox[{"(", 
            RowBox[{"i", "-", "j"}], ")"}]], "\[InvisibleSpace]", 
          RowBox[{
           SubscriptBox["S", "1"], "(", 
           RowBox[{"i", ",", " ", "j"}], ")"}], " ", 
          SubsuperscriptBox["c", "k", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"a", "-", "1"}], ",", 
             RowBox[{"b", "-", "i"}]}], ")"}]], 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"\[Sigma]", "=", "0"}], 
            RowBox[{"k", "+", "j", "+", "1"}]], 
           RowBox[{
            SuperscriptBox["\[Eta]", "\[Sigma]"], 
            RowBox[{
             UnderoverscriptBox["\[Sum]", 
              RowBox[{"\[Tau]", "=", "0"}], "\[Sigma]"], " ", 
             RowBox[{
              RowBox[{"(", GridBox[{
                 {
                  RowBox[{"j", "+", "1"}]},
                 {"\[Tau]"}
                },
                GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
              RowBox[{
               SuperscriptBox["\[CapitalDelta]", 
                RowBox[{"j", "+", "1", "-", "\[Tau]"}]], "(", GridBox[{
                 {"k"},
                 {
                  RowBox[{"\[Sigma]", "-", "\[Tau]"}]}
                },
                GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"-", "1"}], ")"}], 
               RowBox[{"k", "-", 
                RowBox[{"(", 
                 RowBox[{"\[Sigma]", "-", "\[Tau]"}], ")"}]}]], 
              SuperscriptBox["\[CapitalDelta]", 
               RowBox[{"k", "-", 
                RowBox[{"(", 
                 RowBox[{"\[Sigma]", "-", "\[Tau]"}], 
                 ")"}]}]]}]}]}]}]}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "b"], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], "i"], " ", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"k", "=", "0"}], 
          RowBox[{"b", "-", "i"}]], " ", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"\[Sigma]", "=", "0"}], 
           RowBox[{"k", "+", "j", "+", "1"}]], "  ", 
          RowBox[{
           SubsuperscriptBox["c", "k", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"a", "-", "1"}], ",", " ", 
              RowBox[{"b", "-", "i"}]}], ")"}]], 
           SuperscriptBox["\[CapitalDelta]", 
            RowBox[{"k", "+", "j", "+", "1", "-", "\[Sigma]"}]], 
           SuperscriptBox["\[Eta]", "\[Sigma]"], " ", 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"-", "1"}], ")"}], 
              RowBox[{"(", "\[InvisibleSpace]", 
               RowBox[{"i", "-", "j"}], ")"}]], "\[InvisibleSpace]", 
             RowBox[{
              SubscriptBox["S", "1"], "(", 
              RowBox[{"i", ",", " ", "j"}], ")"}], " ", 
             RowBox[{
              UnderoverscriptBox["\[Sum]", 
               RowBox[{"\[Tau]", "=", "0"}], "\[Sigma]"], " ", 
              RowBox[{
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"-", "1"}], ")"}], 
                RowBox[{"k", "-", 
                 RowBox[{"(", 
                  RowBox[{"\[Sigma]", "-", "\[Tau]"}], ")"}]}]], 
               RowBox[{"(", GridBox[{
                  {
                   RowBox[{"j", "+", "1"}]},
                  {"\[Tau]"}
                 },
                 GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
               RowBox[{"(", GridBox[{
                  {"k"},
                  {
                   RowBox[{"\[Sigma]", "-", "\[Tau]"}]}
                 },
                 GridBoxAlignment->{"Columns" -> {Center}}], ")"}]}]}]}], 
            ")"}]}]}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Sigma]", "=", "0"}], 
        RowBox[{"b", "+", "1"}]], " ", 
       RowBox[{
        SuperscriptBox["\[Eta]", "\[Sigma]"], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"k", "=", "0"}], "b"], " ", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"i", "=", "0"}], 
           RowBox[{"b", "-", "k"}]], " ", 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"j", "=", 
             RowBox[{"\[Sigma]", "-", "k", "-", "1"}]}], "i"], "   ", 
           RowBox[{
            SubsuperscriptBox["c", "k", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"a", "-", "1"}], ",", " ", 
               RowBox[{"b", "-", "i"}]}], ")"}]], 
            SuperscriptBox["\[CapitalDelta]", 
             RowBox[{"k", "+", "j", "+", "1", "-", "\[Sigma]"}]], " ", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"-", "1"}], ")"}], 
               RowBox[{"(", "\[InvisibleSpace]", 
                RowBox[{"i", "-", "j"}], ")"}]], "\[InvisibleSpace]", 
              RowBox[{
               SubscriptBox["S", "1"], "(", 
               RowBox[{"i", ",", " ", "j"}], ")"}], " ", 
              RowBox[{
               UnderoverscriptBox["\[Sum]", 
                RowBox[{"\[Tau]", "=", "0"}], "\[Sigma]"], " ", 
               RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"-", "1"}], ")"}], 
                 RowBox[{"k", "-", 
                  RowBox[{"(", 
                   RowBox[{"\[Sigma]", "-", "\[Tau]"}], ")"}]}]], 
                RowBox[{"(", GridBox[{
                   {
                    RowBox[{"j", "+", "1"}]},
                   {"\[Tau]"}
                  },
                  GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
                RowBox[{"(", GridBox[{
                   {"k"},
                   {
                    RowBox[{"\[Sigma]", "-", "\[Tau]"}]}
                  },
                  GridBoxAlignment->{"Columns" -> {Center}}], ")"}]}]}]}], 
             ")"}]}]}]}]}]}]}]}]}
