Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "D"], " ", 
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]], 
       SubscriptBox["P", "D"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       SubsuperscriptBox["E", "n", 
        RowBox[{"(", "1", ")"}]], 
       SubscriptBox["P", "D"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "U"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"[", 
         RowBox[{"U", ":", 
          SubsuperscriptBox["\[CapitalPi]", "n", 
           RowBox[{"(", "0", ")"}]], ":", "U"}], "]"}], 
        TemplateBox[{
          RowBox[{"T", ":", "\[VeryThinSpace]", 
            RowBox[{
              UnderoverscriptBox[
               RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}], 
               StyleBox["1", FontSize -> 14], 
               StyleBox["1", FontSize -> 12]], 
              RowBox[{"(", "k", ")"}]}]}]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"[", 
         RowBox[{"U", ":", 
          SubsuperscriptBox["\[CapitalPi]", "n", 
           RowBox[{"(", "0", ")"}]], ":", "U"}], "]"}], 
        SuperscriptBox["H", 
         RowBox[{"(", "k", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}]}]},
    {
     RowBox[{
      SuperscriptBox["E", 
       RowBox[{"(", "k", ")"}]], "=", " ", 
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], 
        SuperscriptBox["H", 
         RowBox[{"(", "k", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], ":", "T"}]},
         "Bra"], " ", 
        SubsuperscriptBox["\[Delta]E", "n", 
         RowBox[{"(", "1", ")"}]], 
        TemplateBox[{
          RowBox[{"U", ":", 
            SuperscriptBox["n", 
             RowBox[{"(", 
               RowBox[{"k", "-", "1"}], ")"}]]}]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], ":", "T"}]},
         "Bra"], " ", 
        RowBox[{
         UnderoverscriptBox["\[CapitalDelta]E", 
          StyleBox["1",
           FontSize->14], 
          StyleBox["2",
           FontSize->14]], "(", "k", ")"}], 
        TemplateBox[{
          RowBox[{"T", ":", 
            RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}]}]},
         "Ket"]}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", 
        RowBox[{"D", "\[VeryThinSpace]", "n"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"[", 
         RowBox[{
          SubscriptBox["D", "n"], ":", 
          SubsuperscriptBox["\[CapitalPi]", 
           RowBox[{"n", "\[VeryThinSpace]"}], 
           RowBox[{"(", "1", ")"}]], ":", 
          RowBox[{"D", "\[VeryThinSpace]", "n"}]}], "]"}], 
        TemplateBox[{
          RowBox[{"D", ":", "\[VeryThinSpace]", 
            RowBox[{
              UnderoverscriptBox[
               RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}], "0", 
               "2"], 
              RowBox[{"(", 
                RowBox[{"k", "+", "1"}], ")"}]}]}]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"[", 
         RowBox[{
          SubscriptBox["D", "n"], ":", 
          SubsuperscriptBox["\[CapitalPi]", 
           RowBox[{"n", "\[VeryThinSpace]"}], 
           RowBox[{"(", "1", ")"}]], ":", 
          RowBox[{"D", "\[VeryThinSpace]", "n"}]}], "]"}], 
        TemplateBox[{
          RowBox[{"U", ":", "\[VeryThinSpace]", 
            RowBox[{
              UnderoverscriptBox[
               RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}], "0", 
               "1"], 
              RowBox[{"(", 
                RowBox[{"k", "+", "1"}], ")"}]}]}]},
         "Ket"]}]}]}]},
    {
     RowBox[{
      TemplateBox[{
        RowBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]], " "}], 
        RowBox[{"\[VeryThinSpace] ", 
          SuperscriptBox["n", 
           RowBox[{"(", "k", ")"}]]}]},
       "BraKet"], "=", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Ket"], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], 
         RowBox[{"k", "-", "1"}]], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "i", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", 
               RowBox[{"k", "-", "i"}], ")"}]]}]},
         "BraKet"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
