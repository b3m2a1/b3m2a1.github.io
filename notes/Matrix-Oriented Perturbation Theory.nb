Cell[TextData[{
 "We know that the energy contribution is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[InvisibleSpace]", "E"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "13a8a499-aa35-4ae3-8d5d-6cfae7aa873e"],
 " and the corresponding polynomial is"
}], "ExpositoryText",
 CellChangeTimes->{{3.889500598228282*^9, 
  3.8895006383672247`*^9}},ExpressionUUID->"c48917fe-8956-4659-ba62-\
bd302d78f5bf"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["P", "3", "6"], "(", "n", ")"}], 
   RowBox[{
    SubsuperscriptBox["P", "3", "2"], "(", 
    RowBox[{"n", "+", "3"}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.889500639804674*^9, 
  3.889500730128961*^9}},ExpressionUUID->"f2a00034-6895-4282-891a-\
d81f5aac9e50"],

Cell[TextData[{
 "which could be pretty quick to evaluate using the polynomial formulas \
developed before, but it would be ",
 StyleBox["nice",
  FontSlant->"Italic"],
 " to have a compact way to evaluate this for any ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "92cc59a6-ede1-4f64-ac3a-d2317e5662e0"],
 " and any pairs of ups and downs, so for that we\[CloseCurlyQuote]ll write \
these out"
}], "ExpositoryText",
 CellChangeTimes->{{3.889502194395914*^9, 
  3.8895022762128363`*^9}},ExpressionUUID->"94749faa-cb9f-48c0-908e-\
11668868db26"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["P", 
        SubscriptBox["a", "1"], 
        SubscriptBox["b", "1"]], "(", "n", ")"}], "=", 
      RowBox[{
       FractionBox["1", 
        RowBox[{
         SuperscriptBox["2", 
          SubscriptBox["b", "1"]], "\[InvisibleSpace]"}]], 
       RowBox[{"(", GridBox[{
          {
           RowBox[{
            SubscriptBox["a", "1"], "+", 
            SubscriptBox["b", "1"]}]},
          {
           SubscriptBox["b", "1"]}
         },
         GridBoxAlignment->{"Columns" -> {Center}}], ")"}], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"k", "=", "0"}], 
         SubscriptBox["b", "1"]], "\[VeryThinSpace] ", 
        RowBox[{
         RowBox[{
          SubsuperscriptBox["Q", "k", 
           RowBox[{"(", 
            SubscriptBox["b", "1"], ")"}]], "(", 
          SubscriptBox["a", "1"], ")"}], "\[InvisibleSpace]", 
         SuperscriptBox["n", "k"]}]}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["P", 
        SubscriptBox["b", "2"], 
        SubscriptBox["a", "2"]], "(", 
       RowBox[{"n", "+", 
        RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}]}], ")"}], "=", 
      RowBox[{
       FractionBox["1", 
        RowBox[{
         SuperscriptBox["2", 
          SubscriptBox["b", "2"]], "\[InvisibleSpace]"}]], 
       RowBox[{"(", GridBox[{
          {
           RowBox[{
            SubscriptBox["a", "2"], "+", 
            SubscriptBox["b", "2"]}]},
          {
           SubscriptBox["b", "2"]}
         },
         GridBoxAlignment->{"Columns" -> {Center}}], ")"}], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"k", "=", "0"}], 
         SubscriptBox["b", "2"]], "\[VeryThinSpace] ", 
        RowBox[{
         RowBox[{
          SubsuperscriptBox["T", "k", 
           RowBox[{"(", 
            SubscriptBox["b", "2"], ")"}]], "(", 
          SubscriptBox["a", "2"], ")"}], "\[InvisibleSpace]", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"n", "+", 
            RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}]}], ")"}], 
          "k"]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       FractionBox["1", 
        RowBox[{
         SuperscriptBox["2", 
          SubscriptBox["b", "2"]], "\[InvisibleSpace]"}]], 
       RowBox[{"(", GridBox[{
          {
           RowBox[{
            SubscriptBox["a", "2"], "+", 
            SubscriptBox["b", "2"]}]},
          {
           SubscriptBox["b", "2"]}
         },
         GridBoxAlignment->{"Columns" -> {Center}}], ")"}], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"k", "=", "0"}], 
         SubscriptBox["b", "2"]], "\[VeryThinSpace] ", 
        RowBox[{
         RowBox[{
          SubsuperscriptBox["T", "k", 
           RowBox[{"(", 
            SubscriptBox["b", "2"], ")"}]], "(", 
          RowBox[{
           SubscriptBox["a", "1"], "+", 
           RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "a"}]}], ")"}], 
         "\[InvisibleSpace]", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"n", "+", 
            RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}]}], ")"}], 
          "k"]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.889297158544037*^9, 3.8892972284816217`*^9}, {
  3.889302209795473*^9, 3.889302221121471*^9}, {3.889479920141796*^9, 
  3.889479927078665*^9}, {3.889500879162839*^9, 3.889501014306322*^9}, {
  3.889501055870576*^9, 3.889501087527932*^9}, {3.889501435347138*^9, 
  3.8895015052914953`*^9}, {3.8895015824819603`*^9, 3.889501614464837*^9}, {
  3.889501808070992*^9, 3.889501873537368*^9}, {3.8895029506714487`*^9, 
  3.889502957044159*^9}, {3.889503093870576*^9, 
  3.889503142076119*^9}},ExpressionUUID->"c2515db2-1008-4f31-b555-\
36182a679b85"],

Cell["\<\
and by two applications of the binomial theorem, we can get a polynomial\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8895031469939127`*^9, 3.889503160469839*^9}, {
  3.889503205382127*^9, 
  3.889503207336802*^9}},ExpressionUUID->"a3fd0fd5-ead6-4d67-b624-\
c15fbb79469d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["P", 
     RowBox[{
      SubscriptBox["a", "1"], "\[InvisibleSpace]", 
      SubscriptBox["b", "2"]}], 
     RowBox[{
      SubscriptBox["b", "1"], "\[InvisibleSpace]", 
      SubscriptBox["a", "2"]}]], "(", "n", ")"}], " ", "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{
      SuperscriptBox["2", 
       RowBox[{
        SubscriptBox["b", "1"], "+", 
        SubscriptBox["b", "2"]}]], "\[InvisibleSpace]"}]], 
    RowBox[{"(", GridBox[{
       {
        RowBox[{
         SubscriptBox["a", "1"], "+", 
         SubscriptBox["b", "1"]}]},
       {
        SubscriptBox["b", "1"]}
      },
      GridBoxAlignment->{"Columns" -> {Center}}], ")"}], " ", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{
         SubscriptBox["a", "2"], "+", 
         SubscriptBox["b", "2"]}]},
       {
        SubscriptBox["b", "2"]}
      },
      GridBoxAlignment->{"Columns" -> {Center}}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", "0"}], 
       RowBox[{
        SubscriptBox["b", "1"], "+", 
        SubscriptBox["b", "2"]}]], "\[VeryThinSpace] ", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["Q", "k", 
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["b", "1"], ",", 
           SubscriptBox["b", "2"], ",", 
           RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "a"}]}], ")"}]], 
        "(", 
        SubscriptBox["a", "1"], ")"}], "\[InvisibleSpace]", 
       SuperscriptBox["n", "k"]}]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.889503143563252*^9, 3.889503145135927*^9}, {
  3.889503209402215*^9, 
  3.8895033292583113`*^9}},ExpressionUUID->"24345460-20d7-4bc2-96fb-\
f70dfc85c1f0"],

Cell[TextData[{
 "which is a function of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "78ab9cba-cd30-44f7-a578-edc05c85906b"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "1"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "5d887b60-b3b8-4661-a590-ba62b7110b27"],
 " as we\[CloseCurlyQuote]ve taken the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "a"}], " ", "=", " ", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["a", "2"], "\[InvisibleSpace]", "\[Minus]", 
      SubscriptBox["a", "1"]}], ")"}]}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "151401f4-6eb5-4365-9300-f79a70e6195a"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}], " ", "=", " ", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["a", "1"], "\[Minus]", 
      SubscriptBox["b", "1"]}], ")"}]}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "c98528ea-4daa-4e00-887b-53b7bdcf71fe"],
 " terms and moved them into the polynomial coefficients"
}], "ExpositoryText",
 CellChangeTimes->{{3.889503306739666*^9, 
  3.8895035323389072`*^9}},ExpressionUUID->"ca66664b-e376-442d-9847-\
ca8e75017085"],

Cell["\<\
As we work through different possible sets of paths, this ability might be \
useful.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.889503533910738*^9, 
  3.889503563326356*^9}},ExpressionUUID->"d18f2a70-a952-45fc-a084-\
1943db0b6687"],

Cell["In 1D, our denominators look like", "ExpositoryText",
 CellChangeTimes->{{3.8895455184157543`*^9, 3.889545542553934*^9}, {
  3.8902214412522383`*^9, 
  3.890221443823944*^9}},ExpressionUUID->"f41b6748-da0e-486c-a2c1-\
fbb901293dff"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderoverscriptBox["\[Product]", 
     RowBox[{"i", "=", "1"}], "k"], " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "1"}], "i"], " ", 
     SubscriptBox["\[CapitalDelta]E", "j"]}]}], " ", "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Product]", 
     RowBox[{"i", "=", "1"}], "k"], " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "1"}], "i"], " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["a", "j"], "-", 
        SubscriptBox["b", "j"]}], ")"}], 
      SubscriptBox["E", "j"]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.88954553770741*^9, 3.889545537718503*^9}, {
  3.88954561325449*^9, 3.889545682988923*^9}, {3.8895461670841208`*^9, 
  3.889546181724251*^9}},ExpressionUUID->"56fc5e82-dd24-45b8-9848-\
2b9b0b44aefb"]
}, Closed]],

Cell[CellGroupData[{

Cell["Implementation", "Subsubsubsection",
 CellChangeTimes->{{3.890233414705368*^9, 
  3.890233421128438*^9}},ExpressionUUID->"897c1679-2d5f-4000-bbc8-\
b45b29ba0818"],

Cell["\<\
Generically, every class of terms can be characterized by three factors:\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8902334226586113`*^9, 3.8902334375269136`*^9}, {
  3.890233505817583*^9, 3.890233580371255*^9}, {3.890233706108676*^9, 
  3.890233711509322*^9}},ExpressionUUID->"88087cef-a3a6-476b-91cf-\
e623cda4c386"],

Cell[TextData[{
 "the number of quanta changed in every dimension connecting ",
 Cell[BoxData[
  TemplateBox[{"n"},
   "Bra"]],ExpressionUUID->"48241974-4105-4b09-a1e7-6abd65b2dba1"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"m"},
    "Ket"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "06244a9a-5eb2-4550-b51d-51a16ce9207d"]
}], "ItemNumbered",
 CellChangeTimes->{{3.890233640318675*^9, 
  3.89023369695085*^9}},ExpressionUUID->"fac86753-2c02-4edd-99bc-\
4d1729a6db40"],

Cell["the number operations in each dimension", "ItemNumbered",
 CellChangeTimes->{{3.890233640318675*^9, 
  3.890233712798954*^9}},ExpressionUUID->"c1ed100e-3461-47c0-8cff-\
7567deeba61d"],

Cell["the positions of the permutation splits", "ItemNumbered",
 CellChangeTimes->{{3.890233640318675*^9, 
  3.890233719572031*^9}},ExpressionUUID->"aa487f97-c230-49c9-9a3d-\
cf76a011750d"],

Cell["\<\
but like what do we do about the fact that we really have the terms\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8902339426470222`*^9, 
  3.890233952486595*^9}},ExpressionUUID->"1af616e6-7ef2-44bf-8ac6-\
87da1d15a593"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], " ", 
    SubsuperscriptBox["\[CapitalDelta]H", "n", 
     RowBox[{"(", "1", ")"}]], 
    SubscriptBox["\[CapitalPi]", "n"], "A", "\[VeryThinSpace]\[AlignmentMarker]", 
    SubscriptBox["\[CapitalPi]", "m"], 
    SubsuperscriptBox["\[CapitalDelta]H", "m", 
     RowBox[{"(", "1", ")"}]]}], "+", 
   RowBox[{
    SubsuperscriptBox["\[CapitalDelta]H", "n", 
     RowBox[{"(", "1", ")"}]], 
    SubscriptBox["\[CapitalPi]", "n"], 
    SubsuperscriptBox["\[CapitalDelta]H", "n", 
     RowBox[{"(", "1", ")"}]], 
    SubscriptBox["\[CapitalPi]", "n"], "A"}], "\[VeryThinSpace]", "+", 
   RowBox[{"A", "\[VeryThinSpace]", 
    SubscriptBox["\[CapitalPi]", "m"], 
    SubsuperscriptBox["\[CapitalDelta]H", "m", 
     RowBox[{"(", "1", ")"}]], 
    SubscriptBox["\[CapitalPi]", "m"], 
    SubsuperscriptBox["\[CapitalDelta]H", "m", 
     RowBox[{"(", "1", ")"}]], 
    TemplateBox[{
      SuperscriptBox["m", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.890233953789569*^9, 
  3.890233993374462*^9}},ExpressionUUID->"6072df25-6ee8-4ba1-8c5d-\
56f88a636485"],

Cell["this also gives us stuff like", "ExpositoryText",
 CellChangeTimes->{{3.890233998146357*^9, 
  3.890234026519966*^9}},ExpressionUUID->"68590aea-d8b3-475b-bf70-\
ae259af0b5f2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Bra"], 
   SubsuperscriptBox["\[CapitalDelta]H", "n", 
    RowBox[{"(", "1", ")"}]], 
   SubscriptBox["\[CapitalPi]", "n"], 
   SubscriptBox["\[CapitalPi]", "n"], "A", 
   TemplateBox[{
     SuperscriptBox["m", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.890234012860889*^9, 
  3.890234038593651*^9}},ExpressionUUID->"188e1f79-84fc-4cb5-a5d4-\
32271c3170e6"],

Cell[TextData[{
 "which is length 4 instead of 7 (and therefore can\[CloseCurlyQuote]t \
actually connect the terms...) \[Implies] ",
 StyleBox["only matters for dropping even order terms",
  FontSlant->"Italic"],
 " which also squares with the fact that the odd order energy corrections are \
uniformly zero..."
}], "ExpositoryText",
 CellChangeTimes->{{3.890234117357953*^9, 
  3.890234214469756*^9}},ExpressionUUID->"402f62ea-281d-4109-9da0-\
2e869da1676b"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Recursive Polynomial PT", "Section",
 CellChangeTimes->{{3.898169520700686*^9, 
  3.89816952465489*^9}},ExpressionUUID->"ec8551e6-ee81-4454-b313-\
0e80697765bc"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"5", 
    SubscriptBox["P", "1"], 
    SubscriptBox["P", "2"], 
    SubscriptBox["P", "3"]}], " ", "+", " ", 
   RowBox[{"3", " ", 
    SubscriptBox["P", "1"], 
    SubscriptBox["P", "2"], 
    SubscriptBox["P", "j"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.898943639313611*^9, 
  3.89894365745198*^9}},ExpressionUUID->"b374e560-7c47-4d9c-a935-\
9cb230371e2c"],

Cell["\<\
To avoid redoing a bunch of work it would be nice to take the expressions we \
have\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8981695261426783`*^9, 
  3.898169548702305*^9}},ExpressionUUID->"887c8752-4c2f-4219-8569-\
5f817c93cbdc"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox[
       SubscriptBox["E", "n"], 
       RowBox[{"(", "k", ")"}]], "=", 
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], " ", 
        SuperscriptBox["H", 
         RowBox[{"(", "k", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], 
         RowBox[{"k", "-", "1"}]], 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], " ", 
         SuperscriptBox["H", 
          RowBox[{"(", 
           RowBox[{"k", "-", "i"}], ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"]}]}], " ", "-", " ", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["E", "n"], 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", "i", ")"}]]}]},
         "BraKet"]}]}]}]},
    {
     RowBox[{
      TemplateBox[{
        RowBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]], " "}], 
        RowBox[{"\[VeryThinSpace] ", 
          SuperscriptBox["n", 
           RowBox[{"(", "k", ")"}]]}]},
       "BraKet"], "=", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], 
         RowBox[{"k", "-", "1"}]], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "i", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", 
               RowBox[{"k", "-", "i"}], ")"}]]}]},
         "BraKet"]}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "n"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       SubscriptBox["\[CapitalPi]", "n"], 
       RowBox[{"(", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"i", "=", "0"}], 
          RowBox[{"k", "-", "1"}]], "\[VeryThinSpace]", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox[
             SubscriptBox["E", "n"], 
             RowBox[{"(", 
              RowBox[{"k", "-", "i"}], ")"}]], "-", 
            SuperscriptBox["H", 
             RowBox[{"(", 
              RowBox[{"k", "-", "i"}], ")"}]]}], ")"}], 
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "i", ")"}]]},
           "Ket"]}]}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.898169540547079*^9, 
  3.898169542976819*^9}},ExpressionUUID->"14257a3b-8a72-4599-bcee-\
d5c2bf7ed825"],

Cell["to evaluate any property we need for the PT", "ExpositoryText",
 CellChangeTimes->{{3.898169551989421*^9, 
  3.8981695685168877`*^9}},ExpressionUUID->"34539150-7efe-47c5-a95b-\
4cedfb7d688b"],

Cell[TextData[{
 "To do so, we\[CloseCurlyQuote]ll assume to start that for every ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", " ", "<", " ", "k"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "f99b6606-0265-4893-b40c-90364bd220b4"],
 " we can evaluate"
}], "ExpositoryText",
 CellChangeTimes->{{3.89816957033331*^9, 3.8981696197253647`*^9}, {
  3.8981698892841263`*^9, 
  3.898169890374198*^9}},ExpressionUUID->"9c2a98a6-5fe5-4007-a745-\
e273496e10e1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["m", 
      RowBox[{"(", "0", ")"}]], 
     RowBox[{"\[VeryThinSpace] ", 
       SuperscriptBox["n", 
        RowBox[{"(", "i", ")"}]], "\[VeryThinSpace]"}]},
    "BraKet"], " ", "=", " ", 
   RowBox[{
    SubsuperscriptBox["W", 
     RowBox[{"(", 
      RowBox[{"n", "-", "m"}], ")"}], 
     RowBox[{"(", "i", ")"}]], "(", "n", ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.898169639197651*^9, 3.8981697202724323`*^9}, {
   3.89816980226163*^9, 3.8981698171766*^9}, 
   3.898169893404161*^9},ExpressionUUID->"487461c7-e93f-4804-8560-\
fafabf884b17"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["W", "\[CapitalDelta]", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "7e65c9c0-7aed-423c-a769-4add542cbd2e"],
 " is a polynomial in the quantum numbers (",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "ae5864a6-73b2-48ff-82be-4c5f1e390556"],
 ") encoding the ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "8a3ecf9d-b6b2-49f7-b3e2-58facf802496"],
 "th order wave function correction for a change in quanta by ",
 Cell[BoxData[
  FormBox["\[CapitalDelta]", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "bd401042-d33e-4098-9b8a-f6378dfe55dc"]
}], "ExpositoryText",
 CellChangeTimes->{{3.8981698952642593`*^9, 
  3.8981699788209543`*^9}},ExpressionUUID->"eaaf7d35-7f68-41ef-a4de-\
1346a1123cd2"],

Cell["\<\
This will build off of a set of Hamiltonian operator polynomials given by\
\>", "ExpositoryText",
 CellChangeTimes->{{3.89816999659894*^9, 
  3.8981700212806273`*^9}},ExpressionUUID->"a19a898e-803e-43f9-bcb4-\
dc767797eec2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      RowBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]], "+", "\[CapitalDelta]"}]},
     "Bra"], " ", 
    SuperscriptBox["H", 
     RowBox[{"(", "k", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], " ", "=", " ", 
   RowBox[{
    SubsuperscriptBox["H", "\[CapitalDelta]", 
     RowBox[{"(", "k", ")"}]], "(", "n", ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.898170070420307*^9, 
  3.898170087487504*^9}},ExpressionUUID->"b216a7ad-3a6f-4fea-a1ab-\
1d12c48205fd"],

Cell["then when we have something like", "ExpositoryText",
 CellChangeTimes->{{3.898169744679953*^9, 
  3.898169749103611*^9}},ExpressionUUID->"8e1d53ed-c83f-4838-a1a4-\
b42c55ac4a01"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Bra"], " ", 
   SuperscriptBox["H", 
    RowBox[{"(", 
     RowBox[{"k", "-", "i"}], ")"}]], 
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "i", ")"}]]},
    "Ket"], " "}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8981697542458487`*^9, 
  3.898169754801097*^9}},ExpressionUUID->"e1ccc5fa-fab3-4dc3-a4e9-\
e9909a03fe30"],

Cell[TextData[{
 "we\[CloseCurlyQuote]ll note that we can change quanta in the range ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"2", "+", "k", "\[Minus]", "i"}], ")"}]}], ",", " ", 
     RowBox[{"2", "+", "k", "\[Minus]", "i"}]}], "]"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "410ece1f-c76d-42d5-bb66-6ce60513715b"],
 " stepping by twos, and for each of those changes we\[CloseCurlyQuote]ll \
then get the polynomial"
}], "ExpositoryText",
 CellChangeTimes->{{3.898169756057084*^9, 3.8981697929837723`*^9}, 
   3.898169824722221*^9, {3.898170113731874*^9, 3.898170117808481*^9}, {
   3.8981701521746283`*^9, 3.8981702129147177`*^9}, {3.898170348944618*^9, 
   3.898170409252191*^9}, {3.898170539219952*^9, 
   3.8981705671504908`*^9}},ExpressionUUID->"d2c74c86-6c63-4437-8385-\
64f8647dcb14"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], " ", 
    SuperscriptBox["H", 
     RowBox[{"(", 
      RowBox[{"k", "-", "i"}], ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "i", ")"}]]},
     "Ket"]}], " ", "=", " ", 
   RowBox[{
    UnderscriptBox["\[Sum]", "\[CapitalDelta]"], " \[VeryThinSpace]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["H", "\[CapitalDelta]", 
        RowBox[{"(", 
         RowBox[{"k", "-", "i"}], ")"}]], "*", 
       SubsuperscriptBox["W", 
        RowBox[{"-", "\[CapitalDelta]"}], 
        RowBox[{"(", "i", ")"}]]}], ")"}], 
     RowBox[{"(", "n", ")"}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8981705685605917`*^9, 3.8981706240055532`*^9}, {
  3.898325422553094*^9, 
  3.898325448049837*^9}},ExpressionUUID->"ad46ad76-d8a7-433b-916e-\
2a28f5c23f9d"],

Cell[TextData[{
 "To consider how this polynomial is constructed, we\[CloseCurlyQuote]ll note \
that, letting ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", " ", "=", " ", "4"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "9d258621-bf46-44d2-95dc-baab7ae18238"],
 ", if \[CapitalDelta] changes one mode by two quanta, then "
}], "ExpositoryText",
 CellChangeTimes->{{3.89817053338094*^9, 3.898170535985869*^9}, {
  3.89817063190701*^9, 
  3.898170703269628*^9}},ExpressionUUID->"9d189a45-92a8-4d3f-b1bf-\
c346aee10611"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      RowBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]], "+", "\[CapitalDelta]"}]},
     "Bra"], " ", 
    SuperscriptBox["H", 
     RowBox[{"(", "k", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], " ", "=", " ", 
   RowBox[{
    SubsuperscriptBox["H", "\[CapitalDelta]", 
     RowBox[{"(", "k", ")"}]], "(", "n", ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.898170707463964*^9, 
  3.898170708088516*^9}},ExpressionUUID->"bfb39b21-06d0-412b-a3e7-\
3040666e0380"],

Cell[TextData[StyleBox["is a polynomial with three distinct contributions, we \
have",
 FontSlant->"Plain"]], "ExpositoryText",
 CellChangeTimes->{{3.898170711746469*^9, 3.898170780193681*^9}, {
  3.898170834802945*^9, 3.898170835371028*^9}},
 FontSlant->"Italic",ExpressionUUID->"d94bc300-f39d-49d2-9d49-27dee5b495c1"],

Cell[TextData[StyleBox["a 1D polynomial in the changed mode coming from \
putting all 6 possible changes in on degree of freedom",
 FontSlant->"Plain"]], "Subitem",
 CellChangeTimes->{{3.898170782243113*^9, 
  3.898170787162937*^9}},ExpressionUUID->"674abe24-5897-4a5a-ad66-\
d2030a930df5"],

Cell[TextData[StyleBox["a 2D polynomial from putting 4 quanta in the changed \
mode and 2 in any arbitrary unchanged mode (where we at a later step must sum \
over all unchanged modes)",
 FontSlant->"Plain"]], "Subitem",
 CellChangeTimes->{{3.898170782243113*^9, 
  3.8981708559916077`*^9}},ExpressionUUID->"c0646fca-6662-431f-a754-\
5e6d3e13187d"],

Cell[TextData[StyleBox["a 2D polynomial from putting 2 quanta in the changed \
mode and 4 in any arbitrary unchanged mode",
 FontSlant->"Plain"]], "Subitem",
 CellChangeTimes->{{3.898170782243113*^9, 
  3.898170870430874*^9}},ExpressionUUID->"9369fb4b-c30c-45ab-a2df-\
22388f6755f4"],

Cell[TextData[StyleBox["a 3D polynomial from putting 2 quanta in the changed \
mode and 2 each in any pair of unchanged modes, and again at a later step we \
will sum over pairs",
 FontSlant->"Plain"]], "Subitem",
 CellChangeTimes->{{3.898170782243113*^9, 
  3.8981709026380033`*^9}},ExpressionUUID->"44894f8f-4fb3-4871-81c3-\
4d1c094e0406"],

Cell[TextData[{
 "Then when we take the product with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["W", "\[CapitalDelta]", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.8981705685605917`*^9, 3.8981706240055532`*^9}},
  ExpressionUUID->"417841a9-b257-4c76-84c9-35eac50aa125"],
 ", these will be the four cases we need to consider, ",
 StyleBox["however",
  FontSlant->"Italic"],
 " we also need to note that the polynomial contributions to ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["W", "\[CapitalDelta]", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.8981705685605917`*^9, 3.8981706240055532`*^9}},
  ExpressionUUID->"31317f42-06e0-4f59-beb7-6a877d8d842e"],
 " will also have a set of \
\[OpenCurlyDoubleQuote]free\[CloseCurlyDoubleQuote] modes, and the free modes \
from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["H", "\[CapitalDelta]", 
     RowBox[{"(", "k", ")"}]], "(", "n", ")"}], TraditionalForm]],
  CellChangeTimes->{{3.898170707463964*^9, 3.898170708088516*^9}},
  ExpressionUUID->"5fe2263e-a15e-450f-9576-a5e55bc04c03"],
 " will not necessarily align with the free modes from ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["W", "\[CapitalDelta]", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.8981705685605917`*^9, 3.8981706240055532`*^9}},
  ExpressionUUID->"37604c0c-25b4-47a1-a13c-19005381f4a3"],
 " and therefore we must take the direct product of free modes aligning and \
not aligning"
}], "ExpositoryText",
 CellChangeTimes->{{3.898170925942643*^9, 3.898170963280198*^9}, {
  3.898171008583807*^9, 
  3.8981710630635347`*^9}},ExpressionUUID->"34b2bac9-8c0e-4072-a439-\
a92c5fe5e1b5"],

Cell[TextData[{
 "Mechanistically, when computing the terms available to e.g. ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], 
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "1", ")"}]]},
    "Ket"]}]],
  CellChangeTimes->{{3.898324526498815*^9, 3.898324527181658*^9}},
  ExpressionUUID->"60f359c0-7828-48a8-b510-de6d968b2e15"],
 " we need to be a bit careful, ",
 Cell[BoxData[
  SuperscriptBox["H", 
   RowBox[{"(", "1", ")"}]]],ExpressionUUID->
  "58af4b23-df3a-419c-9723-b255aabcb05d"],
 " can change quanta by"
}], "ExpositoryText",
 CellChangeTimes->{{3.898324501840722*^9, 3.898324520465143*^9}, {
  3.8983245732853727`*^9, 
  3.898324674049292*^9}},ExpressionUUID->"2878d3f8-82c1-462b-b1f3-\
aba0f033e76c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], " \[AlignmentMarker]", "~", " ", 
    SubsuperscriptBox["q", "1", "3"]}], ",", " ", 
   RowBox[{
    SubsuperscriptBox["q", "1", "2"], "\[InvisibleSpace]", 
    SubscriptBox["q", "2"]}], ",", " ", 
   RowBox[{
    SubscriptBox["q", "1"], "\[InvisibleSpace]", 
    SubscriptBox["q", "2"], "\[InvisibleSpace]", 
    SubscriptBox["q", "3"]}]}], 
  TraditionalForm]], "ExpositoryMathCenteredManuallyAligned",
 CellChangeTimes->{{3.898324676137795*^9, 
  3.898324723294959*^9}},ExpressionUUID->"7c6bbdfe-94fb-43d9-9959-\
4610a6ddaeb7"],

Cell[TextData[{
 "and so ",
 Cell[BoxData[
  TemplateBox[{
    SuperscriptBox["n", 
     RowBox[{"(", "1", ")"}]]},
   "Ket"]],
  CellChangeTimes->{{3.898324526498815*^9, 3.898324527181658*^9}},
  ExpressionUUID->"76d1dd21-85b7-4add-aa0e-8648059d3185"],
 " has these changes for all possible operators plus a contribution from \
changing no quanta, and so we end up with "
}], "ExpositoryText",
 CellChangeTimes->{{3.898324726497233*^9, 3.898324771294018*^9}, {
  3.8983249052245617`*^9, 
  3.898324967345694*^9}},ExpressionUUID->"838093e1-6b02-43b0-b2be-\
25f5253e1e5a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], 
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "1", ")"}]]},
      "Ket"], " ", "~", " ", 
     SubsuperscriptBox["q", "1", "6"]}]}], ",", 
   RowBox[{
    SubsuperscriptBox["q", "1", "3"], "\[InvisibleSpace]", 
    SubsuperscriptBox["q", "2", "3"]}], ",", " ", 
   RowBox[{
    SubsuperscriptBox["q", "1", "3"], "\[InvisibleSpace]", 
    SubsuperscriptBox["q", "2", "2"], "\[InvisibleSpace]", 
    SubscriptBox["q", "3"]}], ",", " ", 
   RowBox[{
    SubsuperscriptBox["q", "1", "3"], "\[InvisibleSpace]", 
    SubscriptBox["q", "2"], "\[InvisibleSpace]", 
    SubscriptBox["q", "3"], "\[InvisibleSpace]", 
    SubscriptBox["q", "4"]}], ",", " ", 
   RowBox[{
    SubsuperscriptBox["q", "1", "2"], "\[InvisibleSpace]", 
    SubsuperscriptBox["q", "2", "2"], "\[InvisibleSpace]", 
    SubscriptBox["q", "3"], "\[InvisibleSpace]", 
    SubscriptBox["q", "4"]}], ",", " ", 
   RowBox[{
    SubsuperscriptBox["q", "1", "2"], "\[InvisibleSpace]", 
    SubscriptBox["q", "2"], "\[InvisibleSpace]", 
    SubscriptBox["q", "3"], "\[InvisibleSpace]", 
    SubscriptBox["q", "4"], "\[InvisibleSpace]", 
    SubscriptBox["q", "5"]}], ",", " ", 
   RowBox[{
    SubscriptBox["q", "1"], "\[InvisibleSpace]", 
    SubscriptBox["q", "2"], "\[InvisibleSpace]", 
    SubscriptBox["q", "3"], "\[InvisibleSpace]", 
    SubscriptBox["q", "4"], "\[InvisibleSpace]", 
    SubscriptBox["q", "5"], "\[InvisibleSpace]", 
    SubscriptBox["q", "6"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.898324632184532*^9, 3.898324632196919*^9}, {
  3.898324973545424*^9, 
  3.898325109238648*^9}},ExpressionUUID->"77a872a0-8c10-452f-b0d1-\
df73d3018a3e"],

Cell[TextData[{
 "but difficultly, while there\[CloseCurlyQuote]s only one way to get ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["q", "1", "6"], TraditionalForm]],
  CellChangeTimes->{{3.898324632184532*^9, 3.898324632196919*^9}, {
   3.898324973545424*^9, 3.898325109238648*^9}},ExpressionUUID->
  "c794c783-ad51-4ec5-80ea-6e49083bb906"],
 ", there are multiple ways yo get to, e.g., ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["q", "1", "3"], "\[InvisibleSpace]", 
    SubscriptBox["q", "2"], "\[InvisibleSpace]", 
    SubscriptBox["q", "3"], "\[InvisibleSpace]", 
    SubscriptBox["q", "4"]}], TraditionalForm]],
  CellChangeTimes->{{3.898324632184532*^9, 3.898324632196919*^9}, {
   3.898324973545424*^9, 3.898325109238648*^9}},ExpressionUUID->
  "7b20f849-3a1d-4a80-b41e-4d66f0f59a03"],
 " and so assuming initially that"
}], "ExpositoryText",
 CellChangeTimes->{{3.898325140546342*^9, 3.898325176901832*^9}, {
  3.898325248155671*^9, 
  3.8983252542114677`*^9}},ExpressionUUID->"9745a0e3-20c7-4139-b63a-\
85f737e3ad48"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     RowBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]], "+", 
       SubscriptBox["\[CapitalDelta]", "1"], "\[ThinSpace]\[VeryThinSpace]"}], 
     RowBox[{"\[VeryThinSpace] ", 
       SuperscriptBox["n", 
        RowBox[{"(", "i", ")"}]], "\[VeryThinSpace]"}]},
    "BraKet"], " ", "=", " ", 
   RowBox[{
    SubsuperscriptBox["W", 
     SubscriptBox["\[CapitalDelta]", "1"], 
     RowBox[{"(", "i", ")"}]], "(", "n", ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.898325264748435*^9, 
  3.898325324418861*^9}},ExpressionUUID->"f9e075b2-10df-472a-a169-\
b4b4b8c02266"],

