               RowBox[{"a", "-", "i"}], ")"}], "-", "1"}], ")"}]}]}], 
          "\[RightBracketingBar]"}], 
         RowBox[{"i", "=", 
          RowBox[{"a", "-", "2"}]}]], " ", "+", " ", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"a", "-", "i"}], ")"}], "+", "1", "+", "1"}], ")"}], 
         RowBox[{"(", 
