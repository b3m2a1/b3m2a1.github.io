      RowBox[{"A", "\[InvisibleSpace]", 
       SubscriptBox["x", "i"]}], " ", "=", " ", 
      RowBox[{
       SubscriptBox["\[Lambda]", "i"], 
       SubscriptBox["x", "i"]}]}]},
    {
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{
       SubscriptBox["\[Lambda]", "i"], " ", "=", " ", 
       RowBox[{
        SubsuperscriptBox["x", "i", "T"], "\[InvisibleSpace]", "A", 
        "\[InvisibleSpace]", 
        SubscriptBox["x", "i"]}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "Q"], 
       SubscriptBox["\[Lambda]", "i"]}], " ", "=", " ", 
      RowBox[{
       SubscriptBox["\[Del]", "Q"], 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["x", "i", "T"], "\[InvisibleSpace]", "A", 
         "\[InvisibleSpace]", 
         SubscriptBox["x", "i"]}], ")"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", "Q"], 
         RowBox[{"(", 
          SubsuperscriptBox["x", "i", "T"], "\[InvisibleSpace]", ")"}]}], 
        RowBox[{"(", 
         RowBox[{"A", "\[InvisibleSpace]", 
          SubscriptBox["x", "i"]}], ")"}]}], " ", "+", " ", 
       RowBox[{
        SubsuperscriptBox["x", "i", "T"], "\[InvisibleSpace]", "A", 
        "\[InvisibleSpace]", 
        RowBox[{
         SubscriptBox["\[Del]", "Q"], 
         RowBox[{"(", 
          SubscriptBox["x", "i"], ")"}]}]}], " ", "+", " ", 
       RowBox[{
        SubsuperscriptBox["x", "i", "T"], "\[InvisibleSpace]", 
        RowBox[{
         SubscriptBox["\[Del]", "Q"], 
         RowBox[{"(", "A", "\[InvisibleSpace]", ")"}]}], 
        SubscriptBox["x", "i"]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Lambda]", "i"], "(", 
        RowBox[{
         RowBox[{
          RowBox[{
           SubscriptBox["\[Del]", "Q"], 
           RowBox[{"(", 
            SubsuperscriptBox["x", "i", "T"], "\[InvisibleSpace]", ")"}]}], 
          RowBox[{"(", 
           SubscriptBox["x", "i"], ")"}]}], " ", "+", " ", 
         RowBox[{
          SubsuperscriptBox["x", "i", "T"], "\[InvisibleSpace]\[InvisibleSpace]", 
          RowBox[{
           SubscriptBox["\[Del]", "Q"], 
           RowBox[{"(", 
            SubscriptBox["x", "i"], ")"}]}]}]}], ")"}], " ", "+", " ", 
       RowBox[{
        SubsuperscriptBox["x", "i", "T"], "\[InvisibleSpace]", 
        RowBox[{
         SubscriptBox["\[Del]", "Q"], 
         RowBox[{"(", "A", "\[InvisibleSpace]", ")"}]}], 
        SubscriptBox["x", "i"]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SubsuperscriptBox["x", "i", "T"], "\[InvisibleSpace]", 
       RowBox[{
        SubscriptBox["\[Del]", "Q"], 
        RowBox[{"(", "A", "\[InvisibleSpace]", ")"}]}], 
       SubscriptBox["x", "i"]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "Q"], 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["x", "i", "T"], "\[InvisibleSpace]", 
         RowBox[{
          SubscriptBox["\[Del]", "Q"], 
          RowBox[{"(", "A", "\[InvisibleSpace]", ")"}]}], 
         SubscriptBox["x", "i"]}], ")"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", "Q"], 
         RowBox[{"(", 
          SubsuperscriptBox["x", "i", "T"], "\[InvisibleSpace]", ")"}]}], 
        RowBox[{"(", 
         RowBox[{"A", "\[InvisibleSpace]", 
          SubscriptBox["x", "i"]}], ")"}]}], " ", "+", " ", 
       RowBox[{
        SubsuperscriptBox["x", "i", "T"], "\[InvisibleSpace]", "A", 
        "\[InvisibleSpace]", 
        RowBox[{
         SubscriptBox["\[Del]", "Q"], 
         RowBox[{"(", 
          SubscriptBox["x", "i"], ")"}]}]}], " ", "+", " ", 
       RowBox[{
        SubsuperscriptBox["x", "i", "T"], "\[InvisibleSpace]", 
        RowBox[{
         SubscriptBox["\[Del]", "Q"], 
         RowBox[{"(", "A", "\[InvisibleSpace]", ")"}]}], "x"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.927115183568839*^9, 3.927115215146482*^9}, {
  3.927115297845662*^9, 3.927115346921579*^9}, {3.9271155682828608`*^9, 
  3.927115577172791*^9}, {3.927115637004937*^9, 3.927115757395567*^9}, {
  3.92711579585083*^9, 3.927115828272738*^9}, {3.9271158860087957`*^9, 
  3.927116031666581*^9}, {3.9271161542909603`*^9, 3.927116157699586*^9}, {
  3.9271162106588984`*^9, 3.9271162294208508`*^9}, {3.9271164291242247`*^9, 
  3.927116430309906*^9}, {3.927116463461013*^9, 3.927116473980874*^9}, {
  3.92711657796373*^9, 
  3.92711660665843*^9}},ExpressionUUID->"68650983-0f9a-427b-b5eb-\
0b005ad97e69"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"A", "-", 
         RowBox[{
          SubscriptBox["\[Lambda]", "i"], "I"}]}], ")"}], "\[VeryThinSpace]\[InvisibleSpace]", 
       SubscriptBox["x", "i"]}], " ", "=", " ", "0"}]},
    {
     RowBox[{
      RowBox[{"\[Implies]", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"A", "-", 
          RowBox[{
           SubscriptBox["\[Lambda]", "i"], "I"}]}], ")"}], "\[VeryThinSpace]\[InvisibleSpace]", 
        RowBox[{
         SubscriptBox["\[Del]", "Q"], 
         SubscriptBox["x", "i"]}]}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[Del]", "Q"], "A"}], "-", 
         RowBox[{
          RowBox[{
           SubscriptBox["\[Del]", "Q"], 
           SubscriptBox["\[Lambda]", "i"]}], "I"}]}], ")"}], "\[VeryThinSpace]\[InvisibleSpace]", 
       SubscriptBox["x", "i"]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", "Q"], "A"}], " ", "-", " ", 
        RowBox[{
         SubsuperscriptBox["x", "i", "T"], "\[InvisibleSpace]", 
         RowBox[{
          SubscriptBox["\[Del]", "Q"], 
          RowBox[{"(", "A", "\[InvisibleSpace]", ")"}]}], 
         SubscriptBox["x", "i"]}]}], ")"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.92711661717307*^9, 3.927116676812401*^9}, {
  3.927117104107151*^9, 
  3.9271171383558693`*^9}},ExpressionUUID->"750cb9e6-af78-455c-b410-\
