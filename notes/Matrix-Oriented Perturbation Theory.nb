Cell[CellGroupData[{

Cell["Dipole Derivatives", "Section",
 CellChangeTimes->{{3.810514097502219*^9, 3.810514103957509*^9}, {
  3.8109903841243687`*^9, 
  3.810990384393523*^9}},ExpressionUUID->"3cadcc50-7d53-464c-a1f5-\
4d9bc1fb9061"],

Cell["\<\
We need to transform from Cartesian coords to internals again...but this time \
we\[CloseCurlyQuote]ve got different mixed derivatives to deal with. \
\>", "ExpositoryText",
 CellChangeTimes->{{3.810514105041148*^9, 
  3.810514220269301*^9}},ExpressionUUID->"6f3d1cb7-ec74-4adf-a79a-\
5b79bac2300d"],

Cell["\<\
The first derivatives are straightforward (being wholly in Cartesian \
coordinates)\
\>", "ExpositoryText",
 CellChangeTimes->{{3.810514105041148*^9, 3.810514194684287*^9}, 
   3.810514225715446*^9},ExpressionUUID->"4d77f8f9-01ec-403d-8cd0-\
37286aa7f202"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", "Q"], 
    SubscriptBox["\[Mu]", "\[Alpha]"]}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "Q"], "X"}], 
    RowBox[{
     SubscriptBox["\[Del]", "X"], 
     SubscriptBox["\[Mu]", "\[Alpha]"]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8105141960903263`*^9, 
  3.810514217243951*^9}},ExpressionUUID->"524d5021-6684-4d4a-8aad-\
671ad88b65db"],

Cell[TextData[{
 "The second derivatives are not bad, even though we start with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", "q"], 
    RowBox[{
     SubscriptBox["\[Del]", "X"], 
     SubscriptBox["\[Mu]", "\[Alpha]"]}]}], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "95779a9c-a81c-410c-af08-fe1f76468192"]
}], "ExpositoryText",
 CellChangeTimes->{{3.810514222019291*^9, 
  3.8105142553640623`*^9}},ExpressionUUID->"787ea26c-4aa5-4c40-8760-\
fb94b1bd3e0f"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "Q"], 
       RowBox[{
        SubscriptBox["\[Del]", "X"], 
        SubscriptBox["\[Mu]", "\[Alpha]"]}]}], "=", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "Q"], "q"}], 
       RowBox[{
        SubscriptBox["\[Del]", "q"], 
        RowBox[{
         SubscriptBox["\[Del]", "X"], 
         SubscriptBox["\[Mu]", "\[Alpha]"]}]}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["Q", "2"]], 
       SubscriptBox["\[Mu]", "\[Alpha]"]}], "=", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "Q"], "X"}], 
       RowBox[{"\[LeftAngleBracket]", "2", "\[RightAngleBracket]"}], 
       RowBox[{
        SubscriptBox["\[Del]", "Q"], 
        RowBox[{
         SubscriptBox["\[Del]", "X"], 
         SubscriptBox["\[Mu]", "\[Alpha]"]}]}]}]}]}
