Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"bucketReduce", ",", " ", "sublistReduce"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bucketReduce", "[", 
    RowBox[{"ops_List", ",", " ", "sizes_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"heads", "=", 
       RowBox[{"Sort", "@", 
        RowBox[{"DeleteDuplicates", "[", 
         RowBox[{"Head", "/@", "ops"}], "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"sublistReduce", "[", 
        RowBox[{"#", ",", " ", "heads"}], "]"}], "&"}], "/@", 
      RowBox[{"TakeList", "[", 
       RowBox[{"ops", ",", " ", "sizes"}], "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sublistReduce", "[", 
   RowBox[{"ops_List", ",", " ", "heads_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"headGroups", "=", 
      RowBox[{"GroupBy", "[", 
       RowBox[{"ops", ",", " ", "Head", ",", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Total", "@", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", " ", "1"}], "]"}], "]"}]}], ",", " ", 
           RowBox[{"Length", "@", "#"}]}], "}"}], "&"}]}], "]"}]}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{"Lookup", "[", 
     RowBox[{"headGroups", ",", " ", "heads", ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
