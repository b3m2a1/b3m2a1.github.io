Cell[CellGroupData[{

Cell["Near Degeneracies", "Subsection",
 CellChangeTimes->{{3.829055584477961*^9, 
  3.8290555868992147`*^9}},ExpressionUUID->"c53c949b-af80-49a3-9abf-\
3ff961291673"],

Cell[TextData[{
 "By ",
 StyleBox["near-degeneracies",
  FontSlant->"Italic"],
 " we just mean cases where the perturbation expansions either do not \
converge or, alternately, converge very slowly. To counter this, we will \
introduce a two-parameter expansion to our wave functions and energies"
}], "ExpositoryText",
 CellChangeTimes->{{3.829055594557604*^9, 3.829055659401675*^9}, {
  3.829055765618428*^9, 3.829055772928192*^9}, {3.829055850878343*^9, 
  3.829055865104747*^9}, {3.829055909954108*^9, 
  3.829055928314474*^9}},ExpressionUUID->"c39b1044-9004-4472-af2f-\
ac08df36510d"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["E", "n"], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "\[Infinity]"], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"a", "=", "0"}], "\[Infinity]"], " ", 
        RowBox[{
         SubsuperscriptBox["E", "n", 
          RowBox[{"(", 
           RowBox[{"\[Lambda]", ",", "a"}], ")"}]], 
         SuperscriptBox["\[Lambda]", 
          RowBox[{"(", "i", ")"}]], 
         SuperscriptBox["\[Epsilon]", 
          RowBox[{"(", "a", ")"}]]}]}]}]}]},
    {
     RowBox[{
      TemplateBox[{"n"},
       "Ket"], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "\[Infinity]"], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"a", "=", "0"}], "\[Infinity]"], " ", 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", 
              RowBox[{"\[Lambda]", ",", "a"}], ")"}]]},
          "Ket"], 
         SuperscriptBox["\[Lambda]", 
          RowBox[{"(", "i", ")"}]], 
         SuperscriptBox["\[Epsilon]", 
          RowBox[{"(", "a", ")"}]]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.829055955704768*^9, 3.829055979913821*^9}, {
  3.8290560613892736`*^9, 
  3.829056164584572*^9}},ExpressionUUID->"01549e37-e3c5-4170-b6de-\
05eb0bb0afa4"],

Cell[TextData[{
 "or alternately, for any order ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "4eb82ed7-6337-4bf9-9668-8dc245e3ce7f"],
 " in \[Lambda] we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.8290562155189323`*^9, 
  3.829056227362714*^9}},ExpressionUUID->"b887778d-336f-42c0-b339-\
2e74f385bd0f"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["E", "n", 
       RowBox[{"(", "k", ")"}]], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"a", "=", "0"}], "\[Infinity]"], " ", 
       RowBox[{
        SubsuperscriptBox["E", "n", 
         RowBox[{"(", 
          RowBox[{"k", ",", "a"}], ")"}]], 
        SuperscriptBox["\[Epsilon]", 
         RowBox[{"(", "a", ")"}]]}]}]}]},
    {
     RowBox[{
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "k", ")"}]]},
       "Ket"], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"a", "=", "0"}], "\[Infinity]"], " ", 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", 
             RowBox[{"k", ",", "a"}], ")"}]]},
         "Ket"], 
        SuperscriptBox["\[Epsilon]", 
         RowBox[{"(", "a", ")"}]]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.829055955704768*^9, 3.829055979913821*^9}, {
  3.8290560613892736`*^9, 3.829056164584572*^9}, {3.8290562318235607`*^9, 
  3.829056249520907*^9}, {3.829056576421068*^9, 
  3.829056578639987*^9}},ExpressionUUID->"fc19639f-4869-46d7-b740-\
39a5de05e691"],

Cell["\<\
which allows us to reexpress the perturbation theory equations as\
\>", "ExpositoryText",
 CellChangeTimes->{{3.829056254467369*^9, 3.8290562614357643`*^9}, {
  3.829056510501152*^9, 
  3.8290565351585207`*^9}},ExpressionUUID->"7a583c95-7c03-49b6-8cc1-\
85564d723451"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{"\[DoubleStruckZero]", " ", "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "k"], 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "i", ")"}]]},
         "Ket"]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"m", "=", "0"}], "M"], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], "k"], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"a", "=", "0"}], "m"], 
         RowBox[{
          SubsuperscriptBox["\[CapitalDelta]H", "n", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"k", "-", "i"}], ",", " ", 
             RowBox[{"m", "-", "a"}]}], ")"}]], 
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", 
               RowBox[{"i", ",", " ", "a"}], ")"}]]},
           "Ket"]}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8290565366424093`*^9, 3.8290566160203238`*^9}, {
   3.829056751065999*^9, 3.829056753276412*^9}, 
   3.8290567837185583`*^9},ExpressionUUID->"7b611ddc-8e3e-4d80-919b-\
c91a883140c9"],

Cell[TextData[{
 "which so far is no different from everything we have presented before. But \
what we can do is say for this to converge, we should be able to truncate at \
some maximal ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],ExpressionUUID->
  "eeab40b8-4a75-496f-a808-501de69653a1"],
 ". The idea with the non-convergence is that there is no such ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],ExpressionUUID->
  "02c7ac1f-200d-4bb4-9709-3bd6961cc4db"],
 ". "
}], "ExpositoryText",
 CellChangeTimes->{{3.829056657509782*^9, 3.829056716743947*^9}, {
  3.8290567562997923`*^9, 
  3.829056807366262*^9}},ExpressionUUID->"fd61003d-bdb9-4f3a-ac33-\
69951c583bf6"],

Cell["\<\
will note that the energies come directly from our wavefunctions\
\>", "ExpositoryText",
 CellChangeTimes->{{3.829055594557604*^9, 3.829055659401675*^9}, {
  3.829055765618428*^9, 3.829055772928192*^9}, {3.829055850878343*^9, 
  3.829055865104747*^9}},ExpressionUUID->"d4e8e363-9e75-4388-aa6d-\
c6970dbadb4d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["E", "n", 
    RowBox[{"(", "k", ")"}]], " ", "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     SuperscriptBox["H", 
      RowBox[{"(", "k", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], 
      RowBox[{"k", "-", "1"}]], 
     RowBox[{
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]]},
       "Bra"], 
      SubsuperscriptBox["\[CapitalDelta]H", "n", 
       RowBox[{"(", 
        RowBox[{"k", "-", "i"}], ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8290558756170197`*^9, 
  3.829055876256734*^9}},ExpressionUUID->"7ddcc855-c423-4401-98b8-\
9b2a01d4f444"],

Cell[TextData[{
 "and so if the ",
 StyleBox["perturbation theory",
  FontSlant->"Italic"],
 " is going to yield non-convergent expansions for the energies and wave \
functions "
}], "ExpositoryText",
 CellChangeTimes->{{3.829055878847568*^9, 
  3.829055905567865*^9}},ExpressionUUID->"cd5e4fce-5ba7-4ec3-8deb-\
30bf1ed9b4f4"]
}, Open  ]],

