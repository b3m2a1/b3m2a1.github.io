               SubscriptBox["S", "2"], "(", 
               RowBox[{"j", ",", " ", "\[Omega]"}], ")"}], 
              RowBox[{"\[Omega]", "+", "1"}]], 
             RowBox[{
              UnderoverscriptBox["\[Sum]", 
               RowBox[{"l", "=", "0"}], 
               RowBox[{"\[Omega]", "+", "1"}]], " ", 
              RowBox[{
               SubscriptBox[
                RowBox[{"(", 
                 RowBox[{
                  SubscriptBox["S", "1"], "\[VeryThinSpace]", "P"}], ")"}], 
                RowBox[{"\[Omega]", "+", 
                 RowBox[{"1", "\[InvisibleSpace]", "l"}]}]], 
               SuperscriptBox["a", "l"]}]}]}]}]}]}]}], ")"}]}]}]},
    {
