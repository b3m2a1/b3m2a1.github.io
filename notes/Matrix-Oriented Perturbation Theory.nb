            RowBox[{"(", "i", ")"}]]}], "-", 
          SuperscriptBox["E", 
           RowBox[{"(", "i", ")"}]]}], ")"}], 
        SubscriptBox["P", "D"], 
        TemplateBox[{"n"},
         "Ket"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
