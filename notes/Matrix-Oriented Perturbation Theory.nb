     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "0"}], 
      RowBox[{"a", "+", "1"}]], 
     RowBox[{
      SuperscriptBox["\[CapitalDelta]H", 
       RowBox[{"(", 
        RowBox[{"a", "+", "1", "-", "j"}], ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", 
           RowBox[{"k", "+", "j"}], ")"}]]},
       "Ket"]}]}]}], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["P", "D", 
      RowBox[{"(", 
       RowBox[{"a", "+", "1"}], ")"}]], 
     SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
      RowBox[{"(", 
       RowBox[{"a", "+", "1"}], ")"}]], 
     SubsuperscriptBox["P", "D", 
      RowBox[{"(", 
       RowBox[{"a", "+", "1"}], ")"}]], 
