          SuperscriptBox["n", 
           RowBox[{"(", "k", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "1"}], 
         RowBox[{"a", "+", "1"}]], 
        RowBox[{
         SubscriptBox["P", "D"], 
         SuperscriptBox["\[CapitalDelta]H", 
          RowBox[{"(", 
           RowBox[{"a", "+", "1", "-", "j"}], ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", 
              RowBox[{"k", "+", "j"}], ")"}]]},
          "Ket"]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        SubscriptBox["P", "D"], 
        SuperscriptBox["\[CapitalDelta]H", 
