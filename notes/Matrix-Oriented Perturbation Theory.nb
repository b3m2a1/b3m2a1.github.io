Cell[CellGroupData[{

Cell["Induction on Degeneracy Order", "Subsubsection",
 CellChangeTimes->{{3.825766836091835*^9, 3.8257668406361227`*^9}, {
  3.8277072513873243`*^9, 
  3.827707251650056*^9}},ExpressionUUID->"8d670de9-ca71-4ce7-bb81-\
7330a3a9ec74"],

Cell[TextData[{
 "Suppose up to degeneracy order ",
 StyleBox["a",
  FontSlant->"Italic"],
 " for any ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "258306a8-a912-4efa-bd71-1efe7c64438d"],
 " we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.825726103853674*^9, 3.825726203855031*^9}, 
   3.8257264970922813`*^9, {3.825727131905707*^9, 
   3.825727133827593*^9}},ExpressionUUID->"14060cd8-0e2c-47c7-90ac-\
0d0fe745bf0a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"j", "=", "0"}], "a"], 
    RowBox[{
     SubscriptBox["P", "D"], 
     SuperscriptBox["\[CapitalDelta]H", 
      RowBox[{"(", 
       RowBox[{"a", "-", "j"}], ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", 
          RowBox[{"k", "+", "j"}], ")"}]]},
      "Ket"]}]}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["P", "D"], 
     SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
      RowBox[{"(", "a", ")"}]], 
     SubscriptBox["P", "D"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "k", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "1"}], "a"], "\[VeryThinSpace]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "0"}], 
       RowBox[{"k", "-", "1"}]], 
      RowBox[{
       SubscriptBox["P", "D"], 
       SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
        RowBox[{"(", "j", ")"}]], 
       SubsuperscriptBox["\[CapitalPi]", "U", "n"], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", 
         RowBox[{"k", "+", "a", "-", "j", "-", "i"}], ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]]},
        "Ket"]}]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825726109047275*^9, 3.825726114403275*^9}, {
  3.825726191984178*^9, 3.82572626474254*^9}, {3.825726375705141*^9, 
