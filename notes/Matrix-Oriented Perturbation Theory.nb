   3.825808485081386*^9},ExpressionUUID->"cdd7fb74-564f-47b3-8b70-\
4ae41094859e"],

Cell[TextData[{
 "and then from the inductive hypothesis, defining ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["J", "a", 
     RowBox[{"(", "0", ")"}]], "=", "I"}], TraditionalForm]],
  CellChangeTimes->{{3.825789799765967*^9, 3.8257899016079187`*^9}},
  ExpressionUUID->"e5b93769-e4df-4d16-a052-b08793e6078f"]
}], "ExpositoryText",
