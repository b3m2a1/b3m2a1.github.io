Cell["\<\
where we can see that this is clearly a linear combination of the degenerate \
original states where the strongest contribution is coming from state 4 in \
the original bases.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.821649423629305*^9, 
  3.821649502753561*^9}},ExpressionUUID->"91adfc82-198d-4f4a-a14f-\
adaa1f63c582"],

Cell["\<\
 We have the first order energy correction from this already, too, so now we \
focus on getting the first-order corrections to the wave functions in the \
non-degenerate space. To do this we have\
\>", "ExpositoryText",
 CellChangeTimes->{{3.821649423629305*^9, 3.8216495119132137`*^9}, {
  3.821651852615815*^9, 
  3.8216518711033173`*^9}},ExpressionUUID->"ccd1a62b-ca2c-4056-9025-\
fbf09ab361fc"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", "U"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"[", 
      RowBox[{"U", ":", 
       SubsuperscriptBox["\[CapitalPi]", "n", 
        RowBox[{"(", "0", ")"}]], ":", "U"}], "]"}], 
     TemplateBox[{
       RowBox[{"T", ":", "\[VeryThinSpace]", 
         RowBox[{
           UnderoverscriptBox[
            RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}], 
            StyleBox["1", FontSize -> 14], 
            StyleBox["1", FontSize -> 12]], 
           RowBox[{"(", "k", ")"}]}]}]},
      "Ket"]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"[", 
      RowBox[{"U", ":", 
       SubsuperscriptBox["\[CapitalPi]", "n", 
        RowBox[{"(", "0", ")"}]], ":", "U"}], "]"}], 
     SuperscriptBox["H", 
      RowBox[{"(", "k", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821651872033991*^9, 
  3.82165187279504*^9}},ExpressionUUID->"6905b5b9-64cc-47ff-ac7f-\
7482790f68da"],

Cell[TextData[{
 "which means we build ",
 StyleBox["most",
  FontSlant->"Italic"],
 " of the unperturbed correction to the wave function in the total space & \
then add on the final order ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "3c23c42a-405c-43fb-b2bc-e8b2709cc2cc"],
 " part in only non-degenerate pace. We won\[CloseCurlyQuote]t go too much \
into this, since it looks pretty much identical to what we did before. In any \
case we get"
}], "ExpositoryText",
 CellChangeTimes->{{3.8216518745632544`*^9, 3.821651985746992*^9}, {
  3.821730971376664*^9, 3.821731023645041*^9}, {3.821731111450179*^9, 
  3.821731114685658*^9}},ExpressionUUID->"8ea73672-9560-48fc-94a8-\
d010d81dc32e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"$dD", "[", 
    RowBox[{"[", 
     RowBox[{"\"\<n\>\"", ",", " ", "2"}], "]"}], "]"}], "=", 
   RowBox[{"Dot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[CapitalPi]", "[", "$dD", "]"}], "[", 
      RowBox[{"\[ScriptCapitalU]", ",", " ", "0"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"\[CapitalDelta]n", "[", "$dD", "]"}], "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalT]", "[", "$ptData", "]"}], ",", "1", ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}], "+", 
      RowBox[{"Dot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[CapitalEta]", "[", "$ptData", "]"}], "[", "1", "]"}], ",",
         " ", 
        RowBox[{
         RowBox[{"\[Phi]", "[", "$dD", "]"}], "[", "0", "]"}]}], "]"}]}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "@", 
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
     "figStyleText", "[", 
      "\"\<\!\(\*SubscriptBox[\(P\), \(U\)]\)\!\(\*TemplateBox[{
SuperscriptBox[
StyleBox[\"n\", FontSlant -> \"Italic\"], 
RowBox[{\"(\", \"1\", \")\"}]]},\"Ket\"]\)\>\"", "]"}], ",", " ", 
     RowBox[{"figStyleText", "@", "\"\<=\>\""}], ",", "\[IndentingNewLine]", 
     RowBox[{"pertPlot", "[", 
      RowBox[{
       RowBox[{"\[Phi]", "[", "$dD", "]"}], "[", "1", "]"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"figStyleText", "@", "\"\<=\>\""}], ",", "\[IndentingNewLine]", 
     RowBox[{"pertPlot", "[", 
      RowBox[{
       RowBox[{"\[CapitalPi]", "[", "$dD", "]"}], "[", 
       RowBox[{"\[ScriptCapitalU]", ",", " ", "0"}], "]"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"pertPlot", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalDelta]n", "[", "$dD", "]"}], "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalT]", "[", "$ptData", "]"}], ",", "1", ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}], "\[IndentingNewLine]",
        "+", 
       RowBox[{"Dot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[CapitalEta]", "[", "$ptData", "]"}], "[", "1", "]"}], 
         ",", " ", 
         RowBox[{
          RowBox[{"\[Phi]", "[", "$dD", "]"}], "[", "0", "]"}]}], "]"}]}], 
      "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "}"}], 
   "}"}]}]}], "Input",
