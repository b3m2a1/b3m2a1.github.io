Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "x"], "A"}], " ", "\[Congruent]", " ", 
      SubscriptBox["A", "x"]}]},
    {
     RowBox[{
      SuperscriptBox["A", 
       RowBox[{"a", "\[Rule]", "b"}]], "\[Congruent]", 
      SuperscriptBox["A", 
       RowBox[{"a", ":", "b"}]]}]},
    {
     RowBox[{
      RowBox[{"A", "\[CircleDot]", "B"}], "\[Congruent]", 
      RowBox[{"A", "\[VeryThinSpace]", "B"}]}]}
   },
   GridBoxAlignment->{"Columns" -> {{"\[Congruent]"}}}], 
