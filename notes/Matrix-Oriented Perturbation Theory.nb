f64ab3824574"],

Cell[TextData[{
 "Then noting that (when evaluated at the equilibrium structure) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["Q", "1"], "=", 
    RowBox[{
     SuperscriptBox["R", "1"], "=", "I"}]}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "eeb200a4-0898-4597-999e-0496ae6d420c"]
}], "ExpositoryText",
 CellChangeTimes->{{3.91996287754502*^9, 
  3.919962919365994*^9}},ExpressionUUID->"5a6bfe93-9843-467b-adcf-\
582f3f11cc1d"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox["\[CapitalGamma]", "1"], " ", "=", " ", 
      RowBox[{
       SuperscriptBox["G", "1"], "+", 
       SuperscriptBox["V", "1"]}]}]},
    {
     RowBox[{
      SuperscriptBox["\[CapitalGamma]", "2"], " ", "=", " ", 
      RowBox[{
       SuperscriptBox["G", "2"], "+", 
       SuperscriptBox["V", "2"], " ", "+", " ", 
       RowBox[{
        SubsuperscriptBox["Q", 
         RowBox[{"k", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "a"}], 
         "2"], 
        SubsuperscriptBox["\[CapitalGamma]", 
         RowBox[{"a", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "i"}], 
         "1"]}], " ", "+", " ", 
       SubscriptBox[
        RowBox[{"2", "[", 
         RowBox[{
          SubsuperscriptBox["R", 
           RowBox[{"a", "\[InvisibleSpace]", "_", "\[InvisibleSpace]", "j"}], 
           "2"], 
          SubsuperscriptBox["G", 
           RowBox[{"b", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "_"}], 
           "1"]}], "]"}], 
        RowBox[{"a", "\[InvisibleSpace]", 
         RowBox[{"b", "(", "\[InvisibleSpace]", 
          RowBox[{
           RowBox[{"j", "\[InvisibleSpace]", "i"}], "+", 
           RowBox[{"i", "\[InvisibleSpace]", "j"}]}], ")"}]}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.919962885562788*^9, 3.919962890092952*^9}, {
  3.919962951884273*^9, 3.91996297259648*^9}, {3.919963031078425*^9, 
  3.9199631173657007`*^9}, {3.919963188257943*^9, 
  3.919963203811475*^9}},ExpressionUUID->"fccf7075-d890-4703-b7f8-\
484e812998f4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", 
      SuperscriptBox["Q", "2"]], "R"}], 
    RowBox[{
     SubscriptBox["\[Del]", "R"], "G"}]}], " ", "=", " "}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.920563205037683*^9, 
  3.920563256005043*^9}},ExpressionUUID->"7da7ffb0-4f62-4f04-88ea-\
356b58e3e3a4"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "Q"], 
       SubscriptBox["G", "R"]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "Q"], "R"}], 
       RowBox[{
        SubscriptBox["\[Del]", "R"], 
        SubscriptBox["G", "R"]}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["Q", "2"]], 
       SubscriptBox["G", "R"]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["Q", "2"]], "R"}], 
        RowBox[{
         SubscriptBox["\[Del]", "R"], 
         SubscriptBox["G", "R"]}]}], " ", "+", " ", 
       SubscriptBox["\[Del]", "\[Placeholder]"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9205632728604307`*^9, 
  3.9205633403069468`*^9}},ExpressionUUID->"1f91cf04-9bf8-4a7b-a724-\
64b06195ad42"],

Cell[TextData[{
 "Now we will note something slightly funky, that for ",
 StyleBox["any",
  FontSlant->"Italic"],
 " evaluation position we can write"
}], "ExpositoryText",
 CellChangeTimes->{{3.919980382784663*^9, 
  3.919980410309473*^9}},ExpressionUUID->"3fc7c0e9-5301-4588-a395-\
8f2cb130cd69"],

Cell[BoxData[
 FormBox[
  RowBox[{"I", " ", "=", " ", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "Q"], "R"}], 
    RowBox[{
     SubscriptBox["\[Del]", "R"], "Q"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.919980411628893*^9, 
  3.919980422459771*^9}},ExpressionUUID->"f027f0af-392a-4ccc-a95b-\
e7d4b6e677da"],

Cell["therefore", "ExpositoryText",
 CellChangeTimes->{{3.919980424228829*^9, 
  3.919980425832755*^9}},ExpressionUUID->"afc480ac-1e78-4f64-8748-\
18068d283e31"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "Q"], "I"}], " ", "=", " ", 
      RowBox[{
       SubscriptBox["\[Del]", "Q"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[Del]", "Q"], "R"}], 
         RowBox[{
          SubscriptBox["\[Del]", "R"], "Q"}]}], ")"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{"[", 
        RowBox[{
         SubsuperscriptBox["Q", 
          RowBox[{"i", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "a"}], 
          "2"], "\[InvisibleSpace]", 
         SubsuperscriptBox["R", 
          RowBox[{"a", "\[InvisibleSpace]", "j"}], "1"]}], "]"}], " ", "+", 
       " ", 
       RowBox[{"[", 
        RowBox[{
         SubsuperscriptBox["Q", 
          RowBox[{"i", "\[InvisibleSpace]", "a"}], "1"], 
         SubsuperscriptBox["Q", 
          RowBox[{"i", "\[InvisibleSpace]", "a"}], "1"], "\[InvisibleSpace]", 
         
         SubsuperscriptBox["R", 
          RowBox[{"a", "\[InvisibleSpace]", "a", "\[InvisibleSpace]", "j"}], 
          "2"]}], "]"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.919980411628893*^9, 
  3.9199805214658203`*^9}},ExpressionUUID->"f1bca472-9062-4ba1-a346-\
1892fc54f789"],

Cell[TextData[{
 "but when evaluated at the minimum energy structure specifically this gives \
us (since ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "Q"], "I"}], "=", "\[DoubleStruckZero]"}], 
   TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "751c4ae8-c993-4f65-9b8f-8e57897ede0c"],
 ")"
}], "ExpositoryText",
 CellChangeTimes->{{3.919980524978279*^9, 
  3.9199805648918123`*^9}},ExpressionUUID->"d1988ed7-e54f-40ff-bf89-\
d962d7800e05"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["Q", "2"], "\[InvisibleSpace]  ", "=", " ", 
   RowBox[{"-", "\[InvisibleSpace]", 
    SuperscriptBox["R", "2"]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.919980411628893*^9, 3.9199805214658203`*^9}, {
  3.919980570887268*^9, 
  3.9199805958198433`*^9}},ExpressionUUID->"853a630d-3c75-4b94-ab4e-\
58e3f7871334"],

Cell[TextData[{
 "which notably just indicates the tensors ",
 StyleBox["have the same value",
  FontSlant->"Italic"],
 " at this specific evaluation location not that the relevant axes are the \
same or that they transform in similar ways"
}], "ExpositoryText",
 CellChangeTimes->{{3.919980599716308*^9, 3.919980628398242*^9}, {
  3.920031901381043*^9, 
  3.9200319120838747`*^9}},ExpressionUUID->"534f3131-01a7-4c76-b163-\
809dd8d42988"],

Cell["Note that by a similar argument we have", "ExpositoryText",
 CellChangeTimes->{{3.919986192724908*^9, 
  3.9199861977089157`*^9}},ExpressionUUID->"5ab2c06d-87bf-4b2d-8aa9-\
7d355fd15ac6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["Q", 
     RowBox[{"k", "\[InvisibleSpace]\[InvisibleSpace]", "a"}], "1"], 
    SubscriptBox[
     RowBox[{
      SubsuperscriptBox["Q", 
       RowBox[{"k", "\[InvisibleSpace]\[InvisibleSpace]", "b"}], "1"], "[", 
      RowBox[{
       SubsuperscriptBox["R", 
        RowBox[{"a", "\[InvisibleSpace]", "_", "\[InvisibleSpace]", "j"}], 
        "2"], 
       SubsuperscriptBox["R", 
        RowBox[{"_", "\[InvisibleSpace]", "i"}], "1"], 
       SubsuperscriptBox["G", 
        RowBox[{"b", "\[InvisibleSpace]", "_", "\[InvisibleSpace]", "_"}], 
        "1"]}], "]"}], 
     RowBox[{"a", "\[InvisibleSpace]", 
      RowBox[{"b", "(", "\[InvisibleSpace]", 
       RowBox[{
        RowBox[{"j", "\[InvisibleSpace]", "i"}], "+", 
        RowBox[{"i", "\[InvisibleSpace]", "j"}]}], ")"}]}]]}], " ", "=", " ", 
   
   SubscriptBox[
    RowBox[{"[", 
     RowBox[{
      SubsuperscriptBox["R", 
       RowBox[{"k", "\[InvisibleSpace]", "_", "\[InvisibleSpace]", "j"}], 
       "2"], 
      SubsuperscriptBox["G", 
       RowBox[{"k", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "_"}], 
       "1"]}], "]"}], 
    RowBox[{"k", "\[InvisibleSpace]", 
     RowBox[{"k", "(", "\[InvisibleSpace]", 
      RowBox[{
       RowBox[{"j", "\[InvisibleSpace]", "i"}], "+", 
       RowBox[{"i", "\[InvisibleSpace]", "j"}]}], ")"}]}]]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.91998619870945*^9, 
  3.9199862534275637`*^9}},ExpressionUUID->"df7f312f-ef74-442b-b6df-\
6685ac5d3877"],

Cell[TextData[{
 "which would seem to imply either of the ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "e882c25f-a537-40e7-93db-6569fd66ea89"],
 " axes in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["R", 
     RowBox[{"a", "\[InvisibleSpace]", "a", "\[InvisibleSpace]", "j"}], "2"], 
    " ", "=", " ", 
    RowBox[{
     SubscriptBox["\[Del]", 
      SuperscriptBox["R", "2"]], "Q"}]}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "5b43567e-2045-4872-90c6-fcc1f0e1cd2c"],
 " can be contracted with the ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "66508e31-dc8e-428b-ab74-e3940bece618"],
 " axis in ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["G", 
    RowBox[{"k", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "a"}], "1"], 
   TraditionalForm]],
  CellChangeTimes->{{3.91998619870945*^9, 3.9199862534275637`*^9}},
  ExpressionUUID->"fd4e47f0-3c73-4ada-aacd-7b1fb3495b3c"],
 ", plus we have an implied symmetry in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["R", 
     RowBox[{"k", "\[InvisibleSpace]", "_", "\[InvisibleSpace]", "j"}], "2"], 
    
    SubsuperscriptBox["G", 
     RowBox[{"k", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "_"}], 
     "1"]}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "7b007194-3d18-441d-a623-394202257dea"]
}], "ExpositoryText",
 CellChangeTimes->{{3.919986239588666*^9, 3.9199864112213297`*^9}, {
  3.919987284507091*^9, 
  3.9199872875827923`*^9}},ExpressionUUID->"e9e036a9-101a-41cc-b91c-\
24199068497b"],

Cell["We then have", "ExpositoryText",
 CellChangeTimes->{{3.919964545854097*^9, 
  3.91996454772561*^9}},ExpressionUUID->"38a9bc5b-35b7-4d8c-8988-\
539935a23a37"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["\[CapitalGamma]", "2"], " ", "=", " ", 
   RowBox[{
    SuperscriptBox["G", "2"], "+", 
    SuperscriptBox["V", "2"], " ", "-", " ", 
    RowBox[{
     SubsuperscriptBox["R", 
      RowBox[{"k", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "a"}], "2"], 
     SubsuperscriptBox["\[CapitalGamma]", 
      RowBox[{"a", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "i"}], 
      "1"]}], " ", "+", " ", 
    SubscriptBox[
     RowBox[{"2", "[", 
      RowBox[{
       SubsuperscriptBox["R", 
        RowBox[{"k", "\[InvisibleSpace]", "c", "\[InvisibleSpace]", "j"}], 
        "2"], 
       SubsuperscriptBox["G", 
        RowBox[{"b", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "c"}], 
        "1"]}], "]"}], 
     RowBox[{"a", "\[InvisibleSpace]", 
      RowBox[{"b", "(", "\[InvisibleSpace]", 
       RowBox[{
        RowBox[{"j", "\[InvisibleSpace]", "i"}], "+", 
        RowBox[{"i", "\[InvisibleSpace]", "j"}]}], ")"}]}]]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.919962885562788*^9, 3.919962890092952*^9}, {
  3.919962951884273*^9, 3.91996297259648*^9}, {3.919963031078425*^9, 
  3.9199631173657007`*^9}, {3.919963188257943*^9, 3.919963203811475*^9}, {
  3.9199807320386*^9, 3.919980734420719*^9}, {3.919986073665762*^9, 
  3.919986091974553*^9}},ExpressionUUID->"6f767649-0f25-4da6-b083-\
60cc16903a0f"]
}, Closed]],

Cell[CellGroupData[{

Cell["Generic 2nd Order Perturbation Theory", "Subsubsection",
 CellChangeTimes->{{3.920032347637904*^9, 
  3.920032357407902*^9}},ExpressionUUID->"e99386d0-af74-4d9b-a51b-\
3aab0d5f8662"],

Cell["We\[CloseCurlyQuote]ll use the expressions developed above to write", \
"ExpositoryText",
 CellChangeTimes->{{3.920032358523734*^9, 
  3.920032365358754*^9}},ExpressionUUID->"d0d18cce-632c-40af-b72e-\
5ece85ee271e"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{"n"},
        "Bra"], 
       RowBox[{
        SuperscriptBox["V", 
         RowBox[{"(", "2", ")"}]], "\[CircleDot]", 
        SuperscriptBox["Q", "4"]}], 
       TemplateBox[{"n"},
        "Ket"]}], " ", "=", "\[AlignmentMarker] ", 
      RowBox[{
       RowBox[{
        UnderscriptBox["\[Sum]", "i"], " ", 
        RowBox[{
         SubsuperscriptBox["V", 
          RowBox[{
          "i", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "i", 
           "\[InvisibleSpace]", "i", "\[InvisibleSpace]"}], 
          RowBox[{"(", "2", ")"}]], 
         TemplateBox[{
           SubscriptBox["n", "i"]},
          "Bra"], 
         SubsuperscriptBox["Q", "i", "4"], 
         TemplateBox[{
           SubscriptBox["n", "i"]},
          "Ket"]}]}], " ", "+", " ", 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"i", ",", "j"}]], " ", 
        RowBox[{
         SubsuperscriptBox["V", 
          RowBox[{
          "i", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "j", 
           "\[InvisibleSpace]", "j", "\[InvisibleSpace]"}], 
          RowBox[{"(", "2", ")"}]], 
         TemplateBox[{
           SubscriptBox["n", "i"]},
          "Bra"], 
         SubsuperscriptBox["Q", "i", "2"], 
         TemplateBox[{
           SubscriptBox["n", "i"]},
          "Ket"], 
         TemplateBox[{
           SubscriptBox["n", "j"]},
          "Bra"], 
         SubsuperscriptBox["Q", "j", "2"], 
         TemplateBox[{
           SubscriptBox["n", "j"]},
          "Ket"]}]}]}]}]},
    {
     RowBox[{"=", "\[AlignmentMarker] ", 
      RowBox[{
       RowBox[{
        UnderscriptBox["\[Sum]", "i"], 
        RowBox[{
         SubsuperscriptBox["V", 
          RowBox[{
          "i", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "i", 
           "\[InvisibleSpace]", "i", "\[InvisibleSpace]"}], 
          RowBox[{"(", "2", ")"}]], 
         RowBox[{
          SubsuperscriptBox["K", "2", "2"], "(", 
          SubscriptBox["n", "i"], ")"}]}]}], " ", "+", " ", 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"i", ",", "j"}]], " ", 
        RowBox[{
         SubsuperscriptBox["V", 
          RowBox[{
          "i", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "j", 
           "\[InvisibleSpace]", "j", "\[InvisibleSpace]"}], 
          RowBox[{"(", "2", ")"}]], 
         RowBox[{
          SubsuperscriptBox["K", "1", "1"], "(", 
          SubscriptBox["n", "i"], ")"}], 
         RowBox[{
          SubsuperscriptBox["K", "1", "1"], "(", 
          SubscriptBox["n", "j"], ")"}]}]}]}]}]},
    {
     RowBox[{
      RowBox[{
       TemplateBox[{"n"},
        "Bra"], 
       RowBox[{
        SuperscriptBox["G", 
         RowBox[{"(", "2", ")"}]], "\[CircleDot]", "P"}], "\[InvisibleSpace]", 
       SuperscriptBox["Q", "2"], "\[InvisibleSpace]", "P", 
       TemplateBox[{"n"},
        "Ket"]}], "  ", "=", "\[AlignmentMarker] ", 
      RowBox[{
       RowBox[{
        UnderscriptBox["\[Sum]", "i"], " ", 
        RowBox[{
         SubsuperscriptBox["G", 
          RowBox[{
          "i", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "i", 
           "\[InvisibleSpace]", "i", "\[InvisibleSpace]"}], 
          RowBox[{"(", "2", ")"}]], 
         TemplateBox[{
           SubscriptBox["n", "i"]},
          "Bra"], 
         SubscriptBox["P", "i"], "\[InvisibleSpace]", 
         SubsuperscriptBox["Q", "i", "2"], "\[InvisibleSpace]", 
         SubscriptBox["P", "i"], "\[InvisibleSpace]", 
         TemplateBox[{
           SubscriptBox["n", "i"]},
          "Ket"]}]}], " ", "+", " ", 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"i", ",", "j"}]], " ", 
        RowBox[{
         SubsuperscriptBox["G", 
          RowBox[{
          "i", "\[InvisibleSpace]\[InvisibleSpace]", "i", "\[InvisibleSpace]",
            "j", "\[InvisibleSpace]", "j"}], 
          RowBox[{"(", "2", ")"}]], 
         TemplateBox[{
           SubscriptBox["n", "i"]},
          "Bra"], 
         SubscriptBox["Q", "i"], "\[InvisibleSpace]", 
         SubscriptBox["Q", "i"], "\[InvisibleSpace]", 
         TemplateBox[{
           SubscriptBox["n", "i"]},
          "Ket"], 
         TemplateBox[{
           SubscriptBox["n", "j"]},
          "Bra"], 
         SubscriptBox["P", "j"], "\[InvisibleSpace]", 
         SubscriptBox["P", "j"], "\[InvisibleSpace]", 
         TemplateBox[{
           SubscriptBox["n", "j"]},
          "Ket"]}]}]}]}]},
    {
     RowBox[{"\[AlignmentMarker]  ", 
      RowBox[{"+", 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"i", ",", "j"}]], " ", 
        RowBox[{
         SubsuperscriptBox["G", 
          RowBox[{
          "i", "\[InvisibleSpace]\[InvisibleSpace]", "j", "\[InvisibleSpace]",
            "i", "\[InvisibleSpace]", "j"}], 
          RowBox[{"(", "2", ")"}]], "(", 
         RowBox[{
          RowBox[{
           TemplateBox[{
             SubscriptBox["n", "i"]},
            "Bra"], 
           SubscriptBox["Q", "i"], "\[InvisibleSpace]", 
           SubscriptBox["P", "i"], "\[InvisibleSpace]", 
           TemplateBox[{
             SubscriptBox["n", "i"]},
            "Ket"], 
           TemplateBox[{
             SubscriptBox["n", "j"]},
            "Bra"], 
           SubscriptBox["P", "j"], "\[InvisibleSpace]", 
           SubscriptBox["Q", "j"], "\[InvisibleSpace]", 
           TemplateBox[{
             SubscriptBox["n", "j"]},
            "Ket"]}], "+", 
          RowBox[{
           TemplateBox[{
             SubscriptBox["n", "i"]},
            "Bra"], 
           SubscriptBox["P", "i"], "\[InvisibleSpace]", 
           SubscriptBox["Q", "i"], "\[InvisibleSpace]", 
           TemplateBox[{
             SubscriptBox["n", "i"]},
            "Ket"], 
           TemplateBox[{
             SubscriptBox["n", "j"]},
            "Bra"], 
           SubscriptBox["Q", "j"], "\[InvisibleSpace]", 
           SubscriptBox["P", "j"], "\[InvisibleSpace]", 
           TemplateBox[{
             SubscriptBox["n", "j"]},
            "Ket"]}]}], ")"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCenteredManuallyAligned",
 CellChangeTimes->{{3.9200323733999166`*^9, 3.920032410812456*^9}, {
  3.9200324675583076`*^9, 3.9200325767459383`*^9}, {3.920032615278461*^9, 
  3.920032634978335*^9}, {3.920032669052285*^9, 3.920032768750064*^9}, {
  3.920032810755468*^9, 3.920032962165615*^9}, {3.920033025687302*^9, 
  3.920033118049556*^9}, {3.920039320552243*^9, 
  3.920039324099983*^9}},ExpressionUUID->"01799708-e7bf-4532-abbc-\
6ad69a61c776"],

Cell["Then we expand those final terms as", "ExpositoryText",
 CellChangeTimes->{{3.920033431432352*^9, 3.920033432942547*^9}, {
  3.920033628101577*^9, 3.920033647036313*^9}, {3.920033686330023*^9, 
  3.920033686372933*^9}},ExpressionUUID->"0f63e4b8-1d47-43a3-9ea3-\
647efef344ef"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SubscriptBox["n", "j"]},
        "Bra"], 
       SubscriptBox["P", "j"], "\[InvisibleSpace]", 
       SubscriptBox["Q", "j"], "\[InvisibleSpace]", 
       TemplateBox[{
         SubscriptBox["n", "j"]},
        "Ket"]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          SubsuperscriptBox["K", "1", "0"], "(", 
          RowBox[{
           SubscriptBox["n", "j"], "+", "1"}], ")"}]}], 
        RowBox[{
         SubsuperscriptBox["K", "0", "1"], "(", 
         SubscriptBox["n", "j"], ")"}]}], "+", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["K", "0", "1"], "(", 
         RowBox[{
          SubscriptBox["n", "j"], "-", "1"}], ")"}], 
        RowBox[{
         SubsuperscriptBox["K", "1", "0"], "(", 
         SubscriptBox["n", "j"], ")"}]}]}]}]},
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SubscriptBox["n", "j"]},
        "Bra"], 
       SubscriptBox["Q", "j"], "\[InvisibleSpace]", 
       SubscriptBox["P", "j"], "\[InvisibleSpace]", 
       TemplateBox[{
         SubscriptBox["n", "j"]},
        "Ket"]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubsuperscriptBox["K", "1", "0"], "(", 
         RowBox[{
          SubscriptBox["n", "j"], "+", "1"}], ")"}], 
        RowBox[{
         SubsuperscriptBox["K", "0", "1"], "(", 
         SubscriptBox["n", "j"], ")"}]}], "-", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["K", "0", "1"], "(", 
         RowBox[{
          SubscriptBox["n", "j"], "-", "1"}], ")"}], 
        RowBox[{
         SubsuperscriptBox["K", "1", "0"], "(", 
         SubscriptBox["n", "j"], ")"}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{"-", 
        TemplateBox[{
          SubscriptBox["n", "j"]},
         "Bra"]}], 
       SubscriptBox["P", "j"], "\[InvisibleSpace]", 
       SubscriptBox["Q", "j"], "\[InvisibleSpace]", 
       TemplateBox[{
         SubscriptBox["n", "j"]},
        "Ket"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
