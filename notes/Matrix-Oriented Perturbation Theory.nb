           RowBox[{"(", "3", ")"}]]}]},
       "BraKet"], "=", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], "2"], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "i", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", 
               RowBox[{"3", "-", "i"}], ")"}]]}]},
         "BraKet"]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], 
       RowBox[{"(", 
        RowBox[{
         TemplateBox[{
           RowBox[{
             SuperscriptBox["n", 
              RowBox[{"(", "1", ")"}]], " "}], 
           RowBox[{"\[VeryThinSpace] ", 
             SuperscriptBox["n", 
              RowBox[{"(", "2", ")"}]]}]},
          "BraKet"], "+", 
         TemplateBox[{
           RowBox[{
             SuperscriptBox["n", 
              RowBox[{"(", "2", ")"}]], " "}], 
           RowBox[{"\[VeryThinSpace] ", 
             SuperscriptBox["n", 
              RowBox[{"(", "1", ")"}]]}]},
          "BraKet"]}], ")"}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{"-", 
       TemplateBox[{
         RowBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "1", ")"}]], " "}], 
         RowBox[{"\[VeryThinSpace] ", 
           SuperscriptBox["n", 
            RowBox[{"(", "2", ")"}]]}]},
        "BraKet"]}]}]},
    {
     RowBox[{
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "3", ")"}]]},
       "Ket"], "=", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], "2"], 
        RowBox[{
         RowBox[{
          SubscriptBox["\[CapitalPi]", "n"], "(", 
          RowBox[{
           SuperscriptBox["H", 
            RowBox[{"(", 
             RowBox[{"3", "-", "i"}], ")"}]], "-", 
           SuperscriptBox[
            SubscriptBox["E", "n"], 
            RowBox[{"(", 
             RowBox[{"3", "-", "i"}], ")"}]]}], ")"}], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"]}]}], "+", 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", "3", ")"}]]}]},
         "BraKet"]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["\[CapitalPi]", "n"], "(", 
         RowBox[{
          SuperscriptBox["H", 
           RowBox[{"(", "3", ")"}]], "-", 
          SuperscriptBox[
           SubscriptBox["E", "n"], 
           RowBox[{"(", "3", ")"}]]}], ")"}], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[CapitalPi]", "n"], "(", 
         RowBox[{
          SuperscriptBox["H", 
           RowBox[{"(", "2", ")"}]], "-", 
          SuperscriptBox[
           SubscriptBox["E", "n"], 
           RowBox[{"(", "2", ")"}]]}], ")"}], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "1", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[CapitalPi]", "n"], "(", 
         RowBox[{
          SuperscriptBox["H", 
           RowBox[{"(", "1", ")"}]], "-", 
          SuperscriptBox[
           SubscriptBox["E", "n"], 
           RowBox[{"(", "1", ")"}]]}], ")"}], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "2", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", "3", ")"}]]}]},
         "BraKet"]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[CapitalPi]", "n"], 
        SuperscriptBox["H", 
         RowBox[{"(", "3", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        SubscriptBox["\[CapitalPi]", "n"], 
        SuperscriptBox["H", 
