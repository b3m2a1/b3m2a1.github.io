        SuperscriptBox["n", 
         RowBox[{"(", "k", ")"}]]}]},
     "BraKet"]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], 
      RowBox[{"k", "-", "1"}]], 
