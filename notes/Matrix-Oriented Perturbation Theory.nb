           {
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["Q", "y"], 
              SubscriptBox["Q", "z"], 
              SubscriptBox["Q", "x"]}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox[
               SubscriptBox["Q", "y"], "2"], 
              SubscriptBox["Q", "z"]}], ")"}], 
            RowBox[{"(", 
