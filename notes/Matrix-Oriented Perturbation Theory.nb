  3.821360616757785*^9}},ExpressionUUID->"1b617f18-c3c0-4198-b273-\
5c4c320960e0"],

Cell[TextData[{
 " Returning to the degenerate part of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "1", ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.821359656192683*^9, 3.82135966044949*^9}},
  ExpressionUUID->"16669f31-c1c0-4095-9ffd-91aa3a59f92c"],
 ", we write down what we had in the previous case"
}], "ExpositoryText",
 CellChangeTimes->{{3.821359662212983*^9, 3.821359680152032*^9}, {
  3.8213600490117073`*^9, 3.821360062213031*^9}, {3.8213606463671713`*^9, 
