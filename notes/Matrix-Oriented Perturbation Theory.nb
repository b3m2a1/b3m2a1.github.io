        UnderscriptBox["\[Sum]", "\[Beta]"], 
        RowBox[{
         SubsuperscriptBox[
          StyleBox["H",
           FontWeight->"Bold"], 
          RowBox[{"\[Beta]", "\[InvisibleSpace]", "n"}], 
          RowBox[{"(", "i", ")"}]], 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
             SubscriptBox["\[Delta]", 
              RowBox[{"\[Beta]", "\[VeryThinSpace]", "m"}]]}], ")"}], 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             SubscriptBox["\[Delta]", 
              RowBox[{"\[Beta]", "\[VeryThinSpace]", "n"}]]}], ")"}]}], 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["E", "\[Beta]"], "-", 
            SubscriptBox["E", "m"]}], ")"}]]}]}], "-", 
       FractionBox[
        RowBox[{
         SubsuperscriptBox[
          StyleBox["H",
           FontWeight->"Bold"], 
          RowBox[{"\[Beta]", "\[InvisibleSpace]", "n"}], 
          RowBox[{"(", "i", ")"}]], "(", 
         RowBox[{"1", "-", 
          SubscriptBox["\[Delta]", 
           RowBox[{"\[Beta]", "\[VeryThinSpace]", "n"}]]}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["E", "n"], "-", 
          SubscriptBox["E", "m"]}], ")"}]]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        UnderscriptBox["\[Sum]", "\[Beta]"], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["E", "\[Beta]"], "-", 
           SubscriptBox["E", "n"]}], ")"}], 
         SubsuperscriptBox[
          StyleBox["H",
           FontWeight->"Bold"], 
          RowBox[{"\[Beta]", "\[InvisibleSpace]", "n"}], 
          RowBox[{"(", "i", ")"}]], 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
             SubscriptBox["\[Delta]", 
              RowBox[{"\[Beta]", "\[VeryThinSpace]", "m"}]]}], ")"}], 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             SubscriptBox["\[Delta]", 
              RowBox[{"\[Beta]", "\[VeryThinSpace]", "n"}]]}], ")"}]}], 
