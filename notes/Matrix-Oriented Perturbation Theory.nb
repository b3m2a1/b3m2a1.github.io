c2848313737e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["A", 
    RowBox[{"n", "\[LeftRightArrow]", "m"}]], "=", 
   SubscriptBox["A", 
    RowBox[{"T", "(", 
     RowBox[{"1", ",", " ", "2", ",", " ", "\[Ellipsis]", ",", " ", 
      RowBox[{"m", "-", "1"}], ",", " ", "n", ",", " ", 
      RowBox[{"m", "+", "1"}], ",", " ", "\[Ellipsis]", ",", " ", 
      RowBox[{"n", "-", "1"}], ",", " ", "m", ",", " ", 
      RowBox[{"n", "+", "1"}], ",", " ", "\[Ellipsis]", ",", " ", "N"}], 
     ")"}]]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.79278375800988*^9, 3.7927838104328203`*^9}, {
