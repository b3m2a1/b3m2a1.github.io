Cell["We can then write this term out as", "ExpositoryText",
 InitializationCell->True,
 CellChangeTimes->{{3.813533788338031*^9, 3.813533810130001*^9}, {
  3.813533849779953*^9, 3.8135339109718513`*^9}, {3.813533946195261*^9, 
  3.813533958946566*^9}, {3.813533997906065*^9, 3.8135340237885513`*^9}, {
  3.813534054394307*^9, 3.8135340710267344`*^9}, {3.8135341981198177`*^9, 
  3.813534226081732*^9}, {3.81353487606828*^9, 3.813534880019023*^9}, {
  3.813536018582724*^9, 3.813536114240919*^9}, {3.813536167147698*^9, 
  3.813536234711501*^9}},ExpressionUUID->"b55a0a35-9bbc-40b7-aaef-\
160744e8db57"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], 
    SubscriptBox[
     RowBox[{"p", "\[InvisibleSpace]"}], "i"], "\[InvisibleSpace]", 
    SubscriptBox[
     RowBox[{"Q", "\[InvisibleSpace]"}], "j"], "\[InvisibleSpace]", 
    SubscriptBox["p", "j"], "\[InvisibleSpace]", "\[CapitalPi]", "\[InvisibleSpace]\[VeryThinSpace]", 
    SubscriptBox["q", "j"], "\[InvisibleSpace]", 
    SubscriptBox[
     RowBox[{"q", "\[InvisibleSpace]"}], "j"], "\[InvisibleSpace]", 
    SubscriptBox["q", "i"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      SubscriptBox["d", "i"], "=", 
      RowBox[{"-", "1"}]}], "1"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       SubscriptBox["d", "j"], "=", 
       RowBox[{"-", "2"}]}], "2"], "\[VeryThinSpace]", 
     RowBox[{
      FractionBox[
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SubscriptBox["\[Delta]", 
          RowBox[{
           SubscriptBox["d", "i"], ",", 
           SubscriptBox["d", "j"], ",", "0"}]]}], ")"}], 
       RowBox[{
        RowBox[{
         SubscriptBox["d", "i"], "\[InvisibleSpace]", 
         SubscriptBox["\[Omega]", "i"]}], "+", 
        RowBox[{
         SubscriptBox["d", "j"], "\[InvisibleSpace]", 
         SubscriptBox["\[Omega]", "j"]}]}]], 
      RowBox[{
       SubscriptBox["\[Rho]", 
        RowBox[{"\[InvisibleSpace]", 
         RowBox[{"Q", "\[InvisibleSpace]", "p"}]}]], "(", 
       RowBox[{
        RowBox[{
         RowBox[{
          SubscriptBox["n", "j"], "+", 
          SubscriptBox["d", "j"]}], " ", ";", " ", 
         RowBox[{"-", 
          SubscriptBox["d", "j"]}]}], ",", " ", "2"}], ")"}], 
      RowBox[{
       SubscriptBox["\[Rho]", 
        StyleBox["qq",
         FontSlant->"Italic"]], "(", 
       RowBox[{
        RowBox[{
         SubscriptBox["n", "j"], " ", ";", " ", 
         SubscriptBox["d", "j"]}], ",", " ", "2"}], ")"}], 
      RowBox[{
       SubscriptBox["\[Rho]", 
        RowBox[{"\[InvisibleSpace]\[InvisibleSpace]", "p"}]], "(", 
       RowBox[{
        RowBox[{
         RowBox[{
          SubscriptBox["n", "i"], "+", 
          SubscriptBox["d", "i"]}], " ", ";", " ", 
         RowBox[{"-", 
          SubscriptBox["d", "i"]}]}], ",", " ", "1"}], ")"}], 
      RowBox[{
       SubscriptBox["\[Rho]", 
        StyleBox["q",
         FontSlant->"Italic"]], "(", 
       RowBox[{
        RowBox[{
         SubscriptBox["n", "i"], " ", ";", " ", 
         SubscriptBox["d", "i"]}], ",", " ", "1"}], ")"}]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.81353400504825*^9, 3.813534183993164*^9}, {
  3.813534293788464*^9, 3.813534301080258*^9}, {3.8135343394933167`*^9, 
  3.813534434322995*^9}, {3.8135346463027287`*^9, 3.813534659309725*^9}, {
  3.81353475485942*^9, 3.8135347953422117`*^9}, {3.813534843009605*^9, 
  3.813534848346739*^9}, {3.813535033172475*^9, 3.8135350935776567`*^9}, {
  3.813535385134471*^9, 3.8135354695754213`*^9}, {3.8135359647553577`*^9, 
  3.81353601163146*^9}, {3.8135361261765413`*^9, 3.813536165120452*^9}, {
  3.8135363208542233`*^9, 3.813536368539447*^9}, {3.8135364166823063`*^9, 
  3.813536442310855*^9}, {3.8135364790619*^9, 3.813536490810783*^9}, {
  3.813536525907126*^9, 
  3.813536570522444*^9}},ExpressionUUID->"18e1b5e4-dcb5-4bf0-8e6a-\
573be22c4e7a"],

Cell[TextData[{
 "what if we wanted to toss in an extra term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["q", "k"], "\[InvisibleSpace]", 
    SubscriptBox["q", "k"]}], TraditionalForm]],ExpressionUUID->
  "8d5757be-1dab-4cea-b2d8-4a10bf933c78"],
 " term (separated by a perturbation operator)? By our recursive formulation \
we\[CloseCurlyQuote]ll say"
}], "ExpositoryText",
 CellChangeTimes->{{3.813536629411643*^9, 3.813536807050736*^9}, {
  3.813536838920815*^9, 
  3.8135368408245907`*^9}},ExpressionUUID->"1a362a94-a9b3-4027-9de1-\
e9f599e42e6b"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{"B", "=", 
      RowBox[{
       SubscriptBox[
        RowBox[{"p", "\[InvisibleSpace]"}], "i"], "\[InvisibleSpace]", 
       SubscriptBox[
        RowBox[{"Q", "\[InvisibleSpace]"}], "j"], "\[InvisibleSpace]", 
       SubscriptBox["p", "j"], "\[InvisibleSpace]", "\[CapitalPi]", "\[InvisibleSpace]\[VeryThinSpace]", 
       SubscriptBox["q", "j"], "\[InvisibleSpace]", 
       SubscriptBox[
        RowBox[{"q", "\[InvisibleSpace]"}], "j"], "\[InvisibleSpace]", 
       SubscriptBox["q", "i"]}]}]},
    {
     RowBox[{
      SuperscriptBox["\[CapitalDelta]", "B"], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["\[CapitalDelta]", "i", "B"], "=", "2"}], ",", " ", 
        RowBox[{
         SubsuperscriptBox["\[CapitalDelta]", "j", "B"], "=", "4"}]}], 
       "}"}]}]},
    {
     RowBox[{
      SuperscriptBox["\[CapitalDelta]", "A"], "=", 
      RowBox[{"{", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]", "k", "A"], "=", "2"}], "}"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 InitializationCell->True,
 CellChangeTimes->{{3.813536846469997*^9, 3.813536859385969*^9}, {
  3.8135368969012012`*^9, 3.813536906595847*^9}, {3.8135370328284063`*^9, 
  3.813537076617446*^9}},ExpressionUUID->"4807429e-bc5d-4a1c-97e2-\
c4a5e5cb0640"],

Cell["and", "ExpositoryText",
 CellChangeTimes->{{3.813536853344302*^9, 3.813536855439365*^9}, {
  3.813536910665338*^9, 3.813536911485787*^9}, {3.813537153945098*^9, 
