Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["QQQ", 
    RowBox[{"n", "\[VeryThinSpace]", "m"}]], " ", "=", " ", 
   RowBox[{
    TemplateBox[{
      SubscriptBox["n", "x"]},
     "Bra"], 
    TemplateBox[{
      SubscriptBox["n", "y"]},
     "Bra"], 
    RowBox[{
     TemplateBox[{
       SubscriptBox["n", "z"]},
      "Bra"], "(", GridBox[{
       {
        RowBox[{"(", GridBox[{
           {
            RowBox[{"(", 
             SuperscriptBox[
              SubscriptBox["Q", "x"], "3"], ")"}], 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox[
               SubscriptBox["Q", "x"], "2"], 
              SubscriptBox["Q", "y"]}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox[
               SubscriptBox["Q", "x"], "2"], 
              SubscriptBox["Q", "z"]}], ")"}]},
           {
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox[
               SubscriptBox["Q", "x"], "2"], 
              SubscriptBox["Q", "y"]}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["Q", "x"], 
              SuperscriptBox[
               SubscriptBox["Q", "y"], "2"]}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["Q", "x"], 
              SubscriptBox["Q", "y"], 
              SubscriptBox["Q", "z"]}], ")"}]},
           {
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox[
               SubscriptBox["Q", "x"], "2"], 
              SubscriptBox["Q", "z"]}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["Q", "x"], 
              SubscriptBox["Q", "z"], 
              SubscriptBox["Q", "y"]}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["Q", "x"], 
              SuperscriptBox[
               SubscriptBox["Q", "z"], "2"]}], ")"}]}
          },
          GridBoxAlignment->{"Columns" -> {{Center}}}], ")"}]},
       {
        RowBox[{"(", GridBox[{
           {
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox[
               SubscriptBox["Q", "x"], "2"], 
              SubscriptBox["Q", "y"]}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["Q", "x"], 
              SuperscriptBox[
               SubscriptBox["Q", "y"], "2"]}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["Q", "y"], 
              SubscriptBox["Q", "x"], 
              SubscriptBox["Q", "z"]}], ")"}]},
           {
