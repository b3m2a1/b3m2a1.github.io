Cell[TextData[{
 "Which correspond to the permutations of terms like ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
        SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
        SuperscriptBox["i", "+"]}], "..."}], "\[InvisibleSpace]", 
      SuperscriptBox["i", "+"], 
      SubscriptBox["\[CapitalPi]", "n"], 
      SuperscriptBox["i", "-"], "\[InvisibleSpace]", 
      SuperscriptBox["i", "-"], "\[InvisibleSpace]", 
      SuperscriptBox["i", "-"]}], "\[InvisibleSpace]", "..."}], 
    SuperscriptBox["i", "-"], "\[InvisibleSpace]"}], TraditionalForm]],
  CellChangeTimes->{{3.8894917186541357`*^9, 3.889491833064045*^9}},
  ExpressionUUID->"ca961b2f-d153-4ae7-8c84-a2bd0ebd1a72"],
 ", which, from this, we ",
 StyleBox["don\[CloseCurlyQuote]t need to evaluate explicitly",
  FontSlant->"Italic"],
 ". Instead we can simply enumerate all of the different ",
 StyleBox["energy changes",
  FontSlant->"Italic"],
 " possible from having 9 operations ",
 StyleBox["before",
  FontSlant->"Italic"],
 " the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPi]", "n"], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "feec2476-48c2-4c3e-a0d9-311cf2207fbb"],
 " and 5 operations afterwards, with energies of 7, 5, 3, 1, -1, and -3, each \
of which gets its own polynomial (from what we did before)"
}], "ExpositoryText",
 CellChangeTimes->{{3.889491691143277*^9, 3.8894917141234713`*^9}, {
   3.889491837747381*^9, 3.889491890319468*^9}, {3.889492179526651*^9, 
   3.8894922352030563`*^9}, 3.8894923135342627`*^9, {3.889493137065551*^9, 
   3.889493166277787*^9}, {3.889493430224677*^9, 
   3.889493448770721*^9}},ExpressionUUID->"9d5bb7dc-c421-4e23-91dc-\
886d4f39f6f2"],

Cell["Then when we decompose terms like", "ExpositoryText",
 CellChangeTimes->{{3.8894973009640083`*^9, 3.889497305039703*^9}, {
  3.889497389061576*^9, 
  3.88949739254947*^9}},ExpressionUUID->"99a8cf7d-cdae-44a6-b266-\
925c62be5438"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], " ", 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], "A", "\[VeryThinSpace]\[AlignmentMarker]", 
        SubscriptBox["\[CapitalPi]", "m"], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]]}], "+", 
       RowBox[{
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], "A"}], "\[VeryThinSpace]", "+", 
       RowBox[{"A", "\[VeryThinSpace]", 
        SubscriptBox["\[CapitalPi]", "m"], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", "m"], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        TemplateBox[{
          SuperscriptBox["m", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}], " ", "="}]},
    {
     RowBox[{"\[AlignmentMarker]", 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{"\[Sigma]", "\[Element]", 
         RowBox[{"P", "(", "7", ")"}]}]], 
       RowBox[{"\[Sigma]", "(", 
        RowBox[{
         RowBox[{
         "x", "\[InvisibleSpace]", "y", "\[InvisibleSpace]\[InvisibleSpace]", 
          "z", "\[InvisibleSpace]", 
          SubscriptBox["\[CapitalPi]", "n"], 
          SuperscriptBox[
           RowBox[{"i", "\[InvisibleSpace]\[InvisibleSpace]"}], "+"], 
          "\[InvisibleSpace]", 
          SuperscriptBox[
           RowBox[{"i", "\[InvisibleSpace]"}], "-"], "\[InvisibleSpace]", 
          SuperscriptBox["j", "+"], "\[InvisibleSpace]", 
          SubscriptBox["\[CapitalPi]", "n"], 
          SuperscriptBox["j", "-"]}], "\[InvisibleSpace] ", "+", 
         " \[InvisibleSpace]", 
         RowBox[{
         "x", "\[InvisibleSpace]", "y", "\[InvisibleSpace]\[InvisibleSpace]", 
          "z", "\[InvisibleSpace]", 
          SubscriptBox["\[CapitalPi]", "n"], 
          SuperscriptBox[
           RowBox[{"i", "\[InvisibleSpace]\[InvisibleSpace]"}], "+"], 
          "\[InvisibleSpace]", 
          SubscriptBox["\[CapitalPi]", "m"], 
          SuperscriptBox[
           RowBox[{"i", "\[InvisibleSpace]"}], "-"], "\[InvisibleSpace]", 
          SuperscriptBox["j", "+"], "\[InvisibleSpace]", 
          SuperscriptBox["j", "-"]}], "\[InvisibleSpace] ", "+", " ", 
         RowBox[{"x", "\[VeryThinSpace]\[InvisibleSpace]", 
          SubscriptBox["\[CapitalPi]", "m"], "\[InvisibleSpace]", "y", "\[InvisibleSpace]\[InvisibleSpace]",
           "z", "\[InvisibleSpace]", 
          SuperscriptBox[
           RowBox[{"i", "\[InvisibleSpace]\[InvisibleSpace]"}], "+"], 
          "\[InvisibleSpace]", 
          SubscriptBox["\[CapitalPi]", "m"], 
          SuperscriptBox[
           RowBox[{"i", "\[InvisibleSpace]"}], "-"], "\[InvisibleSpace]", 
          SuperscriptBox["j", "+"], "\[InvisibleSpace]", 
          SuperscriptBox["j", "-"]}]}], "\[InvisibleSpace]", ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCenteredManuallyAligned",
 CellChangeTimes->{{3.889497360450592*^9, 3.889497459992709*^9}, {
  3.889497504724997*^9, 
  3.889497665488825*^9}},ExpressionUUID->"092f87c8-40e0-4111-bb24-\
5e4e72cb3519"],

Cell[TextData[{
 "we see the utility immediately, as if for instance ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["m", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.889497360450592*^9, 3.889497459992709*^9}, {
   3.889497504724997*^9, 3.889497665488825*^9}},ExpressionUUID->
  "417a65a7-27cd-456e-a136-dc35f4c25dbd"],
 " differs from ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Bra"], " "}]],
  CellChangeTimes->{{3.889497360450592*^9, 3.889497459992709*^9}, {
   3.889497504724997*^9, 3.889497665488825*^9}},ExpressionUUID->
  "3a86b2f0-1f51-46c9-a6cb-8bcff0051fb0"],
 "by one quantum in mode ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "5fb357d9-d47f-4fba-9ad7-8eaf091e4443"],
 ", all of the paths like ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
   SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
   SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
   SubscriptBox["\[CapitalPi]", "n"], 
   SuperscriptBox[
    RowBox[{"i", "\[InvisibleSpace]\[InvisibleSpace]"}], "+"], 
   "\[InvisibleSpace]", 
   SuperscriptBox[
    RowBox[{"i", "\[InvisibleSpace]"}], "-"], "\[InvisibleSpace]", 
   SuperscriptBox[
    RowBox[{"i", "\[InvisibleSpace]"}], "-"], "\[InvisibleSpace]", 
   SubscriptBox["\[CapitalPi]", "n"], "\[InvisibleSpace]", 
   SuperscriptBox[
    RowBox[{"i", "\[InvisibleSpace]"}], "-"]}]],
  CellChangeTimes->{{3.889497802574806*^9, 3.889497832884122*^9}},
  ExpressionUUID->"3c5d5cb3-8329-4453-8e78-4099725b4b3b"],
 " are possible and the polynomials are immediately enumerable by just \
considering the possible sets of energy changes"
}], "ExpositoryText",
 CellChangeTimes->{{3.8894977305252647`*^9, 3.88949779522167*^9}, {
  3.889497836351083*^9, 
  3.889497871888286*^9}},ExpressionUUID->"ab136582-7968-4492-a237-\
2847725c6415"],

Cell["We can formalize this algebraically, noting that [TODO]", \
"ExpositoryText",
 CellChangeTimes->{{3.889497895982469*^9, 3.8894979174659357`*^9}, {
  3.889500557703495*^9, 
  3.889500561555974*^9}},ExpressionUUID->"0f5aa3a4-a4b0-4d55-8636-\
c27bc1ccadf9"],

Cell["\<\
Also of interest, if we have two polynomials, corresponding to say this \
diagram\
\>", "ExpositoryText",
