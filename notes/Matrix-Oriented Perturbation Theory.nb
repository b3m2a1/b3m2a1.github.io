Cell[TextData[{
 "this becomes useful when we think about the common structure of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "(", 
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.8259395796339407`*^9, 3.8259396419595757`*^9}, {
   3.825939731205914*^9, 3.8259398902592287`*^9}},ExpressionUUID->
  "4cdb781f-7e0a-4695-a131-aed669718fa9"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "(", 
    SuperscriptBox["H", 
     RowBox[{"(", "2", ")"}]], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.8259395796339407`*^9, 3.8259396419595757`*^9}, {
   3.825939731205914*^9, 3.8259398902592287`*^9}},ExpressionUUID->
  "94f244a7-f027-4145-b644-498a00f34956"],
 ", which can be decomposed into the operation of a permutation on a set of \
equivalence classes of operators, e.g. usually we only have three distinct \
operations for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "(", 
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.8259395796339407`*^9, 3.8259396419595757`*^9}, {
   3.825939731205914*^9, 3.8259398902592287`*^9}},ExpressionUUID->
  "123b90ed-bb95-46c0-824b-dc7557efd71b"],
 " as something like"
}], "ExpositoryText",
 CellChangeTimes->{{3.825940056321344*^9, 3.8259401670558567`*^9}, {
  3.8259402690615177`*^9, 
  3.825940271076353*^9}},ExpressionUUID->"4604ca8e-f037-47d8-aa4d-\
cb81d80d5ffa"],

