            TemplateBox[{
              RowBox[{
                SuperscriptBox["n", 
                 RowBox[{"(", "0", ")"}]], " "}], 
              RowBox[{"\[VeryThinSpace] ", 
                SuperscriptBox["n", 
                 RowBox[{"(", "j", ")"}]]}]},
             "BraKet"]}]}], ")"}]}]}], "+", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], " "}], 
