   3.792787382500087*^9}, {3.79278765485069*^9, 
   3.79278773926513*^9}},ExpressionUUID->"e0a324ff-67f8-4980-adaf-\
bb273ae8ddad"],

Cell["Then recombining we have ", "Text",
 CellChangeTimes->{{3.792787865465869*^9, 
  3.792787871135229*^9}},ExpressionUUID->"f57cfb60-c6b8-4db3-9278-\
a51340a4259d"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[Del]", "X"], 
         RowBox[{"(", 
          RowBox[{"A", "\[CircleDot]", "B"}], ")"}]}], 
        StyleBox[")",
         FontSlant->"Plain"]}], 
       RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]], 
      StyleBox["=",
       FontSlant->"Plain"], 
      RowBox[{
       SubscriptBox[
        RowBox[{
         StyleBox["(",
          FontSlant->"Plain"], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Del]", "X"], "A"}], ")"}], "\[CircleDot]", "B"}], 
         ")"}], 
        RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]], 
       StyleBox["+",
        FontSlant->"Plain"], 
       SubscriptBox[
        RowBox[{
         StyleBox["(",
          FontSlant->"Plain"], 
         SubscriptBox[
          RowBox[{"(", 
           RowBox[{"A", "\[CircleDot]", 
            SubscriptBox[
             RowBox[{"(", 
              RowBox[{
               SubscriptBox["\[Del]", "X"], "B"}], ")"}], 
             RowBox[{"2", "\[Rule]", "1"}]]}], ")"}], 
          RowBox[{"2", "\[Rule]", "1"}]], ")"}], 
        RowBox[{
        "i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"n", "=", "1"}], "N"], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           FractionBox["\[PartialD]", 
            RowBox[{"\[PartialD]", 
             SubscriptBox[
              StyleBox["x",
               FontSlant->"Italic"], "i"]}]], 
           SubscriptBox["A", 
            RowBox[{"j", "\[InvisibleSpace]", "n"}]]}], ")"}], 
         SubscriptBox["B", 
          RowBox[{"n", "\[InvisibleSpace]\[InvisibleSpace]", "k"}]]}]}], " ", 
       "+", " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"n", "=", "1"}], "N"], 
        RowBox[{
         RowBox[{"(", 
          SubscriptBox["A", 
           RowBox[{"j", "\[InvisibleSpace]", "n"}]], ")"}], 
         RowBox[{
          FractionBox["\[PartialD]", 
           RowBox[{"\[PartialD]", 
            SubscriptBox[
             StyleBox["x",
              FontSlant->"Italic"], "i"]}]], 
          SubscriptBox["B", 
           RowBox[{
           "n", "\[InvisibleSpace]\[InvisibleSpace]", "k"}]]}]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"n", "=", "1"}], "N"], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           FractionBox["\[PartialD]", 
            RowBox[{"\[PartialD]", 
             SubscriptBox["x", "i"]}]], 
           SubscriptBox["A", "jn"]}], ")"}], 
         SubscriptBox["B", "nk"]}]}], "+", 
       RowBox[{
        SubscriptBox["A", "jn"], "(", 
        RowBox[{
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
           SubscriptBox["x", "i"]}]], 
         SubscriptBox["B", "nk"]}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.792787882753684*^9, 
  3.792787914081164*^9}},ExpressionUUID->"52005bf6-8150-4b5d-bbd7-\
a51d3efc784f"],

