   RowBox[{
    SubsuperscriptBox["P", "a", "b"], "(", 
    RowBox[{"n", " ", "-", " ", 
     RowBox[{"(", 
      RowBox[{"a", "-", "b"}], ")"}]}], ")"}]}], 
