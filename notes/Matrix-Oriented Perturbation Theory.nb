Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "fgC", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fgC", "[", 
    RowBox[{"b_", ",", " ", "0"}], "]"}], ":=", "1"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fgC", "[", 
    RowBox[{"b_", ",", " ", "k_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"k", ">", "b"}], ",", " ", "\[IndentingNewLine]", "0", ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"fgC", "[", 
       RowBox[{"b", ",", " ", "k"}], "]"}], "=", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fgC", "[", 
        RowBox[{
         RowBox[{"b", "-", "1"}], ",", " ", "k"}], "]"}], "+", 
       "\[IndentingNewLine]", 
       RowBox[{"Sum", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"fgC", "[", 
           RowBox[{
            RowBox[{"b", "-", "1"}], ",", " ", "w"}], "]"}], "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"k", "-", "w", "+", "1"}], ")"}]}], 
          RowBox[{"(", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Pochhammer", "[", 
             RowBox[{
              RowBox[{"b", "-", "k"}], ",", " ", 
              RowBox[{"k", "-", "w"}]}], "]"}], "+", "\[IndentingNewLine]", 
            RowBox[{"2", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"-", "1"}], ")"}], "^", 
              RowBox[{"KroneckerDelta", "[", 
               RowBox[{"w", ",", " ", 
                RowBox[{"k", "-", "1"}]}], "]"}]}], 
             RowBox[{"(", 
              RowBox[{"k", "-", "1"}], ")"}], 
             RowBox[{"Pochhammer", "[", 
              RowBox[{
               RowBox[{"b", "-", "k", "+", "1"}], ",", " ", 
               RowBox[{"k", "-", "w", "-", "1"}]}], "]"}]}]}], 
           "\[IndentingNewLine]", ")"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"w", ",", " ", "0", ",", " ", 
           RowBox[{"k", "-", "1"}]}], "}"}]}], "\[IndentingNewLine]", 
        "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fgCvec", "[", "b_", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Table", "[", 
