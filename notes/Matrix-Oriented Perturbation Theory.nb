Cell[CellGroupData[{

Cell["Fourth Order Energy", "Subsubsubsection",
 CellChangeTimes->{{3.8120655869194508`*^9, 3.812065591667902*^9}, {
  3.813539323656389*^9, 
  3.813539324785659*^9}},ExpressionUUID->"bc177180-bdad-4c5e-b12a-\
6246ae09ee79"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox[
       SubscriptBox["E", "n"], 
       RowBox[{"(", "k", ")"}]], "=", 
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], " ", 
        SuperscriptBox["H", 
         RowBox[{"(", "4", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], " ", 
        SuperscriptBox["H", 
         RowBox[{"(", "3", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "1", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], " ", 
        SuperscriptBox["H", 
         RowBox[{"(", "2", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "2", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], " ", 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "3", ")"}]]},
         "Ket"]}], "-", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["E", "n"], 
         RowBox[{"(", "2", ")"}]], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", "2", ")"}]]}]},
         "BraKet"]}], "-", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["E", "n"], 
         RowBox[{"(", "1", ")"}]], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", "3", ")"}]]}]},
         "BraKet"]}]}]}]},
    {
     RowBox[{
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "2", ")"}]]},
       "Ket"], "=", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[CapitalPi]", "n"], 
        SuperscriptBox["H", 
         RowBox[{"(", "2", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        SubscriptBox["\[CapitalPi]", "n"], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], "-", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["E", "n"], 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], "-", 
       RowBox[{
        FractionBox["1", "2"], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "1", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", "1", ")"}]]}]},
         "BraKet"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}]}]},
    {
     RowBox[{
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "3", ")"}]]},
       "Ket"], "=", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[CapitalPi]", "n"], 
        SuperscriptBox["H", 
         RowBox[{"(", "3", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        SubscriptBox["\[CapitalPi]", "n"], 
        SuperscriptBox["H", 
         RowBox[{"(", "2", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "1", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        SubscriptBox["\[CapitalPi]", "n"], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "2", ")"}]]},
         "Ket"]}], "-", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["E", "n"], 
         RowBox[{"(", "2", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "1", ")"}]]},
         "Ket"]}], "-", 
       RowBox[{
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "1", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", "2", ")"}]]}]},
         "BraKet"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8120655927676477`*^9, 3.8120656701309958`*^9}, {
   3.812065700795308*^9, 3.812065717459035*^9}, {3.812066512456605*^9, 
   3.812066517428557*^9}, {3.812066665841179*^9, 3.812066761265275*^9}, {
   3.812066866663168*^9, 3.81206688755649*^9}, {3.8120669218495617`*^9, 
   3.8120669286399803`*^9}, 3.8120669808075857`*^9, {3.812067035760232*^9, 
   3.812067067154727*^9}, 3.813539386980822*^9, {3.813539761089243*^9, 
   3.8135397667471437`*^9}},ExpressionUUID->"b650f1b3-232a-496f-a56c-\
069b47022888"]
}, Open  ]]
