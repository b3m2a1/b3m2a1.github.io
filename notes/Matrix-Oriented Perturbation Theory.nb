  3.8064117159529877`*^9, 
  3.806411717991864*^9}},ExpressionUUID->"550d7bb0-adde-419e-b7a2-\
eb6cf3776096"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["H", 
     RowBox[{"(", "0", ")"}]], 
    SuperscriptBox[
     TemplateBox[{"n"},
      "Ket"], 
     RowBox[{"(", "0", ")"}]]}], "=", 
