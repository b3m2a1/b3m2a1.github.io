    TemplateBox[{
      SuperscriptBox["m", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], TraditionalForm]],
  CellChangeTimes->{{3.827894308031608*^9, 3.827894318522044*^9}},
  ExpressionUUID->"ad4ade50-5dde-4b62-8aaa-dbeb96ad7723"],
 ", which gives us"
}], "ExpositoryText",
