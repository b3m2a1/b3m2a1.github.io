Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", 
        SuperscriptBox["D", 
         RowBox[{"(", "a", ")"}]]], 
       SuperscriptBox["\[CapitalDelta]H", 
        RowBox[{"(", 
         RowBox[{"a", "+", "1"}], ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Ket"]}], "=", 
