Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["P", "D"], "(", 
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", "3", ")"}]], "+", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]], 
