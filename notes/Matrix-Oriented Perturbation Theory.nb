Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HoldPattern", "[", 
    RowBox[{"getPossibleZeroContrib", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a3_", ",", "b3_"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"a2_", ",", "b2_"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"a1_", ",", "b1_"}], "}"}]}], "}"}], "]"}], "]"}], 
   "\[RuleDelayed]", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"polySqrtGen", "[", 
       RowBox[{"a3", ",", "b3"}], "]"}], "/.", "\[VeryThinSpace]", 
      RowBox[{"\[FormalN]", "\[Rule]", 
       RowBox[{"\[FormalN]", "+", 
        RowBox[{"(", 
         RowBox[{"a1", "+", "a2"}], ")"}], "-", 
        RowBox[{"(", 
         RowBox[{"b1", "+", "b2"}], ")"}]}]}]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"polySqrtGen", "[", 
       RowBox[{"a2", ",", "b2"}], "]"}], "/.", "\[VeryThinSpace]", 
      RowBox[{"\[FormalN]", "\[Rule]", 
       RowBox[{"\[FormalN]", "+", 
        RowBox[{"(", 
         RowBox[{"a1", "-", "b1"}], ")"}]}]}]}], ")"}], " ", 
    RowBox[{"polySqrtGen", "[", 
     RowBox[{"a1", ",", "b1"}], "]"}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.889814678889531*^9},
 CellLabel->
  "Out[1607]=",ExpressionUUID->"b0fb5e8c-ddfc-4b00-9992-dfbde32dfcea"]
}, Open  ]],

