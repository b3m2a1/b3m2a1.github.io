        SuperscriptBox["D", 
         RowBox[{"(", 
          RowBox[{"a", "-", "1"}], ")"}]]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], 
         RowBox[{"k", "+", "a"}]], 
        RowBox[{
         SuperscriptBox["\[CapitalDelta]H", 
          RowBox[{"(", 
           RowBox[{"k", "+", "a", "-", "i"}], ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
