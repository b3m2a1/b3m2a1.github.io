Cell[CellGroupData[{

Cell["Mixed Derivatives", "Subsection",
 CellChangeTimes->{{3.806072664046788*^9, 
  3.8060726672388067`*^9}},ExpressionUUID->"58cd010f-0bdf-42c3-ae93-\
35e1f5597663"],

Cell[TextData[{
 "We don\[CloseCurlyQuote]t actually start out with stuff like ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox[
      StyleBox["X",
       FontSlant->"Plain"], "4"]], 
    StyleBox["V",
     FontSlant->"Plain"]}], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"dd8aad2e-6d11-4bd0-baf6-9b7e4ccd0f7c"],
 ", instead having things like ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["q", "2"]], 
    RowBox[{
     SubscriptBox["\[Del]", 
      SuperscriptBox["x", "2"]], 
     StyleBox["V",
      FontSlant->"Plain"]}]}], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"c0e79aff-185d-459c-923a-a3797b034cb1"],
 ", and we need to account for that in the derivs. This will enter only in \
the cubic and quartic force terms, giving us stuff like"
}], "ExpositoryText",
 CellChangeTimes->{{3.8060726688008337`*^9, 3.806072721541744*^9}, {
  3.806073806925363*^9, 
  3.806073873261095*^9}},ExpressionUUID->"c8dc2498-7799-4a33-9081-\
810d4bcdb10d"],

