           RowBox[{"m", ",", " ", "n"}], "}"}], "]"}], "]"}], "+", "3"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"groups", "=", "\[IndentingNewLine]", 
       RowBox[{"GroupBy", "[", 
        RowBox[{
         RowBox[{"Transpose", "@", 
