Cell["\<\
Can we get this for different states? From induction, we can say\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8274119440922623`*^9, 3.827411988663616*^9}, {
  3.827693525309952*^9, 3.827693534895002*^9}, {3.827697229894134*^9, 
  3.8276972360728617`*^9}, {3.827697345143279*^9, 
