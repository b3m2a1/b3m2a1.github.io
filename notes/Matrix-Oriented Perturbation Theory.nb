Cell[CellGroupData[{

Cell[TextData[{
 "Intuitive Understanding of ",
 Cell[BoxData[
  FormBox["S", TraditionalForm]],ExpressionUUID->
  "f8ebf9af-b686-4caa-b92f-c3b45648e1a3"],
 "-products"
}], "Subsubsection",
 CellChangeTimes->{{3.890146124103447*^9, 
  3.890146136302458*^9}},ExpressionUUID->"c6f36643-6631-4894-a96f-\
6d890df4f250"],

Cell["We really just need to modify our sequence ", "ExpositoryText",
 CellChangeTimes->{{3.8901461376329107`*^9, 
  3.8901461466987867`*^9}},ExpressionUUID->"ba5fc337-e3f8-4e38-8550-\
f88d456015c2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      SubsuperscriptBox["S", 
       SubscriptBox["b", "1"], 
       SubscriptBox["a", "1"]], "\[InvisibleSpace]", "(", "n", ")"}], 
     RowBox[{
      SubsuperscriptBox["S", 
       SubscriptBox["b", "2"], 
       SubscriptBox["a", "2"]], "\[InvisibleSpace]", "(", 
      RowBox[{"n", "+", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["a", "1"], "-", 
         SubscriptBox["b", "2"]}], ")"}]}], ")"}]}], "..."}], 
   RowBox[{
    SubsuperscriptBox["S", 
     SubscriptBox["b", "N"], 
     SubscriptBox["a", "N"]], "\[InvisibleSpace]", "(", 
    RowBox[{"n", "+", "k", "-", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["a", "N"], "-", 
       SubscriptBox["b", "N"]}], ")"}]}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.89014615021532*^9, 
  3.8901461508324003`*^9}},ExpressionUUID->"93f9c4f3-be3e-477c-9cca-\
abda5a459494"],

Cell[TextData[{
 "to split it up each time the direction ",
 StyleBox["turns",
  FontSlant->"Italic"],
 " as every change from going down to going up will contribute a product of \
terms like ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"n", "+", 
     SubscriptBox["k", "M"]}], ")"}], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "3984e8c9-3971-4f6e-9dbe-885b1442a2a2"],
 " and vice versa"
}], "ExpositoryText",
 InitializationCell->True,
 CellChangeTimes->{{3.890146346908999*^9, 
  3.890146426868827*^9}},ExpressionUUID->"ec727282-87c4-4e49-9899-\
79e17b0ecb33"],

Cell[TextData[{
 "We should also note that if we are coupling ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "918fb6a3-a3f8-4fbe-bd4a-c33ba3291703"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "+", "k"}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "d970f547-e33c-41f4-b6ef-3f9b635ac942"],
 ", we can decompose the total ",
 Cell[BoxData[
  FormBox["S", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "c28a6303-861e-4e57-a9d5-d3de974c4a5c"],
 " product into a form like (assuming ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", ">", "0"}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "edfc884e-a3c1-4234-8b58-72e80acd4cae"],
 ")"
}], "ExpositoryText",
 CellChangeTimes->{{3.920375488288698*^9, 
  3.920375534903926*^9}},ExpressionUUID->"661863a0-6e0e-4dcb-b333-\
8018e57fce0b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["S", "0", "k"], "(", "n", ")"}], 
   RowBox[{
    UnderscriptBox["\[Product]", 
     RowBox[{"i", ",", "p"}]], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"n", "+", "i"}], ")"}], "p"]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.920375506384411*^9, 3.920375508038052*^9}, {
  3.920375549207213*^9, 
  3.9203755900712223`*^9}},ExpressionUUID->"dc02e3e3-beb3-4c83-9031-\
7b484c568e35"],

Cell[TextData[{
 "for some sequence of ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "b526b742-79c9-47f4-bbcf-0db17ea4ba55"],
 " and ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "d3790ef8-2306-4a08-b9ad-54cdf86036f8"]
}], "ExpositoryText",
 CellChangeTimes->{{3.920375595386837*^9, 
  3.920375600755849*^9}},ExpressionUUID->"7fec117f-dbb1-48b4-b658-\
554fcf3a2154"],

Cell[TextData[{
 "If we were to add up all of the possible paths, the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"n", "+", "i"}], ")"}], "p"], TraditionalForm]],
  CellChangeTimes->{{3.920375506384411*^9, 3.920375508038052*^9}, {
   3.920375549207213*^9, 3.9203755900712223`*^9}},ExpressionUUID->
  "c7ceafdb-34f8-493e-b41a-43f011d5d299"],
 " terms would revert to the basic ",
 Cell[BoxData[
  FormBox["K", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "6c5c7c52-38e5-43d6-b0aa-c0b0bc1e30fe"],
 "-function form but"
}], "ExpositoryText",
 CellChangeTimes->{{3.920375613768331*^9, 
  3.9203756953712053`*^9}},ExpressionUUID->"d7b08905-ec28-462d-93f9-\
2cc0ed302e7a"],

