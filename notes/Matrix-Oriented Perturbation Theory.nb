     RowBox[{"{", 
      RowBox[{"p", ",", " ", "pos"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"inertDeriv", "[", "pos_", "]"}], ":=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"2", "*", 
       RowBox[{"p", ".", 
        RowBox[{"Outer", "[", 
         RowBox[{"Times", ",", " ", 
