         RowBox[{"(", 
          RowBox[{"a", "-", "i", "+", "1"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"a", "-", "i", "+", 
           RowBox[{"2", "\[InvisibleSpace]", "n"}]}], ")"}], 
         RowBox[{"(", 
          RowBox[{"a", "-", "i", "+", "n", "-", "1"}], ")"}]}]}], " ", "+", 
       " ", 
       SubsuperscriptBox["P", "2", "2"]}]}]},
    {
     RowBox[{
      SubsuperscriptBox["P", "2", "2"], " ", "=", " ", 
