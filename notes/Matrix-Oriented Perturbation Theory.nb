Cell[TextData[{
 "and then to get the true first-order wave function correction in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "n"], TraditionalForm]],ExpressionUUID->
  "d5ab1f09-3874-40c2-94f1-1af96cf7ba57"],
 " we apply the perturbation operator"
}], "ExpositoryText",
 CellChangeTimes->{{3.821643216676811*^9, 3.821643230811413*^9}, {
  3.8216433066183777`*^9, 
  3.821643322503533*^9}},ExpressionUUID->"6e9a19fb-b516-4858-a5c1-\
556fb8931532"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"$ptData", "[", 
    RowBox[{"[", 
     RowBox[{"\"\<n\>\"", ",", " ", "2"}], "]"}], "]"}], "=", 
   RowBox[{"Dot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[CapitalPi]", "[", "$ptData", "]"}], "[", 
      RowBox[{
       RowBox[{"\[ScriptCapitalT]\[ScriptN]", "[", "$ptData", "]"}], ",", " ",
        "0"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"\[CapitalDelta]n", "[", "$ptData", "]"}], "[", 
      RowBox[{
       RowBox[{"\[ScriptCapitalT]", "[", "$ptData", "]"}], ",", " ", "1", ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "@", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"figStyleText", "[", "\"\<\!\(\*TemplateBox[{
SuperscriptBox[
StyleBox[\"n\", FontSlant -> \"Italic\"], 
RowBox[{\"(\", \"1\", \")\"}]]},\"Ket\"]\)\>\"", "]"}], ",", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"figStyleText", "@", "\"\<=\>\""}], ",", "\[IndentingNewLine]", 
     RowBox[{"pertPlot", "[", 
      RowBox[{"Transpose", "@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Phi]", "[", "$ptData", "]"}], "[", "1", "]"}], "}"}]}], 
      "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"figStyleText", "@", "\"\<=\>\""}], ",", "\[IndentingNewLine]", 
     RowBox[{"pertPlot", "[", 
      RowBox[{
       RowBox[{"\[CapitalPi]", "[", "$ptData", "]"}], "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalT]\[ScriptN]", "[", "$ptData", "]"}], ",", 
        " ", "0"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"pertPlot", "[", 
      RowBox[{"Transpose", "@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[CapitalDelta]n", "[", "$ptData", "]"}], "[", 
         RowBox[{
          RowBox[{"\[ScriptCapitalT]", "[", "$ptData", "]"}], ",", " ", "1", 
          ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1"}], "}"}]}], "]"}], "}"}]}], "]"}]}], 
    "\[IndentingNewLine]", "}"}], "\[IndentingNewLine]", "}"}]}]}], "Input",
