  ExpressionUUID->"70757708-d7a0-4f30-b575-b0992c8f86fa"],
 " which allows the error in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["E", 
    RowBox[{"(", 
     RowBox[{"k", "+", "a"}], ")"}]], TraditionalForm]],ExpressionUUID->
  "8bc51d4e-d8af-4d77-8f02-fd7bbd5c724d"],
 " to propagate, being bounded like"
}], "ExpositoryText",
 CellChangeTimes->{{3.826719366992774*^9, 
  3.826719464516553*^9}},ExpressionUUID->"5f57ebf8-39d2-488d-8ad0-\
107a9acc994d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"err", "(", 
     RowBox[{
      SubsuperscriptBox["P", "V", 
       RowBox[{"(", "a", ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "k", ")"}]]},
       "Ket"]}], ")"}], "\[LessEqual]", 
    RowBox[{
     RowBox[{"err", "(", 
      SuperscriptBox["E", 
       RowBox[{"(", 
        RowBox[{"k", "+", "a"}], ")"}]], ")"}], 
