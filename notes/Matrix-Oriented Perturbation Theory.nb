      RowBox[{"i", "\[InvisibleSpace]", "j"}]], 
     FractionBox[
      RowBox[{"\[PartialD]", "g"}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["Q", "i"]}]], 
