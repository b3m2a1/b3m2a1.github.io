          "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
        GridBoxItemSize->{
         "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}},
           "RowsIndexed" -> {}},
        GridBoxSpacings->{"Columns" -> {
            Offset[0.27999999999999997`], {
             Offset[0.35]}, 
            Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, 
          "Rows" -> {
            Offset[0.2], {
             Offset[0.4]}, 
            Offset[0.2]}, "RowsIndexed" -> {}}],
       "Piecewise",
       DeleteWithContents->True,
       Editable->False,
       SelectWithContents->True,
       Selectable->False,
       StripWrapperBoxes->True]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826983462074048*^9, 3.826983586514908*^9}, {
  3.826983639232891*^9, 3.826983650863509*^9}, {3.826983718767823*^9, 
  3.8269837240754423`*^9}},ExpressionUUID->"5039d0ed-c197-48e8-92ce-\
78ba7a1d9dab"],

Cell[TextData[{
 "which is clearly possible to rewrite in block diagonal form over only the \
states ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      SuperscriptBox["i", 
       RowBox[{"\[VeryThinSpace]", 
         RowBox[{"(", "0", ")"}]}]]},
     "Ket"], ",", " ", 
    RowBox[{
     TemplateBox[{
       SuperscriptBox["j", 
        RowBox[{"\[VeryThinSpace]", 
          RowBox[{"(", "0", ")"}]}]]},
      "Ket"], "\[Element]", 
     SuperscriptBox["D", 
      RowBox[{"(", "\[Beta]", ")"}]]}]}], TraditionalForm]],
  CellChangeTimes->{{3.826983462074048*^9, 3.826983586514908*^9}, {
   3.826983639232891*^9, 3.826983650863509*^9}, {3.826983718767823*^9, 
   3.8269837240754423`*^9}},ExpressionUUID->
  "4b8eb534-0cc6-4aa9-9d1a-64bf01bab113"],
 ". This is relevant, because we assumed ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"], "\[Element]", 
    SuperscriptBox["D", 
     RowBox[{"(", "\[Beta]", ")"}]]}], TraditionalForm]],
  CellChangeTimes->{{3.826916052010932*^9, 3.8269160711669817`*^9}, {
   3.826916185485743*^9, 3.8269161973464937`*^9}, {3.826916248866921*^9, 
   3.826916325374021*^9}, {3.82691637185133*^9, 3.826916423923917*^9}, {
   3.826916485510365*^9, 3.8269165258696547`*^9}, {3.826916688357238*^9, 
   3.8269166915397243`*^9}, {3.826916746524897*^9, 3.826916754770892*^9}, {
   3.826980114555484*^9, 3.8269801156371593`*^9}, {3.826983596515585*^9, 
   3.826983606988861*^9}},ExpressionUUID->
  "50e2c842-0b7c-4fbd-8eab-fcb524469a93"],
 " and so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], " ", 
    SubsuperscriptBox["P", "D", 
     RowBox[{"(", "\[Beta]", ")"}]], 
    SuperscriptBox["\[ScriptCapitalH]", 
     RowBox[{"(", "\[Beta]", ")"}]], 
    SubsuperscriptBox["P", "D", 
     RowBox[{"(", "\[Beta]", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], TraditionalForm]],
  CellChangeTimes->{{3.826980227332789*^9, 3.826980261304994*^9}},
  ExpressionUUID->"9ec3cc85-6879-44a5-803b-8a2fd55c85ec"],
 " is a diagonal element of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["P", "D", 
     RowBox[{"(", "\[Beta]", ")"}]], 
    SuperscriptBox["\[ScriptCapitalH]", 
     RowBox[{"(", "\[Beta]", ")"}]], 
    SubsuperscriptBox["P", "D", 
     RowBox[{"(", "\[Beta]", ")"}]]}], TraditionalForm]],
  CellChangeTimes->{{3.826983462074048*^9, 3.826983586514908*^9}, {
   3.826983639232891*^9, 3.826983650863509*^9}, {3.826983718767823*^9, 
   3.8269837240754423`*^9}},ExpressionUUID->
  "4a123e54-3f16-4b37-90b4-4140783602ea"],
 "."
}], "ExpositoryText",
 CellChangeTimes->{{3.826984510561874*^9, 
  3.826984585305126*^9}},ExpressionUUID->"27331aba-9bad-4fa5-acfb-\
a8c288a021b9"],

Cell[TextData[{
 "Next, by Gerschgorin\[CloseCurlyQuote]s circle theorem, the eigenvalues of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["P", "D", 
     RowBox[{"(", "\[Beta]", ")"}]], 
    SuperscriptBox["\[ScriptCapitalH]", 
     RowBox[{"(", "\[Beta]", ")"}]], 
    SubsuperscriptBox["P", "D", 
     RowBox[{"(", "\[Beta]", ")"}]]}], TraditionalForm]],
  CellChangeTimes->{{3.826916052010932*^9, 3.8269160711669817`*^9}, {
   3.826916185485743*^9, 3.8269161973464937`*^9}, {3.826916248866921*^9, 
   3.826916325374021*^9}, {3.82691637185133*^9, 3.826916423923917*^9}, {
   3.826916485510365*^9, 3.8269165258696547`*^9}, {3.826916688357238*^9, 
   3.8269166915397243`*^9}, {3.826916746524897*^9, 3.826916754770892*^9}, {
   3.826980114555484*^9, 3.8269801156371593`*^9}, {3.826983596515585*^9, 
   3.826983606988861*^9}},ExpressionUUID->
  "1b25a7a9-58d9-4dd1-9cc6-cf6bd9b82b5b"],
 " are bounded by disks centered around the diagonal entries of the matrix. \
We have a Hermitian matrix, so instead we can write this as a union of \
intervals, i.e."
}], "ExpositoryText",
 CellChangeTimes->{{3.826983729448145*^9, 3.826983755514271*^9}, {
  3.826983815197792*^9, 3.8269838511326447`*^9}, {3.8269839054043417`*^9, 
  3.826983926501759*^9}, {3.826984217920885*^9, 3.826984248754822*^9}, {
  3.8269843054529057`*^9, 3.8269843323495617`*^9}, {3.826984575041472*^9, 
  3.826984575637968*^9}},ExpressionUUID->"547641ec-9cb1-4bbf-928e-\
8fb00dac6cdf"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["a", 
       RowBox[{"i", "\[InvisibleSpace]", "j"}]], "=", "\[AlignmentMarker]", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["i", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], 
       SubsuperscriptBox["P", "D", 
        RowBox[{"(", "\[Beta]", ")"}]], 
       SuperscriptBox["\[ScriptCapitalH]", 
        RowBox[{"(", "\[Beta]", ")"}]], 
       SubsuperscriptBox["P", "D", 
        RowBox[{"(", "\[Beta]", ")"}]], 
       TemplateBox[{
         SuperscriptBox["j", 
          RowBox[{"\[VeryThinSpace]", 
            RowBox[{"(", "0", ")"}]}]]},
        "Ket"]}]}]},
    {
     RowBox[{
      SubscriptBox["D", "i"], "=", "\[AlignmentMarker]", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{
         SubscriptBox["a", 
          RowBox[{"i", "\[InvisibleSpace]", "i"}]], "-", 
         RowBox[{
          UnderscriptBox["\[Sum]", 
           RowBox[{"j", "\[NotEqual]", "i"}]], "\[VeryThinSpace]", 
          RowBox[{"\[LeftBracketingBar]", 
           SubscriptBox["a", 
            RowBox[{"i", "\[VeryThinSpace]", "j"}]], 
           "\[RightBracketingBar]"}]}]}], ",", " ", 
        RowBox[{
         SubscriptBox["a", 
          RowBox[{"i", "\[InvisibleSpace]", "i"}]], "+", 
         RowBox[{
          UnderscriptBox["\[Sum]", 
           RowBox[{"j", "\[NotEqual]", "i"}]], "\[VeryThinSpace]", 
          RowBox[{"\[LeftBracketingBar]", 
           SubscriptBox["a", 
            RowBox[{"i", "\[VeryThinSpace]", "j"}]], 
           "\[RightBracketingBar]"}]}]}]}], "]"}]}]},
    {
     RowBox[{
      RowBox[{"\[CapitalLambda]", 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["P", "D", 
          RowBox[{"(", "\[Beta]", ")"}]], 
         SuperscriptBox["\[ScriptCapitalH]", 
          RowBox[{"(", "\[Beta]", ")"}]], 
         SubsuperscriptBox["P", "D", 
          RowBox[{"(", "\[Beta]", ")"}]]}], ")"}]}], "\[Subset]", 
      "\[AlignmentMarker]", 
      RowBox[{
       UnderscriptBox["\[Union]", "i"], " ", 
       SubscriptBox["D", "i"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCenteredManuallyAligned",
 CellChangeTimes->{{3.826983847045549*^9, 3.826983847052951*^9}, {
  3.826984221659423*^9, 3.826984303126821*^9}, {3.826984333981798*^9, 
  3.826984418353291*^9}, {3.8269845970012617`*^9, 3.826984691883712*^9}, {
  3.826984732804244*^9, 
  3.8269847658922977`*^9}},ExpressionUUID->"742d0b5e-ba52-42b6-9c67-\
b8f8a0980409"],

Cell[TextData[{
 "It actually goes further and says that if ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["D", "n"], TraditionalForm]],
  CellChangeTimes->{{3.826983847045549*^9, 3.826983847052951*^9}, {
   3.826984221659423*^9, 3.826984303126821*^9}, {3.826984333981798*^9, 
   3.826984418353291*^9}, {3.8269845970012617`*^9, 3.826984691883712*^9}},
  ExpressionUUID->"39197812-1003-492a-b8af-94ffb7d1f1f7"],
 " is disjoint from the remaining ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["D", "i"], TraditionalForm]],
  CellChangeTimes->{{3.826983847045549*^9, 3.826983847052951*^9}, {
   3.826984221659423*^9, 3.826984303126821*^9}, {3.826984333981798*^9, 
   3.826984418353291*^9}, {3.8269845970012617`*^9, 3.826984691883712*^9}, {
   3.826984732804244*^9, 3.8269847658922977`*^9}},ExpressionUUID->
  "c5542af5-54d2-492a-85e9-84ae2e96bceb"],
 " then ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["D", "n"], TraditionalForm]],
  CellChangeTimes->{{3.826983847045549*^9, 3.826983847052951*^9}, {
   3.826984221659423*^9, 3.826984303126821*^9}, {3.826984333981798*^9, 
   3.826984418353291*^9}, {3.8269845970012617`*^9, 3.826984691883712*^9}, {
   3.826984732804244*^9, 3.8269847658922977`*^9}},ExpressionUUID->
  "f10b9130-0152-48be-87a1-dd56f1e18782"],
 " contains only a single eigenvalue. Of course, we cannot assume that holds \
in general, but it is a cute thing to keep in mind as a way to cut down our \
error bounds even more."
}], "ExpositoryText",
 CellChangeTimes->{{3.826984705669363*^9, 3.826984725746519*^9}, {
  3.8269847721237717`*^9, 3.826984788332603*^9}, {3.826984917441988*^9, 
