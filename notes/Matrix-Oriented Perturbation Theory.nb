2612bfa5c22b"],

Cell["\<\
It could be helpful to be able to evaluate arbitrary products of the momenta, \
so to that end we\[CloseCurlyQuote]ll note that our recursion is\
\>", "ExpositoryText",
 CellChangeTimes->{{3.89125998635026*^9, 
  3.8912600265521393`*^9}},ExpressionUUID->"97a799cd-ad7d-46a3-b0e9-\
270695b9e707"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["Q", "b", "a"], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"n", "+", "a", "-", "b", "+", "1"}], ")"}], 
        SubsuperscriptBox["Q", 
         RowBox[{"b", "-", "1"}], "a"]}], " ", "-", " ", 
       SubsuperscriptBox["Q", "b", 
        RowBox[{"a", "-", "1"}]]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"n", "+", "a", "-", "b", "+", "1"}], ")"}], 
        SubsuperscriptBox["Q", 
         RowBox[{"b", "-", "1"}], "a"]}], " ", "-", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"n", "+", "a", "-", "b"}], ")"}], 
        SubsuperscriptBox["Q", 
         RowBox[{"b", "-", "1"}], 
         RowBox[{"a", "-", "1"}]]}], " ", "+", " ", 
       SubsuperscriptBox["Q", "b", 
        RowBox[{"a", "-", "2"}]]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "a"], " ", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"a", "-", "i"}], ")"}]], 
        RowBox[{"(", 
         RowBox[{"n", "+", "i", "-", 
          RowBox[{"(", 
           RowBox[{"b", "-", "1"}], ")"}]}], ")"}], 
        RowBox[{
         SubsuperscriptBox["Q", 
          RowBox[{"b", "-", "1"}], "i"], "(", "n", ")"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
