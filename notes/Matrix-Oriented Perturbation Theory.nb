Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"K", "[", 
     RowBox[{"0", ",", " ", "0"}], "]"}], ",", " ", 
    RowBox[{"getPartitionTree", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"3", ",", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], "}"}], "//", 
  "Tree"}]], "Input",
 CellChangeTimes->{{3.890840591009179*^9, 3.890840601277981*^9}, {
  3.8908441180931997`*^9, 3.890844136347042*^9}},
 CellLabel->
  "In[1403]:=",ExpressionUUID->"38598284-23cd-4ae6-a60c-843461c15059"],

Cell[BoxData[
 RowBox[{"getPartitionTree", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"3", ",", " ", "3", ",", "3", ",", " ", "1"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"4", ",", "3", ",", " ", "2", ",", " ", "1"}], "}"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.890844245321974*^9, 3.890844248634914*^9}, {
  3.89084432424441*^9, 3.890844325740367*^9}},
 CellLabel->
  "In[1414]:=",ExpressionUUID->"63d0f1ed-4fb4-4c1b-bd71-9cda3b082eec"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "getPartitionTree", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"getPartitionTree", "[", 
    RowBox[{
     RowBox[{"boxes", ":", 
      RowBox[{"{", "__Integer", "}"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s1_", ",", " ", "steps___Integer"}], "}"}], ",", " ", 
     RowBox[{"depth_", ":", "0"}]}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Block", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"stepParts", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"PadRight", "[", 
          RowBox[{"#", ",", " ", 
           RowBox[{"Length", "@", "boxes"}]}], "]"}], "&"}], "/@", 
        "\[IndentingNewLine]", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"IntegerPartitions", "[", 
           RowBox[{"s1", ",", " ", 
            RowBox[{"Length", "@", "boxes"}]}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Max", "@", "#"}], "<=", 
            RowBox[{"Max", "@", "boxes"}]}], "&"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Flatten", "@", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"b", "=", 
              RowBox[{"boxes", "-", "p"}]}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Min", "@", "b"}], ">=", "0"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "@", 
                  RowBox[{"{", "steps", "}"}]}], ">", "0"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"With", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"pt", "=", 
                    RowBox[{"getPartitionTree", "[", 
                    RowBox[{"b", ",", " ", 
                    RowBox[{"{", "steps", "}"}], ",", " ", 
                    RowBox[{"depth", "+", "1"}]}], "]"}]}], "}"}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Length", "@", 
                    RowBox[{"Flatten", "@", "pt"}]}], ">", "0"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Tree", "[", 
                    RowBox[{
                    RowBox[{"K", "@@", "p"}], ",", " ", "pt"}], "]"}], ",", 
                    "\[IndentingNewLine]", "Nothing"}], "\[IndentingNewLine]",
                    "]"}]}], "\[IndentingNewLine]", "]"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"K", "@@", "p"}]}], "\[IndentingNewLine]", "]"}], ",",
               "\[IndentingNewLine]", "Nothing"}], "\[IndentingNewLine]", 
             "]"}]}], "\[IndentingNewLine]", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"p", ",", " ", 
            RowBox[{"Permutations", "@", "pp"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"pp", ",", " ", "stepParts"}], "}"}]}], 
       "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.890769974099189*^9, 3.89077016000633*^9}, {
   3.8907702215688457`*^9, 3.890770281464284*^9}, {3.890770315303034*^9, 
   3.890770414748252*^9}, {3.8907704453455667`*^9, 3.890770492545414*^9}, {
   3.8907705229006767`*^9, 3.890770533230932*^9}, {3.890770620555085*^9, 
   3.8907706214823837`*^9}, {3.8907708409806757`*^9, 
   3.8907709513294773`*^9}, {3.890771037169379*^9, 3.890771096524604*^9}, {
   3.890771259261271*^9, 3.8907713372218*^9}, {3.890839879706634*^9, 
   3.890839884729876*^9}, 3.890839961378912*^9, {3.890840085219195*^9, 
   3.890840085560182*^9}, {3.890840244247568*^9, 3.8908403358951406`*^9}, {
   3.890840446547331*^9, 3.890840448205552*^9}, {3.890840510264621*^9, 
   3.890840512939946*^9}, {3.890840552697927*^9, 3.890840569618894*^9}, {
   3.89084405027042*^9, 3.89084410009295*^9}, {3.890844208433504*^9, 
   3.890844238137245*^9}},
 CellLabel->
  "In[1410]:=",ExpressionUUID->"002a70e5-feac-4584-a190-fe32d2c7bcb4"]
}, Closed]],

Cell[CellGroupData[{

Cell["Fourier Treatment of Polynomial Coeffs", "Subsubsubsection",
 CellChangeTimes->{{3.890409457169408*^9, 
  3.890409464066749*^9}},ExpressionUUID->"7ad4f202-7694-4641-8b38-\
11b229b464a7"],

Cell["\<\
IGNORE MOST OF THIS AND JUST GO TO THE COMP SCI EXCHANGE POST WHERE I PROVIDE \
AN ALGORITHM\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8923075873624973`*^9, 
  3.892307601271367*^9}},ExpressionUUID->"63e80a30-1af7-46c2-bdfb-\
ebeedc27da78"],

Cell[TextData[{
 "When we multiply polynomials, we\[CloseCurlyQuote]re taking a DFT, which \
gives for the ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "76c110f1-3f57-4dc5-9d36-ea7ef4655f66"],
 "th coefficient (if the total order is ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "36d17b05-b2f0-4f96-8280-4d973250eba8"],
 ") gives"
}], "ExpositoryText",
 CellChangeTimes->{{3.8904096569302683`*^9, 3.890409670336417*^9}, {
  3.890409854034552*^9, 3.890409885139804*^9}, {3.890410017027*^9, 
  3.890410018585231*^9}},ExpressionUUID->"f0f4f737-0721-439b-aba4-\
9f793aeed03c"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["c", "k"], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", "0"}], 
        RowBox[{"N", "-", "1"}]], 
       RowBox[{
        SubscriptBox["a", "r"], 
        SuperscriptBox["e", 
         RowBox[{
          RowBox[{"-", "2"}], "\[InvisibleSpace]", "\[Pi]", 
          "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "k", "\[InvisibleSpace]\[VeryThinSpace] ", 
          RowBox[{"j", "/", "N"}]}]]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       OverscriptBox["a", "\[RightVector]"], "\[CenterDot]", 
       SuperscriptBox["e", 
        RowBox[{
         RowBox[{"-", "2"}], "\[InvisibleSpace]", "\[Pi]", 
         "\[InvisibleSpace]", "i", "\[InvisibleSpace]", 
         RowBox[{"k", "(", 
          RowBox[{
           OverscriptBox["j", "\[RightVector]"], "/", "N"}], ")"}]}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8904096735016727`*^9, 3.890409722436694*^9}, {
  3.890409867075325*^9, 3.8904099625066357`*^9}, {3.890411615788224*^9, 
  3.89041163677461*^9}, {3.8904117784157047`*^9, 3.890411883835763*^9}, {
  3.890412029311298*^9, 
  3.890412040674569*^9}},ExpressionUUID->"e5b83dae-3d34-46c1-b747-\
e3fb8ba6a28e"],

Cell[TextData[{
 "and then we multiply our series of polynomials together element-wise and \
finally we back-transform using an inverse DFT which for the ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "1eb5d840-72ee-4c24-828e-37649f7654f0"],
 "th coefficient gives"
}], "ExpositoryText",
 CellChangeTimes->{{3.8904099700910263`*^9, 3.890409971346195*^9}, {
  3.890410020328422*^9, 3.89041002445625*^9}, {3.89041176764841*^9, 
  3.8904117764542217`*^9}, {3.890411894946066*^9, 3.890411947207443*^9}, {
  3.890411996390181*^9, 
  3.890412025935342*^9}},ExpressionUUID->"a37e2713-f4ce-4696-aaa2-\
b2cffc665d9c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["d", "j"], " ", "=", 
   RowBox[{
    FractionBox["1", "N"], " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "0"}], 
      RowBox[{"N", "-", "1"}]], " ", 
     SuperscriptBox["e", 
      RowBox[{
      "2", "\[InvisibleSpace]", "\[Pi]", "\[InvisibleSpace]", "i", "\[InvisibleSpace]\[InvisibleSpace]\[VeryThinSpace]",
        "j", "\[InvisibleSpace]", 
       RowBox[{"k", "/", "N"}]}]]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.890412044668551*^9, 
  3.890412086915008*^9}},ExpressionUUID->"4b2013b3-b698-4312-b79e-\
2b6ba0c0f504"],

Cell["\<\
of course, the trick here is to use a FFT to cut down on the number of \
operations, but in principle this is how it goes.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8904136336275063`*^9, 3.890413670614509*^9}, {
   3.890416256488455*^9, 3.890416257427826*^9}, 
   3.890416568815241*^9},ExpressionUUID->"d75569cd-8f28-4e09-83ed-\
4204a0995041"],

Cell["\<\
We also need to multiply our polynomials with a shift, and to do that we\
\[CloseCurlyQuote]ll consider what happens to the Fourier coefficients, which \
are equivalent to evaluating the polynomial at the roots of unity\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8904196467097607`*^9, 3.8904196814064417`*^9}, {
  3.8904220643224697`*^9, 
  3.890422065112567*^9}},ExpressionUUID->"9c6ba0e4-52ff-469e-8b06-\
1e494a5003d1"],

Cell["For any given root of unity, we have", "ExpositoryText",
 CellChangeTimes->{{3.890419699026569*^9, 
  3.890419703676943*^9}},ExpressionUUID->"1f851d9b-da9d-41d8-b576-\
121287b09ba3"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"P", "(", 
       RowBox[{"d", "+", "\[Omega]"}], ")"}], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "0"}], "n"], " ", 
       SuperscriptBox[
        RowBox[{
         SubscriptBox["c", "k"], "(", 
         RowBox[{"d", "+", "\[Omega]"}], ")"}], "k"]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "0"}], "n"], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], "k"], " ", 
        RowBox[{
         SubscriptBox["c", "k"], 
         RowBox[{"(", GridBox[{
            {"k"},
            {"j"}
           }], ")"}], 
         SuperscriptBox["d", 
          RowBox[{"k", "-", "j"}]], 
         SuperscriptBox["\[Omega]", "j"]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", "0"}], "n"], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"k", "=", "j"}], "n"], " ", 
          RowBox[{
           RowBox[{
            SubscriptBox["c", "k"], "(", GridBox[{
              {"k"},
              {"j"}
             }], ")"}], 
           SuperscriptBox["d", 
            RowBox[{"k", "-", "j"}]]}]}], ")"}], 
        SuperscriptBox["\[Omega]", "j"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.890419682361932*^9, 3.8904196829673977`*^9}, {
  3.890423159409564*^9, 
  3.8904231758598127`*^9}},ExpressionUUID->"671aa948-1c60-4441-81d3-\
93d78672a7e3"],

Cell["\<\
but of course that bit in the middle there is just the same as the \
appropriate Taylor shift and can\[CloseCurlyQuote]t easily be multiplied into \
the Fourier coefficient of the unshifted polynomial...\
\>", "ExpositoryText",
 CellChangeTimes->{{3.89041978365021*^9, 
  3.890419892258906*^9}},ExpressionUUID->"fa9e154c-c42b-4c9c-ac24-\
7ec43adebd6d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["P", "^"], "(", "\[Omega]", ")"}], " ", "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"k", "=", "0"}], "n"], " ", 
    RowBox[{
     SubscriptBox["c", "k"], 
     SuperscriptBox["\[Omega]", "k"]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.890419786915258*^9, 3.8904198173735037`*^9}, {
  3.8904231204070044`*^9, 
  3.890423122947547*^9}},ExpressionUUID->"c0aedf9f-e861-4324-9572-\
50b38152afc5"],

Cell[TextData[{
 "but using the fact that we do this for all ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "70f1f8c9-3fee-48b1-a98f-1938fdfc1f06"],
 " of the ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "ef75585d-8613-4fc8-8038-fb60f7b7c56a"],
 "th roots of unity we might be able to get something out of this as in \
general we have the ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "2f1ea2aa-5bad-44c2-97d9-55895fe6bce5"],
 "th Fourier coefficient given by"
}], "ExpositoryText",
 InitializationCell->True,
 CellChangeTimes->{{3.890419821696054*^9, 3.890419823563096*^9}, {
  3.890421069357862*^9, 3.890421113494411*^9}, {3.890423125142331*^9, 
  3.8904231320453444`*^9}, {3.8904232187077093`*^9, 
  3.8904232222479963`*^9}},ExpressionUUID->"6985d734-dabd-4adf-a4b8-\
b18f3f5abcb1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["P", "^"], "(", 
    SuperscriptBox["\[Omega]", "m"], ")"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "0"}], "n"], " ", 
     SuperscriptBox[
      RowBox[{
       SubscriptBox["c", "k"], "(", 
       SuperscriptBox["\[Omega]", "m"], ")"}], "k"]}], " ", "=", " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "0"}], "n"], " ", 
     RowBox[{
      SubscriptBox["c", "k"], 
      SuperscriptBox[
       SuperscriptBox["\[Omega]", "m"], "k"]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.890419786915258*^9, 3.8904198173735037`*^9}, {
  3.8904231204070044`*^9, 3.890423144669882*^9}, {3.890423833183531*^9, 
  3.89042384154202*^9}},ExpressionUUID->"e168bb87-f599-4690-908b-\
21f1f084a461"],

Cell[TextData[{
 "and so the ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "66cbb9be-2e24-48dd-843f-335cb2c1fd60"],
 "th Fourier coefficient of the shifted version is"
}], "ExpositoryText",
 CellChangeTimes->{{3.890423151078165*^9, 3.890423152508123*^9}, {
  3.890423237677726*^9, 3.890423255876186*^9}, {3.8904238215448313`*^9, 
  3.8904238229235764`*^9}},ExpressionUUID->"0ef626bb-8c6e-4068-aecf-\
9118415a5159"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["P", "^"], "(", 
    RowBox[{"d", "+", 
     SuperscriptBox["\[Omega]", "m"]}], ")"}], " ", "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"j", "=", "0"}], "n"], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "j"}], "n"], " ", 
       RowBox[{
        RowBox[{
         SubscriptBox["c", "k"], "(", GridBox[{
           {"k"},
           {"j"}
          }], ")"}], 
        SuperscriptBox["d", 
         RowBox[{"k", "-", "j"}]]}]}], ")"}], 
     SuperscriptBox["\[Omega]", 
      RowBox[{"m", "\[InvisibleSpace]", "j"}]]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.890419682361932*^9, 3.8904196829673977`*^9}, {
  3.890423159409564*^9, 3.8904231758598127`*^9}, {3.890423259021414*^9, 
  3.890423272186301*^9}, {3.890423325245698*^9, 3.890423341545904*^9}, {
  3.890423851861919*^9, 
  3.8904238525351667`*^9}},ExpressionUUID->"900c26c6-c3fb-4e79-abe1-\
5fc15836e0c7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"permutationOperatorPathDiagram", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"3", ",", " ", "1"}], "}"}], ",", " ", 
   RowBox[{"{", 
