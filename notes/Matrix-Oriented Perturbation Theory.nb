c124a1b44033"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox[
       SubscriptBox["E", "n"], 
       RowBox[{"(", "k", ")"}]], "=", 
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], " ", 
        SuperscriptBox["H", 
         RowBox[{"(", "k", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], "+", " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], 
         RowBox[{"k", "-", "1"}]], 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], " ", 
         SuperscriptBox["H", 
          RowBox[{"(", 
           RowBox[{"k", "-", "i"}], ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"]}]}], "-", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["E", "n"], 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", "i", ")"}]]}]},
         "BraKet"]}]}]}]},
    {
     RowBox[{
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "k"], 
       TemplateBox[{
         RowBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]], " "}], 
         RowBox[{"\[VeryThinSpace] ", 
           SuperscriptBox["m", 
            RowBox[{"(", 
              RowBox[{"k", "-", "i"}], ")"}]]}]},
        "BraKet"]}], "=", "0"}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["H", 
          RowBox[{"(", "0", ")"}]], "-", 
         SuperscriptBox[
          SubscriptBox["E", "n"], 
          RowBox[{"(", "0", ")"}]]}], ")"}], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], 
        RowBox[{"k", "-", "1"}]], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["E", "n"], 
           RowBox[{"(", 
            RowBox[{"k", "-", "i"}], ")"}]], "-", 
          SuperscriptBox["H", 
           RowBox[{"(", 
            RowBox[{"k", "-", "i"}], ")"}]]}], ")"}], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "i", ")"}]]},
         "Ket"]}]}]}]}
