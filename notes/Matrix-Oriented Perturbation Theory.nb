Cell[TextData[{
 "Lastly, to simplify things we\[CloseCurlyQuote]ll note since each element \
of V is an eigenstate of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "D"], 
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], 
    SubscriptBox["P", "D"]}], TraditionalForm]],ExpressionUUID->
  "d01eb4c5-c4dd-4251-b499-6cc08edc1063"]
