  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"E", ".", "g", ".", " ", "suppose"}], " ", 
     StyleBox["m",
      FontSlant->"Italic"]}], 
    StyleBox[" ",
     FontSlant->"Italic"], "=", " ", "5"}], ",", " ", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["i",
       FontSlant->"Italic"], "5"], " ", "will", " ", "be", " ", "taken", " ", 
