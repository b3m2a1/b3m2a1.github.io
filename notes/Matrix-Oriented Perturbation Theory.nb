Cell[CellGroupData[{

Cell[TextData[{
 "General Raising/Lowering Representation of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["q", "n"], TraditionalForm]],ExpressionUUID->
  "e4546de8-390e-4be5-bdba-b9e3f8aca56b"]
}], "Subsubsection",
 CellChangeTimes->{{3.812047145795076*^9, 
  3.812047174404708*^9}},ExpressionUUID->"13a5cd19-b3f6-448b-ba31-\
dbe0c779b49c"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SuperscriptBox["q", "N"], 
       TemplateBox[{
         SubscriptBox["n", "i"]},
        "Ket"]}], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Alpha]", "=", 
         RowBox[{"-", "N"}]}], "N"], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          UnderscriptBox["\[Sum]", 
           RowBox[{"p", "\[Element]", 
            StyleBox[
             SubsuperscriptBox["P", "N", 
              RowBox[{" ", "\[Alpha]"}]],
             FontSize->14]}]], " ", 
          RowBox[{
           UnderscriptBox["\[Product]", 
            RowBox[{"l", "\[VeryThinSpace]", "\[Element]", "p"}]], 
           SqrtBox[
            FractionBox[
             RowBox[{
              SubscriptBox["n", "i"], "+", "l"}], "2"]]}]}], ")"}], 
        TemplateBox[{
          RowBox[{
            SubscriptBox["n", "i"], "+", "j"}]},
         "Ket"]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Alpha]", "=", 
         RowBox[{"-", "N"}]}], "N"], 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["\[Rho]", "N", "\[Alpha]"], "(", 
         SubscriptBox["n", "i"], ")"}], 
        TemplateBox[{
          RowBox[{
            SubscriptBox["n", "i"], "+", "j"}]},
         "Ket"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.812047196968814*^9, 3.812047197618164*^9}, {
  3.81207038813085*^9, 3.812070474856777*^9}, {3.812103166138143*^9, 
