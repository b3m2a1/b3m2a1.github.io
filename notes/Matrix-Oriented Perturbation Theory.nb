Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["R", "2"]], 
         SubscriptBox["Q", 
          RowBox[{"\[InvisibleSpace]", 
           RowBox[{
           "i", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "j"}]}]]}], 
        SubscriptBox["\[Omega]", "k"]}], " ", "+", " ", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["R", "2"]], 
         SubscriptBox["Q", 
          RowBox[{"\[InvisibleSpace]", 
           RowBox[{
           "i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]}]]}], 
        SubscriptBox["\[Omega]", "j"]}]}], " ", "=", " ", 
      RowBox[{"-", 
       RowBox[{
        SubscriptBox["\[Del]", "R"], 
        SubscriptBox["G", 
         RowBox[{
         "i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]]}]}]}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox["R", "2"]], 
        SubscriptBox["Q", 
         RowBox[{"\[InvisibleSpace]", 
          RowBox[{
          "i", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "j"}]}]]}], " ",
        "+", " ", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["R", "2"]], 
         SubscriptBox["Q", 
          RowBox[{"\[InvisibleSpace]", 
           RowBox[{
           "i", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "j"}]}]]}], 
        SubscriptBox["\[Omega]", "k"]}], " ", "+", " ", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["R", "2"]], 
         SubscriptBox["Q", 
          RowBox[{"\[InvisibleSpace]", 
           RowBox[{
           "i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]}]]}], 
        SubscriptBox["\[Omega]", "j"]}], " ", "+", " ", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["R", "2"]], 
         SubscriptBox["Q", 
          RowBox[{"\[InvisibleSpace]", 
           RowBox[{
           "j", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "k"}]}]]}], 
        SubscriptBox["\[Omega]", "j"]}]}], " ", "=", " ", 
      RowBox[{"-", 
       RowBox[{
        SubscriptBox["\[Del]", "R"], 
        SubscriptBox["G", 
         RowBox[{
         "i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9213709178349667`*^9, 3.92137100840044*^9}, {
   3.92137107839043*^9, 3.921371092507839*^9}, {3.9275976883229027`*^9, 
