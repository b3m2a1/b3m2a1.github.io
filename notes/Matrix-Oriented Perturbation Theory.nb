 FormBox[
  RowBox[{
   RowBox[{"S", "(", 
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], ")"}], "=", 
   RowBox[{
    SuperscriptBox["\[ScriptCapitalP]", "3"], "(", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"S", "(", 
       RowBox[{
        SubscriptBox["q", "1"], 
        SubscriptBox["q", "1"], 
        SubscriptBox["q", "1"]}], ")"}], ",", " ", 
      RowBox[{"S", "(", 
       RowBox[{
        SubscriptBox["q", "1"], 
        SubscriptBox["q", "1"], 
        SubscriptBox["q", "2"]}], ")"}], ",", " ", 
      RowBox[{"S", "(", 
       RowBox[{
        SubscriptBox["q", "1"], 
        SubscriptBox["q", "2"], 
        SubscriptBox["q", "3"]}], ")"}]}], "}"}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8259401703750277`*^9, 3.825940258056834*^9}, {
  3.825941300549333*^9, 3.8259413055432158`*^9}, {3.8259413737904453`*^9, 
  3.825941385309368*^9}},ExpressionUUID->"29c953aa-78ec-493d-a4db-\
90cf3d81ed95"],

Cell["which can be decomposed like", "ExpositoryText",
 CellChangeTimes->{{3.825940206259616*^9, 3.825940234180328*^9}, {
