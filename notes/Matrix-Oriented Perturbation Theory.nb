Cell["\<\
the first thing we do is get the second order correction to the energy by\
\>", "ExpositoryText",
 CellChangeTimes->{{3.821737076883594*^9, 3.821737089585867*^9}, {
  3.8217398109971848`*^9, 
  3.821739811112155*^9}},ExpressionUUID->"c7baa5da-aaba-42dc-8fae-\
83c7ce20c890"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", "G"], " ", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["H", 
       RowBox[{"(", "2", ")"}]], "-", 
      RowBox[{
       RowBox[{
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], "[", 
        RowBox[{"U", ":", 
         SubsuperscriptBox["\[CapitalPi]", "n", 
          RowBox[{"(", "0", ")"}]], ":", "U"}], "]"}], 
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]]}]}], ")"}], 
    SubscriptBox["P", "G"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    SubsuperscriptBox["E", "n", 
     RowBox[{"(", "2", ")"}]], 
    SubscriptBox["P", "G"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8217371138578978`*^9, 
  3.821737114607842*^9}},ExpressionUUID->"161639b2-1e7e-4b64-be0a-\
b85a1b6023b2"],

Cell["where the total perturbed perturbation matrix is given by", \
"ExpositoryText",
 CellChangeTimes->{{3.821737118951116*^9, 3.821737130574656*^9}, {
  3.8217371703671837`*^9, 
  3.821737182383233*^9}},ExpressionUUID->"60b2b02d-9a43-4a3f-8cc7-\
08f2866cb180"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"pertPlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalEta]", "[", "$dD", "]"}], "[", "2", "]"}], " ", "-", 
   " ", 
   RowBox[{"Dot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[CapitalEta]", "[", "$dD", "]"}], "[", "1", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"\[CapitalPi]", "[", "$dD", "]"}], "[", 
      RowBox[{"\[ScriptCapitalU]", ",", " ", "0"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"\[CapitalEta]", "[", "$dD", "]"}], "[", "1", "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[2959]:=",ExpressionUUID->"01c9075c-2382-469d-9e13-9430a3867ded"],

