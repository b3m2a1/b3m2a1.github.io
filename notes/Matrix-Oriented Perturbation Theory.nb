Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "dH", ",", "\[CapitalDelta]n", ",", " ", "\[ScriptCapitalP]", ",", " ", 
    "\[ScriptCapitalP]\[ScriptR]", ",", " ", "\[Phi]", ",", " ", 
    "\[CapitalEpsilon]", ",", " ", "\[CapitalEta]", ",", " ", "\[CapitalPi]", 
    ",", " ", "\[ScriptCapitalT]", ",", " ", "\[ScriptCapitalT]\[ScriptN]", 
    ",", " ", "\[BlackKing]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalEta]", "[", "data_ptData", "]"}], "[", "i_Integer", 
    "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"data", "[", 
    RowBox[{"[", 
     RowBox[{"\"\<H\>\"", ",", " ", 
      RowBox[{"i", "+", "1"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Phi]", "[", "data_ptData", "]"}], "[", "i_Integer", "]"}], ":=",
    "\[IndentingNewLine]", 
   RowBox[{"data", "[", 
    RowBox[{"[", 
     RowBox[{"\"\<n\>\"", ",", " ", 
      RowBox[{"i", "+", "1"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalEpsilon]", "[", "data_ptData", "]"}], "[", "i_Integer", 
    "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"data", "[", 
    RowBox[{"[", 
     RowBox[{"\"\<E\>\"", ",", " ", 
      RowBox[{"i", "+", "1"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalP]", "/:", 
   RowBox[{"v_List", "**", 
    RowBox[{"\[ScriptCapitalP]", "[", "S_List", "]"}]}], ":=", 
   RowBox[{"v", "[", 
    RowBox[{"[", 
     RowBox[{";;", ",", " ", "S"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalP]", "/:", 
   RowBox[{
    RowBox[{"\[ScriptCapitalP]", "[", "S_List", "]"}], "**", "v_List"}], ":=", 
   RowBox[{"v", "[", 
    RowBox[{"[", "S", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalT]", "[", "data_ptData", "]"}], ":=", 
   RowBox[{"Range", "[", 
    RowBox[{"data", "[", 
     RowBox[{"[", "\"\<NDim\>\"", "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalT]\[ScriptN]", "[", "data_ptData", "]"}], ":=", 
   RowBox[{"Complement", "[", 
    RowBox[{
     RowBox[{"\[ScriptCapitalT]", "[", "data", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"data", "[", 
       RowBox[{"[", "\"\<idx\>\"", "]"}], "]"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[ScriptCapitalP]\[ScriptR]", "[", "data_ptData", "]"}], "[", 
    "S_List", "]"}], ":=", 
   RowBox[{"ReplacePart", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"data", "[", 
          RowBox[{"[", "\"\<NDim\>\"", "]"}], "]"}], ",", " ", 
         RowBox[{"data", "[", 
          RowBox[{"[", "\"\<NDim\>\"", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"Transpose", "@", 
        RowBox[{"{", 
         RowBox[{"S", ",", " ", "S"}], "}"}]}], "\[Rule]", "1"}], "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dH", "[", "data_ptData", "]"}], "[", "i_", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalEta]", "[", "data", "]"}], "[", "i", "]"}], "-", 
    "\[IndentingNewLine]", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalEpsilon]", "[", "data", "]"}], "[", "i", "]"}], ",",
        " ", 
       RowBox[{"data", "[", 
        RowBox[{"[", "\"\<NDim\>\"", "]"}], "]"}]}], "]"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalDelta]n", "[", "data_ptData", "]"}], "[", 
    RowBox[{"S_", ",", " ", "k_", ",", " ", 
     RowBox[{"{", 
      RowBox[{"start_", ",", " ", "end_"}], "}"}]}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Sum", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Dot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"dH", "[", "data", "]"}], "[", 
        RowBox[{"k", "-", "i"}], "]"}], ",", 
       RowBox[{
        RowBox[{"\[ScriptCapitalP]\[ScriptR]", "[", "data", "]"}], "[", "S", 
        "]"}], ",", 
       RowBox[{
        RowBox[{"\[Phi]", "[", "data", "]"}], "[", "i", "]"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "start", ",", " ", 
       RowBox[{"k", "-", "end"}]}], "}"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalPi]", "[", "data_ptData", "]"}], "[", 
     RowBox[{"S_", ",", " ", "k_"}], "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"ReplacePart", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"data", "[", 
           RowBox[{"[", "\"\<NDim\>\"", "]"}], "]"}], ",", " ", 
          RowBox[{"data", "[", 
           RowBox[{"[", "\"\<NDim\>\"", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Thread", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Outer", "[", 
           RowBox[{"List", ",", " ", "S", ",", " ", "S"}], "]"}], ",", " ", 
          "1"}], "]"}], "\[Rule]", "\[IndentingNewLine]", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Inverse", "[", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[ScriptCapitalP]", "[", "S", "]"}], "**", 
              RowBox[{
               RowBox[{"dH", "[", "data", "]"}], "[", "k", "]"}], "**", 
              RowBox[{"\[ScriptCapitalP]", "[", "S", "]"}]}], ")"}]}], "]"}], 
