Cell[CellGroupData[{

Cell["Perturbation Theory Hamiltonians", "Section",
 CellChangeTimes->{{3.793484587274716*^9, 3.793484601959643*^9}, {
  3.793487818458797*^9, 
  3.793487823650403*^9}},ExpressionUUID->"36191316-b297-4fdf-a825-\
6e10d7b7ae0c"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox["H", 
       RowBox[{"(", "0", ")"}]], " ", "=", " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "i"], " ", 
       RowBox[{
        FractionBox[
         SubscriptBox["\[Omega]", "i"], "2"], 
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox["p", "i", "2"], " ", "+", " ", 
          SubsuperscriptBox["q", "i", "2"]}], ")"}]}]}]}]},
    {
     RowBox[{
      SuperscriptBox["H", 
       RowBox[{"(", "1", ")"}]], " ", "=", " ", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{
         UnderscriptBox["\[Sum]", 
          RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]], 
         
         RowBox[{
          FractionBox[
           RowBox[{"\[PartialD]", 
            SubscriptBox["G", 
             RowBox[{"\[VeryThinSpace]", 
              RowBox[{"i", "\[VeryThinSpace]", "j"}]}]]}], 
           RowBox[{"\[PartialD]", 
            SubscriptBox["q", "k"]}]], 
          SubscriptBox["p", "i"], 
          SubscriptBox["Q", "k"], 
          SubscriptBox["p", "j"]}]}]}], " ", "+", 
       RowBox[{
        FractionBox["1", "6"], 
        RowBox[{
         UnderscriptBox["\[Sum]", 
          RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]], 
         
         RowBox[{
          FractionBox[
           RowBox[{
            SuperscriptBox["\[PartialD]", "3"], "V"}], 
           RowBox[{
            RowBox[{"\[PartialD]", 
             SubscriptBox["q", "i"]}], "\[InvisibleSpace]", 
            SubscriptBox["q", "j"], "\[InvisibleSpace]", 
            SubscriptBox["q", "k"]}]], 
          SubscriptBox["q", "i"], "\[InvisibleSpace]", 
          SubscriptBox["q", "j"], "\[InvisibleSpace]", 
          SubscriptBox["q", "k"]}]}]}]}]}]},
    {
     RowBox[{
      SuperscriptBox["H", 
       RowBox[{"(", "2", ")"}]], " ", "=", " ", "..."}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9667647164328823`*^9, 
  3.966764863170763*^9}},ExpressionUUID->"43f25051-1a57-4a83-b0e9-\
da7a2191c860"],

