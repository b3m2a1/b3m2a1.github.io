 FormBox[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "1", ")"}]]},
    "Ket"], " ", "=", " ", 
   RowBox[{
    SubscriptBox["\[CapitalPi]", "n"], 
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
