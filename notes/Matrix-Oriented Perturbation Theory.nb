Cell[CellGroupData[{

Cell["The V' Term", "Subsection",
 CellChangeTimes->{{3.811264116808818*^9, 
  3.811264136504649*^9}},ExpressionUUID->"8249a0c4-1c21-497b-975a-\
4338028756ca"],

Cell[CellGroupData[{

Cell["Old Origin", "Subsubsection",
 CellChangeTimes->{{3.843878925940889*^9, 
  3.843878928087082*^9}},ExpressionUUID->"7e6ce74b-8583-4d64-b58f-\
bd0a74007536"],

Cell["Super annoying to show, but this is basically comes from", \
"ExpositoryText",
 CellChangeTimes->{{3.8112663377933617`*^9, 3.8112663704337473`*^9}, {
  3.811273902527763*^9, 3.81127390789478*^9}, {3.8331113679611692`*^9, 
  3.833111368860531*^9}},ExpressionUUID->"644eff31-62ed-4616-bd54-\
99f7365d28a6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"V", "'"}], 
    SubscriptBox[
     RowBox[{"(", "Q", ")"}], 
     RowBox[{"i", "\[VeryThinSpace]", "j"}]]}], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox["\[HBar]", "2"], "2"]}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "4"]}], 
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", "g", "\[RightBracketingBar]"}], 
       RowBox[{"-", 
        FractionBox["1", "4"]}]], 
      RowBox[{
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", 
         SubscriptBox["q", "i"]}]], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"\[LeftBracketingBar]", "g", "\[RightBracketingBar]"}], 
          RowBox[{"-", 
           FractionBox["3", "4"]}]], 
         SubscriptBox["G", 
          RowBox[{"i", "\[VeryThinSpace]", "j"}]], 
         FractionBox[
          RowBox[{"\[PartialD]", 
           RowBox[{"\[LeftBracketingBar]", "g", "\[RightBracketingBar]"}]}], 
          RowBox[{"\[PartialD]", 
           SubscriptBox["q", "j"]}]]}], ")"}]}]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811266387802446*^9, 3.811266469748506*^9}, {
  3.811266587195744*^9, 3.811266655373314*^9}, {3.8112667168353558`*^9, 
  3.811266720821184*^9}, {3.811266850211248*^9, 3.811266891325355*^9}, {
  3.8112669413517513`*^9, 3.811266946255884*^9}, {3.811267089743615*^9, 
  3.8112670950149717`*^9}, {3.811267624964159*^9, 
  3.811267629195188*^9}},ExpressionUUID->"1a45da85-2773-48a6-ad10-\
2a98d12a613e"],

Cell["where", "ExpositoryText",
 CellChangeTimes->{{3.811266989118552*^9, 
  3.811266989618499*^9}},ExpressionUUID->"33650c11-a6e5-4339-b3c6-\
d306b896c2d7"],

Cell[BoxData[
 FormBox[
  RowBox[{"G", "=", 
   RowBox[{
    SubscriptBox["\[Del]", "Q"], 
    SuperscriptBox[
     RowBox[{"Y", "(", 
      RowBox[{
       SubscriptBox["\[Del]", "Q"], "Y"}], ")"}], "T"]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8112669914419727`*^9, 3.811267020744053*^9}, {
   3.811267572169908*^9, 3.811267573140945*^9}, 
   3.833111376271677*^9},ExpressionUUID->"ea16f3c6-8974-4ea8-96b3-\
bfc5b3eac925"],

Cell[TextData[{
 "which of course looks terrible...but using ",
 ButtonBox["Jacobi's formula",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Jacobi%27s_formula"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Jacobi%27s_formula"],
 " we can write"
}], "ExpositoryText",
 CellChangeTimes->{{3.811266963739263*^9, 3.811266980072548*^9}, {
   3.811267066652749*^9, 3.811267102747011*^9}, {3.811267361372581*^9, 
   3.811267371559636*^9}, {3.811267421652101*^9, 3.811267430962536*^9}, 
   3.8112676822875757`*^9, {3.811267972811757*^9, 
   3.811267986398179*^9}},ExpressionUUID->"3de26c40-f750-4723-be32-\
cf8f23c248b4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox["\[PartialD]", 
     RowBox[{"\[PartialD]", 
      SubscriptBox["q", "i"]}]], 
    RowBox[{"\[LeftBracketingBar]", "g", "\[RightBracketingBar]"}]}], "=", 
   RowBox[{"Tr", "(", 
    RowBox[{
     RowBox[{"Adj", "(", "g", ")"}], 
     FractionBox[
      RowBox[{"\[PartialD]", "g"}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["q", "i"]}]]}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811267980105794*^9, 3.811268043099012*^9}, {
  3.811591375926487*^9, 
  3.811591376599637*^9}},ExpressionUUID->"fd9845a0-1cb8-4f08-83e3-\
d603755f835d"],

Cell["\<\
which shows the path one can take to getting these elements. \
\>", "ExpositoryText",
 CellChangeTimes->{{3.811273916421582*^9, 3.811274037390676*^9}, 
   3.811274350618984*^9},ExpressionUUID->"e371114e-c23c-4569-a487-\
06c3e739aca8"]
}, Closed]],

Cell[CellGroupData[{

Cell["Origins", "Subsubsection",
 CellChangeTimes->{{3.8438785819622507`*^9, 
  3.8438785828867493`*^9}},ExpressionUUID->"cc1ff3ca-c30c-49c8-bc52-\
bd8e7b53fc1a"],

Cell["From Meyer we have", "ExpositoryText",
 CellChangeTimes->{{3.843878583901305*^9, 
  3.8438785863104973`*^9}},ExpressionUUID->"16589ecb-5c7e-4542-85a9-\
8f82dab0cd3e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["T", "v"], " ", "=", " ", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox["\[HBar]", "2"], "2"]}], 
    RowBox[{
