Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["A", "n", 
    RowBox[{"(", "k", ")"}]], "=", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"M", "=", "1"}], "k"], " ", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{
        StyleBox["p",
         FontSize->14], "\[Element]", 
        StyleBox[
         SubsuperscriptBox["\[CapitalXi]", "k", "M"],
         FontSize->14]}]], 
      RowBox[{
       RowBox[{"(", "\[VeryThinSpace]", 
        RowBox[{
         UnderoverscriptBox["\[Product]", 
          RowBox[{"i", "=", "1"}], 
          RowBox[{"M", "-", "2"}]], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["H", 
             RowBox[{"(", 
              StyleBox[
               SubscriptBox["p", "i"],
               FontSize->14], ")"}]], "-", 
            SubsuperscriptBox["E", "n", 
             RowBox[{"(", 
              StyleBox[
               SubscriptBox["p", "i"],
               FontSize->14], ")"}]]}], ")"}], 
          SubscriptBox["\[CapitalPi]", "n"]}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["H", 
          RowBox[{"(", 
           StyleBox[
            SubscriptBox["p", 
             RowBox[{"M", "-", "1"}]],
            FontSize->14], ")"}]], "-", 
         SubsuperscriptBox["E", "n", 
          RowBox[{"(", 
           StyleBox[
            SubscriptBox["p", 
             RowBox[{"M", "-", "1"}]],
            FontSize->14], ")"}]]}], ")"}], 
       TemplateBox[{
         RowBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]], " "}], 
         RowBox[{"\[VeryThinSpace] ", 
           SuperscriptBox["n", 
            RowBox[{"(", 
              SubscriptBox["p", "M"], ")"}]]}]},
        "BraKet"]}]}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"(", "\[VeryThinSpace]", 
      RowBox[{
       UnderoverscriptBox["\[Product]", 
        RowBox[{"i", "=", "1"}], 
        RowBox[{"M", "-", "1"}]], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["H", 
           RowBox[{"(", 
            StyleBox[
             SubscriptBox["p", "i"],
             FontSize->14], ")"}]], "-", 
          SubsuperscriptBox["E", "n", 
           RowBox[{"(", 
            StyleBox[
             SubscriptBox["p", "i"],
             FontSize->14], ")"}]]}], ")"}], 
        SubscriptBox["\[CapitalPi]", "n"]}]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", 
         StyleBox[
          SubscriptBox["p", "M"],
          FontSize->14], ")"}]], "-", 
       SubsuperscriptBox["E", "n", 
        RowBox[{"(", 
         StyleBox[
          SubscriptBox["p", "M"],
          FontSize->14], ")"}]]}], ")"}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
