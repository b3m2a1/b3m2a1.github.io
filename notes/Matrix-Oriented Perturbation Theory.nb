          SubscriptBox["\[CapitalPi]", "D"], 
          SubscriptBox["P", "U"], 
          SuperscriptBox["H", 
           RowBox[{"(", "1", ")"}]]}]}], ")"}], 
       SubscriptBox["P", "U"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", 
            RowBox[{"k", "-", "2"}], ")"}]]},
        "Ket"]}]}]}], " ", "\[LineSeparator]", 
    RowBox[{
     RowBox[{"+", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], 
        RowBox[{"k", "-", "3"}]], " ", 
       RowBox[{
