  ExpressionUUID->"a5d70f5c-bebd-4903-b46c-1a7a9c8690fb"],
 " so maybe this is a moot point anyway...basically we can use ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "U"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", 
         RowBox[{"k", "-", "1"}], ")"}]]},
     "Ket"]}], TraditionalForm]],
  CellChangeTimes->{{3.821326261976451*^9, 3.821326342951233*^9}},
  ExpressionUUID->"c089212c-8ffc-4886-885d-144e72d51b90"],
 " which only uses ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", 
        RowBox[{"k", "-", "2"}], ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.821326261976451*^9, 3.821326342951233*^9}},
  ExpressionUUID->"ac8d6cba-d37a-49ee-8b27-5bcf23cea9a1"],
 " to get ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "D"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", 
         RowBox[{"k", "-", "1"}], ")"}]]},
     "Ket"]}], TraditionalForm]],
  CellChangeTimes->{{3.821326261976451*^9, 3.821326342951233*^9}},
  ExpressionUUID->"11eea94a-1507-4fc7-9c94-601214fee48a"],
 " "
}], "ExpositoryText",
