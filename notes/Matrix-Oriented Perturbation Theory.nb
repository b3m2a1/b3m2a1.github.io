Cell[TextData[{
 "which simply reflects that fact that we keep refining the ",
 StyleBox["degenerate",
  FontSlant->"Italic"],
 " subspaces. This means that any hypothesis we come up with must include an \
iteration over these spaces."
}], "ExpositoryText",
 CellChangeTimes->{{3.82581291075309*^9, 
  3.825812965756065*^9}},ExpressionUUID->"99e02de5-e17d-4ca4-bfa5-\
5d270a27dee7"],

Cell[TextData[{
 "In particular, at order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "+", "1"}], TraditionalForm]],ExpressionUUID->
  "e3199c9c-1c7b-4d1a-ae06-f09681aec13b"],
 " (we\[CloseCurlyQuote]re going to do use ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "559e0a67-6514-41b7-a9dd-fb5747075743"],
 " as the base case), we can expand"
}], "ExpositoryText",
 CellChangeTimes->{{3.8258129787704897`*^9, 3.825813015912465*^9}, {
  3.825813096551145*^9, 
  3.825813101111561*^9}},ExpressionUUID->"e506be48-f71f-4087-b48f-\
961cb1141cee"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", 
        SuperscriptBox["D", 
         RowBox[{"(", "a", ")"}]]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], 
         RowBox[{"a", "+", "1"}]], 
        RowBox[{
         SuperscriptBox["\[CapitalDelta]H", 
          RowBox[{"(", 
           RowBox[{"a", "+", "1", "-", "i"}], ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", 
              RowBox[{"k", "+", "j"}], ")"}]]},
          "Ket"]}]}]}], "=", 
      RowBox[{
       RowBox[{
        SubscriptBox["P", 
         SuperscriptBox["D", 
          RowBox[{"(", "a", ")"}]]], 
        SuperscriptBox["\[CapitalDelta]H", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "k", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        SubscriptBox["P", 
         SuperscriptBox["D", 
          RowBox[{"(", "a", ")"}]]], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"j", "=", "1"}], 
          RowBox[{"a", "+", "1"}]], 
         RowBox[{
          SuperscriptBox["\[CapitalDelta]H", 
           RowBox[{"(", 
            RowBox[{"a", "+", "1", "-", "j"}], ")"}]], 
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", 
               RowBox[{"k", "+", "j"}], ")"}]]},
           "Ket"]}]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        SubscriptBox["P", 
         SuperscriptBox["D", 
          RowBox[{"(", "a", ")"}]]], 
        SuperscriptBox["\[CapitalDelta]H", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "k", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        SubscriptBox["P", 
         SuperscriptBox["D", 
          RowBox[{"(", "a", ")"}]]], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"j", "=", "0"}], "a"], 
         RowBox[{
          SuperscriptBox["\[CapitalDelta]H", 
           RowBox[{"(", 
            RowBox[{"a", "-", "i"}], ")"}]], 
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", 
               RowBox[{"k", "+", "1", "+", "j"}], ")"}]]},
           "Ket"]}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825813008530291*^9, 
  3.825813018011717*^9}},ExpressionUUID->"cefa3663-9fee-4aa7-9251-\
f59c165c5e35"],

Cell["which means for the first term we have", "ExpositoryText",
 CellChangeTimes->{{3.825813125440831*^9, 
  3.825813129974118*^9}},ExpressionUUID->"6a85927c-188c-46e4-b1f7-\
4b6daa848cfd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", 
     SuperscriptBox["D", 
      RowBox[{"(", "a", ")"}]]], 
    SuperscriptBox["\[CapitalDelta]H", 
     RowBox[{"(", 
      RowBox[{"a", "+", "1"}], ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["P", 
      SuperscriptBox["D", 
       RowBox[{"(", "a", ")"}]]], 
     SuperscriptBox["\[CapitalDelta]H", 
      RowBox[{"(", 
       RowBox[{"a", "+", "1"}], ")"}]], 
     SubscriptBox["P", 
      SuperscriptBox["D", 
       RowBox[{"(", "a", ")"}]]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "k", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"b", "=", "0"}], "a"], 
     RowBox[{
      SubscriptBox["P", 
       SuperscriptBox["D", 
        RowBox[{"(", "a", ")"}]]], 
      SuperscriptBox["\[CapitalDelta]H", 
       RowBox[{"(", 
        RowBox[{"a", "+", "1"}], ")"}]], 
      SubscriptBox["P", 
       SuperscriptBox["U", 
        RowBox[{"(", "b", ")"}]]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "k", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8258131308094797`*^9, 
  3.825813136767571*^9}},ExpressionUUID->"76cd3601-8e77-4cf8-b4bf-\
05dd7c8de826"],

Cell[TextData[{
 "and now we\[CloseCurlyQuote]ll use the inductive hypothesis we come up with \
to provide an explicit form for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", 
     SuperscriptBox["U", 
      RowBox[{"(", "b", ")"}]]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "a5e00200-8449-46b4-b670-43548e97ee11"],
 " as a sum over states through ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "-", "1"}], TraditionalForm]],ExpressionUUID->
  "d1c12f13-9fb2-4556-b436-0966cab85c74"],
 ", in particular it will look like"
}], "ExpositoryText",
 CellChangeTimes->{{3.825813138164246*^9, 3.825813188563552*^9}, {
  3.825813489652892*^9, 3.825813509140978*^9}, {3.825813667036191*^9, 
  3.825813673271649*^9}},ExpressionUUID->"c54475af-9d18-4325-96a4-\
26a46fc6a6d9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", 
     SuperscriptBox["U", 
      RowBox[{"(", "b", ")"}]]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    SubscriptBox["\[CapitalPi]", 
     SuperscriptBox["U", 
      RowBox[{"(", "b", ")"}]]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], 
      RowBox[{"k", "-", "1"}]], " ", 
     RowBox[{
      SuperscriptBox["X", 
       RowBox[{"(", 
        RowBox[{"k", ",", " ", "b", ",", " ", "i"}], ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825813683197501*^9, 
  3.825813761047167*^9}},ExpressionUUID->"015bddbd-342a-4e89-9bae-\
ba3a187986cb"],

Cell[TextData[{
 "The second term will be a direct application of the inductive hypothesis, \
as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", 
    SuperscriptBox["D", 
     RowBox[{"(", "a", ")"}]]], TraditionalForm]],
  CellChangeTimes->{{3.825787637496421*^9, 3.8257876788148727`*^9}, {
    3.825787746813643*^9, 3.825787760589594*^9}, {3.825787798928966*^9, 
