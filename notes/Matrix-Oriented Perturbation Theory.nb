Cell["then ", "ExpositoryText",
 CellChangeTimes->{{3.8112865987769203`*^9, 3.811286603138638*^9}, {
  3.811286826143363*^9, 
  3.811286826259061*^9}},ExpressionUUID->"24f6e499-f9af-43c3-9200-\
c48045fd7db4"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", "\[VeryThinSpace]", 
        SubscriptBox[
         RowBox[{"Adj", "(", 
          SubscriptBox["I", "0"], ")"}], "k"]}], 
       RowBox[{"\[PartialD]", 
        SubscriptBox["q", "j"]}]], "=", 
      RowBox[{
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", 
          SubscriptBox["q", "j"]}]], 
        SubscriptBox[
         RowBox[{"(", 
          SuperscriptBox[
           SubscriptBox["I", "0"], 
           RowBox[{"-", "1"}]], ")"}], "k"]}], 
       RowBox[{"\[LeftBracketingBar]", 
        SubscriptBox["I", "0"], "\[RightBracketingBar]"}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        RowBox[{"\[LeftBracketingBar]", 
         SubscriptBox["I", "0"], "\[RightBracketingBar]"}], 
        RowBox[{
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
           SubscriptBox["q", "j"]}]], 
         SubscriptBox[
          RowBox[{"(", 
           SuperscriptBox[
            SubscriptBox["I", "0"], 
            RowBox[{"-", "1"}]], ")"}], "k"]}]}], "+", 
       RowBox[{
        SubscriptBox[
         RowBox[{"(", 
          SuperscriptBox[
           SubscriptBox["I", "0"], 
           RowBox[{"-", "1"}]], ")"}], "k"], 
        RowBox[{
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
           SubscriptBox["q", "j"]}]], 
         RowBox[{"\[LeftBracketingBar]", 
          SubscriptBox["I", "0"], "\[RightBracketingBar]"}]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        RowBox[{"\[LeftBracketingBar]", 
         SubscriptBox["I", "0"], "\[RightBracketingBar]"}], 
        SubscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[Del]", "Q"], 
           SuperscriptBox[
            SubscriptBox["I", "0"], 
            RowBox[{"-", "1"}]]}], ")"}], 
         RowBox[{"j", "\[InvisibleSpace]", "k"}]]}], "+", 
       RowBox[{
        SubscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[Del]", "Q"], 
           RowBox[{"\[LeftBracketingBar]", 
            SubscriptBox["I", "0"], "\[RightBracketingBar]"}]}], ")"}], "j"], 
        
        SubscriptBox[
         RowBox[{"(", 
          SuperscriptBox[
           SubscriptBox["I", "0"], 
           RowBox[{"-", "1"}]], ")"}], "k"]}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "Q"], 
       RowBox[{"Adj", "(", 
        SubscriptBox["I", "0"], ")"}]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"\[LeftBracketingBar]", 
         SubscriptBox["I", "0"], "\[RightBracketingBar]"}], 
        RowBox[{
         SubscriptBox["\[Del]", "Q"], 
         SuperscriptBox[
          SubscriptBox["I", "0"], 
          RowBox[{"-", "1"}]]}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Del]", "Q"], 
          RowBox[{"\[LeftBracketingBar]", 
           SubscriptBox["I", "0"], "\[RightBracketingBar]"}]}], ")"}], 
        SuperscriptBox[
         SubscriptBox["I", "0"], 
         RowBox[{"-", "1"}]]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811286829641303*^9, 3.81128688232393*^9}, {
   3.811286954975379*^9, 3.811287041801169*^9}, 3.811287215400105*^9, {
   3.811287289183165*^9, 3.811287297750605*^9}, {3.811287355602846*^9, 
   3.811287414566025*^9}, {3.81128769703682*^9, 3.811287972641787*^9}, {
   3.811296707046424*^9, 3.81129672215943*^9}, {3.811300357778718*^9, 
   3.81130039168845*^9}, {3.811381847882265*^9, 3.811381921872654*^9}, 
   3.811381999650243*^9, {3.811382089142812*^9, 3.811382095167575*^9}, {
   3.8113823763245773`*^9, 3.8113824118946*^9}, {3.811382698141934*^9, 
   3.8113827780995283`*^9}},ExpressionUUID->"30befd11-8c3d-4b0d-84f0-\
4b0fd8bbe328"],

Cell[TextData[{
 "(where we made use of the fact that since ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["I", "0"], TraditionalForm]],ExpressionUUID->
  "7ce059d8-a314-494b-afa2-010b6eb63d4e"],
 " is symmetric its inverse is too). Putting these together because of \
masochism we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.811382781765815*^9, 3.8113828231250153`*^9}, {
  3.811412909563952*^9, 3.811412924524379*^9}, {3.833138336903783*^9, 
  3.833138357157441*^9}},ExpressionUUID->"dc38f80c-6fb8-471f-a1e0-\
cd7455744466"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     SuperscriptBox["\[PartialD]", "2"], 
     RowBox[{
      RowBox[{"\[PartialD]", 
       SubscriptBox["q", "j"]}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["q", "i"]}]}]], 
    RowBox[{"\[LeftBracketingBar]", 
     SubscriptBox["I", "0"], "\[RightBracketingBar]"}]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Del]", "Q"], 
        SubscriptBox["I", "0"]}], ")"}], "i"], 
     SubscriptBox["\[CircleDot]", "2"], 
     SubscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[LeftBracketingBar]", 
         SubscriptBox["I", "0"], "\[RightBracketingBar]"}], 
        RowBox[{
         SubscriptBox["\[Del]", "Q"], 
         SuperscriptBox[
          SubscriptBox["I", "0"], 
          RowBox[{"-", "1"}]]}]}], ")"}], "j"]}], " ", "+", " ", 
    RowBox[{
     SubscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Del]", "Q"], 
        SubscriptBox["I", "0"]}], ")"}], "i"], 
     SubscriptBox["\[CircleDot]", "2"], 
     SubscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Del]", "Q"], 
          RowBox[{"\[LeftBracketingBar]", 
           SubscriptBox["I", "0"], "\[RightBracketingBar]"}]}], ")"}], 
        SuperscriptBox[
         SubscriptBox["I", "0"], 
         RowBox[{"-", "1"}]]}], ")"}], "j"]}], " ", "+", 
    RowBox[{
     RowBox[{"\[LeftBracketingBar]", 
      SubscriptBox["I", "0"], "\[RightBracketingBar]"}], 
     RowBox[{
      SuperscriptBox[
       SubscriptBox["I", "0"], 
       RowBox[{"-", "1"}]], 
      SubscriptBox["\[CircleDot]", "2"], 
      SubscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["Q", "2"]], 
         SubscriptBox["I", "0"]}], ")"}], 
       RowBox[{"i", "\[VeryThinSpace]", "j"}]]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.833138384348588*^9, 3.8331383948442802`*^9}, {
  3.833138442611227*^9, 3.833138453259571*^9}, {3.833138509594837*^9, 
  3.8331385586811943`*^9}},ExpressionUUID->"a6c73f45-86b0-4df3-b266-\
d82d0fb07305"],

Cell["\<\
Finally when worrying about how to do the inertia tensor derivatives we have\
\>", "ExpositoryText",
 CellChangeTimes->{{3.811382781765815*^9, 3.8113828231250153`*^9}, {
  3.811412909563952*^9, 
  3.811412924524379*^9}},ExpressionUUID->"f6b6885c-ca53-4caa-b354-\
4aec801bc062"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", 
        SubscriptBox["I", "0"]}], 
       RowBox[{"\[PartialD]", 
        SubscriptBox["q", "i"]}]], "=", 
      RowBox[{
       SubscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Del]", "Q"], "Y"}], ")"}], "i"], 
       RowBox[{
        SubscriptBox["\[Del]", "Y"], 
        SubscriptBox["I", "0"]}]}]}]},
    {
     RowBox[{
      FractionBox[
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], 
        SubscriptBox["I", "0"]}], 
       RowBox[{
        RowBox[{"\[PartialD]", 
         SubscriptBox["q", "i"]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["q", "j"]}]}]], "=", 
      RowBox[{
       SubscriptBox["\[Del]", "Q"], 
       SubscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox[
           RowBox[{"(", 
            RowBox[{
             SubscriptBox["\[Del]", "Q"], "Y"}], ")"}], "j"], 
          RowBox[{
           SubscriptBox["\[Del]", "Y"], 
           SubscriptBox["I", "0"]}]}], ")"}], "i"]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "Q"], "Y"}], " ", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Del]", "Q"], "Y"}], ")"}], "j"], 
         RowBox[{
          SubscriptBox["\[Del]", "Y"], 
          SubscriptBox["I", "0"]}]}], ")"}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        SubscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[Del]", 
            SuperscriptBox["Q", "2"]], "Y"}], ")"}], 
         RowBox[{"i", "\[InvisibleSpace]", "j"}]], 
        RowBox[{
         SubscriptBox["\[Del]", "Y"], 
         SubscriptBox["I", "0"]}]}], "+", 
       RowBox[{
        SubscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[Del]", "Q"], "Y"}], ")"}], "j"], 
        SubscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[Del]", "Q"], "Y"}], ")"}], "i"], 
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["Y", "2"]], 
         SubscriptBox["I", "0"]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811382029635356*^9, 
  3.8113820302767057`*^9}},ExpressionUUID->"859139c1-a57b-4634-8568-\
c2ad748e3f57"],

Cell["\<\
then getting the Cartesian derivatives of the inertia tensor, for every \
mass-weighted atomic position vector we get a derivative tensor like\
\>", "ExpositoryText",
 CellChangeTimes->{{3.811288376692553*^9, 3.811288378135098*^9}, {
  3.81128860118531*^9, 3.811288626417468*^9}, {3.811288723306031*^9, 
  3.811288734079114*^9}, {3.8112947519115543`*^9, 3.811294788074018*^9}, {
  3.811296728032604*^9, 
  3.811296728777446*^9}},ExpressionUUID->"0b32ff41-9215-4476-8583-\
4542f15874a8"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", 
         SubscriptBox["y", "n"]}]], 
       SubscriptBox["I", "0"]}], "=", 
      RowBox[{
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", 
          SubscriptBox["y", "n"]}]], 
        RowBox[{
         UnderscriptBox["\[Sum]", "m"], " ", 
         RowBox[{
          SubscriptBox["\[DoubleStruckCapitalI]", "3"], "(", 
          RowBox[{
           SubscriptBox["y", "m"], "\[CenterDot]", 
           SubscriptBox["y", "m"]}], ")"}]}]}], "-", 
       RowBox[{
        SubscriptBox["y", "m"], "\[CircleTimes]", 
        SubscriptBox["y", "m"]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", 
         SubscriptBox["y", "n"]}]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[DoubleStruckCapitalI]", "3"], 
          RowBox[{
           SubscriptBox["y", "n"], "\[CenterDot]", 
           SubscriptBox["y", "n"]}]}], "-", 
         RowBox[{
          SubscriptBox["y", "n"], "\[CircleTimes]", 
          SubscriptBox["y", "n"]}]}], ")"}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{"2", 
        RowBox[{
         SubscriptBox["y", "n"], "(", 
         RowBox[{
          SubscriptBox["\[DoubleStruckCapitalI]", "3"], "\[CircleTimes]", 
          SubscriptBox["\[DoubleStruckCapitalI]", "3"]}], ")"}]}], "-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["y", "n"], "\[CircleTimes]", 
          SubscriptBox["\[DoubleStruckCapitalI]", "3"]}], "+", 
         RowBox[{
          SubscriptBox["\[DoubleStruckCapitalI]", "3"], "\[CircleTimes]", 
          SubscriptBox["y", "n"]}]}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811288379596574*^9, 3.811288468324691*^9}, {
   3.811288522066267*^9, 3.811288549448701*^9}, {3.8112887015078278`*^9, 
   3.8112887581844893`*^9}, {3.811294417146367*^9, 3.8112945080629787`*^9}, {
   3.811294611102447*^9, 3.811294742633875*^9}, {3.811294794359651*^9, 
   3.811294829651923*^9}, {3.811294902248225*^9, 3.811294939772603*^9}, 
   3.811295097345562*^9, {3.811295143903736*^9, 3.811295151678769*^9}, {
   3.811295486909441*^9, 3.811295570296576*^9}, 3.811295790754738*^9, {
   3.811295942050109*^9, 3.811295957269919*^9}, {3.8112960009376574`*^9, 
   3.811296018916873*^9}, 3.8112961243307047`*^9, {3.811296173088591*^9, 
   3.811296236778126*^9}, {3.811296439974661*^9, 3.811296461153002*^9}, {
   3.811296550723423*^9, 3.8112966141771307`*^9}, {3.8112968032606287`*^9, 
   3.81129680636027*^9}, {3.81129819880342*^9, 3.81129824840131*^9}, {
   3.811298283799028*^9, 3.811298288174634*^9}, {3.811298763481085*^9, 
   3.8112987751361313`*^9}, 
   3.8113003554273157`*^9},ExpressionUUID->"7e797992-015f-47f4-ae63-\
27726642bcce"],

Cell[TextData[{
 "where we\[CloseCurlyQuote]ve got one non-standard notation. The term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "n"], "\[CircleTimes]", 
    SubscriptBox["\[DoubleStruckCapitalI]", "3"]}], TraditionalForm]],
  CellChangeTimes->{{3.811288379596574*^9, 3.811288468324691*^9}, {
    3.811288522066267*^9, 3.811288549448701*^9}, {3.8112887015078278`*^9, 
    3.8112887581844893`*^9}, {3.811294417146367*^9, 3.8112945080629787`*^9}, {
    3.811294611102447*^9, 3.811294742633875*^9}, {3.811294794359651*^9, 
    3.811294829651923*^9}, {3.811294902248225*^9, 3.811294939772603*^9}, 
    3.811295097345562*^9, {3.811295143903736*^9, 3.811295151678769*^9}, {
    3.811295486909441*^9, 3.811295570296576*^9}, 3.811295790754738*^9, {
    3.811295942050109*^9, 3.811295957269919*^9}, {3.8112960009376574`*^9, 
    3.811296018916873*^9}, 3.8112961243307047`*^9, {3.811296173088591*^9, 
    3.811296236778126*^9}, {3.811296439974661*^9, 3.811296461153002*^9}, {
    3.811296550723423*^9, 3.8112966141771307`*^9}, {3.8112968032606287`*^9, 
    3.81129680636027*^9}},ExpressionUUID->
  "8def841b-0185-4440-9839-d7f194167292"],
 " should be read to mean the vector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["y", "n"], "\[CircleTimes]", 
      SubscriptBox[
       RowBox[{"(", 
        SubscriptBox["\[DoubleStruckCapitalI]", "3"], ")"}], "i"]}], ")"}], 
    "i"], TraditionalForm]],ExpressionUUID->
  "72b74329-b3cc-4012-a05e-06011fc9ecd7"],
 ". I chose to write it this way because this is easy to implement in modern \
numerical programming languages. Your milage may vary on this, though. Worth \
also noting that if your language supports high-dimensional transpositions, \
we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.811298250360269*^9, 3.811298371447867*^9}, {
  3.811298782105667*^9, 3.811298798607203*^9}, {3.811356511241638*^9, 
  3.811356522163973*^9}, {3.811356563996756*^9, 3.8113565801159163`*^9}, {
  3.811357260308195*^9, 
  3.811357320835672*^9}},ExpressionUUID->"f9bdbb44-7221-4a1b-a38b-\
5ad622e65bae"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["y", "n"], "\[CircleTimes]", 
    SubscriptBox["\[DoubleStruckCapitalI]", "3"]}], "=", 
   RowBox[{
    SubscriptBox["\[DoubleStruckCapitalI]", "3"], "\[CircleTimes]", 
    SuperscriptBox[
     SubscriptBox["y", "n"], 
     RowBox[{"(", 
      RowBox[{"1", ",", " ", "3", ",", " ", "2"}], ")"}]]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8113572855289087`*^9, 3.811357286651847*^9}, {
  3.8113573265617523`*^9, 
  3.811357336212159*^9}},ExpressionUUID->"2c540bc8-f785-4904-865e-\
ab5b667dac9f"],

Cell["\<\
where the superscripted (1, 3, 2) indicates that we transposed the final two \
axes of the tensor.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.811357337844913*^9, 
  3.811357356710902*^9}},ExpressionUUID->"2f3d3f48-8ba4-4936-ab88-\
c6847a03d13b"],

Cell["\<\
With this out of the way, the second derivative tensor is actually pretty \
straightforward and actually has no dependence on the coordinates themselves \
(this because the products & moments of inertia are quadratic terms)\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8112967885911083`*^9, 3.811296798862071*^9}, {
  3.811298413108313*^9, 3.811298456136338*^9}, {3.811298526462881*^9, 
  3.811298579073516*^9}},ExpressionUUID->"0e43cfcd-a8d2-457c-b6ed-\
8fc04ae2f3c6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox["\[PartialD]", 
     RowBox[{
      RowBox[{"\[PartialD]", 
       SubscriptBox["y", "n"]}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["y", "m"]}]}]], 
    SubscriptBox["I", "0"]}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[DoubleStruckCapitalI]", "3"], "\[CircleTimes]", 
         SubscriptBox["\[DoubleStruckCapitalI]", "3"]}], ")"}]}], "-", 
      RowBox[{"(", " ", 
       RowBox[{
        SubscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[DoubleStruckCapitalI]", "3"], "\[CircleTimes]", 
           SubscriptBox[
            RowBox[{"(", 
             SubscriptBox["\[DoubleStruckCapitalI]", "3"], ")"}], "i"]}], 
          ")"}], "i"], " ", "+", "  ", 
        SuperscriptBox[
         SubscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[DoubleStruckCapitalI]", "3"], "\[CircleTimes]", 
            SubscriptBox[
             RowBox[{"(", 
              SubscriptBox["\[DoubleStruckCapitalI]", "3"], ")"}], "i"]}], 
           ")"}], "i"], 
         RowBox[{"(", 
          RowBox[{"1", ",", "2", ",", "4", ",", "3"}], ")"}]]}], ")"}]}], 
     ")"}], 
    SubscriptBox["\[Delta]", 
     RowBox[{"n", "\[InvisibleSpace]", "m"}]]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811298437036231*^9, 3.81129851015005*^9}, {
  3.811298597243635*^9, 3.811298599033636*^9}, {3.811299180847014*^9, 
  3.8112991854554996`*^9}, {3.811299665535399*^9, 3.8112997351890593`*^9}, {
  3.811300347881453*^9, 
  3.811300351398254*^9}},ExpressionUUID->"1b756088-1317-4208-9ac5-\
9c30b96cfa36"],

Cell[TextData[{
 "where again, totally weird notation, but ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[DoubleStruckCapitalI]", "3"], "\[CircleTimes]", 
      SubscriptBox[
       RowBox[{"(", 
        SubscriptBox["\[DoubleStruckCapitalI]", "3"], ")"}], "i"]}], ")"}], 
    "i"], TraditionalForm]],
  CellChangeTimes->{{3.811298437036231*^9, 3.81129851015005*^9}, {
   3.811298597243635*^9, 3.811298599033636*^9}, {3.811299180847014*^9, 
   3.8112991854554996`*^9}, {3.811299665535399*^9, 3.8112997351890593`*^9}},
  ExpressionUUID->"8d29842e-4ec9-4cdc-b554-c223a1c1f2e2"],
 " is the same kind of vector of outer products as before and the (1,2,4,3) \
exponent just means transpose the final two axes in the tensor. Not gonna \
deny that it\[CloseCurlyQuote]s not intuitive notation, but it\
\[CloseCurlyQuote]s easy to implement and that\[CloseCurlyQuote]s what really \
matters. Importantly, this also means that the third derivative of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["I", "0"], TraditionalForm]],ExpressionUUID->
  "31a9c54c-a538-4e25-a576-de3569d3351f"],
 " is identically zero"
}], "ExpositoryText",
 CellChangeTimes->{{3.811299737542152*^9, 3.811299846123177*^9}, {
  3.833032918689438*^9, 
  3.833032954421556*^9}},ExpressionUUID->"e48effa6-cc92-4318-8e34-\
958128b2c4f1"],

Cell["\<\
The final component that we need to think about how to handle is\
\>", "ExpositoryText",
 CellChangeTimes->{{3.811299865085335*^9, 
  3.811299890612298*^9}},ExpressionUUID->"5a908ad1-1a22-4e1e-a2a3-\
d10b7bfbda74"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox["\[PartialD]", 
     RowBox[{"\[PartialD]", 
      SubscriptBox["q", "j"]}]], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{"(", 
       SuperscriptBox[
        SubscriptBox["I", "0"], 
        RowBox[{"-", "1"}]], ")"}], ")"}], "j"]}], "=", 
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Del]", "Q"], 
      RowBox[{"(", 
       SuperscriptBox[
        SubscriptBox["I", "0"], 
        RowBox[{"-", "1"}]], ")"}]}], ")"}], 
    RowBox[{"j", "\[InvisibleSpace]", "j"}]]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8112998919429407`*^9, 3.811299926276101*^9}, {
  3.811300301293974*^9, 
  3.811300344795866*^9}},ExpressionUUID->"c093f2c7-c678-41a7-b255-\
1b6cd03c06bf"],

Cell[TextData[{
 "Happily, using the formula for the derivative of a matrix inverse from ",
 ButtonBox["The Matrix Cookbook",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.ics.uci.edu/~welling/teaching/KernelsICS273B/\
MatrixCookBook.pdf"], None},
  ButtonNote->
   "https://www.ics.uci.edu/~welling/teaching/KernelsICS273B/MatrixCookBook.\
pdf"],
 " we can actually formulate this without too much trouble. They give use"
}], "ExpositoryText",
 CellChangeTimes->{{3.8113001648485727`*^9, 
  3.8113002289177856`*^9}},ExpressionUUID->"6170b286-f15c-4431-8232-\
a0c6498d236f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"\[PartialD]", 
     SuperscriptBox["Y", 
      RowBox[{"-", "1"}]]}], 
    RowBox[{"\[PartialD]", "x"}]], "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      SuperscriptBox["Y", 
       RowBox[{"-", "1"}]], ")"}]}], 
    FractionBox[
     RowBox[{"\[PartialD]", "Y"}], 
     RowBox[{"\[PartialD]", "x"}]], 
    SuperscriptBox["Y", 
     RowBox[{"-", "1"}]]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811300185137706*^9, 3.8113001941645937`*^9}, {
  3.8113002308530397`*^9, 
  3.811300251807925*^9}},ExpressionUUID->"e8530dd7-9f99-4a6e-b937-\
036ba41a18f6"],

Cell["or explicitly", "ExpositoryText",
 CellChangeTimes->{{3.811343391925273*^9, 
  3.811343399587974*^9}},ExpressionUUID->"3553dbdf-b0e2-4b01-aa16-\
c3aeb56c05a2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"\[PartialD]", 
     SuperscriptBox[
      SubscriptBox["I", "0"], 
      RowBox[{"-", "1"}]]}], 
    RowBox[{"\[PartialD]", 
     SubscriptBox["y", "n"]}]], "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      SuperscriptBox[
       SubscriptBox["I", "0"], 
       RowBox[{"-", "1"}]], ")"}]}], 
    FractionBox[
     RowBox[{"\[PartialD]", 
      SubscriptBox["I", "0"]}], 
     RowBox[{"\[PartialD]", 
      SubscriptBox["y", "n"]}]], 
    SuperscriptBox[
     SubscriptBox["I", "0"], 
     RowBox[{"-", "1"}]]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811343396078545*^9, 
  3.811343396764889*^9}},ExpressionUUID->"07227a7d-fab5-4478-84a3-\
1a131275f10e"],

Cell["\<\
and so generalizing to the gradient with respect to the normal modes we have\
\>", "ExpositoryText",
 CellChangeTimes->{{3.811300260206315*^9, 3.811300281325179*^9}, {
  3.811300316028483*^9, 
  3.8113003170902433`*^9}},ExpressionUUID->"3897933c-d461-4a0a-8c0b-\
f03db7708006"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", "Q"], 
    RowBox[{"(", 
     SuperscriptBox[
      SubscriptBox["I", "0"], 
      RowBox[{"-", "1"}]], ")"}]}], "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      SuperscriptBox[
       SubscriptBox["I", "0"], 
       RowBox[{"-", "1"}]], ")"}]}], 
    RowBox[{"\[LeftAngleBracket]", "2", "\[RightAngleBracket]"}], 
    RowBox[{
     SubscriptBox["\[Del]", "Q"], 
     SubscriptBox["I", "0"]}], "\[VeryThinSpace]", 
    SuperscriptBox[
     SubscriptBox["I", "0"], 
     RowBox[{"-", "1"}]]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811300282383564*^9, 3.811300282387586*^9}, {
  3.81130032534903*^9, 3.8113003314080143`*^9}, {3.8113004734076157`*^9, 
  3.811300520799053*^9}},ExpressionUUID->"63b92c8c-8123-4dbd-a946-\
14c9d7cd414b"],

Cell[TextData[{
 "which justifies all of the effort that we put into writing down those \
expressions for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["\[PartialD]", 
     RowBox[{"\[PartialD]", 
      SubscriptBox["y", "n"]}]], 
    SubscriptBox["I", "0"]}], TraditionalForm]],
