Cell[CellGroupData[{

Cell["Explicit Expansion", "Subsubsubsection",
 CellChangeTimes->{{3.828051260819944*^9, 
  3.828051265005557*^9}},ExpressionUUID->"95821de9-d6f7-4086-b188-\
54a9314890f9"],

Cell[TextData[{
 "For what comes next, we\[CloseCurlyQuote]ll also want to show how to write \
down ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["A", "n", 
    RowBox[{"(", "k", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.827707029211122*^9, 3.827707051809273*^9}, {
   3.8277071012478857`*^9, 3.827707103590711*^9}},ExpressionUUID->
  "9f36d80c-92ff-4458-8ac2-50058c25724a"],
 " in terms of energy and Hamiltonian terms. We start by noting that"
}], "ExpositoryText",
 CellChangeTimes->{{3.827713612427271*^9, 
  3.827713664474414*^9}},ExpressionUUID->"28c822d2-848c-4e20-b152-\
72be3e3dcf39"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["A", "n", 
       RowBox[{"(", "k", ")"}]], "=", 
