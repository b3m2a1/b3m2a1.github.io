b43588fcab1e"],

Cell[TextData[{
 "We\[CloseCurlyQuote]ll be ",
 StyleBox["veeeeery",
  FontSlant->"Italic"],
 " vague for now and assume that up through order ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "63e150bc-8133-4388-8a95-204d4305e186"],
 ", for any ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "c41f00a7-b84a-4a52-a078-debd198c1cce"],
 ", there\[CloseCurlyQuote]s a set of ",
 Cell[BoxData[
