660902512a18"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["R", 
      RowBox[{"(", 
       RowBox[{"i", "+", "2"}], ")"}]]], 
    SubscriptBox["V", "R"]}], " ", "=", " ", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{"p", "\[Element]", 
      RowBox[{"\[ScriptCapitalP]", "(", 
       RowBox[{
        RowBox[{"i", "+", "2"}], ",", " ", "2"}], ")"}]}]], " ", 
    RowBox[{
     SubscriptBox["w", "p"], " ", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{"t", "\[Element]", 
        RowBox[{"\[CapitalPi]", "(", "p", ")"}]}]], " ", 
      SuperscriptBox[
       RowBox[{"[", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[Del]", 
           SuperscriptBox["R", 
            SubscriptBox["p", "1"]]], "Q"}], 
         RowBox[{"\[LeftAngleBracket]", 
          RowBox[{
           SubscriptBox["p", "1"], ",", " ", "2"}], "\[RightAngleBracket]"}], 
         
         RowBox[{
          SubscriptBox["\[Del]", 
           SuperscriptBox["R", 
            SubscriptBox["p", "2"]]], "Q"}], 
         RowBox[{"\[LeftAngleBracket]", 
          RowBox[{
           SubscriptBox["p", "l"], ",", " ", "1"}], "\[RightAngleBracket]"}], 
         
         SubscriptBox["F", "Q"]}], "]"}], 
       RowBox[{"(", "t", ")"}]]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.919769045868779*^9, 3.919769093068997*^9}, {
   3.919769211578658*^9, 3.919769241368848*^9}, 
   3.919769360737301*^9},ExpressionUUID->"d796e2f9-1293-47f7-8464-\
7e88c99a359e"],

Cell[TextData[{
 "now we can note that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", "Q"], "=", 
    RowBox[{
     SubscriptBox["G", "Q"], "=", 
     RowBox[{
      SubscriptBox["G", "R"], "=", 
      SubscriptBox["F", "R"]}]}]}], TraditionalForm]], "ExpositoryTextInline",
  
  FormatType->TraditionalForm,ExpressionUUID->
  "a18c88fa-25e4-4442-8203-b2462d1ae5b5"],
 " because we have dimensionless normal modes"
}], "ExpositoryText",
 CellChangeTimes->{{3.919769235673192*^9, 
  3.91976928739121*^9}},ExpressionUUID->"b32d9557-a4ea-48b2-9229-\
a0ed90f9d300"],

