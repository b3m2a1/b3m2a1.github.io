          RowBox[{"k", "-", "1"}]], " ", 
         RowBox[{
          RowBox[{"S", "(", 
           SuperscriptBox["H", 
            RowBox[{"(", 
             RowBox[{"k", "-", "i"}], ")"}]], ")"}], "\[CircleTimes]", 
          RowBox[{"S", "(", 
           SuperscriptBox["G", 
            RowBox[{"(", "i", ")"}]], ")"}]}]}], " ", ")"}], " ", "\[Union]", 
       " ", 
       RowBox[{
        RowBox[{"(", " ", 
         RowBox[{
          UnderoverscriptBox["\[Union]", 
