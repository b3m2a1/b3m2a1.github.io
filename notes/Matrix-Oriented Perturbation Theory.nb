       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "1", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1", ",", " ", "2"}], "}"}]}], "}"}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["q", "i"], 
