        RowBox[{"(", 
          RowBox[{"k", "+", "1"}], ")"}]]},
      "Ket"]}], "=", "\[DoubleStruckZero]"}], TraditionalForm]],
  ExpressionUUID->"b4d7f1dc-dc52-4d63-8e96-7ac445d3e387"],
 " and pull out the ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "544acfd4-18a1-48c6-834a-10aa4c5871f5"],
 " term to give"
}], "ExpositoryText",
