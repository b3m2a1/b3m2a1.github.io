Cell[CellGroupData[{

Cell["G-Matrix with coordinate transformations", "Section",
 CellChangeTimes->{{3.854640831426543*^9, 
  3.854640844558236*^9}},ExpressionUUID->"05c7ab59-c882-4746-a9c0-\
57f282620c1d"],

Cell[TextData[{
 "Assuming we\[CloseCurlyQuote]ve calculate the G matrix for some set of \
coordinates, ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]],ExpressionUUID->
  "ecbf7619-0985-41ef-b20c-d456b4c293ee"],
 ", as"
}], "Text",
 CellChangeTimes->{{3.854640848974399*^9, 3.8546408505305233`*^9}, {
  3.8615316942848597`*^9, 3.861531717133132*^9}, {3.8616021979183197`*^9, 
  3.861602200929288*^9}},ExpressionUUID->"df71d2aa-ec0d-443b-ab0e-\
6ab55e88d545"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["G", "R"], " ", "=", " ", 
   RowBox[{
    SuperscriptBox["J", "T"], "J"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.854640854158038*^9, 3.854640858903159*^9}, {
  3.861602218813323*^9, 
  3.861602219330557*^9}},ExpressionUUID->"5eb8c040-7846-486b-bed6-\
081778a72925"],

Cell[TextData[{
 "if we want to translate this to a different coordinate system, ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]],ExpressionUUID->
  "5e0efaa5-bf3d-46f9-9b86-8059e2d5fa2c"],
 ", we need to recognize that"
}], "ExpositoryText",
 CellChangeTimes->{{3.854640861665509*^9, 3.854640877312853*^9}, 
   3.861531725381901*^9, {3.861602205237377*^9, 
   3.861602208487204*^9}},ExpressionUUID->"fbf1001f-d58d-4a77-b238-\
e560cc7f77ed"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", "X"], "\[InvisibleSpace]", "Q"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "X"], "\[InvisibleSpace]", "R"}], 
    RowBox[{
     SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", "Q"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8546408811250563`*^9, 3.854640945751234*^9}, {
  3.861602134024878*^9, 
  3.861602147174506*^9}},ExpressionUUID->"eeda766a-f23d-488b-be76-\
a2089be33a3f"],

Cell["giving us", "ExpositoryText",
 CellChangeTimes->{{3.85464096615552*^9, 
  3.854640967999457*^9}},ExpressionUUID->"cfb23261-ffc7-46b9-986e-\
236fc5730e71"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["G", "Q"], " ", "=", " ", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[Del]", "X"], "\[InvisibleSpace]", "Q"}], ")"}], 
         "T"], "\[InvisibleSpace]", 
        RowBox[{
         SubscriptBox["\[Del]", "X"], "\[InvisibleSpace]", "Q"}]}], " ", "=", 
       " ", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            SubscriptBox["\[Del]", "X"], "\[InvisibleSpace]", "R"}], 
           RowBox[{
            SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", "Q"}]}], ")"}], 
         "T"], "\[InvisibleSpace]", 
        RowBox[{
         SubscriptBox["\[Del]", "X"], "\[InvisibleSpace]", "R"}], 
        RowBox[{
         SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", "Q"}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", 
        SuperscriptBox[
         RowBox[{
          SuperscriptBox["Q", "T"], "(", 
          RowBox[{
           SubscriptBox["\[Del]", "X"], "\[InvisibleSpace]", "R"}], ")"}], 
         "T"]}], "\[InvisibleSpace]", 
       RowBox[{
        SubscriptBox["\[Del]", "X"], "\[InvisibleSpace]", "R"}], 
       RowBox[{
        SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", "Q"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", 
        SuperscriptBox["Q", "T"]}], 
       SuperscriptBox["J", "T"], "\[InvisibleSpace]", "J", 
       RowBox[{
        SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", "Q"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", 
        SuperscriptBox["Q", "T"]}], 
       SubscriptBox["G", "R"], 
       RowBox[{
        SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", "Q"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.861585261474105*^9, 3.861585333974368*^9}, {
   3.861585841758322*^9, 3.861585843091571*^9}, {3.861602128410225*^9, 
   3.8616021804233522`*^9}, {3.861602210681715*^9, 3.86160226971653*^9}, 
   3.861603934199746*^9, 
   3.861914297927623*^9},ExpressionUUID->"4b6da7df-6279-43b9-b6f2-\
45df93c4ef23"],

Cell[TextData[{
 "Alternately if we\[CloseCurlyQuote]re calculating ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["G",
     FontSlant->"Plain"], 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "26f5b0f9-c55b-47ad-969c-c8eba19f8da3"],
 " by default we start with"
}], "ExpositoryText",
 CellChangeTimes->{{3.8616017900298347`*^9, 3.861601797743333*^9}, {
   3.861601828596857*^9, 3.861601838261095*^9}, {3.861602296437495*^9, 
   3.861602297740573*^9}, 
   3.862110894456459*^9},ExpressionUUID->"35f1e100-62c8-4a18-8640-\
14923675417c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["G", 
    RowBox[{"-", "1"}]], "=", 
   SuperscriptBox[
    RowBox[{
     SuperscriptBox["J", 
      RowBox[{"-", "1"}]], "(", 
     SuperscriptBox["J", 
      RowBox[{"-", "1"}]], ")"}], "T"]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.861601831109693*^9, 3.86160189123383*^9}, {
  3.861602282375594*^9, 
  3.861602282623425*^9}},ExpressionUUID->"abc91cf7-dd6c-4a88-b201-\
cf473a46fade"],

Cell["and we can work from there in a similar way", "ExpositoryText",
 CellChangeTimes->{{3.861602289218512*^9, 
  3.8616023041167517`*^9}},ExpressionUUID->"b5e40518-2730-4239-8017-\
5cd4e4a3cf64"],

Cell[CellGroupData[{

Cell["Generalization", "Subsubsection",
 CellChangeTimes->{{3.919717068103739*^9, 
  3.9197170715327053`*^9}},ExpressionUUID->"dac17460-e291-4370-a882-\
190702d07f44"],

Cell["We\[CloseCurlyQuote]ll start by looking at derivatives w.r.t a mixed \
form", "ExpositoryText",
 CellChangeTimes->{{3.919717227760687*^9, 
  3.919717247718226*^9}},ExpressionUUID->"eaca5569-56b5-4efb-95fb-\
987bb9e2cb8b"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["G", "R"], " ", "=", " ", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "X"], "R"}], 
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{"1", ",", "1"}], "\[RightAngleBracket]"}], 
       RowBox[{
        SubscriptBox["\[Del]", "X"], "R"}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "Q"], 
       SubscriptBox["G", "R"]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "Q"], "R"}], 
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{"2", ",", "1"}], "\[RightAngleBracket]"}], 
       RowBox[{
        SubscriptBox["\[Del]", "R"], 
        SubscriptBox["G", "R"]}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["Q", "2"]], "\[InvisibleSpace]", 
       SubscriptBox["G", "R"]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["Q", "2"]], "R"}], 
        RowBox[{"\[LeftAngleBracket]", 
         RowBox[{"2", ",", "1"}], "\[RightAngleBracket]"}], 
        RowBox[{
         SubscriptBox["\[Del]", "R"], 
         SubscriptBox["G", "R"]}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", "Q"], "R"}], 
        RowBox[{"\[LeftAngleBracket]", 
         RowBox[{"2", ",", "1"}], "\[RightAngleBracket]"}], 
        RowBox[{
         SubscriptBox["\[Del]", "Q"], "R"}], 
        RowBox[{"\[LeftAngleBracket]", 
         RowBox[{"2", ",", "2"}], "\[RightAngleBracket]"}], 
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["R", "2"]], 
         SubscriptBox["G", "R"], " "}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.919717073891959*^9, 
  3.919717217812829*^9}},ExpressionUUID->"d3fbc840-ab81-44b8-8f51-\
225d3beab5e4"],

Cell["\<\
from this it should hopefully be clear that this acts pretty much just like a \
regular derivative conversion, i.e. we get\
\>", "ExpositoryText",
 CellChangeTimes->{{3.919717250635263*^9, 
  3.9197172782381163`*^9}},ExpressionUUID->"7883157d-d21b-4031-a25e-\
eaa0e762219a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["Q", "n"]], 
    SubscriptBox["G", "R"]}], " ", "=", " ", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{"p", "\[Element]", 
      RowBox[{"\[ScriptCapitalP]", "(", "n", ")"}]}]], " ", 
    RowBox[{
     SubscriptBox["w", "p"], " ", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{"t", "\[Element]", 
        RowBox[{"\[CapitalPi]", "(", "p", ")"}]}]], " ", 
      SuperscriptBox[
       RowBox[{"[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            SubscriptBox["\[Del]", 
             SuperscriptBox["Q", 
              SubscriptBox["p", "1"]]], "R"}], 
           RowBox[{"\[LeftAngleBracket]", 
            RowBox[{
             SubscriptBox["p", "1"], ",", " ", "l"}], 
            "\[RightAngleBracket]"}]}], "..."}], 
         RowBox[{
          SubscriptBox["\[Del]", 
           SuperscriptBox["Q", 
            SubscriptBox["p", "l"]]], "R"}], 
         RowBox[{"\[LeftAngleBracket]", 
          RowBox[{"n", ",", " ", "1"}], "\[RightAngleBracket]"}], 
         RowBox[{
          SubscriptBox["\[Del]", 
           SuperscriptBox["R", "l"]], 
          SubscriptBox["G", "R"]}]}], "]"}], 
       RowBox[{"(", "t", ")"}]]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.919533746175418*^9, 3.919533864611747*^9}, {
  3.919534020262042*^9, 3.9195340274032497`*^9}, {3.919717297723082*^9, 
  3.919717314794757*^9}},ExpressionUUID->"d301950e-93ff-41fb-9411-\
eb1713e648c9"],

Cell["which is tedious but well defined to evaluate", "ExpositoryText",
 CellChangeTimes->{{3.919717317603825*^9, 
  3.919717328311393*^9}},ExpressionUUID->"725af44e-396e-4c93-a492-\
ce844cfb923d"],

Cell["Then we can consider starting from the expression", "ExpositoryText",
 CellChangeTimes->{{3.919717341025652*^9, 
  3.9197173569964533`*^9}},ExpressionUUID->"4a4ac576-45a2-4d35-9557-\
abfc2a21c34b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["G", "Q"], " ", "=", " ", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", "Q"}], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"1", ",", "2"}], "\[RightAngleBracket]"}], 
    RowBox[{
     SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", "Q"}], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"1", ",", "1"}], "\[RightAngleBracket]"}], 
    SubscriptBox["G", "R"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.861585261474105*^9, 3.861585333974368*^9}, {
   3.861585841758322*^9, 3.861585843091571*^9}, {3.861602128410225*^9, 
   3.8616021804233522`*^9}, {3.861602210681715*^9, 3.86160226971653*^9}, 
   3.861603934199746*^9, 3.861914297927623*^9, {3.919717369597769*^9, 
   3.919717414243222*^9}},ExpressionUUID->"052f1f59-fcb1-4cf3-88b6-\
1ac927536190"],

Cell["\<\
which is just going to be annoying, as we\[CloseCurlyQuote]ll end up with \
stuff like\
\>", "ExpositoryText",
 CellChangeTimes->{{3.919717419374511*^9, 
  3.9197174394270487`*^9}},ExpressionUUID->"ebc6413b-d09b-4dd4-940b-\
2fb738ea7f22"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", "Q"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", "Q"}], ")"}]}], " ", 
   "=", " ", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "Q"], "R"}], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"2", ",", "1"}], "\[RightAngleBracket]"}], 
    RowBox[{
     SubscriptBox["\[Del]", 
      SuperscriptBox["R", "2"]], "\[InvisibleSpace]", "Q"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.919717446984544*^9, 
  3.919717478766507*^9}},ExpressionUUID->"c284d89e-4d1e-4d6a-a4e3-\
f65127796c54"],

Cell["along with expressions like", "ExpositoryText",
 CellChangeTimes->{{3.919733668794136*^9, 
  3.919733672341755*^9}},ExpressionUUID->"3a0f9e02-e5c5-4cb1-be25-\
23119a067e0c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", "Q"], 
    SubscriptBox["G", "Q"]}], " ", "=", " ", 
   RowBox[{"...", " ", "+", " ", 
    SuperscriptBox[
     RowBox[{"[", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", "Q"}], 
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{"1", ",", "3"}], "\[RightAngleBracket]"}], 
       RowBox[{
        SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", "Q"}], 
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{"1", ",", "2"}], "\[RightAngleBracket]"}], 
       RowBox[{
        SubscriptBox["\[Del]", "Q"], 
        SubscriptBox["G", "R"]}]}], "]"}], 
     RowBox[{"3", ":", "1"}]]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.9197336781058197`*^9, 3.919733710694491*^9}, {
  3.919733758735299*^9, 3.9197337766524763`*^9}, {3.919733940518683*^9, 
  3.919733942794018*^9}},ExpressionUUID->"42b585f2-2388-4203-a039-\
de3e99a3fd8e"],

Cell["but we should end up with expressions like", "ExpositoryText",
 CellChangeTimes->{{3.9197337314211884`*^9, 
  3.919733740138516*^9}},ExpressionUUID->"5d60d129-aeec-4ff8-8fe3-\
1f8ae7a8a0da"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["Q", "n"]], 
       SubscriptBox["G", "Q"]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"k", "=", "0"}], "n"], " ", 
         RowBox[{
          UnderscriptBox["\[Sum]", 
           RowBox[{"s", "=", 
            RowBox[{"\[ScriptCapitalP]", "(", 
             RowBox[{"n", "-", "k"}], ")"}]}]], " ", 
          SubscriptBox["\[Del]", "Q"]}]}], "..."}], 
       RowBox[{"\[LeftAngleBracket]", "...", "\[RightAngleBracket]"}], 
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox["Q", "k"]], 
        SubscriptBox["G", "R"]}], 
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{"\[LeftAngleBracket]", "...", "\[RightAngleBracket]"}], 
        "\[RightAngleBracket]"}], 
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox["R", 
          RowBox[{" \[VeryThinSpace]", 
           SubscriptBox["s", "1"]}]]], "\[InvisibleSpace]", "Q"}], 
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{"\[LeftAngleBracket]", "...", "\[RightAngleBracket]"}], 
        "\[RightAngleBracket]"}], 
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox["R", 
          RowBox[{"\[VeryThinSpace]", 
           SubscriptBox["s", "2"]}]]], "\[InvisibleSpace]", "Q"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"k", "=", "0"}], "n"], " ", 
         RowBox[{
          UnderscriptBox["\[Sum]", 
           RowBox[{"s", "=", 
            RowBox[{"\[ScriptCapitalP]", "(", 
             RowBox[{"n", "-", "k"}], ")"}]}]], " ", 
          SubscriptBox["\[Del]", "Q"]}]}], "..."}], 
       RowBox[{"\[LeftAngleBracket]", "...", "\[RightAngleBracket]"}], 
       RowBox[{"(", 
        RowBox[{
         UnderscriptBox["\[Sum]", 
          RowBox[{"p", "\[Element]", 
           RowBox[{"\[ScriptCapitalP]", "(", "k", ")"}]}]], " ", 
         RowBox[{
          SubscriptBox["w", "p"], " ", 
          RowBox[{
           UnderscriptBox["\[Sum]", 
            RowBox[{"t", "\[Element]", 
             RowBox[{"\[CapitalPi]", "(", "p", ")"}]}]], " ", 
           SuperscriptBox[
            RowBox[{"[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 SubscriptBox["\[Del]", 
                  SuperscriptBox["Q", 
                   SubscriptBox["p", "1"]]], "R"}], 
                RowBox[{"\[LeftAngleBracket]", 
                 RowBox[{
                  SubscriptBox["p", "1"], ",", " ", "l"}], 
                 "\[RightAngleBracket]"}]}], "..."}], 
              RowBox[{
               SubscriptBox["\[Del]", 
                SuperscriptBox["Q", 
                 SubscriptBox["p", "l"]]], "R"}], 
              RowBox[{"\[LeftAngleBracket]", 
               RowBox[{"n", ",", " ", "1"}], "\[RightAngleBracket]"}], 
              RowBox[{
               SubscriptBox["\[Del]", 
                SuperscriptBox["R", "l"]], 
               SubscriptBox["G", "R"]}]}], "]"}], 
            RowBox[{"(", "t", ")"}]]}]}]}], ")"}], 
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{"\[LeftAngleBracket]", "...", "\[RightAngleBracket]"}], 
        "\[RightAngleBracket]"}], 
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox["R", 
          RowBox[{" \[VeryThinSpace]", 
           SubscriptBox["s", "1"]}]]], "\[InvisibleSpace]", "Q"}], 
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{"\[LeftAngleBracket]", "...", "\[RightAngleBracket]"}], 
        "\[RightAngleBracket]"}], 
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox["R", 
          RowBox[{"\[VeryThinSpace]", 
           SubscriptBox["s", "2"]}]]], "\[InvisibleSpace]", "Q"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.919533746175418*^9, 3.919533864611747*^9}, {
   3.919534020262042*^9, 3.9195340274032497`*^9}, {3.919717297723082*^9, 
   3.919717314794757*^9}, 3.9197337972827883`*^9, {3.919733829656877*^9, 
   3.91973392589645*^9}, {3.919733958868677*^9, 3.9197339769305353`*^9}, {
   3.919734013030863*^9, 3.9197341406568327`*^9}, {3.919734178027514*^9, 
   3.9197342191146507`*^9}},ExpressionUUID->"2f2f1f75-1e02-45c6-bdf2-\
a53db51ade37"],

Cell["where \[LeftAngleBracket]\[LeftAngleBracket]...\[RightAngleBracket]\
\[RightAngleBracket] is just a right-associative version of \
\[LeftAngleBracket]...\[RightAngleBracket]", "ExpositoryText",
 CellChangeTimes->{{3.919734069312059*^9, 
  3.91973408295774*^9}},ExpressionUUID->"510378cf-b4ab-41d6-88d7-\
6b3affba3cd4"],

Cell["Basically we\[CloseCurlyQuote]ll get transpositions of terms of the \
form", "ExpositoryText",
 CellChangeTimes->{{3.9197341436309*^9, 3.919734147168879*^9}, {
  3.919734197117779*^9, 3.9197341990247583`*^9}, {3.919734301180979*^9, 
  3.91973430670079*^9}},ExpressionUUID->"01d8ff4c-2de3-419d-ab12-\
1693cc7d6734"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["Q", "n"]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", "Q"}], 
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{"1", ",", "2"}], "\[RightAngleBracket]"}], 
      RowBox[{
       SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", "Q"}], 
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{"1", ",", "1"}], "\[RightAngleBracket]"}]}], ")"}]}], 
   RowBox[{"\[LeftAngleBracket]", "...", "\[RightAngleBracket]"}], 
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["Q", "k"]], 
    SubscriptBox["G", "R"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.919734153357296*^9, 3.919734170909169*^9}, {
  3.91973429133718*^9, 
  3.9197342968616056`*^9}},ExpressionUUID->"23fdf4c1-bf32-464d-b4d5-\
f6943fb5bfee"],

Cell[TextData[{
 "Then the hope is that by using the fact that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "Q"], "R"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Del]", "R"], "Q"}], " ", "=", " ", "I"}]}], 
   TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "fee727ec-08f1-4a62-a483-188a979186fa"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["G", "R"], " ", "=", " ", 
    RowBox[{
     SubscriptBox["F", "R"], " ", "=", " ", 
     RowBox[{
      SubscriptBox["G", "Q"], " ", "=", " ", 
      SubscriptBox["F", "Q"]}]}]}], TraditionalForm]], "ExpositoryTextInline",
  
  FormatType->TraditionalForm,ExpressionUUID->
  "4c2ce76f-40a3-47d9-9d8b-477f4a09b1fa"],
 " we can have general expressions of the form"
}], "ExpositoryText",
 CellChangeTimes->{{3.919734310976233*^9, 3.919734329142645*^9}, {
  3.919734378686573*^9, 
  3.919734456326675*^9}},ExpressionUUID->"2167f093-bc2d-4eff-af85-\
a8e7e7dce422"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", "Q"], 
    SubscriptBox["G", "Q"]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "R"], 
     SubscriptBox["G", "R"]}], " ", "+", " ", 
    RowBox[{
     SubscriptBox["\[Del]", "R"], 
     SubscriptBox["F", "R"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.919734389321295*^9, 3.91973441128376*^9}, {
  3.919734461127317*^9, 
  3.9197344619062147`*^9}},ExpressionUUID->"13001c02-550d-4547-8a2f-\
c8ab1bdc5421"],

Cell["which allows us to write", "ExpositoryText",
