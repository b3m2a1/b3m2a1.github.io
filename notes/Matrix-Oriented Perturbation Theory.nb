Cell[CellGroupData[{

Cell["Proper Attempt 1: Assuming Nearly-Degenerate vs. Not", \
"Subsubsubsection",
 CellChangeTimes->{{3.826911384239921*^9, 3.8269113866266403`*^9}, {
  3.826985897170154*^9, 
  3.826985929227664*^9}},ExpressionUUID->"e2bbf79b-b3d4-4381-bf55-\
24465090e9b5"],

Cell[TextData[{
 "We need a good metric to define our error. We will define this as follows, \
given a system with ",
 StyleBox["true",
  FontSlant->"Italic"],
 " degeneracies up to order ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "35db5308-fe73-467a-983b-ac41cd467365"],
 " and a near-degeneracy with error-bound \[Delta]E at order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "+", "1"}], TraditionalForm]],ExpressionUUID->
  "999eef82-4794-4e36-819a-769e27bbe165"],
 ", which just to keep notationally clean we\[CloseCurlyQuote]ll write ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "=", 
    RowBox[{"a", "+", "1"}]}], TraditionalForm]],ExpressionUUID->
  "6106d5df-1dcd-4840-9cd0-d55c26528134"],
 ", we can define the first error in the corrections to the energy by "
}], "ExpositoryText",
 CellChangeTimes->{{3.826911389108779*^9, 3.8269114020607977`*^9}, {
  3.826911509691901*^9, 3.826911634018404*^9}, {3.8269117141114063`*^9, 
  3.826911716120082*^9}, {3.82691183928249*^9, 3.826911849312145*^9}, {
  3.826916428142126*^9, 
  3.8269164801092777`*^9}},ExpressionUUID->"5b3f4464-0c2a-42d1-ae86-\
5fb6e2652f5b"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox["E", 
       RowBox[{"(", "\[Beta]", ")"}]], ",", " ", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["\[Eta]", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"], " ", "\[Element]", "\[AlignmentMarker]", 
       RowBox[{"\[CapitalLambda]", "(", 
        RowBox[{
         SubsuperscriptBox["P", "D", 
          RowBox[{"(", "\[Beta]", ")"}]], 
         SuperscriptBox["\[ScriptCapitalH]", 
          RowBox[{"(", "\[Beta]", ")"}]], 
         SubsuperscriptBox["P", "D", 
          RowBox[{"(", "\[Beta]", ")"}]]}], ")"}]}]}]},
    {
     RowBox[{
      SuperscriptBox["E", 
       RowBox[{"(", "a", ")"}]], ",", " ", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"], " ", "\[Element]", "\[AlignmentMarker]", 
       RowBox[{"\[CapitalLambda]", 
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox["P", "D", 
           RowBox[{"(", "a", ")"}]], 
          SuperscriptBox["\[ScriptCapitalH]", 
           RowBox[{"(", "a", ")"}]], 
          SubsuperscriptBox["P", "D", 
           RowBox[{"(", "a", ")"}]]}], ")"}]}]}]}]},
    {
     RowBox[{
      SuperscriptBox["\[ScriptCapitalE]", 
       RowBox[{"(", 
        RowBox[{"a", "+", "1"}], ")"}]], "=", "\[AlignmentMarker]", 
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], " ", 
        SuperscriptBox["H", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]]}], "+", 
       RowBox[{
        SubsuperscriptBox["J", "a", 
         RowBox[{"(", "1", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}]}]},
    {
     RowBox[{
      RowBox[{"err", "(", 
       SuperscriptBox["E", 
        RowBox[{"(", "\[Beta]", ")"}]], ")"}], "=", "\[AlignmentMarker]", 
      RowBox[{"\[LeftBracketingBar]", 
       RowBox[{
        SuperscriptBox["E", 
         RowBox[{"(", "\[Beta]", ")"}]], "-", 
        SuperscriptBox["\[ScriptCapitalE]", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]]}], "\[RightBracketingBar]"}]}]}
   }], TraditionalForm]], "ExpositoryMathCenteredManuallyAligned",
 CellChangeTimes->{{3.826916052010932*^9, 3.8269160711669817`*^9}, {
  3.826916185485743*^9, 3.8269161973464937`*^9}, {3.826916248866921*^9, 
