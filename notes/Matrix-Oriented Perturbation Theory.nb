  ExpressionUUID->"edc6a133-d4db-4571-bdf8-5f8c0558b47c"],
 " term giving us"
}], "ExpositoryText",
 CellChangeTimes->{{3.825700230104669*^9, 3.825700289942824*^9}, {
  3.8257004238529453`*^9, 
  3.8257004252891903`*^9}},ExpressionUUID->"73ca46b8-7893-426b-8c37-\
