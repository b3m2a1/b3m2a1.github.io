               RowBox[{"\[Beta]", "\[VeryThinSpace]", "n"}]]}], ")"}], 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              SubscriptBox["\[Delta]", 
               RowBox[{"\[Beta]", "\[VeryThinSpace]", "m"}]]}], ")"}]}], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["E", "\[Beta]"], "-", 
              SubscriptBox["E", "n"]}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["E", "\[Beta]"], "-", 
              SubscriptBox["E", "m"]}], ")"}]}]], ")"}], 
         SubsuperscriptBox[
          StyleBox["H",
           FontWeight->"Bold"], 
          RowBox[{"\[Beta]", "\[InvisibleSpace]", "m"}], 
          RowBox[{"(", "i", ")"}]]}]}]}]}]},
    {
     RowBox[{"\[AlignmentMarker]", 
      RowBox[{
       RowBox[{"+", "\[AlignmentMarker]", 
        RowBox[{
         UnderscriptBox["\[Sum]", "\[Alpha]"], 
         RowBox[{
