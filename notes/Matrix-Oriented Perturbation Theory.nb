        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}]}], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      SubscriptBox["E", "n"], 
      RowBox[{"(", "0", ")"}]], 
