Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fgCoeffs", "[", "b_", "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"b", "==", "0"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", "1", "}"}], "}"}], ",", " ", 
        RowBox[{"{", "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"With", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{"baseCoeffs", "=", 
          RowBox[{"Table", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"momC2", "[", 
                 RowBox[{"k", ",", " ", "\[FormalA]", ",", " ", "b"}], "]"}], 
                "//", "Expand"}], "//", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"ReplaceAll", "[", 
                 RowBox[{"#", ",", " ", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], "^", 
                    RowBox[{"(", 
                    RowBox[{"n_", " ", "\[FormalA]"}], ")"}]}], ":>", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"EvenQ", "[", "n", "]"}], ",", " ", "1", ",", " ", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], 
                    RowBox[{"(", "\[FormalA]", ")"}]]}], "]"}]}]}], "]"}], 
                "&"}]}], "//", "\[IndentingNewLine]", 
              RowBox[{"ReplaceAll", "[", 
               RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"-", "1"}], ")"}], 
                 RowBox[{"(", "\[FormalA]", ")"}]], "->", "\[FormalX]"}], 
               "]"}]}], "//", 
             RowBox[{
              RowBox[{"CoefficientList", "[", 
               RowBox[{
                RowBox[{"Expand", "@", "#"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"\[FormalX]", ",", " ", "\[FormalA]"}], "}"}]}], 
               "]"}], "&"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"k", ",", " ", "0", ",", " ", "b"}], "}"}]}], 
           "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"baseCoeffs", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", " ", "1"}], "]"}], "]"}], "//", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{"PadRight", "[", 
              RowBox[{"#", ",", " ", 
               RowBox[{"b", "+", "1"}]}], "]"}], "&"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"baseCoeffs", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", " ", "2"}], "]"}], "]"}], "//", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{"PadRight", "[", 
              RowBox[{"#", ",", " ", 
               RowBox[{"2", "b"}]}], "]"}], "&"}], "]"}]}]}], 
         "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"fgCoeffCore", "[", "b_", "]"}], ":=", "\[IndentingNewLine]", 
     RowBox[{
      SuperscriptBox["2", 
       RowBox[{"2", "b"}]], "*", 
      RowBox[{"(", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"#", ".", 
          RowBox[{"Inverse", "[", 
           RowBox[{"Array", "[", 
            RowBox[{"Binomial", ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"b", "+", "1"}], ",", " ", 
               RowBox[{"b", "+", "1"}]}], "}"}], ",", " ", "0"}], "]"}], 
           "]"}], ".", 
          RowBox[{"Array", "[", 
           RowBox[{"StirlingS2", ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"b", "+", "1"}], ",", " ", 
              RowBox[{"b", "+", "1"}]}], "}"}], ",", " ", "0"}], "]"}]}], 
         "&"}], "/@", "\[IndentingNewLine]", 
        RowBox[{"fgCoeffs", "[", "b", "]"}]}], "\[IndentingNewLine]", 
       ")"}]}]}], ";"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fgShiftMats", "[", "b_", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fg", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"b", ">", "1"}], ",", " ", 
         RowBox[{"fgCoeffs", "[", 
          RowBox[{"b", "-", "1"}], "]"}], ",", 
         RowBox[{"{", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"{", "1", "}"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"{", "0", "}"}], "}"}]}], " ", "}"}]}], "]"}]}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"MapIndexed", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"baseMat", "=", "\[IndentingNewLine]", 
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"C", "=", 
                RowBox[{"ArrayFlatten", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"#", ",", " ", "0"}], "}"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], "]"}]}], 
               "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{"Total", "@", 
               RowBox[{"{", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"C", "[", 
                  RowBox[{"[", 
                   RowBox[{";;", ",", " ", ";;"}], "]"}], "]"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"ArrayFlatten", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"0", ",", " ", "#"}], "}"}]}], "}"}], "]"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"-", 
                  RowBox[{"Join", "[", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{"0", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", " ", 
                    RowBox[{
                    RowBox[{"Dimensions", "[", "C", "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Range", "[", 
                    RowBox[{"0", ",", " ", 
                    RowBox[{"b", "-", "1"}]}], "]"}], "*", 
                    RowBox[{"C", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"1", ";;", 
                    RowBox[{"-", "2"}]}], ",", " ", ";;"}], "]"}], "]"}]}], 
                    " ", ",", "\[IndentingNewLine]", "1"}], 
                   "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
                "}"}]}]}], "\[IndentingNewLine]", "]"}]}], 
           "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#2", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "==", "2"}], ",", " ", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"PadRight", "[", 
                RowBox[{"#", ",", " ", 
                 RowBox[{"2", "b"}]}], "]"}], "&"}], ",", "baseMat"}], "]"}], 
            ",", " ", "baseMat"}], "]"}]}], "\[IndentingNewLine]", "]"}], 
        "&"}], ",", "\[IndentingNewLine]", "fg"}], "\[IndentingNewLine]", 
      "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gShiftMat", "[", "b_", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", "=", 
       RowBox[{
        RowBox[{"fgCoeffs", "[", 
         RowBox[{"b", "-", "1"}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"k", "+", "1"}], "<=", 
            RowBox[{
             RowBox[{"Dimensions", "[", "g", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "&&", 
           RowBox[{
            RowBox[{"j", "+", "1"}], "<=", 
            RowBox[{
             RowBox[{"Dimensions", "[", "g", "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], ",", " ", 
          RowBox[{"g", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"k", "+", "1"}], ",", " ", 
             RowBox[{"j", "+", "1"}]}], "]"}], "]"}], ",", " ", "0"}], "]"}], 
        "+", "\[IndentingNewLine]", 
        RowBox[{"+", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"k", ">", "0"}], "&&", 
            RowBox[{"j", ">", "0"}], "&&", 
            RowBox[{"k", "<=", 
             RowBox[{
              RowBox[{"Dimensions", "[", "g", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "&&", 
            RowBox[{"j", "<=", 
             RowBox[{
              RowBox[{"Dimensions", "[", "g", "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}], ",", " ", 
           RowBox[{"g", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"k", "-", "1", "+", "1"}], ",", " ", 
              RowBox[{"j", "-", "1", "+", "1"}]}], "]"}], "]"}], ",", " ", 
           "0"}], "]"}]}], "\[IndentingNewLine]", "-", 
