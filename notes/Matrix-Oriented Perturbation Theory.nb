  3.82136028266098*^9}},ExpressionUUID->"3d56c7ad-1563-4e05-b91e-\
be2b5ddefd4b"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "U"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "1", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       RowBox[{"-", 
        SubscriptBox["\[CapitalPi]", "D"]}], 
       SubscriptBox["P", "U"], 
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{"-", 
        SubscriptBox["\[CapitalPi]", "D"]}], 
       SubscriptBox["P", "U"], 
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]], 
       SubscriptBox["P", "D"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"], " ", 
       StyleBox[
        RowBox[{"(", " ", 
         RowBox[{
          RowBox[{
           StyleBox["bc",
            FontColor->GrayLevel[0.5]], 
           StyleBox[" ",
            FontColor->GrayLevel[0.5]], 
           SubscriptBox[
            StyleBox["P",
             FontColor->GrayLevel[0.5]], "U"], 
           TemplateBox[{
             SuperscriptBox["n", 
              RowBox[{"(", "0", ")"}]]},
            "Ket"]}], 
          StyleBox["=",
           FontColor->GrayLevel[0.5]], 
          StyleBox["\[DoubleStruckZero]",
           FontColor->GrayLevel[0.5]]}], ")"}],
        FontColor->GrayLevel[0.5]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821359625000393*^9, 3.821359625764101*^9}, {
