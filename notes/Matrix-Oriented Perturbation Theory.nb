Cell[TextData[{
 "and it certainly seems we only get the negative signs when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["o", "r"], " ", "==", " ", "p"}], TraditionalForm]],
  ExpressionUUID->"bd943575-595c-4f0e-8baa-54f99e53c9ec"],
 ", assuming lexical permutation ordering. Of course, that only worked \
because we had the same number of permutations as operators. What happens \
when we consider ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "f98d08b2-a788-42ba-a623-971b4a0be977"],
 "?"
}], "ExpositoryText",
