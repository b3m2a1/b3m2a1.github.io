  "17fa5ca6-1e6b-49d8-b92b-bf0ecd99b051"],
 " in ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["P", "D", 
    RowBox[{"(", 
     RowBox[{"a", "+", "1"}], ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.827066754232292*^9, 3.8270667787050657`*^9}, {
    3.827066957028639*^9, 3.827066963989049*^9}, {3.8270690256722517`*^9, 
    3.827069111712645*^9}, 3.827069231320167*^9},ExpressionUUID->
  "4253cb1a-fd4f-405b-a72a-41816028fb90"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Delta]E", "min"], TraditionalForm]],ExpressionUUID->
  "176b58e2-830e-4b10-af5d-ed3b9264ef64"],
 " was the smallest non-zero difference and gotten"
}], "ExpositoryText",
 CellChangeTimes->{{3.827069219139805*^9, 3.827069298483384*^9}, {
  3.8270693296439543`*^9, 
  3.8270693988904552`*^9}},ExpressionUUID->"eae09fbe-4bf3-403c-ac84-\
a1400a4649d3"],

Cell[BoxData[
 FormBox[
  RowBox[{"O", "(", 
   RowBox[{
    FractionBox[
     SuperscriptBox["\[Delta]E", "max"], 
     SuperscriptBox["\[Delta]E", "min"]], " ", 
    SubscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{"\[LeftBracketingBar]", 
       SubsuperscriptBox["P", "D", 
        RowBox[{"(", 
         RowBox[{"a", "+", "1"}], ")"}]], "\[RightBracketingBar]"}], 
      "\[RightBracketingBar]"}], "2"], 
    RowBox[{"\[LeftDoubleBracketingBar]", 
     RowBox[{
      SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
       RowBox[{"(", "a", ")"}]], 
      TemplateBox[{
        SuperscriptBox["\[Eta]", 
         RowBox[{"(", "0", ")"}]]},
       "Ket"]}], "\[RightDoubleBracketingBar]"}]}], ")"}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8270694057962227`*^9, 
  3.827069450603208*^9}},ExpressionUUID->"c1dad04c-19ea-48c7-8ab7-\
7dca7c4a765c"],

Cell[TextData[{
 "which is like a ",
 StyleBox["terrible",
  FontSlant->"Italic"],
 " result because it says that the goal should be to make ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Delta]E", "min"], TraditionalForm]],
  CellChangeTimes->{{3.8270694057962227`*^9, 3.827069450603208*^9}},
  ExpressionUUID->"c7ad87e9-5a95-46f0-954f-86ab0c10769e"],
 " as large as possible and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Delta]E", "max"], TraditionalForm]],
  CellChangeTimes->{{3.8270694057962227`*^9, 3.827069450603208*^9}},
  ExpressionUUID->"b23b32dd-08ee-4168-80f5-e2813365a32d"],
 " as small as possible, which at best can just be ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]],ExpressionUUID->
  "e7df23dd-cac1-4ffc-89fb-8086a080d0c0"],
 "."
}], "ExpositoryText",
 CellChangeTimes->{{3.827069452340824*^9, 
  3.827069510658784*^9}},ExpressionUUID->"77e31997-efcc-4732-a79b-\
f9d068fa9331"],

Cell["The other option would have been to say ", "ExpositoryText",
 CellChangeTimes->{{3.8270695685878353`*^9, 
  3.8270695740470057`*^9}},ExpressionUUID->"b04f2826-a10c-4bd8-bd26-\
9b9f4c0aa3c0"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["P", "D", 
        RowBox[{"(", 
         RowBox[{"a", "+", "1"}], ")"}]], 
       SuperscriptBox["\[ScriptCapitalH]", 
        RowBox[{"(", 
         RowBox[{"a", "+", "1"}], ")"}]], 
       SubsuperscriptBox["P", "D", 
        RowBox[{"(", 
         RowBox[{"a", "+", "1"}], ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["E", "n", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"O", "(", 
         RowBox[{"\[Delta]E", " ", 
          SubscriptBox[
           RowBox[{"\[LeftBracketingBar]", 
            RowBox[{"\[LeftBracketingBar]", 
             SubsuperscriptBox["P", "D", 
              RowBox[{"(", 
               RowBox[{"a", "+", "1"}], ")"}]], "\[RightBracketingBar]"}], 
            "\[RightBracketingBar]"}], "2"]}], ")"}], " ", 
        RowBox[{
         SubsuperscriptBox["P", "D", 
          RowBox[{"(", 
           RowBox[{"a", "+", "1"}], ")"}]], "(", 
         RowBox[{
          RowBox[{
           SubsuperscriptBox["\[CapitalPi]", "V", 
            RowBox[{"(", 
             RowBox[{"a", "+", "1"}], ")"}]], 
           SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
            RowBox[{"(", 
             RowBox[{"a", "+", "1"}], ")"}]], 
           TemplateBox[{
             SuperscriptBox["n", 
              RowBox[{"(", "0", ")"}]]},
            "Ket"]}], "+", 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"b", "=", "0"}], "a"], " ", 
           RowBox[{
            SubsuperscriptBox["\[CapitalPi]", "U", 
             RowBox[{"(", "b", ")"}]], 
            SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
             RowBox[{"(", "b", ")"}]], 
            TemplateBox[{
              SuperscriptBox["n", 
               RowBox[{"(", "0", ")"}]]},
             "Ket"]}]}]}], ")"}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["E", "n", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"O", "(", 
         RowBox[{"\[Delta]E", " ", 
          SubscriptBox[
           RowBox[{"\[LeftBracketingBar]", 
            RowBox[{"\[LeftBracketingBar]", 
             SubsuperscriptBox["P", "D", 
              RowBox[{"(", 
               RowBox[{"a", "+", "1"}], ")"}]], "\[RightBracketingBar]"}], 
            "\[RightBracketingBar]"}], "2"]}], ")"}], 
        SubsuperscriptBox["\[CapitalPi]", "V", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]], 
        SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.827066754232292*^9, 3.8270667787050657`*^9}, {
   3.827066957028639*^9, 3.827066963989049*^9}, {3.8270690256722517`*^9, 
   3.827069111712645*^9}, 3.827069231320167*^9, {3.8270695991891108`*^9, 
   3.827069620581209*^9}},ExpressionUUID->"f9eac218-be3a-4d1a-8cc9-\
5614a9ac84c2"],

Cell["\<\
and then we can only evaluate the scale of the error once \
we\[CloseCurlyQuote]ve actually done the calculation...with the erroneous \
zero-order state.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.827069630216201*^9, 3.82706966066117*^9}, {
  3.827069712150424*^9, 
  3.827069739588636*^9}},ExpressionUUID->"b70cfea4-1868-493c-830c-\
3c968261be16"],

Cell[TextData[{
 "I think what this is telling us is that there is no real way to assess the \
error made by assuming states are degenerate when they\[CloseCurlyQuote]re \
only nearly degenerate, but there\[CloseCurlyQuote]s reason to think it might \
work out since we have an error which is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    RowBox[{"\[Delta]E", " ", 
     SubscriptBox[
      RowBox[{"\[LeftBracketingBar]", 
       RowBox[{"\[LeftBracketingBar]", 
        SubsuperscriptBox["P", "D", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]], "\[RightBracketingBar]"}], 
       "\[RightBracketingBar]"}], "2"]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.827066754232292*^9, 3.8270667787050657`*^9}, {
    3.827066957028639*^9, 3.827066963989049*^9}, {3.8270690256722517`*^9, 
    3.827069111712645*^9}, 3.827069231320167*^9, {3.8270695991891108`*^9, 
    3.827069620581209*^9}},ExpressionUUID->
  "a3b5db44-ded9-41cc-8c3f-f33c45165e16"],
 " which can be made small."
}], "ExpositoryText",
 CellChangeTimes->{{3.827069662076633*^9, 3.8270696989827538`*^9}, {
  3.827069741076992*^9, 
  3.8270697629603024`*^9}},ExpressionUUID->"86f50b94-e884-4b2b-a9d8-\
efe68821562b"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["OLD BAD VERSION", "Subsubsection",
 CellChangeTimes->{{3.8258133795781927`*^9, 
  3.825813384400874*^9}},ExpressionUUID->"e34021a9-a2c2-48d5-bb26-\
c862c16c332b"],

Cell[TextData[{
 "We\[CloseCurlyQuote]ll be suppose that up to order ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "38078f42-c11a-4c18-b52d-5bd8929116f2"],
 ", for any ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "8359b9d5-4419-44e9-804a-c9e40100016e"]
}], "ExpositoryText",
 CellChangeTimes->{{3.825785682503071*^9, 3.8257856992995996`*^9}, {
  3.8258167021963167`*^9, 
  3.82581670794562*^9}},ExpressionUUID->"a2d4acb6-a1e8-4351-9381-\
36ebbe7cb4c0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", 
     SuperscriptBox["D", 
      RowBox[{"(", 
       RowBox[{"a", "-", "1"}], ")"}]]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "0"}], "a"], 
     RowBox[{
      SuperscriptBox["\[CapitalDelta]H", 
       RowBox[{"(", 
        RowBox[{"a", "-", "j"}], ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", 
           RowBox[{"k", "+", "j"}], ")"}]]},
       "Ket"]}]}]}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["P", 
      SuperscriptBox["D", 
       RowBox[{"(", 
        RowBox[{"a", "-", "1"}], ")"}]]], 
     SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
      RowBox[{"(", "a", ")"}]], 
     SubscriptBox["P", 
      SuperscriptBox["D", 
       RowBox[{"(", 
        RowBox[{"a", "-", "1"}], ")"}]]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "k", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     SubscriptBox["P", 
      SuperscriptBox["D", 
       RowBox[{"(", 
        RowBox[{"a", "-", "1"}], ")"}]]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "0"}], 
       RowBox[{"k", "-", "1"}]], 
      RowBox[{
       SubsuperscriptBox["J", "a", 
        RowBox[{"(", 
         RowBox[{"k", ",", "i"}], ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]]},
        "Ket"]}]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8257875367865953`*^9, 3.8257875638442307`*^9}, {
   3.825787600088464*^9, 3.825787605142007*^9}, {3.825788238984977*^9, 
   3.82578826094847*^9}, {3.825788316085217*^9, 3.825788340205299*^9}, {
