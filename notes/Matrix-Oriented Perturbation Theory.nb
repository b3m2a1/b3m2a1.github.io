          RowBox[{"(", "j", ")"}]]}]}], "+", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", 
          RowBox[{"i", "-", "j"}], ")"}]], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", "j", ")"}]]}]},
         "BraKet"]}]}]}]},
    {
