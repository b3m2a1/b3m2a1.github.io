ae1b1bbb78c2"],

Cell[TextData[{
 "We won\[CloseCurlyQuote]t do a full proof, which would basically have to be \
done by induction by showing that it works for a single axis swap and then \
showing that if it works for ",
 StyleBox["n",
  FontSlant->"Italic"],
 " swaps it works for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n",
     FontSlant->"Italic"], "+", "1"}], TraditionalForm]],ExpressionUUID->
  "b924d050-d642-40b2-b7f7-9a8904f4a0d9"]
}], "Text",
 CellChangeTimes->{{3.792857037949582*^9, 
  3.7928571254170437`*^9}},ExpressionUUID->"7ac66183-ac09-40db-977a-\
cd782edc34f6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Assume", " ", "that", " ", 
    StyleBox["A",
     FontWeight->"Bold"], " ", "has", " ", "axes", " ", 
    RowBox[{"{", 
     StyleBox[
      SubscriptBox["a", "n"],
      FontSlant->"Italic"], "}"}]}], " ", "\[Implies]", " ", 
   RowBox[{
    SubscriptBox["A", 
     RowBox[{"T", "(", 
      RowBox[{
       SubscriptBox[
        StyleBox["k",
         FontSlant->"Italic"], 
        RowBox[{"\[VeryThinSpace]", "1"}]], ",", " ", 
       SubscriptBox[
        StyleBox[
         RowBox[{"k", "\[VeryThinSpace]"}],
         FontSlant->"Italic"], "2"], ",", "\[Ellipsis]", ",", 
       "\[VeryThinSpace]", 
       SubscriptBox[
        StyleBox["k",
         FontSlant->"Italic"], 
        StyleBox["N",
         FontSlant->"Italic"]]}], ")"}]], " ", "has", " ", "axes", " ", 
    RowBox[{"{", 
     SubscriptBox[
      StyleBox["a",
       FontSlant->"Italic"], 
      StyleBox[
       SubscriptBox["k", "n"],
       FontSlant->"Italic"]], "}"}]}]}], TraditionalForm]], "ExpositoryMath",
 CellChangeTimes->{{3.792856486018305*^9, 3.792856567835762*^9}, {
  3.792856723040369*^9, 
  3.792856725019518*^9}},ExpressionUUID->"6c2d7b77-379a-4528-8db7-\
c526e281e3b0"],

