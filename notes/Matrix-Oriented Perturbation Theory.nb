d577c17998ab"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{"\[VeryThinSpace]", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], "a"], "\[VeryThinSpace] ", 
        RowBox[{"(", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"l", "=", "0"}], 
           RowBox[{
            RowBox[{"2", "\[InvisibleSpace]", "b"}], "-", "k"}]], 
          "\[VeryThinSpace]", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SubsuperscriptBox["c", 
              RowBox[{
               RowBox[{"k", "\[InvisibleSpace]", "l"}], "-", "1"}], 
              RowBox[{"(", 
               RowBox[{"b", "-", "1"}], ")"}]], "-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"b", "-", "1"}], ")"}], 
              SubsuperscriptBox["c", 
               RowBox[{"k", "\[InvisibleSpace]", "l"}], 
               RowBox[{"(", 
                RowBox[{"b", "-", "1"}], ")"}]]}], "+", 
             SubsuperscriptBox["c", 
              RowBox[{"k", "-", 
               RowBox[{"1", "\[InvisibleSpace]", "l"}]}], 
              RowBox[{"(", 
               RowBox[{"b", "-", "1"}], ")"}]]}], ")"}], 
           SuperscriptBox["i", "l"]}]}], "\[InvisibleSpace]\[InvisibleSpace]",
          ")"}]}], " ", "=", " \[VeryThinSpace]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"b", "-", "1"}], ")"}]}], 
           SubsuperscriptBox["c", 
            RowBox[{"k", "\[InvisibleSpace]\[VeryThinSpace]", ",", "0"}], 
            RowBox[{"(", 
             RowBox[{"b", "-", "1"}], ")"}]]}], "+", 
          SubsuperscriptBox["c", 
           RowBox[{
            RowBox[{"k", "-", "1"}], "\[InvisibleSpace]", ",", "0"}], 
           RowBox[{"(", 
            RowBox[{"b", "-", "1"}], ")"}]]}], ")"}], " ", "+", 
        "\[VeryThinSpace]\[VeryThinSpace] ", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"\[Omega]", "=", "0"}], 
          RowBox[{
           RowBox[{"2", "\[InvisibleSpace]", "b"}], "-", "k"}]], 
         "\[VeryThinSpace]", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            SubsuperscriptBox["c", 
             RowBox[{
              RowBox[{"k", "\[InvisibleSpace]", "\[Omega]"}], "-", "1"}], 
             RowBox[{"(", 
              RowBox[{"b", "-", "1"}], ")"}]], "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"b", "-", "1"}], ")"}], 
             SubsuperscriptBox["c", 
              RowBox[{"k", "\[InvisibleSpace]", "\[Omega]"}], 
              RowBox[{"(", 
               RowBox[{"b", "-", "1"}], ")"}]]}], "+", 
            SubsuperscriptBox["c", 
             RowBox[{"k", "-", 
              RowBox[{"1", "\[InvisibleSpace]", "\[Omega]"}]}], 
             RowBox[{"(", 
              RowBox[{"b", "-", "1"}], ")"}]]}], ")"}], 
          RowBox[{"(", 
           RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{"i", "=", "1"}], "a"], 
            SuperscriptBox["i", "\[Omega]"]}], 
           "\[InvisibleSpace]\[InvisibleSpace]", ")"}]}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"b", "-", "1"}], ")"}]}], 
          SubsuperscriptBox["c", 
           RowBox[{"k", "\[InvisibleSpace]\[VeryThinSpace]", ",", "0"}], 
           RowBox[{"(", 
            RowBox[{"b", "-", "1"}], ")"}]]}], "+", 
         SubsuperscriptBox["c", 
          RowBox[{
           RowBox[{"k", "-", "1"}], "\[InvisibleSpace]", ",", "0"}], 
          RowBox[{"(", 
           RowBox[{"b", "-", "1"}], ")"}]]}], ")"}], " ", "+", "  ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"\[Omega]", "=", "0"}], 
         RowBox[{
          RowBox[{"2", "\[InvisibleSpace]", "b"}], "-", "k"}]], 
        "\[VeryThinSpace]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SubsuperscriptBox["c", 
            RowBox[{
             RowBox[{"k", "\[InvisibleSpace]", "\[Omega]"}], "-", "1"}], 
            RowBox[{"(", 
             RowBox[{"b", "-", "1"}], ")"}]], "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"b", "-", "1"}], ")"}], 
            SubsuperscriptBox["c", 
             RowBox[{"k", "\[InvisibleSpace]", "\[Omega]"}], 
             RowBox[{"(", 
              RowBox[{"b", "-", "1"}], ")"}]]}], "+", 
           SubsuperscriptBox["c", 
            RowBox[{"k", "-", 
             RowBox[{"1", "\[InvisibleSpace]", "\[Omega]"}]}], 
            RowBox[{"(", 
             RowBox[{"b", "-", "1"}], ")"}]]}], ")"}], 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"z", "=", "0"}], "\[Omega]"], " ", 
          RowBox[{
           FractionBox[
            RowBox[{
             RowBox[{"(", "\[Omega]", ")"}], "!"}], 
            RowBox[{
             RowBox[{"z", "!"}], 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"\[Omega]", "+", "1", "-", "z"}], ")"}], "!"}]}]], 
           SubsuperscriptBox["B", "z", "+"], 
           SuperscriptBox["a", 
            RowBox[{"\[Omega]", "+", "1", "-", "z"}]]}]}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.889449063082142*^9, 3.889449082983528*^9}, {
