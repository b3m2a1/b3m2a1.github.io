         UnderoverscriptBox["\[Sum]", 
          RowBox[{"j", "=", "1"}], 
          RowBox[{"a", "+", "1"}]], 
         RowBox[{
          SuperscriptBox["\[CapitalDelta]H", 
           RowBox[{"(", 
            RowBox[{"a", "+", "1", "-", "j"}], ")"}]], 
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", 
               RowBox[{"k", "+", "j"}], ")"}]]},
           "Ket"]}]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        SubscriptBox["P", 
         SuperscriptBox["D", 
          RowBox[{"(", "a", ")"}]]], 
        SuperscriptBox["\[CapitalDelta]H", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "k", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        SubscriptBox["P", 
         SuperscriptBox["D", 
          RowBox[{"(", "a", ")"}]]], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"j", "=", "0"}], "a"], 
         RowBox[{
          SuperscriptBox["\[CapitalDelta]H", 
           RowBox[{"(", 
            RowBox[{"a", "-", "i"}], ")"}]], 
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", 
               RowBox[{"k", "+", "1", "+", "j"}], ")"}]]},
           "Ket"]}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825787637496421*^9, 3.8257876788148727`*^9}, {
   3.825787746813643*^9, 3.825787760589594*^9}, {3.825787798928966*^9, 
