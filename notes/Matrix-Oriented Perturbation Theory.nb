Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"bt0", "[", 
    RowBox[{"a_", ",", " ", "w_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Binomial", "[", 
     RowBox[{
      RowBox[{"1", "+", "a"}], ",", "w"}], "]"}], " ", 
    RowBox[{"Hypergeometric2F1", "[", 
     RowBox[{"1", ",", 
      RowBox[{"-", "w"}], ",", 
      RowBox[{"2", "+", "a", "-", "w"}], ",", 
      FractionBox["1", "2"]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bt1", "[", 
    RowBox[{"a_", ",", " ", "w_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Binomial", "[", 
     RowBox[{
      RowBox[{"a", "+", "1"}], ",", " ", "w"}], "]"}], "*", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", 
          FractionBox["1", "2"]}], ")"}], "k"], 
       FractionBox[
        RowBox[{"FactorialPower", "[", 
         RowBox[{"w", ",", " ", "k"}], "]"}], 
        RowBox[{"Pochhammer", "[", 
         RowBox[{
          RowBox[{"a", "+", "1", "-", 
           RowBox[{"(", 
            RowBox[{"w", "-", "1"}], ")"}]}], ",", " ", "k"}], "]"}]]}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"k", ",", " ", "0", ",", " ", "w"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bt2", "[", 
   RowBox[{"a_", ",", " ", "w_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Binomial", "[", 
    RowBox[{
     RowBox[{"a", "+", "1"}], ",", " ", "w"}], "]"}], "*", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", 
         FractionBox["1", "2"]}], ")"}], "k"], 
      FractionBox[
       RowBox[{"w", "!"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"w", "-", "k"}], ")"}], "!"}]], 
      FractionBox[
       RowBox[{"FactorialPower", "[", 
        RowBox[{
         RowBox[{"a", "+", "1"}], ",", " ", 
         RowBox[{"w", "-", "k"}]}], "]"}], 
