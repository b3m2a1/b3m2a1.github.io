Cell[TextData[{
 "We can get a significant benefit by noting that we usually care about \
properties, which if we\[CloseCurlyQuote]re doing the PT up to order ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],ExpressionUUID->
  "f9419458-007b-4fe3-82ad-0dd2e936f5d4"],
 " we do like"
}], "ExpositoryText",
