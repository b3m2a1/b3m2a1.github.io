           RowBox[{"a", "-", "j"}], ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", 
              RowBox[{"k", "+", "1", "+", "j"}], ")"}]]},
          "Ket"]}]}]}]}]},
    {
