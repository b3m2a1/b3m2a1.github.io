     RowBox[{"Denominator", "[", "term", "]"}], ",", " ", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"a_Integer", ":>", "a"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"HoldPattern", "[", "Times", "]"}], "[", 
