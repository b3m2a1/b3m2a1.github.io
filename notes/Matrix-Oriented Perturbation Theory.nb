298144ac5a15"],

Cell["In our representation of our Hamiltonian, we have", "ExpositoryText",
 CellChangeTimes->{{3.793484666712749*^9, 3.793484696075626*^9}, {
  3.793484802580173*^9, 
  3.793484819851122*^9}},ExpressionUUID->"e992448f-09aa-404c-86f0-\
