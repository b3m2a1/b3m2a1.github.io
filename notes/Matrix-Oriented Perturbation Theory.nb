           RowBox[{"(", "1", ")"}]]}]},
       "BraKet"], "=", "0"}]},
    {
     RowBox[{
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "1", ")"}]]},
       "Ket"], "=", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[CapitalPi]", "n"], "(", 
