262cec9ba1b9"],

Cell["or more explicitly", "ExpositoryText",
 CellChangeTimes->{{3.814543476585155*^9, 
  3.814543487298842*^9}},ExpressionUUID->"b6fb5322-e4c4-469b-8834-\
033b766a8473"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{"i", "\[InvisibleSpace]", "j"}]], 
    RowBox[{
     SubscriptBox[
      RowBox[{"(", "\[VeryThinSpace]", 
       SubsuperscriptBox["\[Epsilon]", "2", 
        RowBox[{"(", "2", ")"}]], ")"}], 
      RowBox[{"i", "\[InvisibleSpace]", "j"}]], 
     SubscriptBox["n", "i"], 
     SubscriptBox["n", "j"]}]}], "=", 
   RowBox[{
    SubsuperscriptBox["E", "n", 
     RowBox[{"(", "2", ")"}]], "-", 
    SubsuperscriptBox["E", "0", 
     RowBox[{"(", "2", ")"}]], "-", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"i", "\[InvisibleSpace]"}]], 
     RowBox[{
      SubscriptBox[
       RowBox[{"(", "\[VeryThinSpace]", 
        SubsuperscriptBox["\[Epsilon]", "1", 
         RowBox[{"(", "2", ")"}]], ")"}], 
       RowBox[{"i", "\[InvisibleSpace]"}]], 
      SubscriptBox["n", "i"]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.814543482501213*^9, 
  3.814543565811545*^9}},ExpressionUUID->"e4935722-afde-4f25-9f93-\
dff464cf308b"],

