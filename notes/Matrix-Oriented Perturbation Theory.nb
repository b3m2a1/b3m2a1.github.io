Cell[TextData[{
 "which is all well and good, but I think this means we need to compare ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], 
    SubsuperscriptBox["\[GothicCapitalO]", "m", 
     RowBox[{"(", "p", ")"}]]}], 
   SubsuperscriptBox["\[VerticalSeparator]", "a", "b"], 
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"]}]],
  CellChangeTimes->{{3.828405326292385*^9, 3.828405357232705*^9}, {
