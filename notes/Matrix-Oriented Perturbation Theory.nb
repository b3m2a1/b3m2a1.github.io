         RowBox[{"k", "!"}]], 
        SubscriptBox[
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}], 
         RowBox[{"[", "k", "]"}]]}]}]}]}], ")"}]}], TraditionalForm]],
