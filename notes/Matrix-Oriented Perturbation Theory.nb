Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "totalPolyCoeffs", ",", "totalLatticePoly", ",", " ", 
    "pathPartitionPoly"}], "]"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pathPartitionPoly", "[", 
    RowBox[{"partition_", ",", " ", 
     RowBox[{"var_", ":", "n"}]}], "]"}], ":=", 
   RowBox[{"Block", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"pos", "=", 
        RowBox[{"Reverse", "@", 
         RowBox[{"Accumulate", "[", 
          RowBox[{"Reverse", "[", "partition", "]"}], "]"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"which", "=", 
        RowBox[{"Unitize", "[", 
         RowBox[{"partition", "-", "1"}], "]"}]}]}], "\[IndentingNewLine]", 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Times", "@@", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"var", "+", "pos", "+", "which"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"totalLatticePoly", "[", 
    RowBox[{"ups_Integer", ",", "downs_Integer", ",", " ", 
     RowBox[{"var", ":", 
      RowBox[{"Except", "[", "_Integer", "]"}], ":", "n"}]}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Total", "@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"pathPartitionPoly", "[", 
        RowBox[{"#", ",", " ", "var"}], "]"}], "&"}], "/@", 
      RowBox[{"Permutations", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{"1", ",", " ", "ups"}], "]"}], ",", " ", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", "downs"}], "]"}]}], "]"}], "]"}]}], 
     ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"totalLatticePoly", "[", 
    RowBox[{"D_", ",", " ", 
     RowBox[{"var", ":", 
      RowBox[{"Except", "[", "_Integer", "]"}], ":", "n"}]}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Total", "@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"pathPartitionPoly", "[", 
        RowBox[{"#", ",", " ", "var"}], "]"}], "&"}], "/@", 
      RowBox[{"Permutations", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{"1", ",", " ", "D"}], "]"}], ",", " ", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", "D"}], "]"}]}], "]"}], "]"}]}], 
     ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"totalPolyCoeffs", "[", 
