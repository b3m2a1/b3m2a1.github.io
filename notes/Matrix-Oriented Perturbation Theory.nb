 CellChangeTimes->{{3.81029754069508*^9, 3.810297541495832*^9}, {
  3.8102977074775476`*^9, 3.810297725672966*^9}, {3.810298432715782*^9, 
  3.810298442307538*^9}, {3.8103019153992033`*^9, 3.810301915508593*^9}, {
  3.81039463511754*^9, 
  3.810394640161248*^9}},ExpressionUUID->"6b9ae596-f352-460f-8985-\
d33dd69dc7d8"],

Cell[TextData[{
 "and now let\[CloseCurlyQuote]s assume that we\[CloseCurlyQuote]ve gotten \
all of the corrections up to order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "-", "1"}], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"1b735ad2-c9e5-4198-ad72-5df1596cdb08"],
 ". That means we have ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["E", "n"], 
    RowBox[{"(", "k", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.81029754069508*^9, 3.810297541495832*^9}, {
   3.8102977074775476`*^9, 3.810297725672966*^9}, {3.810298432715782*^9, 
   3.810298442307538*^9}},ExpressionUUID->
  "8cd35aac-e467-4256-baa9-e8cf190b6482"],
 " directly. Now we\[CloseCurlyQuote]ll turn to the second term and note that \
it gives us"
}], "ExpositoryText",
 InitializationCell->True,
 CellChangeTimes->{{3.810301345609914*^9, 3.8103014231127443`*^9}, {
  3.8103025494105663`*^9, 
  3.810302551070175*^9}},ExpressionUUID->"6b075e95-400a-4430-8ab1-\
2c4f44ac396b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      RowBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]], " "}], 
      RowBox[{"\[VeryThinSpace] ", 
        SuperscriptBox["m", 
         RowBox[{"(", "k", ")"}]]}]},
     "BraKet"], "+", 
    TemplateBox[{
      RowBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "k", ")"}]], " "}], 
      RowBox[{"\[VeryThinSpace] ", 
        SuperscriptBox["m", 
         RowBox[{"(", "0", ")"}]]}]},
     "BraKet"]}], "=", 
   RowBox[{"-", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], 
      RowBox[{"k", "-", "1"}]], 
     TemplateBox[{
       RowBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]], " "}], 
       RowBox[{"\[VeryThinSpace] ", 
         SuperscriptBox["m", 
          RowBox[{"(", 
            RowBox[{"k", "-", "i"}], ")"}]]}]},
      "BraKet"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.810302159305826*^9, 
  3.810302218358946*^9}},ExpressionUUID->"fde111c6-9114-4af6-a292-\
dd621547d318"],

Cell[TextData[{
 "and when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", "n"}], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"5ceb547b-03ea-417b-a671-916040fc7b90"],
 " we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.8103022199418697`*^9, 
  3.810302226333486*^9}},ExpressionUUID->"c5c96581-fa70-4402-87d0-\
e00c7fadec35"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     RowBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]], " "}], 
     RowBox[{"\[VeryThinSpace] ", 
       SuperscriptBox["n", 
        RowBox[{"(", "k", ")"}]]}]},
    "BraKet"], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], 
      RowBox[{"k", "-", "1"}]], 
     TemplateBox[{
       RowBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]], " "}], 
       RowBox[{"\[VeryThinSpace] ", 
         SuperscriptBox["n", 
          RowBox[{"(", 
            RowBox[{"k", "-", "i"}], ")"}]]}]},
      "BraKet"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.810302228880116*^9, 3.8103022370416*^9}, {
  3.810302328649795*^9, 
  3.810302331040989*^9}},ExpressionUUID->"ffc9c8f3-185c-4e12-8c5c-\
7ccf1030cd31"],

Cell["finally following our previous prescription we have", "ExpositoryText",
 CellChangeTimes->{{3.8103022415906878`*^9, 
  3.810302257509328*^9}},ExpressionUUID->"0c1393bb-0a40-4412-b267-\
44e4892c0121"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "k", ")"}]]},
       "Ket"], "=", 
      RowBox[{
       RowBox[{
        SubscriptBox["R", "n"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "k", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", "k", ")"}]]}]},
         "BraKet"]}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["R", "n"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], 
        RowBox[{"k", "-", "1"}]], 
       RowBox[{
        RowBox[{
         SubscriptBox["\[CapitalPi]", "n"], "(", 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["E", "n"], 
           RowBox[{"(", 
            RowBox[{"k", "-", "i"}], ")"}]], "-", 
          SuperscriptBox["H", 
           RowBox[{"(", 
            RowBox[{"k", "-", "i"}], ")"}]]}], ")"}], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "i", ")"}]]},
         "Ket"]}]}]}]},
    {
     RowBox[{
      RowBox[{"\[Therefore]", 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], 
         RowBox[{"k", "-", "1"}]], 
        RowBox[{
         RowBox[{
          SubscriptBox["\[CapitalPi]", "n"], "(", 
          RowBox[{
           SuperscriptBox[
            SubscriptBox["E", "n"], 
            RowBox[{"(", 
             RowBox[{"k", "-", "i"}], ")"}]], "-", 
           SuperscriptBox["H", 
            RowBox[{"(", 
             RowBox[{"k", "-", "i"}], ")"}]]}], ")"}], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"]}]}], "+", 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", "k", ")"}]]}]},
         "BraKet"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.810302258659374*^9, 3.810302262897318*^9}, {
  3.810302294301551*^9, 3.810302363649911*^9}, {3.810302523837062*^9, 
  3.810302542683189*^9}, {3.810302595609537*^9, 
  3.8103026270556583`*^9}},ExpressionUUID->"78fe1c31-25f3-4eba-98be-\
239bdf66e7cd"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Degenerate Perturbation Theory", "Subsection",
 CellChangeTimes->{{3.821382937035264*^9, 3.821382944883395*^9}, 
   3.821466082335903*^9},ExpressionUUID->"fbb40021-0da0-403a-84f9-\
0c8d14097732"],

Cell[CellGroupData[{

Cell["Setup", "Subsubsection",
 CellChangeTimes->{{3.821409597584354*^9, 
  3.821409602157022*^9}},ExpressionUUID->"b6ca6781-97f6-4df3-b482-\
46082fed9621"],

Cell[TextData[{
 "We\[CloseCurlyQuote]re going to build our way to do degenerate perturbation \
theory without any post-hoc corrections. To do this we\[CloseCurlyQuote]ll \
start with our original basis ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    TemplateBox[{
      SuperscriptBox["m", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"], "}"}], TraditionalForm]],ExpressionUUID->
  "1c469ec4-b09d-424d-bdf1-ac8982b41735"],
 " and assume that we have a set of degenerate states ",
 Cell[BoxData[
  FormBox[
   RowBox[{"D", "=", 
    RowBox[{"{", 
     TemplateBox[{
       SuperscriptBox["d", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"], "}"}]}], TraditionalForm]],ExpressionUUID->
  "2c640b3b-8434-4686-b03b-abc7e7425c26"],
 " such that for each ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["d", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.821407047092662*^9, 3.8214070470981073`*^9}, {
   3.82140720959879*^9, 3.8214072596817427`*^9}},ExpressionUUID->
  "94d6f5ca-9a4b-47b6-9283-3058d1324e2a"]
}], "ExpositoryText",
 CellChangeTimes->{{3.821406750971321*^9, 3.8214068409002237`*^9}, {
  3.821406878951001*^9, 3.821406879940175*^9}, {3.821407034675003*^9, 
  3.821407060183887*^9}, {3.821407107882815*^9, 3.821407225373806*^9}, {
  3.821407267818363*^9, 
  3.821407270734591*^9}},ExpressionUUID->"34782864-ecc9-4270-b581-\
a6f8048f0372"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["H", 
     RowBox[{"(", "0", ")"}]], 
    TemplateBox[{
      SuperscriptBox["d", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    SubsuperscriptBox["E", "n", 
     RowBox[{"(", "0", ")"}]], 
    TemplateBox[{
      SuperscriptBox["d", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}]}], TraditionalForm]], "ExpositoryMathCenteredNumbered",
 CellChangeTimes->{{3.821407047092662*^9, 3.8214070470981073`*^9}, {
  3.82140720959879*^9, 
  3.821407272967711*^9}},ExpressionUUID->"4fd536be-dead-4556-b69e-\
f8e0b813be1c"],

Cell["\<\
Now we\[CloseCurlyQuote]ll introduce two projection operators onto this state \
and its complement\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8214072805989532`*^9, 
  3.821407406644471*^9}},ExpressionUUID->"2c1eebf9-2cbf-4ada-a954-\
c1105468e843"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["P", "D"], "=", 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{"d", "\[Element]", "D"}]], 
       TemplateBox[{
         SuperscriptBox["d", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{
      SubscriptBox["P", "U"], "=", 
      RowBox[{"I", "-", 
       SubscriptBox["P", "D"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCenteredNumbered",
 CellChangeTimes->{{3.821407408859481*^9, 
  3.821407435723777*^9}},ExpressionUUID->"508396f7-f4a9-4217-a6cf-\
12bf6a1f4704"],

Cell["it is straightforward to show that", "ExpositoryText",
 CellChangeTimes->{{3.8214074373392*^9, 
  3.8214074790811768`*^9}},ExpressionUUID->"2c55ddfb-d35a-4445-a717-\
e6889ac8d65c"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "D"], 
       SubscriptBox["P", "D"]}], "=", 
      SubscriptBox["P", "D"]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "U"], 
       SubscriptBox["P", "U"]}], "=", 
      SubscriptBox["P", "U"]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "U"], 
       SubscriptBox["P", "D"]}], "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"I", "-", 
         SubscriptBox["P", "D"]}], ")"}], 
       SubscriptBox["P", "D"]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       SubscriptBox["P", "D"], "-", 
       RowBox[{
        SubscriptBox["P", "D"], 
        SubscriptBox["P", "D"]}]}]}]},
    {
     RowBox[{"=", "\[DoubleStruckZero]"}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "D"], 
       SubscriptBox["P", "U"]}], "=", 
      RowBox[{
       SubscriptBox["P", "D"], "(", 
       RowBox[{"I", "-", 
        SubscriptBox["P", "D"]}], ")"}]}]}
   }], TraditionalForm]], "ExpositoryMathCenteredNumbered",
 CellChangeTimes->{{3.821407454207246*^9, 3.821407458795878*^9}, {
  3.821407505286639*^9, 
  3.821407578750065*^9}},ExpressionUUID->"b14b3554-fed8-4470-a0d0-\
04e766599e51"],

Cell["we will make heavy use of these properties.", "ExpositoryText",
 CellChangeTimes->{{3.821407580365157*^9, 3.821407588304606*^9}, {
  3.82140766264252*^9, 
  3.8214076627502117`*^9}},ExpressionUUID->"eccf6230-7d3c-4be8-b735-\
92cc78a60ef3"],

Cell[TextData[{
 "Before we get started we also should note that any linear combinations of \
degenerate states remains an eigenstate of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "0", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.821407681693362*^9, 3.821407682604466*^9}},
  ExpressionUUID->"dc614626-60ab-451b-8e28-3481da61636e"]
}], "ExpositoryText",
 CellChangeTimes->{{3.8214076426363173`*^9, 
  3.821407706776273*^9}},ExpressionUUID->"6409851e-ee84-47aa-b0b3-\
3b19a185f188"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", "0", ")"}]], 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"d", "\[Element]", "D"}]], 
        RowBox[{
         SubscriptBox["c", "d"], 
         TemplateBox[{
           SuperscriptBox["d", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"]}]}]}], "=", 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{"d", "\[Element]", "D"}]], 
       RowBox[{
        SubscriptBox["c", "d"], 
        SuperscriptBox["H", 
         RowBox[{"(", "0", ")"}]], 
        TemplateBox[{
          SuperscriptBox["d", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{"d", "\[Element]", "D"}]], 
       RowBox[{
        SubscriptBox["c", "d"], 
        SubsuperscriptBox["E", "n", 
         RowBox[{"(", "0", ")"}]], 
        TemplateBox[{
          SuperscriptBox["d", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       SubsuperscriptBox["E", "n", 
        RowBox[{"(", "0", ")"}]], 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"d", "\[Element]", "D"}]], 
        RowBox[{
         SubscriptBox["c", "d"], 
         TemplateBox[{
           SuperscriptBox["d", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCenteredNumbered",
 CellChangeTimes->{{3.821407681693362*^9, 3.821407682604466*^9}, {
  3.8214077289843884`*^9, 
  3.821407769325777*^9}},ExpressionUUID->"5fee7dd8-e157-4d0d-a654-\
bd0dbde41316"],

Cell[TextData[{
 "and crucially from that, given ",
 StyleBox["any",
  FontSlant->"Italic"],
 " linear combination of states, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "i", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "7f333e82-4ea1-4295-9c5b-44d37d616988"],
 ", "
}], "ExpositoryText",
 CellChangeTimes->{{3.821407771638277*^9, 
  3.821407809629045*^9}},ExpressionUUID->"4ecfffee-94e6-4e79-8e68-\
ef90bbc974d9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["H", 
     RowBox[{"(", "0", ")"}]], 
    SubscriptBox["P", "D"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "i", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    SubsuperscriptBox["E", "n", 
     RowBox[{"(", "0", ")"}]], 
    SubscriptBox["P", "D"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "i", ")"}]]},
     "Ket"]}]}], TraditionalForm]], "ExpositoryMathCenteredNumbered",
 CellChangeTimes->{{3.821407783299823*^9, 
  3.821407827184927*^9}},ExpressionUUID->"dd1f5dc1-6641-4ef8-ab8b-\
5e2ea577096a"],

Cell[TextData[{
 "and conversely, when working with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["H", 
     RowBox[{"(", "0", ")"}]], 
    SubscriptBox["P", "U"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "i", ")"}]]},
     "Ket"]}], TraditionalForm]],
  CellChangeTimes->{{3.821407783299823*^9, 3.821407827184927*^9}},
  ExpressionUUID->"4e1e695f-94d2-4b45-b969-5567ef2ef4eb"],
 ", because the zero-order states are eigenstates of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "0", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.821407783299823*^9, 3.821407827184927*^9}},
  ExpressionUUID->"8e3d12c3-aec6-4e12-bd04-967ec5f3822d"]
}], "ExpositoryText",
 CellChangeTimes->{{3.8214090696259937`*^9, 
  3.8214091222829723`*^9}},ExpressionUUID->"bec83787-6597-41d6-b8e8-\
3bcd8fbfa36c"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "D"], 
       SuperscriptBox["H", 
        RowBox[{"(", "0", ")"}]], 
       SubscriptBox["P", "U"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       SubscriptBox["P", "D"], 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"k", "\[NotElement]", "D"}]], 
        RowBox[{
         SubscriptBox["c", "k"], 
         SuperscriptBox["H", 
          RowBox[{"(", "0", ")"}]], 
         TemplateBox[{
           SuperscriptBox["k", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       SubscriptBox["P", "D"], 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"k", "\[NotElement]", "D"}]], 
        RowBox[{
         SubscriptBox["c", "k"], 
         SubsuperscriptBox["E", "k", 
          RowBox[{"(", "0", ")"}]], 
         TemplateBox[{
           SuperscriptBox["k", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"]}]}]}]}]},
    {
     RowBox[{"=", "\[DoubleStruckZero]"}]}
   }], TraditionalForm]], "ExpositoryMathCenteredNumbered",
 CellChangeTimes->{{3.821409089154649*^9, 3.821409089158144*^9}, {
  3.821409125169507*^9, 
  3.821409196859336*^9}},ExpressionUUID->"851b7d05-46f5-4fc1-8515-\
ef098838ecf9"],

Cell["That should do it for preliminaries.", "ExpositoryText",
 CellChangeTimes->{{3.8214092090544453`*^9, 
  3.821409217348091*^9}},ExpressionUUID->"4be548a6-08a5-42aa-aeae-\
efbeaeb07c21"],

Cell[TextData[{
 "Our goal will be to find a set of linear combinations of degenerate states ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "f3ed1805-cef9-4e28-ae69-1d25ba92def0"],
 " so that we can use this in the perturbation theory."
}], "ExpositoryText",
 CellChangeTimes->{{3.821408704413357*^9, 
  3.8214087856096697`*^9}},ExpressionUUID->"ae5fab23-80ba-435c-86b5-\
4f4afa9e4326"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[{
    SuperscriptBox["n", 
     RowBox[{"(", "0", ")"}]]},
   "Ket"], 
  TraditionalForm]],ExpressionUUID->"eda792c3-9528-479a-b065-556d2dab4bf9"]], \
"Subsubsection",
 CellChangeTimes->{{3.821409650700354*^9, 3.821409665033399*^9}, {
   3.821566240088019*^9, 3.8215662408573923`*^9}, 
   3.8215727151212063`*^9},ExpressionUUID->"19b51e2a-4313-4501-8b9d-\
5d314f3156b7"],

Cell["First we\[CloseCurlyQuote]ll bring in our friends the Trash Equations", \
"ExpositoryText",
 CellChangeTimes->{{3.8214078480843782`*^9, 3.821407867152155*^9}, {
  3.821409224531386*^9, 
  3.821409225558186*^9}},ExpressionUUID->"83a872c5-6e19-44b7-a19c-\
ba891fc6d0c9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], "k"], " ", 
    RowBox[{
     SuperscriptBox["H", 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "i", ")"}]]},
      "Ket"]}]}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], "k"], "  ", 
    RowBox[{
     SubsuperscriptBox["E", "n", 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "i", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCenteredNumbered",
 CellChangeTimes->{{3.8214068455300617`*^9, 3.8214068455346413`*^9}, {
  3.821406881649847*^9, 3.8214069010846357`*^9}, {3.821463833930913*^9, 
  3.821463834307041*^9}},ExpressionUUID->"942518b7-3b70-4712-adaf-\
ef8eb0ba23b0"],

Cell[TextData[{
 "then we will make two sets of these equations, one for the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "U"], TraditionalForm]],ExpressionUUID->
  "b773ef03-c9b2-409f-99f7-da77b11e02cd"],
 " space and one for the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "D"], TraditionalForm]],ExpressionUUID->
  "a1100fc4-2357-4cc3-834b-addc1c847aa2"],
 " space"
}], "ExpositoryText",
 CellChangeTimes->{{3.821407872037675*^9, 
  3.821407897545439*^9}},ExpressionUUID->"1b66da5d-b0d9-4620-809c-\
50a5a7f17ba2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", "U"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], "k"], " ", 
     RowBox[{
      SuperscriptBox["H", 
       RowBox[{"(", 
        RowBox[{"k", "-", "i"}], ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}]}], "=", 
   RowBox[{
    SubscriptBox["P", "U"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], "k"], "  ", 
     RowBox[{
      SubsuperscriptBox["E", "n", 
       RowBox[{"(", 
        RowBox[{"k", "-", "i"}], ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCenteredNumbered",
 CellChangeTimes->{{3.8214068455300617`*^9, 3.8214068455346413`*^9}, {
  3.821406881649847*^9, 3.8214069010846357`*^9}, {3.821407901285924*^9, 
  3.821407912541336*^9}, {3.821409333515408*^9, 3.821409334392365*^9}, {
  3.821463836578944*^9, 
  3.8214638368872766`*^9}},ExpressionUUID->"8164bd65-9d31-4f8a-94e5-\
74e6b9911c39"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", "D"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], "k"], " ", 
     RowBox[{
      SuperscriptBox["H", 
       RowBox[{"(", 
        RowBox[{"k", "-", "i"}], ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}]}], "=", 
   RowBox[{
    SubscriptBox["P", "D"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], "k"], "  ", 
     RowBox[{
      SubsuperscriptBox["E", "n", 
       RowBox[{"(", 
        RowBox[{"k", "-", "i"}], ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCenteredNumbered",
 CellChangeTimes->{{3.821409340096746*^9, 3.821409341521531*^9}, {
  3.821463838701041*^9, 
  3.821463838984529*^9}},ExpressionUUID->"afcb69f5-3f87-40ff-92ea-\
1095fff27d24"],

Cell["\<\
We are going to solve for the effects of the perturbation in each space \
independently. \
\>", "ExpositoryText",
 CellChangeTimes->{{3.821407967699751*^9, 3.8214079704997797`*^9}, 
   3.821408122512845*^9, {3.821408666645886*^9, 3.8214086955248003`*^9}, {
   3.821408795565893*^9, 
   3.821408828592505*^9}},ExpressionUUID->"0d69dfa6-621c-4b3d-ac47-\
8a60c13f801e"],

Cell[TextData[{
 "First off though, we need to get ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "97fdc2ec-303f-4b18-bc6d-2b35fea8f525"],
 "."
}], "ExpositoryText",
 CellChangeTimes->{{3.821407967699751*^9, 3.8214079704997797`*^9}, 
   3.821408122512845*^9, {3.821408666645886*^9, 3.8214086955248003`*^9}, {
   3.821408795565893*^9, 
   3.8214088318716583`*^9}},ExpressionUUID->"b4f4ad9c-10a8-41a7-988d-\
81b85e125543"],

Cell["So we start with the Degenerate Trash Equations", "ExpositoryText",
 CellChangeTimes->{{3.821408821224926*^9, 3.8214088487734823`*^9}, {
  3.821409346372923*^9, 
  3.821409352322693*^9}},ExpressionUUID->"43820fb7-df19-4e3c-890f-\
d123dbbc5acf"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", "D"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], "k"], " ", 
     RowBox[{
      SuperscriptBox["H", 
       RowBox[{"(", 
        RowBox[{"k", "-", "i"}], ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}]}], "=", 
   RowBox[{
    SubscriptBox["P", "D"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], "k"], "  ", 
     RowBox[{
      SuperscriptBox["E", 
       RowBox[{"(", 
        RowBox[{"k", "-", "i"}], ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821408851732058*^9, 
  3.8214088524176807`*^9}},ExpressionUUID->"4ebb7860-427f-4aa4-82af-\
5b5feac83101"],

Cell[TextData[{
 "and let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "c30c55d7-3a07-456f-b780-e796a9b8ea45"]
}], "ExpositoryText",
 CellChangeTimes->{{3.8214088628554583`*^9, 
  3.821408883441629*^9}},ExpressionUUID->"95c2136f-f023-415f-98af-\
8d710cf23666"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["P", "D"], " ", 
     SuperscriptBox["H", 
      RowBox[{"(", "1", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     SubscriptBox["P", "D"], " ", 
     SuperscriptBox["H", 
      RowBox[{"(", "0", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "1", ")"}]]},
      "Ket"]}]}], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["E", "n", 
      RowBox[{"(", "1", ")"}]], 
     SubscriptBox["P", "D"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     SubsuperscriptBox["E", "n", 
      RowBox[{"(", "0", ")"}]], 
     SubscriptBox["P", "D"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "1", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCenteredNumbered",
 CellChangeTimes->{{3.821408891537952*^9, 3.821408952509111*^9}, {
  3.821463845008441*^9, 
  3.821463848315783*^9}},ExpressionUUID->"803b3517-949a-46ce-b3ee-\
3297bc5c2c5f"],

Cell[TextData[{
 "and now we look at the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "0", ")"}]], TraditionalForm]],ExpressionUUID->
  "dafa2915-dd5c-480e-9f85-5134d940518a"],
 " term, insert the identity operator, and apply the properties from up top"
}], "ExpositoryText",
 CellChangeTimes->{{3.8214089645333157`*^9, 3.821408998940879*^9}, {
  3.8214092357718973`*^9, 
  3.821409249113543*^9}},ExpressionUUID->"8cef0dbb-9ee2-4225-8ff5-\
832029fc61c6"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "D"], " ", 
       SuperscriptBox["H", 
        RowBox[{"(", "0", ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "1", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       SubscriptBox["P", "D"], " ", 
       RowBox[{
        SuperscriptBox["H", 
         RowBox[{"(", "0", ")"}]], "(", 
        RowBox[{
         SubscriptBox["P", "U"], "+", 
         SubscriptBox["P", "D"]}], ")"}], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "1", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        SubscriptBox["P", "D"], " ", 
        SuperscriptBox["H", 
         RowBox[{"(", "0", ")"}]], 
        SubscriptBox["P", "U"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "1", ")"}]]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        SubscriptBox["P", "D"], " ", 
        SuperscriptBox["H", 
         RowBox[{"(", "0", ")"}]], 
        SubscriptBox["P", "D"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "1", ")"}]]},
         "Ket"]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       SubscriptBox["P", "D"], " ", 
       SuperscriptBox["H", 
        RowBox[{"(", "0", ")"}]], 
       SubscriptBox["P", "D"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "1", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       SubsuperscriptBox["E", "n", 
        RowBox[{"(", "0", ")"}]], 
       SubscriptBox["P", "D"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "1", ")"}]]},
        "Ket"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.82140900001089*^9, 3.821409048931673*^9}, {
   3.821409251050632*^9, 3.82140927474644*^9}, 
   3.821409311115883*^9},ExpressionUUID->"251d177d-25ca-4b5c-bae4-\
ab6a1d2e3994"],

Cell["which, when substituted into (10) term, gives us", "ExpositoryText",
 CellChangeTimes->{{3.82140927880754*^9, 3.821409309434465*^9}, {
  3.8214093635431623`*^9, 
  3.821409365634349*^9}},ExpressionUUID->"8ecbf1f9-8a22-4adc-a809-\
9195d44a7dd2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", "D"], " ", 
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    SubsuperscriptBox["E", "n", 
     RowBox[{"(", "1", ")"}]], 
    SubscriptBox["P", "D"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.82140928763412*^9, 3.821409289092497*^9}, {
  3.8214093721889544`*^9, 3.821409378821599*^9}, {3.8214638414243803`*^9, 
  3.82146384173123*^9}},ExpressionUUID->"9af0a090-11a5-42b5-a002-\
3e4b645e5efc"],

Cell["and then inserting the identity again ", "ExpositoryText",
 CellChangeTimes->{{3.821409383957375*^9, 
  3.821409401954221*^9}},ExpressionUUID->"b3a41b7c-a503-4b5a-9311-\
b53f32b8f698"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "D"], " ", 
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       SubscriptBox["P", "D"], " ", 
       RowBox[{
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], "(", 
        RowBox[{
         SubscriptBox["P", "U"], "+", 
         SubscriptBox["P", "D"]}], ")"}], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        SubscriptBox["P", "D"], " ", 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["P", "U"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        SubscriptBox["P", "D"], " ", 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["P", "D"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"], " "}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821409406331142*^9, 
  3.821409437264357*^9}},ExpressionUUID->"ee8f1b97-fc14-4af8-b372-\
bff3145a468f"],

Cell["and now by construction", "ExpositoryText",
 CellChangeTimes->{{3.821409438866988*^9, 
  3.821409443418174*^9}},ExpressionUUID->"8b294b37-fabc-4991-b236-\
39b99c5db298"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", "U"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], "=", "\[DoubleStruckZero]"}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821409447681073*^9, 
  3.8214094502225847`*^9}},ExpressionUUID->"64ed48ed-ef3b-4860-bce5-\
392915e7d266"],

Cell["giving us", "ExpositoryText",
 CellChangeTimes->{{3.821409452655073*^9, 
  3.821409453931027*^9}},ExpressionUUID->"9588fe3e-f3d9-402a-94f1-\
42c54b46eb66"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", "D"], " ", 
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], 
    SubscriptBox["P", "D"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    SubsuperscriptBox["E", "n", 
     RowBox[{"(", "1", ")"}]], 
    SubscriptBox["P", "D"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821409458177875*^9, 3.821409464855318*^9}, {
  3.82146385073452*^9, 
  3.821463851044505*^9}},ExpressionUUID->"a2b88856-8e0f-4502-8b10-\
6cf65cf77e2c"],

Cell[TextData[{
 "which is an eigenvalue problem telling us that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "D"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], TraditionalForm]],
  CellChangeTimes->{{3.821409458177875*^9, 3.821409464855318*^9}},
  ExpressionUUID->"f9d0d8ae-9c97-4b0e-bcb6-99054c0f14f5"],
 " is and eigenvector of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "D"], " ", 
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], 
    SubscriptBox["P", "D"]}], TraditionalForm]],ExpressionUUID->
  "528099f3-3a08-4965-a008-55f292e5dd06"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["E", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],ExpressionUUID->
  "22472214-4aac-4a1e-96ad-661a78f4b009"],
 " is the corresponding eigenvalue."
}], "ExpositoryText",
 CellChangeTimes->{{3.821409466189032*^9, 
  3.821409536675521*^9}},ExpressionUUID->"6e6f4f63-7ecc-4427-8428-\
8776d216ae02"],

Cell[TextData[{
 "Of course, this depends on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "D"], " ", 
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], 
    SubscriptBox["P", "D"]}], TraditionalForm]],ExpressionUUID->
  "94839441-57d8-4427-b074-7b6492e9cbda"],
 " being diagonalizable. There are cases where this does not happen. One \
further thing to note, there will be cases where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "D"], " ", 
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], 
    SubscriptBox["P", "D"]}], TraditionalForm]],ExpressionUUID->
  "6037dca8-e2cd-4317-a364-d5fcb52b28e5"],
 " is diagonal or at least block-diagonal, in which cases we actually won\
\[CloseCurlyQuote]t resolve the degeneracy since we do not end up with a \
linear combination of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.821409458177875*^9, 3.821409464855318*^9}},
  ExpressionUUID->"bcf590da-a10e-46b6-96e5-9a5585d48b97"],
 " terms. We will handle these cases later"
}], "ExpositoryText",
 CellChangeTimes->{{3.821409542702289*^9, 3.821409584757435*^9}, {
  3.821463655752777*^9, 3.821463667963045*^9}, {3.821464344070756*^9, 
  3.821464344348422*^9}, {3.82146445896837*^9, 
  3.8214644678697023`*^9}},ExpressionUUID->"dc605a5e-4315-4530-917e-\
bda8dd4e679a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  SuperscriptBox["E", 
   RowBox[{"(", "k", ")"}]], 
  TraditionalForm]],ExpressionUUID->"8bd36017-cc5c-4e1a-8ce6-b496ade8b0db"]], \
"Subsubsection",
 CellChangeTimes->{{3.821409676445716*^9, 3.82140969674546*^9}, {
  3.821464280211337*^9, 
  3.82146428062521*^9}},ExpressionUUID->"163c54d8-4a62-4e17-9c09-\
9eab39bec153"],

Cell["\<\
Everything at this point looks very much so like the non-degenerate case.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.821412306595447*^9, 
  3.8214123204286413`*^9}},ExpressionUUID->"afd9c9d8-0d74-42c5-aeb6-\
b516dc94e72f"],

Cell[TextData[{
 "We\[CloseCurlyQuote]ll return once more to (9) but this time at order ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "174357f0-3677-4e4f-9872-388b197cb5e1"],
 " "
}], "ExpositoryText",
 CellChangeTimes->{{3.821409702491289*^9, 
  3.821409745970849*^9}},ExpressionUUID->"45c1ba74-2847-4b09-9b70-\
150ffa54bdf8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", "D"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], "k"], " ", 
     RowBox[{
      SuperscriptBox["H", 
       RowBox[{"(", 
        RowBox[{"k", "-", "i"}], ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}]}], "=", 
   RowBox[{
    SubscriptBox["P", "D"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], "k"], "  ", 
     RowBox[{
      SuperscriptBox["E", 
       RowBox[{"(", 
        RowBox[{"k", "-", "i"}], ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821409748148382*^9, 
  3.8214097488254423`*^9}},ExpressionUUID->"a379b62c-f996-4473-a293-\
875b96a01868"],

Cell[TextData[{
 "and to get the correction to the energy ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["E", 
    RowBox[{"(", "k", ")"}]], TraditionalForm]],ExpressionUUID->
  "3999261d-4503-432d-b27e-517cb9610f02"],
 " we\[CloseCurlyQuote]ll assume we have all energy corrections and \
wavefunction corrections through ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "-", "1"}], TraditionalForm]],ExpressionUUID->
  "993e4a2a-0e1e-49ff-84f5-06a67b9b455d"],
 ". We will go back to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "k", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "6e23ad2a-34d8-45c7-a413-2727576a3fb4"],
 " later to make sure that this base-case is satisfied."
}], "ExpositoryText",
 CellChangeTimes->{{3.821409752064705*^9, 3.821409799476058*^9}, {
  3.8214098343054943`*^9, 3.821409842368187*^9}, {3.82140996083294*^9, 
  3.821409962416891*^9}, {3.821464646855961*^9, 
  3.8214646764689007`*^9}},ExpressionUUID->"0d859098-fac8-4963-9d8a-\
9aaed24106d6"],

Cell["We can isolate this term by", "ExpositoryText",
 CellChangeTimes->{{3.821409752064705*^9, 3.821409799476058*^9}, {
  3.8214098343054943`*^9, 
  3.821409845996664*^9}},ExpressionUUID->"89430306-7e46-482d-b509-\
51596744af80"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SuperscriptBox["E", 
