Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "ptData", ",", " ", "ptDataMutationHandler", ",", " ", 
    "initializePTData"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"ptData", ",", " ", "HoldFirst"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ptData", "[", "a_Association", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"`Private`$pt", "=", "a"}], "}"}], ",", " ", 
     RowBox[{"ptData", "[", "`Private`$pt", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ptData", "/:", 
   RowBox[{"Part", "[", 
    RowBox[{
     RowBox[{"ptData", "[", "s_Symbol", "]"}], ",", " ", "x__"}], "]"}], ":=", 
   RowBox[{"s", "[", 
    RowBox[{"[", "x", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "ptDataMutationHandler", "~", "SetAttributes", "~", "HoldAllComplete"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ptDataMutationHandler", "[", 
    RowBox[{"Set", "[", 
     RowBox[{
      RowBox[{"Part", "[", 
       RowBox[{
        RowBox[{"ptData", "[", "s_Symbol", "]"}], ",", " ", "x__"}], "]"}], 
      ",", " ", "v_"}], "]"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"MatchQ", "[", 
       RowBox[{
        RowBox[{"{", "x", "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"_String", ",", " ", "_Integer"}], "}"}]}], "]"}], "&&", 
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"s", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"{", "x", "}"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}], "<", 
       RowBox[{
        RowBox[{"{", "x", "}"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"s", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"{", "x", "}"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "=", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{"PadRight", "[", 
         RowBox[{
          RowBox[{"s", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"{", "x", "}"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"{", "x", "}"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "-", "1"}], ",", " ", "None"}], 
         "]"}], ",", " ", "v"}], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"s", "[", 
       RowBox[{"[", "x", "]"}], "]"}], "=", "v"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ptDataMutationHandler", "[", 
    RowBox[{"Set", "[", 
     RowBox[{
      RowBox[{"Part", "[", 
       RowBox[{
        RowBox[{"q_Symbol", "?", 
         RowBox[{"(", 
          RowBox[{"MatchQ", "[", 
           RowBox[{"ptData", "[", "_Symbol", "]"}], "]"}], ")"}]}], ",", " ", 
        "x__"}], "]"}], ",", " ", "v_"}], "]"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", "=", "q"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Set", "[", 
      RowBox[{
       RowBox[{"s", "[", 
        RowBox[{"[", "x", "]"}], "]"}], ",", " ", "v"}], "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ptDataMutationHandler", "[", "___", "]"}], ":=", 
   "Language`MutationFallthrough"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Format", "[", 
   RowBox[{
    RowBox[{"ptData", "[", 
     RowBox[{"s_Symbol", "?", "AssociationQ"}], "]"}], ",", " ", 
    "StandardForm"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"RawBoxes", "@", 
   RowBox[{"BoxForm`ArrangeSummaryBox", "[", "\[IndentingNewLine]", 
    RowBox[{
    "ptData", ",", "\[IndentingNewLine]", "\"\<ptData\>\"", ",", 
     "\[IndentingNewLine]", "None", ",", "\[IndentingNewLine]", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"BoxForm`MakeSummaryItem", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<NPerts: \>\"", ",", " ", 
           RowBox[{"Length", "@", 
            RowBox[{"s", "[", "\"\<H\>\"", "]"}]}]}], "}"}], ",", " ", 
         "StandardForm"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"BoxForm`MakeSummaryItem", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<NDim: \>\"", ",", " ", 
           RowBox[{"s", "[", "\"\<NDim\>\"", "]"}]}], "}"}], ",", " ", 
         "StandardForm"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"BoxForm`MakeSummaryItem", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<NCorrs: \>\"", ",", " ", 
           RowBox[{"Length", "@", 
            RowBox[{"s", "[", "\"\<n\>\"", "]"}]}]}], "}"}], ",", " ", 
         "StandardForm"}], "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", "StandardForm"}], 
    "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Language`SetMutationHandler", "[", 
   RowBox[{"ptData", ",", " ", "ptDataMutationHandler"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"initializePTData", "[", 
    RowBox[{"perturbations_", ",", " ", "stateIdx_Integer"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"ptData", "@", 
    RowBox[{"<|", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\"\<H\>\"", "\[Rule]", "perturbations"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"\"\<E\>\"", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"perturbations", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"stateIdx", ",", " ", "stateIdx"}], "]"}], "]"}], "}"}]}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<n\>\"", "\[Rule]", 
       RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<idx\>\"", "\[Rule]", "stateIdx"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"\"\<NDim\>\"", "\[Rule]", 
       RowBox[{"Length", "[", 
        RowBox[{"perturbations", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], "\[IndentingNewLine]", 
     "|>"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.8217043408005323`*^9, 3.821704343584453*^9}, {
   3.821704384881184*^9, 3.821704395949615*^9}, {3.821704431880781*^9, 
