    RowBox[{
     UnderoverscriptBox["\[Union]", 
      RowBox[{"i", "=", "0"}], "k"], " ", 
     RowBox[{"\[CapitalPhi]", "(", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["g", 
          RowBox[{"(", "i", ")"}]]},
        "Bra"], 
       SuperscriptBox["A", 
        RowBox[{"(", 
         RowBox[{"k", "-", "i"}], ")"}]]}], ")"}]}], ")"}]}], 
