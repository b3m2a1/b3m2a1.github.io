 CellChangeTimes->{{3.8365873080194483`*^9, 
  3.8365873681166773`*^9}},ExpressionUUID->"d1819004-e727-4fe6-b527-\
a22f3568622b"],

Cell[TextData[StyleBox["With these rules in place we can write code to do \
this differentiation automatically, but to show the procedure out we\
\[CloseCurlyQuote]ll do up to the fourth derivatives by hand",
 FontSlant->"Italic"]], "Text",
 CellChangeTimes->{{3.792853399638084*^9, 3.792853447229116*^9}, {
  3.8366003337606173`*^9, 
  3.836600334052112*^9}},ExpressionUUID->"f29dd585-b10e-4cbd-8e32-\
1135636accee"],

Cell[CellGroupData[{

Cell["Derivatives to Target", "Subsection",
 CellChangeTimes->{{3.769950218733107*^9, 3.769950226454152*^9}, {
   3.76995029356854*^9, 3.769950305263112*^9}, 
   3.793671521757172*^9},ExpressionUUID->"10152a5d-dbf5-4773-a9b3-\
5e0abc5c4a2e"],

Cell["Basically we\[CloseCurlyQuote]ll want", "Text",
 CellChangeTimes->{{3.769950228557642*^9, 3.7699502307820797`*^9}, {
  3.769950278471691*^9, 
  3.7699503085428553`*^9}},ExpressionUUID->"65e6eaf6-a732-4a19-87c0-\
327f79033c10"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "Q"], "V"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"(", GridBox[{
          {
           FractionBox["\[PartialD]", 
            RowBox[{"\[PartialD]", 
             SubscriptBox["Q", "1"]}]], "\[CenterEllipsis]", 
           FractionBox["\[PartialD]", 
            RowBox[{"\[PartialD]", 
             SubscriptBox["Q", "m"]}]]}
         }], ")"}], "V"}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["Q", "2"]], "V"}], " ", "=", " ", 
      RowBox[{"(", GridBox[{
         {
          RowBox[{
           FractionBox[
            SuperscriptBox["\[PartialD]", "2"], 
            RowBox[{
             RowBox[{"\[PartialD]", 
              SubscriptBox["Q", "1"]}], "\[InvisibleSpace]", 
             SubscriptBox["Q", "1"]}]], "V"}], "\[CenterEllipsis]", 
          RowBox[{
           FractionBox[
            SuperscriptBox["\[PartialD]", "2"], 
            RowBox[{
             RowBox[{"\[PartialD]", 
              SubscriptBox["Q", "1"]}], "\[InvisibleSpace]", 
             SubscriptBox["Q", "m"]}]], "V"}]},
         {
          ItemBox["\[VerticalEllipsis]",
           Alignment->Center], "\[DescendingEllipsis]", 
          ItemBox["\[VerticalEllipsis]",
           Alignment->Center]},
         {
          RowBox[{
           FractionBox[
            SuperscriptBox["\[PartialD]", "2"], 
            RowBox[{
             RowBox[{"\[PartialD]", 
              SubscriptBox["Q", "1"]}], "\[InvisibleSpace]", 
             SubscriptBox["Q", "m"]}]], "V"}], "\[CenterEllipsis]", 
          RowBox[{
           FractionBox[
            SuperscriptBox["\[PartialD]", "2"], 
            RowBox[{
             RowBox[{"\[PartialD]", 
              SubscriptBox["Q", "m"]}], "\[InvisibleSpace]", 
             SubscriptBox["Q", "m"]}]], "V"}]}
        }], ")"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.769949588574173*^9, 3.7699496193722973`*^9}, {
   3.769949739282485*^9, 3.769949747760494*^9}, {3.7699498052545547`*^9, 
   3.769949846628985*^9}, 3.7699499922930117`*^9, {3.769950045615205*^9, 
   3.7699500707022877`*^9}, {3.769950290583233*^9, 3.7699503312559147`*^9}, {
   3.769950537589262*^9, 3.769950581184905*^9}, {3.769950611435698*^9, 
   3.769950635155225*^9}, {3.7699506651558313`*^9, 
   3.769950724088646*^9}},ExpressionUUID->"141df1b1-3165-40dd-819c-\
17aab5be5878"],

Cell["and higher up to order 4.", "Text",
 CellChangeTimes->{{3.769950726016573*^9, 
  3.7699507383038282`*^9}},ExpressionUUID->"3a7dc2fb-7c79-49f7-9a73-\
c1ab2cf5e0b0"],

Cell["\<\
We don\[CloseCurlyQuote]t actually have these directly, though, so we\
\[CloseCurlyQuote]ll need to build them using the chain rule a bunch from the \
components we do have.\
\>", "Text",
 CellChangeTimes->{{3.7699507396493053`*^9, 
  3.769950781635083*^9}},ExpressionUUID->"de3c65ea-7952-44db-9008-\
4df8f051d2c1"],

Cell["As a simple initial example, we want", "Text",
 CellChangeTimes->{{3.7936733573690033`*^9, 
  3.793673373072034*^9}},ExpressionUUID->"9dd6753b-1d9d-4788-9f0a-\
a10a67ca457e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", "Q"], "V"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"(", GridBox[{
       {
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", 
          SubscriptBox["Q", "1"]}]], "\[CenterEllipsis]", 
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", 
          SubscriptBox["Q", "m"]}]]}
      }], ")"}], "V"}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.769950801444975*^9, 
  3.769950805327134*^9}},ExpressionUUID->"557dc682-57ae-4102-833b-\
eaf324a70284"],

Cell["and we can look at this element wise as", "Text",
 CellChangeTimes->{{3.7936733786399612`*^9, 3.793673414679184*^9}, {
  3.7937363608993*^9, 
  3.793736361139225*^9}},ExpressionUUID->"dc904fbd-f2ce-462d-9b9d-\
eb4ddd452085"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Del]", "Q"], "V"}], ")"}], " "}], "i"], "=", 
   RowBox[{
    RowBox[{
     FractionBox["\[PartialD]", 
      RowBox[{"\[PartialD]", 
       SubscriptBox["Q", "i"]}]], "V"}], "=", 
    RowBox[{
     UnderscriptBox["\[Sum]", "j"], 
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", 
        SubscriptBox["x", "j"]}], 
       RowBox[{"\[PartialD]", 
        SubscriptBox["Q", "i"]}]], 
      RowBox[{
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", "j"]}]], "V"}]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.793673400890307*^9, 3.7936734055032387`*^9}, {
  3.7936736008624067`*^9, 3.793673627460607*^9}, {3.793711057323062*^9, 
  3.793711082075531*^9}, {3.7937363678132963`*^9, 
  3.793736377195847*^9}},ExpressionUUID->"a13d736e-ba69-4bfc-b30b-\
668db052af61"]
}, Open  ]],

Cell[CellGroupData[{

Cell["General Layout", "Subsection",
 CellChangeTimes->{{3.76994955331101*^9, 3.769949556358697*^9}, {
  3.769950132890437*^9, 
  3.769950135266973*^9}},ExpressionUUID->"e58de8b4-5aca-4a5a-a4af-\
6b82aec101b8"],

Cell["We have basically two types of terms here:", "Text",
 CellChangeTimes->{{3.7699495614221992`*^9, 3.7699495676786222`*^9}, {
  3.769950093198279*^9, 
  3.769950094318584*^9}},ExpressionUUID->"7f885a25-a94c-46c4-bb25-\
370a9a937b7f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", "Q"], "x"}], " ", "=", " ", 
   RowBox[{"(", GridBox[{
      {
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", "1"]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["Q", "1"]}]], "\[CenterEllipsis]", 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", "n"]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["Q", "1"]}]]},
      {
       ItemBox["\[VerticalEllipsis]",
        Alignment->Center], "\[DescendingEllipsis]", 
       ItemBox["\[VerticalEllipsis]",
        Alignment->Center]},
      {
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", "1"]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["Q", "m"]}]], "\[CenterEllipsis]", 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", "n"]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["Q", "m"]}]]}
     }], ")"}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.769949588574173*^9, 3.7699496193722973`*^9}, {
   3.769949739282485*^9, 3.769949747760494*^9}, {3.7699498052545547`*^9, 
   3.769949846628985*^9}, 3.7699499922930117`*^9, {3.769950329536241*^9, 
   3.7699503351921177`*^9}},ExpressionUUID->"b3181357-0219-4cf9-8ae1-\
b0b9a794e7fc"],

Cell["\<\
which is the Jacobian going from Cartesian coordinates to internal coordinate \
normal modes. We will also have higher order Jacobian type things.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.7699499990670147`*^9, 3.769950020383773*^9}, {
  3.769950098398135*^9, 3.769950109054531*^9}, {3.7699511605673428`*^9, 
  3.769951162383696*^9}, {3.770761355276408*^9, 
  3.770761355578618*^9}},ExpressionUUID->"854f3fb8-2101-4c80-9181-\
558bcbaaa3fb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", "x"], "V"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"(", GridBox[{
       {
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", 
          SubscriptBox["x", "1"]}]], "\[CenterEllipsis]", 
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", 
          SubscriptBox["x", "n"]}]]}
      }], ")"}], "V"}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.769949588574173*^9, 3.7699496193722973`*^9}, {
   3.769949739282485*^9, 3.769949747760494*^9}, {3.7699498052545547`*^9, 
   3.769949846628985*^9}, 3.7699499922930117`*^9, {3.769950045615205*^9, 
   3.7699500707022877`*^9}},ExpressionUUID->"4d6d9989-4a10-41ab-8223-\
988336b9ae69"],

Cell["\<\
which is the gradient of V with respect to the Cartesian coordinates. We\
\[CloseCurlyQuote]ll also have higher order derivatives here.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.769950077446368*^9, 3.769950126174068*^9}, {
  3.769951163415124*^9, 
  3.7699511649675827`*^9}},ExpressionUUID->"d25c51e8-28cd-47e4-98cc-\
543b25ef1714"],

Cell["\<\
I will denote higher derivatives by adding an exponent to the dependent \
variable, e.g.\
\>", "Text",
 CellChangeTimes->{{3.769950147264928*^9, 
  3.769950172559272*^9}},ExpressionUUID->"06a267d2-6850-4fa6-a960-\
6b29ef033fa2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["Q", "2"]], "x"}], " ", "=", 
   RowBox[{"(", 
    RowBox[{GridBox[{
       {
        RowBox[{
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
           SubscriptBox["Q", "1"]}]], 
         RowBox[{"(", GridBox[{
            {
             FractionBox[
              RowBox[{"\[PartialD]", 
               SubscriptBox["x", "1"]}], 
              RowBox[{"\[PartialD]", 
               SubscriptBox["Q", "1"]}]], "\[CenterEllipsis]", 
             FractionBox[
              RowBox[{"\[PartialD]", 
               SubscriptBox["x", "n"]}], 
              RowBox[{"\[PartialD]", 
               SubscriptBox["Q", "1"]}]]},
            {
             ItemBox["\[VerticalEllipsis]",
              Alignment->Center], "\[DescendingEllipsis]", 
             ItemBox["\[VerticalEllipsis]",
              Alignment->Center]},
            {
             FractionBox[
              RowBox[{"\[PartialD]", 
               SubscriptBox["x", "1"]}], 
              RowBox[{"\[PartialD]", 
               SubscriptBox["Q", "m"]}]], "\[CenterEllipsis]", 
             FractionBox[
              RowBox[{"\[PartialD]", 
               SubscriptBox["x", "n"]}], 
              RowBox[{"\[PartialD]", 
               SubscriptBox["Q", "m"]}]]}
           }], ")"}]}], "\[CenterEllipsis]", 
        RowBox[{
         RowBox[{
          FractionBox["\[PartialD]", 
           RowBox[{"\[PartialD]", 
            SubscriptBox["Q", "m"]}]], 
          RowBox[{"(", GridBox[{
             {
              FractionBox[
               RowBox[{"\[PartialD]", 
                SubscriptBox["x", "1"]}], 
               RowBox[{"\[PartialD]", 
                SubscriptBox["Q", "1"]}]], "\[CenterEllipsis]", 
              FractionBox[
               RowBox[{"\[PartialD]", 
                SubscriptBox["x", "n"]}], 
               RowBox[{"\[PartialD]", 
                SubscriptBox["Q", "1"]}]]},
             {
              ItemBox["\[VerticalEllipsis]",
               Alignment->Center], "\[DescendingEllipsis]", 
              ItemBox["\[VerticalEllipsis]",
               Alignment->Center]},
             {
              FractionBox[
               RowBox[{"\[PartialD]", 
                SubscriptBox["x", "1"]}], 
               RowBox[{"\[PartialD]", 
                SubscriptBox["Q", "m"]}]], "\[CenterEllipsis]", 
              FractionBox[
               RowBox[{"\[PartialD]", 
                SubscriptBox["x", "n"]}], 
               RowBox[{"\[PartialD]", 
                SubscriptBox["Q", "m"]}]]}
            }], ")"}]}], ")"}]}
      }], "=", 
     RowBox[{"(", GridBox[{
        {
         RowBox[{"(", GridBox[{
            {
             FractionBox[
              RowBox[{
               SuperscriptBox["\[PartialD]", "2"], 
               SubscriptBox["x", "1"]}], 
              RowBox[{
               RowBox[{"\[PartialD]", 
                SubscriptBox["Q", "1"]}], "\[InvisibleSpace]", 
               SubscriptBox["Q", "1"]}]], "\[CenterEllipsis]", 
             FractionBox[
              RowBox[{
               SuperscriptBox["\[PartialD]", "2"], 
               SubscriptBox["x", "n"]}], 
              RowBox[{
               RowBox[{"\[PartialD]", 
                SubscriptBox["Q", "1"]}], "\[InvisibleSpace]", 
               SubscriptBox["Q", "1"]}]]},
            {
             ItemBox["\[VerticalEllipsis]",
              Alignment->Center], "\[DescendingEllipsis]", 
             ItemBox["\[VerticalEllipsis]",
              Alignment->Center]},
            {
             FractionBox[
              RowBox[{
               SuperscriptBox["\[PartialD]", "2"], 
               SubscriptBox["x", "1"]}], 
              RowBox[{
               RowBox[{"\[PartialD]", 
                SubscriptBox["Q", "1"]}], "\[InvisibleSpace]", 
               SubscriptBox["Q", "m"]}]], "\[CenterEllipsis]", 
             FractionBox[
              RowBox[{
               SuperscriptBox["\[PartialD]", "2"], 
               SubscriptBox["x", "n"]}], 
              RowBox[{
               RowBox[{"\[PartialD]", 
                SubscriptBox["Q", "1"]}], "\[InvisibleSpace]", 
               SubscriptBox["Q", "m"]}]]}
           }], ")"}], "\[CenterEllipsis]", 
         RowBox[{
          RowBox[{"(", GridBox[{
             {
              FractionBox[
               RowBox[{
                SuperscriptBox["\[PartialD]", "2"], 
                SubscriptBox["x", "1"]}], 
               RowBox[{
                RowBox[{"\[PartialD]", 
                 SubscriptBox["Q", "m"]}], "\[InvisibleSpace]", 
                SubscriptBox["Q", "1"]}]], "\[CenterEllipsis]", 
              FractionBox[
               RowBox[{
                SuperscriptBox["\[PartialD]", "2"], 
                SubscriptBox["x", "n"]}], 
               RowBox[{
                RowBox[{"\[PartialD]", 
                 SubscriptBox["Q", "m"]}], "\[InvisibleSpace]", 
                SubscriptBox["Q", "1"]}]]},
             {
              ItemBox["\[VerticalEllipsis]",
               Alignment->Center], "\[DescendingEllipsis]", 
              ItemBox["\[VerticalEllipsis]",
               Alignment->Center]},
             {
              FractionBox[
               RowBox[{
                SuperscriptBox["\[PartialD]", "2"], 
                SubscriptBox["x", "1"]}], 
               RowBox[{
                RowBox[{"\[PartialD]", 
                 SubscriptBox["Q", "m"]}], "\[InvisibleSpace]", 
                SubscriptBox["Q", "m"]}]], "\[CenterEllipsis]", 
              FractionBox[
               RowBox[{
                SuperscriptBox["\[PartialD]", "2"], 
                SubscriptBox["x", "n"]}], 
               RowBox[{
                RowBox[{"\[PartialD]", 
                 SubscriptBox["Q", "m"]}], "\[InvisibleSpace]", 
                SubscriptBox["Q", "m"]}]]}
            }], ")"}], ")"}]}
       }]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.769950177857338*^9, 3.769950180790678*^9}, {
   3.76995034283674*^9, 3.7699503686094418`*^9}, 3.769950405387897*^9, {
   3.769950437007679*^9, 
   3.7699505113271017`*^9}},ExpressionUUID->"8c1a1c89-4e54-4c5b-9cc4-\
ff139c27acee"],

Cell["\<\
is the 3D tensor of second derivatives of Cartesian coordinates with respect \
to pairs of internal coordinate normal modes.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.7699501850486403`*^9, 3.769950215870234*^9}, {
  3.769950423011794*^9, 3.7699504231234827`*^9}, {3.769951166183095*^9, 
  3.7699511679756327`*^9}},ExpressionUUID->"634a525b-b4b3-49f9-b896-\
cc40703294df"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Derivatives", "Subsection",
 CellChangeTimes->{{3.806061548094932*^9, 
  3.806061549863223*^9}},ExpressionUUID->"08d7bec6-30bb-4c36-8432-\
07404b716876"],

Cell["\<\
A worthwhile thing to keep in mind: the number of terms in an expansion grows \
exponentially as the Bell Numbers. It\[CloseCurlyQuote]s a fun little graph \
proof, if you want to see it. This also shows that we should be able to write \
a general combinatoric algorithm for this expansion.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.806063883055787*^9, 3.806063899015942*^9}, {
   3.806064093425108*^9, 3.806064128888246*^9}, {3.832961040176477*^9, 
   3.8329610528727407`*^9}, 3.832961118153112*^9, {3.832961204817132*^9, 
   3.832961210022941*^9}, {3.8329612635864277`*^9, 
   3.8329612772549686`*^9}},ExpressionUUID->"a1d9b26c-3e3d-4317-ad28-\
0fe95b5b4ec6"],

Cell[CellGroupData[{

Cell["Firsts", "Subsubsection",
 CellChangeTimes->{{3.806061609662076*^9, 
  3.8060616104709997`*^9}},ExpressionUUID->"9f5b137b-43a7-47e5-bc61-\
ca3d91224725"],

Cell["These are unchanged", "ExpositoryText",
 CellChangeTimes->{{3.806063353525176*^9, 
  3.806063356610087*^9}},ExpressionUUID->"f6ba5ef0-7e47-455c-ae95-\
4cc93a8e9739"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", "Q"], "V"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "Q"], "X"}], 
    RowBox[{
     SubscriptBox["\[Del]", "X"], "V"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.806061371146659*^9, 
  3.806061405016197*^9}},ExpressionUUID->"0a520ddc-3bfa-4492-9b30-\
0425b0817e47"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Seconds", "Subsubsection",
 CellChangeTimes->{{3.806061614014204*^9, 
  3.806061614751029*^9}},ExpressionUUID->"a6596e03-06ac-4e37-9119-\
8b1ed898c84b"],

Cell["\<\
These have two transpositions removed and rewritten as tensor contractions\
\>", "ExpositoryText",
 CellChangeTimes->{{3.806063353525176*^9, 
  3.806063373809825*^9}},ExpressionUUID->"94a3d5fe-677a-46e8-8630-\
1758115b4444"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["Q", "2"]], "V"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["Q", "2"]], "X"}], 
        RowBox[{
         SubscriptBox["\[Del]", "X"], "V"}]}], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SubscriptBox["\[Del]", "Q"], "X"}], 
          RowBox[{"\[LeftAngleBracket]", "2", "\[RightAngleBracket]"}], 
          RowBox[{
           SubscriptBox["\[Del]", "Q"], "X"}], 
          RowBox[{
           SubscriptBox["\[Del]", 
            SuperscriptBox["X", "2"]], "V"}]}], ")"}], 
        RowBox[{"2", ":", "1"}]]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["Q", "2"]], "X"}], 
        RowBox[{
         SubscriptBox["\[Del]", "X"], "V"}]}], "+", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", "Q"], "X"}], 
        RowBox[{"\[LeftAngleBracket]", "2", "\[RightAngleBracket]"}], 
        RowBox[{
         SubscriptBox["\[Del]", "Q"], "X"}], 
        RowBox[{"\[LeftAngleBracket]", "2", "\[RightAngleBracket]"}], 
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["X", "2"]], "V"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.806061371146659*^9, 3.806061447018199*^9}, {
  3.806061617702224*^9, 3.80606165135922*^9}, {3.8060630631587067`*^9, 
  3.806063065880908*^9}, {3.8060642435889482`*^9, 
  3.80606424838841*^9}},ExpressionUUID->"12b651ed-f47f-49ea-94f3-\
ec94c172ef4e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Thirds", "Subsubsection",
 CellChangeTimes->{{3.806061679514073*^9, 
  3.806061680401802*^9}},ExpressionUUID->"b587e571-2820-4c09-8e76-\
d8268575841b"],

Cell["These still get gross to start, since we\[CloseCurlyQuote]ve got 5 \
elements", "ExpositoryText",
 CellChangeTimes->{{3.806063353525176*^9, 
  3.8060633912735147`*^9}},ExpressionUUID->"70d3d9d3-c02c-441b-a469-\
f73030d5214a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["Q", "3"]], "V"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", 
      SuperscriptBox["Q", "3"]], "X"}], 
    RowBox[{
     SubscriptBox["\[Del]", "X"], "V"}], Cell[TextData[Cell[BoxData[{
     FormBox[
      RowBox[{"+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SubscriptBox["\[Del]", 
            SuperscriptBox["Q", "2"]], "X"}], 
          RowBox[{"\[LeftAngleBracket]", "2", "\[RightAngleBracket]"}], 
          RowBox[{
           SubscriptBox["\[Del]", "Q"], "X"}], 
