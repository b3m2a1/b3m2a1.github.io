Cell[TextData[{
 "and from this we get the zero-order states and second-order energies, with \
the mild subtlety that we have a properly 2D state space in ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],ExpressionUUID->
  "650d0c23-8be3-4112-8af6-a2da13db82af"],
 ", but this is a 3\[Times]3 matrix, meaning either we will want to transform \
the matrix into our 2\[Times]2 space or just drop the states corresponding to \
eigenvalues of zero. We\[CloseCurlyQuote]ll do the latter. We\
\[CloseCurlyQuote]ll also once again pull the state with the largest \
contribution from our initial zero-order state of interest."
}], "ExpositoryText",
 CellChangeTimes->{{3.821737631461033*^9, 3.821737654352763*^9}, {
  3.8217379947760983`*^9, 3.821737995897489*^9}, {3.82173996257174*^9, 
  3.821740050874776*^9}, {3.8217401160800858`*^9, 3.82174016113529*^9}, {
  3.821740218527*^9, 
  3.821740258292273*^9}},ExpressionUUID->"1b88484d-046c-469a-bd9d-\
5c21a0689d5a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"$gData", "=", 
   RowBox[{"initializePTData", "[", 
    RowBox[{"perturbations", ",", "perturbedState"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"$gData", "[", 
    RowBox[{"[", 
     RowBox[{"\"\<E\>\"", ",", " ", "2"}], "]"}], "]"}], "=", 
   RowBox[{"$dD", "[", 
    RowBox[{"[", 
     RowBox[{"\"\<E\>\"", ",", " ", "2"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"deg2E2", ",", " ", "deg2N0"}], "}"}], "=", 
   RowBox[{"Eigensystem", "[", "pertH2", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"$gData", "[", 
    RowBox[{"[", 
     RowBox[{"\"\<E\>\"", ",", " ", "3"}], "]"}], "]"}], "=", 
   RowBox[{"deg2E2", "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"$gData", "[", 
    RowBox[{"[", 
     RowBox[{"\"\<n\>\"", ",", " ", "1"}], "]"}], "]"}], "=", 
   RowBox[{"ReplacePart", "[", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"$dD", "[", 
        RowBox[{"[", "\"\<NDim\>\"", "]"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{"\[ScriptCapitalD]", "\[Rule]", 
       RowBox[{"deg2N0", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "@", 
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"figStyleText", "[", "\"\<\!\(\*TemplateBox[{
SuperscriptBox[
StyleBox[\"n\", FontSlant -> \"Italic\"], 
RowBox[{\"(\", \"0\", \")\"}]]},\"Ket\"]\)\>\"", "]"}], ",", " ", 
     RowBox[{"figStyleText", "@", "\"\<=\>\""}], ",", "\[IndentingNewLine]", 
     RowBox[{"pertPlot", "[", 
      RowBox[{
       RowBox[{"\[Phi]", "[", "$gData", "]"}], "[", "0", "]"}], "]"}]}], 
    "\[IndentingNewLine]", "}"}], "}"}]}]}], "Input",
 CellChangeTimes->{{3.821737655480667*^9, 3.821737735724124*^9}, 
   3.8217377968073463`*^9, {3.821739924024795*^9, 3.82173994828695*^9}, {
