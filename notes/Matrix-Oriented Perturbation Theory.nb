  3.793223235205681*^9}},ExpressionUUID->"41c8747f-b8a5-46eb-a7ce-\
159cd56d1b83"],

Cell["\<\
If we are simply swap two axes, we define an alternate notation for \
convenience\
\>", "Text",
 CellChangeTimes->{{3.7927844090825653`*^9, 3.792784451761125*^9}, {
  3.7927845049522142`*^9, 3.792784513944119*^9}, {3.792855818454998*^9, 
