        RowBox[{"\[Omega]", "!"}], 
        RowBox[{"B", "(", 
         RowBox[{"a", ",", " ", "\[Omega]"}], ")"}]}]}]}]}], " ", "+", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"(", "a", ")"}]], " ", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"j", "=", "0"}], 
       RowBox[{"b", "+", "k"}]], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["g", 
          RowBox[{"k", "\[InvisibleSpace]", "j"}], 
          RowBox[{"\[VeryThinSpace]", 
           RowBox[{"(", 
            RowBox[{"b", "-", "1"}], ")"}]}]], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"k", "-", "1"}], ")"}], 
          SubsuperscriptBox["g", 
           RowBox[{"k", "-", 
            RowBox[{"1", "\[InvisibleSpace]", "j"}]}], 
           RowBox[{"\[VeryThinSpace]", 
            RowBox[{"(", 
             RowBox[{"b", "-", "1"}], ")"}]}]]}], "+", 
         SubsuperscriptBox["g", 
          RowBox[{"k", "-", 
           RowBox[{"1", "\[InvisibleSpace]", "j"}], "-", "1"}], 
          RowBox[{"\[VeryThinSpace]", 
           RowBox[{"(", 
            RowBox[{"b", "-", "1"}], ")"}]}]]}], ")"}], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"\[Omega]", "=", "0"}], "j"], "\[VeryThinSpace] ", 
        RowBox[{
         FractionBox[
          RowBox[{
           SubscriptBox["S", "2"], "(", 
           RowBox[{"j", ",", " ", "\[Omega]"}], ")"}], 
          RowBox[{"\[Omega]", "+", "1"}]], 
         SubscriptBox[
          RowBox[{"(", 
           RowBox[{"a", "+", "1"}], ")"}], "\[Omega]"]}]}]}]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8914956475048733`*^9, 3.891495712760597*^9}, {
  3.891565948180745*^9, 3.891565967063843*^9}, {3.891599452549464*^9, 
  3.891599455343774*^9}},ExpressionUUID->"a067adab-aeac-436e-80ab-\
aae40e7ce8ea"],

Cell[TextData[{
 "where we\[CloseCurlyQuote]ve put all the power-series dependence into the \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"B", "(", 
    RowBox[{"a", ",", " ", "\[Omega]"}], ")"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "2fc98090-52d6-415d-87ff-4f840932cb11"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{"a", "+", "1"}], ")"}], "\[Omega]"], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "4f312106-261a-4275-a695-05cb280ee83a"],
 " terms, which we\[CloseCurlyQuote]ll reexpress as a power series in ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "d8d91f2c-7ee2-467e-82b7-f56a78685177"],
 ", by noting that that ordinary generating function for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"B", "(", 
    RowBox[{"a", ",", " ", "\[Omega]"}], ")"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "e5c08b45-7723-4210-8e88-7d93edb0a571"],
 " is given by"
}], "ExpositoryText",
 CellChangeTimes->{{3.8914957209888287`*^9, 3.891495772392864*^9}, {
  3.891565988044612*^9, 
  3.8915659981840267`*^9}},ExpressionUUID->"b8c1b312-e337-4961-95f4-\
6a9459215a21"],

