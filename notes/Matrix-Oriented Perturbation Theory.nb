   RowBox[{
    SubscriptBox["P", 
     SuperscriptBox["D", 
      RowBox[{"(", "a", ")"}]]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "1"}], "a"], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "0"}], "k"], 
      RowBox[{
       SubsuperscriptBox["J", "a", 
        RowBox[{"(", "j", ")"}]], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1", "+", "a", "-", "j", "-", "i"}], ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]]},
        "Ket"]}]}]}]}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["P", 
      SuperscriptBox["D", 
       RowBox[{"(", "a", ")"}]]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"j", "=", "1"}], "a"], 
