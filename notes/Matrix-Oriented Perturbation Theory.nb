  3.813587273155406*^9, 3.8135873008293247`*^9}},
 CellLabel->
  "Out[1578]=",ExpressionUUID->"84e9ea04-36e0-46a6-a2f5-ee01a9d17146"]
}, Open  ]],

Cell[TextData[{
 "so now this gives us restrictions possible space for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "p", "\[InvisibleSpace]", "Q", "\[InvisibleSpace]", "Q", 
    "\[InvisibleSpace]", "p"}], TraditionalForm]],ExpressionUUID->
  "8f1c0302-0809-43b0-86ab-aa9361b692dc"],
 " since we know that after applying ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", "\[InvisibleSpace]", "Q", "\[InvisibleSpace]", "Q"}], 
   TraditionalForm]],ExpressionUUID->"e5577062-afcd-44a6-b5df-d4017c942ed9"],
 " we need to be in a state like"
}], "ExpositoryText",
 CellChangeTimes->{{3.813587904619532*^9, 3.813587939500105*^9}, {
  3.8135881680546513`*^9, 3.813588273825252*^9}, {3.813588364277952*^9, 
  3.8135883994969788`*^9}, {3.813588552212949*^9, 
  3.8135885666115847`*^9}},ExpressionUUID->"c55153ae-6c6a-41cf-9ec4-\
31c5dc5a53ee"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{
    TemplateBox[{
      RowBox[{
        SubscriptBox["n", "i"], "\[PlusMinus]", "1"}]},
     "Ket"], ",", " ", 
    TemplateBox[{
      RowBox[{
        SubscriptBox["n", "i"], "\[PlusMinus]", "3"}]},
     "Ket"], ",", " ", 
    RowBox[{
     TemplateBox[{
       RowBox[{
         SubscriptBox["n", "i"], "\[PlusMinus]", "1"}]},
      "Ket"], 
     TemplateBox[{
       RowBox[{
         SubscriptBox["n", "j"], "\[PlusMinus]", "2"}]},
      "Ket"]}], ",", " ", 
    RowBox[{
     TemplateBox[{
       RowBox[{
         SubscriptBox["n", "i"], "\[PlusMinus]", "1"}]},
      "Ket"], 
     TemplateBox[{
       RowBox[{
         SubscriptBox["n", "j"], "\[PlusMinus]", "1"}]},
      "Ket"], 
     TemplateBox[{
       RowBox[{
         SubscriptBox["n", "k"], "\[PlusMinus]", "1"}]},
      "Ket"]}]}], "}"}], TraditionalForm]], "ExpositoryMathCentered",
