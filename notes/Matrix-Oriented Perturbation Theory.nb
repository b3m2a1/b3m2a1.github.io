       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821320803368054*^9, 3.821320836201187*^9}, {
  3.821320869649582*^9, 3.8213209510910683`*^9}, {3.821320995123756*^9, 
