Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["V", "\[Prime]"], "=", 
   RowBox[{
    RowBox[{
     FractionBox[
      SuperscriptBox["\[HBar]", "2"], "8"], 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{"i", "\[InvisibleSpace]", "j"}]], 
      RowBox[{
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["G", 
          RowBox[{"i", "\[VeryThinSpace]", "j"}]]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["q", "i"]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", "\[Gamma]"}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["q", "j"]}]]}]}]}], "+", 
    RowBox[{
     SubscriptBox["G", 
      RowBox[{"i", "\[InvisibleSpace]", "j"}]], "(", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox["\[PartialD]", "2"], "\[Gamma]"}], 
        RowBox[{
         RowBox[{"\[PartialD]", 
          SubscriptBox["q", "i"]}], 
         SubscriptBox["q", "j"]}]], 
       RowBox[{"+", 
        FractionBox["1", "4"]}]}], 
      FractionBox[
       RowBox[{"\[PartialD]", "\[Gamma]"}], 
       RowBox[{"\[PartialD]", 
        SubscriptBox["q", "i"]}]], 
      FractionBox[
       RowBox[{"\[PartialD]", "\[Gamma]"}], 
