        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "k", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        SubscriptBox["P", 
         SuperscriptBox["D", 
          RowBox[{"(", "a", ")"}]]], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
           StyleBox["b",
            FontSize->10], "=", "0"}], "a"], 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"j", "=", "0"}], "b"], 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"i", "=", "0"}], 
            RowBox[{"k", "-", "1"}]], 
           RowBox[{
            SuperscriptBox["\[CapitalDelta]H", 
             RowBox[{"(", 
              RowBox[{"a", "+", "1"}], ")"}]], 
            SubscriptBox["\[CapitalPi]", 
             SuperscriptBox["U", 
              RowBox[{"(", "b", ")"}]]], 
            SubsuperscriptBox["J", "b", 
             RowBox[{"(", "j", ")"}]], 
            SubsuperscriptBox["\[CapitalDelta]H", "n", 
             RowBox[{"(", 
              RowBox[{"k", "+", "b", "-", "j", "-", "i"}], ")"}]], 
            TemplateBox[{
              SuperscriptBox["n", 
               RowBox[{"(", "i", ")"}]]},
             "Ket"]}]}]}]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        SubscriptBox["P", 
         SuperscriptBox["D", 
          RowBox[{"(", "a", ")"}]]], 
        SuperscriptBox["\[CapitalDelta]H", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]], 
        SubscriptBox["P", 
         SuperscriptBox["D", 
          RowBox[{"(", "a", ")"}]]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "k", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        SubscriptBox["P", 
         SuperscriptBox["D", 
          RowBox[{"(", "a", ")"}]]], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"i", "=", "0"}], 
          RowBox[{"k", "-", "1"}]], " ", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{
            StyleBox["b",
             FontSize->10], "=", "0"}], "a"], 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"j", "=", "0"}], "b"], " ", 
           RowBox[{
            SubsuperscriptBox["\[CapitalGamma]", "b", 
             RowBox[{"a", "+", "1"}]], "\[InvisibleSpace]", 
            SubsuperscriptBox["J", "b", 
             RowBox[{"(", "j", ")"}]], 
            SubsuperscriptBox["\[CapitalDelta]H", "n", 
             RowBox[{"(", 
              RowBox[{"k", "+", "b", "-", "j", "-", "i"}], ")"}]], 
            TemplateBox[{
              SuperscriptBox["n", 
               RowBox[{"(", "i", ")"}]]},
             "Ket"]}]}]}]}]}]}]}]}
