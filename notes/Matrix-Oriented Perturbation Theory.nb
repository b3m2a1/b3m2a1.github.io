Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["QQQ", "65"], "=", 
   RowBox[{
    RowBox[{"(", GridBox[{
       {
        RowBox[{"(", GridBox[{
           {
            RowBox[{
             FractionBox["3", 
              RowBox[{"2", " ", 
               SqrtBox["2"]}]], 
             SubscriptBox["\[Delta]", "01"], 
             SubscriptBox["\[Delta]", "11"]}], 
            RowBox[{"0", "*", 
             FractionBox["1", 
              SqrtBox["2"]], 
             SubscriptBox["\[Delta]", "11"]}], 
            RowBox[{"0", "*", "0", 
             SubscriptBox["\[Delta]", "01"]}]},
           {
            RowBox[{"0", "*", 
             FractionBox["1", 
              SqrtBox["2"]], 
             SubscriptBox["\[Delta]", "11"]}], 
            RowBox[{
             FractionBox["1", 
              SqrtBox["2"]], "*", "0", 
             SubscriptBox["\[Delta]", "11"]}], 
            RowBox[{
             FractionBox["1", 
              SqrtBox["2"]], "*", 
             FractionBox["1", 
              SqrtBox["2"]], "*", "0"}]},
           {
            RowBox[{"0", "*", "0", 
             SubscriptBox["\[Delta]", "01"]}], 
            RowBox[{
             FractionBox["1", 
              SqrtBox["2"]], "*", 
             FractionBox["1", 
              SqrtBox["2"]], "*", "0"}], 
            RowBox[{
             FractionBox["1", 
              SqrtBox["2"]], "*", 
             FractionBox["3", "2"], 
             SubscriptBox["\[Delta]", "01"]}]}
          },
          GridBoxAlignment->{"Columns" -> {{Center}}}], ")"}]},
       {
        RowBox[{"(", GridBox[{
           {
            RowBox[{"0", "*", 
             FractionBox["1", 
              SqrtBox["2"]], 
             SubscriptBox["\[Delta]", "11"]}], 
            RowBox[{
             FractionBox["1", 
              SqrtBox["2"]], "*", "0", 
             SubscriptBox["\[Delta]", "11"]}], 
            RowBox[{
             FractionBox["1", 
              SqrtBox["2"]], "*", 
             FractionBox["1", 
              SqrtBox["2"]], "*", "0"}]},
           {
            RowBox[{
             FractionBox["1", 
              SqrtBox["2"]], "*", "0", 
             SubscriptBox["\[Delta]", "11"]}], 
            RowBox[{
             FractionBox["3", 
              RowBox[{"2", " ", 
               SqrtBox["2"]}]], 
             SubscriptBox["\[Delta]", "10"], 
             SubscriptBox["\[Delta]", "11"]}], 
            RowBox[{"0", "*", "0", 
             SubscriptBox["\[Delta]", "10"]}]},
           {
            RowBox[{
             FractionBox["1", 
              SqrtBox["2"]], "*", 
             FractionBox["1", 
              SqrtBox["2"]], "*", "0"}], 
            RowBox[{"0", "*", "0", 
             SubscriptBox["\[Delta]", "10"]}], 
            RowBox[{
             FractionBox["1", 
              SqrtBox["2"]], 
             FractionBox["3", "2"], 
             SubscriptBox["\[Delta]", "10"]}]}
          },
          GridBoxAlignment->{"Columns" -> {{Center}}}], ")"}]},
       {
        RowBox[{"(", GridBox[{
           {
            RowBox[{"0", "*", "0", 
             SubscriptBox["\[Delta]", "01"]}], 
            RowBox[{
             FractionBox["1", 
              SqrtBox["2"]], "*", 
             FractionBox["1", 
              SqrtBox["2"]], "*", "0"}], 
            RowBox[{
             FractionBox["1", 
              SqrtBox["2"]], "*", 
             FractionBox["3", "2"], 
             SubscriptBox["\[Delta]", "01"]}]},
           {
            RowBox[{
             FractionBox["1", 
              SqrtBox["2"]], "*", 
             FractionBox["1", 
              SqrtBox["2"]], "*", "0"}], 
            RowBox[{"0", "*", "0", 
             SubscriptBox["\[Delta]", "10"]}], 
            RowBox[{
             FractionBox["1", 
              SqrtBox["2"]], "*", 
             FractionBox["3", "2"], 
             SubscriptBox["\[Delta]", "10"]}]},
           {
            RowBox[{
             FractionBox["1", 
              SqrtBox["2"]], "*", 
             FractionBox["3", "2"], 
             SubscriptBox["\[Delta]", "01"]}], 
            RowBox[{
             FractionBox["1", 
              SqrtBox["2"]], "*", 
             FractionBox["3", "2"], 
             SubscriptBox["\[Delta]", "10"]}], 
            RowBox[{"0", 
             SubscriptBox["\[Delta]", "10"], 
             SubscriptBox["\[Delta]", "01"]}]}
          },
          GridBoxAlignment->{"Columns" -> {{Center}}}], ")"}]}
      }], ")"}], "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{"(", GridBox[{
           {"0", "0", "0"},
           {"0", "0", "0"},
           {"0", "0", "0"}
          },
          GridBoxAlignment->{"Columns" -> {{Center}}}], ")"}]},
       {
        RowBox[{"(", GridBox[{
           {"0", "0", "0"},
           {"0", "0", "0"},
           {"0", "0", "0"}
          },
          GridBoxAlignment->{"Columns" -> {{Center}}}], ")"}]},
       {
        RowBox[{"(", GridBox[{
           {"0", "0", "0"},
           {"0", "0", "0"},
           {"0", "0", "0"}
          },
          GridBoxAlignment->{"Columns" -> {{Center}}}], ")"}]}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.793824715936226*^9, 3.793825001295821*^9}, {
  3.7938250501948233`*^9, 3.793825182436784*^9}, {3.793916940177827*^9, 
  3.793917105950408*^9}},ExpressionUUID->"b52f3514-067a-4285-82ff-\
2e2d949a20f8"],

Cell["\<\
And so looked like a very large tensor turns out to be identically 0. This is \
a pretty common phenomenon with these and if we are trying to be very \
computationally efficient we can use selection rules to guide which terms we \
actually need to consider.\
\>", "Text",
 CellChangeTimes->{{3.793917114481159*^9, 
  3.7939171901890087`*^9}},ExpressionUUID->"1b308926-6848-410e-b367-\
ac5b4146b52c"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Operator Tensor Symmetries", "Subsection",
 CellChangeTimes->{{3.810594254909824*^9, 
  3.8105942622499657`*^9}},ExpressionUUID->"7fe65181-2406-47f5-96f7-\
788025c99c75"],

Cell[TextData[{
 "When we build our representations, one key thing we can take advantage of \
is the symmetry of the problem. In particular, for ",
 StyleBox["unshared",
  FontSlant->"Italic"],
 " indices, we should be able to symmetrize at will, so"
}], "ExpositoryText",
 CellChangeTimes->{{3.8105942636997643`*^9, 3.810594333635433*^9}, {
  3.810594538872313*^9, 3.810594572687889*^9}, {3.810594623852317*^9, 
  3.8105946242114058`*^9}},ExpressionUUID->"d166504f-7560-448c-ad1d-\
bccaf1f0889f"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["p", "i"], 
       SubscriptBox["Q", "j"], 
       SubscriptBox["p", "k"]}], "=", 
      RowBox[{
       RowBox[{
        SubscriptBox["p", "i"], 
        SubscriptBox["p", "k"], 
        SubscriptBox["Q", "j"]}], "=", 
       RowBox[{
        SubscriptBox["p", "k"], 
        SubscriptBox["p", "i"], 
        SubscriptBox["Q", "j"]}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["p", "i"], 
       SubscriptBox["Q", "j"], 
       SubscriptBox["p", "i"]}], "=", 
      RowBox[{
       SubscriptBox["p", "i"], 
       SubscriptBox["p", "i"], 
       SubscriptBox["Q", "j"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.810594334839978*^9, 3.8105943456272573`*^9}, {
  3.810594512600377*^9, 3.810594526280569*^9}, {3.810594594359313*^9, 
  3.8105946423050547`*^9}, {3.810594686524005*^9, 
  3.810594731183895*^9}},ExpressionUUID->"f0f6e326-8260-4a48-bbfa-\
aa8ff1f21cbb"],

Cell["\<\
but when indices are shared we lose that flexibility, as we note that \
\>", "ExpositoryText",
 CellChangeTimes->{{3.810594613734785*^9, 3.81059468142476*^9}, {
   3.8105947666246567`*^9, 3.810594797666497*^9}, 
   3.810594836168117*^9},ExpressionUUID->"dc4d1de2-be2c-435d-9f1d-\
85075e3d7107"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["p", "i"], 
    SubscriptBox["Q", "i"], 
    SubscriptBox["p", "j"]}], "\[NotEqual]", 
   RowBox[{
    SubscriptBox["Q", "i"], 
    SubscriptBox["p", "i"], 
    SubscriptBox["p", "j"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.810594807879183*^9, 3.810594829672619*^9}, {
  3.8105948675822*^9, 
  3.8105948685372133`*^9}},ExpressionUUID->"c88605b0-4a3e-4195-b2b2-\
8bddea30243d"],

Cell["\<\
this is effectively due to the lack of commutativity of these terms\
\>", "ExpositoryText",
 CellChangeTimes->{{3.810594877437604*^9, 
  3.8105949053651323`*^9}},ExpressionUUID->"de020077-f89c-4f3a-b938-\
e7149c93c9ad"],

Cell[TextData[{
 "This means that when we are determining if two terms are equivalent we need \
to ask ourselves one main thing: ",
 StyleBox["have we transposed our terms?",
  FontSlant->"Italic"]
}], "ExpositoryText",
 CellChangeTimes->{{3.810595233602614*^9, 
  3.81059532345457*^9}},ExpressionUUID->"8c3369c8-fb12-488b-be84-\
a6ea77fbd1c1"],

Cell[TextData[{
 "The issue is that this can be tough to figure out. Algorithmically we need \
to first know which of our terms can be treated as equivalent (e.g. ",
 StyleBox["Q",
  FontSlant->"Italic"],
 " and ",
 StyleBox["Q",
  FontSlant->"Italic"],
 ", but not ",
 StyleBox["Q",
  FontSlant->"Italic"],
 " and ",
 StyleBox["p",
  FontSlant->"Italic"],
 "). Then we check to see if any of our terms have been swapped around."
}], "ExpositoryText",
 CellChangeTimes->{{3.810595331830245*^9, 3.810595428700905*^9}, {
  3.810640140571856*^9, 
  3.810640170378456*^9}},ExpressionUUID->"38fa30ba-43b9-4881-b67b-\
87db18d9abe6"]
}, Closed]],

Cell[CellGroupData[{

Cell["Sample Code", "Subsection",
 CellChangeTimes->{{3.8109944860830803`*^9, 
  3.81099448880068*^9}},ExpressionUUID->"278f1d40-1367-4f31-bf33-\
488fe22e75f1"],

Cell["\<\
This provides Mathematica code to obtain explicit symbolic forms of tensor \
elements\
