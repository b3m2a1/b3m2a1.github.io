Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fgShifts2", "[", "b_", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fg", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"b", ">", "1"}], ",", " ", 
         RowBox[{"fgCoeffs2", "[", 
          RowBox[{"b", "-", "1"}], "]"}], ",", 
         RowBox[{"{", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"{", "1", "}"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"{", "0", "}"}], "}"}]}], " ", "}"}]}], "]"}]}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"MapIndexed", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"baseMat", "=", "\[IndentingNewLine]", 
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"C", "=", 
                RowBox[{"ArrayFlatten", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"#", ",", " ", "0"}], "}"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], "]"}]}], 
               "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{"Total", "@", 
               RowBox[{"{", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"2", 
                  RowBox[{"C", "[", 
                   RowBox[{"[", 
                    RowBox[{";;", ",", " ", ";;"}], "]"}], "]"}]}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"4", "*", 
                  RowBox[{"ArrayFlatten", "[", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"0", ",", " ", "#"}], "}"}]}], "}"}], "]"}]}], 
                 ",", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"-", "4"}], "*", 
                  RowBox[{"Join", "[", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{"0", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", " ", 
                    RowBox[{
                    RowBox[{"Dimensions", "[", "C", "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Range", "[", 
                    RowBox[{"0", ",", " ", 
                    RowBox[{"b", "-", "1"}]}], "]"}], "*", 
                    RowBox[{"C", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"1", ";;", 
                    RowBox[{"-", "2"}]}], ",", " ", ";;"}], "]"}], "]"}]}], 
                    " ", ",", "\[IndentingNewLine]", "1"}], 
                   "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
                "}"}]}]}], "\[IndentingNewLine]", "]"}]}], 
           "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#2", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "==", "2"}], ",", " ", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"PadRight", "[", 
                RowBox[{"#", ",", " ", 
                 RowBox[{"2", "b"}]}], "]"}], "&"}], ",", "baseMat"}], "]"}], 
            ",", " ", "baseMat"}], "]"}]}], "\[IndentingNewLine]", "]"}], 
        "&"}], ",", "\[IndentingNewLine]", "fg"}], "\[IndentingNewLine]", 
      "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fgCoeffs2", "[", "b_", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fg", "=", 
       RowBox[{"fgShifts2", "[", "b", "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"fg", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ".", 
        RowBox[{"tfLamMat", "[", "b", "]"}]}], ",", "\[IndentingNewLine]", 
