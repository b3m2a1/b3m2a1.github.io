      SuperscriptBox["\[HBar]", "2"], "8"], " ", 
     FractionBox["1", 
      RowBox[{"\[InvisibleSpace]", "g"}]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "\[InvisibleSpace]", ",", "j"}], 
       RowBox[{
        RowBox[{"3", "\[InvisibleSpace]", "N"}], "-", "6"}]], 
      RowBox[{
       SubscriptBox["G", 
        RowBox[{"i", "\[InvisibleSpace]", "j"}]], 
       FractionBox[
        RowBox[{
         SuperscriptBox["\[PartialD]", "2"], "g"}], 
        RowBox[{
         RowBox[{"\[PartialD]", 
          SubscriptBox["Q", "i"]}], 
         RowBox[{"\[PartialD]", 
          SubscriptBox["Q", "j"]}]}]]}]}]}], "+", 
    RowBox[{
     FractionBox[
      SubscriptBox["G", 
       RowBox[{"i", "\[InvisibleSpace]", "j"}]], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["Q", "i"]}]], 
     FractionBox[
      RowBox[{"\[PartialD]", "g"}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["Q", "j"]}]]}], "-", 
    RowBox[{
     FractionBox["3", 
      RowBox[{"4", "g"}]], 
