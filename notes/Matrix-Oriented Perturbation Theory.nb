77502cc7a7f3"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Coordinate Invariance", "Section",
 CellChangeTimes->{{3.9197686527067013`*^9, 3.919768656894507*^9}, {
  3.920032331645687*^9, 
  3.920032332597344*^9}},ExpressionUUID->"484f4ac6-1269-4177-afb2-\
b95fba0efbe0"],

Cell[TextData[{
 "We\[CloseCurlyQuote]ll start by expressing ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "713a27fb-0a65-488a-8f73-4c64364b5454"],
 " in two separate coordinate sets assuming in one of the coordinate systems \
the potential terms only go up to 2nd order"
}], "ExpositoryText",
 CellChangeTimes->{{3.91976865826161*^9, 
  3.9197687007151546`*^9}},ExpressionUUID->"caad524f-102f-450a-9ccd-\
9c6080d9ac4a"],

Cell[TextData[{
 "These will be an initial set of dimensionless normal modes ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "18f08367-0c29-401f-9152-6a17db5fe51c"],
 " and an alternate set ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "d558dc23-129f-4087-81b5-302a582aa9ef"],
 ", the difference between the two being the set of reference coordinates"
}], "ExpositoryText",
 CellChangeTimes->{{3.919768730042733*^9, 3.9197687762655897`*^9}, {
  3.919768893194509*^9, 
  3.919768894980377*^9}},ExpressionUUID->"53e81ad4-7298-4541-952d-\
6c353bff0991"],

Cell["In general, this means", "ExpositoryText",
 CellChangeTimes->{{3.919768863957666*^9, 
  3.9197688685549393`*^9}},ExpressionUUID->"329eb3f0-2069-4cae-bed5-\
c48937ffd3f4"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["H", "Q", 
       RowBox[{"(", "i", ")"}]], " ", "=", " ", 
      RowBox[{
       RowBox[{
        FractionBox["1", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"k", "+", "1"}], ")"}], "!"}]], 
        RowBox[{
         RowBox[{
          SubscriptBox["\[Del]", 
           SuperscriptBox["Q", 
            RowBox[{"(", "i", ")"}]]], 
          SubscriptBox["G", "Q"]}], "\[CircleDot]", "P"}], 
        "\[InvisibleSpace]", 
        SuperscriptBox["Q", "i"], "\[InvisibleSpace]", "P"}], " ", "+", " ", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["Q", 
           RowBox[{"(", 
            RowBox[{"i", "-", "i"}], ")"}]]], 
         SubscriptBox["U", "Q"]}], "\[CircleDot]", "\[InvisibleSpace]", 
        SuperscriptBox["Q", 
         RowBox[{"i", "-", "2"}]], "\[InvisibleSpace]"}]}]}]},
    {
     RowBox[{
      SubsuperscriptBox["H", "R", 
       RowBox[{"(", "i", ")"}]], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["R", 
           RowBox[{"(", 
            RowBox[{"i", "+", "2"}], ")"}]]], 
         SubscriptBox["V", "R"]}], "\[CircleDot]", "\[InvisibleSpace]", 
        SuperscriptBox["Q", 
         RowBox[{"i", "+", "2"}]]}], " ", "+", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          SubscriptBox["\[Del]", 
           SuperscriptBox["R", 
            RowBox[{"(", "i", ")"}]]], 
          SubscriptBox["G", "R"]}], "\[CircleDot]", "P"}], 
        "\[InvisibleSpace]", 
        SuperscriptBox["Q", "i"], "\[InvisibleSpace]", "P"}], " ", "+", " ", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["R", 
           RowBox[{"(", 
            RowBox[{"i", "-", "i"}], ")"}]]], 
         SubscriptBox["U", "R"]}], "\[CircleDot]", "\[InvisibleSpace]", 
        SuperscriptBox["Q", 
         RowBox[{"i", "-", "2"}]], "\[InvisibleSpace]"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.919768870866702*^9, 3.9197689944297028`*^9}, {
  3.920142058642153*^9, 
  3.920142070386539*^9}},ExpressionUUID->"ce23ee54-aafe-48f2-9918-\
b1d4b6ba7072"],

Cell["where we\[CloseCurlyQuote]ll let", "ExpositoryText",
 CellChangeTimes->{{3.919768998056221*^9, 
  3.919768999861085*^9}},ExpressionUUID->"c8dcc639-001c-47fb-a122-\
bbd0ec9d16c7"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["G", "R", 
       RowBox[{"(", "i", ")"}]], " ", "=", " ", 
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["R", 
         RowBox[{"(", "i", ")"}]]], 
       SubscriptBox["G", "R"]}]}]},
    {
     RowBox[{
      SubsuperscriptBox["V", "R", 
       RowBox[{"(", "i", ")"}]], " ", "=", " ", 
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["R", 
         RowBox[{"(", 
          RowBox[{"i", "+", "2"}], ")"}]]], 
       SubscriptBox["V", "R"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.919769004422269*^9, 
  3.919769036152481*^9}},ExpressionUUID->"ac231eed-9d4f-40cf-8a65-\
e6168ef81839"],

Cell["Now notably, ", "ExpositoryText",
 CellChangeTimes->{{3.919769038766345*^9, 
