Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{"n"},
        "Bra"], 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["Q", "k"]], "G"}], "\[CircleDot]", "P"}], 
       "\[InvisibleSpace]", 
       SuperscriptBox["Q", "k"], "\[InvisibleSpace]", "P", 
       TemplateBox[{"n"},
        "Ket"]}], " ", "=", " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "i"], " ", 
       RowBox[{
        FractionBox[
         RowBox[{
          SubscriptBox["T", "i"], "(", "n", ")"}], 
         RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", 
          SubscriptBox["E", "i"]}]], 
        RowBox[{
         SubscriptBox["R", "i"], "(", 
         RowBox[{
          SubscriptBox["\[Del]", 
           SuperscriptBox["Q", "k"]], "G"}], ")"}]}]}]}]},
    {
     RowBox[{
      RowBox[{
       TemplateBox[{"n"},
        "Bra"], 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["Q", 
           RowBox[{"k", "+", "2"}]]], "V"}], "\[CircleDot]", 
        SuperscriptBox["Q", 
         RowBox[{"k", "+", "2"}]]}], 
       TemplateBox[{"n"},
        "Ket"]}], " ", "=", " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "i"], " ", 
       RowBox[{
        FractionBox[
         RowBox[{
          SubscriptBox["T", "i"], "(", "n", ")"}], 
         RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", 
          SubscriptBox["E", "i"]}]], 
        RowBox[{
         SubscriptBox["R", "i"], "(", 
         RowBox[{
          SubscriptBox["\[Del]", 
           SuperscriptBox["Q", 
            RowBox[{"k", "+", "2"}]]], "V"}], ")"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9204002292799377`*^9, 3.9204002306912394`*^9}, {
  3.920400266360861*^9, 3.920400305076523*^9}, {3.9204014973749437`*^9, 
