Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "a"], " ", 
       RowBox[{
        RowBox[{"(", GridBox[{
           {
            RowBox[{"i", "+", "b", "-", "1"}]},
           {
            RowBox[{"b", "-", "1"}]}
          },
          GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
        SuperscriptBox["i", "\[Omega]"]}]}], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "a"], " ", 
       RowBox[{
        RowBox[{"(", GridBox[{
           {
            RowBox[{"i", "+", "b", "-", "1"}]},
           {
            RowBox[{"b", "-", "1"}]}
          },
          GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"j", "=", "0"}], "\[Omega]"], 
         RowBox[{
          RowBox[{
           SubscriptBox["S", "2"], "(", 
           RowBox[{"\[Omega]", ",", " ", 
            RowBox[{"j", "+", "1"}]}], ")"}], 
          RowBox[{
           UnderoverscriptBox["\[Product]", 
            RowBox[{"x", "=", "0"}], "j"], 
           RowBox[{"(", 
            RowBox[{"i", "-", "x"}], ")"}]}]}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "a"], " ", 
       RowBox[{
        FractionBox["1", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"b", "-", "1"}], ")"}], "!"}]], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"j", "=", "0"}], "\[Omega]"], 
         RowBox[{
          RowBox[{
           SubscriptBox["S", "2"], "(", 
           RowBox[{"\[Omega]", ",", " ", 
            RowBox[{"j", "+", "1"}]}], ")"}], 
          RowBox[{
           UnderoverscriptBox["\[Product]", 
            RowBox[{"x", "=", 
             RowBox[{"-", "j"}]}], 
            RowBox[{"b", "-", "1"}]], 
           RowBox[{"(", 
            RowBox[{"i", "+", "j"}], ")"}]}]}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       FractionBox["1", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"b", "-", "1"}], ")"}], "!"}]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], "\[Omega]"], " ", 
        RowBox[{
         RowBox[{
          SubscriptBox["S", "2"], "(", 
          RowBox[{"\[Omega]", ",", " ", 
           RowBox[{"j", "+", "1"}]}], ")"}], 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"i", "=", "0"}], "a"], 
          RowBox[{
           UnderoverscriptBox["\[Product]", 
            RowBox[{"x", "=", 
             RowBox[{"-", "j"}]}], 
            RowBox[{"b", "-", "1"}]], 
           RowBox[{"(", 
            RowBox[{"i", "+", "x"}], ")"}]}]}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       FractionBox["1", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"b", "-", "1"}], ")"}], "!"}]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], "\[Omega]"], " ", 
        RowBox[{
         RowBox[{
          SubscriptBox["S", "2"], "(", 
          RowBox[{"\[Omega]", ",", " ", 
           RowBox[{"j", "+", "1"}]}], ")"}], 
         FractionBox["1", 
          RowBox[{"b", "+", "1", "+", "j"}]], 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"a", "+", "b"}], ")"}], "!"}], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"a", "-", 
             RowBox[{"(", 
              RowBox[{"j", "+", "1"}], ")"}]}], ")"}], "!"}]]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", "0"}], "\[Omega]"], " ", 
       RowBox[{
        RowBox[{
         SubscriptBox["S", "2"], "(", 
         RowBox[{"\[Omega]", ",", " ", 
          RowBox[{"j", "+", "1"}]}], ")"}], 
        FractionBox["b", 
         RowBox[{"b", "+", "1", "+", "j"}]], 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"a", "+", "b"}], ")"}], "!"}], 
         RowBox[{
          RowBox[{"b", "!"}], 
          RowBox[{"a", "!"}]}]], 
        RowBox[{
         UnderoverscriptBox["\[Product]", 
          RowBox[{"x", "=", "0"}], "j"], " ", 
         RowBox[{"(", 
          RowBox[{"a", "-", "x"}], ")"}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{"(", GridBox[{
          {
           RowBox[{"a", "+", "b"}]},
          {"b"}
         },
         GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], "\[Omega]"], " ", 
        RowBox[{
         RowBox[{
          SubscriptBox["S", "2"], "(", 
          RowBox[{"\[Omega]", ",", " ", 
           RowBox[{"j", "+", "1"}]}], ")"}], 
         FractionBox["b", 
          RowBox[{"b", "+", "1", "+", "j"}]], 
         RowBox[{
          UnderoverscriptBox["\[Product]", 
           RowBox[{"x", "=", "0"}], "j"], " ", 
          RowBox[{"(", 
           RowBox[{"a", "-", "x"}], ")"}]}]}]}]}]}]},
    {
     RowBox[{"=", "  ", 
      RowBox[{
       RowBox[{"(", GridBox[{
          {
           RowBox[{"a", "+", "b"}]},
          {"b"}
         },
         GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], "\[Omega]"], " ", 
        RowBox[{
         RowBox[{
          SubscriptBox["S", "2"], "(", 
          RowBox[{"\[Omega]", ",", " ", 
           RowBox[{"j", "+", "1"}]}], ")"}], 
         FractionBox["b", 
          RowBox[{"b", "+", "j", "+", "1"}]], 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"l", "=", "1"}], 
           RowBox[{"j", "+", "1"}]], " ", 
          RowBox[{
           RowBox[{
            SubscriptBox["S", "1"], "(", 
            RowBox[{
             RowBox[{"j", "+", "1"}], ",", " ", "l"}], ")"}], 
           SuperscriptBox["a", "l"]}]}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.889465914002426*^9, 3.8894660400473833`*^9}, {
