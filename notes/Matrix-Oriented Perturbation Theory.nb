 CellChangeTimes->{{3.82132575074745*^9, 
  3.821325768486836*^9}},ExpressionUUID->"ff9df311-6c13-4375-9bcb-\
5a2a3b5a4703"],

Cell[TextData[{
 "Finally, we need to resolve the apparent contradiction that I\
\[CloseCurlyQuote]m assuming we have the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "-", "1"}], TraditionalForm]],ExpressionUUID->
  "35bcb6c5-8803-4732-9aeb-025ff33e603d"],
 " states here but in the previous section we needed to solve for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "-", "1"}], TraditionalForm]],ExpressionUUID->
  "c6a126f2-5b16-4e7b-93fc-7e1240e4db47"],
 ". "
}], "ExpositoryText",
 CellChangeTimes->{{3.821325773667712*^9, 
  3.821325857073292*^9}},ExpressionUUID->"f421a34b-4c66-47cc-9e1b-\
4ab7d440ba75"],

Cell[TextData[{
 "This contradiction is resolved by noting that what we meant by ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "5233f73f-0a27-4f3f-aded-87ece3a24107"],
 " changed. To wit, the way we actually will build up looks like this"
}], "ExpositoryText",
 CellChangeTimes->{{3.821325773667712*^9, 
  3.821325890324914*^9}},ExpressionUUID->"cdab2958-a77a-467b-bdc2-\
3e0c62601c78"],

