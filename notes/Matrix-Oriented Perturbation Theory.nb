  RowBox[{
   RowBox[{
    TemplateBox[{"g"},
     "Bra"], "A", 
    TemplateBox[{"n"},
     "Ket"]}], " ", "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"k", "=", "0"}], "N"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], "k"], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"j", "=", "0"}], 
       RowBox[{"k", "-", "i"}]], " ", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["g", 
          RowBox[{"(", "i", ")"}]]},
        "Bra"], 
       SuperscriptBox["A", 
        RowBox[{"(", 
         RowBox[{"k", "-", "i", "-", "j"}], ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "j", ")"}]]},
        "Ket"]}]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8353506937114277`*^9, 3.835350723910287*^9}, {
