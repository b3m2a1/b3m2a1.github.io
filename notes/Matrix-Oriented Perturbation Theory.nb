Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{"A", "\[CircleDot]", "B"}], ")"}], 
    RowBox[{"T", "(", 
     RowBox[{"{", 
      SubscriptBox["k", "l"], "}"}], ")"}]], "=", 
   RowBox[{
    SubscriptBox["B", 
