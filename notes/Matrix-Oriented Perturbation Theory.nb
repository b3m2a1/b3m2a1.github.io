           RowBox[{"k", "-", "1"}]], " ", 
          RowBox[{"S", "(", 
           SuperscriptBox["H", 
            RowBox[{"(", 
             RowBox[{"k", "-", "i"}], ")"}]], ")"}]}], " ", ")"}], " ", "\\", 
        " ", 
        RowBox[{"{", "e", "}"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
