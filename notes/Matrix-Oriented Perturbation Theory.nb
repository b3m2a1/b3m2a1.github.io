  3.889894503142871*^9, 
  3.88989450424074*^9}},ExpressionUUID->"b5404d31-f2aa-4453-96cf-\
9b18b7213de8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SubsuperscriptBox["K", 
        SubscriptBox["b", "1"], 
        SubscriptBox["a", "1"]], "\[InvisibleSpace]", "(", "n", ")"}], 
      RowBox[{
       SubsuperscriptBox["K", 
        SubscriptBox["b", "2"], 
        SubscriptBox["a", "2"]], "\[InvisibleSpace]", "(", 
       RowBox[{"n", "+", 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["a", "1"], "-", 
          SubscriptBox["b", "2"]}], ")"}]}], ")"}]}], "..."}], 
    RowBox[{
     SubsuperscriptBox["K", 
      SubscriptBox["b", "N"], 
      SubscriptBox["a", "N"]], "\[InvisibleSpace]", "(", 
     RowBox[{"n", "+", "k", "-", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["a", "N"], "-", 
        SubscriptBox["b", "N"]}], ")"}]}], ")"}]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SubsuperscriptBox["P", 
        RowBox[{
         RowBox[{
          SubscriptBox["b", "1"], "\[InvisibleSpace]", 
          SubscriptBox["b", "2"]}], "..."}], 
        RowBox[{
         RowBox[{
          SubscriptBox["a", "1"], "\[InvisibleSpace]", 
          SubscriptBox["a", "2"]}], "..."}]], "(", "n", ")"}], "\[InvisibleSpace] ", 
      RowBox[{
       SubsuperscriptBox["S", 
        SubscriptBox["b", "1"], 
        SubscriptBox["a", "1"]], "\[InvisibleSpace]", "(", "n", ")"}], 
      RowBox[{
       SubsuperscriptBox["S", 
        SubscriptBox["b", "2"], 
        SubscriptBox["a", "2"]], "\[InvisibleSpace]", "(", 
       RowBox[{"n", "+", 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["a", "1"], "-", 
          SubscriptBox["b", "2"]}], ")"}]}], ")"}]}], "..."}], 
    RowBox[{
     SubsuperscriptBox["S", 
      SubscriptBox["b", "N"], 
      SubscriptBox["a", "N"]], "\[InvisibleSpace]", "(", 
     RowBox[{"n", "+", "k", "-", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["a", "N"], "-", 
        SubscriptBox["b", "N"]}], ")"}]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8898944380604353`*^9, 3.889894562492112*^9}, {
