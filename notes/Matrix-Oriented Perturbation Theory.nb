Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], "k"], 
    RowBox[{
     FractionBox[
      TemplateBox[{
        RowBox[{
          SuperscriptBox["m", 
           RowBox[{"(", "0", ")"}]], "\[ThinSpace]"}], 
        RowBox[{" ", 
          SuperscriptBox["m", 
           RowBox[{"(", 
             RowBox[{"k", "-", "i"}], ")"}]]}]},
       "BraKet"], 
      RowBox[{
       SubsuperscriptBox["E", "m", 
        RowBox[{"(", "0", ")"}]], "-", 
       SubsuperscriptBox["E", "n", 
        RowBox[{"(", "0", ")"}]]}]], " ", 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     SubsuperscriptBox["A", "n", 
      RowBox[{"(", "i", ")"}]], 
     TemplateBox[{
       SuperscriptBox["m", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}]}], " ", "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], "k"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"M", "=", "1"}], "i"], " ", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{
        StyleBox["p",
         FontSize->14], "\[Element]", 
        StyleBox[
         SubsuperscriptBox["\[CapitalXi]", "i", "M"],
         FontSize->14]}]], 
      RowBox[{"(", " ", 
       RowBox[{
        RowBox[{
         UnderscriptBox["\[Sum]", 
          RowBox[{
           StyleBox["r",
            FontSize->14], "\[Element]", 
           SuperscriptBox["\[ScriptCapitalP]", 
            RowBox[{"M", "-", "2"}]]}]], " ", 
         RowBox[{
          FractionBox[
           RowBox[{
            TemplateBox[{
              RowBox[{
                SuperscriptBox["m", 
                 RowBox[{"(", "0", ")"}]], "\[ThinSpace]"}], 
              RowBox[{" ", 
                SuperscriptBox["m", 
                 RowBox[{"(", 
                   RowBox[{"k", "-", "i"}], ")"}]]}]},
             "BraKet"], 
            TemplateBox[{
              RowBox[{
                SuperscriptBox["n", 
                 RowBox[{"(", "0", ")"}]], " "}], 
              RowBox[{"\[VeryThinSpace] ", 
                SuperscriptBox["n", 
                 RowBox[{"(", 
                   SubscriptBox["p", "M"], ")"}]]}]},
             "BraKet"]}], 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              SubsuperscriptBox["E", "m", 
               RowBox[{"(", "0", ")"}]], "-", 
              SubsuperscriptBox["E", "n", 
               RowBox[{"(", "0", ")"}]]}], ")"}], 
            RowBox[{
             RowBox[{"\[LeftBracketingBar]", "r", "\[RightBracketingBar]"}], 
             "+", "1"}]]], 
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]]},
           "Bra"], 
          SubsuperscriptBox["\[GothicCapitalO]", "n", 
           RowBox[{"(", "p", ")"}]]}]}], 
        SubsuperscriptBox["\[VerticalSeparator]", "0", 
         SubscriptBox["r", "1"]], 
        RowBox[{
         TemplateBox[{
           RowBox[{"\[VeryThinSpace]", 
             SuperscriptBox["m", 
              RowBox[{"(", "0", ")"}]]}]},
          "Ket"], 
         TemplateBox[{
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], 
         SubsuperscriptBox["\[GothicCapitalO]", "n", 
          RowBox[{"(", "p", ")"}]]}], 
        SubsuperscriptBox["\[VerticalSeparator]", 
         SubscriptBox["r", 
          StyleBox[
           RowBox[{"\[LeftBracketingBar]", "r", "\[RightBracketingBar]"}],
           FontSize->10]], "M"], 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"], 
         RowBox[{
          UnderoverscriptBox["\[Product]", 
           RowBox[{"j", "=", "2"}], 
           RowBox[{
            RowBox[{"\[LeftBracketingBar]", "r", "\[RightBracketingBar]"}], 
            "-", "1"}]], 
          RowBox[{
           TemplateBox[{
             SuperscriptBox["m", 
              RowBox[{"(", "0", ")"}]]},
            "Bra"], 
           SubsuperscriptBox["\[GothicCapitalO]", "n", 
            RowBox[{"(", "p", ")"}]]}]}]}], 
        SubsuperscriptBox["\[VerticalSeparator]", 
         SubscriptBox["r", "j"], 
         SubscriptBox["r", 
          RowBox[{"j", "+", "1"}]]], 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"], "\[LineSeparator]", "             ", "+", 
         RowBox[{
          UnderscriptBox["\[Sum]", 
           RowBox[{"q", "\[Element]", 
            SuperscriptBox["\[ScriptCapitalP]", 
             RowBox[{"M", "-", "1"}]]}]], 
          RowBox[{
           FractionBox[
            TemplateBox[{
              RowBox[{
                SuperscriptBox["m", 
                 RowBox[{"(", "0", ")"}]], "\[ThinSpace]"}], 
              RowBox[{" ", 
                SuperscriptBox["m", 
                 RowBox[{"(", 
                   RowBox[{"k", "-", "i"}], ")"}]]}]},
             "BraKet"], 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               SubsuperscriptBox["E", "m", 
                RowBox[{"(", "0", ")"}]], "-", 
               SubsuperscriptBox["E", "n", 
                RowBox[{"(", "0", ")"}]]}], ")"}], 
             RowBox[{
              RowBox[{"\[LeftBracketingBar]", "q", "\[RightBracketingBar]"}], 
              "+", "1"}]]], 
           TemplateBox[{
             SuperscriptBox["n", 
              RowBox[{"(", "0", ")"}]]},
            "Bra"], 
           SubsuperscriptBox["\[GothicCapitalO]", "n", 
            RowBox[{"(", "p", ")"}]]}]}]}], 
        SubsuperscriptBox["\[VerticalSeparator]", "0", 
         SubscriptBox["q", "1"]], 
        RowBox[{
         TemplateBox[{
           RowBox[{"\[VeryThinSpace]", 
             SuperscriptBox["m", 
              RowBox[{"(", "0", ")"}]]}]},
          "Ket"], 
         TemplateBox[{
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], 
         SubsuperscriptBox["\[GothicCapitalO]", "n", 
          RowBox[{"(", "p", ")"}]]}], 
        SubsuperscriptBox["\[VerticalSeparator]", 
         SubscriptBox["q", 
          StyleBox[
           RowBox[{"\[LeftBracketingBar]", "q", "\[RightBracketingBar]"}],
           FontSize->10]], "M"], 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"], 
         RowBox[{
          UnderoverscriptBox["\[Product]", 
           RowBox[{"j", "=", "2"}], 
           RowBox[{
            RowBox[{"\[LeftBracketingBar]", "q", "\[RightBracketingBar]"}], 
            "-", "1"}]], 
          RowBox[{
           TemplateBox[{
             SuperscriptBox["m", 
              RowBox[{"(", "0", ")"}]]},
            "Bra"], 
           SubsuperscriptBox["\[GothicCapitalO]", "n", 
            RowBox[{"(", "p", ")"}]]}]}]}], 
        SubsuperscriptBox["\[VerticalSeparator]", 
         SubscriptBox["q", "j"], 
         SubscriptBox["q", 
          RowBox[{"j", "+", "1"}]]], 
        TemplateBox[{
          SuperscriptBox["m", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], ")"}]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.828405326292385*^9, 3.828405357232705*^9}, {
