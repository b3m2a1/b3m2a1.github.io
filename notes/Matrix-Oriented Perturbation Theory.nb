c543134cb419"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["E", "n", 
     RowBox[{"(", "4", ")"}]], "-", 
    SubsuperscriptBox["E", "0", 
     RowBox[{"(", "4", ")"}]]}], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Epsilon]", "3", 
      RowBox[{"(", "4", ")"}]], 
     SubscriptBox["\[CircleDot]", "3"], 
     SuperscriptBox[
      RowBox[{"(", 
       StyleBox["n",
        FontWeight->"Bold"], ")"}], "3"]}], "+", 
    RowBox[{
     SubsuperscriptBox["\[Epsilon]", "2", 
      RowBox[{"(", "4", ")"}]], 
     SubscriptBox["\[CircleDot]", "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       StyleBox["n",
        FontWeight->"Bold"], ")"}], "2"]}], "+", 
    RowBox[{
     SubsuperscriptBox["\[Epsilon]", "1", 
      RowBox[{"(", "4", ")"}]], "\[CircleDot]", 
     StyleBox["n",
      FontWeight->"Bold"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8145392977767477`*^9, 3.8145395164507437`*^9}, {
  3.814539565495068*^9, 3.814539620319025*^9}, {3.814540102925145*^9, 
  3.8145401053162117`*^9}, {3.814540390237661*^9, 3.814540395019607*^9}, {
  3.814544276393297*^9, 
  3.814544316520212*^9}},ExpressionUUID->"53e9b6ef-3b94-4c6a-b5bf-\
366adb7bdeab"],

Cell["\<\
the goal will be to iteratively solve this for successive levels of \
approximation. \
\>", "ExpositoryText",
 CellChangeTimes->{{3.814544484225356*^9, 
  3.8145445128435497`*^9}},ExpressionUUID->"3c005a6c-0938-4855-8794-\
71cca7407650"],

Cell["To do this, we can look at a single excitation, i.e.", "ExpositoryText",
 CellChangeTimes->{{3.814544484225356*^9, 
  3.814544532443746*^9}},ExpressionUUID->"4631ff2b-d5df-47c0-b83d-\
970bb96da933"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["n", "i"], "=", 
   RowBox[{
    SubscriptBox["n", "k"], "\[InvisibleSpace]", 
    SubscriptBox["\[Delta]", 
     RowBox[{"i", "\[InvisibleSpace]", "k"}]]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.814543586521738*^9, 3.814543614932396*^9}, {
  3.814544799211396*^9, 
  3.81454481780015*^9}},ExpressionUUID->"641f2817-4e1e-4db7-828c-\
3480d5d3209d"],

Cell["In this case, ", "ExpositoryText",
 CellChangeTimes->{{3.814544541897533*^9, 
  3.814544543856496*^9}},ExpressionUUID->"f9accdb4-0333-448a-990d-\
c806cbb7c62b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["E", 
     SubscriptBox["n", "k"], 
     RowBox[{"(", "4", ")"}]], "-", 
    SubsuperscriptBox["E", "0", 
     RowBox[{"(", "4", ")"}]]}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[Epsilon]", "3", 
        RowBox[{"(", "4", ")"}]], ")"}], 
      RowBox[{"k", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "k"}]], 
     SuperscriptBox[
      SubscriptBox["n", "k"], "3"]}], "+", 
    RowBox[{
     SubscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[Epsilon]", "2", 
        RowBox[{"(", "4", ")"}]], ")"}], 
      RowBox[{"k", "\[InvisibleSpace]", "k"}]], 
     SuperscriptBox[
      SubscriptBox["n", "k"], "2"]}], "+", 
    RowBox[{
     SubscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[Epsilon]", "1", 
        RowBox[{"(", "4", ")"}]], ")"}], "k"], 
     SubscriptBox["n", "k"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.8145392977767477`*^9, 3.8145395164507437`*^9}, {
  3.814539565495068*^9, 3.814539620319025*^9}, {3.814540102925145*^9, 
  3.8145401053162117`*^9}, {3.814540390237661*^9, 3.814540395019607*^9}, {
  3.814544276393297*^9, 3.814544316520212*^9}, {3.81454455381712*^9, 
  3.814544598763447*^9}, {3.814544677685597*^9, 3.814544681844369*^9}, {
  3.814544793823398*^9, 
  3.814544794116481*^9}},ExpressionUUID->"59ac6241-e9b9-4320-a2e3-\
57a02539b7b7"],

Cell[TextData[{
 "seems tough to solve for! But by using enough values of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "k"], TraditionalForm]],ExpressionUUID->
  "f0f86d2a-a34e-417b-8bb1-817f062adcdb"],
 " we can get all of these components, first we\[CloseCurlyQuote]ll have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["n", "k"], "=", "1"}], ",", " ", "2", ",", " ", "3"}], 
   TraditionalForm]],ExpressionUUID->"034c68f3-119b-492b-a4ee-99ee79dbc7a9"]
}], "ExpositoryText",
 CellChangeTimes->{{3.81454468372867*^9, 3.814544781614832*^9}, {
  3.814544849239667*^9, 3.8145448508661633`*^9}, {3.814551885401504*^9, 
  3.814551885834915*^9}},ExpressionUUID->"a84c1231-8dc3-40f9-9017-\
5b7b71504222"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["E", 
        RowBox[{
         SubscriptBox["n", "k"], "=", "1"}], 
        RowBox[{"(", "4", ")"}]], "-", 
       SubsuperscriptBox["E", "0", 
        RowBox[{"(", "4", ")"}]]}], "=", 
      RowBox[{
       RowBox[{
        SubscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox["\[Epsilon]", "3", 
           RowBox[{"(", "4", ")"}]], ")"}], 
         RowBox[{"k", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "k"}]], 
        SuperscriptBox["1", "3"]}], "+", 
       RowBox[{
        SubscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox["\[Epsilon]", "2", 
           RowBox[{"(", "4", ")"}]], ")"}], 
         RowBox[{"k", "\[InvisibleSpace]", "k"}]], 
        SuperscriptBox["1", "2"]}], "+", 
       RowBox[{
        SubscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox["\[Epsilon]", "1", 
           RowBox[{"(", "4", ")"}]], ")"}], "k"], "1"}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["E", 
        RowBox[{
         SubscriptBox["n", "k"], "=", "2"}], 
        RowBox[{"(", "4", ")"}]], "-", 
       SubsuperscriptBox["E", "0", 
        RowBox[{"(", "4", ")"}]]}], "=", 
      RowBox[{
       RowBox[{
        SubscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox["\[Epsilon]", "3", 
           RowBox[{"(", "4", ")"}]], ")"}], 
         RowBox[{"k", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "k"}]], 
        SuperscriptBox["2", "3"]}], "+", 
       RowBox[{
        SubscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox["\[Epsilon]", "2", 
           RowBox[{"(", "4", ")"}]], ")"}], 
         RowBox[{"k", "\[InvisibleSpace]", "k"}]], 
        SuperscriptBox["2", "2"]}], "+", 
       RowBox[{
        SubscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox["\[Epsilon]", "1", 
           RowBox[{"(", "4", ")"}]], ")"}], "k"], "2"}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["E", 
        RowBox[{
         SubscriptBox["n", "k"], "=", "3"}], 
        RowBox[{"(", "4", ")"}]], "-", 
       SubsuperscriptBox["E", "0", 
        RowBox[{"(", "4", ")"}]]}], "=", 
      RowBox[{
       RowBox[{
        SubscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox["\[Epsilon]", "3", 
           RowBox[{"(", "4", ")"}]], ")"}], 
         RowBox[{"k", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "k"}]], 
        SuperscriptBox["3", "3"]}], "+", 
       RowBox[{
        SubscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox["\[Epsilon]", "2", 
           RowBox[{"(", "4", ")"}]], ")"}], 
         RowBox[{"k", "\[InvisibleSpace]", "k"}]], 
        SuperscriptBox["3", "2"]}], "+", 
       RowBox[{
        SubscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox["\[Epsilon]", "1", 
           RowBox[{"(", "4", ")"}]], ")"}], "k"], "3"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8145392977767477`*^9, 3.8145395164507437`*^9}, {
  3.814539565495068*^9, 3.814539620319025*^9}, {3.814540102925145*^9, 
  3.8145401053162117`*^9}, {3.814540390237661*^9, 3.814540395019607*^9}, {
  3.814544276393297*^9, 3.814544316520212*^9}, {3.81454455381712*^9, 
  3.814544598763447*^9}, {3.814544677685597*^9, 3.814544681844369*^9}, {
  3.8145448344555063`*^9, 3.814544882988674*^9}, {3.814544933621212*^9, 
  3.814544966375144*^9}},ExpressionUUID->"0246abbc-7a41-4e6d-994e-\
c96bee274072"],

Cell["and clearly this is a linear system, so we have", "ExpositoryText",
 CellChangeTimes->{{3.8145449699492292`*^9, 
  3.814544980901024*^9}},ExpressionUUID->"7bcb2e6b-289d-4825-bf5c-\
b27611b0ccef"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"(", GridBox[{
      {
       SubscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["\[Epsilon]", "3", 
          RowBox[{"(", "4", ")"}]], ")"}], 
        RowBox[{"k", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "k"}]]},
      {
       SubscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["\[Epsilon]", "2", 
          RowBox[{"(", "4", ")"}]], ")"}], 
        RowBox[{"k", "\[InvisibleSpace]", "k"}]]},
      {
       SubscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["\[Epsilon]", "1", 
          RowBox[{"(", "4", ")"}]], ")"}], 
        RowBox[{"k", "\[InvisibleSpace]"}]]}
     }], ")"}], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", GridBox[{
        {
         SuperscriptBox["1", "3"], 
         SuperscriptBox["1", "2"], "1"},
        {
         SuperscriptBox["2", "3"], 
         SuperscriptBox["1", "2"], "2"},
        {
         SuperscriptBox["3", "3"], 
         SuperscriptBox["3", "2"], "3"}
       }], ")"}], 
     RowBox[{"-", "1"}]], 
    RowBox[{"(", GridBox[{
       {
