          RowBox[{"k", "-", "i"}], ")"}]], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", "i", ")"}]]}]},
         "BraKet"]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], 
         RowBox[{"k", "-", "1"}]], 
