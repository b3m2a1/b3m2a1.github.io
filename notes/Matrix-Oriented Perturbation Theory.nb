Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{"A", "\[CircleDot]", "B"}], ")"}], 
    RowBox[{"T", "(", 
     RowBox[{"{", 
