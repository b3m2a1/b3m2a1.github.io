Cell[CellGroupData[{

Cell["Non-Degenerate Case", "Subsubsection",
 CellChangeTimes->{{3.821648815806913*^9, 
  3.8216488185783243`*^9}},ExpressionUUID->"b04a0430-66e1-4086-976b-\
96ad055360a1"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox[
       SubscriptBox["E", "n"], 
       RowBox[{"(", "k", ")"}]], "=", 
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], 
        SuperscriptBox["H", 
         RowBox[{"(", "k", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], ":", "T"}]},
         "Bra"], " ", 
        RowBox[{
         UnderoverscriptBox["\[CapitalDelta]E", 
          StyleBox["1",
           FontSize->14], 
          StyleBox["1",
           FontSize->14]], "(", "k", ")"}], 
        TemplateBox[{
          RowBox[{"T", ":", 
            RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}]}]},
         "Ket"]}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", 
        SubscriptBox["T", "n"]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       RowBox[{"[", 
        RowBox[{
         SubscriptBox["T", "n"], ":", 
         SubsuperscriptBox["\[CapitalPi]", 
          RowBox[{"\[VeryThinSpace]", "n", "\[VeryThinSpace]"}], 
          RowBox[{"(", "0", ")"}]], ":", 
         SubscriptBox["T", "n"]}], "]"}], 
       TemplateBox[{
         RowBox[{"T", ":", "\[VeryThinSpace]", 
           RowBox[{
             UnderoverscriptBox[
              RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}], 
              StyleBox["0", FontSize -> 14], 
              StyleBox["1", FontSize -> 12]], 
             RowBox[{"(", "k", ")"}]}]}]},
        "Ket"]}]}]},
    {
     RowBox[{
      TemplateBox[{
        RowBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]], " "}], 
        RowBox[{"\[VeryThinSpace] ", 
          SuperscriptBox["n", 
           RowBox[{"(", "k", ")"}]]}]},
       "BraKet"], "=", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], 
         RowBox[{"k", "-", "1"}]], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "i", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", 
               RowBox[{"k", "-", "i"}], ")"}]]}]},
         "BraKet"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821575110564403*^9, 3.821575149067493*^9}, {
   3.8215755056382513`*^9, 3.8215755650522747`*^9}, 3.821575703930519*^9, {
   3.821576102521146*^9, 3.82157611003946*^9}, {3.8215763264414577`*^9, 
   3.821576365120534*^9}, {3.82157685280335*^9, 3.821576947745014*^9}, {
   3.8215770281239367`*^9, 3.8215770340418386`*^9}, {3.82157708569702*^9, 
