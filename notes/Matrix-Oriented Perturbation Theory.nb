        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], "k"], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"i", "=", "0"}], 
          RowBox[{"k", "-", "i"}]], " ", 
         RowBox[{
          TemplateBox[{
            SuperscriptBox["g", 
             RowBox[{"(", "i", ")"}]]},
           "Bra"], 
          SuperscriptBox["A", 
           RowBox[{"(", 
            RowBox[{"k", "-", "i", "-", "j"}], ")"}]], 
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "j", ")"}]]},
           "Ket"]}]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "0"}], "N"], "\[VeryThinSpace]", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], "k"], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"i", "=", "0"}], 
            RowBox[{"k", "-", "j"}]], " ", 
           RowBox[{
            TemplateBox[{
              SuperscriptBox["g", 
               RowBox[{"(", "i", ")"}]]},
             "Bra"], 
            SuperscriptBox["A", 
             RowBox[{"(", 
              RowBox[{"k", "-", "i", "-", "j"}], ")"}]]}]}], ")"}], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "j", ")"}]]},
          "Ket"]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8353506937114277`*^9, 3.835350723910287*^9}, {
  3.835350786111107*^9, 3.83535080499762*^9}, {3.835350845117962*^9, 
  3.835350849597204*^9}, {3.835350915473649*^9, 3.835350957733308*^9}, {
  3.835350999096417*^9, 3.835351019300487*^9}, {3.835352111567724*^9, 
  3.8353521127456837`*^9}, {3.835352232935287*^9, 3.835352234012794*^9}, {
  3.835352290572466*^9, 3.835352321379148*^9}, {3.835352620483501*^9, 
  3.835352623750291*^9}, {3.835353063746922*^9, 
  3.835353064337428*^9}},ExpressionUUID->"c4ca5d6f-2f2b-4f9b-9f54-\
f4bf545dca0e"],

Cell[TextData[{
 "then if the expansion of ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "92038e04-260e-497e-aced-5400f6086503"],
 " supports selection rules as well this provides a secondary filter which is \
especially useful if the number of initial states in ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],ExpressionUUID->
  "d13a51f1-cb35-405a-98b4-9d2c55fb0930"],
 " is less than the number of final states requested"
}], "ExpositoryText",
 CellChangeTimes->{{3.8353523024524*^9, 3.835352304757656*^9}, {
  3.835352461849812*^9, 3.835352462093645*^9}, {3.835352617879084*^9, 
  3.835352652246683*^9}, {3.8353528527466173`*^9, 3.835352856908388*^9}, {
  3.835352993545855*^9, 3.8353530230561533`*^9}, {3.835353104201498*^9, 
  3.835353150209714*^9}},ExpressionUUID->"78b9b162-fd9d-4832-a7be-\
c0a6432725ad"],

Cell["\<\
We need to also make sure that the energies can be calculated correctly, i.e. \
that we have the necessary terms for \
\>", "ExpositoryText",
 CellChangeTimes->{{3.835353790833403*^9, 
  3.8353538248190536`*^9}},ExpressionUUID->"66b53427-cd3e-430c-a65a-\
9e8b987b56e9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["E", "n", 
    RowBox[{"(", "k", ")"}]], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], " ", 
     SuperscriptBox["H", 
      RowBox[{"(", "k", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], "+", " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], 
      RowBox[{"k", "-", "1"}]], 
     RowBox[{
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]]},
       "Bra"], " ", 
      SuperscriptBox["H", 
       RowBox[{"(", 
        RowBox[{"k", "-", "i"}], ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}], "-", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["E", "n"], 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]], 
     TemplateBox[{
       RowBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]], " "}], 
       RowBox[{"\[VeryThinSpace] ", 
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]]}]},
      "BraKet"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.835353932421625*^9, 3.835353932980205*^9}, {
  3.83535607185255*^9, 
  3.835356074048697*^9}},ExpressionUUID->"ae372c64-e87f-48b6-973c-\
8f5b62fc2777"],

Cell["\<\
but that reduces to just having the terms necessary to evaluate\
\>", "ExpositoryText",
 CellChangeTimes->{{3.835353934483568*^9, 
  3.83535397360539*^9}},ExpressionUUID->"6b5b0584-1313-4541-baec-\
3541ad1ec86e"],

Cell[BoxData[
 FormBox[
  RowBox[{" ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], 
     RowBox[{"k", "-", "1"}]], 
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], " ", 
     SuperscriptBox["H", 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "i", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.83535397496841*^9, 
  3.8353539755108833`*^9}},ExpressionUUID->"9cb9dc0c-2272-4f4e-8b6a-\
2c62fbba92a3"],

Cell[TextData[{
 "where the terms connected to ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Bra"], " ", 
   SuperscriptBox["H", 
    RowBox[{"(", 
     RowBox[{"k", "-", "i"}], ")"}]]}]],
  CellChangeTimes->{{3.83535397496841*^9, 3.8353539755108833`*^9}},
  ExpressionUUID->"d9740211-ac00-4ab0-9ae4-ab14685d5eb0"],
 " are in fact just a subset of the terms required to evaluate ",
 Cell[BoxData[
  TemplateBox[{
    SuperscriptBox["n", 
     RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]]},
   "Bra"]],
  CellChangeTimes->{{3.83535397496841*^9, 3.8353539755108833`*^9}},
  ExpressionUUID->"13f070f2-be80-413b-abb8-c374b80fe1d9"]
}], "ExpositoryText",
 CellChangeTimes->{{3.835353976767209*^9, 3.835353977848001*^9}, {
  3.8353540088039303`*^9, 3.835354105340447*^9}, {3.835354836867742*^9, 
  3.835354842142091*^9}, {3.8353548912159643`*^9, 3.835354897469741*^9}, {
  3.835355107871768*^9, 
  3.835355112941763*^9}},ExpressionUUID->"2817e262-450e-4a88-8323-\
0447156d4b5d"],

Cell[TextData[{
 "Therefore the entire state space that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "j", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "a6858bfa-f9c4-44d8-99ea-433d86895615"],
 " could to connect to for non-zero elements (which can include states ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "j", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "4b8e63d2-9a2d-475d-ae47-8b2305bb8c68"],
 " doesn\[CloseCurlyQuote]t connect to) can be given by"
}], "ExpositoryText",
 CellChangeTimes->{{3.83535512642257*^9, 3.835355140834875*^9}, {
  3.8353551890906363`*^9, 3.8353552249086447`*^9}, {3.835355271902999*^9, 
  3.8353553268371143`*^9}, {3.835356157620713*^9, 3.8353561778633633`*^9}, {
  3.835356347605587*^9, 3.835356351453289*^9}, {3.836738979550302*^9, 
  3.836738996849119*^9}},ExpressionUUID->"64a7e1a9-d810-4ce2-9999-\
c90a68955ec7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[CurlyPhi]", "(", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "j", ")"}]]},
     "Ket"], ")"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Union]", 
      RowBox[{"k", "=", "0"}], "N"], " ", 
     RowBox[{"\[CapitalPhi]", "(", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SuperscriptBox["H", 
        RowBox[{"(", 
         RowBox[{"k", "-", "j"}], ")"}]]}], ")"}]}], " ", "\[Union]", " ", 
    RowBox[{"(", " ", 
     RowBox[{
      UnderoverscriptBox["\[Union]", 
       RowBox[{"i", "=", "0"}], 
       RowBox[{"k", "-", "j"}]], " ", 
      RowBox[{"\[CapitalPhi]", "(", 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["g", 
           RowBox[{"(", "i", ")"}]]},
         "Bra"], 
        SuperscriptBox["A", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i", "-", "j"}], ")"}]]}], ")"}]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8353554306467037`*^9, 3.835355435704452*^9}, {
  3.835355723314541*^9, 3.835355741327293*^9}, {3.835355887929968*^9, 
  3.835355979206182*^9}, {3.8353561982244167`*^9, 3.8353562120228243`*^9}, {
  3.835356330878109*^9, 3.835356342523554*^9}, {3.835356429530217*^9, 
  3.835356457206007*^9}},ExpressionUUID->"994116fa-a2d7-4b47-aca8-\
d943e2c867d7"],

Cell["\<\
where \[CapitalPhi] is just the total connected space for that term, given by\
\
\>", "ExpositoryText",
 CellChangeTimes->{{3.835356441074073*^9, 3.8353564691167507`*^9}, {
  3.836739448280108*^9, 
  3.8367394497896767`*^9}},ExpressionUUID->"7197f983-0b00-49e3-8260-\
c647e4928768"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[CapitalPhi]", "(", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "j", ")"}]]},
     "Ket"], ")"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Union]", 
      RowBox[{"i", "=", "0"}], 
      RowBox[{"j", "-", "1"}]], " ", 
     RowBox[{"\[CapitalPhi]", "(", 
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", 
         RowBox[{"j", "-", "i"}], ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]]},
        "Ket"]}], ")"}]}], " ", "\[Union]", " ", 
    RowBox[{"{", 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"], "}"}]}]}], TraditionalForm]], "ExpositoryMathCentered",
