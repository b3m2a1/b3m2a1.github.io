Cell[BoxData[{
 RowBox[{"pathStepsWithPhases", "//", "Clear"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pathStepsWithPhases", "[", 
    RowBox[{"target_", ",", " ", "seq_", ",", " ", 
     RowBox[{"p_", ":", "p"}], ",", " ", 
     RowBox[{"q_", ":", "q"}]}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Block", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"phaseElems", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"#", "===", "p"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", 
              RowBox[{"-", "1"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}], "&"}], "/@", 
         "seq"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"pathElems", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"Length", "[", "seq", "]"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", "sel", ",", "\[IndentingNewLine]", "phases", 
       ",", "\[IndentingNewLine]", "perms", ",", "\[IndentingNewLine]", 
       "states", ",", "\[IndentingNewLine]", "paths"}], "\[IndentingNewLine]",
       "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"perms", " ", "=", 
       RowBox[{"Tuples", "[", "pathElems", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"phases", " ", "=", 
       RowBox[{"Tuples", "[", "phaseElems", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sel", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Total", "[", "#", "]"}], "\[Equal]", "target"}], "&"}], "/@",
         "perms"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"phases", "=", 
       RowBox[{"Pick", "[", 
        RowBox[{"phases", ",", "sel"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"perms", "=", 
       RowBox[{"Pick", "[", 
        RowBox[{"perms", ",", " ", "sel"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Times", "@@@", "phases"}], ",", " ", "perms"}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.8134309422288857`*^9, 3.8134309735535097`*^9}, {
