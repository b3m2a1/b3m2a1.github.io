  3.8894610320119667`*^9}},ExpressionUUID->"a6ae72c0-2033-4959-af78-\
fc370d17af15"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox[
       OverscriptBox["c", "~"], 
       RowBox[{"k", "\[InvisibleSpace]", "p"}], 
       RowBox[{"(", "b", ")"}]], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", 
         RowBox[{"b", "+", "p", "-", "1"}]}], 
        RowBox[{"2", "\[InvisibleSpace]", "b"}]], " ", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"j", "+", "p", "+", "1"}], ")"}]], 
        RowBox[{
         SubscriptBox["S", "2"], "(", 
         RowBox[{
          RowBox[{"j", "-", "p"}], ",", " ", "b"}], ")"}], 
        SubsuperscriptBox["c", 
         RowBox[{"k", "\[InvisibleSpace]\[VeryThinSpace]", "j"}], 
         RowBox[{"(", "b", ")"}]]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", "0"}], 
        RowBox[{"\[InvisibleSpace]", 
         RowBox[{"b", "+", "1", "-", "p"}]}]], " ", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"j", "+", "b", "+", "1"}], ")"}]], 
        RowBox[{
         SubscriptBox["S", "2"], "(", 
         RowBox[{
          RowBox[{"j", "+", "b", "-", "1"}], ",", " ", "b"}], ")"}], 
        SubsuperscriptBox["c", 
         RowBox[{
          RowBox[{"k", "\[InvisibleSpace]\[VeryThinSpace]", "j"}], "+", "b", 
          "+", "p", "-", "1"}], 
         RowBox[{"(", "b", ")"}]]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", "0"}], 
        RowBox[{"\[InvisibleSpace]", 
         RowBox[{"b", "+", "1", "-", "p"}]}]], " ", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"j", "+", "b", "+", "1"}], ")"}]], 
        RowBox[{
         SubscriptBox["S", "2"], "(", 
         RowBox[{
          RowBox[{"j", "+", "b", "-", "1"}], ",", " ", "b"}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"\[Omega]", "=", "0"}], 
           RowBox[{"b", "+", "2", "-", 
            RowBox[{"(", 
             RowBox[{"k", "+", "j", "+", "p"}], ")"}]}]], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SubsuperscriptBox["c", 
              RowBox[{
               RowBox[{"k", "\[InvisibleSpace] ", "\[Omega]"}], "+", "j", "+",
                "b", "+", "p", "-", "3"}], 
              RowBox[{"(", 
               RowBox[{"b", "-", "1"}], ")"}]], "-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"b", "-", "1"}], ")"}], 
              SubsuperscriptBox["c", 
               RowBox[{
                RowBox[{"k", "\[InvisibleSpace] ", "\[Omega]"}], "+", "j", 
                "+", "b", "+", "p", "-", "2"}], 
               RowBox[{"(", 
                RowBox[{"b", "-", "1"}], ")"}]]}], "+", 
             SubsuperscriptBox["c", 
              RowBox[{"k", "-", 
               RowBox[{"1", "\[InvisibleSpace]", "\[Omega]"}], "+", "j", "+", 
               "b", "+", "p", "-", "2"}], 
              RowBox[{"(", 
               RowBox[{"b", "-", "1"}], ")"}]]}], ")"}], " ", 
           RowBox[{"(", " ", 
            RowBox[{
             UnderoverscriptBox["\[Product]", 
              RowBox[{"x", "=", "1"}], 
              RowBox[{"j", "+", "b", "+", "p", "-", "2"}]], " ", 
             FractionBox[
              RowBox[{"\[Omega]", "+", "x"}], 
              RowBox[{"1", "+", "x"}]]}], ")"}], 
           SubsuperscriptBox["B", "\[Omega]", "+"]}]}], ")"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
