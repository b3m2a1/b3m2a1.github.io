Cell[BoxData[{
 RowBox[{
  RowBox[{"polyGenCoreCombFalling", "[", 
   RowBox[{"a_", ",", " ", "b_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"w", "!"}], 
      SuperscriptBox["2", "w"]], " ", 
     RowBox[{"Binomial", "[", 
      RowBox[{"b", ",", " ", "w"}], "]"}], 
     RowBox[{"Binomial", "[", 
      RowBox[{"a", ",", " ", "w"}], "]"}], 
     RowBox[{"Product", "[", 
      RowBox[{
       RowBox[{"\[FormalN]", "-", "j"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "0", ",", 
         RowBox[{"(", 
          RowBox[{"b", "-", "w", "-", "1"}], ")"}]}], "}"}]}], "]"}]}], ",", 
    " ", 
    RowBox[{"{", 
     RowBox[{"w", ",", " ", "0", ",", " ", "b"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"polyGenCoreComb", "[", 
   RowBox[{"a_", ",", " ", "b_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"b", "!"}], 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       SuperscriptBox["2", "w"]], " ", 
      RowBox[{"Binomial", "[", 
       RowBox[{"a", ",", " ", "w"}], "]"}], 
      RowBox[{"Binomial", "[", 
       RowBox[{"\[FormalN]", ",", " ", 
        RowBox[{"b", "-", "w"}]}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"w", ",", " ", "0", ",", " ", "b"}], "}"}]}], "]"}]}]}], "\n", 
 RowBox[{
  RowBox[{"polyGenComb", "[", 
   RowBox[{"a_", ",", " ", "b_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Binomial", "[", 
    RowBox[{
     RowBox[{"a", "+", "b"}], ",", " ", "b"}], "]"}], "*", 
   RowBox[{"polyGenCoreComb", "[", 
    RowBox[{"a", ",", " ", "b"}], "]"}]}]}]}], "Input",
