Cell[TextData[{
 "Why is this useful? Well we can write a reduced sequence as a product of a \
regular sequence and some ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalDelta]H", "\[Lambda]", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.888230951228767*^9, 3.888231075760157*^9}},
  ExpressionUUID->"6707c0a8-4283-42dd-b8d7-9ed2ea7f2a09"]
}], "ExpositoryText",
 CellChangeTimes->{{3.888231699651473*^9, 3.8882317631470833`*^9}, 
   3.888232211126844*^9},ExpressionUUID->"e0401675-9743-4d98-865a-\
b8343ae8b885"],

