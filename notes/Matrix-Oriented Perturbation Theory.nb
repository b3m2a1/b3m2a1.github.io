Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"a", "=", "1"}], "n"], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], 
         RowBox[{"n", "-", "2", "-", "a"}]], 
        RowBox[{
         TemplateBox[{
           RowBox[{"n", "+", "1", "+", "i"}]},
          "Bra"], 
         RowBox[{"\[CapitalDelta]", "(", 
          RowBox[{"n", "-", "a", "-", "i"}], ")"}], 
         TemplateBox[{"a"},
          "Ket"]}]}]}], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"b", "=", "0"}], 
        RowBox[{"n", "-", "2"}]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], "b"], 
        RowBox[{
         TemplateBox[{
           RowBox[{
             RowBox[{"2", "\[InvisibleSpace]", "n"}], "-", "1", "-", "b"}]},
          "Bra"], 
         RowBox[{"\[CapitalDelta]", "(", 
          RowBox[{"b", "+", "2", "-", "i"}], ")"}], 
         TemplateBox[{"i"},
          "Ket"]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"b", "=", "0"}], 
        RowBox[{"n", "-", "2"}]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "1"}], 
         RowBox[{"n", "-", "2", "-", "b"}]], 
        RowBox[{
         TemplateBox[{
           RowBox[{"\[InvisibleSpace]", 
             RowBox[{"n", "+", "1", "+", "b"}]}]},
          "Bra"], 
         RowBox[{"\[CapitalDelta]", "(", 
          RowBox[{"n", "-", "b", "-", "j"}], ")"}], 
         RowBox[{
          TemplateBox[{"j"},
           "Ket"], " ", "[", 
          RowBox[{"reversing", " ", "sum"}], "]"}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
