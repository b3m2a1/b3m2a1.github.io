  3.9205741465121727`*^9}},ExpressionUUID->"579bf2b3-dfa6-43d4-8984-\
4b3329a5318a"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      FractionBox[
       RowBox[{
        SubscriptBox["n", "2"], "+", 
        RowBox[{
         SubscriptBox["n", "1"], "\[InvisibleSpace]", 
         SubscriptBox["n", "2"]}], "+", 
        RowBox[{
         SubscriptBox["n", "2"], "\[InvisibleSpace]", 
