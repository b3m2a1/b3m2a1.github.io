Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", "*"]},
     "Bra"], "H", 
    TemplateBox[{
      SuperscriptBox["m", "*"]},
     "Ket"]}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"k", "=", "0"}], "N"], " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], "k"], " ", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"j", "=", "0"}], 
       RowBox[{"k", "-", "i"}]], " ", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox[
          SuperscriptBox["n", "*"], 
          RowBox[{"(", "i", ")"}]]},
        "Bra"], 
       SuperscriptBox["H", 
        RowBox[{"(", 
         RowBox[{"k", "-", "i", "-", "j"}], ")"}]], 
       TemplateBox[{
         SuperscriptBox[
          SuperscriptBox["m", "*"], 
          RowBox[{"(", "j", ")"}]]},
        "Ket"]}]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
