Cell["and for the 2D terms we have", "ExpositoryText",
 CellChangeTimes->{{3.920390475533361*^9, 3.920390479261108*^9}, {
  3.920391337207633*^9, 
  3.920391340885097*^9}},ExpressionUUID->"48b57131-dc76-43e8-9a01-\
34aabe6b7966"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SubscriptBox["n", "2"]},
     "Bra"], 
    TemplateBox[{
      SubscriptBox["n", "1"]},
     "Bra"], 
    SuperscriptBox[
     SubscriptBox["T", "2"], "2"], 
    SubscriptBox["T", "1"], "\[InvisibleSpace]", "\[CapitalPi]", 
    "\[InvisibleSpace]", 
    SubscriptBox["T", "1"], 
    SubsuperscriptBox["T", "2", "2"], 
    TemplateBox[{
      SubscriptBox["n", "1"]},
     "Ket"], 
    TemplateBox[{
      SubscriptBox["n", "2"]},
     "Ket"]}], " ", "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      SubscriptBox[
       RowBox[{"k", "\[VeryThinSpace]"}], "2"], "=", 
      RowBox[{"-", "2"}]}], "2"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       SubscriptBox["k", "1"], "=", 
       RowBox[{"-", "1"}]}], "1"], " ", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"\[InvisibleSpace]", 
        RowBox[{
         RowBox[{
          SubscriptBox["k", "1"], "\[InvisibleSpace]\[VeryThinSpace]", 
          SubscriptBox["\[Omega]", "1"]}], "+", 
         RowBox[{
          SubscriptBox[
           RowBox[{"k", "\[InvisibleSpace]\[VeryThinSpace]"}], "2"], 
          SubscriptBox["\[Omega]", "2"]}]}]}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox[
          SubscriptBox["Z", "2"], "a", "b"], "(", 
         RowBox[{
          SubscriptBox["n", "2"], "+", 
          SubscriptBox["k", "2"]}], ")"}], 
        RowBox[{
         SubsuperscriptBox[
          SubscriptBox["Z", "2"], "b", "a"], "(", 
         SubscriptBox["n", "2"], ")"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox[
          SubscriptBox["Z", "1"], "a", "b"], "(", 
         RowBox[{
          SubscriptBox["n", "1"], "+", 
          SubscriptBox["k", "1"]}], ")"}], 
        RowBox[{
         SubsuperscriptBox[
          SubscriptBox["Z", "1"], "b", "a"], "(", 
         SubscriptBox["n", "1"], ")"}]}], ")"}]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.92039044770303*^9, 3.920390496605506*^9}, {
  3.9203905338777647`*^9, 3.920390544617724*^9}, {3.9203910977238407`*^9, 
  3.920391227120277*^9}},ExpressionUUID->"f3dc265b-7e4e-4fc4-8fba-\
b07dc87fd00e"],

Cell[TextData[{
 "This seems more annoying since in principle ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "1"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "f1573792-41bd-4a6b-a3d7-a816ea9cb8eb"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "2"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "6480e481-0bce-444d-93e3-6c36ec18c7d4"],
 " don\[CloseCurlyQuote]t need to be the same on the left and right, except \
since we have a direct product of terms we can just add up the left/right \
contributions ahead of time, although we need to do this over the 2D polys \
generated by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "1"], 
    SubscriptBox["T", "2"]}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "aeff5bee-0b1d-4111-b1bc-31f65bf2b6a3"],
 "...except this is complicated by the asymmetry of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", "Q"], "G"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "3c1fe594-30d0-4935-9db5-bc157c1aa533"],
 "...so we need to add extra tags to track the symmetries"
}], "ExpositoryText",
 CellChangeTimes->{{3.920391872994402*^9, 3.9203918930464993`*^9}, {
  3.9203919531145*^9, 3.920391973076639*^9}, {3.920392278097816*^9, 
  3.920392315707896*^9}, {3.920392541521546*^9, 3.920392564094131*^9}, {
  3.920392869310648*^9, 3.920392894682481*^9}, {3.920392956451062*^9, 
  3.920392965014861*^9}},ExpressionUUID->"86dca09d-903c-4c06-b774-\
2211adfd25ed"],

