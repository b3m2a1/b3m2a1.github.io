               RowBox[{"(", "i", ")"}]]}]},
           "BraKet"], 
          TemplateBox[{
            SuperscriptBox["\[Eta]", 
             RowBox[{"(", "0", ")"}]]},
           "Ket"]}]}]}], "+", 
       RowBox[{
        SubsuperscriptBox["\[CapitalPi]", "V", 
         RowBox[{"(", "a", ")"}]], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"i", "=", "0"}], 
          RowBox[{"k", "-", "1"}]], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["\[CapitalDelta]J", 
             RowBox[{"(", 
              RowBox[{"a", ",", " ", 
               RowBox[{"k", "-", "i"}]}], ")"}]], " ", "+", " ", 
            SuperscriptBox["\[CapitalDelta]H", 
             RowBox[{"(", 
              RowBox[{"a", "+", "k", "-", "i"}], ")"}]]}], ")"}], 
          TemplateBox[{"i"},
           "Ket"]}]}]}], "+", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], 
         RowBox[{"k", "-", "1"}]], 
