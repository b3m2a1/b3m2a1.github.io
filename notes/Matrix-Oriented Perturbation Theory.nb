e725b8c7e4b2"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox["D", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "077706cb-ea52-45ca-a41a-4e6899d6db3d"],
 " is a \[OpenCurlyDoubleQuote]shift\[CloseCurlyDoubleQuote] matrix with ones \
on the first superdiagonal, and so we again have a transformation in terms of \
falling factorials, but in this case..."
}], "ExpositoryText",
 CellChangeTimes->{{3.8916900286390667`*^9, 
  3.891690107776635*^9}},ExpressionUUID->"ed3d78fb-d174-4538-9bd6-\
