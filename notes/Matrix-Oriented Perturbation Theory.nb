Cell["and so we get", "ExpositoryText",
 CellChangeTimes->{
  3.81128489750781*^9, {3.811284929575163*^9, 
   3.8112849446043158`*^9}},ExpressionUUID->"4fe8e533-dcd3-4464-b715-\
282699659949"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       FractionBox[
        SuperscriptBox["\[PartialD]", "2"], 
        RowBox[{
         RowBox[{"\[PartialD]", 
          SubscriptBox["q", "j"]}], 
         RowBox[{"\[PartialD]", 
          SubscriptBox["q", "i"]}]}]], 
       RowBox[{"\[LeftBracketingBar]", 
        SubscriptBox["I", "0"], "\[RightBracketingBar]"}]}], "=", 
      RowBox[{
       UnderscriptBox["\[Sum]", "k"], 
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", 
          SubscriptBox["q", "j"]}]], 
        SubscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Adj", "(", 
            SubscriptBox["I", "0"], ")"}], 
           FractionBox[
            RowBox[{"\[PartialD]", 
             SubscriptBox["I", "0"]}], 
            RowBox[{"\[PartialD]", 
             SubscriptBox["q", "i"]}]]}], ")"}], 
         RowBox[{"k", "\[InvisibleSpace]", "k"}]]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderscriptBox["\[Sum]", "k"], 
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", 
          SubscriptBox["q", "j"]}]], 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox[
           RowBox[{"Adj", "(", 
            SubscriptBox["I", "0"], ")"}], "k"], 
          FractionBox[
           RowBox[{"\[PartialD]", 
            SubscriptBox[
             RowBox[{"(", 
              SubscriptBox["I", "0"], ")"}], 
             RowBox[{":", "k"}]]}], 
           RowBox[{"\[PartialD]", 
            SubscriptBox["q", "i"]}]]}], ")"}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        UnderscriptBox["\[Sum]", "k"], 
        RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", "\[VeryThinSpace]", 
           SubscriptBox[
            RowBox[{"Adj", "(", 
             SubscriptBox["I", "0"], ")"}], "k"]}], 
          RowBox[{"\[PartialD]", 
           SubscriptBox["q", "j"]}]], 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubscriptBox[
            RowBox[{"(", 
             SubscriptBox["I", "0"], ")"}], 
            RowBox[{":", "k"}]]}], 
          RowBox[{"\[PartialD]", 
           SubscriptBox["q", "i"]}]]}]}], "+", 
       RowBox[{
        SubscriptBox[
         RowBox[{"Adj", "(", 
          SuperscriptBox["I", "0"], ")"}], "k"], 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[PartialD]", "2"], 
          SubscriptBox[
           RowBox[{"(", 
            SubscriptBox["I", "0"], ")"}], 
           RowBox[{":", "k"}]]}], 
         RowBox[{
          RowBox[{"\[PartialD]", 
           SubscriptBox["q", "i"]}], 
          RowBox[{"\[PartialD]", 
           SubscriptBox["q", "j"]}]}]]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        SubscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[Del]", "Q"], 
           SubscriptBox["I", "0"]}], ")"}], "i"], 
        SubscriptBox["\[CircleDot]", "2"], 
        SubscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[Del]", "Q"], 
           RowBox[{"Adj", "(", 
            SubscriptBox["I", "0"], ")"}]}], ")"}], "j"]}], "+", 
       RowBox[{
        RowBox[{"Adj", "(", 
         SuperscriptBox["I", "0"], ")"}], 
        SubscriptBox["\[CircleDot]", "2"], 
        SubscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[Del]", 
            SuperscriptBox["Q", "2"]], 
           SubscriptBox["I", "0"]}], ")"}], 
         RowBox[{"i", "\[VeryThinSpace]", "j"}]]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811267980105794*^9, 3.811268043099012*^9}, {
   3.8112841666923103`*^9, 3.811284175449643*^9}, {3.8112849592319593`*^9, 
