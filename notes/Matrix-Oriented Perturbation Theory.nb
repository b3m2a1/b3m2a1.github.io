            {
             RowBox[{"b", "-", "1"}]}
           },
           GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
         RowBox[{"(", 
          RowBox[{"n", "+", "i", "-", 
           RowBox[{"(", 
            RowBox[{"b", "-", "1"}], ")"}]}], ")"}], 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"k", "=", "0"}], 
           RowBox[{"b", "-", "1"}]], "\[VeryThinSpace] ", 
          RowBox[{
           RowBox[{
            SubsuperscriptBox["Q", "k", 
             RowBox[{"(", 
              RowBox[{"b", "-", "1"}], ")"}]], "(", "i", ")"}], 
           "\[InvisibleSpace]", 
           SuperscriptBox["n", "k"]}]}]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        FractionBox["1", 
