 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "D"], TraditionalForm]],ExpressionUUID->
  "ecbb43bc-83b4-40a3-8ee8-d25e4241dfde"],
 " in turn, giving us two equations"
}], "ExpositoryText",
