           RowBox[{"(", "i", ")"}]]}], ")"}], 
        SubscriptBox["P", "D"], 
        TemplateBox[{"n"},
         "Ket"]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}]], 
        RowBox[{
         SubscriptBox["P", "D"], 
