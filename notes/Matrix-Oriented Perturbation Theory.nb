 RowBox[{
  RowBox[{"parityHalved", "[", "n_", "]"}], ":=", 
  RowBox[{
   FractionBox["1", "4"], " ", 
   RowBox[{"(", 
    RowBox[{"3", "-", 
     SuperscriptBox[
