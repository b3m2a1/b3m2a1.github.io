       RowBox[{"A", "'"}], " ", "with", " ", 
       RowBox[{"dim", "(", 
        RowBox[{"A", "'"}], ")"}]}]}]}], "=", 
    RowBox[{"n", "-", "1"}]}], ",", " ", 
   RowBox[{
    RowBox[{"dim", "(", 
