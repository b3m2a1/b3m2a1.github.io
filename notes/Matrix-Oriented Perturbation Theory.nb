   3.793209912366707*^9},ExpressionUUID->"81af4976-1e23-4d71-a3a2-\
f2f70b06d7a3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{"A", "\[CircleDot]", "B"}], ")"}], 
    RowBox[{"T", "(", 
     RowBox[{"{", 
      SubscriptBox["k", "l"], "}"}], ")"}]], "=", 
   RowBox[{
    SubscriptBox["A", 
     RowBox[{"T", "(", 
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["k", "l"], "\[VerticalSeparator]", "\[VeryThinSpace]", 
        RowBox[{"l", "\[LessEqual]", "N"}]}], "}"}], ")"}]], "\[CircleDot]", 
    SubscriptBox["B", 
     RowBox[{"T", "(", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         SubscriptBox["k", "l"], "-", "N"}], "\[VerticalSeparator]", 
        "\[VeryThinSpace]", 
        RowBox[{"l", ">", "N"}]}], "}"}], ")"}]]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.792893314380785*^9, 3.79289332957778*^9}, 
   3.793207662274925*^9, {3.7932081215246277`*^9, 3.793208127755539*^9}, {
