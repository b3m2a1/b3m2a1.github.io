Cell[TextData[{
 "and again to get the true correction in the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "n"], TraditionalForm]],ExpressionUUID->
  "5e8d0ac1-971c-4017-965f-60a9d6492715"],
 " subspace we apply the perturbation operator to this (and add on the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "c94c89b6-80e0-4667-ad52-7ff9c8e79c74"],
 " component by doing the not-shown overlaps)"
}], "ExpositoryText",
 CellChangeTimes->{{3.8216457082525053`*^9, 3.82164572408018*^9}, {
  3.821729486234371*^9, 
  3.821729506266058*^9}},ExpressionUUID->"bc70d22e-5ca6-4476-93be-\
d904d8f4b64c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"$ptData", "[", 
    RowBox[{"[", 
     RowBox[{"\"\<n\>\"", ",", " ", "3"}], "]"}], "]"}], "=", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Dot", "[", 
