     RowBox[{
      TemplateBox[{
        SuperscriptBox["m", 
         RowBox[{"(", "0", ")"}]]},
       "Bra"], 
      SuperscriptBox["H", 
       RowBox[{"(", 
        RowBox[{"k", "-", "i"}], ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821192173865511*^9, 3.8211922240257196`*^9}, {
  3.821192496099118*^9, 3.8211925355056543`*^9}, {3.82119261186228*^9, 
  3.821192621528081*^9}},ExpressionUUID->"45b36687-9292-4888-8fc9-\
88ec2b8b7d3a"],

Cell[TextData[{
 "...which will break down if ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["E", "m"], 
      RowBox[{"(", "0", ")"}]], "-", 
     SuperscriptBox[
      SubscriptBox["E", "n"], 
      RowBox[{"(", "0", ")"}]]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.821192173865511*^9, 3.8211922240257196`*^9}, {
   3.821192496099118*^9, 3.8211925355056543`*^9}, {3.82119261186228*^9, 
   3.821192621528081*^9}},ExpressionUUID->
  "e2fb925b-b3ce-423e-9166-d8f1578004ce"],
 " are truly exactly degenerate... OTOH might be good enough if they\
\[CloseCurlyQuote]re only ",
 StyleBox["nearly ",
  FontSlant->"Italic"],
 "degenerate?"
}], "ExpositoryText",
 CellChangeTimes->{{3.821192592392207*^9, 
  3.821192672946974*^9}},ExpressionUUID->"3c3c1c45-a7ad-41ff-9bd7-\
f94fe9f9d778"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Post-PT Diagonalization Approach", "Subsubsection",
 CellChangeTimes->{{3.821192713158746*^9, 3.821192717902399*^9}, {
  3.8211928300995502`*^9, 3.821192833546732*^9}, {3.821321839912479*^9, 
  3.8213218467468863`*^9}},ExpressionUUID->"3764cec5-08d4-4ddd-a30b-\
2d13fe652c10"],

Cell[TextData[{
 "To do so, we apply non-degenerate perturbation theory to each state in ",
 Cell[BoxData[
  FormBox["D", TraditionalForm]],ExpressionUUID->
  "71a4e394-937c-4090-996a-550bdf568f6f"],
 ", giving us a set of corrections ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    TemplateBox[{
      SubsuperscriptBox["d", "i", 
       RowBox[{"\[VeryThinSpace]", 
         RowBox[{"(", "k", ")"}]}]]},
     "Ket"], "}"}], TraditionalForm]],ExpressionUUID->
  "3bbf38ed-5081-4f70-a63a-4898f15e090f"],
 ", which we then use to transform the entirety of ",
 Cell[BoxData[
  FormBox["H", TraditionalForm]],ExpressionUUID->
  "8b39d001-d87f-4872-a4da-03d9cea56e99"],
 " into the non-degenerate subspace for ",
 StyleBox["D",
  FontSlant->"Italic"],
 ", through"
}], "ExpositoryText",
 CellChangeTimes->{{3.8211112615830517`*^9, 3.821111265662032*^9}, {
  3.821111460137713*^9, 3.821111498768036*^9}, {3.8211115920805483`*^9, 
  3.821111603213883*^9}, {3.821111688363062*^9, 3.821111713615093*^9}, {
  3.821112668785495*^9, 3.8211127068867903`*^9}, {3.821112869284216*^9, 
  3.8211128730536737`*^9}},ExpressionUUID->"f17aa3c4-76ec-4532-9a1f-\
5726556dbcf8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     SuperscriptBox["H", "ndeg"], ")"}], 
    RowBox[{"i", "\[InvisibleSpace]", "j"}]], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", "k"], " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"\[Alpha]", "=", "0"}], "k"], " ", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"\[Beta]", "=", "0"}], 
       RowBox[{"k", "-", "\[Alpha]"}]], " ", 
      RowBox[{
       TemplateBox[{
         SubsuperscriptBox["d", "i", 
          RowBox[{"\[VeryThinSpace]", 
            RowBox[{"(", "\[Alpha]", ")"}]}]]},
        "Bra"], 
       SuperscriptBox["A", 
        RowBox[{"(", 
         RowBox[{"k", "-", "\[Alpha]", "-", "\[Beta]"}], ")"}]], 
       TemplateBox[{
         SubsuperscriptBox[
          RowBox[{"d", "\[VeryThinSpace]"}], "j", 
          RowBox[{"(", "\[Beta]", ")"}]]},
        "Ket"]}]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821111500535721*^9, 3.8211115005400543`*^9}, {
  3.821111546699994*^9, 3.821111548369577*^9}, {3.821112563523678*^9, 
  3.821112575618532*^9}, {3.8211127219439697`*^9, 3.821112737648514*^9}, {
  3.821112790618227*^9, 3.821112801071925*^9}, {3.821112852784936*^9, 
  3.821112890906816*^9}, {3.821112929956918*^9, 
  3.821112943516354*^9}},ExpressionUUID->"b321a1c1-91ef-432b-8634-\
d829bf0939f8"],

Cell["\<\
this can then be diagonalized to give us a new set of degenerate energies and \
a transformation to apply to the non-degenerate corrections, i.e. we have\
\>", "ExpositoryText",
 CellChangeTimes->{{3.821111216982513*^9, 3.821111216987217*^9}, {
  3.821112917978764*^9, 
  3.821112992348755*^9}},ExpressionUUID->"e28a927c-2323-420e-b507-\
5529a094bab0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["E", "deg"], "=", 
   RowBox[{
    SuperscriptBox["Q", "deg"], 
    SuperscriptBox[
     RowBox[{
      SuperscriptBox["H", "ndeg"], "(", 
      SuperscriptBox["Q", "deg"], ")"}], 
     RowBox[{"-", "1"}]]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821112967781232*^9, 
  3.821113031461014*^9}},ExpressionUUID->"66b1e71e-b7bd-4ced-9792-\
73489992e6c0"],

Cell[TextData[{
 "for simplicity, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", "ndeg"], TraditionalForm]],
  CellChangeTimes->{{3.821112967781232*^9, 3.821113031461014*^9}},
  ExpressionUUID->"f2f52120-519c-4fc6-aa42-812e03323409"],
 " being Hermitian implies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["Q", "deg"], ")"}], 
     RowBox[{"-", "1"}]], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["Q", "deg"], ")"}], 
     StyleBox["T",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "5663b63c-290c-4200-8a24-d9129aee2010"]
}], "ExpositoryText",
 CellChangeTimes->{{3.821113033734473*^9, 
  3.8211130857845984`*^9}},ExpressionUUID->"3a31810a-35bd-4e15-a374-\
3843a23f448c"],

Cell[TextData[{
 "It is worth noting that to get results that map nicely onto our original \
basis of states, we will want to sort by contributions in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["Q", "deg"], TraditionalForm]],ExpressionUUID->
  "7e7e25aa-e236-4280-9b92-b080da181f9f"],
 ", although there will be cases where almost perfect mixing is achieved. "
}], "ExpositoryText",
 CellChangeTimes->{{3.8211131627571583`*^9, 
  3.821113254273345*^9}},ExpressionUUID->"79646950-5a9e-44c9-bb2d-\
d8c32ef6ffa4"]
}, Closed]],

Cell[CellGroupData[{

Cell["First Go", "Subsubsection",
 CellChangeTimes->{{3.821109520019882*^9, 
  3.821109525024789*^9}},ExpressionUUID->"03ad389f-c3f4-4b72-a714-\
b51b2f9b0e8e"],

Cell["\<\
The idea in degenerate perturbation theory is to use non-degenerate \
perturbation theory to create a contracted representation and then do a \
regular variational calculation in this contracted subspace. To that effect \
we start with the regular perturbation theory representation of the \
Hamiltonian\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8108563297470417`*^9, 3.810856390450467*^9}, {
  3.810856427355607*^9, 
  3.810856447572991*^9}},ExpressionUUID->"0a6d3e70-e111-4fe3-8d3d-\
3ea59017d70d"],

Cell[BoxData[
 FormBox[
  RowBox[{"H", "=", 
   RowBox[{
    SubscriptBox["\[Sum]", "k"], 
    SuperscriptBox["H", 
     RowBox[{"(", "k", ")"}]]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.8108564497167683`*^9, 
  3.810856457705168*^9}},ExpressionUUID->"137a8d65-5489-4baa-9a57-\
42830474511f"],

Cell[TextData[{
 "then we take our initial basis of states ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SuperscriptBox[
     TemplateBox[{"n"},
      "Ket"], 
     RowBox[{"(", "0", ")"}]], "}"}], TraditionalForm]],ExpressionUUID->
  "2ecde7cb-3534-47ac-be05-bc2ea31eaed5"],
 " and we partition it into a non-degenerate subspace and a nearly-degenerate \
subspace, which we\[CloseCurlyQuote]re calling ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    TemplateBox[{
      SubscriptBox["\[Chi]", "i"]},
     "Ket"], "}"}], TraditionalForm]],ExpressionUUID->
  "befa10ef-0a77-497e-b280-67a0e9c56a4e"],
 "."
}], "ExpositoryText",
 CellChangeTimes->{{3.810856461550557*^9, 3.810856464448577*^9}, {
  3.8108565697732286`*^9, 3.810856704077189*^9}, {3.8108637917142763`*^9, 
  3.8108638620028257`*^9}, {3.810863983129562*^9, 3.8108639833737717`*^9}, {
  3.810864096927163*^9, 3.810864110345634*^9}, {3.810864670417645*^9, 
  3.8108646704177217`*^9}},ExpressionUUID->"c2d40a3b-27af-498b-af44-\
b715681c1d7f"],

Cell["\<\
We then, temporarily, artificially set all of the problematic off-diagonal \
elements to zero, i.e. we say\
\>", "ExpositoryText",
 CellChangeTimes->{{3.810863756809453*^9, 3.810863763836033*^9}, {
  3.8108639322894907`*^9, 
  3.8108639570846043`*^9}},ExpressionUUID->"f428c855-272b-4404-a745-\
d70693eca0c5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SubscriptBox["\[Chi]", "n"]},
     "Bra"], "H", 
    TemplateBox[{
      SubscriptBox["\[Chi]", "m"]},
     "Ket"]}], " ", "=", " ", 
   RowBox[{
    TemplateBox[{
      SubscriptBox["\[Chi]", "n"]},
     "Bra"], "H", 
    TemplateBox[{
      SubscriptBox["\[Chi]", "n"]},
     "Ket"], " ", 
    SubscriptBox["\[Delta]", 
     RowBox[{"n", "\[VeryThinSpace]", "m"}]]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.810863878214315*^9, 
  3.810863930271255*^9}},ExpressionUUID->"26830389-9e40-450e-98f5-\
779890e64738"],

Cell["or in terms of matrices, we say", "ExpositoryText",
 CellChangeTimes->{{3.810863971476089*^9, 
  3.8108639819189177`*^9}},ExpressionUUID->"bf7662d5-b7a2-474f-bd8b-\
e725ed24d46a"],

Cell[BoxData[
 FormBox[
  RowBox[{"H", " ", "=", " ", 
   RowBox[{
    SubscriptBox["H", 
     RowBox[{"non", "-", "deg"}]], " ", "+", 
    SubscriptBox["H", "deg"]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.810863986470069*^9, 3.810864015664816*^9}, {
  3.810864210670207*^9, 3.810864338788753*^9}, {3.81086440475867*^9, 
  3.810864407871264*^9}, {3.810936442882449*^9, 
  3.8109364509589376`*^9}},ExpressionUUID->"8cd09723-22c0-4e30-9177-\
5cecd440386f"],

Cell[TextData[{
 "We then treat ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"non", "-", "deg"}]], TraditionalForm]],
  CellChangeTimes->{{3.810863986470069*^9, 3.810864015664816*^9}, {
   3.810864210670207*^9, 3.810864338788753*^9}, {3.81086440475867*^9, 
   3.810864407871264*^9}},ExpressionUUID->
  "1961b149-8610-4c09-a95c-8427e24a985d"],
 " as usual using non-degenerate perturbation theory."
}], "ExpositoryText",
 CellChangeTimes->{{3.810864020335519*^9, 3.810864049912956*^9}, {
  3.810864383852981*^9, 
  3.8108644136205397`*^9}},ExpressionUUID->"b8367703-783c-4963-bf8b-\
709dabe6c6b7"],

Cell[TextData[{
 "This gives us a new basis of states to work in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    TemplateBox[{"n"},
     "Ket"], "}"}], TraditionalForm]],ExpressionUUID->
  "10dd1356-0628-4107-b3a5-8cb4f8adc4a6"],
 ", and we can use this to represent the entire Hamiltonian. First, we\
\[CloseCurlyQuote]ll note that"
}], "ExpositoryText",
 CellChangeTimes->{{3.810864051644829*^9, 
  3.810864090779706*^9}},ExpressionUUID->"4c3b00b7-9009-4466-b165-\
4005ffd864b6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{"n"},
     "Bra"], 
    SuperscriptBox["H", 
     RowBox[{"non", "-", "deg"}]], 
    TemplateBox[{"m"},
     "Ket"]}], " ", "=", " ", 
   RowBox[{
    TemplateBox[{"n"},
     "Bra"], 
    RowBox[{
     SubscriptBox["\[Sum]", "k"], 
     RowBox[{
      SubsuperscriptBox["H", 
       RowBox[{"non", "-", "deg"}], 
       RowBox[{"(", "k", ")"}]], 
      TemplateBox[{"n"},
       "Ket"], 
      SubscriptBox["\[Delta]", 
       RowBox[{"n", "\[VeryThinSpace]", "m"}]]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.810864078111456*^9, 3.8108640829099617`*^9}, {
  3.810864116252499*^9, 3.810864203389491*^9}, {3.8108643999381857`*^9, 
  3.810864477614768*^9}, {3.810936546038227*^9, 
  3.810936558516472*^9}},ExpressionUUID->"05cf6da2-41b3-4eba-bc71-\
8b4278483f0b"],

Cell["\<\
and so the difficulty is really just in dealing with the omitted terms.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8108644809413433`*^9, 
  3.810864502464632*^9}},ExpressionUUID->"604ba1ef-c0fc-4145-af53-\
8fa426c2f9e5"],

Cell["\<\
To do that, we note that from our non-degenerate treatment we have\
\>", "ExpositoryText",
 CellChangeTimes->{{3.810864504392487*^9, 
  3.810864543492889*^9}},ExpressionUUID->"38f099e3-24cf-49e9-881b-\
31d25bbcfa10"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{"n"},
    "Ket"], "=", 
   RowBox[{
    SubscriptBox["\[Sum]", "m"], 
    RowBox[{
     SubscriptBox["c", "m"], 
     SuperscriptBox[
      TemplateBox[{"n"},
       "Ket"], 
      RowBox[{"(", "0", ")"}]]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8108645792077427`*^9, 3.810864607161504*^9}, {
  3.810921833099991*^9, 3.810921840368292*^9}, {3.810921928019806*^9, 
  3.81092192828764*^9}},ExpressionUUID->"50b2eb70-2ef5-4039-a02e-\
906e139ef53d"],

Cell[TextData[{
 "and so then for any two nearly-degenerate states, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SubscriptBox["\[Chi]", "i"]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "dfb72832-cfea-4a89-b50f-a97e2bfb97e9"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SubscriptBox["\[Chi]", "j"]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "287f2561-bf8f-4f4d-babb-cbb83e2df940"],
 ", we need to pull the appropriate ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "m"], TraditionalForm]],ExpressionUUID->
  "a1e8519a-8007-49b3-b466-2801be9b5862"],
 " coefficients to allow them to couple. We then want to use this as a \
transformation on the non-zero elements of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", "deg"], TraditionalForm]],
  CellChangeTimes->{{3.810863986470069*^9, 3.810864015664816*^9}, {
   3.810864210670207*^9, 3.810864338788753*^9}, {3.81086440475867*^9, 
   3.810864407871264*^9}},ExpressionUUID->
  "3db3fc48-2a4e-4d44-accb-12b5a75efd92"],
 " to give the representation of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", "deg"], TraditionalForm]],
  CellChangeTimes->{{3.810863986470069*^9, 3.810864015664816*^9}, {
   3.810864210670207*^9, 3.810864338788753*^9}, {3.81086440475867*^9, 
   3.810864407871264*^9}},ExpressionUUID->
  "a0dacb04-c661-4638-a2a9-3e76653b2e84"],
 " in the basis of non-degenerate modes. Once we have that, we can \
diagonalize add it onto our diagonal representation of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"non", "-", "deg"}]], TraditionalForm]],
  CellChangeTimes->{{3.810863986470069*^9, 3.810864015664816*^9}, {
   3.810864210670207*^9, 3.810864338788753*^9}, {3.81086440475867*^9, 
   3.810864407871264*^9}},ExpressionUUID->
  "ccbe1ae0-74ec-408e-a18f-ea1871f88799"],
 ", and diagonalize this to get a transformation from non-degenerate space to \
the degenerate space. This transformation can then be applied to anything \
that is represented in the non-degenerate space to take it to the degenerate \
one."
}], "ExpositoryText",
 CellChangeTimes->{{3.8108646108141823`*^9, 3.81086462383295*^9}, {
  3.810864660849214*^9, 3.810864698439869*^9}, {3.810864740308834*^9, 
  3.8108647479060717`*^9}, {3.8108666091852417`*^9, 3.810866634284402*^9}, {
  3.810866709570071*^9, 3.810866710552806*^9}, {3.810866772852662*^9, 
  3.810866855777884*^9}, {3.810866886857757*^9, 
  3.810867024998827*^9}},ExpressionUUID->"593703a8-1967-4170-864f-\
9fc4daada426"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Nearly-Degenerate PT Orthonormality", "Subsection",
 CellChangeTimes->{{3.837026650698419*^9, 3.837026657799801*^9}, {
  3.8370355008650703`*^9, 
  3.8370355045052853`*^9}},ExpressionUUID->"3e781452-c663-458d-ad91-\
9d4a178eb463"],

Cell["To get orthogonality we have", "ExpositoryText",
 InitializationCell->True,
 CellChangeTimes->{{3.810301345609914*^9, 3.8103014231127443`*^9}, {
  3.8103025494105663`*^9, 3.810302551070175*^9}, {3.837026782680479*^9, 
  3.837026797994627*^9}},ExpressionUUID->"9a8456f7-452a-445f-96ef-\
63d8870d130d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      RowBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]], " "}], 
      RowBox[{"\[VeryThinSpace] ", 
        SuperscriptBox["m", 
         RowBox[{"(", "k", ")"}]]}]},
     "BraKet"], "+", 
    TemplateBox[{
      RowBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "k", ")"}]], " "}], 
      RowBox[{"\[VeryThinSpace] ", 
        SuperscriptBox["m", 
         RowBox[{"(", "0", ")"}]]}]},
     "BraKet"]}], "=", 
   RowBox[{"-", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], 
      RowBox[{"k", "-", "1"}]], 
     TemplateBox[{
       RowBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]], " "}], 
       RowBox[{"\[VeryThinSpace] ", 
         SuperscriptBox["m", 
          RowBox[{"(", 
            RowBox[{"k", "-", "i"}], ")"}]]}]},
      "BraKet"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.810302159305826*^9, 
  3.810302218358946*^9}},ExpressionUUID->"673ba7ba-5aba-41b3-b9dc-\
732f8f8a26f4"],

Cell[TextData[{
 "and when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", "n"}], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"0bc903ad-fcc1-4f56-a139-d59b573c0669"],
 " we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.8103022199418697`*^9, 
  3.810302226333486*^9}},ExpressionUUID->"1d872167-1234-46ca-b628-\
8cb2b77dadb3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     RowBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]], " "}], 
     RowBox[{"\[VeryThinSpace] ", 
       SuperscriptBox["n", 
        RowBox[{"(", "k", ")"}]]}]},
    "BraKet"], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], 
      RowBox[{"k", "-", "1"}]], 
     TemplateBox[{
       RowBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]], " "}], 
       RowBox[{"\[VeryThinSpace] ", 
         SuperscriptBox["n", 
          RowBox[{"(", 
            RowBox[{"k", "-", "i"}], ")"}]]}]},
      "BraKet"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.810302228880116*^9, 3.8103022370416*^9}, {
  3.810302328649795*^9, 
  3.810302331040989*^9}},ExpressionUUID->"5799ab4a-d59b-4852-9b18-\
f804156e54dc"],

Cell["unfortunately in the non-degenerate PT context we have....", \
"ExpositoryText",
 CellChangeTimes->{{3.837026800723866*^9, 
  3.8370268504864388`*^9}},ExpressionUUID->"2a77468d-2b77-4395-9cad-\
dd7621a612ff"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      RowBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]], " "}], 
      RowBox[{"\[VeryThinSpace] ", 
        SuperscriptBox["m", 
