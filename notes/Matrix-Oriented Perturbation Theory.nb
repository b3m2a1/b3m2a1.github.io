Cell[TextData[{
 "because as we noted before, ",
 StyleBox["we don\[CloseCurlyQuote]t actually have ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", 
        RowBox[{"k", "-", "1"}], ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "e05da337-98ac-45f8-a273-78e7f3570491"]
