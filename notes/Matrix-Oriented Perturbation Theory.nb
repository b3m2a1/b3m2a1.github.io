Cell["and we diagonalize in the subspace. ", "ExpositoryText",
 CellChangeTimes->{{3.821649066347184*^9, 3.821649072300126*^9}, {
  3.821649222431785*^9, 3.821649266635619*^9}, {3.821649389480876*^9, 
  3.8216493963919764`*^9}, {3.8217305025493317`*^9, 
  3.821730506371127*^9}},ExpressionUUID->"57eccff7-b335-49a1-9ac4-\
728692cf484f"],

Cell["\<\
Then for consistency, we\[CloseCurlyQuote]ll use the state that looks most \
like our initial state of interest, assuming one exists\
\>", "ExpositoryText",
 CellChangeTimes->{{3.821649066347184*^9, 3.821649072300126*^9}, {
  3.821649222431785*^9, 3.821649266635619*^9}, {3.821649389480876*^9, 
  3.8216493963919764`*^9}, {3.8217305025493317`*^9, 3.821730505263671*^9}, {
  3.821737818060265*^9, 
  3.821737848841238*^9}},ExpressionUUID->"e8a17f12-8197-4744-800f-\
64119296b026"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"degE1", ",", " ", "degN0"}], "}"}], "=", 
   RowBox[{"Eigensystem", "[", " ", 
    RowBox[{
     RowBox[{"\[ScriptCapitalP]", "[", "\[ScriptCapitalD]", "]"}], "**", 
     RowBox[{
      RowBox[{"\[CapitalEta]", "[", "$ptData", "]"}], "[", "1", "]"}], "**", 
     RowBox[{"\[ScriptCapitalP]", "[", "\[ScriptCapitalD]", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$dD", "=", 
   RowBox[{"initializePTData", "[", 
    RowBox[{"perturbations", ",", " ", 
     RowBox[{"\[ScriptCapitalD]", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalU]", "=", 
   RowBox[{"Complement", "[", 
    RowBox[{
     RowBox[{"\[ScriptCapitalT]", "[", "$dD", "]"}], ",", " ", 
     "\[ScriptCapitalD]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"$dD", "[", 
    RowBox[{"[", 
     RowBox[{"\"\<E\>\"", ",", " ", "2"}], "]"}], "]"}], "=", 
   RowBox[{"degE1", "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"$dD", "[", 
    RowBox[{"[", 
     RowBox[{"\"\<n\>\"", ",", " ", "1"}], "]"}], "]"}], "=", 
   RowBox[{"ReplacePart", "[", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"$dD", "[", 
        RowBox[{"[", "\"\<NDim\>\"", "]"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{"\[ScriptCapitalD]", "\[Rule]", 
       RowBox[{"degN0", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "@", 
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"figStyleText", "[", "\"\<\!\(\*TemplateBox[{
SuperscriptBox[
StyleBox[\"n\", FontSlant -> \"Italic\"], 
RowBox[{\"(\", \"0\", \")\"}]]},\"Ket\"]\)\>\"", "]"}], ",", " ", 
     RowBox[{"figStyleText", "@", "\"\<=\>\""}], ",", "\[IndentingNewLine]", 
     RowBox[{"pertPlot", "[", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Phi]", "[", "$dD", "]"}], "[", "0", "]"}], "}"}], "]"}], 
      "]"}]}], "\[IndentingNewLine]", "}"}], "}"}]}]}], "Input",
 CellChangeTimes->{{3.821648980915914*^9, 3.821649062648138*^9}, {
  3.82164919437948*^9, 3.8216492209228287`*^9}, {3.821649271071362*^9, 
