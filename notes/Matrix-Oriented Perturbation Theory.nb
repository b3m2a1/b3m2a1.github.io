    3.825788583259416*^9, 3.8257885851965933`*^9}, {3.8257886175259457`*^9, 
    3.82578870489564*^9}},ExpressionUUID->
  "885b5540-2aa0-4dc5-aaf0-e96036ab0ce9"],
 " is a subspace of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", 
    SuperscriptBox["D", 
     RowBox[{"(", 
      RowBox[{"a", "-", "1"}], ")"}]]], TraditionalForm]],ExpressionUUID->
  "cd672b25-7b67-4d9e-8311-6da115bb6c50"],
 ", giving us some form like"
}], "ExpositoryText",
 CellChangeTimes->{{3.825813258640712*^9, 
  3.82581334873705*^9}},ExpressionUUID->"3d0ee850-964a-45a9-9376-\
509a0d0b2637"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", 
        SuperscriptBox["D", 
         RowBox[{"(", "a", ")"}]]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], "a"], 
