Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{"n"},
     "Bra"], 
    SuperscriptBox["q", 
     RowBox[{"a", "+", "b"}]], 
    TemplateBox[{
      RowBox[{"n", "+", "a", "-", "b"}]},
     "Ket"]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["P", "b", "a"], "(", "n", ")"}], 
