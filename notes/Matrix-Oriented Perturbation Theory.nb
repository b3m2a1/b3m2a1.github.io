         SuperscriptBox["X", "2"]], "V"}]}], "=", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "Q"], "q"}], 
       RowBox[{
        SubscriptBox["\[Del]", "q"], 
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["X", "2"]], "V"}]}]}]}]},
    {
     RowBox[{
