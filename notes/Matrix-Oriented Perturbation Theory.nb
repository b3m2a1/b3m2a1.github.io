Cell[TextData[{
 "However it should be clear that we will have at least some cancellation, \
which we can check numerically. In particular, any term involving terms \
beyond ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"n"},
    "Ket"], TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "feb10dbc-695d-4deb-b679-9350ef190bc0"],
 " should disappear, so we\[CloseCurlyQuote]ll isolate those terms in the LHS \
sum (adding one one extra term to keep the sums clean)"
}], "ExpositoryText",
