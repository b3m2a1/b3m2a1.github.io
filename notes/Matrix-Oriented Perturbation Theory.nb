Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"\[Omega]", "=", "0"}], 
     RowBox[{
      RowBox[{"2", "\[InvisibleSpace]", "b"}], "-", "k"}]], 
    "\[VeryThinSpace]", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"z", "=", "0"}], "\[Omega]"], " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["c", 
         RowBox[{
          RowBox[{"k", "\[InvisibleSpace]", "\[Omega]"}], "-", "1"}], 
         RowBox[{"(", 
          RowBox[{"b", "-", "1"}], ")"}]], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"b", "-", "1"}], ")"}], 
         SubsuperscriptBox["c", 
          RowBox[{"k", "\[InvisibleSpace]", "\[Omega]"}], 
          RowBox[{"(", 
           RowBox[{"b", "-", "1"}], ")"}]]}], "+", 
        SubsuperscriptBox["c", 
         RowBox[{"k", "-", 
          RowBox[{"1", "\[InvisibleSpace]", "\[Omega]"}]}], 
         RowBox[{"(", 
          RowBox[{"b", "-", "1"}], ")"}]]}], ")"}], " ", 
      FractionBox[
       RowBox[{
        RowBox[{"(", "\[Omega]", ")"}], "!"}], 
       RowBox[{
        RowBox[{"z", "!"}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Omega]", "+", "1", "-", "z"}], ")"}], "!"}]}]], 
      SubsuperscriptBox["B", "z", "+"], 
      SuperscriptBox["a", 
       RowBox[{"\[Omega]", "+", "1", "-", "z"}]]}]}]}], " ", "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"p", "=", "1"}], 
     RowBox[{
      RowBox[{"2", "\[InvisibleSpace]", "b"}], "+", "1", "-", "k"}]], 
    " \[VeryThinSpace]", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"\[Omega]", "=", 
       RowBox[{"p", "-", "1"}]}], 
      RowBox[{
       RowBox[{"2", "\[InvisibleSpace]", "b"}], "-", "k"}]], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["c", 
         RowBox[{
          RowBox[{"k", "\[InvisibleSpace]", "\[Omega]"}], "-", "1"}], 
         RowBox[{"(", 
          RowBox[{"b", "-", "1"}], ")"}]], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"b", "-", "1"}], ")"}], 
         SubsuperscriptBox["c", 
          RowBox[{"k", "\[InvisibleSpace]", "\[Omega]"}], 
          RowBox[{"(", 
           RowBox[{"b", "-", "1"}], ")"}]]}], "+", 
        SubsuperscriptBox["c", 
         RowBox[{"k", "-", 
          RowBox[{"1", "\[InvisibleSpace]", "\[Omega]"}]}], 
         RowBox[{"(", 
          RowBox[{"b", "-", "1"}], ")"}]]}], ")"}], " ", 
      FractionBox[
       RowBox[{
        RowBox[{"(", "\[Omega]", ")"}], "!"}], 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Omega]", "+", "1", "-", "p"}], ")"}], "!"}], 
        RowBox[{
         RowBox[{"(", "p", ")"}], "!"}]}]], 
      SubsuperscriptBox["B", 
       RowBox[{"\[Omega]", "+", "1", "-", "p"}], "+"], 
      SuperscriptBox["a", "p"], " "}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.889449596165889*^9, 3.88944963889953*^9}, {
  3.88944972118935*^9, 3.889449775305421*^9}, {3.8894498823655577`*^9, 
