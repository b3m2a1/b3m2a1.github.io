Cell[CellGroupData[{

Cell["Property 1 (Derivative Relations)", "Subsubsection",
 CellChangeTimes->{{3.7927982012858067`*^9, 
  3.7927982145411263`*^9}},ExpressionUUID->"b1fb067d-cd6f-489c-8c5d-\
9f96fa8ef30e"],

Cell["\<\
WLOG we will state this only for swaps, but the same ideas hold for standard \
transpositions\
\>", "Text",
