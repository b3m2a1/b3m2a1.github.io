  3.89180606998516*^9}},ExpressionUUID->"b2877b0c-79a2-431d-8b53-\
fc98f948ced2"],

Cell[TextData[{
 "which obviously looks like shit, but we\[CloseCurlyQuote]ll also assume it \
can be written as an adapted power series in ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "d2cc5de8-47ce-4d4d-bf23-5fbabcce6b67"]
}], "ExpositoryText",
 CellChangeTimes->{{3.8913046703198853`*^9, 3.8913046791721153`*^9}, {
  3.891305302919538*^9, 3.89130531522857*^9}, {3.891305478844071*^9, 
  3.8913054846171713`*^9}, {3.8914437099860897`*^9, 3.89144372284086*^9}, {
  3.8914943348761053`*^9, 3.891494343502369*^9}, {3.8914945838336477`*^9, 
  3.8914945843905573`*^9}, {3.8915445934084253`*^9, 
  3.891544595480267*^9}},ExpressionUUID->"386a07ff-3d60-4908-9f2c-\
5457e2ee41f4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["c", "k", 
    RowBox[{"(", 
     RowBox[{"a", ",", "b"}], ")"}]], " ", "=", " ", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "0"}], "b"], " ", 
     RowBox[{
      SubsuperscriptBox["f", 
       RowBox[{"k", "\[InvisibleSpace]", "j"}], 
       RowBox[{"\[VeryThinSpace]", 
        RowBox[{"(", "b", ")"}]}]], 
      SuperscriptBox["a", "j"]}]}], " ", "+", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "a"], " ", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"j", "=", "0"}], 
       RowBox[{"b", "+", "k", "-", "1"}]], " ", 
      RowBox[{
       SubsuperscriptBox["g", 
        RowBox[{"k", "\[InvisibleSpace]", "j"}], 
        RowBox[{"\[VeryThinSpace]", 
         RowBox[{"(", "b", ")"}]}]], 
       SuperscriptBox["a", "j"], " "}]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.891305316813382*^9, 3.8913053632115*^9}, {
   3.8913054465544357`*^9, 3.891305495968973*^9}, {3.8913055849734783`*^9, 
   3.891305627260233*^9}, {3.8913059088483133`*^9, 3.8913059151480083`*^9}, 
   3.89130596037105*^9, {3.8913067168626537`*^9, 3.891306754350436*^9}, {
   3.891306851962346*^9, 3.8913068561225033`*^9}, 3.8913070403497047`*^9, {
   3.891365439017262*^9, 3.891365443275489*^9}, {3.891433397579258*^9, 
   3.891433401343503*^9}, {3.8914943470204973`*^9, 3.891494353589815*^9}, {
   3.8914944416850653`*^9, 3.891494457565507*^9}, {3.891494503541428*^9, 
   3.8914945149200706`*^9}, {3.891494571029539*^9, 3.89149457562614*^9}, {
   3.891494607667238*^9, 3.891494609835442*^9}, {3.891544589457758*^9, 
   3.891544614272819*^9}, {3.891598466863945*^9, 3.891598470644259*^9}, {
   3.8916227064103603`*^9, 3.89162270724542*^9}, {3.891623009547043*^9, 
   3.8916230097324543`*^9}},ExpressionUUID->"9e7ffe59-657a-4665-8fcd-\
b800c49fd259"],

Cell["\<\
since we actually can\[CloseCurlyQuote]t make a pure power series work, \
combining these we get\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8914944651551857`*^9, 3.891494487226234*^9}, {
  3.8914945287452307`*^9, 
  3.891494530768762*^9}},ExpressionUUID->"29360b59-0b26-428e-9b9b-\
69d2531ccd87"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["c", "k", 
       RowBox[{"(", 
        RowBox[{"a", ",", "b"}], ")"}]], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "a"], " ", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"a", "-", "i"}], ")"}]], 
        RowBox[{"(", " ", 
         RowBox[{
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"j", "=", "0"}], 
            RowBox[{"b", "-", "1"}]], " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              SubsuperscriptBox["f", 
               RowBox[{"k", "\[InvisibleSpace]", "j"}], 
               RowBox[{"\[VeryThinSpace]", 
                RowBox[{"(", 
                 RowBox[{"b", "-", "1"}], ")"}]}]], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"i", "-", "k", "+", "1"}], ")"}], 
               SubsuperscriptBox["f", 
                RowBox[{"k", "-", 
                 RowBox[{"1", "\[InvisibleSpace]", "j"}]}], 
                RowBox[{"\[VeryThinSpace]", 
                 RowBox[{"(", 
                  RowBox[{"b", "-", "1"}], ")"}]}]]}]}], ")"}], 
            SuperscriptBox["i", "j"]}]}], " ", "+", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "i"], " ", 
           RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{"j", "=", "0"}], 
             RowBox[{"b", "-", "1", "+", "k", "-", "1"}]], " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               SubsuperscriptBox["g", 
                RowBox[{"k", "\[InvisibleSpace]", "j"}], 
                RowBox[{"\[VeryThinSpace]", 
                 RowBox[{"(", 
                  RowBox[{"b", "-", "1"}], ")"}]}]], "+", 
               RowBox[{
                RowBox[{"(", 
