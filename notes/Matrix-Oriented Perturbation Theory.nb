2e11760da236"],

Cell[TextData[{
 "and now if we have a string of ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "79a81223-5bd7-4b13-9eec-191462a44859"],
 " operators that generate lead to a change in quanta by ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "0c7f3a12-1101-4c8a-9c99-12a2f8473716"],
 " we have"
}], "ExpositoryText",
