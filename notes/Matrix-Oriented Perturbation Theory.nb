Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{"...", " ", "=", " ", 
      RowBox[{
       RowBox[{
        SubscriptBox["n", "1"], "(", 
        RowBox[{"1", "+", 
         SubscriptBox["n", "1"]}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{"3", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["G", "111"], "+", 
              SubscriptBox["V", "111"]}], ")"}], "2"]}], 
          SubscriptBox["\[Omega]", "1"]], " ", "+", " ", 
         FractionBox[
          RowBox[{"3", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["G", "111"], "-", 
              RowBox[{"3", "\[InvisibleSpace]", 
               SubscriptBox["V", "111"]}]}], ")"}], "2"]}], 
          SubscriptBox["\[Omega]", "1"]]}], ")"}], " "}]}]},
    {
     RowBox[{"+=", " ", 
      RowBox[{
       RowBox[{
        SubscriptBox["n", "1"], "(", 
        RowBox[{"1", "+", 
         SubscriptBox["n", "1"]}], ")"}], "  ", 
       FractionBox[
        RowBox[{"4", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["G", "121"], "-", 
            RowBox[{"3", "\[InvisibleSpace]", 
             SubscriptBox["V", "121"]}]}], ")"}], "2"]}], 
        SubscriptBox["\[Omega]", "2"]], " "}]}]},
    {
     RowBox[{"+=", " ", 
      RowBox[{
       RowBox[{
