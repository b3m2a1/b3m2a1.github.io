Cell[CellGroupData[{

Cell["Higher-Order Corrections", "Subsubsubsection",
 CellChangeTimes->{{3.8103009905646257`*^9, 
  3.810300995301237*^9}},ExpressionUUID->"6e7a138e-4e37-4bc2-8f14-\
ba10b351eb8c"],

Cell["\<\
We\[CloseCurlyQuote]ll take a moment to note that we didn\[CloseCurlyQuote]t \
need to totally expand the second-order correction. And in the name of \
building a general form for these corrections, it\[CloseCurlyQuote]s worth \
thinking about how this would work iteratively.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8103010080212383`*^9, 3.8103010356769238`*^9}, {
  3.810301078841949*^9, 3.810301113092536*^9}, {3.810301280629765*^9, 
  3.8103013229317837`*^9}},ExpressionUUID->"7ae439cb-7cf9-46dd-82a7-\
b17f5015000e"],

