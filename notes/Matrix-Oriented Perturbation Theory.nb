Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], 
       SubsuperscriptBox["A", "n", 
        RowBox[{"(", "k", ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], " ", "=", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
