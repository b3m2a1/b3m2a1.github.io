 CellChangeTimes->{{3.9197699227529097`*^9, 3.919769936083555*^9}, {
  3.919769993080154*^9, 3.9197700528974113`*^9}, {3.919770094138007*^9, 
  3.919770097817978*^9}},ExpressionUUID->"80e392e6-9871-4322-b525-\
c320a57eff3a"],

Cell["extrapolating we\[CloseCurlyQuote]ll note that we can almost certainly \
write", "ExpositoryText",
 CellChangeTimes->{{3.919770082007276*^9, 3.919770103519988*^9}, {
  3.919770603501134*^9, 3.919770608411634*^9}, {3.9197707311281767`*^9, 
  3.919770733850428*^9}},ExpressionUUID->"536574fc-3935-4132-8b0c-\
70d6e599a8fe"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["Q", "n"]], 
    SubscriptBox["G", "Q"]}], " ", "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"k", "=", "0"}], "n"], " ", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"p", "\[Element]", 
       RowBox[{"\[ScriptCapitalP]", "(", 
        RowBox[{",", "2"}], ")"}]}]], " ", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{"p", "\[Element]", "\[ScriptCapitalP]"}]], " ", 
      RowBox[{
       SubscriptBox["\[Sigma]", "p"], " ", 
       RowBox[{
        UnderscriptBox["\[Sum]", "t"], "\[VeryThinSpace]", 
        SuperscriptBox[
