       RowBox[{"i", "=", "0"}], 
       RowBox[{"c", "-", "2"}]], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["E", "n", 
          RowBox[{"(", 
           RowBox[{"c", "-", "i"}], ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"]}], "-", 
        RowBox[{
         SuperscriptBox["H", 
          RowBox[{"(", 
           RowBox[{"c", "-", "i"}], ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"]}]}], ")"}]}]}], " ", "-", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["P", "D"], "(", 
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]], "-", 
       SubsuperscriptBox["E", "n", 
        RowBox[{"(", "1", ")"}]]}], ")"}], 
     SubscriptBox["P", "U"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", 
          RowBox[{"c", "-", "1"}], ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8214950222568827`*^9, 
  3.821495032862339*^9}},ExpressionUUID->"3b90aeae-0acd-4c80-ad51-\
ef03e9936a63"],

Cell[TextData[{
 "and next we\[CloseCurlyQuote]ll recall that we can get ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["E", "n", 
    RowBox[{"(", 
     RowBox[{"k", "+", "1"}], ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.821491619052662*^9, 3.821491619056903*^9}, {
    3.82149193929854*^9, 3.821491942834066*^9}, {3.821494484421122*^9, 
    3.821494486457605*^9}, {3.821494567116926*^9, 3.821494743021317*^9}, 
    3.82149477681131*^9},ExpressionUUID->
  "c11636b9-f64a-4fa6-a5d9-1daec7d3cf05"],
 " without knowing ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "D"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "5342ff90-ff04-4bea-9f4a-116a9e5ffc48"],
 ", so we can evaluate the entirety of the RHS!"
}], "ExpositoryText",
 CellChangeTimes->{{3.821495034583805*^9, 
  3.8214950990449963`*^9}},ExpressionUUID->"8ed8e953-bc36-4597-894f-\
114c5929576f"],

Cell[TextData[{
 "Now we would ",
 StyleBox["like",
  FontSlant->"Italic"],
 " to be able to invert ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["P", "D"], "(", 
     RowBox[{
      SuperscriptBox["H", 
       RowBox[{"(", "1", ")"}]], "-", 
      SubsuperscriptBox["E", "n", 
       RowBox[{"(", "1", ")"}]]}], ")"}], 
    SubscriptBox["P", "D"]}], TraditionalForm]],ExpressionUUID->
  "b1d98bbe-1300-418a-a4a9-980b63f0366b"],
 ", but unfortunately we note that"
}], "ExpositoryText",
 CellChangeTimes->{{3.8214948801069727`*^9, 3.821494895670257*^9}, {
  3.821495105106367*^9, 3.8214951237293367`*^9}, {3.8214951830483027`*^9, 
  3.8214952278819227`*^9}},ExpressionUUID->"472af33c-2717-4baf-a0a5-\
c3603a4059ed"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["P", "D"], "(", 
     RowBox[{
      SuperscriptBox["H", 
       RowBox[{"(", "1", ")"}]], "-", 
      SubsuperscriptBox["E", "n", 
       RowBox[{"(", "1", ")"}]]}], ")"}], 
    SubscriptBox["P", "D"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], "=", "0"}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821495232183918*^9, 3.821495237638376*^9}, {
  3.8214952763037167`*^9, 
  3.82149527783235*^9}},ExpressionUUID->"2faf3335-df51-4b10-9ccd-\
671e44014121"],

Cell["\<\
and so we will need to project that state out first, which we\
\[CloseCurlyQuote]ll do by defining (in a way that should remind you of the \
non-degenerate case)\
\>", "ExpositoryText",
 CellChangeTimes->{{3.821495251643207*^9, 3.821495253436935*^9}, {
  3.8214952846232233`*^9, 
  3.821495342408246*^9}},ExpressionUUID->"8ad0de7a-4515-4679-9ccc-\
b72cf195e7f2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["P", "n"], "=", 
   RowBox[{"I", "-", 
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8214953193114758`*^9, 
  3.821495352672785*^9}},ExpressionUUID->"0ef67bf0-bc66-4b1c-a1e4-\
1472397894c4"],

Cell["and now we can define", "ExpositoryText",
 CellChangeTimes->{{3.821495355012727*^9, 3.821495369932953*^9}, {
  3.8214960057810287`*^9, 
  3.821496005976755*^9}},ExpressionUUID->"d0d7ad22-8d62-4df9-9527-\
0458f672b535"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[CapitalPi]", 
    RowBox[{"D", "\[VeryThinSpace]", "n", "\[VeryThinSpace]"}]], "=", 
   RowBox[{
    SubscriptBox["P", "D"], 
    SuperscriptBox[
     RowBox[{
      SubscriptBox["P", "n"], "(", 
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]], "-", 
       SubsuperscriptBox["E", "n", 
        RowBox[{"(", "1", ")"}]]}], ")"}], 
     RowBox[{"-", "1"}]], 
    SubscriptBox["P", "n"], 
    SubscriptBox["P", "D"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821495307723208*^9, 3.821495313919986*^9}, {
  3.821495364165114*^9, 3.821495395285977*^9}, {3.821496063160696*^9, 
  3.8214960748655157`*^9}},ExpressionUUID->"a1534aae-97c6-4213-893c-\
dc8a1d4e3457"],

Cell["which means that ", "ExpositoryText",
 CellChangeTimes->{{3.821496007761271*^9, 
  3.8214960098772173`*^9}},ExpressionUUID->"4de06a6e-5b74-47bf-8ba0-\
5fea09508632"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", 
     RowBox[{"D", "\[VeryThinSpace]", "n"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", 
         RowBox[{"c", "-", "1"}], ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    SubscriptBox["\[CapitalPi]", 
     RowBox[{"D", "\[VeryThinSpace]", "n", "\[VeryThinSpace]"}]], "(", 
    RowBox[{
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "0"}], 
       RowBox[{"c", "-", "2"}]], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["E", "n", 
          RowBox[{"(", 
           RowBox[{"c", "-", "i"}], ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"]}], "-", 
        RowBox[{
         SuperscriptBox["H", 
          RowBox[{"(", 
           RowBox[{"c", "-", "i"}], ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"]}]}], ")"}]}], " ", "-", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], "-", 
        SubsuperscriptBox["E", "n", 
         RowBox[{"(", "1", ")"}]]}], ")"}], 
      SubscriptBox["P", "U"], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", 
           RowBox[{"c", "-", "1"}], ")"}]]},
       "Ket"]}]}], ")"}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8214960137617702`*^9, 3.821496084869258*^9}, {
  3.821496257807138*^9, 
  3.821496259656931*^9}},ExpressionUUID->"995a0db5-a6ce-4f06-86ae-\
9395ca824285"],

Cell[TextData[{
 "and now like in the non-degenerate case we need to recover ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]], " "}], 
     RowBox[{"\[VeryThinSpace] ", 
       SuperscriptBox["n", 
        RowBox[{"(", "k", ")"}]]}]},
    "BraKet"], TraditionalForm]],
  CellChangeTimes->{{3.810302228880116*^9, 3.8103022370416*^9}, {
   3.810302328649795*^9, 3.810302331040989*^9}},ExpressionUUID->
  "e124dfb3-1334-4ab8-855f-fe2c97cb4657"],
 " by enforcing normalization on our states. This part will look pretty much \
identical to the non-degenerate case, since again we assume"
}], "ExpositoryText",
 InitializationCell->True,
 CellChangeTimes->{{3.821496087118043*^9, 3.8214962321154327`*^9}, {
   3.821496264821966*^9, 3.821496283835046*^9}, {3.821572736428334*^9, 
   3.82157277532199*^9}, 
   3.8215730656623163`*^9},ExpressionUUID->"382eb5f9-075e-43e1-817f-\
0bdc15fb383f"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      TemplateBox[{
        RowBox[{"n", " "}], 
        RowBox[{" ", "n", "\[VeryThinSpace]"}]},
       "BraKet"], "=", "1"}]},
    {
     RowBox[{
      TemplateBox[{
        RowBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]], " "}], 
        RowBox[{" ", 
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]], "\[VeryThinSpace]"}]},
       "BraKet"], "=", "1"}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821572776367735*^9, 
  3.821572817530409*^9}},ExpressionUUID->"194698e9-4086-4c65-bbcb-\
1765e3823338"],

Cell["and so once again", "ExpositoryText",
 CellChangeTimes->{{3.821572824141416*^9, 3.821572826082032*^9}, {
  3.821572982431045*^9, 
  3.8215729852511473`*^9}},ExpressionUUID->"5844cccf-2e0a-4b64-a109-\
607af6b2184e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      RowBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]], " "}], 
      RowBox[{"\[VeryThinSpace] ", 
        SuperscriptBox["m", 
         RowBox[{"(", "k", ")"}]]}]},
     "BraKet"], "+", 
    TemplateBox[{
      RowBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "k", ")"}]], " "}], 
      RowBox[{"\[VeryThinSpace] ", 
        SuperscriptBox["m", 
         RowBox[{"(", "0", ")"}]]}]},
     "BraKet"]}], "=", 
   RowBox[{"-", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], 
      RowBox[{"k", "-", "1"}]], 
     TemplateBox[{
       RowBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]], " "}], 
       RowBox[{"\[VeryThinSpace] ", 
         SuperscriptBox["m", 
          RowBox[{"(", 
            RowBox[{"k", "-", "i"}], ")"}]]}]},
      "BraKet"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.810302159305826*^9, 
  3.810302218358946*^9}},ExpressionUUID->"4a28b123-a857-408d-a11b-\
6d810b71bdf3"],

Cell[TextData[{
 "and when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", "n"}], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"f9dc4bda-9748-4742-b3d0-9f194ffef5c8"],
 " we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.8103022199418697`*^9, 
  3.810302226333486*^9}},ExpressionUUID->"2fee0e85-03c4-451f-94eb-\
1d475878f467"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     RowBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]], " "}], 
     RowBox[{"\[VeryThinSpace] ", 
       SuperscriptBox["n", 
        RowBox[{"(", "k", ")"}]]}]},
    "BraKet"], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], 
      RowBox[{"k", "-", "1"}]], 
     TemplateBox[{
       RowBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]], " "}], 
       RowBox[{"\[VeryThinSpace] ", 
         SuperscriptBox["n", 
          RowBox[{"(", 
            RowBox[{"k", "-", "i"}], ")"}]]}]},
      "BraKet"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.810302228880116*^9, 3.8103022370416*^9}, {
  3.810302328649795*^9, 
  3.810302331040989*^9}},ExpressionUUID->"1df014f4-ca9c-47c1-a186-\
2f0b895f4875"],

Cell[TextData[{
 "So now, assuming ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],ExpressionUUID->
  "84dbf191-ff3f-4b20-847d-7c201d87e72e"],
 " removes the degeneracy, we can do degenerate perturbation theory by \
basically doing non-degenerate PT in the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "U"], TraditionalForm]],ExpressionUUID->
  "0108046d-c9f4-4c5c-aac4-53bc1f4269f7"],
 " subspace starting at ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "0", ")"}]], TraditionalForm]],ExpressionUUID->
  "ce49f1cd-2a2b-4235-9df7-89a7d825823d"],
 " and non-degenerate PT starting at ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],ExpressionUUID->
  "ccec30ca-7698-42bc-9877-513a7c945a90"],
 " in the degenerate subspace. This works because we treat ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "0", ")"}]], TraditionalForm]],ExpressionUUID->
  "6bbbd072-da17-43cc-8a14-a63a1916b325"],
 " as a constant shift."
}], "ExpositoryText",
 CellChangeTimes->{{3.821496242660925*^9, 
  3.8214963739546747`*^9}},ExpressionUUID->"4cdafdf7-03ad-4a2d-acf8-\
fdc76ab8870c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Unresolved Degeneracies", "Subsubsection",
 CellChangeTimes->{{3.821464478056425*^9, 3.821464485182255*^9}, {
  3.821491034040761*^9, 
  3.821491037814481*^9}},ExpressionUUID->"7b04be36-fde1-4f94-b5c8-\
0fa2b5c77c79"],

Cell[TextData[{
 "We need to return to the assumption that ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],ExpressionUUID->
  "c4d98256-d8ac-46c0-ad4c-ac44b115a637"],
 " resolves the degeneracy in the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "D"], TraditionalForm]],ExpressionUUID->
  "d266ffa9-9e6a-40d2-9f06-00de61167eb7"],
 " subspace. This happens when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "D"], 
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], 
    SubscriptBox["P", "D"]}], TraditionalForm]],ExpressionUUID->
  "54ce3500-6dfe-4721-8ddd-e15295e9e888"],
 " has degenerate eigenvalues"
}], "ExpositoryText",
 CellChangeTimes->{{3.8214649469461737`*^9, 3.821465008220042*^9}, {
  3.8215322603801727`*^9, 
  3.821532277982966*^9}},ExpressionUUID->"ee094443-3474-4a42-aa29-\
89238b7a5d9f"],

Cell["\<\
We will handle this the same way we dealt with what I\[CloseCurlyQuote]m \
gonna consider zero-order degeneracies. In particular, this will cause us \
grief when we write\
\>", "ExpositoryText",
 CellChangeTimes->{{3.821496541666692*^9, 3.821496555167923*^9}, {
   3.8214966761172333`*^9, 3.8214967378174*^9}, 
   3.821534611616043*^9},ExpressionUUID->"0addff63-7082-4c0c-a6f3-\
1513f4139b46"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[CapitalPi]", 
    RowBox[{"D", "\[VeryThinSpace]", "n", "\[VeryThinSpace]"}]], "=", 
   RowBox[{
    SubscriptBox["P", "D"], 
    SuperscriptBox[
     RowBox[{
      SubscriptBox["P", "n"], "(", 
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]], "-", 
       SubsuperscriptBox["E", "n", 
        RowBox[{"(", "1", ")"}]]}], ")"}], 
     RowBox[{"-", "1"}]], 
    SubscriptBox["P", "n"], 
    SubscriptBox["P", "D"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821496739077797*^9, 
  3.8214967567317963`*^9}},ExpressionUUID->"d6786886-a7d5-4701-ac21-\
1d73d0d03db6"],

Cell[TextData[{
 "Now our ",
 StyleBox["n",
  FontSlant->"Italic"],
 " will become a space of states that remain degenerate even through the \
application of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.821496739077797*^9, 3.8214967567317963`*^9}},
  ExpressionUUID->"8cf304a6-d0be-4897-b58c-806e6b438b1a"],
 ". We\[CloseCurlyQuote]ll call them ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],ExpressionUUID->
  "12acdf7a-6dea-42a6-a470-937af54dbfab"],
 " and their complement in ",
 StyleBox["D ",
  FontSlant->"Italic"],
 "will be V, i.e."
}], "ExpositoryText",
 CellChangeTimes->{{3.821496761235537*^9, 3.821496781275921*^9}, {
  3.821496953525449*^9, 3.821497021347515*^9}, {3.821497134200041*^9, 
  3.821497134200141*^9}, {3.821497276746004*^9, 
  3.821497312557827*^9}},ExpressionUUID->"334eae85-0261-4661-aaa7-\
11b8d418c80f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["P", "V"], "=", 
   RowBox[{
    SubscriptBox["P", "D"], "-", 
    SubscriptBox["P", "G"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821497295702808*^9, 
  3.821497307720636*^9}},ExpressionUUID->"af62fc90-c5cf-4d5c-8c7e-\
cca4e8cc2c22"],

Cell["\<\
Moving to the second-order trash equations in this sub-subspace\
\>", "ExpositoryText",
 CellChangeTimes->{{3.821497035307526*^9, 3.821497049618677*^9}, {
  3.821497109787348*^9, 3.821497122987525*^9}, {3.8215317338893013`*^9, 
  3.821531742385172*^9}},ExpressionUUID->"9177137a-497a-4b89-be9e-\
70d4b51547a7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["P", "G"], " ", 
     SuperscriptBox["H", 
      RowBox[{"(", "2", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     SubscriptBox["P", "G"], " ", 
     SuperscriptBox["H", 
      RowBox[{"(", "1", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "1", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     SubscriptBox["P", "G"], " ", 
     SuperscriptBox["H", 
      RowBox[{"(", "0", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "2", ")"}]]},
      "Ket"]}]}], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["E", "n", 
      RowBox[{"(", "2", ")"}]], 
     SubscriptBox["P", "G"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     SubsuperscriptBox["E", "n", 
      RowBox[{"(", "1", ")"}]], 
     SubscriptBox["P", "G"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "1", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     SubsuperscriptBox["E", "n", 
      RowBox[{"(", "0", ")"}]], 
     SubscriptBox["P", "G"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "2", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821408891537952*^9, 3.821408952509111*^9}, {
   3.821463845008441*^9, 3.821463848315783*^9}, {3.821497125486597*^9, 
   3.821497185339039*^9}, 
   3.8214972193546867`*^9},ExpressionUUID->"8bd316d6-69d4-423c-a5e9-\
753537ddf1f6"],

Cell[TextData[{
 "this space comprises the simultaneous eigenvectors of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],ExpressionUUID->
  "488d4421-3f06-4fa9-a6d1-252ee4739452"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "0", ")"}]], TraditionalForm]],ExpressionUUID->
  "ec3a973a-631d-4736-9bbd-cac06efb2027"],
 " so"
}], "ExpositoryText",
 InitializationCell->True,
 CellChangeTimes->{{3.821497189243855*^9, 
  3.821497213964712*^9}},ExpressionUUID->"72434ca4-9fd0-41c0-ac33-\
b29fc940d2e2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["P", "G"], " ", 
     SuperscriptBox["H", 
      RowBox[{"(", "2", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], "+", 
