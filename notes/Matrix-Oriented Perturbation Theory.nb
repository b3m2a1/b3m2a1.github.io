Cell[CellGroupData[{

Cell["[WORKING OFF BAD FORMS OF EQUATIONS] Connections", "Subsubsection",
 CellChangeTimes->{{3.821574527214859*^9, 3.821574532415072*^9}, {
  3.8242394869241858`*^9, 
  3.824239495937989*^9}},ExpressionUUID->"fa8c107b-4541-4738-bc86-\
b4ac27e7c29e"],

Cell["\<\
We want to make connections between the degenerate and non-degenerate PT \
implementations. \
\>", "ExpositoryText",
 CellChangeTimes->{{3.8215745336864977`*^9, 3.821574634074456*^9}, 
   3.82157644867514*^9},ExpressionUUID->"b9f584f6-82e2-47e9-a2db-\
98532801b264"],

Cell[TextData[{
 "The key to this will be a consistent definition of the sums of \
energy/Hamiltonian differences within a given state space, ",
 Cell[BoxData[
  FormBox["S", TraditionalForm]],ExpressionUUID->
  "c47d8567-6768-4219-a5f5-53611a53d99d"],
 ". For that we\[CloseCurlyQuote]ll define a projection operator"
}], "ExpositoryText",
 CellChangeTimes->{{3.8215745336864977`*^9, 3.821574634074456*^9}, {
  3.821576452936081*^9, 
  3.821576525440385*^9}},ExpressionUUID->"22d07025-b510-4916-ac29-\
1bebc683ef07"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["P", "S"], "=", 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{"s", "\[Element]", "S"}]], 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["s", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"], 
        TemplateBox[{
          SuperscriptBox["s", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"]}]}]}]},
    {
     RowBox[{
      TemplateBox[{
        RowBox[{"S", ":", "n"}]},
       "Ket"], "=", 
      RowBox[{
       SubscriptBox["P", "S"], 
       TemplateBox[{"n"},
        "Ket"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8215765264437513`*^9, 3.8215765482880373`*^9}, {
  3.821578973563361*^9, 
  3.821578996322775*^9}},ExpressionUUID->"26032e27-5e3f-49b2-8fd8-\
c1d4fe3a46ad"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["\[Delta]H", "n", 
       RowBox[{"(", "i", ")"}]], "=", " ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["H", 
         RowBox[{"(", "i", ")"}]], "-", 
        SubsuperscriptBox["E", "n", 
         RowBox[{"(", "i", ")"}]]}], ")"}]}]},
    {
     RowBox[{
      TemplateBox[{
        RowBox[{"\[VeryThinSpace]", 
          RowBox[{"S", " ", ":", " ", 
            RowBox[{
              UnderoverscriptBox[
               RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}], "start",
                "end"], 
              RowBox[{"(", "order", ")"}]}]}]}]},
       "Ket"], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "start"}], 
        RowBox[{"order", "-", "end"}]], " ", 
       RowBox[{
        SubsuperscriptBox["\[Delta]H", "n", 
         RowBox[{"(", 
          RowBox[{"order", "-", "i"}], ")"}]], 
        SubscriptBox["P", "S"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "i", ")"}]]},
         "Ket"]}]}]}]},
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         RowBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "j", ")"}]], "\[VeryThinSpace] ", ":", " ", 
           SubscriptBox["S", "L"]}]},
        "Bra"], 
       RowBox[{
        UnderoverscriptBox["\[CapitalDelta]H", "start", "end"], "(", "order", 
        ")"}], 
       TemplateBox[{
         RowBox[{
           SubscriptBox["S", "R"], " ", ":", " ", 
           RowBox[{"\[CapitalDelta]", "\[VeryThinSpace]", "n"}]}]},
        "Ket"]}], " ", "=", " ", 
      RowBox[{
       TemplateBox[{
         RowBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "j", ")"}]], " "}]},
        "Bra"], " ", 
       SubscriptBox["P", 
        SubscriptBox["S", "L"]], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "start"}], 
         RowBox[{"order", "-", "end"}]], " ", 
        RowBox[{
         SubsuperscriptBox["\[Delta]H", "n", 
          RowBox[{"(", 
           RowBox[{"order", "-", "i"}], ")"}]], 
         SubscriptBox["P", 
          SubscriptBox["S", "R"]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821574563949215*^9, 3.82157456584271*^9}, {
   3.821574791600811*^9, 3.821574901078167*^9}, {3.82157497112074*^9, 
   3.8215749714805937`*^9}, {3.821575018897408*^9, 3.821575079305225*^9}, {
   3.821575217147276*^9, 3.821575229150135*^9}, {3.821575534198604*^9, 
   3.82157553720147*^9}, {3.82157617959797*^9, 3.8215762613492537`*^9}, {
   3.821576293818606*^9, 3.821576319006239*^9}, {3.821576471533289*^9, 
   3.821576478587072*^9}, 3.821576510928577*^9, {3.821576579599359*^9, 
   3.82157661885201*^9}, {3.8215769523014927`*^9, 3.8215769527123137`*^9}, 
   3.8215769839724693`*^9, {3.821577117013253*^9, 3.821577169741025*^9}, {
   3.8215774465822372`*^9, 3.821577550963696*^9}, {3.8215776512495728`*^9, 
   3.821577705424224*^9}, 3.821577800425652*^9, {3.821577878441412*^9, 
   3.821577882045467*^9}, {3.821578545199442*^9, 3.821578558718116*^9}, {
   3.821578933156291*^9, 3.821578960068832*^9}, {3.821579033443018*^9, 
   3.8215790448087606`*^9}, {3.8217116106996613`*^9, 
   3.821711638333147*^9}},ExpressionUUID->"84048a3d-ad23-47b9-9a70-\
2136a5b7be1c"],

Cell[TextData[{
 "next we\[CloseCurlyQuote]ll define a projection operator onto a subspace, \
S, and a perturbation operator in this space centered around a state ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "c5e63cb7-770a-4d6d-9d1d-f594bbc3a46b"]
}], "ExpositoryText",
 CellChangeTimes->{{3.821575157780047*^9, 3.821575207477952*^9}, {
  3.8215752416679792`*^9, 3.821575269261608*^9}, {3.821575343792647*^9, 
  3.8215753692221127`*^9}},ExpressionUUID->"a8ce8d79-209e-4bc8-8ac3-\
f7c4b4e7b001"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"[", 
    RowBox[{"S", ":", 
     SubsuperscriptBox["\[CapitalPi]", 
      RowBox[{"\[VeryThinSpace]", "n", "\[VeryThinSpace]"}], 
      RowBox[{"(", "i", ")"}]], ":", "S"}], "]"}], "=", 
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{
       SubscriptBox["P", "S"], "(", 
       SubsuperscriptBox["\[Delta]H", "n", 
        RowBox[{"(", "i", ")"}]], ")"}], 
      RowBox[{"-", "1"}]]}], 
    SubscriptBox["P", "S"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821575172057218*^9, 3.821575189858981*^9}, {
   3.8215752432094107`*^9, 3.821575341019693*^9}, {3.8215753734496717`*^9, 
   3.8215754213741493`*^9}, {3.821576093060719*^9, 3.821576097024375*^9}, {
   3.821578601044671*^9, 3.82157860851762*^9}, {3.821578682850979*^9, 
   3.821578684416935*^9}, 
   3.821726676232464*^9},ExpressionUUID->"8c31d281-46db-4180-a8e7-\
2b5c0222de7e"],

Cell[TextData[{
 "defining ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]],ExpressionUUID->
  "c682bdfe-cd6e-485e-9cd4-2479e658e5db"],
 " to be the total state space used to build ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "0", ")"}]], TraditionalForm]],ExpressionUUID->
  "8c2c09a4-5948-4ce0-b7e6-3a3080c647ca"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "n"], "=", 
    RowBox[{"T", " ", "\[Backslash]", " ", 
     RowBox[{"{", 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]]},
       "Ket"], "}"}]}]}], TraditionalForm]],ExpressionUUID->
  "07ffec45-c11b-4a66-8905-ea1722538aaa"],
 ", with this notation the non-degenerate equations become"
}], "ExpositoryText",
 CellChangeTimes->{{3.8215750850970182`*^9, 3.821575124900065*^9}, {
  3.821575450358827*^9, 3.821575491688572*^9}, {3.8215770210952597`*^9, 
  3.8215770474744377`*^9}, {3.821577283550642*^9, 
  3.8215772938492537`*^9}},ExpressionUUID->"8cfe64e2-c6a0-475f-8a92-\
d88ab3e115c1"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox[
       SubscriptBox["E", "n"], 
       RowBox[{"(", "k", ")"}]], "=", 
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], 
        SuperscriptBox["H", 
         RowBox[{"(", "k", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], ":", "T"}]},
         "Bra"], " ", 
        RowBox[{
         UnderoverscriptBox["\[CapitalDelta]E", 
          StyleBox["1",
           FontSize->14], 
          StyleBox["1",
           FontSize->14]], "(", "k", ")"}], 
        TemplateBox[{
          RowBox[{"T", ":", 
            RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}]}]},
         "Ket"]}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", 
        SubscriptBox["T", "n"]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       RowBox[{"[", 
        RowBox[{
         SubscriptBox["T", "n"], ":", 
         SubsuperscriptBox["\[CapitalPi]", 
          RowBox[{"\[VeryThinSpace]", "n", "\[VeryThinSpace]"}], 
          RowBox[{"(", "0", ")"}]], ":", 
         SubscriptBox["T", "n"]}], "]"}], 
       TemplateBox[{
         RowBox[{"T", ":", "\[VeryThinSpace]", 
           RowBox[{
             UnderoverscriptBox[
              RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}], 
              StyleBox["0", FontSize -> 14], 
              StyleBox["1", FontSize -> 12]], 
             RowBox[{"(", "k", ")"}]}]}]},
        "Ket"]}]}]},
    {
     RowBox[{
      TemplateBox[{
        RowBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]], " "}], 
        RowBox[{"\[VeryThinSpace] ", 
          SuperscriptBox["n", 
           RowBox[{"(", "k", ")"}]]}]},
       "BraKet"], "=", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], 
         RowBox[{"k", "-", "1"}]], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "i", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", 
               RowBox[{"k", "-", "i"}], ")"}]]}]},
         "BraKet"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821575110564403*^9, 3.821575149067493*^9}, {
   3.8215755056382513`*^9, 3.8215755650522747`*^9}, 3.821575703930519*^9, {
   3.821576102521146*^9, 3.82157611003946*^9}, {3.8215763264414577`*^9, 
   3.821576365120534*^9}, {3.82157685280335*^9, 3.821576947745014*^9}, {
   3.8215770281239367`*^9, 3.8215770340418386`*^9}, {3.82157708569702*^9, 
   3.821577088334916*^9}, {3.821577191351717*^9, 3.8215772087295933`*^9}, {
   3.8215777472691097`*^9, 3.821577983547103*^9}, {3.821578563657338*^9, 
   3.82157857070404*^9}, {3.821578610866733*^9, 3.8215786161211863`*^9}, {
   3.82157867789042*^9, 3.821578679789487*^9}, {3.821579358951417*^9, 
   3.821579360024152*^9}},ExpressionUUID->"997096a7-f7a3-4b67-b9a8-\
78e735557bc6"],

Cell[TextData[{
 "which honestly looks messier in many ways, but this gets better at the \
first layer of degenerate equations, defining ",
 Cell[BoxData[
  FormBox["D", TraditionalForm]],ExpressionUUID->
  "5062884f-5b91-40df-b441-ceebfdd608bf"],
 " to be the degenerate state space, its complement to be ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", " ", "=", " ", 
    RowBox[{"T", " ", "\\", " ", "D", "\[VeryThinSpace]"}]}], 
   TraditionalForm]],ExpressionUUID->"584aef5d-9fd1-4c57-aa4d-2690ca5844f7"],
 ", and then space with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "12e2b59d-0adf-4eaa-8ea7-33ea08058911"],
 " removed as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["D", "n"], "=", 
    RowBox[{"D", " ", "\[Backslash]", " ", 
     RowBox[{"{", 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]]},
       "Ket"], "}"}]}]}], TraditionalForm]],ExpressionUUID->
  "b8e26454-e0ee-4143-8223-c9d630651893"]
}], "ExpositoryText",
 CellChangeTimes->{{3.8215763753429337`*^9, 3.821576404067554*^9}, {
  3.821577224046444*^9, 3.821577321649892*^9}, {3.8215783054848957`*^9, 
  3.8215783398911953`*^9}},ExpressionUUID->"97ddc8e8-a588-468a-86e8-\
965dd2734d24"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "D"], " ", 
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]], 
       SubscriptBox["P", "D"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       SubsuperscriptBox["E", "n", 
        RowBox[{"(", "1", ")"}]], 
       SubscriptBox["P", "D"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "U"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"[", 
         RowBox[{"U", ":", 
          SubsuperscriptBox["\[CapitalPi]", "n", 
           RowBox[{"(", "0", ")"}]], ":", "U"}], "]"}], 
        TemplateBox[{
          RowBox[{"T", ":", "\[VeryThinSpace]", 
            RowBox[{
              UnderoverscriptBox[
               RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}], 
               StyleBox["1", FontSize -> 14], 
               StyleBox["1", FontSize -> 12]], 
              RowBox[{"(", "k", ")"}]}]}]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"[", 
         RowBox[{"U", ":", 
          SubsuperscriptBox["\[CapitalPi]", "n", 
           RowBox[{"(", "0", ")"}]], ":", "U"}], "]"}], 
        SuperscriptBox["H", 
         RowBox[{"(", "k", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}]}]},
    {
     RowBox[{
      SuperscriptBox["E", 
       RowBox[{"(", "k", ")"}]], "=", " ", 
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], 
        SuperscriptBox["H", 
         RowBox[{"(", "k", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], ":", "T"}]},
         "Bra"], " ", 
        SubsuperscriptBox["\[Delta]H", "n", 
         RowBox[{"(", "1", ")"}]], 
        TemplateBox[{
          RowBox[{"U", ":", 
            SuperscriptBox["n", 
             RowBox[{"(", 
               RowBox[{"k", "-", "1"}], ")"}]]}]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], ":", "T"}]},
         "Bra"], " ", 
        RowBox[{
         UnderoverscriptBox["\[CapitalDelta]H", 
          StyleBox["1",
           FontSize->14], 
          StyleBox["2",
           FontSize->14]], "(", "k", ")"}], 
        TemplateBox[{
          RowBox[{"T", ":", 
            RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}]}]},
         "Ket"]}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", 
        RowBox[{"D", "\[VeryThinSpace]", "n"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"[", 
         RowBox[{
          SubscriptBox["D", "n"], ":", 
          SubsuperscriptBox["\[CapitalPi]", 
           RowBox[{"n", "\[VeryThinSpace]"}], 
           RowBox[{"(", "1", ")"}]], ":", 
          RowBox[{"D", "\[VeryThinSpace]", "n"}]}], "]"}], 
        TemplateBox[{
          RowBox[{"D", ":", "\[VeryThinSpace]", 
            RowBox[{
              UnderoverscriptBox[
               RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}], "0", 
               "2"], 
              RowBox[{"(", 
                RowBox[{"k", "+", "1"}], ")"}]}]}]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"[", 
         RowBox[{
          SubscriptBox["D", "n"], ":", 
          SubsuperscriptBox["\[CapitalPi]", 
           RowBox[{"n", "\[VeryThinSpace]"}], 
           RowBox[{"(", "1", ")"}]], ":", 
          RowBox[{"D", "\[VeryThinSpace]", "n"}]}], "]"}], 
        TemplateBox[{
          RowBox[{"U", ":", "\[VeryThinSpace]", 
            RowBox[{
              UnderoverscriptBox[
               RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}], "0", 
               "1"], 
              RowBox[{"(", 
                RowBox[{"k", "+", "1"}], ")"}]}]}]},
         "Ket"]}]}]}]},
    {
     RowBox[{
      TemplateBox[{
        RowBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]], " "}], 
        RowBox[{"\[VeryThinSpace] ", 
          SuperscriptBox["n", 
           RowBox[{"(", "k", ")"}]]}]},
       "BraKet"], "=", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Ket"], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], 
         RowBox[{"k", "-", "1"}]], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "i", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", 
               RowBox[{"k", "-", "i"}], ")"}]]}]},
         "BraKet"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8214641464114532`*^9, 3.821464178702422*^9}, 
   3.821464807038756*^9, 3.821492202488035*^9, {3.821564629934217*^9, 
   3.821564645747007*^9}, {3.821564685732432*^9, 3.8215648042403927`*^9}, 
   3.8215648358386297`*^9, {3.821566944774683*^9, 3.821566948607658*^9}, 
   3.82157153689513*^9, {3.821571748856003*^9, 3.8215717598588333`*^9}, 
   3.8215718185334053`*^9, {3.821571893721383*^9, 3.82157189605057*^9}, {
   3.821573075262273*^9, 3.821573076134334*^9}, {3.821577253155452*^9, 
   3.821577261744863*^9}, {3.82157733396906*^9, 3.82157736229769*^9}, 
   3.82157739849721*^9, 3.8215779974846582`*^9, {3.821578035172748*^9, 
   3.821578095142597*^9}, {3.821578132772779*^9, 3.821578149351931*^9}, {
   3.821578193557128*^9, 3.8215782373810177`*^9}, {3.8215782866134663`*^9, 
   3.821578287142173*^9}, {3.821578344443618*^9, 3.8215783731028976`*^9}, {
   3.821578413588801*^9, 3.8215784156122*^9}, 3.821578451775906*^9, {
   3.821578488678665*^9, 3.821578510236487*^9}, {3.821578634093604*^9, 
   3.821578825858182*^9}, {3.821579067125526*^9, 3.821579073252685*^9}, {
   3.821579150094592*^9, 3.8215791637023277`*^9}, {3.821580097212866*^9, 
   3.821580132259226*^9}, {3.821580162715073*^9, 3.821580180884632*^9}, {
   3.821581888526354*^9, 3.821581888721499*^9}, {3.8217266800422707`*^9, 
   3.821726683067264*^9}},ExpressionUUID->"9c581b09-c55e-438c-b6f7-\
cab4377f125a"],

Cell["\<\
which is still hard to read, I will not deny, but comparing pieces to the \
non-degenerate case we see the energy looks very similar\
\>", "ExpositoryText",
 CellChangeTimes->{{3.821579171239546*^9, 
  3.821579220765461*^9}},ExpressionUUID->"ffe33ce6-47f0-40a2-bce8-\
efea2f5d67bc"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"Non", "-", 
       RowBox[{"Degenerate", ":", " ", 
        SuperscriptBox["E", 
         RowBox[{"(", "k", ")"}]]}]}], "=", 
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], 
        SuperscriptBox["H", 
         RowBox[{"(", "k", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], ":", "T"}]},
         "Bra"], " ", 
        RowBox[{
         UnderoverscriptBox["\[CapitalDelta]E", 
          StyleBox["1",
           FontSize->14], 
          StyleBox["1",
           FontSize->14]], "(", "k", ")"}], 
        TemplateBox[{
          RowBox[{"T", ":", 
            RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}]}]},
         "Ket"]}]}]}]},
    {
     RowBox[{
      RowBox[{"Degenerate", ":", " ", 
       SuperscriptBox["E", 
        RowBox[{"(", "k", ")"}]]}], "=", " ", 
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], 
        SuperscriptBox["H", 
         RowBox[{"(", "k", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], ":", "T"}]},
         "Bra"], " ", 
        SubsuperscriptBox["\[Delta]E", "n", 
         RowBox[{"(", "1", ")"}]], 
        TemplateBox[{
          RowBox[{"U", ":", 
            SuperscriptBox["n", 
             RowBox[{"(", 
               RowBox[{"k", "-", "1"}], ")"}]]}]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], ":", "T"}]},
         "Bra"], " ", 
        UnderoverscriptBox["\[CapitalDelta]E", 
         StyleBox["1",
          FontSize->14], 
         StyleBox["2",
          FontSize->14]], 
        RowBox[{"(", "k", ")"}], 
        TemplateBox[{
          RowBox[{"T", ":", 
            RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}]}]},
         "Ket"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821579222139071*^9, 3.821579278769536*^9}, {
  3.8215818968106203`*^9, 
  3.821581896993197*^9}},ExpressionUUID->"63e775ec-61fe-46c2-8c22-\
9db34af422ea"],

Cell[TextData[{
 "the difference is basically only that we are missing ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      RowBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]], ":", "T"}]},
     "Bra"], " ", 
    SubsuperscriptBox["\[Delta]E", "n", 
     RowBox[{"(", "1", ")"}]], 
    TemplateBox[{
      RowBox[{"D", ":", 
        SuperscriptBox["n", 
         RowBox[{"(", 
           RowBox[{"k", "-", "1"}], ")"}]]}]},
     "Ket"]}], TraditionalForm]],
  CellChangeTimes->{{3.821579222139071*^9, 3.821579278769536*^9}},
  ExpressionUUID->"847dd489-807f-49f3-a375-beef3cdc088f"]
}], "ExpositoryText",
 CellChangeTimes->{{3.821579289336588*^9, 
  3.8215793044275427`*^9}},ExpressionUUID->"182ecb51-e74f-49ee-a618-\
0a785896af8a"],

Cell["Then the pieces of the wavefunction corrections, now", "ExpositoryText",
 CellChangeTimes->{{3.821579312269931*^9, 3.821579322286201*^9}, {
  3.821580208547834*^9, 
  3.82158020899476*^9}},ExpressionUUID->"2c6bd42f-f530-4219-a905-\
8dfe62b98573"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", 
        SubscriptBox["T", "n"]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       RowBox[{"[", 
        RowBox[{
         SubscriptBox["T", "n"], ":", 
         SubsuperscriptBox["\[CapitalPi]", 
          RowBox[{"\[VeryThinSpace]", "n", "\[VeryThinSpace]"}], 
          RowBox[{"(", "0", ")"}]], ":", 
         SubscriptBox["T", "n"]}], "]"}], 
       TemplateBox[{
         RowBox[{"T", ":", "\[VeryThinSpace]", 
           RowBox[{
             UnderoverscriptBox[
              RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}], 
              StyleBox["0", FontSize -> 14], 
              StyleBox["1", FontSize -> 12]], 
             RowBox[{"(", "k", ")"}]}]}]},
        "Ket"]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "U"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"[", 
         RowBox[{"U", ":", 
          SubsuperscriptBox["\[CapitalPi]", "n", 
           RowBox[{"(", "0", ")"}]], ":", "U"}], "]"}], 
        TemplateBox[{
          RowBox[{"T", ":", "\[VeryThinSpace]", 
            RowBox[{
              UnderoverscriptBox[
               RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}], 
               StyleBox["1", FontSize -> 14], 
               StyleBox["1", FontSize -> 12]], 
              RowBox[{"(", "k", ")"}]}]}]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"[", 
         RowBox[{"U", ":", 
          SubsuperscriptBox["\[CapitalPi]", "n", 
           RowBox[{"(", "0", ")"}]], ":", "U"}], "]"}], 
        SuperscriptBox["H", 
         RowBox[{"(", "k", ")"}]], 
        TemplateBox[{
          RowBox[{"T", ":", 
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]]}]},
         "Ket"]}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", 
        SubscriptBox["D", "n"]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"[", 
         RowBox[{
          SubscriptBox["D", "n"], ":", 
          SubsuperscriptBox["\[CapitalPi]", 
           RowBox[{"n", "\[VeryThinSpace]"}], 
           RowBox[{"(", "1", ")"}]], ":", 
          RowBox[{"D", "\[VeryThinSpace]", "n"}]}], "]"}], 
        TemplateBox[{
          RowBox[{"D", ":", "\[VeryThinSpace]", 
            RowBox[{
              UnderoverscriptBox[
               RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}], "0", 
               "2"], 
              RowBox[{"(", 
                RowBox[{"k", "+", "1"}], ")"}]}]}]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"[", 
         RowBox[{
          SubscriptBox["D", "n"], ":", 
          SubsuperscriptBox["\[CapitalPi]", 
           RowBox[{"n", "\[VeryThinSpace]"}], 
           RowBox[{"(", "1", ")"}]], ":", 
          RowBox[{"D", "\[VeryThinSpace]", "n"}]}], "]"}], 
        TemplateBox[{
          RowBox[{"U", ":", "\[VeryThinSpace]", 
            RowBox[{
              UnderoverscriptBox[
               RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}], "0", 
               "1"], 
              RowBox[{"(", 
                RowBox[{"k", "+", "1"}], ")"}]}]}]},
         "Ket"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821579324647792*^9, 3.8215793868144093`*^9}, {
   3.821579422613544*^9, 3.821579452062379*^9}, 3.82158021227507*^9, 
   3.821580253968664*^9},ExpressionUUID->"d2ccdb23-8211-4dc7-bb86-\
25e13698d4ae"],

Cell[TextData[{
 "we see that the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "U"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], TraditionalForm]],
  CellChangeTimes->{{3.821579324647792*^9, 3.8215793868144093`*^9}, {
   3.821579422613544*^9, 3.821579452062379*^9}},ExpressionUUID->
  "5afab888-955c-4d2b-9824-7d180d376586"],
 " is almost identical to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", 
     SubscriptBox["T", "n"]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], TraditionalForm]],
  CellChangeTimes->{{3.821579324647792*^9, 3.8215793868144093`*^9}, {
   3.821579422613544*^9, 3.821579452062379*^9}},ExpressionUUID->
  "fbb39dab-4f2c-47ab-bf39-80a4759d9607"],
 ", except we\[CloseCurlyQuote]re missing a single ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["E", 
    RowBox[{"(", "k", ")"}]], TraditionalForm]],ExpressionUUID->
  "cf476dd9-8000-444e-94c9-50c52b78a025"],
 " term, which we actually just factored out because to get ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", 
     SubscriptBox["D", "n"]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], TraditionalForm]],
  CellChangeTimes->{{3.821579324647792*^9, 3.8215793868144093`*^9}, {
   3.821579422613544*^9, 3.821579452062379*^9}},ExpressionUUID->
  "738bff83-feee-49de-bc12-001ea0fd4f94"],
 " we need to get to order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "+", "1"}], TraditionalForm]],ExpressionUUID->
  "aa9bbd18-67a7-4a77-a811-5c0e5ccdd4e8"],
 " in the energies (the bottom index tells how many terms in \[Delta]E we \
skip and the top index tells us how many terms in ",
 Cell[BoxData[
  TemplateBox[{
    SuperscriptBox["n", 
     RowBox[{"(", "k", ")"}]]},
   "Ket"]],ExpressionUUID->"c5399871-d40c-4677-b87d-9c5ae98be7c9"],
 " we skip)."
}], "ExpositoryText",
 CellChangeTimes->{{3.821579554717454*^9, 3.82157970921517*^9}, {
  3.8215802270055313`*^9, 
  3.821580235452613*^9}},ExpressionUUID->"5cd17d0c-665d-4145-9d9b-\
07479b54831f"],

Cell[TextData[{
 "Then for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", 
     SubscriptBox["D", "n"]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], TraditionalForm]],
  CellChangeTimes->{{3.821579324647792*^9, 3.8215793868144093`*^9}, {
   3.821579422613544*^9, 3.821579452062379*^9}},ExpressionUUID->
  "72bc94f2-31e8-4719-8fe8-fe5e9a661627"],
 " we\[CloseCurlyQuote]re doing ",
 StyleBox["almost",
  FontSize->14,
  FontSlant->"Italic"],
 " an entire perturbation theory correction to the wave function in the \
degenerate subspace and then adding on the corrections coming from truly \
doing a perturbation theory correction to the wave function in the \
non-degenerate subspace."
}], "ExpositoryText",
 CellChangeTimes->{{3.8215802580973873`*^9, 3.82158035830742*^9}, {
  3.821580505872078*^9, 
  3.8215805204493113`*^9}},ExpressionUUID->"279b9b29-6336-4485-9ad7-\
d2b5074d76b3"],

Cell[TextData[{
 "In essence, this tells us that first order degenerate perturbation theory \
can be understood as perturbation theory calculation in a non-degenerate \
subspace starting from ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "0", ")"}]], TraditionalForm]],ExpressionUUID->
  "86963bd3-69dd-4b52-ad11-a57ac0f6feb6"],
 " coupled to one in the degenerate subspace starting from ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],ExpressionUUID->
  "86f9aed7-ae06-4090-8ec1-66b24c07a03d"],
 ", and in fact the normalization remains identical between the two."
}], "ExpositoryText",
 CellChangeTimes->{{3.821580522365871*^9, 
  3.8215806255992603`*^9}},ExpressionUUID->"97ca9392-e86f-4044-92a4-\
ae5504c2ad36"],

Cell[TextData[{
 "Moving then to the second type of degenerate perturbation theory we let ",
 StyleBox["G",
  FontSlant->"Italic"],
 " be the space of simultaneously degenerate eigenstates of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "0", ")"}]], TraditionalForm]],ExpressionUUID->
