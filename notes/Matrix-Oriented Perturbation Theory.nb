   3.836740512994536*^9, 3.836740514752832*^9}, {3.836740821908021*^9, 
   3.836740846316292*^9}},ExpressionUUID->"10ce8dd9-e9b8-4fd2-9615-\
3ab454c3aeef"],

Cell[TextData[{
 "then from this we can note that we need the entirety of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "93b7ce9d-02e4-42dc-8075-a2d527d3be4d"],
 " as "
}], "ExpositoryText",
 CellChangeTimes->{{3.8367395489650087`*^9, 3.836739549246019*^9}, {
  3.836740517478178*^9, 3.836740652998686*^9}, {3.8367408609865313`*^9, 
  3.836740876896858*^9}},ExpressionUUID->"63bfded2-682e-42d8-93f8-\
962be1755400"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalPhi]", "(", 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "1", ")"}]]},
      "Ket"], ")"}], " ", "\[Intersection]", " ", 
    RowBox[{"\[CurlyPhi]", "(", 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "1", ")"}]]},
      "Ket"], ")"}]}], " ", "=", " ", 
   RowBox[{"\[CapitalPhi]", "(", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "1", ")"}]]},
     "Ket"], ")"}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.836740881500935*^9, 
  3.8367408923762493`*^9}},ExpressionUUID->"28d122b8-ba1e-42c2-8bba-\
3ce7bf693a60"],

Cell["but for the second order corrections we only need ", "ExpositoryText",
 CellChangeTimes->{{3.836740902899557*^9, 
  3.836740919989336*^9}},ExpressionUUID->"7160c017-e079-435c-acfa-\
cfe58074bea8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[CapitalPhi]", "(", 
    RowBox[{
     SuperscriptBox["H", 
      RowBox[{"(", "1", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "1", ")"}]]},
      "Ket"]}], ")"}], " ", "\[Intersection]", " ", 
   SuperscriptBox["\[CapitalGamma]", 
    RowBox[{"(", "0", ")"}]], " ", "\[Intersection]", " ", 
   RowBox[{"{", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"], "}"}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.836740932578497*^9, 3.836740938934464*^9}, {
  3.836741185342087*^9, 
  3.836741188522645*^9}},ExpressionUUID->"6b83e061-599c-4c4f-8095-\
2a0726cd337f"],

Cell[TextData[{
 "and by Hermiticity we don\[CloseCurlyQuote]t need to calculate the terms \
from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "(", 
    RowBox[{
     SuperscriptBox["H", 
      RowBox[{"(", "1", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "1", ")"}]]},
      "Ket"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "583f18af-3b64-4393-ac22-6194a68a95c3"],
 " \[Intersection] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"], "}"}], TraditionalForm]],
  CellChangeTimes->{{3.836740932578497*^9, 3.836740938934464*^9}, {
   3.836741185342087*^9, 3.836741188522645*^9}},ExpressionUUID->
  "c5884f61-ef41-45db-a9ae-49868d8a9210"],
 " as these are already calculated for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "(", 
    RowBox[{
     SuperscriptBox["H", 
      RowBox[{"(", "1", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.836739110306885*^9, 3.836739167823021*^9}, {
    3.836739229795149*^9, 3.836739244453781*^9}, 3.836739308751585*^9, {
    3.836739374626686*^9, 3.8367394328042173`*^9}, {3.8367394696416273`*^9, 
    3.836739508543502*^9}, {3.836739561831985*^9, 3.8367397022267647`*^9}, {
    3.83673976764296*^9, 3.8367397852427607`*^9}, {3.836739920606543*^9, 
    3.836739963298815*^9}, {3.8367400120231*^9, 3.836740012448927*^9}, {
    3.836740399565754*^9, 3.836740436786276*^9}, 3.8367404742765427`*^9, {
    3.836740512994536*^9, 3.836740514752832*^9}, {3.836740821908021*^9, 
    3.836740846316292*^9}},ExpressionUUID->
  "5ed24a2f-b855-4f97-937d-688c69d2f5b4"],
 " since the matrix elements of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.836739110306885*^9, 3.836739167823021*^9}, {
    3.836739229795149*^9, 3.836739244453781*^9}, 3.836739308751585*^9, {
    3.836739374626686*^9, 3.8367394328042173`*^9}, {3.8367394696416273`*^9, 
    3.836739508543502*^9}, {3.836739561831985*^9, 3.8367397022267647`*^9}, {
    3.83673976764296*^9, 3.8367397852427607`*^9}, {3.836739920606543*^9, 
    3.836739963298815*^9}, {3.8367400120231*^9, 3.836740012448927*^9}, {
    3.836740399565754*^9, 3.836740436786276*^9}, 3.8367404742765427`*^9, {
    3.836740512994536*^9, 3.836740514752832*^9}, {3.836740821908021*^9, 
    3.836740846316292*^9}},ExpressionUUID->
  "22a9f0a7-bc81-4e70-bfb9-2731869f93cb"],
 " that connect ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "1", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "019204ad-7efe-4cc5-8044-62dc490eb7c4"],
 " to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.836740932578497*^9, 3.836740938934464*^9}, {
   3.836741185342087*^9, 3.836741188522645*^9}},ExpressionUUID->
  "1102c136-3382-49be-acdb-d907055f1cdd"],
 " are the complex conjugates of the ones that connect ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.836740932578497*^9, 3.836740938934464*^9}, {
   3.836741185342087*^9, 3.836741188522645*^9}},ExpressionUUID->
  "9d8422bb-f8b7-438b-bd31-a3eea60e7e2a"],
 " to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "1", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "3b67f4ee-6a25-4cf9-93c4-a2d2a08c6068"]
}], "ExpositoryText",
 CellChangeTimes->{{3.836741230443912*^9, 3.836741300418334*^9}, {
   3.836741410310258*^9, 3.83674146468297*^9}, 
   3.8367415718171463`*^9},ExpressionUUID->"fe3b874b-df69-4c52-aff2-\
6fb94bdc02ec"],

Cell[TextData[{
 "Therefore the only remaining terms we might need to calculate come from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalPhi]", "(", 
     RowBox[{
      SuperscriptBox["H", 
       RowBox[{"(", "1", ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "1", ")"}]]},
       "Ket"]}], ")"}], " ", "\[Intersection]", " ", 
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{"(", "0", ")"}]]}], TraditionalForm]],
  CellChangeTimes->{{3.836741613043126*^9, 3.836741613692163*^9}},
  ExpressionUUID->"08e4061e-26ad-494d-8f20-a6c786de7b7e"],
 " which if the selection rules of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.836741613043126*^9, 3.836741613692163*^9}},
  ExpressionUUID->"f9856880-ad43-4ce3-8b68-53921935c508"],
 " are symmetric (i.e. any ways they can raise they can lower) we can also \
write as"
}], "ExpositoryText",
 CellChangeTimes->{{3.836741597795603*^9, 3.836741608548615*^9}, {
  3.836743131007326*^9, 
  3.836743142376629*^9}},ExpressionUUID->"33db2713-80b6-4f1b-aa6f-\
a9adb057fa45"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalPhi]", "(", 
     RowBox[{
      SuperscriptBox["H", 
       RowBox[{"(", "1", ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "1", ")"}]]},
       "Ket"]}], ")"}], " ", "\[Intersection]", " ", 
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{"(", "0", ")"}]]}], " ", "=", " ", 
   RowBox[{
    RowBox[{"\[CapitalPhi]", "(", 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "1", ")"}]]},
      "Ket"], ")"}], " ", "\[Intersection]", " ", 
    RowBox[{"\[CapitalPhi]", "(", 
     RowBox[{
      SuperscriptBox["H", 
       RowBox[{"(", "1", ")"}]], 
      SuperscriptBox["\[CapitalGamma]", 
       RowBox[{"(", "0", ")"}]]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.836741613043126*^9, 3.836741613692163*^9}, {
  3.836743143923254*^9, 
  3.8367431599159727`*^9}},ExpressionUUID->"d4534d8b-388d-4c32-a8ef-\
93c37257f02b"],

Cell[TextData[{
 "and then if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{
      RowBox[{"(", "0", ")"}], " "}]], "\[Subset]", " ", 
    RowBox[{"{", 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"], "}"}]}], TraditionalForm]],
  CellChangeTimes->{{3.836741613043126*^9, 3.836741613692163*^9}, {
   3.836743143923254*^9, 3.8367431599159727`*^9}},ExpressionUUID->
  "79d038bc-d286-4fb2-adc9-9f236688c5eb"],
 " we note we don\[CloseCurlyQuote]t need to calculate any more terms. If it \
is not, we need to calculate ",
 Cell[BoxData[
  RowBox[{"\[CapitalPhi]", 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["H", 
      RowBox[{"(", "1", ")"}]], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalGamma]", 
        RowBox[{"(", "0", ")"}]], " ", "\[Backslash]", " ", 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], ")"}]}], ")"}]}]],
  CellChangeTimes->{{3.836741613043126*^9, 3.836741613692163*^9}},
  ExpressionUUID->"ffeac853-42c5-4d2b-a3a7-606cfc36f677"],
 "."
}], "ExpositoryText",
 CellChangeTimes->{{3.836741803640546*^9, 3.83674180467222*^9}, {
   3.8367418697754917`*^9, 3.836741875395027*^9}, {3.8367428481420403`*^9, 
   3.8367428829687643`*^9}, {3.8367429132109118`*^9, 3.836742916045238*^9}, {
   3.8367430195002403`*^9, 3.836743019615815*^9}, {3.836743066414693*^9, 
   3.836743135043394*^9}, {3.836743168963385*^9, 3.836743218277417*^9}, {
   3.836743530600185*^9, 3.8367435731536007`*^9}, {3.836743789551745*^9, 
   3.836743793190258*^9}, 
   3.8367439030553303`*^9},ExpressionUUID->"2e38e56f-9050-4506-ba78-\
b44eec370570"],

Cell[TextData[{
 "The same logic applies to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "(", 
    RowBox[{
     SuperscriptBox["H", 
      RowBox[{"(", "2", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.836739110306885*^9, 3.836739167823021*^9}, {
    3.836739229795149*^9, 3.836739244453781*^9}, 3.836739308751585*^9, {
    3.836739374626686*^9, 3.8367394328042173`*^9}, {3.8367394696416273`*^9, 
    3.836739508543502*^9}, {3.836739561831985*^9, 3.8367397022267647`*^9}, {
    3.83673976764296*^9, 3.8367397852427607`*^9}, {3.836739920606543*^9, 
    3.836739963298815*^9}, {3.8367400120231*^9, 3.836740012448927*^9}, {
    3.836740399565754*^9, 3.836740436786276*^9}, 3.8367404742765427`*^9, {
    3.836740512994536*^9, 3.836740514752832*^9}, {3.836740821908021*^9, 
    3.836740846316292*^9}},ExpressionUUID->
  "b6c10265-b298-4275-b058-7b7df0cf89e3"],
 ", giving us"
}], "ExpositoryText",
 CellChangeTimes->{{3.836743906468589*^9, 3.8367439326413794`*^9}, {
  3.836744037458371*^9, 3.8367440420550423`*^9}, {3.836744205183302*^9, 
  3.836744205813902*^9}, {3.836749724557378*^9, 
  3.8367497255284357`*^9}},ExpressionUUID->"28df110e-4110-4d3f-ac1b-\
a58bf943d65e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalPhi]", "(", 
     RowBox[{
      SuperscriptBox["H", 
       RowBox[{"(", "2", ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]]},
       "Ket"]}], ")"}], " ", "\[Intersection]", " ", 
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{"(", "0", ")"}]]}], " ", "=", " ", 
   RowBox[{
    RowBox[{"\[CapitalPhi]", "(", 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"], ")"}], " ", "\[Intersection]", " ", 
    RowBox[{"\[CapitalPhi]", "(", 
     RowBox[{
      SuperscriptBox["H", 
       RowBox[{"(", "2", ")"}]], 
      SuperscriptBox["\[CapitalGamma]", 
       RowBox[{"(", "0", ")"}]]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.836749728502865*^9, 3.8367497648473587`*^9}, {
  3.836749871559492*^9, 
  3.8367498722316837`*^9}},ExpressionUUID->"14ffeae6-322d-4bd0-b398-\
a67774f7b09b"],

Cell[CellGroupData[{

Cell["Old Too Hard Approach", "Subsubsection",
 CellChangeTimes->{{3.836738883387732*^9, 
  3.836738889036078*^9}},ExpressionUUID->"f9ad7ed6-0221-4eb1-99a2-\
eab01796fc94"],

Cell[TextData[{
 "This allows us to be more efficient for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"j", " ", "=", "N"}], TraditionalForm]],ExpressionUUID->
  "e9445b24-aaa7-4329-876d-fbb6d9d0e3d9"],
 " since we don\[CloseCurlyQuote]t need to connect it to anything higher \
order and allows us to filter out Hamiltonian elements to calculate for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"j", " ", "<", " ", "N"}], TraditionalForm]],ExpressionUUID->
  "65cfd660-abb8-41db-b054-39d0c7621a3b"],
 " but the question remains if we can make use of this at all to avoid ever \
even calculating state space elements for the lower-order terms."
}], "ExpositoryText",
 CellChangeTimes->{{3.835355804312497*^9, 3.8353558714548407`*^9}, {
  3.835355987500445*^9, 
  3.835356042388034*^9}},ExpressionUUID->"eeebb1c5-b44d-4604-a539-\
6dbe94972fff"],

Cell[TextData[{
 "We can start by noting that by default at order ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "1ba4b0bd-5f8f-48c6-b0c4-d68b14eecb18"],
 " one has"
}], "ExpositoryText",
 CellChangeTimes->{{3.835356269821849*^9, 
  3.835356296724263*^9}},ExpressionUUID->"233bfc0e-295d-4e74-be88-\
50c363d5fcc1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "j", ")"}]]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], 
      RowBox[{"j", "-", "1"}]], 
     RowBox[{
      RowBox[{
       SubscriptBox["\[CapitalPi]", "n"], "(", 
       RowBox[{
        SubsuperscriptBox["E", "n", 
         RowBox[{"(", 
          RowBox[{"j", "-", "i"}], ")"}]], "-", 
        SuperscriptBox["H", 
         RowBox[{"(", 
          RowBox[{"j", "-", "i"}], ")"}]]}], ")"}], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}], "+", 
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"], 
     TemplateBox[{
       RowBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]], " "}], 
       RowBox[{"\[VeryThinSpace] ", 
         SuperscriptBox["n", 
          RowBox[{"(", "j", ")"}]]}]},
      "BraKet"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.835356289898128*^9, 3.835356320999384*^9}, 
   3.835359332283719*^9},ExpressionUUID->"26f7b392-6679-493b-9089-\
c1f8c1d101ed"],

Cell["and the state space for this is given by", "ExpositoryText",
 CellChangeTimes->{{3.835356326019396*^9, 3.835356327757332*^9}, {
  3.8353563623033333`*^9, 
  3.835356378422143*^9}},ExpressionUUID->"4c2d724a-f3c0-4ba0-a00f-\
d808dbbe7dd7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[CapitalPhi]", "(", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "j", ")"}]]},
     "Ket"], ")"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Union]", 
      RowBox[{"i", "=", "0"}], 
      RowBox[{"j", "-", "1"}]], " ", 
     RowBox[{"\[CapitalPhi]", "(", 
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", 
         RowBox[{"j", "-", "i"}], ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]]},
        "Ket"]}], ")"}]}], " ", "\[Union]", " ", 
    RowBox[{"{", 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"], "}"}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.835356390533958*^9, 3.835356426707198*^9}, {
   3.8353564752002497`*^9, 3.835356514384104*^9}, 
   3.835359328573205*^9},ExpressionUUID->"8ab8d6d0-7fbd-4ef8-8b4d-\
96f3bf93aba4"],

Cell[TextData[{
 "then if we have a set of selection rules for our different Hamiltonian \
perturbations, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["s", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]],ExpressionUUID->
  "52b9d72c-0c54-48d6-8931-0246ffdc6cfb"],
 " we get"
}], "ExpositoryText",
 CellChangeTimes->{{3.835359193506012*^9, 
  3.835359225354692*^9}},ExpressionUUID->"a43aae92-aebc-4422-9c78-\
d6a323d798cb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[CapitalPhi]", "(", 
    RowBox[{
     SuperscriptBox["H", 
      RowBox[{"(", 
       RowBox[{"j", "-", "i"}], ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "j", ")"}]]},
      "Ket"]}], ")"}], " ", "=", " ", 
   RowBox[{
    SuperscriptBox["s", 
     RowBox[{"(", 
      RowBox[{"j", "-", "i"}], ")"}]], "\[CircleTimes]", 
    RowBox[{"\[CapitalPhi]", "(", 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "i", ")"}]]},
      "Ket"], ")"}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.835359215810577*^9, 3.835359242341054*^9}, {
  3.83535969784813*^9, 
  3.83535970172935*^9}},ExpressionUUID->"a6673e88-848d-48d4-8362-\
ec6ff09679fb"],

Cell["so ", "ExpositoryText",
 CellChangeTimes->{{3.8353593128777514`*^9, 
  3.835359313143441*^9}},ExpressionUUID->"6e6b1daf-cc6c-4a0d-ae94-\
e5570dfbfdc0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[CapitalPhi]", "(", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "j", ")"}]]},
     "Ket"], ")"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Union]", 
      RowBox[{"i", "=", "0"}], 
      RowBox[{"j", "-", "1"}]], " ", 
     RowBox[{
      SuperscriptBox["s", 
       RowBox[{"(", 
        RowBox[{"j", "-", "i"}], ")"}]], "\[CircleTimes]", 
      RowBox[{"\[CapitalPhi]", "(", 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]]},
        "Ket"], ")"}]}]}], " ", "\[Union]", " ", 
    RowBox[{"\[CapitalPhi]", "(", 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "i", ")"}]]},
      "Ket"], ")"}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.835356390533958*^9, 3.835356426707198*^9}, {
   3.8353564752002497`*^9, 3.835356514384104*^9}, 3.835359328573205*^9, {
   3.8353596911421413`*^9, 3.835359705496464*^9}, 
   3.8354407396844797`*^9},ExpressionUUID->"56b4b8f0-fde4-43df-97e2-\
cda9802ba63f"],

Cell[TextData[{
 "and if we have selection rules for the ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "0f7c77f3-56a3-41da-a53c-e696935d5104"],
 " expansion ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]],ExpressionUUID->
  "a0e70c73-755e-40be-a0fa-b559054bb7fa"],
 " we get"
}], "ExpositoryText",
 CellChangeTimes->{{3.835359741833775*^9, 
  3.835359781308731*^9}},ExpressionUUID->"5dde1fe9-ce51-4381-a0b1-\
23241eb30c12"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[CurlyPhi]", "(", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "j", ")"}]]},
     "Ket"], ")"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Union]", 
      RowBox[{"k", "=", "0"}], "N"], " ", 
     RowBox[{
      SuperscriptBox["s", 
       RowBox[{"(", 
        RowBox[{"k", "-", "j"}], ")"}]], "\[CircleTimes]", 
      RowBox[{"\[CapitalPhi]", "(", 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"], ")"}]}]}], " ", "\[Union]", " ", 
    RowBox[{"(", " ", 
     RowBox[{
      UnderoverscriptBox["\[Union]", 
       RowBox[{"i", "=", "0"}], 
       RowBox[{"k", "-", "j"}]], " ", 
      RowBox[{
       SuperscriptBox["a", 
        RowBox[{"(", 
         RowBox[{"k", "-", "i", "-", "j"}], ")"}]], "\[CircleTimes]", " ", 
       RowBox[{"\[CapitalPhi]", "(", 
        TemplateBox[{
          SuperscriptBox["g", 
           RowBox[{"(", "i", ")"}]]},
         "Ket"], ")"}]}]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8353554306467037`*^9, 3.835355435704452*^9}, {
  3.835355723314541*^9, 3.835355741327293*^9}, {3.835355887929968*^9, 
  3.835355979206182*^9}, {3.8353561982244167`*^9, 3.8353562120228243`*^9}, {
  3.835356330878109*^9, 3.835356342523554*^9}, {3.835356429530217*^9, 
  3.835356457206007*^9}, {3.83536026706618*^9, 3.835360337943171*^9}, {
  3.8353630137298307`*^9, 
  3.835363025146784*^9}},ExpressionUUID->"3fff3ca3-1f5b-4a85-9aea-\
014589df59c3"],

Cell["then the total state space we need to actually have is ", \
"ExpositoryText",
 CellChangeTimes->{{3.8353613546392813`*^9, 
  3.835361364871258*^9}},ExpressionUUID->"c5c64f9b-77f0-47cc-9b58-\
402cd1b46c49"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[CapitalPsi]", "(", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "j", ")"}]]},
     "Ket"], ")"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"\[CapitalPhi]", "(", 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "j", ")"}]]},
      "Ket"], ")"}], " ", "\[Intersection]", " ", 
    RowBox[{"\[CurlyPhi]", "(", 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "j", ")"}]]},
      "Ket"], ")"}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.835361366195689*^9, 3.835361387384557*^9}, 
   3.835361887314066*^9, {3.835362661867927*^9, 3.835362679644615*^9}, {
   3.835362749680009*^9, 3.83536275035848*^9}, {3.835362827706915*^9, 
   3.835362828162067*^9}, {3.8353629045133038`*^9, 
   3.835362905024117*^9}},ExpressionUUID->"01ee96af-20c6-454e-8181-\
b765be62aa51"],

Cell[TextData[{
 "where in general ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CurlyPhi]", "(", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "j", ")"}]]},
     "Ket"], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.8353554306467037`*^9, 3.835355435704452*^9}, {
   3.835355723314541*^9, 3.835355741327293*^9}, {3.835355887929968*^9, 
   3.835355979206182*^9}, {3.8353561982244167`*^9, 3.8353562120228243`*^9}, {
   3.835356330878109*^9, 3.835356342523554*^9}, {3.835356429530217*^9, 
   3.835356457206007*^9}, {3.83536026706618*^9, 3.835360337943171*^9}},
  ExpressionUUID->"735647e3-7aa7-4b0a-8946-8c24d837b54f"],
 " is likely to be much cheaper to evaluate than ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "(", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "j", ")"}]]},
     "Ket"], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.8353554306467037`*^9, 3.835355435704452*^9}, {
   3.835355723314541*^9, 3.835355741327293*^9}, {3.835355887929968*^9, 
   3.835355979206182*^9}, {3.8353561982244167`*^9, 3.8353562120228243`*^9}, {
   3.835356330878109*^9, 3.835356342523554*^9}, {3.835356429530217*^9, 
   3.835356457206007*^9}, {3.83536026706618*^9, 3.835360337943171*^9}},
  ExpressionUUID->"b0742c73-4e6f-4183-bf7d-e628827c23ca"],
 " so it might make sense only to evaluate ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CurlyPhi]", "(", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "j", ")"}]]},
     "Ket"], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.835361366195689*^9, 3.835361387384557*^9}, 
    3.835361887314066*^9, {3.835362661867927*^9, 3.835362679644615*^9}, {
    3.835362749680009*^9, 3.83536275035848*^9}, {3.835362827706915*^9, 
    3.835362828162067*^9}, {3.8353629045133038`*^9, 3.835362905024117*^9}},
  ExpressionUUID->"569c5139-78d8-402e-9f03-4686601bd2a5"],
 "...except actually that might still be big... The main issue though is how \
to determine which Hamiltonian elements we need to get to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CurlyPhi]", "(", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "j", ")"}]]},
     "Ket"], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.835361366195689*^9, 3.835361387384557*^9}, 
    3.835361887314066*^9, {3.835362661867927*^9, 3.835362679644615*^9}, {
    3.835362749680009*^9, 3.83536275035848*^9}, {3.835362827706915*^9, 
    3.835362828162067*^9}, {3.8353629045133038`*^9, 3.835362905024117*^9}},
  ExpressionUUID->"00e1405d-e682-4048-9e40-f40e13a9b966"],
 " and for that we can note that we can write"
}], "ExpositoryText",
 CellChangeTimes->{{3.835362830114374*^9, 3.835362834857966*^9}, {
  3.835362907482395*^9, 3.835363002709586*^9}, {3.835363553760108*^9, 
  3.835363607837968*^9}, {3.835363646151291*^9, 
  3.83536367067706*^9}},ExpressionUUID->"c5357370-6a33-4c8e-a484-\
396dc2fd37dd"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SuperscriptBox["a", 
        RowBox[{"(", 
         RowBox[{"k", "-", "i", "-", "j"}], ")"}]], "\[CircleTimes]", " ", 
       RowBox[{"\[CapitalPhi]", "(", 
        TemplateBox[{
          SuperscriptBox["g", 
           RowBox[{"(", "i", ")"}]]},
         "Ket"], ")"}]}], " ", "=", " ", 
      RowBox[{
       SuperscriptBox["a", 
        RowBox[{"(", 
         RowBox[{"k", "-", "i", "-", "j"}], ")"}]], "\[CircleTimes]", 
       RowBox[{"(", " ", 
        RowBox[{
         RowBox[{
          UnderoverscriptBox["\[Union]", 
           RowBox[{"l", "=", "0"}], 
           RowBox[{"i", "-", "1"}]], " ", 
          RowBox[{
           SuperscriptBox["s", 
            RowBox[{"(", 
             RowBox[{"i", "-", "l"}], ")"}]], "\[CircleTimes]", 
           RowBox[{"\[CapitalPhi]", "(", 
            TemplateBox[{
              SuperscriptBox["g", 
               RowBox[{"(", "l", ")"}]]},
             "Ket"], ")"}]}]}], " ", "\[Union]", " ", 
         RowBox[{"{", 
          TemplateBox[{
            SuperscriptBox["g", 
             RowBox[{"(", "0", ")"}]]},
           "Ket"], "}"}]}], ")"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Union]", 
         RowBox[{"l", "=", "0"}], 
         RowBox[{"i", "-", "1"}]], " ", 
        RowBox[{
         SuperscriptBox["a", 
          RowBox[{"(", 
           RowBox[{"k", "-", "i", "-", "j"}], ")"}]], "\[CircleTimes]", 
         SuperscriptBox["s", 
          RowBox[{"(", 
           RowBox[{"i", "-", "l"}], ")"}]], "\[CircleTimes]", 
         RowBox[{"\[CapitalPhi]", "(", 
          TemplateBox[{
            SuperscriptBox["g", 
             RowBox[{"(", "l", ")"}]]},
           "Ket"], ")"}]}]}], " ", "\[Union]", " ", 
       RowBox[{
        SuperscriptBox["a", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i", "-", "j"}], ")"}]], "\[CircleTimes]", 
        RowBox[{"{", 
         TemplateBox[{
           SuperscriptBox["g", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"], "}"}], " "}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.835363674579297*^9, 3.835363675786661*^9}, {
   3.835363929128476*^9, 3.8353639948813267`*^9}, {3.8353736665501623`*^9, 
   3.8353736923183527`*^9}, 
   3.835373799357905*^9},ExpressionUUID->"d59b5618-12d0-49ee-b21b-\
e1f435858866"],

Cell["\<\
and we\[CloseCurlyQuote]ll give names to all of the terms we need (mostly \
picked at random)\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8354402524468937`*^9, 3.835440254602153*^9}, {
  3.835440361812512*^9, 3.835440386822453*^9}, {3.835440432874043*^9, 
  3.835440545929947*^9}, {3.835440593617585*^9, 3.8354406006744623`*^9}, {
  3.835440692174575*^9, 
  3.8354406964042673`*^9}},ExpressionUUID->"fdea09c5-4f7a-4bc3-b931-\
770a40d31ae2"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"P", "(", 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "j", ")"}]]},
        "Ket"], ")"}], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Union]", 
        RowBox[{"k", "=", "0"}], "N"], " ", 
       RowBox[{
        UnderoverscriptBox["\[Union]", 
         RowBox[{"i", "=", "0"}], 
         RowBox[{"k", "-", "j"}]], " ", 
        RowBox[{
         SuperscriptBox["a", 
          RowBox[{"(", 
           RowBox[{"k", "-", "i", "-", "j"}], ")"}]], "\[CircleTimes]", " ", 
         RowBox[{"\[CapitalPhi]", "(", 
          TemplateBox[{
            SuperscriptBox["g", 
             RowBox[{"(", "i", ")"}]]},
           "Ket"], ")"}]}]}]}]}]},
    {
     RowBox[{
      RowBox[{"J", "(", 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "j", ")"}]]},
        "Ket"], ")"}], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Union]", 
        RowBox[{"k", "=", "0"}], "N"], " ", 
       RowBox[{
        SuperscriptBox["s", 
         RowBox[{"(", 
          RowBox[{"k", "-", "j"}], ")"}]], "\[CircleTimes]", 
        RowBox[{"\[CapitalPhi]", "(", 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"], ")"}]}]}]}]},
    {
     RowBox[{
      RowBox[{"R", "(", 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "j", ")"}]]},
        "Ket"], ")"}], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Union]", 
        RowBox[{"i", "=", "0"}], 
        RowBox[{"j", "-", "1"}]], " ", 
       RowBox[{
        SuperscriptBox["s", 
         RowBox[{"(", 
          RowBox[{"j", "-", "i"}], ")"}]], "\[CircleTimes]", 
        RowBox[{"\[CapitalPhi]", "(", 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"], ")"}]}]}]}]},
    {
     RowBox[{
      RowBox[{"B", "(", 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "j", ")"}]]},
        "Ket"], ")"}], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Union]", 
        RowBox[{"i", "=", "0"}], 
        RowBox[{"j", "-", "1"}]], " ", 
       RowBox[{"\[CapitalPhi]", "(", 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "i", ")"}]]},
         "Ket"], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8354406027625837`*^9, 3.8354407087922363`*^9}, {
  3.8354414915673*^9, 3.83544153194179*^9}, {3.835441580881674*^9, 
  3.835441582027815*^9}, {3.835441660160193*^9, 
  3.835441660627432*^9}},ExpressionUUID->"f7f2d26c-8acd-4562-921c-\
44218e68f1bd"],

Cell["so our intersection can be written as", "ExpositoryText",
 CellChangeTimes->{{3.835441471427867*^9, 3.8354414778447933`*^9}, 
   3.8356244002044783`*^9},ExpressionUUID->"4242e0f1-c5b5-473c-8aa3-\
a02040d33430"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[CapitalPsi]", "(", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "j", ")"}]]},
     "Ket"], ")"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"P", "(", 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "j", ")"}]]},
       "Ket"], ")"}], " ", "\[Intersection]", " ", 
     RowBox[{"R", "(", 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "j", ")"}]]},
       "Ket"], ")"}]}], " ", "\[Union]", " ", 
    RowBox[{
     RowBox[{"P", "(", 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "j", ")"}]]},
       "Ket"], ")"}], " ", "\[Intersection]", " ", 
     RowBox[{"B", "(", 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "j", ")"}]]},
       "Ket"], ")"}]}], " ", "\[Union]", " ", 
    RowBox[{
     RowBox[{"J", "(", 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "j", ")"}]]},
       "Ket"], ")"}], " ", "\[Intersection]", " ", 
     RowBox[{"R", "(", 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "j", ")"}]]},
       "Ket"], ")"}]}], " ", "\[Union]", " ", 
    RowBox[{
     RowBox[{"J", "(", 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "j", ")"}]]},
       "Ket"], ")"}], " ", "\[Intersection]", " ", 
     RowBox[{"B", "(", 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "j", ")"}]]},
       "Ket"], ")"}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8354415921753597`*^9, 3.8354416297475243`*^9}, {
  3.835441935217407*^9, 
  3.8354419540917664`*^9}},ExpressionUUID->"d31d8d00-aa80-4386-9f53-\
1311fda9648c"],

Cell["\<\
and we can treat these terms independently. Most of them are easy to assess \
once we recognize that\
\>", "ExpositoryText",
 CellChangeTimes->{{3.835441958763014*^9, 3.835441968150461*^9}, {
  3.8354423999192257`*^9, 3.8354424128855133`*^9}, {3.835442556009707*^9, 
  3.8354425626064577`*^9}, {3.835442597448203*^9, 
  3.83544259876031*^9}},ExpressionUUID->"8f4a8739-86fb-472e-95d2-\
1bc844817f4b"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["s", 
         RowBox[{"(", 
          RowBox[{"k", "-", "j"}], ")"}]], "\[CircleTimes]", "A"}], " ", 
       "\[Intersection]", " ", 
       RowBox[{
        SuperscriptBox["s", 
         RowBox[{"(", 
          RowBox[{"j", "-", "i"}], ")"}]], "\[CircleTimes]", "B"}]}], " ", 
      "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", 
          SuperscriptBox["s", 
           RowBox[{"(", 
            RowBox[{"j", "-", "i"}], ")"}]]}], ")"}], "\[CircleTimes]", 
        SuperscriptBox["s", 
         RowBox[{"(", 
          RowBox[{"k", "-", "j"}], ")"}]], "\[CircleTimes]", "A"}], " ", 
       "\[Intersection]", " ", "B"}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["s", 
            RowBox[{"(", 
             RowBox[{"j", "-", "i"}], ")"}]]}], "\[CircleTimes]", 
          SuperscriptBox["s", 
           RowBox[{"(", 
            RowBox[{"k", "-", "j"}], ")"}]]}], ")"}], "\[CircleTimes]", "A"}],
        " ", "\[Intersection]", " ", "B"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.835442601095347*^9, 
  3.835442675727271*^9}},ExpressionUUID->"20d5bcb3-9c1f-4202-9765-\
195346023d89"],

Cell["\<\
which can be evaluated more efficiently than taking the intersection of two \
direct product terms.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.835442661361636*^9, 3.835442663362583*^9}, {
  3.83544275725994*^9, 
  3.8354427758160057`*^9}},ExpressionUUID->"9a52666b-6514-47a2-9b8d-\
961ef27aa971"],

Cell["\<\
For two of the terms, then, this gives us straightforward evaluation rules\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8354427772845173`*^9, 3.8354427938155127`*^9}, {
  3.8354428681323137`*^9, 3.835442873039784*^9}, {3.8354436646452847`*^9, 
  3.835443667628064*^9}, {3.8354443010414753`*^9, 
  3.83544430133904*^9}},ExpressionUUID->"583cc43c-d80b-4825-82a9-\
c774067d22d5"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       RowBox[{"J", "(", 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "j", ")"}]]},
         "Ket"], ")"}], " ", "\[Intersection]", " ", 
       RowBox[{"B", "(", 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "j", ")"}]]},
         "Ket"], ")"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Union]", 
         RowBox[{"k", "=", "0"}], "N"], " ", 
        RowBox[{
         SuperscriptBox["s", 
          RowBox[{"(", 
           RowBox[{"k", "-", "j"}], ")"}]], "\[CircleTimes]", 
         RowBox[{"\[CapitalPhi]", "(", 
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]]},
           "Ket"], ")"}]}]}], " ", "\[Intersection]", " ", 
       RowBox[{
        UnderoverscriptBox["\[Union]", 
         RowBox[{"i", "=", "0"}], 
         RowBox[{"j", "-", "1"}]], " ", 
        RowBox[{"\[CapitalPhi]", "(", 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"], ")"}]}]}]}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{"J", "(", 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "j", ")"}]]},
         "Ket"], ")"}], " ", "\[Intersection]", " ", 
       RowBox[{"R", "(", 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "j", ")"}]]},
         "Ket"], ")"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Union]", 
         RowBox[{"k", "=", "0"}], "N"], " ", 
        RowBox[{
         RowBox[{
          SuperscriptBox["s", 
           RowBox[{"(", 
            RowBox[{"k", "-", "j"}], ")"}]], "\[CircleTimes]", 
          "\[CapitalPhi]"}], 
         RowBox[{"(", 
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]]},
           "Ket"], ")"}]}]}], " ", "\[Intersection]", " ", 
       RowBox[{
        UnderoverscriptBox["\[Union]", 
         RowBox[{"i", "=", "0"}], 
         RowBox[{"j", "-", "1"}]], " ", 
        RowBox[{
         RowBox[{
          SuperscriptBox["s", 
           RowBox[{"(", 
            RowBox[{"j", "-", "i"}], ")"}]], "\[CircleTimes]", 
          "\[CapitalPhi]"}], 
         RowBox[{"(", 
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "i", ")"}]]},
           "Ket"], ")"}]}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Union]", 
         RowBox[{"k", "=", "0"}], "N"], " ", 
        RowBox[{
         UnderoverscriptBox["\[Union]", 
          RowBox[{"i", "=", "0"}], 
          RowBox[{"j", "-", "1"}]], "  ", 
         RowBox[{
          SuperscriptBox["s", 
           RowBox[{"(", 
            RowBox[{"k", "-", "j"}], ")"}]], "\[CircleTimes]", 
          RowBox[{"\[CapitalPhi]", "(", 
           TemplateBox[{
             SuperscriptBox["n", 
              RowBox[{"(", "0", ")"}]]},
            "Ket"], ")"}]}]}]}], " ", "\[Intersection]", " ", 
       RowBox[{
        SuperscriptBox["s", 
         RowBox[{"(", 
          RowBox[{"j", "-", "i"}], ")"}]], "\[CircleTimes]", 
        RowBox[{"\[CapitalPhi]", "(", 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"], ")"}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Union]", 
         RowBox[{"k", "=", "0"}], "N"], " ", 
        RowBox[{
         UnderoverscriptBox["\[Union]", 
          RowBox[{"i", "=", "0"}], 
          RowBox[{"j", "-", "1"}]], "  ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             SuperscriptBox["s", 
              RowBox[{"(", 
               RowBox[{"j", "-", "i"}], ")"}]]}], "\[CircleTimes]", 
            SuperscriptBox["s", 
             RowBox[{"(", 
              RowBox[{"k", "-", "j"}], ")"}]]}], ")"}], "\[CircleTimes]", 
          RowBox[{"\[CapitalPhi]", "(", 
           TemplateBox[{
             SuperscriptBox["n", 
              RowBox[{"(", "0", ")"}]]},
            "Ket"], ")"}]}]}]}], " ", "\[Intersection]", " ", 
       RowBox[{"\[CapitalPhi]", "(", 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "i", ")"}]]},
         "Ket"], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8354424143625307`*^9, 3.83544259284545*^9}, {
   3.8354428499376698`*^9, 3.835442851941505*^9}, {3.8354434377477293`*^9, 
   3.835443459192238*^9}, {3.835443626266129*^9, 3.835443654355342*^9}, {
   3.835443690915619*^9, 3.835443715929097*^9}, {3.835444127054687*^9, 
   3.835444154849948*^9}, 3.835444303265346*^9, {3.8356092168771563`*^9, 
   3.8356092562496233`*^9}},ExpressionUUID->"9ec04bf7-9818-41ca-bb15-\
9a46e776308d"],

Cell[TextData[{
 "and since we can characterize the terms in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPhi]", "(", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "i", ")"}]]},
     "Ket"], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.8354424143625307`*^9, 3.83544259284545*^9}, {
    3.8354428499376698`*^9, 3.835442851941505*^9}, {3.8354434377477293`*^9, 
    3.835443459192238*^9}, {3.835443626266129*^9, 3.835443654355342*^9}, {
    3.835443690915619*^9, 3.835443715929097*^9}, {3.835444127054687*^9, 
    3.835444154849948*^9}, 3.835444303265346*^9},ExpressionUUID->
  "8a4c329b-a248-46bb-8eed-afc8b1311773"],
 " as sequences like"
}], "ExpositoryText",
 CellChangeTimes->{{3.835444982434863*^9, 
  3.835445000255434*^9}},ExpressionUUID->"78e20f30-2371-494e-9445-\
d70cb2ddf3a3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[CapitalPhi]", "(", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "i", ")"}]]},
     "Ket"], ")"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      UnderscriptBox["\[Union]", "p"], " ", 
      RowBox[{
       SuperscriptBox["s", 
        RowBox[{"(", 
         SubscriptBox["p", "1"], ")"}]], "\[CircleTimes]", 
       SuperscriptBox["s", 
        RowBox[{"(", 
         SubscriptBox["p", "2"], ")"}]]}]}], "..."}], "\[CircleTimes]", 
    RowBox[{"\[CapitalPhi]", "(", 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"], ")"}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8354450018973923`*^9, 
  3.835445060818303*^9}},ExpressionUUID->"a9870006-36ad-46d2-9741-\
c8acad7a49c0"],

Cell["\<\
we can calculate whether these terms intersect or not relatively easily since \
we just need the identity to be in the total product of rules. This would \
potentially allow us to avoid calculating unnecessary terms.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.83544506396741*^9, 3.835445103331232*^9}, {
   3.835445145883574*^9, 3.8354451822762203`*^9}, 3.835449382186667*^9, {
   3.835486064039796*^9, 3.8354860772347*^9}, {3.835519932923089*^9, 
   3.835519933533328*^9}, {3.835609260833819*^9, 3.8356092628189573`*^9}, {
   3.835609307131336*^9, 
   3.8356093612279577`*^9}},ExpressionUUID->"26a0ce3e-c27a-41b5-b282-\
23ed73bd4110"],

Cell["\<\
For the remaining terms the analysis is similar but slightly more complicated\
\
\>", "ExpositoryText",
 CellChangeTimes->{{3.835444297444257*^9, 3.835444315172202*^9}, {
  3.835445266725687*^9, 3.835445268794014*^9}, {3.835609364950411*^9, 
  3.835609372984459*^9}},ExpressionUUID->"6e29493f-a792-4ee7-8178-\
18b5c06684d2"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       RowBox[{"P", "(", 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "j", ")"}]]},
         "Ket"], ")"}], " ", "\[Intersection]", " ", 
       RowBox[{"B", "(", 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "j", ")"}]]},
         "Ket"], ")"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Union]", 
         RowBox[{"k", "=", "0"}], "N"], " ", 
        RowBox[{
         UnderoverscriptBox["\[Union]", 
          RowBox[{"i", "=", "0"}], 
          RowBox[{"k", "-", "j"}]], " ", 
         RowBox[{
          UnderoverscriptBox["\[Union]", 
           RowBox[{"l", "=", "0"}], 
           RowBox[{"j", "-", "1"}]], " ", 
          RowBox[{
           SuperscriptBox["a", 
            RowBox[{"(", 
             RowBox[{"k", "-", "i", "-", "j"}], ")"}]], "\[CircleTimes]", " ", 
           RowBox[{"\[CapitalPhi]", "(", 
            TemplateBox[{
              SuperscriptBox["g", 
               RowBox[{"(", "i", ")"}]]},
             "Ket"], ")"}]}]}]}]}], " ", "\[Intersection]", " ", 
       RowBox[{"\[CapitalPhi]", "(", 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "l", ")"}]]},
         "Ket"], ")"}]}]}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{"P", "(", 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "j", ")"}]]},
         "Ket"], ")"}], " ", "\[Intersection]", " ", 
       RowBox[{"R", "(", 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "j", ")"}]]},
         "Ket"], ")"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Union]", 
         RowBox[{"k", "=", "0"}], "N"], " ", 
        RowBox[{
         UnderoverscriptBox["\[Union]", 
          RowBox[{"i", "=", "0"}], 
          RowBox[{"k", "-", "j"}]], " ", 
         RowBox[{
          UnderoverscriptBox["\[Union]", 
           RowBox[{"l", "=", "0"}], 
           RowBox[{"j", "-", "1"}]], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", 
              SuperscriptBox["s", 
               RowBox[{"(", 
                RowBox[{"j", "-", "i"}], ")"}]]}], "\[CircleTimes]", 
             SuperscriptBox["a", 
              RowBox[{"(", 
               RowBox[{"k", "-", "i", "-", "j"}], ")"}]]}], ")"}], 
           "\[CircleTimes]", " ", 
           RowBox[{"\[CapitalPhi]", "(", 
            TemplateBox[{
              SuperscriptBox["g", 
               RowBox[{"(", "i", ")"}]]},
             "Ket"], ")"}]}]}]}]}], " ", "\[Intersection]", " ", 
       RowBox[{"\[CapitalPhi]", "(", 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "l", ")"}]]},
         "Ket"], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.835444318243494*^9, 
  3.835444320268847*^9}},ExpressionUUID->"0c30edda-4052-4996-9663-\
7355335fea57"],

Cell["However we can do a similar trick to before, noting that", \
"ExpositoryText",
 CellChangeTimes->{{3.835449387399603*^9, 3.835449391849804*^9}, {
   3.835449581907465*^9, 3.835449591764962*^9}, 
   3.835708583704932*^9},ExpressionUUID->"f91c0c9a-043d-4326-a350-\
d2b73e6087f6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[CapitalPhi]", "(", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "i", ")"}]]},
     "Ket"], ")"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      UnderscriptBox["\[Union]", "p"], " ", 
      RowBox[{
       SuperscriptBox["s", 
        RowBox[{"(", 
         SubscriptBox["p", "1"], ")"}]], "\[CircleTimes]", 
       SuperscriptBox["s", 
        RowBox[{"(", 
         SubscriptBox["p", "2"], ")"}]]}]}], "..."}], "\[CircleTimes]", 
    RowBox[{"\[CapitalPhi]", "(", 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"], ")"}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8354450018973923`*^9, 
  3.835445060818303*^9}},ExpressionUUID->"de4733dc-7de7-445b-a401-\
dafa59f298e6"],

Cell["and so", "ExpositoryText",
 CellChangeTimes->{{3.835449600975891*^9, 
  3.835449615203285*^9}},ExpressionUUID->"1fa292ff-6e06-432a-a998-\
08773cd5c9c4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["s", 
        RowBox[{"(", 
         RowBox[{"j", "-", "i"}], ")"}]]}], "\[CircleTimes]", 
      SuperscriptBox["a", 
       RowBox[{"(", 
        RowBox[{"k", "-", "i", "-", "j"}], ")"}]]}], ")"}], "\[CircleTimes]", 
    " ", 
    RowBox[{"\[CapitalPhi]", "(", 
     TemplateBox[{
       SuperscriptBox["g", 
        RowBox[{"(", "i", ")"}]]},
      "Ket"], ")"}]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      UnderscriptBox["\[Union]", "p"], "  ", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["s", 
         RowBox[{"(", 
          RowBox[{"j", "-", "i"}], ")"}]]}], "\[CircleTimes]", 
       SuperscriptBox["a", 
        RowBox[{"(", 
         RowBox[{"k", "-", "i", "-", "j"}], ")"}]], "\[CircleTimes]", 
       SuperscriptBox["s", 
        RowBox[{"(", 
         SubscriptBox["p", "1"], ")"}]], "\[CircleTimes]", 
       SuperscriptBox["s", 
        RowBox[{"(", 
         SubscriptBox["p", "2"], ")"}]]}]}], "..."}], "\[CircleTimes]", 
    RowBox[{"\[CapitalPhi]", "(", 
     TemplateBox[{
       SuperscriptBox["g", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"], ")"}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8354496101187067`*^9, 
  3.8354496433582983`*^9}},ExpressionUUID->"be1aebaa-52e8-4c23-a6ae-\
c750490f66c8"],

Cell[TextData[{
 "then by defining ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]],ExpressionUUID->
  "531330fe-f7e8-42e1-8f4b-76c9c89b9b43"],
 " to be the smallest set of selection rules such that "
}], "ExpositoryText",
 CellChangeTimes->{{3.835449743588833*^9, 3.835449783854045*^9}, {
  3.835450421031906*^9, 
  3.8354504231084433`*^9}},ExpressionUUID->"021276a4-b014-4bc8-bbbc-\
d6c61e93f560"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[CapitalPhi]", "(", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"], ")"}], " ", "\[Subset]", " ", 
   RowBox[{"d", " ", "\[CircleTimes]", " ", 
    RowBox[{"\[CapitalPhi]", "(", 
     TemplateBox[{
       SuperscriptBox["g", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"], ")"}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.83544975667029*^9, 3.835449803950192*^9}, {
  3.835450411864745*^9, 3.835450426978725*^9}, {3.835450482874857*^9, 
  3.835450486204628*^9}},ExpressionUUID->"c5946167-d94b-4877-8e09-\
213e1996a540"],

Cell["we can write", "ExpositoryText",
 CellChangeTimes->{{3.835450478194702*^9, 3.835450498991075*^9}, {
  3.835450548291363*^9, 
  3.8354505506137247`*^9}},ExpressionUUID->"36323c7c-7610-4cce-8dff-\
ef7cdac0bb4e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalPhi]", "(", 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "l", ")"}]]},
       "Ket"], ")"}], " ", "\[Subset]", " ", 
     RowBox[{
      UnderscriptBox["\[Union]", "r"], " ", 
      RowBox[{
       SuperscriptBox["s", 
        RowBox[{"(", 
         SubscriptBox["r", "1"], ")"}]], "\[CircleTimes]", 
       SuperscriptBox["s", 
        RowBox[{"(", 
         SubscriptBox["r", "2"], ")"}]]}]}]}], "..."}], "\[CircleTimes]", " ",
    "d", " ", "\[CircleTimes]", " ", 
   RowBox[{"\[CapitalPhi]", "(", 
    TemplateBox[{
      SuperscriptBox["g", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"], ")"}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8354450018973923`*^9, 3.835445060818303*^9}, {
  3.8354513011134377`*^9, 3.8354513075607*^9}, {3.835451542685213*^9, 
  3.835451551229752*^9}},ExpressionUUID->"8a2f91a8-429f-4954-9659-\
281ab03f7a65"],

Cell["\<\
and then we just need to figure out which paths through the total set of \
lattice paths\
\>", "ExpositoryText",
 CellChangeTimes->{{3.835451490189583*^9, 3.835451530027482*^9}, {
  3.835451615151683*^9, 
  3.835451621258112*^9}},ExpressionUUID->"5fca0887-93a3-4da5-9d80-\
ae55e466c448"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"...", "-", 
     RowBox[{
      SuperscriptBox["s", 
       RowBox[{"(", 
        SubscriptBox["p", "2"], ")"}]], "\[CircleTimes]", 
      RowBox[{"-", 
       SuperscriptBox["s", 
        RowBox[{"(", 
         SubscriptBox["p", "1"], ")"}]]}], "\[CircleTimes]", 
      RowBox[{"-", 
       SuperscriptBox["a", 
        RowBox[{"(", 
         RowBox[{"k", "-", "i", "-", "j"}], ")"}]]}], "\[CircleTimes]", 
      RowBox[{"-", 
       SuperscriptBox["s", 
        RowBox[{"(", 
         RowBox[{"j", "-", "i"}], ")"}]]}], "\[CircleTimes]", 
      SuperscriptBox["s", 
       RowBox[{"(", 
        SubscriptBox["r", "1"], ")"}]], "\[CircleTimes]", 
      SuperscriptBox["s", 
       RowBox[{"(", 
        SubscriptBox["r", "2"], ")"}]]}]}], "..."}], "\[CircleTimes]", " ", 
   "d"}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.835451563077919*^9, 
  3.835451622308363*^9}},ExpressionUUID->"735afbb4-70f1-4e56-ab57-\
40f8814e5c72"],

Cell["give us the identity", "ExpositoryText",
 CellChangeTimes->{{3.835451623570298*^9, 
  3.835451629699626*^9}},ExpressionUUID->"ed9cff76-b6d7-4918-ab5b-\
7ecc49aaf4fe"],

Cell["\<\
By then tracking which selection rules are used from which operators we can \
determine which elements of each operator we need to get the desired results\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8354814875169897`*^9, 3.835481489040782*^9}, {
  3.835481520064434*^9, 
  3.835481563397564*^9}},ExpressionUUID->"4b807f84-873f-4c8f-91b6-\
63df6db94a10"]
}, Closed]],

Cell[CellGroupData[{

Cell["Paper Write-Up", "Subsubsection",
 CellChangeTimes->{{3.84352627300634*^9, 
  3.8435262778595877`*^9}},ExpressionUUID->"8e032959-e17c-4d0a-831a-\
74ef952423b1"],

Cell[TextData[{
 "It is generally the case that we have a property or set of properties that \
we are interested in evaluating. If that is the case we can potentially \
reduce the number of terms we need to evaluate and store. To understand how \
this works, we can note that the evaluation of properties between some \
initial state, ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],ExpressionUUID->
  "473cdd11-9ee3-4f35-a4ff-bf01961bf5d9"],
 " and a given other state, ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "d7e22fc8-5d85-4b57-a50b-9ba7d3d313cc"],
 ", in perturbation theory looks like"
}], "ExpositoryText",
 CellChangeTimes->{{3.843526282032372*^9, 3.843526351386642*^9}, {
  3.843526391779344*^9, 
  3.843526414359599*^9}},ExpressionUUID->"ac718361-bc58-46aa-bf3d-\
8a58b972a132"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{"g"},
        "Bra"], "A", 
       TemplateBox[{"n"},
        "Ket"]}], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "0"}], "N"], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          TemplateBox[{"g"},
           "Bra"], "A", 
          TemplateBox[{"n"},
           "Ket"]}], ")"}], 
        RowBox[{"(", "k", ")"}]]}]}]},
    {
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         TemplateBox[{"g"},
          "Bra"], "A", 
         TemplateBox[{"n"},
          "Ket"]}], ")"}], 
       RowBox[{"(", "k", ")"}]], "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "k"], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], 
         RowBox[{"k", "-", "i"}]], " ", 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["g", 
            RowBox[{"(", "i", ")"}]]},
          "Bra"], 
         SuperscriptBox["A", 
          RowBox[{"(", 
           RowBox[{"k", "-", "i", "-", "j"}], ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "j", ")"}]]},
          "Ket"]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8353506937114277`*^9, 3.835350723910287*^9}, {
  3.835350786111107*^9, 3.83535080499762*^9}, {3.835350845117962*^9, 
  3.835350849597204*^9}, {3.835350915473649*^9, 3.835350957733308*^9}, {
  3.835350999096417*^9, 3.835351019300487*^9}, {3.843526364829496*^9, 
  3.843526389642364*^9}},ExpressionUUID->"d7c5e4c6-9039-4ce2-9cc9-\
e6aa663d94fd"],

Cell[TextData[{
 "and to evaluate a given term in this expansion we only ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "j", ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.8353506937114277`*^9, 3.835350723910287*^9}, {
   3.835350786111107*^9, 3.83535080499762*^9}, {3.835350845117962*^9, 
   3.835350849597204*^9}, {3.835350915473649*^9, 3.835350957733308*^9}, {
   3.835350999096417*^9, 3.835351019300487*^9}, {3.843526364829496*^9, 
   3.843526389642364*^9}},ExpressionUUID->
  "a958d714-fab3-499a-91ad-7c56f1762246"],
 " to support terms connected to ",
 Cell[BoxData[
  TemplateBox[{
    SuperscriptBox["g", 
     RowBox[{"(", "i", ")"}]]},
   "Bra"]],
  CellChangeTimes->{{3.8353506937114277`*^9, 3.835350723910287*^9}, {
   3.835350786111107*^9, 3.83535080499762*^9}, {3.835350845117962*^9, 
   3.835350849597204*^9}, {3.835350915473649*^9, 3.835350957733308*^9}, {
   3.835350999096417*^9, 3.835351019300487*^9}, {3.843526364829496*^9, 
   3.843526389642364*^9}},ExpressionUUID->
  "626eb6e1-fae4-48cf-bd02-2ac2541e64d3"],
 " through the action of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", 
    RowBox[{"(", 
     RowBox[{"k", "-", "i", "-", "j"}], ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.8353506937114277`*^9, 3.835350723910287*^9}, {
   3.835350786111107*^9, 3.83535080499762*^9}, {3.835350845117962*^9, 
   3.835350849597204*^9}, {3.835350915473649*^9, 3.835350957733308*^9}, {
   3.835350999096417*^9, 3.835351019300487*^9}, {3.843526364829496*^9, 
   3.843526389642364*^9}},ExpressionUUID->
  "2ae033b1-2654-4aa0-a0ab-80d4adab4ed6"],
 ". Focusing initially on the case that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "=", "N"}], TraditionalForm]],ExpressionUUID->
  "44940016-6465-4e7e-a55c-bbb7caff224e"],
 ", we have "
}], "ExpositoryText",
 CellChangeTimes->{{3.843526423241584*^9, 
  3.843526576404213*^9}},ExpressionUUID->"93ea4166-d654-485a-81de-\
61a63f8a0f08"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      TemplateBox[{"g"},
       "Bra"], "A", 
      TemplateBox[{"n"},
       "Ket"]}], ")"}], 
    RowBox[{"(", "N", ")"}]], "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], "N"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "0"}], 
      RowBox[{"N", "-", "i"}]], " ", 
     RowBox[{
      TemplateBox[{
        SuperscriptBox["g", 
         RowBox[{"(", "i", ")"}]]},
       "Bra"], 
      SuperscriptBox["A", 
       RowBox[{"(", 
        RowBox[{"N", "-", "i", "-", "j"}], ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "j", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8435265890419397`*^9, 3.843526601627317*^9}, {
  3.8435282679773417`*^9, 3.843528268668627*^9}, {3.843528305394595*^9, 
  3.843528333390622*^9}, {3.8435655640289907`*^9, 
  3.84356556505062*^9}},ExpressionUUID->"6b19fc8c-01f9-429e-98fa-\
0863dfe5bb98"],

Cell[TextData[{
 "for each of these terms, then, the most efficient evaluation strategy will \
be to consider whether ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", " ", ">", " ", "j"}], TraditionalForm]],ExpressionUUID->
  "d98a6063-2ef9-4b6c-8c30-5ad6996b4c56"],
 " and then supposing ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", " ", ">", " ", "j"}], TraditionalForm]],ExpressionUUID->
  "5486fc9e-7164-4a4c-925a-c91ecdda3679"],
 " to look at the state space connected to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", 
     RowBox[{"(", 
      RowBox[{"N", "-", "i", "-", "j"}], ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "j", ")"}]]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "0dfcaf64-671c-491e-8f46-945c100ed4e9"],
 " and consider its intersection with the state space for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["g", 
      RowBox[{"(", "i", ")"}]]},
    "Bra"], TraditionalForm]],
  CellChangeTimes->{{3.8435265890419397`*^9, 3.843526601627317*^9}, {
    3.8435282679773417`*^9, 3.843528268668627*^9}, {3.843528305394595*^9, 
    3.843528333390622*^9}, {3.8435655640289907`*^9, 3.84356556505062*^9}, 
    3.843566052621257*^9},ExpressionUUID->
  "4828c0ca-90ca-4911-bea2-90e7477efc44"],
 ". It is, however, hard to implement this transformation completely \
generally without reduplicating much of the work already required in the \
perturbation theory calculation. Most of the benefit, too, will come from \
finding a more efficient strategy to evaluate ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "N", ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.8435265890419397`*^9, 3.843526601627317*^9}, {
   3.8435282679773417`*^9, 3.843528268668627*^9}, {3.843528305394595*^9, 
   3.843528333390622*^9}, {3.8435655640289907`*^9, 3.84356556505062*^9}},
  ExpressionUUID->"1d0c6beb-6937-4d6b-9f5b-d5ec9c96016c"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["g", 
      RowBox[{"(", "N", ")"}]]},
    "Bra"], TraditionalForm]],
  CellChangeTimes->{{3.8435265890419397`*^9, 3.843526601627317*^9}, {
   3.8435282679773417`*^9, 3.843528268668627*^9}, {3.843528305394595*^9, 
   3.843528333390622*^9}, {3.8435655640289907`*^9, 3.84356556505062*^9}},
  ExpressionUUID->"7f7154ed-056f-4823-ba29-e698a12c5f84"],
 ", and so we will focus on that. This filter, then, can be constructed most \
easily by looking at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      SuperscriptBox["g", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], 
    SuperscriptBox["A", 
     RowBox[{"(", "0", ")"}]]}], TraditionalForm]],ExpressionUUID->
  "54589824-4f12-408e-88e2-4e9769d568d8"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", 
     RowBox[{"(", "0", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "9876d915-c7a1-468a-92bb-58621726dd4e"],
 ". The state space touched by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "N", ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.8435265890419397`*^9, 3.843526601627317*^9}, {
   3.8435282679773417`*^9, 3.843528268668627*^9}, {3.843528305394595*^9, 
   3.843528333390622*^9}, {3.8435655640289907`*^9, 3.84356556505062*^9}},
  ExpressionUUID->"099b5f72-493b-42a5-bcbb-e76c726abcb8"],
 " need only be intersected with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      SuperscriptBox["g", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], 
    SuperscriptBox["A", 
     RowBox[{"(", "0", ")"}]]}], TraditionalForm]],ExpressionUUID->
  "42595baf-262f-42be-a662-3ab82e033a0b"],
 " and similarly that touched by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["g", 
      RowBox[{"(", "N", ")"}]]},
    "Bra"], TraditionalForm]],
  CellChangeTimes->{{3.8435265890419397`*^9, 3.843526601627317*^9}, {
   3.8435282679773417`*^9, 3.843528268668627*^9}, {3.843528305394595*^9, 
   3.843528333390622*^9}, {3.8435655640289907`*^9, 3.84356556505062*^9}},
  ExpressionUUID->"a2085742-0175-4317-9b2b-f69b2eef7c21"],
 " need only intersect with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", 
     RowBox[{"(", "0", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "1ac9bf0d-c777-4bb7-b0f9-1b810d130257"],
 ". "
}], "ExpositoryText",
 CellChangeTimes->{{3.8435282561409082`*^9, 3.8435282626074543`*^9}, {
  3.843529222965601*^9, 3.843529240005924*^9}, {3.843565578662201*^9, 
  3.843565624923592*^9}, {3.843565737038316*^9, 3.843565776327744*^9}, {
  3.843565810875904*^9, 3.843565842763411*^9}, {3.843565934707116*^9, 
  3.843565969872664*^9}, {3.84356603494335*^9, 3.843566037808572*^9}, {
  3.84356606785026*^9, 3.843566119597581*^9}, {3.843600706639195*^9, 
  3.8436008958554068`*^9}, {3.843600927927312*^9, 
  3.843601088591379*^9}},ExpressionUUID->"0ec47c9a-b9ff-4f15-a943-\
269750e7d2ba"],

Cell[TextData[{
 "A naive implementation of this filter would still require constructing the \
total state space for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "N", ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.8435265890419397`*^9, 3.843526601627317*^9}, {
   3.8435282679773417`*^9, 3.843528268668627*^9}, {3.843528305394595*^9, 
   3.843528333390622*^9}, {3.8435655640289907`*^9, 3.84356556505062*^9}},
  ExpressionUUID->"a36bf336-34c1-4795-a4df-ccb96e4182b5"],
 ", which will become increasingly expensive as the system size increases. To \
mitigate this effect we can pre-filter the state space of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "N", ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.8435265890419397`*^9, 3.843526601627317*^9}, {
   3.8435282679773417`*^9, 3.843528268668627*^9}, {3.843528305394595*^9, 
   3.843528333390622*^9}, {3.8435655640289907`*^9, 3.84356556505062*^9}},
  ExpressionUUID->"5d407301-0b7d-4604-b359-11051b254161"],
 " by looking at the total numbers of quanta in the accessed states. For \
example, let\[CloseCurlyQuote]s assume that ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", 
    RowBox[{"(", "0", ")"}]], TraditionalForm]],ExpressionUUID->
  "a4c2dc2f-083d-416b-b4b3-e187cf42ac0b"],
 " can change the total number of quanta by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", "1"}], TraditionalForm]],ExpressionUUID->
  "fbd20516-ee14-48c0-8d56-f101038a3aae"],
 ". Then let\[CloseCurlyQuote]s suppose that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["g", 
      RowBox[{"(", "0", ")"}]]},
    "Bra"], TraditionalForm]],
  CellChangeTimes->{{3.8435265890419397`*^9, 3.843526601627317*^9}, {
   3.8435282679773417`*^9, 3.843528268668627*^9}, {3.843528305394595*^9, 
   3.843528333390622*^9}, {3.8435655640289907`*^9, 3.84356556505062*^9}},
  ExpressionUUID->"a0b0b798-d97a-4585-9b78-580337f942be"],
 " has 1 total quantum of excitation and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.8435265890419397`*^9, 3.843526601627317*^9}, {
   3.8435282679773417`*^9, 3.843528268668627*^9}, {3.843528305394595*^9, 
   3.843528333390622*^9}, {3.8435655640289907`*^9, 3.84356556505062*^9}},
  ExpressionUUID->"041e865c-5ed5-46ca-80bc-d5ddfa72b68c"],
 " has 2. This means ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      SuperscriptBox["g", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], 
    SuperscriptBox["A", 
     RowBox[{"(", "0", ")"}]]}], TraditionalForm]],ExpressionUUID->
  "834e5fb4-40a6-4bba-83d1-7162845ec6b6"],
 " can have 0 or 2 quanta of excitation and therefore the state spaces \
accessed in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "N", ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.8435265890419397`*^9, 3.843526601627317*^9}, {
   3.8435282679773417`*^9, 3.843528268668627*^9}, {3.843528305394595*^9, 
   3.843528333390622*^9}, {3.8435655640289907`*^9, 3.84356556505062*^9}},
  ExpressionUUID->"8cac74ad-b9b9-4641-a71d-72015cc22c55"],
 " need only have that many quanta as well. This can occur through many \
paths, but the straightforward approach is to note that we have terms that \
look like"
}], "ExpositoryText",
 CellChangeTimes->{{3.8435282561409082`*^9, 3.8435282626074543`*^9}, {
  3.843529222965601*^9, 3.843529240005924*^9}, {3.843565578662201*^9, 
  3.843565624923592*^9}, {3.843565737038316*^9, 3.843565776327744*^9}, {
  3.843565810875904*^9, 3.843565842763411*^9}, {3.843565934707116*^9, 
  3.843565969872664*^9}, {3.84356603494335*^9, 3.843566037808572*^9}, {
  3.84356606785026*^9, 3.843566119597581*^9}, {3.843600706639195*^9, 
  3.8436008958554068`*^9}, {3.84360111530295*^9, 3.8436012760006857`*^9}, {
  3.843601307555938*^9, 3.843601409543913*^9}, {3.843601458062663*^9, 
  3.8436014686352253`*^9}, {3.8436015548932943`*^9, 
  3.843601661668119*^9}},ExpressionUUID->"f9a7fa8b-bdfe-4a9c-83ed-\
255cad7127a3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   UnderscriptBox["\[Sum]", "i"], " ", 
   RowBox[{
    SuperscriptBox["H", 
     RowBox[{"(", 
      RowBox[{"N", "-", "i"}], ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "i", ")"}]]},
     "Ket"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.843601662655137*^9, 
  3.8436016780264387`*^9}},ExpressionUUID->"bfedcfcd-4b08-482b-80ef-\
7bbdd4d34069"],

Cell[TextData[{
 "and so when looking at, e.g., ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", 
         RowBox[{"N", "-", "1"}], ")"}]]},
     "Ket"]}], TraditionalForm]],
  CellChangeTimes->{{3.843601662655137*^9, 3.8436016780264387`*^9}},
  ExpressionUUID->"375567a7-241a-41ae-990a-80b828755ee6"],
 ", we only need to consider when one of the selection rules for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],ExpressionUUID->
  "8559a066-4b65-4a88-8a90-b1f0f029e46c"],
 " will take one of the elements of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", 
        RowBox[{"N", "-", "1"}], ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.843601662655137*^9, 3.8436016780264387`*^9}},
  ExpressionUUID->"594c9159-5433-49e7-a0b4-3cbd6d6fa072"],
 " to a state with 0 or 2 quanta of excitation. "
}], "ExpositoryText",
 CellChangeTimes->{{3.843601694295854*^9, 3.84360178206463*^9}, {
  3.843601823189026*^9, 
  3.84360186357022*^9}},ExpressionUUID->"0e1c5c96-56e2-41d5-bb25-\
eafda0f8013a"],

Cell[TextData[{
 "As a final note, by assuming ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", 
    RowBox[{"(", "0", ")"}]], TraditionalForm]],ExpressionUUID->
  "2420fc22-a345-45c3-a79c-b0c5ed32f34c"],
 " and the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]],ExpressionUUID->
  "c513601b-cdbd-48a6-8f95-97bf0030ca1d"],
 " are Hermitian, we can make use of symmetry to avoid needing to calculate \
most of these elements. This can be implemented as a filter as well, which \
provides even more significant speed ups. As a concrete example,  "
}], "ExpositoryText",
 CellChangeTimes->{{3.843601866392174*^9, 3.843601945357624*^9}, {
  3.8436542698129063`*^9, 
  3.84365427979106*^9}},ExpressionUUID->"a079e0cd-6dda-413d-97f0-\
383b8a883cf2"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Morse Expansions", "Section",
 CellChangeTimes->{{3.843842855265038*^9, 
  3.8438428595225573`*^9}},ExpressionUUID->"4ec19263-d89d-45d6-bddf-\
c0c48205de9a"],

Cell[CellGroupData[{

Cell["\[CapitalDelta]r", "Subsubsection",
 CellChangeTimes->{{3.84384522687325*^9, 
  3.843845227887787*^9}},ExpressionUUID->"63e13159-db33-49c6-9875-\
ff3910325d0e"],

Cell[TextData[{
 "The basic model is a stretch with reduced mass \[Mu] and displacement from \
the equilibrium length ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "r"}], TraditionalForm]],
  ExpressionUUID->"5b88cc4c-7a95-4331-81fc-7de155c11904"],
 ". At the harmonic level, we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.843842880505888*^9, 3.8438428879456387`*^9}, {
  3.843843108304192*^9, 3.8438432103383837`*^9}, {3.843845232267806*^9, 
  3.8438452428374968`*^9}},ExpressionUUID->"e7ffa5cf-6034-4d28-b982-\
b47a701bafac"],

Cell[BoxData[
 FormBox[
  RowBox[{"H", " ", "=", " ", 
   RowBox[{
    FractionBox[
     SuperscriptBox[
      SubscriptBox["p", "r"], "2"], 
     RowBox[{"2", "\[InvisibleSpace]", "\[Mu]"}]], "\[VeryThinSpace] ", "+", 
    " ", 
    RowBox[{
     FractionBox["1", "2"], "\[Mu]", "\[InvisibleSpace]", 
     SuperscriptBox["\[Omega]", "2"], "\[CapitalDelta]", "\[InvisibleSpace]", 
     
     SuperscriptBox["r", "2"]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.843821378221128*^9, 3.8438214118781147`*^9}, 
   3.843821446890491*^9, {3.843821504373465*^9, 3.843821506245597*^9}, {
   3.843821634232997*^9, 3.843821634516283*^9}, {3.843831590146503*^9, 
   3.8438315967471447`*^9}, {3.843842903042485*^9, 3.843842904401773*^9}, {
   3.843843259255282*^9, 
   3.8438432628569803`*^9}},ExpressionUUID->"c282a8f4-b1de-4273-96f9-\
4612eeb8a8f4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dumpTeXString", "@", 
  RowBox[{"PreviousCell", "[", "]"}]}]], "Input",
 CellChangeTimes->{{3.843845358135847*^9, 3.8438453602635517`*^9}},
 CellLabel->
  "In[409]:=",ExpressionUUID->"bc34e3b4-a60e-4ab5-bdde-ca9e80cc1b7a"],

Cell[BoxData["\<\"H=\\\\frac{p_r^2}{2 \\\\mu }+\\\\frac{1}{2} \\\\mu  \
\\\\omega ^2 \\\\Delta  r^2\"\>"], "Output",
 CellChangeTimes->{3.843845360514724*^9},
 CellLabel->
  "Out[409]=",ExpressionUUID->"f03e4c99-3803-4ef0-830b-551d18a93f13"]
}, Open  ]],

Cell["which can be put in dimensionless coordinates by defining", \
"ExpositoryText",
 CellChangeTimes->{{3.843843215386324*^9, 
  3.843843231769331*^9}},ExpressionUUID->"08846e07-ace3-4320-b4a4-\
622a3346f930"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "r"}], " ", "=", 
      RowBox[{
       SqrtBox[
        RowBox[{
         RowBox[{
         "\[HBar]", "\[VeryThinSpace]", "/", "\[VeryThinSpace]", "\[Mu]"}], "\[InvisibleSpace]\[VeryThinSpace]",
          "\[Omega]"}]], "q"}]}]},
    {
     RowBox[{
      SubscriptBox["p", 
       RowBox[{"r", " "}]], "=", " ", 
      RowBox[{
       SqrtBox[
        RowBox[{
        "\[HBar]", "\[VeryThinSpace]", "\[Mu]", "\[InvisibleSpace]\[VeryThinSpace]",
          "\[Omega]"}]], "p"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8438214278513737`*^9, 3.843821458602132*^9}, {
   3.843821495151037*^9, 3.843821500172182*^9}, {3.843821553526743*^9, 
   3.843821580158883*^9}, {3.843842897843807*^9, 3.8438429401086617`*^9}, {
   3.843843685153419*^9, 3.843843715901634*^9}, 
   3.843845249281849*^9},ExpressionUUID->"df11648e-eaa0-49a7-b8dd-\
1cd3e2bb2cdb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dumpTeXString", "@", 
  RowBox[{"PreviousCell", "[", "]"}]}]], "Input",
 CellChangeTimes->{{3.843845358135847*^9, 3.8438453602635517`*^9}},
 CellLabel->
  "In[410]:=",ExpressionUUID->"7a7cc8bc-0fba-47d2-8ba9-9a2a86d289ad"],

Cell[BoxData["\<\"\\\\left(\\n\\\\begin{array}{c}\\n \\\\Delta  r=\\\\sqrt{\\\
\\frac{\\\\hbar  \\\\omega }{\\\\mu }} q \\\\\\\\\\n p_r=\\\\sqrt{\\\\hbar  \
\\\\mu  \\\\omega } p \\\\\\\\\\n\\\\end{array}\\n\\\\right)\"\>"], "Output",
 CellChangeTimes->{3.843845364959613*^9},
 CellLabel->
  "Out[410]=",ExpressionUUID->"986442ce-4b03-43c3-92ec-62ec1d91bcb1"]
}, Open  ]],

Cell["which gives the form", "ExpositoryText",
 CellChangeTimes->{{3.843843243032105*^9, 
  3.843843246115959*^9}},ExpressionUUID->"a168750a-3a42-4261-83ba-\
70518be05c7a"],

Cell[BoxData[
 FormBox[
  RowBox[{"H", " ", "=", " ", 
   RowBox[{
    FractionBox["\[HBar]\[Omega]", 
     RowBox[{"2", "\[InvisibleSpace]"}]], "\[VeryThinSpace]", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["p", "2"], " ", "+", " ", 
      SuperscriptBox["q", "2"]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.843843250797225*^9, 3.8438432565921097`*^9}, {
  3.843843655760521*^9, 3.843843670757403*^9}, {3.843843707319811*^9, 
  3.843843708930064*^9}},ExpressionUUID->"f3da81d4-a370-4439-8bad-\
03e70a775522"],

Cell["\<\
We can then do the same to a series expansion of the Morse oscillator, with \
the Hamiltonian\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8438217394428587`*^9, 3.843821750573038*^9}, {
  3.8438221022503853`*^9, 3.8438221098044357`*^9}, {3.843843808687024*^9, 
  3.843843832251568*^9}},ExpressionUUID->"e30c06a3-259f-4a2f-a398-\
a7327a41a877"],

Cell[BoxData[
 FormBox[
  RowBox[{"H", " ", "=", " ", 
   RowBox[{
    FractionBox[
     SuperscriptBox[
      SubscriptBox["p", "r"], "2"], 
     RowBox[{"2", "\[InvisibleSpace]", "\[Mu]"}]], "\[VeryThinSpace] ", "+", 
    " ", 
    SuperscriptBox[
     RowBox[{
      SubscriptBox["D", "e"], "(", 
      RowBox[{"1", "-", 
       SuperscriptBox["e", 
        RowBox[{
         RowBox[{"-", "\[Alpha]"}], "\[VeryThinSpace]", "\[CapitalDelta]", 
         "\[InvisibleSpace]", "r"}]]}], ")"}], "2"]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.843821378221128*^9, 3.8438214118781147`*^9}, 
   3.843821446890491*^9, {3.843821504373465*^9, 3.843821506245597*^9}, {
