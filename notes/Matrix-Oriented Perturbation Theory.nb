Cell[TextData[{
 "but I know the relevant parameter is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", " ", "+", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"a", "\[Minus]", "b", "+", "1"}], ")"}], "/", "2"}]}], 
   TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "38beeb71-70b5-4b8d-a40d-a597c00b1d75"],
 "...so letting ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Eta]", " ", "=", " ", 
    RowBox[{"z", " ", "\[Minus]", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", "\[Minus]", "b", "+", "1"}], ")"}], "/", "2"}]}]}], 
   TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "1265432d-e028-4df3-ac55-3f2e2afb72a3"],
 " and for notation letting ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"a", "\[Minus]", "b", "+", "1"}], ")"}], "/", "2", " "}]}], 
   TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "bf2161ef-87b1-4f7a-9676-76c42b6773b9"]
}], "ExpositoryText",
