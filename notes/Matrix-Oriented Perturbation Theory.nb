   3.8269862579001417`*^9}},ExpressionUUID->"e0be8971-2935-4c09-abdf-\
21d95724861d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Rho]", "n"], "=", 
   RowBox[{
    RowBox[{
     UnderscriptBox["max", "i"], " ", 
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["a", 
         RowBox[{"n", "\[InvisibleSpace]", "n"}]], "-", 
        SubscriptBox["a", 
         RowBox[{"i", "\[InvisibleSpace]", "i"}]]}], ")"}], 
      "\[RightBracketingBar]"}]}], "+", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"j", "\[NotEqual]", "i"}]], "\[VeryThinSpace]", 
     RowBox[{"\[LeftBracketingBar]", 
      SubscriptBox["a", 
       RowBox[{"i", "\[VeryThinSpace]", "j"}]], 
      "\[RightBracketingBar]"}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826986225263941*^9, 3.826986278239347*^9}, {
  3.8269863086841803`*^9, 3.8269863749654427`*^9}, {3.826986431307325*^9, 
  3.826986466473649*^9}},ExpressionUUID->"2a7b1e26-da9b-407c-bece-\
f843f2320784"],

Cell["at its strongest, this theorem gives us the bound", "ExpositoryText",
 CellChangeTimes->{{3.826986391005958*^9, 
  3.82698640001443*^9}},ExpressionUUID->"76b260b9-156a-465d-aeab-\
b838dd217b17"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Rho]", "n"], "=", " ", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{"j", "\[NotEqual]", "n"}]], "\[VeryThinSpace]", 
    RowBox[{"\[LeftBracketingBar]", 
     SubscriptBox["a", 
      RowBox[{"n", "\[VeryThinSpace]", "j"}]], "\[RightBracketingBar]"}]}]}], 
