        SuperscriptBox["n", 
         RowBox[{"(", "k", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8257897011283207`*^9, 3.825789776212631*^9}, {
   3.825792567706643*^9, 3.825792571864249*^9}, {3.825792610125415*^9, 
