  3.826983606988861*^9}},ExpressionUUID->"485a3394-e283-4546-96b8-\
9ff6b287e81c"],

Cell[TextData[{
 "we will assume, because the converse would not require a nearly-degenerate \
approach, that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"], "\[Element]", 
    SuperscriptBox["D", 
     RowBox[{"(", "\[Beta]", ")"}]]}], TraditionalForm]],
  CellChangeTimes->{{3.826916052010932*^9, 3.8269160711669817`*^9}, {
   3.826916185485743*^9, 3.8269161973464937`*^9}, {3.826916248866921*^9, 
   3.826916325374021*^9}, {3.82691637185133*^9, 3.826916423923917*^9}, {
   3.826916485510365*^9, 3.8269165258696547`*^9}, {3.826916688357238*^9, 
   3.8269166915397243`*^9}, {3.826916746524897*^9, 3.826916754770892*^9}, {
   3.826980114555484*^9, 3.8269801156371593`*^9}, {3.826983596515585*^9, 
   3.826983606988861*^9}},ExpressionUUID->
  "9d5a8265-a300-43ec-a005-22027b4d76bf"],
 "."
}], "ExpositoryText",
