Cell[BoxData[
 RowBox[{
  RowBox[{"diagonalLatticePaths", "[", "n_", "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Accumulate", "/@", 
      RowBox[{"Tuples", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], ",", " ", "n"}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}], "==", "0"}], "&"}]}], "]"}], "//", 
   
   RowBox[{
    RowBox[{"Transpose", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", " ", "n"}], "]"}], ",", " ", 
          RowBox[{"Length", "@", "#"}]}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Join", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Length", "@", "#"}], ",", " ", "1"}], "}"}]}], "]"}], 
          ",", "\[IndentingNewLine]", "#", ",", "\[IndentingNewLine]", "2"}], 
         "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "1", ",", " ", "2"}], "}"}]}], 
     "\[IndentingNewLine]", "]"}], "&"}]}]}]], "Input",
 CellChangeTimes->{{3.8888580482896557`*^9, 3.8888582267986794`*^9}, {
  3.8888584693130283`*^9, 3.888858501178054*^9}, {3.888858535250719*^9, 
  3.888858561246132*^9}, {3.8888585978888283`*^9, 3.888858615655882*^9}},
 CellLabel->
  "In[495]:=",ExpressionUUID->"9df4f1d3-85c0-4eba-82cd-fc708ca0cfdc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"highlightBlock", "[", 
   RowBox[{"n_", ",", " ", "split_", ",", " ", "value_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"paths", "=", 
      RowBox[{"diagonalLatticePaths", "[", 
       RowBox[{"2", "*", "n"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Graphics", "[", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Line", "@", "paths"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{"Thick", ",", "\[IndentingNewLine]", 
         RowBox[{"Hue", "[", 
          RowBox[{"0", ",", " ", "1", ",", " ", ".9"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Line", "@", 
          RowBox[{"Pick", "[", 
           RowBox[{"paths", ",", " ", 
            RowBox[{"paths", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", " ", 
               RowBox[{"split", "+", "1"}], ",", " ", "2"}], "]"}], "]"}], 
            ",", " ", "value"}], "]"}]}]}], "\[IndentingNewLine]", "}"}]}], 
      "\[IndentingNewLine]", "}"}], "]"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.888858811830529*^9, 3.888858874055808*^9}, {
  3.888859821663793*^9, 3.888859822651647*^9}},
 CellLabel->
  "In[594]:=",ExpressionUUID->"f1af3c0c-acd5-4715-a567-0c4212071bf2"],

