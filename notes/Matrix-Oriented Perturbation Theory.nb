Cell[CellGroupData[{

Cell["Tensor Operations", "Section",
 CellChangeTimes->{{3.770001525637146*^9, 
  3.770001528772377*^9}},ExpressionUUID->"66f34734-263b-4037-8941-\
b05da12bccfc"],

Cell[CellGroupData[{

Cell["Tensor Addition and Scalar Tensor Multiplication", "Subsection",
 CellChangeTimes->{{3.769991063588567*^9, 
  3.769991085668191*^9}},ExpressionUUID->"561bd692-dde5-445e-8471-\
fd8dbeccf831"],

Cell["\<\
These two operations will be defined elementwise, that is to say\
\>", "Text",
 CellChangeTimes->{{3.7699910787562304`*^9, 
  3.7699910927560863`*^9}},ExpressionUUID->"afbc3699-755e-44bc-a4db-\
670a472250c3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Given", " ", 
    StyleBox["A",
     FontWeight->"Bold"]}], ",", " ", 
   RowBox[{
    StyleBox["B",
     FontWeight->"Bold"], " ", "tensors"}], ",", " ", 
   RowBox[{
    StyleBox["c",
     FontSlant->"Italic"], " ", "a", " ", "scalar"}], ","}], 
  TraditionalForm]], "ExpositoryMath",
 CellChangeTimes->{{3.7699910950222273`*^9, 3.769991127491581*^9}, {
   3.769991179652369*^9, 3.769991187594631*^9}, 
   3.792783024437813*^9},ExpressionUUID->"d5f1cc93-173f-4994-a8ca-\
39e0023972e2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox[
     RowBox[{"(", 
      RowBox[{"A", "+", "B"}], ")"}],
     FontWeight->"Plain"], 
    RowBox[{
     SubscriptBox["i", "1"], 
     SubscriptBox["i", "2"], 
     SubscriptBox["i", "3"], 
     SubscriptBox["\[Ellipsis]i", "n"]}]], "=", 
   RowBox[{
    SubscriptBox["A", 
     RowBox[{
      SubscriptBox["i", "1"], 
      SubscriptBox["i", "2"], 
      SubscriptBox["i", "3"], 
      SubscriptBox["\[Ellipsis]i", "n"]}]], "+", 
    SubscriptBox["B", 
     RowBox[{
      SubscriptBox["i", "1"], 
      SubscriptBox["i", "2"], 
      SubscriptBox["i", "3"], 
      SubscriptBox["\[Ellipsis]i", "n"]}]]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.769991130141603*^9, 
  3.7699911713877373`*^9}},ExpressionUUID->"ad612606-0e06-4fef-80cc-\
69255e30742e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox[
     RowBox[{"(", "cA", ")"}],
     FontWeight->"Plain"], 
    RowBox[{
     SubscriptBox["i", "1"], 
     SubscriptBox["i", "2"], 
     SubscriptBox["i", "3"], 
     SubscriptBox["\[Ellipsis]i", "n"]}]], "=", 
   RowBox[{"c", "*", 
    SubscriptBox["A", 
     RowBox[{
      SubscriptBox["i", "1"], 
      SubscriptBox["i", "2"], 
      SubscriptBox["i", "3"], 
      SubscriptBox["\[Ellipsis]i", "n"]}]]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.7699911958051577`*^9, 3.7699912110021257`*^9}, 
   3.7927830353245163`*^9},ExpressionUUID->"d6b1eae2-4a49-4a17-ae54-\
9c080aaf7324"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Or", " ", "extending", " ", "this", " ", "a", " ", "bit"}], ",", 
   " ", 
   RowBox[{"given", " ", 
    StyleBox["A",
     FontWeight->"Bold"]}], ",", " ", 
   RowBox[{
    StyleBox["B",
     FontWeight->"Bold"], " ", "tensors"}], ",", " ", 
   StyleBox["c",
    FontSlant->"Italic"], 
   StyleBox[",",
    FontSlant->"Italic"], 
   StyleBox[" ",
    FontSlant->"Italic"], 
   RowBox[{
    StyleBox["d",
     FontSlant->"Italic"], " ", "scalars"}], ","}], 
  TraditionalForm]], "ExpositoryMath",
 CellChangeTimes->{{3.769991850913966*^9, 3.7699918788394957`*^9}, 
   3.792783028492309*^9},ExpressionUUID->"39593a3a-8138-4c41-b4f5-\
b79c1a7d3b1b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox[
     RowBox[{"(", 
      RowBox[{"cA", "+", "dB"}], ")"}],
     FontWeight->"Plain"], 
    RowBox[{
     SubscriptBox["i", "1"], 
     SubscriptBox["i", "2"], 
     SubscriptBox["i", "3"], 
     SubscriptBox["\[Ellipsis]i", "n"]}]], "=", 
   RowBox[{
    SubscriptBox["cA", 
     RowBox[{
      SubscriptBox["i", "1"], 
      SubscriptBox["i", "2"], 
      SubscriptBox["i", "3"], 
      SubscriptBox["\[Ellipsis]i", "n"]}]], "+", 
    SubscriptBox["dB", 
     RowBox[{
      SubscriptBox["i", "1"], 
      SubscriptBox["i", "2"], 
      SubscriptBox["i", "3"], 
      SubscriptBox["\[Ellipsis]i", "n"]}]]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.769991867082386*^9, 3.76999186801014*^9}, {
  3.7699919232956877`*^9, 
  3.769991932142274*^9}},ExpressionUUID->"437282d4-b77d-40ba-b4dc-\
eba407fed297"],

Cell["This has a few important ramifications, namely", "Text",
 CellChangeTimes->{{3.7699912316477423`*^9, 
  3.769991260999844*^9}},ExpressionUUID->"91fba994-7c3b-4de9-87d2-\
1da67a808434"],

Cell["\<\
Tensors can only be added if all of their dimensions are aligned\
\>", "Subitem",
 CellChangeTimes->{{3.76999126384658*^9, 
  3.769991283142704*^9}},ExpressionUUID->"b436771a-ab5d-46d8-b665-\
72a6660db300"],

Cell["\<\
Tensor scalar multiplication and tensor addition do not change the overall \
dimension of the tensor\
\>", "Subitem",
 CellChangeTimes->{{3.76999126384658*^9, 3.769991309886539*^9}, {
  3.769991813826939*^9, 
  3.7699918138276863`*^9}},ExpressionUUID->"8535c7fc-21d9-40bc-9063-\
74815136234e"],

Cell["\<\
Tensor scalar multiplication distributes over tensor addition\
\>", "Subitem",
 CellChangeTimes->{{3.769991952851632*^9, 
  3.7699919674026613`*^9}},ExpressionUUID->"a8c9be06-a50b-478b-b68e-\
79a679459252"],

Cell["\<\
Tensor scalar multiplication and tensor addition can be used to form vector \
spaces of tensors\
\>", "Subitem",
 CellChangeTimes->{{3.76999126384658*^9, 3.769991309886539*^9}, {
  3.769991815261986*^9, 3.76999182720645*^9}, {3.769991881998673*^9, 
  3.769991906932213*^9}, {3.7699922718783627`*^9, 
  3.769992271878892*^9}},ExpressionUUID->"b9fe6216-d722-4191-b4ac-\
141e93d7cff1"],

Cell["\<\
All linear operators (e.g. derivatives) will distribute and act normally with \
the scalar multiplications\
\>", "Subitem",
 CellChangeTimes->{{3.76999126384658*^9, 3.769991309886539*^9}, {
  3.769991815261986*^9, 3.76999182720645*^9}, {3.769991881998673*^9, 
  3.769991906932213*^9}, {3.769992274408485*^9, 
  3.7699923083115797`*^9}},ExpressionUUID->"0378758a-1723-4fbd-9902-\
d91a7a84e129"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tensor Transposition", "Subsection",
 CellChangeTimes->{{3.792783008436879*^9, 3.7927830112776012`*^9}, {
  3.792783101324688*^9, 
  3.792783104771769*^9}},ExpressionUUID->"ce45645a-7ea7-4dd7-adc7-\
c59fb885a3d6"],

Cell["\<\
This operations is the analog of the matrix transpose in that it changes the \
way indexing works in a tensor\
\>", "Text",
 CellChangeTimes->{{3.7699910787562304`*^9, 3.7699910927560863`*^9}, {
  3.792783134505631*^9, 
  3.7927831584410257`*^9}},ExpressionUUID->"e5963773-b693-49c1-91c5-\
59305e1ef61b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Given", " ", "a", " ", "tensor", " ", 
    StyleBox["A",
     FontWeight->"Bold"], " ", "with", " ", "axes", " ", 
    SubscriptBox[
     StyleBox["i",
      FontSlant->"Italic"], "1"]}], ",", " ", 
   SubscriptBox[
    StyleBox["i",
     FontSlant->"Italic"], "2"], ",", " ", 
   RowBox[{"...", " ", 
    SubscriptBox[
     StyleBox["i",
      FontSlant->"Italic"], "N"], " ", "we", " ", "define", " ", "the", " ", 
    "tensor", " ", "transpose", " ", 
    SubscriptBox[
     StyleBox["A",
      FontWeight->"Bold"], 
     RowBox[{"T", "(", 
      RowBox[{"{", 
       SubscriptBox["k", "m"], "}"}], ")"}]], " ", "such", " ", "that"}]}], 
  TraditionalForm]], "ExpositoryMath",
 CellChangeTimes->{{3.7927831596108294`*^9, 3.79278323830443*^9}, {
  3.792783280618908*^9, 3.7927833797965593`*^9}, {3.792855673783864*^9, 
  3.7928556966289663`*^9}, {3.792855732343603*^9, 3.792855732871456*^9}, {
  3.792855966831533*^9, 
  3.792855994352014*^9}},ExpressionUUID->"8a021947-a03b-49b8-9d74-\
fd68d5921e73"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["A", 
     RowBox[{"T", "(", 
      RowBox[{
       SubscriptBox[
        StyleBox["k",
         FontSlant->"Italic"], 
        RowBox[{"\[VeryThinSpace]", "1"}]], ",", " ", 
       SubscriptBox[
        StyleBox[
         RowBox[{"k", "\[VeryThinSpace]"}],
         FontSlant->"Italic"], "2"], ",", "\[Ellipsis]", ",", 
       "\[VeryThinSpace]", 
       SubscriptBox[
        StyleBox["k",
         FontSlant->"Italic"], 
        StyleBox["N",
         FontSlant->"Italic"]]}], ")"}]], " ", "has", " ", "axes", 
    SubscriptBox[
     StyleBox["i",
      FontSlant->"Italic"], 
     SubscriptBox["k", "1"]]}], ",", " ", 
   SubscriptBox[
    StyleBox["i",
     FontSlant->"Italic"], 
    SubscriptBox[
     StyleBox["k",
      FontSlant->"Italic"], "2"]], ",", " ", 
   RowBox[{"...", " ", 
    SubscriptBox[
     StyleBox["i",
      FontSlant->"Italic"], 
     SubscriptBox[
      StyleBox["k",
       FontSlant->"Italic"], 
      StyleBox["N",
       FontSlant->"Italic"]]]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.7927831596108294`*^9, 3.79278323830443*^9}, {
  3.792783280618908*^9, 3.7927833797965593`*^9}, {3.792855673783864*^9, 
  3.7928556966289663`*^9}, {3.792855732343603*^9, 3.792855732871456*^9}, {
  3.792855966831533*^9, 
  3.792855994352014*^9}},ExpressionUUID->"3edc19ce-f8e3-4ad2-af32-\
cc0fd8fbcd9d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     SubscriptBox["A", 
      RowBox[{"T", "(", 
       RowBox[{
        SubscriptBox[
         StyleBox["k",
          FontSlant->"Italic"], 
         RowBox[{"\[VeryThinSpace]", "1"}]], ",", " ", 
        SubscriptBox[
         StyleBox[
          RowBox[{"k", "\[VeryThinSpace]"}],
          FontSlant->"Italic"], "2"], ",", "\[Ellipsis]", ",", 
        "\[VeryThinSpace]", 
        SubscriptBox[
         StyleBox["k",
          FontSlant->"Italic"], 
         StyleBox["N",
          FontSlant->"Italic"]]}], ")"}]], ")"}], 
    RowBox[{
     RowBox[{
      SubscriptBox[
       StyleBox["j",
        FontSlant->"Italic"], 
       RowBox[{"\[VeryThinSpace]", "1"}]], 
      SubscriptBox[
       StyleBox[
        RowBox[{"j", "\[VeryThinSpace]"}],
        FontSlant->"Italic"], "2"], "\[Ellipsis]"}], ",", 
     SubscriptBox[
      StyleBox["j",
       FontSlant->"Italic"], 
      StyleBox["N",
       FontSlant->"Italic"]]}]], "=", 
   SubscriptBox["A", 
    RowBox[{
     SubscriptBox[
      StyleBox["k",
       FontSlant->"Italic"], 
      RowBox[{
       SubscriptBox["j", "1"], "\[InvisibleSpace]"}]], "\[InvisibleSpace]", 
     SubscriptBox["k", 
      SubscriptBox["j", "2"]], "\[Ellipsis]", " ", 
     SubscriptBox["k", 
      SubscriptBox["j", "N"]]}]]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.7927833726490393`*^9, 
  3.7927836369247217`*^9}},ExpressionUUID->"d10fe222-f800-4b39-8671-\
6549103b0b06"],

Cell["\<\
Note that for the case where N = 2 the traditional transpose is\
\>", "Text",
 CellChangeTimes->{{3.792783724090769*^9, 3.79278375020809*^9}, {
  3.792856011666909*^9, 
  3.792856020948662*^9}},ExpressionUUID->"60707540-e64e-4bc7-b0c2-\
0ba2b2a0aa44"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"A", "\[Transpose]"}], "=", 
   SubscriptBox["A", 
    RowBox[{"T", "(", 
     RowBox[{"2", ",", " ", "1"}], ")"}]]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.7928560252121773`*^9, 
  3.792856029012733*^9}},ExpressionUUID->"9ca763b6-475e-461d-ad6d-\
2fa97998ecaf"],

Cell[CellGroupData[{

Cell["Axes Shift", "Subsubsection",
 CellChangeTimes->{{3.792855810016048*^9, 
  3.7928558138074017`*^9}},ExpressionUUID->"9cbd8088-8fc6-444c-81ec-\
c98805249f78"],

Cell["\<\
If we are simply shift one axis to a new position, we define an alternate \
notation for convenience\
\>", "Text",
 CellChangeTimes->{{3.7927844090825653`*^9, 3.792784451761125*^9}, {
   3.7927845049522142`*^9, 3.792784513944119*^9}, {3.792855818454998*^9, 
   3.792855819415881*^9}, 
   3.793223257548923*^9},ExpressionUUID->"6ef2d7ea-2938-49b6-b295-\
f5c69cb7c5e4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Given", " ", "a", " ", "tensor", " ", 
    StyleBox["A",
     FontWeight->"Bold"], " ", "with", " ", "axes", " ", 
    SubscriptBox[
     StyleBox["i",
      FontSlant->"Italic"], "1"]}], ",", " ", 
   SubscriptBox[
    StyleBox["i",
     FontSlant->"Italic"], "2"], ",", " ", 
   RowBox[{"...", " ", 
    SubscriptBox[
     StyleBox["i",
      FontSlant->"Italic"], "N"]}], ",", " ", 
   RowBox[{
    RowBox[{"assuming", " ", "WLOG", " ", "that", " ", "n"}], ">", "m"}]}], 
  TraditionalForm]], "ExpositoryMath",
 CellChangeTimes->{{3.7927845151789227`*^9, 3.7927845197128973`*^9}, {
  3.792784555042465*^9, 
  3.792784590249689*^9}},ExpressionUUID->"3ccf7407-5f03-46e9-a12e-\
53f186fe0ed4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["A", 
    RowBox[{"n", "\[Rule]", "m"}]], "=", 
   SubscriptBox["A", 
    RowBox[{"T", "(", 
     RowBox[{"1", ",", " ", "2", ",", " ", "\[Ellipsis]", ",", " ", 
      RowBox[{"m", "-", "1"}], ",", " ", "n", ",", " ", "m", ",", " ", 
      RowBox[{"m", "+", "1"}], ",", " ", "\[Ellipsis]", ",", " ", 
      RowBox[{"n", "-", "1"}], ",", " ", 
      RowBox[{"n", "+", "1"}], ",", " ", "\[Ellipsis]", ",", " ", "N"}], 
     ")"}]]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.79278375800988*^9, 3.7927838104328203`*^9}, {
  3.7927844684023037`*^9, 3.7927844858257923`*^9}, {3.7927845227201138`*^9, 
  3.792784614633395*^9}, {3.792798190500533*^9, 3.79279819266101*^9}, {
  3.7928550133800297`*^9, 
  3.7928550163083677`*^9}},ExpressionUUID->"722b32e1-c22a-4868-8903-\
b09657609829"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Axes Swap", "Subsubsection",
