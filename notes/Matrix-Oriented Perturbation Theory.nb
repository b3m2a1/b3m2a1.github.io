          SubscriptBox["n", "1"], 
          SubscriptBox["n", "2"], "\[InvisibleSpace]"}]}], 
        RowBox[{
         SubscriptBox["\[Omega]", "3"], "-", 
         SubscriptBox["\[Omega]", "2"], "-", 
         SubscriptBox["\[Omega]", "1"]}]], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["G", "132"], "-", 
          RowBox[{"3", "\[InvisibleSpace]", 
           SubscriptBox["V", "123"]}]}], ")"}], "2"]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       FractionBox[
        RowBox[{
         SubscriptBox["n", "3"], "+", 
         RowBox[{
          SubscriptBox["n", "2"], "\[InvisibleSpace]", 
          SubscriptBox["n", "3"]}], "+", 
         RowBox[{
          SubscriptBox["n", "1"], "\[InvisibleSpace]", 
          SubscriptBox["n", "3"]}], "-", 
         RowBox[{
          SubscriptBox["n", "1"], "\[InvisibleSpace]", 
          SubscriptBox["n", "2"]}]}], 
        RowBox[{
         SubscriptBox["\[Omega]", "1"], "+", 
         SubscriptBox["\[Omega]", "2"], "-", 
         SubscriptBox["\[Omega]", "3"]}]], "4", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[FormalCapitalG]", "132"], "-", 
          RowBox[{"3", "\[InvisibleSpace]", 
           SubscriptBox["V", "123"]}]}], ")"}], "2"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9205740251010313`*^9, 
  3.9205741050878973`*^9}},ExpressionUUID->"62c2d048-22f9-460d-8d10-\
fc3576780089"],

Cell[TextData[{
 "so we get identical contributions to the term above (by the symmetry in ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "24682c09-df6f-4c59-8f51-01b407d94997"],
 ")"
}], "Text",
 CellChangeTimes->{{3.9205741071069393`*^9, 
  3.9205741382180843`*^9}},ExpressionUUID->"960c9863-07e3-4240-8106-\
b246554669fa"],

Cell["So for the final term of this form we have", "ExpositoryText",
