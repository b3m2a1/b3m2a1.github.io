e852ea0d674a"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["F", "D"], "=", 
      RowBox[{
       UnderscriptBox["\[Sum]", "d"], "\[VeryThinSpace]", 
       RowBox[{"\[Delta]", "\[VeryThinSpace]", 
        SubscriptBox["E", "d"], 
        TemplateBox[{
          SuperscriptBox["d", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"], 
        TemplateBox[{
          SuperscriptBox["d", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"]}]}]}]},
    {
     RowBox[{
      OverscriptBox["F", "~"], "=", 
      RowBox[{"\[LeftBracketingBar]", 
       RowBox[{
        SubscriptBox["F", "D"], 
        SubscriptBox["\[CapitalPi]", 
         RowBox[{"D", "\[VeryThinSpace]", "n", "\[VeryThinSpace]"}]], 
        "\[InvisibleSpace]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SuperscriptBox["H", 
            RowBox[{"(", "1", ")"}]], 
           SubscriptBox["\[CapitalPi]", "U"], 
           SuperscriptBox["H", 
            RowBox[{"(", "1", ")"}]]}], "-", 
          SuperscriptBox["H", 
           RowBox[{"(", "2", ")"}]]}], ")"}], 
        TemplateBox[{
          SuperscriptBox["n", 
