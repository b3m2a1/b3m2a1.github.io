Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["P", "D", 
        RowBox[{"(", 
         RowBox[{"a", "+", "1"}], ")"}]], 
       SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
        RowBox[{"(", "a", ")"}]], 
       SubsuperscriptBox["P", "D", 
        RowBox[{"(", "a", ")"}]]}], "=", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["P", "D", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]], 
        SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
         RowBox[{"(", "a", ")"}]], 
        SubsuperscriptBox["P", "D", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]]}], "+", 
       RowBox[{
        SubsuperscriptBox["P", "D", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]], 
        SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
         RowBox[{"(", "a", ")"}]], 
        SubsuperscriptBox["P", "U", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       SubsuperscriptBox["P", "D", 
        RowBox[{"(", 
         RowBox[{"a", "+", "1"}], ")"}]], 
       SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
        RowBox[{"(", "a", ")"}]], 
       SubsuperscriptBox["P", "D", 
        RowBox[{"(", 
         RowBox[{"a", "+", "1"}], ")"}]]}]}]},
    {
     RowBox[{"=", "\[DoubleStruckZero]"}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
