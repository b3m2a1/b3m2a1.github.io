Cell[TextData[{
 "and then there is a well-defined way to provide all of the unique ",
 ButtonBox["lexocographic permutations",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Permutation#Generation_in_\
lexicographic_order"], None},
  ButtonNote->
   "https://en.wikipedia.org/wiki/Permutation#Generation_in_lexicographic_\
order"],
 " of this list."
}], "ExpositoryText",
