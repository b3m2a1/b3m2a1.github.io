Cell["and this is cleanly solvable by saying", "ExpositoryText",
 CellChangeTimes->{{3.8213257319098043`*^9, 
  3.8213257595122747`*^9}},ExpressionUUID->"3cca8b82-4127-43f5-8822-\
fb77dcdb78b2"],

