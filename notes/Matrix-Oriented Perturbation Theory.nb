       RowBox[{"j", "=", "2"}], 
       RowBox[{
        RowBox[{"\[LeftBracketingBar]", "r", "\[RightBracketingBar]"}], "-", 
        "1"}]], 
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["m", 
