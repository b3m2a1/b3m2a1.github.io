        RowBox[{"(", "1", ")"}]], 
       SubscriptBox["P", "U"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", 
            RowBox[{"k", "-", "1"}], ")"}]]},
        "Ket"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8213213385136538`*^9, 3.821321369519685*^9}, {
  3.821321563284273*^9, 3.821321564963087*^9}, {3.821321799812477*^9, 
  3.821321804073807*^9}, {3.82132751684172*^9, 3.821327525234219*^9}, {
  3.821327568444825*^9, 
  3.821327780439063*^9}},ExpressionUUID->"e5b67a20-fc66-4d36-9751-\
9f2745f751d4"],

Cell["\<\
and so we end up with an even more restricted summation than in the \
non-degenerate case\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8213215663817673`*^9, 3.821321582257769*^9}, {
  3.82132778467317*^9, 
  3.8213277856396713`*^9}},ExpressionUUID->"6c404e3f-d18f-46e8-9ac5-\
7fa4b55b153c"],

Cell[BoxData[
 FormBox[
  RowBox[{" ", 
   RowBox[{
    RowBox[{
     SuperscriptBox["E", 
      RowBox[{"(", "k", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     SubscriptBox["P", "D"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], "=", 
    RowBox[{
     RowBox[{
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]]},
       "Bra"], 
      SubscriptBox["P", "D"], 
      SuperscriptBox["H", 
       RowBox[{"(", "k", ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]]},
       "Ket"]}], "+", 
     RowBox[{
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]]},
       "Bra"], " ", 
      SubscriptBox["P", "D"], 
      SuperscriptBox["H", 
       RowBox[{"(", "1", ")"}]], 
      SubscriptBox["P", "U"], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", 
           RowBox[{"k", "-", "1"}], ")"}]]},
       "Ket"]}], "+", " ", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}], 
       RowBox[{"k", "-", "2"}]], " ", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], 
       SubscriptBox["P", "D"], 
       SuperscriptBox["H", 
        RowBox[{"(", 
         RowBox[{"k", "-", "i"}], ")"}]]}]}], "-", 
     RowBox[{
      SuperscriptBox["E", 
       RowBox[{"(", 
        RowBox[{"k", "-", "i"}], ")"}]], 
      SubscriptBox["P", "D"], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821321585823433*^9, 3.821321593194696*^9}, 
   3.8213218533935432`*^9, {3.821327790650297*^9, 
   3.821327798708324*^9}},ExpressionUUID->"2ce19f46-6f1f-456b-bbd2-\
47c948c1efc1"],

Cell[TextData[{
 "where we will assume (this will be justified later) that we have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "U"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", 
         RowBox[{"k", "-", "1"}], ")"}]]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "d268a285-be90-42ca-b994-022764b4d62c"],
 "."
}], "ExpositoryText",
 CellChangeTimes->{{3.821327801421352*^9, 
  3.82132782107909*^9}},ExpressionUUID->"94027580-b60a-4c53-ac0b-\
f246457e5601"],

Cell[TextData[{
 "Now we can make use of the fact that when we solved for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "fe5acf20-18dc-42c5-b962-50ccf02e2bfc"],
 " we did so by diagonalizing a matrix in the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "D"], TraditionalForm]],ExpressionUUID->
  "aed979c9-8e16-4367-9c59-90536164874d"],
 " subspace, and so we can choose ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.821321585823433*^9, 3.821321593194696*^9}},
  ExpressionUUID->"80c2a096-9f92-44ae-867f-b9e0d386d642"],
 " to be normalized, giving us"
}], "ExpositoryText",
 CellChangeTimes->{{3.821321595704479*^9, 3.821321635372553*^9}, {
  3.821321740765283*^9, 3.8213217582578907`*^9}, {3.8213218609993143`*^9, 
  3.821321861148073*^9}, {3.821327825071312*^9, 
  3.82132782882795*^9}},ExpressionUUID->"9fe460d8-b30c-43bd-ad3b-\
fa4d3e51c2e9"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], 
       SubscriptBox["P", "D"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], "=", "1"}]},
    {
     RowBox[{
      SuperscriptBox["E", 
       RowBox[{"(", "k", ")"}]], "=", 
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], 
        SubscriptBox["P", "D"], 
        SuperscriptBox["H", 
         RowBox[{"(", "k", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], " ", 
        SubscriptBox["P", "D"], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["P", "U"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", 
             RowBox[{"k", "-", "1"}], ")"}]]},
         "Ket"]}], "+", " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], 
         RowBox[{"k", "-", "2"}]], " ", 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], 
         SubscriptBox["P", "D"], 
         SuperscriptBox["H", 
          RowBox[{"(", 
           RowBox[{"k", "-", "i"}], ")"}]]}]}], "-", 
       RowBox[{
        SuperscriptBox["E", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], 
        SubscriptBox["P", "D"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "i", ")"}]]},
         "Ket"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821321759222794*^9, 3.821321759856933*^9}, {
   3.821327841773033*^9, 3.821327873058365*^9}, 
   3.821362264603754*^9},ExpressionUUID->"3980ff06-aa7b-4a5d-8d48-\
f1b24376134c"],

Cell[TextData[{
 "Great! We\[CloseCurlyQuote]ve recovered ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "898ab5ef-372e-4a4f-93df-a4a7504dbc05"],
 "-order energy. Now we need to get ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "D"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", 
         RowBox[{"k", "-", "1"}], ")"}]]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "3c339b7c-86ea-4ea5-8ec1-626b948a1005"],
 ". To do that, again, we\[CloseCurlyQuote]ll return to"
}], "ExpositoryText",
 CellChangeTimes->{{3.821321863818966*^9, 3.821321894926474*^9}, {
  3.821321935166988*^9, 
  3.8213219713854027`*^9}},ExpressionUUID->"2ae4b2d5-d935-4f20-b388-\
dbbdd1806466"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], 
     RowBox[{"k", "-", "1"}]], " ", 
    RowBox[{
     SubscriptBox["P", "D"], 
     SuperscriptBox["H", 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "i", ")"}]]},
      "Ket"]}]}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], 
     RowBox[{"k", "-", "1"}]], " ", " ", 
    RowBox[{
     SubscriptBox["P", "D"], 
     SuperscriptBox["E", 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "i", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821321972974929*^9, 
  3.821321973574966*^9}},ExpressionUUID->"923501a2-9411-47d6-b5d5-\
913df200f63a"],

Cell["\<\
and now that we can evaluate the entirety of the RHS, we can happily write\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8213219766056767`*^9, 3.821321993935658*^9}, {
  3.8213222092368927`*^9, 
  3.821322239623609*^9}},ExpressionUUID->"f05cd15e-08e5-4c70-9452-\
c0f0f2ac3767"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["P", "D"], "(", 
     RowBox[{
      SuperscriptBox["H", 
       RowBox[{"(", "1", ")"}]], "-", 
      SuperscriptBox["E", 
       RowBox[{"(", "1", ")"}]]}], ")"}], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", 
         RowBox[{"k", "-", "1"}], ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], 
     RowBox[{"k", "-", "2"}]], " ", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["P", "D"], "(", 
      RowBox[{
       SuperscriptBox["E", 
        RowBox[{"(", 
         RowBox[{"k", "-", "i"}], ")"}]], "-", 
       SuperscriptBox["H", 
        RowBox[{"(", 
         RowBox[{"k", "-", "i"}], ")"}]]}], ")"}], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "i", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.82132199795636*^9, 3.821321999053988*^9}, {
   3.821322220564632*^9, 3.8213222601820393`*^9}, {3.82132246345463*^9, 
   3.821322468512847*^9}, {3.8213225029778*^9, 3.821322510379245*^9}, 
   3.821322541689335*^9},ExpressionUUID->"0ec50368-8d37-45ca-ad74-\
c238173610a3"],

Cell["\<\
which, I will not lie, doesn\[CloseCurlyQuote]t look too promising. But we\
\[CloseCurlyQuote]ll add in the identity again to give us\
\>", "ExpositoryText",
 CellChangeTimes->{{3.821322301112916*^9, 
  3.8213223333963223`*^9}},ExpressionUUID->"4332c73c-7110-49dd-8f9b-\
efdf8cae97d9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["P", "D"], "(", 
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]], "-", 
       SuperscriptBox["E", 
        RowBox[{"(", "1", ")"}]]}], ")"}], 
     SubscriptBox["P", "D"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", 
          RowBox[{"k", "-", "1"}], ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["P", "D"], "(", 
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]], "-", 
       SuperscriptBox["E", 
        RowBox[{"(", "1", ")"}]]}], ")"}], 
     SubscriptBox["P", "U"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", 
          RowBox[{"k", "-", "1"}], ")"}]]},
      "Ket"]}]}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], 
     RowBox[{"k", "-", "2"}]], " ", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["P", "D"], "(", 
      RowBox[{
       SuperscriptBox["E", 
        RowBox[{"(", 
         RowBox[{"k", "-", "i"}], ")"}]], "-", 
       SuperscriptBox["H", 
        RowBox[{"(", 
         RowBox[{"k", "-", "i"}], ")"}]]}], ")"}], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "i", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821322320792897*^9, 3.821322366587291*^9}, {
  3.8213225313504753`*^9, 3.8213225363881702`*^9}, {3.821322572251033*^9, 
  3.821322585196526*^9}},ExpressionUUID->"6a32a5ac-209a-43ec-9301-\
306cb4b732af"],

Cell[TextData[{
 "and so now if we can evaluate ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "U"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", 
         RowBox[{"k", "-", "1"}], ")"}]]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "76db4a95-6640-43b5-a993-c4fade34a790"],
 " we can write"
}], "ExpositoryText",
 CellChangeTimes->{{3.821322369047887*^9, 
  3.8213223861191473`*^9}},ExpressionUUID->"9b1c18cb-ef13-4bb3-b24b-\
ed094dd9fba8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["P", "D"], "(", 
     RowBox[{
      SuperscriptBox["H", 
       RowBox[{"(", "1", ")"}]], "-", 
      SuperscriptBox["E", 
       RowBox[{"(", "1", ")"}]]}], ")"}], 
    SubscriptBox["P", "D"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", 
         RowBox[{"k", "-", "1"}], ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], 
      RowBox[{"k", "-", "2"}]], " ", " ", 
     RowBox[{
      RowBox[{
       SubscriptBox["P", "D"], "(", 
       RowBox[{
        SuperscriptBox["E", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], "-", 
        SuperscriptBox["H", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]]}], ")"}], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}], "-", 
    RowBox[{
     RowBox[{
      SubscriptBox["P", "D"], "(", 
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]], "-", 
       SuperscriptBox["E", 
        RowBox[{"(", "1", ")"}]]}], ")"}], 
     SubscriptBox["P", "U"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", 
          RowBox[{"k", "-", "1"}], ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821322320792897*^9, 3.8213223981926413`*^9}, {
  3.8213225874198313`*^9, 
  3.8213226059583607`*^9}},ExpressionUUID->"03cf9f47-0e6d-49bb-a4b7-\
7f0794c3e11e"],

Cell[TextData[{
 "and then invert ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "D"], 
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], 
    SubscriptBox["P", "D"]}], TraditionalForm]],ExpressionUUID->
  "036b3870-f0db-4244-bb06-46f7db0c3837"],
 " which will be a small, easy to work with matrix (it is important to point \
out that since ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.821322320792897*^9, 3.8213223981926413`*^9}, {
   3.8213225874198313`*^9, 3.8213226059583607`*^9}},ExpressionUUID->
  "76c61e40-43da-4489-aa93-7c9854978159"],
 " will be represented in the basis of eigenfunctions of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "0", ")"}]], TraditionalForm]],ExpressionUUID->
  "94b5af27-1bde-4afe-afe6-7791f62951b9"],
 " it won\[CloseCurlyQuote]t matter that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "67916f25-65cd-48c0-b23b-603606c9f34b"],
 " is an eigenfunction of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.821322320792897*^9, 3.8213223981926413`*^9}, {
   3.8213225874198313`*^9, 3.8213226059583607`*^9}},ExpressionUUID->
  "cd19dd33-c818-4897-90f2-212f6dd5b137"],
 ") ",
 StyleBox["[CHECK THIS]",
  FontColor->RGBColor[1, 0, 0]]
}], "ExpositoryText",
 CellChangeTimes->{{3.8213224001213427`*^9, 3.821322434330351*^9}, {
  3.8213226076172743`*^9, 
  3.821322694028799*^9}},ExpressionUUID->"3fc4bbd6-c9d2-40ca-b5b0-\
bc30bd24bb29"],

Cell["\<\
And so at long last we finally come back to the claim that using\
\>", "ExpositoryText",
 CellChangeTimes->{{3.821322760134884*^9, 3.821322769342836*^9}, {
  3.821322866503149*^9, 3.8213228682924337`*^9}, {3.821322946952611*^9, 
  3.821322948270574*^9}},ExpressionUUID->"47659750-922e-4c65-b955-\
ecd9b6a54dbb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[CapitalPi]", "D"], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{
      SubscriptBox["P", "U"], "(", 
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", "0", ")"}]], "-", 
       SuperscriptBox[
        SubscriptBox["E", "n"], 
        RowBox[{"(", "0", ")"}]]}], ")"}], 
     RowBox[{"-", "1"}]], 
    SubscriptBox["P", "U"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821322871288457*^9, 
  3.821322872019224*^9}},ExpressionUUID->"6bf2a7dd-6d83-4f0c-bc6f-\
c774f3e341c1"],

Cell["will make it easy to solve", "ExpositoryText",
 CellChangeTimes->{{3.8213228734618807`*^9, 
  3.821322877240239*^9}},ExpressionUUID->"58d17a6e-f8c4-4e49-a5f9-\
caa64b12fccf"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", "U"], "H", "\[VeryThinSpace]", 
    TemplateBox[{"n"},
     "Ket"]}], "=", 
   RowBox[{"E", "\[VeryThinSpace]", 
    SubscriptBox["P", "U"], 
    TemplateBox[{"n"},
     "Ket"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8213162017276373`*^9, 3.821316223700755*^9}, {
   3.821316273822598*^9, 3.821316317389687*^9}, 3.8213164355919847`*^9, {
   3.821316472563299*^9, 3.821316480288516*^9}, 3.821322880367258*^9, {
   3.821323029924314*^9, 
   3.8213230345963163`*^9}},ExpressionUUID->"19b6f7c0-ec0e-40d0-b457-\
64fa9ebfa3ce"],

Cell[TextData[{
 "to start off with, we do exactly what we always do, and expand and match \
terms in order ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "6f8705ef-3853-46aa-a181-c42fbec26c1c"],
 ". Setting up the Trash Equations for arbitrary ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "692ddcc6-654d-4667-9b03-303bff4eda5b"],
 " in this subspace as"
}], "ExpositoryText",
 CellChangeTimes->{{3.821323037570776*^9, 3.821323075327084*^9}, {
  3.8213231243675117`*^9, 
  3.821323158081224*^9}},ExpressionUUID->"b1bbbb23-bdd6-4d6f-9c77-\
a58179e1ce1e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], "k"], 
    RowBox[{
     SubscriptBox["P", "U"], 
     SuperscriptBox["H", 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "i", ")"}]]},
      "Ket"]}]}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], "k"], 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["E", "n"], 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]], 
     SubscriptBox["P", "U"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "i", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.810046685081461*^9, 3.810046761718396*^9}, {
  3.810053860753112*^9, 3.810053861116617*^9}, {3.821323162226123*^9, 
  3.8213231645507708`*^9}},ExpressionUUID->"e34bebfc-d1bc-4cd4-a340-\
4eaf94ab5f55"],

Cell[TextData[{
 "then we note we already have ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["E", 
    RowBox[{"(", "k", ")"}]], TraditionalForm]],ExpressionUUID->
  "c3e3fb4e-57e6-4153-b661-01f9d60980ed"],
 " (it\[CloseCurlyQuote]s actually ",
 StyleBox["impossible",
  FontSlant->"Italic"],
 " to determine from this using the regular trick, since ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     SubscriptBox["P", "U"]}], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "90cbd571-d5ac-4772-9135-4710a2e0952b"],
 ") so we jump straight into getting the wavefunction corrections by \
separating out the order ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "e20a5f95-f04e-42ce-bb6f-c55e1989f28e"],
 " terms"
}], "ExpositoryText",
 CellChangeTimes->{{3.8213231705696487`*^9, 3.821323181395774*^9}, {
