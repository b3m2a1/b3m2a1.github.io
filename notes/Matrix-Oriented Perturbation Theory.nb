 FormBox[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "k", ")"}]]},
    "Ket"], " ", "=", " ", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"b", "=", "0"}], "a"], 
     RowBox[{
      SubsuperscriptBox["\[CapitalPi]", "U", 
       RowBox[{"(", "a", ")"}]], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], 
        RowBox[{"k", "-", "1"}]], 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", "b", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "i", ")"}]]},
         "Ket"]}]}]}]}], " ", "-", " ", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}], 
       RowBox[{"k", "-", "1"}]], 
      TemplateBox[{
        RowBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "i", ")"}]], " "}], 
        RowBox[{"\[VeryThinSpace] ", 
          SuperscriptBox["n", 
           RowBox[{"(", 
             RowBox[{"k", "-", "i"}], ")"}]]}]},
       "BraKet"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8287463935192127`*^9, 3.828746393543025*^9}, {
   3.828746428460998*^9, 3.828746525762726*^9}, 
   3.82874676249151*^9},ExpressionUUID->"4f012a2d-a9b5-46cc-a903-\
9622a675a546"]
}, Open  ]]
