e6694afd39db"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], 
    SubscriptBox["q", "k"], "\[InvisibleSpace]", 
    SubscriptBox["q", "k"], "\[CapitalPi]", "\[VeryThinSpace]", 
    SubscriptBox[
     RowBox[{"p", "\[InvisibleSpace]"}], "i"], "\[InvisibleSpace]", 
    SubscriptBox[
     RowBox[{"Q", "\[InvisibleSpace]"}], "j"], "\[InvisibleSpace]", 
    SubscriptBox["p", "j"], "\[InvisibleSpace]", "\[CapitalPi]", "\[InvisibleSpace]\[VeryThinSpace]", 
    SubscriptBox["q", "j"], "\[InvisibleSpace]", 
    SubscriptBox[
     RowBox[{"q", "\[InvisibleSpace]"}], "j"], "\[InvisibleSpace]", 
    SubscriptBox["q", "i"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      SubscriptBox["d", "i"], "=", 
      RowBox[{"-", "2"}]}], "2"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       SubscriptBox["d", "j"], "=", 
       RowBox[{"-", "4"}]}], "4"], "\[VeryThinSpace]", 
     RowBox[{
      RowBox[{"\[Pi]", "(", 
       StyleBox["d",
        FontWeight->"Bold"], ")"}], 
      RowBox[{
       SubscriptBox["\[Rho]", 
        RowBox[{
         SubscriptBox[
          StyleBox["q",
           FontSlant->"Italic"], "k"], "\[InvisibleSpace]", 
         SubscriptBox["q", "k"]}]], "(", 
       RowBox[{
        RowBox[{
         SubscriptBox["n", "i"], "+", 
         SubscriptBox["d", "i"]}], ",", " ", 
        RowBox[{"-", 
         SubscriptBox["d", "i"]}], ",", " ", 
        SubsuperscriptBox["\[CapitalDelta]", "i", "A"]}], ")"}], 
      RowBox[{
       SubscriptBox["\[Chi]", "B"], "(", 
       RowBox[{
        SubscriptBox["n", "i"], ",", " ", 
        SubscriptBox["d", "i"], ",", " ", 
        SubsuperscriptBox["\[CapitalDelta]", "i", "B"]}], ")"}], 
      RowBox[{
       SubscriptBox["\[Rho]", 
        RowBox[{
         SubscriptBox[
          StyleBox["q",
           FontSlant->"Italic"], "k"], "\[InvisibleSpace]", 
         SubscriptBox["q", "k"]}]], "(", 
       RowBox[{
        RowBox[{
         SubscriptBox["n", "j"], "+", 
         SubscriptBox["d", "j"]}], ",", " ", 
        RowBox[{"-", 
         SubscriptBox["d", "j"]}], ",", " ", 
        SubsuperscriptBox["\[CapitalDelta]", "j", "A"]}], ")"}], 
      RowBox[{
       SubscriptBox["\[Chi]", "B"], "(", 
       RowBox[{
        SubscriptBox["n", "j"], ",", " ", 
        SubscriptBox["d", "j"], ",", " ", 
        SubsuperscriptBox["\[CapitalDelta]", "j", "B"]}], ")"}]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.81353400504825*^9, 3.813534183993164*^9}, {
  3.813534293788464*^9, 3.813534301080258*^9}, {3.8135343394933167`*^9, 
  3.813534434322995*^9}, {3.8135346463027287`*^9, 3.813534659309725*^9}, {
