b602e7396f67"],

Cell[TextData[{
 "We note that to hit a given ",
 StyleBox["k",
  FontSlant->"Italic"],
 ", assuming for now that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "\[GreaterEqual]", "0"}], TraditionalForm]],ExpressionUUID->
  "b497f19e-85e8-4ab7-8c94-01eccc663a7e"],
 ", we need to do ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"(", 
     RowBox[{"n", "-", "k"}], ")"}], "2"], TraditionalForm]],ExpressionUUID->
  "20bf3b21-a848-43b5-8422-d484b040dd3c"],
 " downward transitions (i.e. 2 downward in the previous example) and the \
rest upward. Then to generate the list of transitions we just take the full \
set of permutations of these. Mathematically, this mean we can start with the \
list"
}], "ExpositoryText",
 CellChangeTimes->{{3.812045594447064*^9, 3.8120456290439568`*^9}, {
  3.812045675194511*^9, 3.812045700718495*^9}, {3.8120457418867083`*^9, 
