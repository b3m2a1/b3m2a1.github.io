       FontSlant->"Italic"], "5"]}], " ", "=", " ", "2"}]}], 
  TraditionalForm], "\[IndentingNewLine]", 
 FormBox[
  RowBox[{"\t", 
   RowBox[{"\[Implies]", " ", 
    RowBox[{"we", " ", "want", " ", "element", " ", 
     SubscriptBox[
      StyleBox["i",
       FontSlant->"Italic"], "5"], " ", "from", " ", "axis", " ", "2", " ", 
