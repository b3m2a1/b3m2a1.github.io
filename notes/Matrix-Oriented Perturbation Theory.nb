5583f09fcc0a"],

Cell["\<\
To answer this we need to think about how our total Hamiltonian is \
structured. A given element of this looks like\
\>", "Text",
 CellChangeTimes->{{3.793821115211595*^9, 3.793821119659966*^9}, {
  3.793821158347988*^9, 
  3.7938212088745947`*^9}},ExpressionUUID->"42365025-03de-4662-a7b6-\
16917a7e9b94"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox[
     TemplateBox[{"n"},
      "Bra"],
     FontSlant->"Plain"], 
    StyleBox["H",
     FontSlant->"Plain"], 
    TemplateBox[{"m"},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{
     StyleBox[
      TemplateBox[{"n"},
       "Bra"],
      FontSlant->"Plain"], 
     StyleBox["T",
      FontSlant->"Plain"], 
     TemplateBox[{"m"},
      "Ket"]}], "+", 
    RowBox[{
     StyleBox[
      TemplateBox[{"n"},
       "Bra"],
      FontSlant->"Plain"], 
     StyleBox["V",
      FontSlant->"Plain"], 
     TemplateBox[{"m"},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.79382121076602*^9, 
  3.793821248642519*^9}},ExpressionUUID->"fd6cdc7b-92af-4cb8-8462-\
21dfe5aa7f1a"],

Cell["\<\
and keeping in mind that our basis is the direct product of the basis sets\
\>", "Text",
 CellChangeTimes->{{3.793821255273682*^9, 
  3.793821290473503*^9}},ExpressionUUID->"94cb7300-f456-4a5b-92e4-\
10d64ef09e8b"],

