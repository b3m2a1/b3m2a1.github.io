   3.827932583565517*^9},ExpressionUUID->"eecf59fd-834d-4f02-a235-\
23392cceb771"],

Cell[TextData[{
 "which just is a rewriting of the previous term over sequences in ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "4ab4424d-aae5-4dbd-bc7e-bfad9935bcba"]
}], "ExpositoryText",
 CellChangeTimes->{{3.827932587759227*^9, 
  3.827932605331318*^9}},ExpressionUUID->"9e954b38-dcfd-41d5-8f0a-\
793452ac5b1c"],

Cell[TextData[{
 "it is worth noting for every ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "62e0e308-6a0c-452a-8f09-e93bf38793ef"],
 " there is a corresponding ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "4f3d6036-5349-4779-91c6-c63675bcb702"],
 " and vice verse, and in fact the set of all of these ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "e901f7e5-3de6-41ab-bce8-7a2915fce9cc"],
 " terms is just the power set of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[DoubleStruckCapitalN]", "M"], TraditionalForm]],
  ExpressionUUID->"bbf7eeaa-eadd-4263-8dd7-d25f0d388e38"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalP]", "M"], TraditionalForm]],ExpressionUUID->
  "a0a5746f-90c3-479e-a84c-62efafdda5fa"],
 ", meaning we can now write"
}], "ExpositoryText",
 CellChangeTimes->{{3.827927881108536*^9, 3.827927913547784*^9}, {
