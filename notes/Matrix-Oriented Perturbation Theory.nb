Cell[CellGroupData[{

Cell["State Selection Rules", "Section",
 CellChangeTimes->{{3.8117581226342173`*^9, 
  3.811758127218614*^9}},ExpressionUUID->"35688d61-50a4-4905-b659-\
a6ea07089ebb"],

Cell[TextData[{
 "The number of states that are required to be accurate enough with the \
perturbation theory grows exponentially, as do the number of potentially \
relevant transitions. If we have ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "vib"], TraditionalForm]],ExpressionUUID->
  "6d3a25cc-8094-4c2f-a0b1-0647ef6c136f"],
 " vibrational modes and want to put up to ",
 StyleBox["M",
  FontSlant->"Italic"],
 " quanta of excitation into any of these modes, assuming ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "<", 
    SubscriptBox["N", "vib"], " "}], TraditionalForm]],ExpressionUUID->
  "3f5e9f49-4ce4-471d-830b-e32eb316dd28"],
 "the number of states we\[CloseCurlyQuote]re working with can be defined \
recursively for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", ">", "1"}], TraditionalForm]],ExpressionUUID->
  "9942c317-0d36-4ef4-b052-2f03f1e3d0b9"],
 " as"
}], "ExpositoryText",
 CellChangeTimes->{{3.811758141515345*^9, 3.811758301548502*^9}, {
  3.811758385814352*^9, 3.811758391748541*^9}, {3.811758464319778*^9, 
  3.811758471521212*^9}, {3.81175857860003*^9, 3.811758580557561*^9}, {
  3.8117587476286983`*^9, 
  3.811758760184016*^9}},ExpressionUUID->"fdfcf8ba-c037-4958-99d0-\
c8a836a0409e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Rho]", "(", 
    RowBox[{
     SubscriptBox["N", "vib"], ",", " ", "M"}], ")"}], "=", 
   RowBox[{
    RowBox[{"\[Rho]", "(", 
     RowBox[{
      SubscriptBox["N", "vib"], ",", " ", 
      RowBox[{"M", "-", "1"}]}], ")"}], " ", "+", " ", 
    RowBox[{"\[Rho]", "(", 
     RowBox[{
      RowBox[{
       SubscriptBox["N", "vib"], "-", "1"}], ",", " ", "M"}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8117583029449797`*^9, 3.81175832987221*^9}, {
   3.811758380332759*^9, 3.8117583817114162`*^9}, {3.8117584123951817`*^9, 
   3.8117584150022287`*^9}, {3.811758479158901*^9, 3.811758481965714*^9}, {
   3.811758520338306*^9, 3.811758538519456*^9}, 3.811758583366671*^9, {
   3.8117586335860243`*^9, 3.811758649707185*^9}, {3.811759033211918*^9, 
   3.811759034965309*^9}, {3.811759310437711*^9, 
   3.8117593389728947`*^9}},ExpressionUUID->"d589dfa0-512d-443c-acf4-\
b8b1ff9ea952"],

Cell[TextData[{
 "where the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "(", 
    RowBox[{
     SubscriptBox["N", "vib"], ",", " ", 
     RowBox[{"M", "-", "1"}]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.8117583029449797`*^9, 3.81175832987221*^9}, {
   3.811758380332759*^9, 3.8117583817114162`*^9}, {3.8117584123951817`*^9, 
   3.8117584150022287`*^9}, {3.811758479158901*^9, 3.811758481965714*^9}, {
   3.811758520338306*^9, 3.811758538519456*^9}},ExpressionUUID->
  "83984615-622a-42f8-b3c7-a1e9e3e9689b"],
 " contribution comes from the fact that the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "-", "1"}], TraditionalForm]],ExpressionUUID->
  "00e94935-14ac-4f7a-b430-86bc0e3c5402"],
 " states also have fewer than ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],ExpressionUUID->
  "745e7711-09e8-4f7c-bec4-0dd4c6f36f40"],
 " quanta and the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "(", 
    RowBox[{
     RowBox[{
      SubscriptBox["N", "vib"], "-", "1"}], ",", " ", "M"}], ")"}], 
   TraditionalForm]],
  CellChangeTimes->{{3.8117583029449797`*^9, 3.81175832987221*^9}, {
    3.811758380332759*^9, 3.8117583817114162`*^9}, {3.8117584123951817`*^9, 
    3.8117584150022287`*^9}, {3.811758479158901*^9, 3.811758481965714*^9}, {
    3.811758520338306*^9, 3.811758538519456*^9}, 3.811758583366671*^9, {
    3.8117586335860243`*^9, 3.811758649707185*^9}, {3.811759033211918*^9, 
    3.811759034965309*^9}, {3.811759310437711*^9, 3.8117593170254393`*^9}},
  ExpressionUUID->"742e217a-2e60-4a00-9ee2-9b1766ad8775"],
 " comes from adding an extra quantum to all of those states & dealing with \
duplicates. I might actually be mildly over counting in this formula, but at \
the very least it suffices to show the exponential blow-up we expect."
}], "ExpositoryText",
 CellChangeTimes->{{3.8117585404431953`*^9, 3.811758568628846*^9}, {
   3.8117585987804537`*^9, 3.8117586171487417`*^9}, {3.811758656051271*^9, 
   3.811758679456181*^9}, {3.811759324471455*^9, 3.811759334413329*^9}, {
   3.811759715325881*^9, 3.811759745113022*^9}, {3.8117599225529947`*^9, 
   3.811759987155023*^9}, {3.8117601626781282`*^9, 3.811760203587611*^9}, 
   3.811760506819044*^9},ExpressionUUID->"93396643-f21f-4927-bce8-\
e2353708fa5f"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["N", "vib"], "=", "2"}], TraditionalForm]],
  CellChangeTimes->{{3.8117583029449797`*^9, 3.81175832987221*^9}, {
    3.811758380332759*^9, 3.8117583817114162`*^9}, {3.8117584123951817`*^9, 
    3.8117584150022287`*^9}, {3.811758479158901*^9, 3.811758481965714*^9}, {
    3.811758520338306*^9, 3.811758538519456*^9}, 3.811758583366671*^9, {
    3.8117586335860243`*^9, 3.811758649707185*^9}, {3.811759033211918*^9, 
    3.811759034965309*^9}, {3.811759310437711*^9, 3.8117593389728947`*^9}},
  ExpressionUUID->"e24672e4-04c0-457c-b908-8f508fd71398"],
 ", these will grow as the triangular numbers, defined as"
}], "ExpositoryText",
 CellChangeTimes->{{3.8117585404431953`*^9, 3.811758568628846*^9}, {
   3.8117585987804537`*^9, 3.8117586171487417`*^9}, {3.811758656051271*^9, 
   3.811758679456181*^9}, {3.811759324471455*^9, 3.811759334413329*^9}, {
   3.811759715325881*^9, 3.811759745113022*^9}, {3.8117599225529947`*^9, 
   3.811759987155023*^9}, {3.8117601626781282`*^9, 3.811760203587611*^9}, 
   3.811760508699527*^9},ExpressionUUID->"c1cf5112-0df2-40b2-bf05-\
a7d5e256c81c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"a", "(", "n", ")"}], " ", "=", " ", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{"n", "+", "1"}]},
      {"2"}
     },
     GridBoxAlignment->{"Columns" -> Center}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811760205471526*^9, 3.811760218675035*^9}, {
  3.811760249229665*^9, 
  3.811760249731257*^9}},ExpressionUUID->"a7cc32fe-b945-4ad2-8303-\
af23bd3a4435"],

Cell[TextData[{
 "and when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Rho]", "(", 
     RowBox[{
      SubscriptBox["N", "vib"], ",", " ", "1"}], ")"}], " ", "=", 
    SubscriptBox["N", "vib"]}], TraditionalForm]],ExpressionUUID->
  "a3a659be-e423-4e98-88b1-da751f52152a"],
 " so this building recursively we\[CloseCurlyQuote]re going to by something \
like a binomial expansion on the binomial numbers. I\[CloseCurlyQuote]ll \
leave the proper analysis of this kind of thing to the number theorists, who \
have certainly already studied problems like this and just leave you with a \
plot of what this looks like"
}], "ExpositoryText",
 CellChangeTimes->{{3.8117602426895742`*^9, 3.8117602738710203`*^9}, {
  3.811760431784421*^9, 3.8117604811233387`*^9}, {3.8117606174430017`*^9, 
  3.811760624039403*^9}, {3.811760657391679*^9, 3.811760672886594*^9}, {
  3.811760719565935*^9, 3.811760779569306*^9}, {3.811760833474485*^9, 
  3.811760843854992*^9}},ExpressionUUID->"18c2dca3-118a-444b-8aa4-\
bed738353cb2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"rhoNM", "//", "Clear"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rhoNM", "[", 
    RowBox[{
     RowBox[{"nvib", ":", 
      RowBox[{"{", "__Integer", "}"}]}], ",", " ", 
     RowBox[{"m", ":", 
      RowBox[{"{", "__Integer", "}"}]}]}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "rhoNM", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"rhoNM", "[", 
        RowBox[{"nv_Integer", ",", " ", "0"}], "]"}], ":=", "1"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rhoNM", "[", 
        RowBox[{"nv_Integer", ",", " ", "1"}], "]"}], ":=", 
       RowBox[{"nv", "+", "1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rhoNM", "[", 
        RowBox[{"2", ",", " ", "mq_Integer"}], "]"}], ":=", 
       RowBox[{"Binomial", "[", 
        RowBox[{
         RowBox[{"mq", "+", "2"}], ",", " ", "2"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rhoNM", "[", 
        RowBox[{"nv_Integer", ",", " ", "mq_Integer"}], "]"}], ":=", 
       RowBox[{
        RowBox[{"rhoNM", "[", 
         RowBox[{"nv", ",", " ", "mq"}], "]"}], "=", 
        RowBox[{
         RowBox[{"rhoNM", "[", 
          RowBox[{"nv", ",", " ", 
           RowBox[{"mq", "-", "1"}]}], "]"}], "+", 
         RowBox[{"rhoNM", "[", 
          RowBox[{
           RowBox[{"nv", "-", "1"}], ",", " ", "mq"}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SetAttributes", "[", 
       RowBox[{"rhoNM", ",", " ", "Listable"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rhoNM", "[", 
       RowBox[{"nvib", ",", " ", "m"}], "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rhoNM", "[", 
    RowBox[{"nvib_Integer", ",", " ", "m_Integer"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"rhoNM", "[", 
     RowBox[{
      RowBox[{"{", "nvib", "}"}], ",", " ", 
      RowBox[{"{", "m", "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
