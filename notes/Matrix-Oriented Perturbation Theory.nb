           "$ptFormattingRules"}], ",", " ", "\"\<)\>\""}], "}"}]}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"kn", "[", "i_", "]"}], "\[RuleDelayed]", 
      RowBox[{"RawBoxes", "@", 
       RowBox[{"TemplateBox", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"SuperscriptBox", "[", 
           RowBox[{"\"\<n\>\"", ",", " ", 
            RowBox[{"RowBox", "@", 
             RowBox[{"{", 
              RowBox[{"\"\<(\>\"", ",", " ", 
               RowBox[{"toPTBoxes", "@", "i"}], ",", " ", "\"\<)\>\""}], 
              "}"}]}]}], "]"}], "}"}], ",", " ", "\"\<Ket\>\""}], "]"}]}]}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"bn", "[", "i_", "]"}], "\[RuleDelayed]", 
      RowBox[{"RawBoxes", "@", 
       RowBox[{"TemplateBox", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"SuperscriptBox", "[", 
           RowBox[{"\"\<n\>\"", ",", " ", 
            RowBox[{"RowBox", "@", 
             RowBox[{"{", 
              RowBox[{"\"\<(\>\"", ",", " ", 
               RowBox[{"toPTBoxes", "@", "i"}], ",", " ", "\"\<)\>\""}], 
              "}"}]}]}], "]"}], "}"}], ",", " ", "\"\<Bra\>\""}], "]"}]}]}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ov", "[", 
       RowBox[{"i_", ",", " ", "j_"}], "]"}], ":>", 
      RowBox[{"RawBoxes", "@", 
       RowBox[{"TemplateBox", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"RowBox", "@", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"SuperscriptBox", "[", 
               RowBox[{"\"\<n\>\"", ",", " ", 
                RowBox[{"RowBox", "@", 
                 RowBox[{"{", 
                  RowBox[{"\"\<(\>\"", ",", " ", 
