       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SuperscriptBox["S", 
        RowBox[{"(", "k", ")"}]], 
       SubsuperscriptBox["\[CapitalDelta]H", "m", 
        RowBox[{"(", "i", ")"}]], 
       SuperscriptBox["R", 
        RowBox[{"(", 
         RowBox[{"j", "-", "i"}], ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
