  3.829053355479897*^9}, {3.8290538993882227`*^9, 
  3.8290538998402157`*^9}},ExpressionUUID->"381a883b-732b-4c24-876e-\
7411ded8803c"],

Cell["which pretty clearly gives us", "ExpositoryText",
 CellChangeTimes->{{3.829053364244234*^9, 
  3.829053371305667*^9}},ExpressionUUID->"4e942f27-e439-4ec2-a89b-\
289583d043b7"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox["\[GothicCapitalH]", 
       RowBox[{"(", "k", ")"}]], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "1"}], 
        RowBox[{"k", "-", "1"}]], " ", 
       RowBox[{
        SubsuperscriptBox["H", "n", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], "(", 
        RowBox[{
         TemplateBox[{
           RowBox[{
             SuperscriptBox["n", 
              RowBox[{"(", "0", ")"}]], " "}], 
           RowBox[{"\[VeryThinSpace] ", 
             SuperscriptBox["n", 
              RowBox[{"(", "i", ")"}]]}]},
          "BraKet"], " ", "+", "  ", 
         RowBox[{
          SubscriptBox["\[CapitalPi]", "n"], 
          SuperscriptBox["H", 
           RowBox[{"(", "i", ")"}]]}], " ", "+", " ", 
         RowBox[{
          SubscriptBox["\[CapitalPi]", "n"], 
          SubsuperscriptBox["\[GothicCapitalH]", "n", 
           RowBox[{"(", "i", ")"}]]}]}], ")"}]}]}]},
    {
     RowBox[{
      SubsuperscriptBox["\[GothicCapitalE]", "n", 
       RowBox[{"(", "k", ")"}]], " ", "=", " ", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], 
         RowBox[{"k", "-", "1"}]], 
        RowBox[{
         SubsuperscriptBox["H", "n", 
          RowBox[{"(", 
           RowBox[{"k", "-", "i"}], ")"}]], 
         SubscriptBox["\[CapitalPi]", "n"], 
         SubsuperscriptBox["\[GothicCapitalE]", "n", 
          RowBox[{"(", "i", ")"}]]}]}], " ", "+", " ", 
       RowBox[{
        SubsuperscriptBox["E", "n", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubsuperscriptBox["B", "n", 
         RowBox[{"(", "i", ")"}]]}], " ", "+", " ", 
       RowBox[{
        SubsuperscriptBox["E", "n", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SuperscriptBox["H", 
         RowBox[{"(", "i", ")"}]]}], "+", " ", 
       RowBox[{
        SuperscriptBox["E", 
         RowBox[{"(", "i", ")"}]], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"]}], " ", "+", " ", 
       RowBox[{
        SubsuperscriptBox["E", "n", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", "i", ")"}]]}]},
         "BraKet"]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], 
         RowBox[{"k", "-", "1"}]], " ", 
        RowBox[{
         SubsuperscriptBox["E", "n", 
          RowBox[{"(", 
           RowBox[{"k", "-", "i"}], ")"}]], 
         TemplateBox[{
           RowBox[{
             SuperscriptBox["n", 
              RowBox[{"(", "0", ")"}]], " "}], 
           RowBox[{"\[VeryThinSpace] ", 
             SuperscriptBox["n", 
              RowBox[{"(", "i", ")"}]]}]},
          "BraKet"]}]}], " ", "+", " ", 
       RowBox[{
        SubsuperscriptBox["E", "n", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubsuperscriptBox["\[GothicCapitalH]", "n", 
         RowBox[{"(", "i", ")"}]]}], "  ", "+", " ", 
       RowBox[{
        SubsuperscriptBox["E", "n", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SuperscriptBox["H", 
         RowBox[{"(", "i", ")"}]]}], " ", "+", "  ", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubsuperscriptBox["\[GothicCapitalE]", "n", 
         RowBox[{"(", "i", ")"}]]}], " ", "+", " ", 
       RowBox[{
        SubsuperscriptBox["H", "n", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubsuperscriptBox["E", "n", 
         RowBox[{"(", "i", ")"}]]}], " ", "-", " ", 
       RowBox[{
        SubsuperscriptBox["E", "n", 
         RowBox[{"(", "i", ")"}]], 
        SubsuperscriptBox["E", "n", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], "  "}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], 
         RowBox[{"k", "-", "1"}]], " ", 
        RowBox[{
         SubsuperscriptBox["E", "n", 
          RowBox[{"(", 
           RowBox[{"k", "-", "i"}], ")"}]], "(", 
         RowBox[{
          TemplateBox[{
            RowBox[{
              SuperscriptBox["n", 
               RowBox[{"(", "0", ")"}]], " "}], 
            RowBox[{"\[VeryThinSpace] ", 
              SuperscriptBox["n", 
               RowBox[{"(", "i", ")"}]]}]},
           "BraKet"], " ", "+", "  ", 
          RowBox[{
           SubscriptBox["\[CapitalPi]", "n"], 
           SuperscriptBox["H", 
            RowBox[{"(", "i", ")"}]]}], " ", "+", " ", 
          RowBox[{
           SubscriptBox["\[CapitalPi]", "n"], 
           SubsuperscriptBox["\[GothicCapitalH]", "n", 
            RowBox[{"(", "i", ")"}]]}]}], ")"}]}], " ", "+", " ", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], 
        RowBox[{
         SubscriptBox["\[CapitalPi]", "n"], "(", 
         RowBox[{
          SubsuperscriptBox["\[GothicCapitalE]", "n", 
           RowBox[{"(", "i", ")"}]], " ", "+", " ", 
          SubsuperscriptBox["E", "n", 
           RowBox[{"(", "i", ")"}]]}], ")"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.829053373786602*^9, 3.82905344733963*^9}, {
  3.8290535089637213`*^9, 3.8290535837139597`*^9}, {3.829053619952936*^9, 
  3.829053682124612*^9}, {3.8290538060943613`*^9, 3.829053918797365*^9}, {
  3.829054009107273*^9, 3.829054015248575*^9}, {3.829054058989664*^9, 
  3.8290541054729652`*^9}, {3.8290541643142033`*^9, 3.82905417916151*^9}, {
  3.829054239284155*^9, 
  3.829054262518344*^9}},ExpressionUUID->"78641a36-93ee-4cce-982e-\
376c7a397281"],

Cell["but it turns out this is less useful that I thought...", \
"ExpositoryText",
 CellChangeTimes->{{3.829054333934194*^9, 
  3.829054346026525*^9}},ExpressionUUID->"ee88e29c-56af-4b22-a020-\
6a06526c1b24"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Condensed B operator", "Subsubsubsection",
 CellChangeTimes->{{3.830315407817297*^9, 
  3.8303154176251917`*^9}},ExpressionUUID->"d27087a5-9b5f-48b5-8419-\
ffe96732ec62"],

Cell["We can actually do something pretty convenient. We note that", \
"ExpositoryText",
 CellChangeTimes->{{3.8303154201421423`*^9, 
  3.8303154398317833`*^9}},ExpressionUUID->"38d2b964-0343-44a3-8778-\
a82f2e875b2d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["E", "n", 
    RowBox[{"(", "k", ")"}]], " ", "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     SuperscriptBox["H", 
      RowBox[{"(", "k", ")"}]]}], " ", "+", " ", 
    RowBox[{
     SubsuperscriptBox["B", "n", 
      RowBox[{"(", "k", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8303154414442797`*^9, 
  3.83031544561274*^9}},ExpressionUUID->"0abf3522-2620-4ef6-afaf-\
c130ccf97f5f"],

Cell["and", "ExpositoryText",
 CellChangeTimes->{{3.830315470111704*^9, 
  3.8303154703809233`*^9}},ExpressionUUID->"5ba14ee4-7ad4-4417-b7e0-\
222b762ea941"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["A", "n", 
        RowBox[{"(", "k", ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["H", 
          RowBox[{"(", "k", ")"}]], " ", "+", " ", 
         SubsuperscriptBox["B", "n", 
          RowBox[{"(", "k", ")"}]], " ", "-", " ", 
         SubsuperscriptBox["E", "n", 
          RowBox[{"(", "k", ")"}]]}], ")"}], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["H", 
          RowBox[{"(", "k", ")"}]], " ", "+", " ", 
         SubsuperscriptBox["B", "n", 
          RowBox[{"(", "k", ")"}]], " ", "-", " ", 
         SubsuperscriptBox["E", "n", 
          RowBox[{"(", "k", ")"}]]}], ")"}], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["H", 
          RowBox[{"(", "k", ")"}]], " ", "+", " ", 
         SubsuperscriptBox["B", "n", 
          RowBox[{"(", "k", ")"}]], " ", "-", " ", 
         RowBox[{
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]]},
           "Bra"], 
          SuperscriptBox["H", 
           RowBox[{"(", "k", ")"}]]}], " ", "+", " ", 
         RowBox[{
          SubsuperscriptBox["B", "n", 
           RowBox[{"(", "k", ")"}]], 
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]]},
           "Ket"]}]}], ")"}], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.83031547505779*^9, 3.830315564813545*^9}, {
  3.8303156320908337`*^9, 
  3.830315637404914*^9}},ExpressionUUID->"fc05ccb3-045b-49d8-af18-\
ad9db0b4c697"],

Cell["which means instead we could write all of this as", "ExpositoryText",
 CellChangeTimes->{{3.8303155764606247`*^9, 3.83031559337799*^9}, {
  3.83031568624885*^9, 
  3.8303156881779947`*^9}},ExpressionUUID->"0598100d-1748-43da-a7a4-\
19bdf2787370"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["\[ScriptCapitalH]", "n", 
       RowBox[{"(", "k", ")"}]], " ", "=", " ", 
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", "k", ")"}]], " ", "+", " ", 
       SubsuperscriptBox["B", "n", 
        RowBox[{"(", "k", ")"}]]}]}]},
    {
     RowBox[{
      SubsuperscriptBox["E", "n", 
       RowBox[{"(", "k", ")"}]], " ", "=", " ", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], 
       SubsuperscriptBox["\[ScriptCapitalH]", "n", 
        RowBox[{"(", "k", ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "k", ")"}]]},
       "Ket"], " ", "=", " ", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[CapitalPi]", "n"], 
        SubsuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", "n", 
         RowBox[{"(", "k", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], " \[VeryThinSpace]"}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", "k", ")"}]]}]},
         "BraKet"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.83031603241459*^9, 
  3.8303160330566998`*^9}},ExpressionUUID->"ebad66b4-866d-4005-a973-\
bb6f2d9155f3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Application to Nearly-Degenerate Problems", "Subsubsubsection",
 CellChangeTimes->{{3.828051273847117*^9, 
  3.828051289371542*^9}},ExpressionUUID->"86c86620-5811-4431-a463-\
047a8e1bf8c2"],

Cell[TextData[{
 "We\[CloseCurlyQuote]ll introduce a set of nearly degenerate states, i.e. \
ones where when naively pushing the perturbation theory through one would \
obtain a non-convergent series, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"D", "=", 
    RowBox[{"{", 
     TemplateBox[{
       SuperscriptBox["d", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"], "}"}]}], TraditionalForm]],ExpressionUUID->
  "a2c4bd93-10cb-411e-a1b9-2d494d660133"],
 ", and its orthogonal complement ",
 Cell[BoxData[
  FormBox["O", TraditionalForm]],ExpressionUUID->
  "00c7f583-627a-4898-8734-3735846c74cb"],
 ", and we\[CloseCurlyQuote]ll note that we can write"
}], "ExpositoryText",
 CellChangeTimes->{{3.828051282185644*^9, 3.828051391940889*^9}, {
  3.828051486911521*^9, 3.828051488914006*^9}, {3.828051524717107*^9, 
  3.828051533933804*^9}},ExpressionUUID->"d11d8467-46f1-47ed-b521-\
3e15bae57f95"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "U"], " ", 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Ket"]}], " ", "=", 
      RowBox[{
       SubscriptBox["\[CapitalPi]", "n"], 
       SubsuperscriptBox["A", "n", 
        RowBox[{"(", "k", ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[CapitalPi]", "n"], 
        SubscriptBox["P", "O"], 
        SubsuperscriptBox["A", "n", 
         RowBox[{"(", "k", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        SubscriptBox["\[CapitalPi]", "n"], 
        SubscriptBox["P", "D"], 
        SubsuperscriptBox["A", "n", 
         RowBox[{"(", "k", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.828051501197337*^9, 
  3.828051547175037*^9}},ExpressionUUID->"062ba684-5840-4d8b-9f56-\
133f30f9e5e2"],

Cell[TextData[{
 "this alone isn\[CloseCurlyQuote]t that useful, but if we expand ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["A", "n", 
    RowBox[{"(", "k", ")"}]], TraditionalForm]],ExpressionUUID->
  "d5d084c5-d5cf-447d-a4ee-a8f0e3214cc4"],
 " we note we can also write"
}], "ExpositoryText",
 CellChangeTimes->{{3.8280515795806627`*^9, 
  3.828051670557089*^9}},ExpressionUUID->"b67fc655-0423-49e5-91ab-\
e58050f66d13"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["A", "n", 
    RowBox[{"(", "k", ")"}]], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], 
     RowBox[{"k", "-", "1"}]], 
    RowBox[{
     SubsuperscriptBox["\[CapitalDelta]H", "n", 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]], "(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[CapitalPi]", "n"], 
       SubscriptBox["P", "O"], 
       SubsuperscriptBox["A", "n", 
        RowBox[{"(", "i", ")"}]]}], "+", 
      RowBox[{
       SubscriptBox["\[CapitalPi]", "n"], 
       SubscriptBox["P", "D"], 
       SubsuperscriptBox["A", "n", 
        RowBox[{"(", "i", ")"}]]}], "+", 
      TemplateBox[{
        RowBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]], " "}], 
        RowBox[{"\[VeryThinSpace] ", 
          SuperscriptBox["n", 
           RowBox[{"(", "i", ")"}]]}]},
       "BraKet"]}], ")"}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.827707029211122*^9, 3.827707051809273*^9}, {
  3.8277071012478857`*^9, 3.827707103590711*^9}, {3.8277139502139*^9, 
  3.8277139841597157`*^9}, {3.827714028413035*^9, 3.827714039715076*^9}, {
  3.828051675180504*^9, 
  3.828051684530818*^9}},ExpressionUUID->"c892aefa-735e-44b6-8854-\
68905efde081"],

Cell[TextData[{
 "by definition, if we eliminate all terms of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPi]", "n"], 
    SubscriptBox["P", "D"]}], TraditionalForm]],
  CellChangeTimes->{{3.827707029211122*^9, 3.827707051809273*^9}, {
   3.8277071012478857`*^9, 3.827707103590711*^9}, {3.8277139502139*^9, 
   3.8277139841597157`*^9}, {3.827714028413035*^9, 3.827714039715076*^9}, {
   3.828051675180504*^9, 3.828051684530818*^9}},ExpressionUUID->
  "5c4f5c21-7d94-4083-8c8e-6bcb7236df72"],
 ", the perturbation theory converges. This is the kind of non-degenerate \
treatment Anne has done in the past. It is possible, however, that divergence \
in the PT comes in only once we have multiple applications of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPi]", "n"], 
    SubscriptBox["P", "D"]}], TraditionalForm]],
  CellChangeTimes->{{3.827707029211122*^9, 3.827707051809273*^9}, {
   3.8277071012478857`*^9, 3.827707103590711*^9}, {3.8277139502139*^9, 
   3.8277139841597157`*^9}, {3.827714028413035*^9, 3.827714039715076*^9}, {
   3.828051675180504*^9, 3.828051684530818*^9}},ExpressionUUID->
  "2cad0950-9e8d-4b86-a1d1-d36bd765ecf1"],
 ", i.e. issues arise when we have terms involving, e.g. ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[CapitalPi]", "n"], 
      SubscriptBox["P", "D"]}], ")"}], "K"], TraditionalForm]],ExpressionUUID->
  "f3e445ea-7d36-4ec2-922c-26a5594ed601"],
 ". If that\[CloseCurlyQuote]s the case, then we can actually treat that and \
potentially get a better 0 order picture for a variational treatment than \
defining ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[CapitalPi]", "n"], 
     SubscriptBox["P", "D"]}], "=", "\[DoubleStruckZero]"}], 
   TraditionalForm]],ExpressionUUID->"d2b80945-e8cc-44b1-90d5-2620b0b2514e"],
 " would give."
}], "ExpositoryText",
 CellChangeTimes->{{3.828051728058707*^9, 3.828052023764415*^9}, 
   3.828052420776993*^9},ExpressionUUID->"fd398151-3e9b-45fc-a3a7-\
f0db6024e169"],

Cell[TextData[{
 "We\[CloseCurlyQuote]ll define a related quantity to ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["A", "n", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]],ExpressionUUID->
  "90433d1f-7933-4071-9d1d-d326d511dc76"]
}], "ExpositoryText",
 CellChangeTimes->{{3.828052423423934*^9, 3.828052429816216*^9}, {
  3.8280525143181067`*^9, 
  3.828052522500252*^9}},ExpressionUUID->"fb1ab073-2123-47c6-a376-\
bcd03039e8d1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["B", "n", 
    RowBox[{"(", "k", ")"}]], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], 
     RowBox[{"k", "-", "1"}]], 
    RowBox[{
     SubsuperscriptBox["\[CapitalDelta]H", "n", 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]], 
     SubscriptBox["\[CapitalPi]", "n"], 
     SubsuperscriptBox["A", "n", 
      RowBox[{"(", "i", ")"}]]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.82805243494342*^9, 
  3.828052450871374*^9}},ExpressionUUID->"3db79e79-0d0d-4402-b782-\
4ba32887c483"],

Cell[TextData[{
 "which will make it easier to motivate what we\[CloseCurlyQuote]re going to \
do. Now we\[CloseCurlyQuote]ll expand ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["B", "n", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]],ExpressionUUID->
  "1201bd7e-9997-4f45-bc6d-d592d0efa7ae"],
 "to fourth order"
}], "ExpositoryText",
 CellChangeTimes->{{3.8280525017743683`*^9, 
  3.828052533680368*^9}},ExpressionUUID->"5bf61cc0-25da-4b46-b86b-\
7c5cedb8b12f"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["B", "n", 
       RowBox[{"(", "1", ")"}]], "=", "\[AlignmentMarker]", 
      SubsuperscriptBox["\[CapitalDelta]H", "n", 
       RowBox[{"(", "1", ")"}]]}]},
    {
     RowBox[{
      SubsuperscriptBox["B", "n", 
       RowBox[{"(", "2", ")"}]], "=", "\[AlignmentMarker]", 
      RowBox[{
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", "2", ")"}]], "+", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]]}]}]}]},
    {
     RowBox[{
      SubsuperscriptBox["B", "n", 
       RowBox[{"(", "3", ")"}]], "=", "\[AlignmentMarker]", 
      RowBox[{
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", "3", ")"}]], "+", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "2", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
