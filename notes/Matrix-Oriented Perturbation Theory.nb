Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"polyGenDirect", "[", 
    RowBox[{"a_", ",", " ", "b_", ",", " ", 
     RowBox[{"n_", ":", "\[FormalN]"}]}], "]"}], ":=", "\[IndentingNewLine]", 
   
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"b", ">", "a"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"polyGenDirect", "[", 
       RowBox[{"b", ",", " ", "a", ",", " ", "\[FormalN]\[FormalN]"}], "]"}], 
      "/.", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"\[FormalN]\[FormalN]", "->", 
        RowBox[{"(", 
         RowBox[{"n", "+", 
          RowBox[{"(", 
           RowBox[{"a", "-", "b"}], ")"}]}], ")"}]}], "\[IndentingNewLine]", 
       "}"}]}], ",", "\[IndentingNewLine]", 
