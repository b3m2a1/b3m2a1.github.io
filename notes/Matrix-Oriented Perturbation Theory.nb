   3.825789732455204*^9}},ExpressionUUID->"be76407c-0bad-4ecc-bf41-\
dc7ba4492464"],

Cell["\<\
taking the first term, we\[CloseCurlyQuote]ll note by resolution of the \
identity that\
\>", "ExpositoryText",
 CellChangeTimes->{{3.825789696367277*^9, 3.825789700177746*^9}, {
  3.825792667908071*^9, 
  3.825792674583418*^9}},ExpressionUUID->"0d19751f-02df-4f13-8c16-\
6d535e781ea7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", 
     SuperscriptBox["D", 
      RowBox[{"(", "a", ")"}]]], 
    SuperscriptBox["\[CapitalDelta]H", 
     RowBox[{"(", 
      RowBox[{"a", "+", "1"}], ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["P", 
      SuperscriptBox["D", 
       RowBox[{"(", "a", ")"}]]], 
     SuperscriptBox["\[CapitalDelta]H", 
      RowBox[{"(", 
       RowBox[{"a", "+", "1"}], ")"}]], 
     SubscriptBox["P", 
      SuperscriptBox["D", 
       RowBox[{"(", "a", ")"}]]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "k", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     SubscriptBox["P", 
      SuperscriptBox["D", 
       RowBox[{"(", "a", ")"}]]], 
     SuperscriptBox["\[CapitalDelta]H", 
      RowBox[{"(", 
       RowBox[{"a", "+", "1"}], ")"}]], 
     SubscriptBox["P", 
      SuperscriptBox["U", 
       RowBox[{"(", "a", ")"}]]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "k", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"b", "=", "0"}], 
      RowBox[{"a", "-", "1"}]], 
     RowBox[{
      SubscriptBox["P", 
       SuperscriptBox["D", 
        RowBox[{"(", "a", ")"}]]], 
      SuperscriptBox["\[CapitalDelta]H", 
