Cell[CellGroupData[{

Cell["Subspace Considerations", "Subsubsection",
 CellChangeTimes->{{3.825766854573278*^9, 3.82576685674162*^9}, {
  3.82576719833505*^9, 
  3.8257671998427896`*^9}},ExpressionUUID->"3e84b620-3471-4213-be3f-\
35d81eb4c2a2"],

Cell[TextData[{
 "Our inductive hypothesis was that at degeneracy order ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "7acf641d-248a-4247-8b3a-d16d09fd0f47"]
}], "ExpositoryText",
 CellChangeTimes->{{3.825773886887993*^9, 
  3.825773925617532*^9}},ExpressionUUID->"8a637ef1-991e-4063-97c2-\
de51adffe629"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"j", "=", "0"}], "a"], 
    RowBox[{
     SubscriptBox["P", "D"], 
     SuperscriptBox["\[CapitalDelta]H", 
      RowBox[{"(", 
       RowBox[{"a", "-", "j"}], ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", 
          RowBox[{"k", "+", "j"}], ")"}]]},
      "Ket"]}]}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["P", "D"], 
     SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
      RowBox[{"(", "a", ")"}]], 
     SubscriptBox["P", "D"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "k", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "1"}], "a"], "\[VeryThinSpace]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "0"}], 
       RowBox[{"k", "-", "1"}]], 
      RowBox[{
       SubscriptBox["P", "D"], 
       SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
        RowBox[{"(", "j", ")"}]], 
       SubsuperscriptBox["\[CapitalPi]", "U", "n"], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", 
         RowBox[{"k", "+", "a", "-", "j", "-", "i"}], ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]]},
        "Ket"]}]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825726109047275*^9, 3.825726114403275*^9}, {
  3.825726191984178*^9, 3.82572626474254*^9}, {3.825726375705141*^9, 
  3.825726453939332*^9}, {3.8257264989919252`*^9, 3.825726504083993*^9}, {
  3.825727136550562*^9, 
  3.825727143261832*^9}},ExpressionUUID->"5512d09d-3ef6-41c5-a93e-\
83436ea97c56"],

Cell[TextData[{
 "to go to order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "+", "1"}], TraditionalForm]],ExpressionUUID->
  "00f1f691-2214-4322-ac37-abbc54ad458a"],
 " we used ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["P", "D"], 
     SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
      RowBox[{"(", "a", ")"}]], 
     SubscriptBox["P", "D"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", 
          RowBox[{"k", "+", "1"}], ")"}]]},
      "Ket"]}], "=", "\[DoubleStruckZero]"}], TraditionalForm]],
  ExpressionUUID->"e520422f-3ef0-4bf6-8f80-3fe1d2c1efba"],
 ", by degeneracies. We will now consider the case that in ",
 Cell[BoxData[
  FormBox["D", TraditionalForm]],ExpressionUUID->
  "8b09ad3b-3f5d-4187-9a77-aa3d9387c3c9"],
 " there is a degenerate subsubspace, ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],ExpressionUUID->
  "fc501f98-fa5d-4756-bda7-a33ca9cef5d2"],
 ", and a non-degenerate subsubspace ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "ca353cc5-5516-46c4-a16b-cdddbc81d37f"],
 ". As these subspaces are comprised of the eigenvalues of ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["P", "D"], 
   SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
    RowBox[{"(", "a", ")"}]], 
   SubscriptBox["P", "D"]}]],ExpressionUUID->
  "ab86e7fb-72ae-4ca9-8d79-08787f35fee8"],
 " we end up with"
}], "ExpositoryText",
 CellChangeTimes->{{3.825773909686407*^9, 3.825773938820772*^9}, {
  3.825774131070643*^9, 3.825774159322969*^9}, {3.825774333613896*^9, 
  3.8257743830346823`*^9}, {3.825774867344392*^9, 
  3.825774878222856*^9}},ExpressionUUID->"d88ee8cc-c433-4a0f-94d0-\
d6ba9df4bb1a"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "D"], 
