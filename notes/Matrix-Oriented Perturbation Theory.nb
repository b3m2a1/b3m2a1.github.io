Cell["This inner sum can be written as the appropriate dot product", \
"ExpositoryText",
 CellChangeTimes->{{3.8907474222882643`*^9, 
  3.890747435649748*^9}},ExpressionUUID->"ce963731-51d2-456b-aad9-\
b7f9c08474da"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["C", 
     RowBox[{"k", "\[InvisibleSpace]", ";"}], 
     RowBox[{"(", 
      RowBox[{"b", "-", "1"}], ")"}]], "\[CenterDot]", 
    SubsuperscriptBox["A", 
     RowBox[{";", "l"}], 
     RowBox[{"(", "b", ")"}]]}], 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"\[Omega]", "=", 
      RowBox[{"l", "+", "1"}]}], 
     RowBox[{"b", "-", "k"}]], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["c", 
        RowBox[{
         RowBox[{"k", "\[InvisibleSpace]", "\[Omega]"}], "-", "1"}], 
        RowBox[{"(", 
         RowBox[{"b", "-", "1"}], ")"}]], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"b", "-", "1"}], ")"}], 
        SubsuperscriptBox["c", 
         RowBox[{"k", "\[InvisibleSpace]", "\[Omega]"}], 
         RowBox[{"(", 
          RowBox[{"b", "-", "1"}], ")"}]]}], " ", "+", " ", 
       SubsuperscriptBox["c", 
        RowBox[{"k", "-", 
         RowBox[{"1", "\[InvisibleSpace]", "\[Omega]"}]}], 
        RowBox[{"(", 
         RowBox[{"b", "-", "1"}], ")"}]]}], ")"}], 
     SubscriptBox[
      RowBox[{"(", 
       SuperscriptBox["A", 
        RowBox[{"(", "b", ")"}]], ")"}], 
      RowBox[{"\[Omega]", "\[InvisibleSpace]", "l"}]]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.890747436883439*^9, 
  3.8907474744754744`*^9}},ExpressionUUID->"083cafac-fcd8-4103-aca4-\
de545b81c3f4"],

Cell[TextData[{
 "and we do this for all valid values of ",
 Cell[BoxData[
  FormBox["l", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "ecea453a-cd72-47b0-9003-5bee62437e1f"],
 ", meaning we can interpret this coefficient as a part of a matrix \
multiplication by writing"
}], "ExpositoryText",
 CellChangeTimes->{{3.89074748731352*^9, 
  3.8907475062077208`*^9}},ExpressionUUID->"f3959ead-134f-42f6-b479-\
e4c9a5b3fe47"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["C", 
    RowBox[{"(", "b", ")"}]], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["C", 
       RowBox[{";", 
        RowBox[{"\[Omega]", "-", "1"}]}], 
       RowBox[{"(", 
        RowBox[{"b", "-", "1"}], ")"}]], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"b", "-", "1"}], ")"}], 
       SuperscriptBox["C", 
        RowBox[{"(", 
         RowBox[{"b", "-", "1"}], ")"}]]}], " ", "+", " ", 
      SubsuperscriptBox["C", 
       RowBox[{
        RowBox[{"k", "-", "1"}], ";"}], 
       RowBox[{"(", 
        RowBox[{"b", "-", "1"}], ")"}]]}], ")"}], 
    SuperscriptBox["A", 
     RowBox[{"(", "b", ")"}]]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.890651449673889*^9, 3.8906515564067087`*^9}, {
  3.890651593438162*^9, 
  3.8906516033462887`*^9}},ExpressionUUID->"583440f6-a493-4320-878f-\
99a7637474e4"],

Cell[TextData[{
 "and in fact by noting that our definition of ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "010eeb3b-b888-4fc6-a85c-9c01efb92521"],
 " would have its 0th row and column be the identity and by noting that ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["C", 
    RowBox[{"(", 
     RowBox[{"b", "-", "1"}], ")"}]], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "3f8e0f4a-a3d8-4b40-b1b4-13f89114469d"],
 " will have its ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "+", "1"}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "1c20ece9-75d8-4a81-9ae5-325f2c95b295"],
 "th row and column to be entirely zeros, we can pad appropriately and \
construct the entire matrix of polynomial coefficients in ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "d71950c5-00f0-4aa1-84f6-82a257a49aee"],
 " and ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "5267bf52-c5b7-4b91-93f3-2759ac701fd7"],
 " through this single matrix multiplication without considering the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"l", "=", "0"}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "0e20dc58-aa3a-4cd6-9285-18b218326bae"],
 " case separately"
}], "ExpositoryText",
 InitializationCell->True,
 CellChangeTimes->{{3.890748166048771*^9, 
  3.890748300950375*^9}},ExpressionUUID->"764b3f30-b8cf-4650-8f90-\
5a541b1f0f70"],

Cell[TextData[{
 "And in fact this can be reduced ",
 StyleBox["even further",
  FontSlant->"Italic"],
 " by the identity"
}], "ExpositoryText",
 CellChangeTimes->{{3.890762370087017*^9, 
  3.8907623821157084`*^9}},ExpressionUUID->"bf82e79d-9866-434b-91fc-\
0b5205eef260"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox["C", 
       RowBox[{"(", "b", ")"}]], "=", 
      RowBox[{
       SuperscriptBox["Q", 
        RowBox[{"(", "b", ")"}]], "\[InvisibleSpace]", 
       SubsuperscriptBox["S", "1", 
        RowBox[{"(", "b", ")"}]]}]}]},
    {
     RowBox[{
      SubsuperscriptBox["Q", 
       RowBox[{"k", "\[InvisibleSpace]", "\[Omega]"}], 
       RowBox[{"(", "b", ")"}]], "=", 
      RowBox[{
       FractionBox["1", 
        SuperscriptBox["2", "\[Omega]"]], 
       RowBox[{"(", GridBox[{
          {"b"},
          {
           RowBox[{"b", "-", "\[Omega]"}]}
         },
         GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
       RowBox[{
        SubscriptBox["S", "1"], "(", 
        RowBox[{
         RowBox[{"b", "-", "\[Omega]"}], ",", " ", "k"}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.890762383324316*^9, 3.890762407449286*^9}, {
