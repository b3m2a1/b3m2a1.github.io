       SubscriptBox["P", "D"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", 
            RowBox[{"k", "+", "1"}], ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       RowBox[{
        SubscriptBox["P", "G"], 
        SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
         RowBox[{"(", "a", ")"}]], 
        SubscriptBox["P", "G"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", 
             RowBox[{"k", "+", "1"}], ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        SubscriptBox["P", "V"], 
        SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
         RowBox[{"(", "a", ")"}]], 
        SubscriptBox["P", "V"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", 
             RowBox[{"k", "+", "1"}], ")"}]]},
         "Ket"]}]}]}]},
    {
