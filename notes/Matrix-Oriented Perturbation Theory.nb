Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], "(", "\[VeryThinSpace]", 
     RowBox[{
      UnderoverscriptBox["\[Product]", 
       RowBox[{"i", "=", "1"}], 
       RowBox[{"r", "-", "1"}]], 
      SubsuperscriptBox["\[CapitalOmega]", "m", 
       RowBox[{"(", 
        SubscriptBox["p", "i"], ")"}]]}], ")"}], 
    SubsuperscriptBox["\[CapitalDelta]H", "m", 
     RowBox[{"(", 
      StyleBox[
       SubscriptBox["p", "r"],
       FontSize->14], ")"}]], 
    TemplateBox[{
      RowBox[{"\[VeryThinSpace]", 
        SuperscriptBox["m", 
         RowBox[{"(", "0", ")"}]]}]},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
