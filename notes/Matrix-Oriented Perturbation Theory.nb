Cell[CellGroupData[{

Cell["Notations", "Subsection",
 CellChangeTimes->{{3.7928509876223907`*^9, 
  3.792850988662053*^9}},ExpressionUUID->"77e2457f-523d-472a-bc44-\
e352d960a57e"],

Cell[TextData[{
 "Since these derivatives involve a large number of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", "\[CenterDot]"], "\[CenterDot]"}], 
   TraditionalForm]],ExpressionUUID->"7fe4eab3-6865-47ca-a339-a08159f3f5a8"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", 
    RowBox[{"\[CenterDot]", 
     RowBox[{"\[Rule]", "\[CenterDot]"}]}]], TraditionalForm]],ExpressionUUID->
  "b6222b33-dbac-45a3-9adf-04a0c21bb1ad"],
 ", and \[CenterDot]\[CircleDot]\[CenterDot] operations \
we\[CloseCurlyQuote]ll introduce a convenient shorthand where"
}], "Text",
