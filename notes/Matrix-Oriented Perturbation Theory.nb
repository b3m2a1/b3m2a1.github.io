Cell[TextData[{
 "The general strategy for this proof would be the same as for Property 6, \
where we show it holds for tensors of dimension one and then generalize \
upwards via induction on the dimension of ",
 StyleBox["A",
  FontWeight->"Bold"],
 " or ",
 StyleBox["C",
  FontWeight->"Bold"],
 ". In the interest of time, we will simply show that it operates for dim(A)=1"
}], "Text",
 CellChangeTimes->{{3.769990693256041*^9, 3.7699906932597523`*^9}, {
   3.7699908437621183`*^9, 3.769990909084791*^9}, {3.7699916784129753`*^9, 
