   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8277659544631577`*^9, 3.8277659697965612`*^9}, {
  3.82776603285312*^9, 3.8277660449531803`*^9}, {3.827766078643608*^9, 
