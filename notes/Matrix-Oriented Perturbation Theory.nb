        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "2", ")"}]]}]}], ")"}], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], "+", 
