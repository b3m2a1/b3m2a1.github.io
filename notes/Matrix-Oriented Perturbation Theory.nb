Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], 
    RowBox[{
     SubscriptBox["\[GothicCapitalF]", "n"], "(", 
     RowBox[{"A", ",", " ", "b", ",", " ", "c"}], ")"}], 
    TemplateBox[{
      SuperscriptBox["m", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], 
    RowBox[{
     SubscriptBox["\[GothicCapitalF]", "m"], "(", 
     RowBox[{"D", ",", " ", "e", ",", " ", "f"}], ")"}], 
    TemplateBox[{
      SuperscriptBox["m", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"], 
    TemplateBox[{
      SuperscriptBox["m", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], 
    SubsuperscriptBox["\[GothicCapitalO]", "n", 
     RowBox[{"(", "x", ")"}]]}], 
   SubsuperscriptBox["\[VerticalSeparator]", "y", "Y"], 
   RowBox[{
    SubscriptBox["\[CapitalPi]", "n"], 
    SubscriptBox["\[CapitalPi]", "m"], " ", 
    SubsuperscriptBox["\[GothicCapitalO]", "m", 
     RowBox[{"(", "X", ")"}]]}], 
   SubsuperscriptBox["\[VerticalSeparator]", "z", "Z"], 
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.827876086077504*^9, 3.827876152374495*^9}, {
   3.8278762528083973`*^9, 3.8278763040383053`*^9}, {3.8279278647896147`*^9, 
   3.827927873630622*^9}, 3.827931272578971*^9, 3.827932583565517*^9, {
