91d6d922b714"],

Cell[TextData[{
 "now we would like to extend this to include momenta as well, considering \
that the key portion of the momentum is defined as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["a", "+"], " ", "\[Minus]", " ", "a"}], ")"}], 
   TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "055697ad-41bd-48ac-b33f-415a8a079c1e"],
 ", this leads immediately to the relation"
}], "ExpositoryText",
 CellChangeTimes->{{3.891103464897048*^9, 3.8911034775998793`*^9}, {
  3.891103706585361*^9, 3.8911037147861013`*^9}, {3.891103776025969*^9, 
