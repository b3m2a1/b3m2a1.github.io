cd26559571f4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox["\[PartialD]", 
     RowBox[{"\[PartialD]", 
      StyleBox["x",
       FontSlant->"Italic"]}]], 
    SuperscriptBox[
     StyleBox["A",
      FontWeight->"Bold"], 
     RowBox[{"n", "\[Rule]", "m"}]]}], "=", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", 
        StyleBox["x",
         FontSlant->"Italic"]}]], 
      StyleBox["A",
       FontWeight->"Bold"]}], 
     StyleBox[")",
      FontWeight->"Bold"]}], 
    RowBox[{"n", "\[Rule]", "m"}]]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.792798260118443*^9, 
