   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"\[Omega]", "=", "0"}], 
     RowBox[{"b", "-", "k"}]], " ", 
    RowBox[{
     FractionBox["1", 
      SuperscriptBox["2", "\[Omega]"]], 
