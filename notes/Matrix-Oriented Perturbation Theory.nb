 "Now at order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "+", "1"}], TraditionalForm]],ExpressionUUID->
  "a61a461b-292d-4461-b9da-3c9c83be2c7d"],
 " we have"
}], "ExpositoryText",
