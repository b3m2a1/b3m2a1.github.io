  3.7700015697728777`*^9}},ExpressionUUID->"a4528128-5099-407b-bcb0-\
111fdd070d44"],

Cell[TextData[{
 "Given tensors ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["A",
     FontWeight->"Bold"], "ijkl"], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"f09c77e5-93b5-4f06-bc25-bbd2cc493a8e"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["B",
     FontWeight->"Bold"], "l\[Alpha]\[Beta]\[Gamma]"], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "25d5b679-c3c0-4e47-b80c-f3f8f30bd5d9"],
 " we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.76998344539023*^9, 
  3.7699834861098747`*^9}},ExpressionUUID->"444ed753-59fc-448c-a87b-\
59e115d2ed56"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"A", "\[CircleDot]", "B"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     SubscriptBox["A", "ijkl"], 
     SubscriptBox["B", "l\[Alpha]\[Beta]\[Gamma]"]}], "=", 
    SubscriptBox[
     RowBox[{"(", "AB", ")"}], "ijk\[Alpha]\[Beta]\[Gamma]"]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
