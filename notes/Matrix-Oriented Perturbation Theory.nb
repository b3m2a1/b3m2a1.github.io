Cell[TextData[{
 "now we will note that we can express ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox["P", "D", 
    RowBox[{"(", "\[Beta]", ")"}]], 
   SuperscriptBox["\[ScriptCapitalH]", 
    RowBox[{"(", "\[Beta]", ")"}]], 
   SubsuperscriptBox["P", "D", 
    RowBox[{"(", "\[Beta]", ")"}]]}]],
  CellChangeTimes->{{3.826980227332789*^9, 3.826980261304994*^9}},
  ExpressionUUID->"afbb28d0-a08c-4388-97c2-a80c365151d6"],
 " in the eigenstates of ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox["P", "D", 
    RowBox[{"(", "a", ")"}]], 
   SuperscriptBox["\[ScriptCapitalH]", 
    RowBox[{"(", "a", ")"}]], 
   SubsuperscriptBox["P", "D", 
    RowBox[{"(", "a", ")"}]]}]],
  CellChangeTimes->{{3.826980227332789*^9, 3.826980261304994*^9}},
  ExpressionUUID->"c52047b1-b2a6-4e04-95e9-47ca7cf04096"],
 " by writing "
}], "ExpositoryText",
 CellChangeTimes->{{3.826983347609926*^9, 3.8269834086616096`*^9}, {
  3.826983447156496*^9, 3.826983458539146*^9}, {3.82698349878372*^9, 
  3.826983507084311*^9}},ExpressionUUID->"a030313f-cfbc-42c4-a73d-\
d2677a0172fe"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["P", "D", 
          RowBox[{"(", "\[Beta]", ")"}]], 
         SuperscriptBox["\[ScriptCapitalH]", 
          RowBox[{"(", "\[Beta]", ")"}]], 
         SubsuperscriptBox["P", "D", 
          RowBox[{"(", "\[Beta]", ")"}]]}], ")"}], 
       RowBox[{"i", "\[InvisibleSpace]", "j"}]], "=", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["i", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], 
       SubsuperscriptBox["P", "D", 
        RowBox[{"(", "\[Beta]", ")"}]], 
       SuperscriptBox["\[ScriptCapitalH]", 
        RowBox[{"(", "\[Beta]", ")"}]], 
       SubsuperscriptBox["P", "D", 
        RowBox[{"(", "\[Beta]", ")"}]], 
       TemplateBox[{
         SuperscriptBox["j", 
          RowBox[{"\[VeryThinSpace]", 
            RowBox[{"(", "0", ")"}]}]]},
        "Ket"]}]}]},
    {
     RowBox[{"=", 
      TagBox[GridBox[{
         {"\[Piecewise]", GridBox[{
            {
             RowBox[{
              TemplateBox[{
                SuperscriptBox["i", 
                 RowBox[{"(", "0", ")"}]]},
               "Bra"], 
              SuperscriptBox["\[ScriptCapitalH]", 
               RowBox[{"(", "\[Beta]", ")"}]], 
              TemplateBox[{
                SuperscriptBox["j", 
                 RowBox[{"\[VeryThinSpace]", 
                   RowBox[{"(", "0", ")"}]}]]},
               "Ket"]}], 
             RowBox[{
              TemplateBox[{
                SuperscriptBox["i", 
                 RowBox[{"\[VeryThinSpace]", 
                   RowBox[{"(", "0", ")"}]}]]},
               "Ket"], ",", 
              RowBox[{
               TemplateBox[{
                 SuperscriptBox["j", 
                  RowBox[{"\[VeryThinSpace]", 
                    RowBox[{"(", "0", ")"}]}]]},
                "Ket"], "\[Element]", 
               SuperscriptBox["D", 
                RowBox[{"(", "\[Beta]", ")"}]]}]}]},
            {"0", "else"}
           },
           AllowedDimensions->{2, Automatic},
           Editable->True,
           
           GridBoxAlignment->{
            "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
             "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
           
