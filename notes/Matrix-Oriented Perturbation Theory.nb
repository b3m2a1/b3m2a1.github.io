 CellChangeTimes->{{3.826031753242302*^9, 3.826031793531252*^9}, {
  3.826031856935907*^9, 
  3.826031865984972*^9}},ExpressionUUID->"d70ba875-f097-484f-b73b-\
a4a8edfc4559"],

Cell[BoxData[
 FormBox[
  RowBox[{"q", "=", 
   RowBox[{
    SubscriptBox["\[Pi]", "D"], "(", 
    RowBox[{
     UnderoverscriptBox["\[Product]", 
      RowBox[{"j", "=", "1"}], "D"], " ", 
     SuperscriptBox[
      SubscriptBox["q", "j"], 
      SubscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox["\[Lambda]", "D", "M"], ")"}], "j"]]}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826031867361435*^9, 3.826031907329975*^9}, {
  3.8260319951189003`*^9, 3.826032032132909*^9}, {3.826032098376173*^9, 
  3.826032102008041*^9}, {3.826032344202269*^9, 
  3.8260323482362967`*^9}},ExpressionUUID->"080e2a05-011d-47d1-8721-\
881996104c5a"],

Cell["so we have an expansion over partitions and permutations.", \
"ExpositoryText",
 CellChangeTimes->{{3.826032118324605*^9, 
  3.8260321430919313`*^9}},ExpressionUUID->"6e830f39-5e5e-4cd3-b175-\
7f1dd39c001e"],

Cell["\<\
When we look at how one of these terms operates on a H.O. function, we get \
restricted numbers of terms, which will come from our selection rule\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8260321483586903`*^9, 3.826032169289752*^9}, {
  3.826032274737743*^9, 3.826032306499321*^9}, {3.8260323764008207`*^9, 
  3.826032379893981*^9}},ExpressionUUID->"efd65995-c296-4bb6-9d4b-\
35c0c67f7d6f"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"s", "(", "q", ")"}], "=", 
      RowBox[{
       SubscriptBox["\[Pi]", "D"], "(", 
       RowBox[{
        UnderoverscriptBox["\[CircleTimes]", 
         RowBox[{"j", "=", "1"}], "D"], 
        RowBox[{"s", "(", 
         SuperscriptBox[
          SubscriptBox["q", "j"], 
          SubscriptBox[
           RowBox[{"(", 
            SubsuperscriptBox["\[Lambda]", "D", "M"], ")"}], "j"]], ")"}]}], 
       ")"}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       SubscriptBox["\[Pi]", "D"], "(", 
       RowBox[{
        UnderoverscriptBox["\[CircleTimes]", 
         RowBox[{"j", "=", "1"}], "D"], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", "1"}], ")"}], 
         SubscriptBox[
          RowBox[{"(", 
           SubsuperscriptBox["\[Lambda]", "D", "M"], ")"}], "j"]]}], ")"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826032308517037*^9, 3.8260324168083277`*^9}, {
  3.8260335840206842`*^9, 
  3.826033588597066*^9}},ExpressionUUID->"7a8f3008-bebf-40ba-a0ff-\
b63737cd71b2"],

Cell["\<\
where that exponentiation just means iterated direct summation\
\>", "ExpositoryText",
 CellChangeTimes->{{3.826032421581115*^9, 
  3.8260324628299522`*^9}},ExpressionUUID->"8d264e44-cc6a-4eca-ba3c-\
89749338d29c"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], ")"}], "1"], "=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", "1"}], ")"}]}]},
    {
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], ")"}], "2"], "=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "2"}], ",", " ", "0", ",", " ", "2"}], ")"}]}]},
    {
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], ")"}], "3"], "=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "3"}], ",", " ", 
        RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "3"}], ")"}]}]},
    {
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], ")"}], "4"], "=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "4"}], ",", " ", 
        RowBox[{"-", "2"}], ",", " ", "0", ",", " ", "2", ",", " ", "4"}], 
       ")"}]}]},
    {"..."}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826032425799528*^9, 
  3.826032540284781*^9}},ExpressionUUID->"45dc2ccf-ed5a-4590-9e8e-\
0556550b9bd4"],

Cell["each of these, clearly, can just be written as", "ExpositoryText",
 CellChangeTimes->{{3.826032713558223*^9, 3.826032735376361*^9}, {
  3.826033165686469*^9, 3.826033169437765*^9}, {3.826033260987899*^9, 
  3.826033261151022*^9}},ExpressionUUID->"8ef35e78-d610-4e82-b0ad-\
711d81500eb3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], ",", " ", "1"}], ")"}], "m"], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "m"}], " ", "+", " ", 
     RowBox[{"2", 
      RowBox[{"i", " ", ":", " ", 
       RowBox[{"i", "\[Element]", 
        SubscriptBox["\[DoubleStruckCapitalN]", 
         RowBox[{"2", "\[InvisibleSpace]", "m"}]]}]}]}]}], "}"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826032736802548*^9, 3.8260327368070803`*^9}, {
   3.826032768392455*^9, 3.8260328355070467`*^9}, 3.82603314494932*^9, {
   3.826033177692789*^9, 
   3.826033255372902*^9}},ExpressionUUID->"900672ba-652b-4e7b-9073-\
39449c667691"],

Cell["\<\
or can be mapped onto a binary sequence representing the actual way this was \
calculated\
\>", "ExpositoryText",
 CellChangeTimes->{{3.826033263207673*^9, 3.8260332874238787`*^9}, {
  3.8260333626091003`*^9, 
  3.826033381307165*^9}},ExpressionUUID->"c7159656-1826-4ff2-8126-\
c3392f9fb29b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], ",", " ", "1"}], ")"}], "m"], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      UnderscriptBox["\[Sum]", "i"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       SubscriptBox["l", "i"]]}], " ", ":", " ", 
     RowBox[{"l", "\[Element]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"bin", "(", 
         RowBox[{
          RowBox[{
           SuperscriptBox["2", "n"], "-", "1"}], ",", " ", "m"}], ")"}], " ", 
        ":", " ", 
        RowBox[{"n", "\[Element]", 
         SubscriptBox["\[DoubleStruckCapitalN]", 
          RowBox[{"2", "\[InvisibleSpace]", "m"}]]}]}], "}"}]}]}], " ", 
    "}"}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826033279198063*^9, 
  3.826033399004073*^9}},ExpressionUUID->"b84aeb7f-63d6-4747-8a39-\
fc29e891d0a5"],

Cell[TextData[{
 "in any case, this shows we can map the set of selection rules for a given \
operator which maps to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[Pi]", "D"], ",", " ", 
     SubsuperscriptBox["\[Lambda]", "D", "M"]}], ")"}], TraditionalForm]],
  ExpressionUUID->"207286ff-1170-4316-8dc0-b6a558c0bf36"],
 " as"
}], "ExpositoryText",
 CellChangeTimes->{{3.826033441278563*^9, 3.826033457186302*^9}, {
  3.82603379750562*^9, 
  3.826033820001945*^9}},ExpressionUUID->"e577d0d5-0eb1-4ff9-9c8d-\
02f812ca926f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"s", "(", "q", ")"}], "=", 
   RowBox[{
    SubscriptBox["\[Pi]", "D"], "(", 
    RowBox[{
     UnderoverscriptBox["\[Union]", 
      RowBox[{"j", "=", "1"}], "D"], " ", 
     RowBox[{"{", " ", 
      SubsuperscriptBox["r", 
       SubscriptBox["\[Xi]", "j"], 
       SubscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["\[Lambda]", "D", "M"], ")"}], "j"]], "}"}]}], 
    ")"}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826033468201819*^9, 3.826033492730589*^9}, {
   3.826033534397276*^9, 3.826033640708685*^9}, {3.826033693847073*^9, 
   3.826033715122205*^9}, {3.8260337472533083`*^9, 3.826033748175609*^9}, {
   3.82603383254818*^9, 3.826033832885519*^9}, 3.8260338653475943`*^9, {
   3.826033974970373*^9, 3.8260339754702587`*^9}, 
   3.826034632483623*^9},ExpressionUUID->"5d40ca09-446c-4e34-9bfe-\
83bb9cddb64f"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["r", 
    SubscriptBox["\[Xi]", "j"], 
    SubscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Lambda]", "D", "M"], ")"}], "j"]], 
   TraditionalForm]],
  CellChangeTimes->{{3.826033468201819*^9, 3.826033492730589*^9}, {
   3.826033534397276*^9, 3.826033640708685*^9}, {3.826033693847073*^9, 
   3.826033715122205*^9}, {3.8260337472533083`*^9, 3.826033748175609*^9}},
  ExpressionUUID->"1e93744c-0da9-4927-af1c-5b85ce0e52b6"],
 " is just the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[Xi]", "j"], "th"], TraditionalForm]],ExpressionUUID->
  "3c1351ee-2c46-455a-ba6b-500dd8014356"],
 " element of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], ",", " ", "1"}], ")"}], 
    SubscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Lambda]", "D", "M"], ")"}], "j"]], 
   TraditionalForm]],ExpressionUUID->"195c6215-f4a5-4c0d-a29a-bb805c905785"],
 " and we\[CloseCurlyQuote]re taking the union over every possible combo of \
indices, i.e."
}], "ExpositoryText",
 CellChangeTimes->{{3.82603375300914*^9, 3.826033784570825*^9}, {
  3.826033835667077*^9, 3.8260338419453382`*^9}, {3.826033942743932*^9, 
  3.8260339802673283`*^9}, {3.8260346275396957`*^9, 
  3.82603463002921*^9}},ExpressionUUID->"86da2197-3dd1-415b-9feb-\
79ca5306a8a1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Xi]", "\[Element]", 
    RowBox[{
     RowBox[{
      UnderoverscriptBox["\[CircleTimes]", 
       RowBox[{"i", "=", "1"}], "D"], 
      SubscriptBox["\[DoubleStruckCapitalN]", 
       RowBox[{"2", "\[InvisibleSpace]", 
        SubscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox["\[Lambda]", "D", "M"], ")"}], "j"]}]]}], "-", 
     "1"}]}], " ", "=", " ", 
   RowBox[{"\[CapitalXi]", "(", 
    SubsuperscriptBox["\[Lambda]", "D", "M"], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.82603396925994*^9, 3.826034014733232*^9}, {
  3.826034578100769*^9, 3.8260346224554358`*^9}, {3.82606335753021*^9, 
  3.826063390149638*^9}},ExpressionUUID->"ba1081ed-3932-4602-bca0-\
e935a81292fa"],

Cell[TextData[{
 "this then allows us to map every element of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"s", "(", "q", ")"}], TraditionalForm]],ExpressionUUID->
  "b45c033d-b387-4bcf-b6ef-0b7c8a7d6c45"],
 " as "
}], "ExpositoryText",
 CellChangeTimes->{{3.8260345288705072`*^9, 
  3.826034554025269*^9}},ExpressionUUID->"64562b8a-69ed-48f6-94f4-\
66bf15bd9d94"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     RowBox[{
       SubscriptBox["\[CapitalDelta]s", "1"], ",", " ", 
       SubscriptBox["\[CapitalDelta]s", "2"], ",", " ", "...", ",", " ", 
       SubscriptBox["\[CapitalDelta]s", "D"]}]},
    "Ket"], " ", "~", " ", 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[Pi]", "D"], ",", " ", 
     SubsuperscriptBox["\[Lambda]", "D", "M"], ",", " ", 
     RowBox[{"\[Xi]", "(", 
      SubsuperscriptBox["\[Lambda]", "D", "M"], ")"}]}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826034556235104*^9, 3.826034570650631*^9}, {
  3.826034610607308*^9, 
  3.82603464284196*^9}},ExpressionUUID->"82a2e462-93a0-4656-afc2-\
19fd91855d90"],

Cell["so then when we do ", "ExpositoryText",
 CellChangeTimes->{{3.8260346767492857`*^9, 
  3.826034680574009*^9}},ExpressionUUID->"b8af4317-9e4c-4df3-90ea-\
9981f872347e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      RowBox[{
        SubscriptBox["n", "1"], ",", " ", 
        SubscriptBox["n", "2"], ",", " ", "...", ",", " ", 
        SubscriptBox["n", "D"]}]},
     "Ket"], " ", "+", " ", 
    TemplateBox[{
      RowBox[{
        SubscriptBox["\[CapitalDelta]s", "1"], ",", " ", 
        SubscriptBox["\[CapitalDelta]s", "2"], ",", " ", "...", ",", " ", 
        SubscriptBox["\[CapitalDelta]s", "D"]}]},
     "Ket"]}], " ", "=", " ", 
   TemplateBox[{
     RowBox[{
       SubscriptBox["m", "1"], ",", " ", 
       SubscriptBox["m", "2"], ",", " ", "...", ",", " ", 
       SubscriptBox["m", "D"]}]},
    "Ket"]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8260346900652933`*^9, 
  3.826034709111752*^9}},ExpressionUUID->"5e36e742-177a-49a0-90d8-\
c63fc3aead38"],

Cell["we end up mapping to ", "ExpositoryText",
 CellChangeTimes->{{3.826034752805159*^9, 3.826034756364252*^9}, {
  3.82603485707034*^9, 
  3.826034858315859*^9}},ExpressionUUID->"4286c119-c59b-4db8-9a5e-\
664d5229ce24"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     RowBox[{
       SubscriptBox["m", "1"], ",", " ", 
       SubscriptBox["m", "2"], ",", " ", "...", ",", " ", 
       SubscriptBox["m", "D"]}]},
    "Ket"], " ", "~", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        SuperscriptBox["\[Pi]", 
         RowBox[{"(", "1", ")"}]], "D"], ",", " ", 
       SubsuperscriptBox[
        SuperscriptBox["\[Lambda]", 
         RowBox[{"(", "1", ")"}]], "D", "N"]}], ")"}], ",", " ", 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["\[Pi]", "D", 
        RowBox[{"(", "2", ")"}]], ",", " ", 
       SubsuperscriptBox[
        SuperscriptBox["\[Lambda]", 
         RowBox[{"(", "2", ")"}]], "D", "M"], ",", " ", 
       RowBox[{"\[Xi]", "(", 
        SubsuperscriptBox[
         SuperscriptBox["\[Lambda]", 
          RowBox[{"(", "2", ")"}]], "D", "M"], ")"}]}], ")"}]}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8260348637657213`*^9, 3.826034921526792*^9}, {
  3.826062679434873*^9, 3.8260626835787287`*^9}, {3.8260637273792133`*^9, 
  3.826063767140523*^9}},ExpressionUUID->"5e8defc7-e9d7-447b-bb2f-\
e0e3e06ed5cb"],

Cell["\<\
and then the question is how do we remap this back to a form like \
\>", "ExpositoryText",
 CellChangeTimes->{{3.826034923761095*^9, 
  3.826034937031777*^9}},ExpressionUUID->"91fcc1f9-1552-4db6-bfa3-\
090408dfd665"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", 
   RowBox[{
    SubscriptBox["\[Pi]", "D"], ",", " ", 
    SubsuperscriptBox["\[Lambda]", "D", "L"]}], ")"}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8260349434251204`*^9, 
  3.8260349628745213`*^9}},ExpressionUUID->"fb0ab8c9-3739-45f7-82f6-\
adfd1c9e71a0"],

Cell[TextData[{
 "where ",
 StyleBox["L",
  FontSlant->"Italic"],
 " is somehow related to ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],ExpressionUUID->
  "e41d3761-bd86-4894-aea2-80f6d2b5307f"],
 " and ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],ExpressionUUID->
  "141d90af-4792-4b99-a6b2-3e67d4b5e7e8"],
 " and this new ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Pi]", "D"], TraditionalForm]], "ExpositoryText",
  ExpressionUUID->"c40841d3-b125-49de-8bb8-8ea80dba34b6"],
 " is related to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SubscriptBox["\[Pi]", "1"], "D"], TraditionalForm]],ExpressionUUID->
  "c22085ff-8e07-4269-b7f9-6b6b14695f98"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SubscriptBox["\[Pi]", "2"], "D"], TraditionalForm]],ExpressionUUID->
  "10bfabac-9a36-4814-8d95-00483f00c059"],
 " , and ",
 Cell[BoxData[
  FormBox["\[Xi]", TraditionalForm]],ExpressionUUID->
  "2a9a6e3f-65a0-43ea-9631-75664b386dea"],
 "..."
}], "ExpositoryText",
 CellChangeTimes->{{3.826034969223936*^9, 
  3.8260350167736797`*^9}},ExpressionUUID->"0119b117-0ee3-4d8a-a806-\
51990c6e967b"],

Cell[TextData[{
 "Starting out with the absolute basics, we know for a partition ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    SubscriptBox["\[Lambda]", "2"], "D", "M"], TraditionalForm]],
  CellChangeTimes->{{3.8260348637657213`*^9, 3.826034921526792*^9}},
  ExpressionUUID->"d0ad4a83-cbb0-45bf-8b21-0c4dda87ce19"],
 ", the total number of quanta changed is in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     RowBox[{"-", "M"}], ",", " ", "M"}], "]"}], TraditionalForm]],
  ExpressionUUID->"21bf555d-6208-43a4-ac4b-98732df6e7f4"],
 ", corresponding to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Xi]", " ", "=", " ", 
    RowBox[{"(", 
     RowBox[{"0", ",", " ", "0", ",", " ", 
      RowBox[{"0", "..."}]}], " ", ")"}]}], TraditionalForm]],ExpressionUUID->
  "d9a02b65-46a2-4fef-a43a-f679009b05b2"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Xi]", " ", "=", " ", 
    RowBox[{
     RowBox[{"2", 
      SubsuperscriptBox[
       SubscriptBox["\[Lambda]", "2"], "D", "M"]}], "-", "1"}]}], 
   TraditionalForm]],ExpressionUUID->"56fc8912-6753-4a02-bdcb-3ea479e1ae35"],
 " respectively, for the H.O. This means we have ",
 Cell[BoxData[
  FormBox[
   RowBox[{"L", " ", "\[Element]", " ", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"N", "-", "M"}], ",", " ", 
      RowBox[{"N", "+", "M"}]}], "]"}]}], TraditionalForm]],ExpressionUUID->
  "87c7f8f4-99d2-4654-b569-f223c09608e9"],
 " but of course the question is ",
 StyleBox["which",
  FontSlant->"Italic"],
 " specifically."
}], "ExpositoryText",
 CellChangeTimes->{{3.826062191595579*^9, 3.826062193083878*^9}, {
  3.826062266186692*^9, 3.826062398248514*^9}, {3.8260624987444*^9, 
  3.826062538634816*^9}, {3.826062694104965*^9, 3.826062730992025*^9}, {
  3.8260633630893803`*^9, 
  3.8260633971534348`*^9}},ExpressionUUID->"adef2300-8851-4346-a299-\
b3ad65ce039f"],

Cell["\<\
For this, we\[CloseCurlyQuote]ll think algorithmically about what\
\[CloseCurlyQuote]s happening. First off, thinking about the sequence of \
changes we have, excluding the permutation, we have\
\>", "ExpositoryText",
 CellChangeTimes->{{3.826062732692277*^9, 3.826062769829011*^9}, {
  3.826062841268936*^9, 
  3.8260628524305487`*^9}},ExpressionUUID->"43c92835-5f85-40ee-8800-\
1561413a64dd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[CapitalDelta]s", "i"], "=", 
   RowBox[{
    RowBox[{"-", 
     SubscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[Lambda]", "D", "M"], ")"}], "i"]}], " ", "+", " ", 
    RowBox[{"2", " ", 
     SubscriptBox[
      RowBox[{"\[Xi]", "(", 
       SubsuperscriptBox["\[Lambda]", "D", "M"], ")"}], "i"]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826062771493503*^9, 3.8260627715008993`*^9}, {
  3.826062862709147*^9, 3.8260628771719522`*^9}, {3.826062909176502*^9, 
  3.8260629427725077`*^9}, {3.826063172620524*^9, 3.8260631755275583`*^9}, {
  3.8260634046472673`*^9, 3.826063407048423*^9}, {3.82606416837127*^9, 
  3.826064171863813*^9}},ExpressionUUID->"e0092acd-7ce8-46cf-8662-\
36fe574fab10"],

Cell["which means the change in quanta is given by ", "ExpositoryText",
 CellChangeTimes->{{3.826062551166133*^9, 3.8260625545725203`*^9}, {
   3.826062612141593*^9, 3.82606262287442*^9}, 3.826062693301128*^9, {
   3.826062966632821*^9, 3.826062968344265*^9}, {3.8260630028200703`*^9, 
   3.8260630117584553`*^9}},ExpressionUUID->"769b93f7-2a9e-4cd1-ae80-\
20a6c122e211"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{"\[CapitalDelta]M", "=", 
      RowBox[{
       UnderscriptBox["\[Sum]", "i"], 
       SubscriptBox["\[CapitalDelta]s", "i"]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        UnderscriptBox["\[Sum]", "i"], 
        RowBox[{"-", 
         SubscriptBox[
          RowBox[{"(", 
           SubsuperscriptBox["\[Lambda]", "D", "M"], ")"}], "i"]}]}], " ", 
       "+", " ", 
       RowBox[{"2", " ", 
        SubscriptBox[
         RowBox[{"\[Xi]", "(", 
          SubsuperscriptBox["\[Lambda]", "D", "M"], ")"}], "i"]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{"-", "M"}], "+", 
       RowBox[{
        UnderscriptBox[
         RowBox[{"2", "\[Sum]"}], "i"], 
        SubscriptBox[
         RowBox[{"\[Xi]", "(", 
          SubsuperscriptBox["\[Lambda]", "D", "M"], ")"}], "i"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826063032567596*^9, 3.8260630480233717`*^9}, {
   3.8260630989473248`*^9, 3.826063115628173*^9}, {3.82606319604793*^9, 
   3.826063198680794*^9}, {3.826063232343252*^9, 3.826063242523925*^9}, {
   3.826063310649707*^9, 3.8260633395259857`*^9}, {3.826063408315073*^9, 
   3.8260634179978333`*^9}, 3.826063554323688*^9, {3.8260641631961823`*^9, 
   3.826064174263294*^9}},ExpressionUUID->"4512cecc-679d-4ce4-ab9a-\
518cf72bd973"],

Cell[TextData[{
 "and since ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"\[Xi]", "(", 
     SubsuperscriptBox[
      SubscriptBox["\[Lambda]", "2"], "D", "M"], ")"}], "i"], 
   TraditionalForm]],
  CellChangeTimes->{{3.826063032567596*^9, 3.8260630480233717`*^9}, {
   3.8260630989473248`*^9, 3.826063115628173*^9}},ExpressionUUID->
  "f2ebecc8-055e-42e0-a1b0-7e4920754a2f"],
 " is restricted to integer values, the possible changes in quanta are \
restricted to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     RowBox[{"-", "M"}], ",", " ", 
     RowBox[{
      RowBox[{"-", "M"}], "+", "2"}], ",", " ", "...", ",", " ", 
     RowBox[{"M", "-", "2"}], ",", " ", "M"}], "]"}], TraditionalForm]],
  ExpressionUUID->"793b08bc-4e74-45ad-b03a-b2d45430f654"]
}], "ExpositoryText",
 InitializationCell->True,
 CellChangeTimes->{{3.826063140160857*^9, 3.826063154550684*^9}, {
  3.8260632050492687`*^9, 3.826063212106859*^9}, {3.826063294017448*^9, 
  3.8260632943461037`*^9}},ExpressionUUID->"6d4454a7-402d-407f-9023-\
7e1acaae9985"],

Cell["\<\
That, at least, is straightforward! Obviously which case depends on which \
\[Xi] we pull.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.826063594495049*^9, 
  3.8260636381340218`*^9}},ExpressionUUID->"49395097-8bd1-4c1d-a947-\
5a3da738c7a6"],

Cell[TextData[{
 "More annoying is to figure out which ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Lambda]", "D", "L"], TraditionalForm]],
  CellChangeTimes->{{3.8260349434251204`*^9, 3.8260349628745213`*^9}},
  ExpressionUUID->"11a0387b-e7a2-48d6-a335-b56c4dc64843"],
 " we\[CloseCurlyQuote]ll end up with. For that, we note that when we write"
}], "ExpositoryText",
 CellChangeTimes->{{3.826063609242462*^9, 3.8260636097060003`*^9}, {
  3.826063682414954*^9, 3.826063722701332*^9}, {3.8260637777386713`*^9, 
  3.8260637988093243`*^9}},ExpressionUUID->"3d66dfde-4eba-4e63-820b-\
6704ec0496f1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     RowBox[{
       SubscriptBox["n", "1"], ",", " ", 
       SubscriptBox["n", "2"], ",", " ", "...", ",", " ", 
       SubscriptBox["n", "D"]}]},
    "Ket"], "~", 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox[
      SuperscriptBox["\[Pi]", 
       RowBox[{"(", "1", ")"}]], "D"], ",", " ", 
     SubsuperscriptBox[
      SuperscriptBox["\[Lambda]", 
       RowBox[{"(", "1", ")"}]], "D", "N"]}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826063800045217*^9, 
  3.826063816989777*^9}},ExpressionUUID->"713b450b-9e9c-4949-bc0e-\
0e438712aa5d"],

Cell["we are defining this relation by", "ExpositoryText",
 CellChangeTimes->{{3.82606382044271*^9, 
  3.826063827235052*^9}},ExpressionUUID->"2c79a5da-53f4-4917-87bd-\
11259adbe13b"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["n", "i"], "=", 
      SubscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         SuperscriptBox["\[Lambda]", 
          RowBox[{"(", "1", ")"}]], "D", "N"], ")"}], "j"]}]},
    {
     RowBox[{"j", "=", 
      SubscriptBox[
       RowBox[{"(", 
        SubscriptBox[
         SuperscriptBox["\[Pi]", 
          RowBox[{"(", "1", ")"}]], "D"], ")"}], "i"]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826063833542572*^9, 
  3.826063884931407*^9}},ExpressionUUID->"58887d1b-826e-4356-86ca-\
88ad8c04a977"],

Cell["similarly, when we write", "ExpositoryText",
 CellChangeTimes->{{3.826063909569384*^9, 
  3.826063928439917*^9}},ExpressionUUID->"8a455d64-f276-4725-9e34-\
81b943c62f02"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     RowBox[{
       SubscriptBox["\[CapitalDelta]s", "1"], ",", " ", 
       SubscriptBox["\[CapitalDelta]s", "2"], ",", " ", "...", ",", " ", 
       SubscriptBox["\[CapitalDelta]s", "D"]}]},
    "Ket"], " ", "~", " ", 
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox["\[Pi]", "D", 
      RowBox[{"(", "2", ")"}]], ",", " ", 
     SubsuperscriptBox[
      SuperscriptBox["\[Lambda]", 
       RowBox[{"(", "2", ")"}]], "D", "M"], ",", " ", 
     RowBox[{"\[Xi]", "(", 
      SubsuperscriptBox[
       SuperscriptBox["\[Lambda]", 
        RowBox[{"(", "2", ")"}]], "D", "M"], ")"}]}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.82606393302462*^9, 
  3.8260639405370817`*^9}},ExpressionUUID->"3f6522ef-a89a-43c4-9f65-\
b4a701c27fcd"],

Cell["we are saying", "ExpositoryText",
 CellChangeTimes->{{3.826063941694767*^9, 
  3.8260639433381042`*^9}},ExpressionUUID->"7dea35ac-8a7a-4f85-9293-\
37669e07d82f"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["\[CapitalDelta]s", "i"], "=", 
      RowBox[{
       RowBox[{"-", 
        SubscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox[
           SuperscriptBox["\[Lambda]", 
            RowBox[{"(", "2", ")"}]], "D", "M"], ")"}], "j"]}], " ", "+", " ", 
       RowBox[{"2", " ", 
        SubscriptBox[
         RowBox[{"\[Xi]", "(", 
          SubsuperscriptBox[
           SuperscriptBox["\[Lambda]", 
            RowBox[{"(", "2", ")"}]], "D", "M"], ")"}], "j"]}]}]}]},
    {
     RowBox[{"j", "=", 
      SubscriptBox[
       RowBox[{"(", 
        SubscriptBox[
         SuperscriptBox["\[Pi]", 
          RowBox[{"(", "2", ")"}]], "D"], ")"}], "i"]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826063833542572*^9, 3.826063884931407*^9}, {
  3.826064183345039*^9, 
  3.826064215444284*^9}},ExpressionUUID->"41cfa8ea-49a8-4ddd-a952-\
60980a75374a"],

Cell["meaning ", "ExpositoryText",
 CellChangeTimes->{{3.826064245735187*^9, 
  3.826064246974103*^9}},ExpressionUUID->"a5829dca-f851-4eb5-8b08-\
9d382ef0688b"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["n", "i"], "+", 
       SubscriptBox["\[CapitalDelta]s", "i"]}], "=", 
      RowBox[{
       SubscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          SuperscriptBox["\[Lambda]", 
           RowBox[{"(", "1", ")"}]], "D", "N"], ")"}], "j"], "-", 
       SubscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          SuperscriptBox["\[Lambda]", 
           RowBox[{"(", "2", ")"}]], "D", "M"], ")"}], "k"], "+", 
       RowBox[{"2", " ", 
        SubscriptBox[
         RowBox[{"\[Xi]", "(", 
          SubsuperscriptBox[
           SuperscriptBox["\[Lambda]", 
            RowBox[{"(", "2", ")"}]], "D", "M"], ")"}], "k"]}]}]}]},
    {
     RowBox[{"j", "=", 
      SubscriptBox[
       RowBox[{"(", 
        SubscriptBox[
         SuperscriptBox["\[Pi]", 
          RowBox[{"(", "1", ")"}]], "D"], ")"}], "i"]}]},
    {
     RowBox[{"k", "=", 
      SubscriptBox[
       RowBox[{"(", 
        SubscriptBox[
         SuperscriptBox["\[Pi]", 
          RowBox[{"(", "2", ")"}]], "D"], ")"}], "i"]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826063833542572*^9, 3.826063884931407*^9}, {
  3.8260642653736877`*^9, 
  3.82606433558957*^9}},ExpressionUUID->"d54e9fdb-7e63-4ea4-ad38-\
211ea78540fc"],

Cell[TextData[{
 "unfortunately, this doesn\[CloseCurlyQuote]t seem very promising. However \
we can imagine some ",
 StyleBox["second",
  FontSlant->"Italic"],
 " permutation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[Pi]", 
     RowBox[{"(", "3", ")"}]], "D"], TraditionalForm]],ExpressionUUID->
  "7115a202-26b8-48c3-9223-9d4816bc2ffd"],
 " such that"
}], "ExpositoryText",
 CellChangeTimes->{{3.826064410761972*^9, 
  3.8260644706322603`*^9}},ExpressionUUID->"d1c37730-40d9-4b7a-89af-\
4e92b0895b32"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     SuperscriptBox["\[Pi]", 
      RowBox[{"(", "3", ")"}]], "D"], "(", 
    SubscriptBox[
     SuperscriptBox["\[Pi]", 
      RowBox[{"(", "2", ")"}]], "D"], ")"}], "=", 
   SubscriptBox[
    SuperscriptBox["\[Pi]", 
     RowBox[{"(", "1", ")"}]], "D"]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826064472057906*^9, 3.826064484956481*^9}, {
  3.8260645553064833`*^9, 
  3.826064556263659*^9}},ExpressionUUID->"4cc73683-b691-4880-8208-\
f3666549c796"],

Cell["under this mapping then, writing ", "ExpositoryText",
 CellChangeTimes->{{3.826064536206417*^9, 
  3.8260645402174187`*^9}},ExpressionUUID->"7e2378df-d86b-4730-92c8-\
0aba1fa5384b"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox[
       SuperscriptBox["\[Lambda]", 
        RowBox[{"(", "3", ")"}]], "D", "M"], "=", 
      RowBox[{
       SubscriptBox[
        SuperscriptBox["\[Pi]", 
         RowBox[{"(", "3", ")"}]], "D"], "(", 
       SubsuperscriptBox[
        SuperscriptBox["\[Lambda]", 
         RowBox[{"(", "2", ")"}]], "D", "M"], ")"}]}]},
    {
     RowBox[{
      RowBox[{"\[Xi]", "(", 
       SubsuperscriptBox[
        SuperscriptBox["\[Lambda]", 
         RowBox[{"(", "3", ")"}]], "D", "M"], ")"}], "=", 
      RowBox[{
       SubscriptBox[
        SuperscriptBox["\[Pi]", 
         RowBox[{"(", "3", ")"}]], "D"], "(", 
       RowBox[{"\[Xi]", "(", 
        SubsuperscriptBox[
         SuperscriptBox["\[Lambda]", 
          RowBox[{"(", "2", ")"}]], "D", "M"], ")"}], ")"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826064543894012*^9, 
  3.8260646057566853`*^9}},ExpressionUUID->"e8e3749e-8e98-4462-a852-\
2db4db35a6b8"],

Cell["and under this mapping", "ExpositoryText",
 CellChangeTimes->{{3.826064618424477*^9, 
  3.826064628971575*^9}},ExpressionUUID->"fc7a4081-8fd1-47cc-8c66-\
35af21896410"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["n", "i"], "+", 
       SubscriptBox["\[CapitalDelta]s", "i"]}], "=", 
      RowBox[{
       SubscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          SuperscriptBox["\[Lambda]", 
           RowBox[{"(", "1", ")"}]], "D", "N"], ")"}], "j"], "-", 
       SubscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox[
          SuperscriptBox["\[Lambda]", 
           RowBox[{"(", "3", ")"}]], "D", "M"], ")"}], "j"], "+", 
       RowBox[{"2", " ", 
        SubscriptBox[
         RowBox[{"\[Xi]", "(", 
          SubsuperscriptBox[
           SuperscriptBox["\[Lambda]", 
            RowBox[{"(", "3", ")"}]], "D", "M"], ")"}], "j"]}]}]}]},
    {
     RowBox[{"j", "=", 
      SubscriptBox[
       RowBox[{"(", 
        SubscriptBox[
         SuperscriptBox["\[Pi]", 
          RowBox[{"(", "1", ")"}]], "D"], ")"}], "i"]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826063833542572*^9, 3.826063884931407*^9}, {
  3.8260642653736877`*^9, 3.82606433558957*^9}, {3.826064637464497*^9, 
  3.826064644420197*^9}},ExpressionUUID->"286c0514-2997-40b6-a23a-\
1fd4124aa842"],

Cell[TextData[{
 "the permutation ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Pi]", 
    RowBox[{"(", "3", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.826064472057906*^9, 3.826064484956481*^9}, {
   3.8260645553064833`*^9, 3.826064556263659*^9}},ExpressionUUID->
  "aea49950-d034-47fd-99a0-d71ddb8827be"],
 ", of course, is just"
}], "ExpositoryText",
 CellChangeTimes->{{3.8260646854059067`*^9, 
  3.8260646965624*^9}},ExpressionUUID->"f291259a-d369-4ee6-8929-d416297ec97c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["\[Pi]", 
    RowBox[{"(", "3", ")"}]], "=", 
   RowBox[{
    SubscriptBox[
     SuperscriptBox["\[Pi]", 
      RowBox[{"(", "1", ")"}]], "D"], "\[SmallCircle]", 
    SuperscriptBox[
     SubscriptBox[
      SuperscriptBox["\[Pi]", 
       RowBox[{"(", "2", ")"}]], "D"], 
     RowBox[{"-", "1"}]]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826064697901553*^9, 3.826064717367529*^9}, {
  3.826064922058456*^9, 
  3.8260649319338493`*^9}},ExpressionUUID->"56c11fc9-6c1e-4a56-8275-\
ea935d8a5a66"],

Cell[TextData[{
 "under this relation we can now again ignore ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[Pi]", 
     RowBox[{"(", "1", ")"}]], "D"], TraditionalForm]],
  CellChangeTimes->{{3.826063833542572*^9, 3.826063884931407*^9}, {
   3.8260642653736877`*^9, 3.82606433558957*^9}, {3.826064637464497*^9, 
   3.826064644420197*^9}},ExpressionUUID->
  "d6d56ed4-c9fd-4801-a9a1-c226c608123a"],
 " for a bit. In particular, we\[CloseCurlyQuote]ll note that the sequence "
}], "ExpositoryText",
 CellChangeTimes->{{3.826064949568572*^9, 
  3.8260650095267677`*^9}},ExpressionUUID->"e063ef70-6304-40c9-9953-\
235b91cde665"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    SuperscriptBox["\[Lambda]", 
     RowBox[{"(", "1", ")"}]], "D", "N"], "-", 
   SubsuperscriptBox[
    SuperscriptBox["\[Lambda]", 
     RowBox[{"(", "3", ")"}]], "D", "M"], "+", 
   RowBox[{"2", " ", 
    RowBox[{"\[Xi]", "(", 
     SubsuperscriptBox[
      SuperscriptBox["\[Lambda]", 
       RowBox[{"(", "3", ")"}]], "D", "M"], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.82606501768501*^9, 3.8260650186096563`*^9}, {
  3.8260650692231607`*^9, 
  3.826065081620482*^9}},ExpressionUUID->"e48e8137-aca0-4cf4-a93e-\
c93400475f1f"],

Cell[TextData[{
 "is not necessarily an element of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalLambda]", "D", "L"], TraditionalForm]],
  CellChangeTimes->{{3.8260349434251204`*^9, 3.8260349628745213`*^9}},
  ExpressionUUID->"d97752b4-aebe-4452-8e51-e9bd27b0cc15"],
 ". But it ",
 StyleBox["can",
  FontSlant->"Italic"],
 " be written as"
}], "ExpositoryText",
 CellChangeTimes->{{3.82606508454291*^9, 
  3.826065143765109*^9}},ExpressionUUID->"52041c2e-55a0-46e3-810b-\
8cf14f583283"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox[
     SuperscriptBox["\[Lambda]", 
      RowBox[{"(", "1", ")"}]], "D", "N"], "-", 
    SubsuperscriptBox[
     SuperscriptBox["\[Lambda]", 
      RowBox[{"(", "3", ")"}]], "D", "M"], "+", 
    RowBox[{"2", " ", 
     RowBox[{"\[Xi]", "(", 
      SubsuperscriptBox[
       SuperscriptBox["\[Lambda]", 
        RowBox[{"(", "3", ")"}]], "D", "M"], ")"}]}]}], "=", 
   RowBox[{
    SubscriptBox[
     SuperscriptBox["\[Pi]", 
      RowBox[{"(", "4", ")"}]], "D"], "(", 
    SubsuperscriptBox[
     SuperscriptBox["\[Lambda]", 
      RowBox[{"(", "4", ")"}]], "D", "L"], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8260651450157213`*^9, 
  3.8260651819033403`*^9}},ExpressionUUID->"5ceddc9f-19d3-4981-8c84-\
56085d5b3061"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[Pi]", 
     RowBox[{"(", "4", ")"}]], "D"], TraditionalForm]],
  CellChangeTimes->{{3.8260651450157213`*^9, 3.8260651819033403`*^9}},
  ExpressionUUID->"ca627bf9-d6be-46bc-874a-d121f4591e55"],
 " just puts the sequence in canonical order. It is unfortunately kinda hard \
to know what the form of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[Pi]", 
     RowBox[{"(", "4", ")"}]], "D"], TraditionalForm]],
  CellChangeTimes->{{3.8260651450157213`*^9, 3.8260651819033403`*^9}},
  ExpressionUUID->"2adfbaf2-39e5-49c8-9935-226817590ebc"],
 " looks like, since it depends on the relative sizes of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    SuperscriptBox["\[Lambda]", 
     RowBox[{"(", "3", ")"}]], "D", "M"], TraditionalForm]],
  CellChangeTimes->{{3.8260651450157213`*^9, 3.8260651819033403`*^9}},
  ExpressionUUID->"b190c3db-ee22-4437-b850-a30598a2dc8d"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    SuperscriptBox["\[Lambda]", 
     RowBox[{"(", "1", ")"}]], "D", "N"], TraditionalForm]],
  CellChangeTimes->{{3.8260651450157213`*^9, 3.8260651819033403`*^9}},
  ExpressionUUID->"32da4c00-a9ee-4d4a-aff4-b1e971604d6c"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Xi]", "(", 
    SubsuperscriptBox[
     SuperscriptBox["\[Lambda]", 
      RowBox[{"(", "3", ")"}]], "D", "M"], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.8260651450157213`*^9, 3.8260651819033403`*^9}},
  ExpressionUUID->"d24098b2-7118-4732-9135-822a5c7fe982"],
 ", but it is conceivable that a fast algorithm could be constructed for ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    SuperscriptBox["\[Lambda]", 
     RowBox[{"(", "1", ")"}]], "D", "N"], "-", 
   SubsuperscriptBox[
    SuperscriptBox["\[Lambda]", 
     RowBox[{"(", "3", ")"}]], "D", "M"]}]],
  CellChangeTimes->{{3.8260651450157213`*^9, 3.8260651819033403`*^9}},
  ExpressionUUID->"41eda599-51ac-45b0-bdba-e96505db24db"],
 " and iteratively updated for each element of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", " ", 
    RowBox[{"\[Xi]", "(", 
     SubsuperscriptBox[
      SuperscriptBox["\[Lambda]", 
       RowBox[{"(", "3", ")"}]], "D", "M"], ")"}]}], TraditionalForm]],
  CellChangeTimes->{{3.8260651450157213`*^9, 3.8260651819033403`*^9}},
  ExpressionUUID->"25697588-a601-4335-8455-44b5d294ebcf"],
 "."
}], "ExpositoryText",
 CellChangeTimes->{{3.8260651850196447`*^9, 3.8260652030314302`*^9}, {
  3.8260662364306498`*^9, 3.8260662454346733`*^9}, {3.8260665757896233`*^9, 
  3.8260667038071823`*^9}},ExpressionUUID->"e561ac2c-b62e-43fb-a1ce-\
d8c267b67d01"],

Cell[TextData[{
 "Perhaps more productive is to look at the set of ",
 StyleBox["all",
  FontSlant->"Italic"],
 " selection rules coming from "
}], "ExpositoryText",
 CellChangeTimes->{{3.8261174686259823`*^9, 
  3.826117493656168*^9}},ExpressionUUID->"32a79379-fddd-4831-90d8-\
87e5b0a292ba"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["H", 
    RowBox[{"(", "i", ")"}]], " ", "~", " ", 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[ScriptCapitalP]", "D"], ",", " ", 
     SubsuperscriptBox["\[CapitalLambda]", "D", "M"]}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826117548658738*^9, 
  3.826117549369049*^9}},ExpressionUUID->"d9f14b0d-b11d-4b3c-8d42-\
e03efd0a484c"],

Cell[TextData[{
 "or more particularly, from the subset of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.826117548658738*^9, 3.826117549369049*^9}},
  ExpressionUUID->"7cdc30d6-0409-4424-a3bc-a0cc983fbc9e"],
 " that maps as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[ScriptCapitalP]", "D"], ",", " ", 
     SubsuperscriptBox["\[Lambda]", "D", "M"]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.826117548658738*^9, 3.826117549369049*^9}},
  ExpressionUUID->"ef1542fe-bdae-4ac5-891f-520108b8a84c"],
 " for some partition \[Lambda]. The benefit of this is now we don\
\[CloseCurlyQuote]t need to worry about a specific "
}], "ExpositoryText",
 CellChangeTimes->{{3.8261176848186617`*^9, 3.826117697949773*^9}, {
  3.82611798508037*^9, 3.8261180165670137`*^9}, {3.8261182348876038`*^9, 
  3.826118248358686*^9}},ExpressionUUID->"564f6d0e-8e9d-4cb7-8ab1-\
a75dce440792"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["\[Pi]", 
    RowBox[{"(", "3", ")"}]], "=", 
   RowBox[{
    SubscriptBox[
     SuperscriptBox["\[Pi]", 
      RowBox[{"(", "1", ")"}]], "D"], "\[SmallCircle]", 
    SuperscriptBox[
     SubscriptBox[
      SuperscriptBox["\[Pi]", 
       RowBox[{"(", "2", ")"}]], "D"], 
     RowBox[{"-", "1"}]]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826118252255546*^9, 
  3.8261182528841248`*^9}},ExpressionUUID->"c9418e3a-c0ce-45ff-ac17-\
884068c90ab2"],

Cell["but instead about the action of the entire space", "ExpositoryText",
 CellChangeTimes->{{3.826118254308979*^9, 
  3.8261182609568033`*^9}},ExpressionUUID->"28165123-b29c-473c-a8d4-\
0b7c9caeeee4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{
     SubscriptBox[
      SuperscriptBox["\[Pi]", 
       RowBox[{"(", "1", ")"}]], "D"], "(", 
     SubscriptBox["\[ScriptCapitalP]", "D"], ")"}], 
    RowBox[{"-", "1"}]], "=", 
   SubscriptBox["\[ScriptCapitalP]", "D"]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8261182661286507`*^9, 
  3.82611828203331*^9}},ExpressionUUID->"884e02fa-e01b-4fad-b05e-\
605f08e5db67"],

Cell[TextData[{
 "that is, we get to write the space of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{
       SubscriptBox["n", "1"], ",", " ", 
       SubscriptBox["n", "2"], ",", " ", "...", ",", " ", 
       SubscriptBox["n", "D"]}]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.826063800045217*^9, 3.826063816989777*^9}},
  ExpressionUUID->"4595c0e7-8b40-4607-bcd8-251ec6049ba3"],
 " coming from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[ScriptCapitalP]", "D"], ",", " ", 
     SubsuperscriptBox["\[Lambda]", "D", "M"]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.826117548658738*^9, 3.826117549369049*^9}},
  ExpressionUUID->"32f78b24-a783-4994-bd0d-747cb713cc43"],
 " as"
}], "ExpositoryText",
 CellChangeTimes->{{3.8261183460575438`*^9, 
  3.826118388812319*^9}},ExpressionUUID->"7269a00c-22ec-4476-aab3-\
190967d2345a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"s", "(", "q", ")"}], "\[SmallCircle]", 
    TemplateBox[{
      RowBox[{
        SubscriptBox["n", "1"], ",", " ", 
        SubscriptBox["n", "2"], ",", " ", "...", ",", " ", 
        SubscriptBox["n", "D"]}]},
     "Ket"]}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     SubsuperscriptBox[
      SuperscriptBox["\[Lambda]", 
       RowBox[{"(", "1", ")"}]], "D", "N"], "-", 
     RowBox[{
      SubscriptBox["\[Pi]", "D"], 
      SubsuperscriptBox["\[Lambda]", "D", "M"]}], "+", 
     RowBox[{"2", " ", 
      RowBox[{"\[Xi]", "(", 
       RowBox[{
        SubscriptBox["\[Pi]", "D"], 
        SubsuperscriptBox["\[Lambda]", "D", "M"]}], ")"}]}]}], "}"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8261183903844624`*^9, 
  3.826118504241418*^9}},ExpressionUUID->"172d7d77-ba21-4496-86d5-\
a395868d5dec"],

Cell[TextData[{
 "for every ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Pi]", "D"], TraditionalForm]],
  CellChangeTimes->{{3.8261183903844624`*^9, 3.8261184907198143`*^9}},
  ExpressionUUID->"1cfc661b-985a-4c82-8eed-90aa184e978e"],
 " and \[Xi] which means we can also write it as"
}], "ExpositoryText",
 CellChangeTimes->{{3.826118446055374*^9, 3.8261184475887012`*^9}, {
  3.826118494994014*^9, 3.826118520341241*^9}, {3.826205772499441*^9, 
  3.8262057898994827`*^9}},ExpressionUUID->"04c4e612-f088-40b2-8d2e-\
3966c38b3106"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"s", "(", "q", ")"}], "\[SmallCircle]", 
    TemplateBox[{
      RowBox[{
        SubscriptBox["n", "1"], ",", " ", 
        SubscriptBox["n", "2"], ",", " ", "...", ",", " ", 
        SubscriptBox["n", "D"]}]},
     "Ket"]}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     SubsuperscriptBox[
      SuperscriptBox["\[Lambda]", 
       RowBox[{"(", "1", ")"}]], "D", "N"], "+", 
     RowBox[{
      SubscriptBox["\[Pi]", "D"], 
      SubsuperscriptBox["\[Lambda]", "D", "M"]}], "-", 
     RowBox[{"2", " ", 
      RowBox[{"\[Xi]", "(", 
       RowBox[{
        SubscriptBox["\[Pi]", "D"], 
        SubsuperscriptBox["\[Lambda]", "D", "M"]}], ")"}]}]}], "}"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826205785886142*^9, 
  3.8262057945217037`*^9}},ExpressionUUID->"7a0e0e58-d787-4385-b442-\
0d50d02fe26a"],

Cell[TextData[{
 "The way this can benefit us is by writing ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    SuperscriptBox["\[Lambda]", 
     RowBox[{"(", "1", ")"}]], "D", "N"], TraditionalForm]],
  CellChangeTimes->{{3.8261183903844624`*^9, 3.826118504241418*^9}},
  ExpressionUUID->"79848092-0871-4445-a271-64882eb3ce54"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Lambda]", "D", "M"], TraditionalForm]],
  CellChangeTimes->{{3.8261183903844624`*^9, 3.826118504241418*^9}},
  ExpressionUUID->"4961ba5e-da6b-4a5b-9408-307c47708793"],
 " as expansions over ",
 StyleBox["classes",
  FontSlant->"Italic"],
 " of elements with their multiplicities, i.e. we\[CloseCurlyQuote]ll have"
}], "ExpositoryText",
 CellChangeTimes->{{3.826118663953443*^9, 
  3.826118707800908*^9}},ExpressionUUID->"2589aafa-c68c-46fb-aae3-\
526afc39bb84"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Lambda]", "D", "M"], " ", "~", " ", 
   RowBox[{"(", "\[VeryThinSpace]", 
    RowBox[{
     SubscriptBox["\[Chi]", "i"], ",", " ", 
     SubscriptBox["m", "i"]}], "\[VeryThinSpace]", ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8261183506311493`*^9, 3.8261183513345547`*^9}, {
  3.826205592333097*^9, 3.826205672444997*^9}, {3.826205871001178*^9, 
  3.8262058773701143`*^9}, {3.826205944079698*^9, 
  3.82620594547831*^9}},ExpressionUUID->"e5bcd587-b33e-485a-aa50-\
72c1e3237455"],

Cell[TextData[{
 "this allows us to split our partition into \[OpenCurlyDoubleQuote]subspaces\
\[CloseCurlyDoubleQuote] from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SubscriptBox["m", "i"], ",", " ", 
      SubscriptBox["m", 
       RowBox[{"i", "+", "1"}]]}]}], ")"}], TraditionalForm]],ExpressionUUID->
  "607979da-0e67-47f8-945e-d1510570943b"]
}], "ExpositoryText",
 CellChangeTimes->{{3.826205676927375*^9, 
  3.826205718511181*^9}},ExpressionUUID->"70866efa-faa1-4d0b-bb86-\
e346ec022d7d"],

Cell[TextData[{
 "Then just focusing on the term ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    SuperscriptBox["\[Lambda]", 
     RowBox[{"(", "1", ")"}]], "D", "N"], "+", 
   RowBox[{
    SubscriptBox["\[Pi]", "D"], 
    SubsuperscriptBox["\[Lambda]", "D", "M"]}]}]],
  CellChangeTimes->{{3.826205785886142*^9, 3.8262057945217037`*^9}},
  ExpressionUUID->"2a24a860-5ee4-465c-beeb-0fda9c70aab1"],
 " for every ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Pi]", "D"], TraditionalForm]],ExpressionUUID->
  "50ff51c9-31ec-488f-848a-62bedfd127df"],
 ", this gives us a way to efficiently resolve the set of ",
 StyleBox["unique",
  FontSlant->"Italic"],
 " terms under the various ",
 Cell[BoxData[
  SubscriptBox["\[Pi]", "D"]],
  CellChangeTimes->{{3.826205785886142*^9, 3.8262057945217037`*^9}},
  ExpressionUUID->"dc789e63-ffd1-470b-be55-cc77b462bf84"],
 " applications. To outline the algorithm we\[CloseCurlyQuote]ll start with "
}], "ExpositoryText",
 CellChangeTimes->{{3.826205839986158*^9, 
  3.826205951547797*^9}},ExpressionUUID->"2e86653a-4c21-47c5-897a-\
49b4ed64d9f1"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["\[Lambda]", "D", "m"], " ", "~", 
      "\[AlignmentMarker] ", 
      RowBox[{"(", "\[VeryThinSpace]", 
       RowBox[{
        SubscriptBox["a", "i"], ",", " ", 
        SubscriptBox["m", "i"]}], "\[VeryThinSpace]", ")"}]}]},
    {
     RowBox[{
      SubsuperscriptBox[
       SuperscriptBox["\[Lambda]", 
        RowBox[{"(", "1", ")"}]], "D", "N"], " ", "~", "\[AlignmentMarker] ", 
      
      RowBox[{"(", "\[VeryThinSpace]", 
       RowBox[{
        SubscriptBox["b", "j"], ",", " ", 
        SubscriptBox["c", "j"]}], "\[VeryThinSpace]", ")"}]}]}
   }], TraditionalForm]], "ExpositoryMathCenteredManuallyAligned",
 CellChangeTimes->{{3.826205883274787*^9, 3.826205883955224*^9}, {
  3.8262059534411507`*^9, 3.826205984929986*^9}, {3.826291524898984*^9, 
  3.8262915275329227`*^9}},ExpressionUUID->"dd023d7b-a057-4bbd-96e1-\
a8fdec6680ca"],

Cell[TextData[{
 "then we have two sets of bins ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SubscriptBox["m", "i"], ",", " ", 
      SubscriptBox["m", 
       RowBox[{"i", "+", "1"}]]}]}], ")"}], TraditionalForm]],ExpressionUUID->
  "c8ebba4a-3b67-4a08-b104-ca6973d5b55d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SubscriptBox["c", "j"], ",", " ", 
      SubscriptBox["c", 
       RowBox[{"j", "+", "1"}]]}]}], ")"}], TraditionalForm]],ExpressionUUID->
  "1ad02874-192f-4711-be29-868ff25c78af"],
 " and the question is how many ",
 StyleBox["unique",
  FontSlant->"Italic"],
 " ways can we distribute the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SubscriptBox["m", "i"], ",", " ", 
      SubscriptBox["m", 
       RowBox[{"i", "+", "1"}]]}]}], ")"}], TraditionalForm]],ExpressionUUID->
  "aca866e4-3f97-43ca-bb35-286f6cb889dc"],
 " across the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SubscriptBox["c", "j"], ",", " ", 
      SubscriptBox["c", 
       RowBox[{"j", "+", "1"}]]}]}], ")"}], TraditionalForm]],ExpressionUUID->
  "92a2258b-f7ae-4c3a-a581-f9a0020a9c6e"]
}], "ExpositoryText",
 CellChangeTimes->{{3.826206107558708*^9, 3.826206166691306*^9}, {
  3.82620620096344*^9, 
  3.8262062221481133`*^9}},ExpressionUUID->"6a0c374a-d8ee-4a26-ad5f-\
bf2fdc7f9fe4"],

Cell[TextData[{
 "We can do this in recursive fashion by recasting it as a balls/buckets type \
problem where we say I have ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "i"], TraditionalForm]],
  CellChangeTimes->{{3.826205883274787*^9, 3.826205883955224*^9}, {
   3.8262059534411507`*^9, 3.826205984929986*^9}, {3.826291524898984*^9, 
   3.8262915275329227`*^9}},ExpressionUUID->
  "4401403b-b276-4b2c-a9bb-1ccbfc332fec"],
 " balls and I want to distribute them over the ",
 Cell[BoxData[
  FormBox["D", TraditionalForm]],ExpressionUUID->
  "225c43f0-ff57-4104-96a4-7488c238f907"],
 " buckets of size ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox["c", "j"], "}"}], TraditionalForm]],ExpressionUUID->
  "120b4753-43b0-4414-b64f-206dea6fe291"],
 ". We\[CloseCurlyQuote]ll note that in the case that the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "j"], TraditionalForm]],ExpressionUUID->
  "2264bb97-5181-4b87-9038-602ec483969c"],
 " are arbitrarily large, for each ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "i"], TraditionalForm]],
  CellChangeTimes->{{3.826205883274787*^9, 3.826205883955224*^9}, {
   3.8262059534411507`*^9, 3.826205984929986*^9}, {3.826291524898984*^9, 
   3.8262915275329227`*^9}},ExpressionUUID->
  "00a707f0-4f7f-48ef-a73d-87aae727f4ac"],
 " we\[CloseCurlyQuote]d have the number of ways to distribute that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "i"], TraditionalForm]],ExpressionUUID->
  "1b3ab263-fa12-4302-8a01-9517261c0c9d"],
 " given by"
}], "ExpositoryText",
 CellChangeTimes->{{3.826291484929737*^9, 3.826291544503694*^9}, {
  3.826292769538103*^9, 3.8262927968639727`*^9}, {3.826293049030003*^9, 
  3.82629314036651*^9}, {3.826293234609209*^9, 
  3.8262932547485323`*^9}},ExpressionUUID->"91c2ed41-e505-4e77-a7bf-\
fa1d06e1413d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"#", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["m", "i"], ",", " ", "D"}], ")"}]}], " ", "=", " ", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{"D", "+", 
        SubscriptBox["m", "i"], "-", "1"}]},
      {
       SubscriptBox["m", "i"]}
     },
     GridBoxAlignment->{"Columns" -> {Center}}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826293195828064*^9, 3.826293282456444*^9}, {
  3.826293361222724*^9, 
  3.826293442613576*^9}},ExpressionUUID->"4b86487e-fa6a-4006-ab8a-\
af091e101852"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {
       RowBox[{"D", "+", 
        SubscriptBox["m", "i"], "-", "1"}]},
      {
       SubscriptBox["m", "i"]}
     },
     GridBoxAlignment->{"Columns" -> {Center}}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.826293195828064*^9, 3.826293282456444*^9}, {
   3.826293361222724*^9, 3.826293442613576*^9}},ExpressionUUID->
  "80f63554-91c2-4a1f-afa8-8c8eca430af7"],
 " is the binomial coefficient. This gives an upper bound on our partitions."
}], "ExpositoryText",
 CellChangeTimes->{{3.826293290605793*^9, 3.826293310140307*^9}, {
  3.8262934514228*^9, 3.8262934800237417`*^9}, {3.826295321427679*^9, 
  3.826295328621149*^9}, {3.8263812382081327`*^9, 
  3.826381238665491*^9}},ExpressionUUID->"d0b17d1b-9628-4285-a4f3-\
756866dee8db"],

Cell[CellGroupData[{

Cell["Tableau Examples", "Subsubsection",
 CellChangeTimes->{{3.826062195286441*^9, 
  3.826062199774514*^9}},ExpressionUUID->"216d89c6-05f9-4787-b8c8-\
778268965c66"],

Cell[BoxData[
 RowBox[{
  RowBox[{"showTableau", "[", "perm_", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"v", "=", 
      RowBox[{"ReverseSort", "[", "perm", "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Graphics", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"EdgeForm", "[", "Black", "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"FaceForm", "[", "White", "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Table", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Rectangle", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"i", "-", "1"}], ",", " ", 
                RowBox[{"1", "-", "j"}]}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"i", ",", " ", 
                RowBox[{"-", "j"}]}], "}"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"j", ",", " ", 
              RowBox[{"v", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], 
           "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", 
            RowBox[{"Length", "[", "v", "]"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"ImageSize", "\[Rule]", 
       RowBox[{"30", "*", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Length", "[", "v", "]"}], ",", " ", 
          RowBox[{"Max", "@", "v"}]}], "}"}]}]}], ",", "\[IndentingNewLine]", 
      
      RowBox[{"AspectRatio", "\[Rule]", "Automatic"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",\

 CellChangeTimes->{{3.8259620330108557`*^9, 3.825962035370994*^9}, {
  3.825962136361299*^9, 3.825962398132023*^9}, {3.825962738989642*^9, 
  3.8259627531051273`*^9}, {3.8259633680571213`*^9, 3.825963387424386*^9}},
 CellLabel->"In[60]:=",ExpressionUUID->"8af26f11-8169-4fbb-86ef-735ce4af920f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "@", 
  RowBox[{"{", 
   RowBox[{"showTableau", "/@", 
    RowBox[{"IntegerPartitions", "[", "4", "]"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.825962265715247*^9, 3.825962269532423*^9}, {
  3.825962412464385*^9, 3.8259624164488163`*^9}},
 CellLabel->"In[61]:=",ExpressionUUID->"ac5f2a24-0ee4-4503-b2bd-45674a443f9f"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     GraphicsBox[
      {EdgeForm[GrayLevel[0]], FaceForm[GrayLevel[1]], 
       RectangleBox[{0, 0}, {1, -1}], RectangleBox[{0, -1}, {1, -2}], 
       RectangleBox[{0, -2}, {1, -3}], RectangleBox[{0, -3}, {1, -4}]},
      AspectRatio->Automatic,
      ImageSize->{30, 120}], 
     GraphicsBox[
      {EdgeForm[GrayLevel[0]], FaceForm[GrayLevel[
       1]], {RectangleBox[{0, 0}, {1, -1}], RectangleBox[{0, -1}, {1, -2}], 
        RectangleBox[{0, -2}, {1, -3}]}, RectangleBox[{1, 0}, {2, -1}]},
      AspectRatio->Automatic,
      ImageSize->{60, 90}], 
     GraphicsBox[
      {EdgeForm[GrayLevel[0]], FaceForm[GrayLevel[
       1]], {RectangleBox[{0, 0}, {1, -1}], RectangleBox[{0, -1}, {1, -2}]}, {
        RectangleBox[{1, 0}, {2, -1}], RectangleBox[{1, -1}, {2, -2}]}},
      AspectRatio->Automatic,
      ImageSize->{60, 60}], 
     GraphicsBox[
      {EdgeForm[GrayLevel[0]], FaceForm[GrayLevel[
       1]], {RectangleBox[{0, 0}, {1, -1}], RectangleBox[{0, -1}, {1, -2}]}, 
       RectangleBox[{1, 0}, {2, -1}], RectangleBox[{2, 0}, {3, -1}]},
      AspectRatio->Automatic,
      ImageSize->{90, 60}], 
