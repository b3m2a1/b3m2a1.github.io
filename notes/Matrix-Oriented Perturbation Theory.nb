        RowBox[{"(", "k", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], 
      RowBox[{"k", "-", "1"}]], 
     RowBox[{
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]]},
       "Bra"], " ", 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["J", "a", 
         RowBox[{"(", 
          RowBox[{"k", ",", "i"}], ")"}]], "+", 
        SuperscriptBox["\[CapitalDelta]H", 
         RowBox[{"(", 
          RowBox[{"k", "+", "a", "-", "i"}], ")"}]]}], ")"}], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825820741862116*^9, 3.8258207790924683`*^9}, {
