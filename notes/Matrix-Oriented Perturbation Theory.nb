Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Given", " ", 
    StyleBox["A",
     FontWeight->"Bold"], " ", "with", " ", "axes", " ", 
    SubsuperscriptBox[
     RowBox[{"{", 
      SubscriptBox["a", "n"], "}"}], 
     RowBox[{"n", "=", "1"}], 
     RowBox[{"N", "+", "1"}]], "  ", 
    StyleBox["B",
     FontWeight->"Bold"], " ", "with", " ", "asxes", " ", 
    SubsuperscriptBox[
     RowBox[{"{", 
      SubscriptBox["b", "m"], "}"}], 
     RowBox[{"m", "=", "1"}], 
     RowBox[{"M", "+", "1"}]], " ", "and", " ", "some", " ", "transposition", 
    " ", 
    RowBox[{"{", 
     SubscriptBox["k", "l"], "}"}]}], ","}], 
  TraditionalForm]], "ExpositoryMath",
 CellChangeTimes->{{3.792893296557214*^9, 3.792893312034081*^9}, {
   3.793207686219603*^9, 3.793207762938402*^9}, {3.793207941442622*^9, 
   3.793208116641032*^9}, 
   3.793209912366707*^9},ExpressionUUID->"0ec005ab-6abb-4e91-af5b-\
f26b8b7bc834"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"if", " ", 
     RowBox[{
      SubscriptBox["\[ForAll]", "i"], " ", 
      RowBox[{"i", "\[LessEqual]", "N"}]}]}], " ", "\[Implies]", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["k", "i"], " ", "\[LessEqual]", " ", 
      RowBox[{"N", " ", "and", " ", 
       RowBox[{
        SubscriptBox["\[ForAll]", "j"], " ", 
        RowBox[{"j", ">", "N"}]}]}]}], " ", "\[Implies]", " ", 
     RowBox[{
      SubscriptBox["k", "j"], ">", "N"}]}]}], ","}], 
  TraditionalForm]], "ExpositoryMath",
 CellChangeTimes->{{3.792893296557214*^9, 3.792893312034081*^9}, {
   3.793207686219603*^9, 3.793207762938402*^9}, {3.793207941442622*^9, 
