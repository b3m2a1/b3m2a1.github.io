ad996cb1e810"],

Cell[TextData[{
 "and this seems tough even just to evaluate ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", "B"], TraditionalForm]],
  CellChangeTimes->{{3.81353400504825*^9, 3.813534183993164*^9}, {
   3.813534293788464*^9, 3.813534301080258*^9}, {3.8135343394933167`*^9, 
   3.813534434322995*^9}, {3.8135346463027287`*^9, 3.813534659309725*^9}, {
   3.81353475485942*^9, 3.8135347953422117`*^9}, {3.813534843009605*^9, 
   3.813534848346739*^9}, {3.813535033172475*^9, 3.8135350935776567`*^9}, {
   3.813535385134471*^9, 3.8135354695754213`*^9}, {3.8135359647553577`*^9, 
   3.81353601163146*^9}, {3.8135361261765413`*^9, 3.813536165120452*^9}, {
   3.8135363208542233`*^9, 3.813536368539447*^9}, {3.8135364166823063`*^9, 
   3.813536442310855*^9}, {3.8135364790619*^9, 3.813536490810783*^9}, {
   3.813536525907126*^9, 3.813536570522444*^9}, {3.813536691757083*^9, 
   3.8135366950868683`*^9}, {3.813536921186365*^9, 3.813536931074243*^9}, {
   3.813537093174944*^9, 3.813537135301662*^9}, {3.813537178533146*^9, 
   3.8135372060835533`*^9}},ExpressionUUID->
  "7dc96eff-cdb7-49b0-892e-2cdd4291057a"],
 ", until you think about the fact that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalDelta]", "i", "A"], "=", 
    RowBox[{
     SubsuperscriptBox["\[CapitalDelta]", "j", "A"], "=", "0"}]}], 
   TraditionalForm]],
  CellChangeTimes->{{3.81353400504825*^9, 3.813534183993164*^9}, {
   3.813534293788464*^9, 3.813534301080258*^9}, {3.8135343394933167`*^9, 
   3.813534434322995*^9}, {3.8135346463027287`*^9, 3.813534659309725*^9}, {
   3.81353475485942*^9, 3.8135347953422117`*^9}, {3.813534843009605*^9, 
   3.813534848346739*^9}, {3.813535033172475*^9, 3.8135350935776567`*^9}, {
   3.813535385134471*^9, 3.8135354695754213`*^9}, {3.8135359647553577`*^9, 
   3.81353601163146*^9}, {3.8135361261765413`*^9, 3.813536165120452*^9}, {
   3.8135363208542233`*^9, 3.813536368539447*^9}, {3.8135364166823063`*^9, 
   3.813536442310855*^9}, {3.8135364790619*^9, 3.813536490810783*^9}, {
   3.813536525907126*^9, 3.813536570522444*^9}, {3.813536691757083*^9, 
   3.8135366950868683`*^9}, {3.813536921186365*^9, 3.813536931074243*^9}, {
   3.813537093174944*^9, 3.813537135301662*^9}, {3.813537178533146*^9, 
   3.8135372060835533`*^9}},ExpressionUUID->
  "14836010-c0dd-4e34-ae05-7cef063ca4f6"],
 ", which means that the only time this is non-zero is when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["d", "i"], "=", 
    RowBox[{
     SubscriptBox["d", "j"], "=", "0"}]}], TraditionalForm]],ExpressionUUID->
  "254e56bf-e3ed-4e09-bac8-4a874e2db7dd"],
 "."
}], "ExpositoryText",
 CellChangeTimes->{{3.8135372075059233`*^9, 3.813537271313731*^9}, {
  3.813537315420891*^9, 
  3.8135373772381*^9}},ExpressionUUID->"82ec39aa-dbf4-47bf-a4a3-edc379f2b737"],

Cell["Then going back to previous expressions, to look at", "ExpositoryText",
 CellChangeTimes->{{3.8135372075059233`*^9, 3.813537271313731*^9}, {
  3.813537315420891*^9, 3.813537356151288*^9}, {3.813537386270108*^9, 
