Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], 
       RowBox[{
        SubscriptBox["\[GothicCapitalD]", "n"], "(", 
        RowBox[{"M", ",", " ", "p", ",", " ", 
         RowBox[{"1", "..."}]}], ")"}], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], "(", "\[VeryThinSpace]", 
        RowBox[{
         UnderoverscriptBox["\[Product]", 
          RowBox[{"i", "=", "1"}], 
          RowBox[{"M", "-", "1"}]], 
         SubsuperscriptBox["\[CapitalGamma]", "n", 
          RowBox[{"(", 
           SubscriptBox["p", "i"], ")"}]]}], ")"}], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", 
         SubscriptBox["p", "M"], ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{"(", "\[VeryThinSpace]", 
        RowBox[{
         UnderoverscriptBox["\[Product]", 
          RowBox[{"i", "=", "2"}], 
          RowBox[{"M", "-", "1"}]], 
         RowBox[{
          TemplateBox[{
            SuperscriptBox["m", 
             RowBox[{"(", "0", ")"}]]},
           "Bra"], 
          SubsuperscriptBox["\[CapitalDelta]H", "n", 
           RowBox[{"(", 
            StyleBox[
             SubscriptBox["p", "i"],
             FontSize->14], ")"}]], 
          TemplateBox[{
            RowBox[{"\[VeryThinSpace]", 
              SuperscriptBox["m", 
               RowBox[{"(", "0", ")"}]]}]},
           "Ket"]}]}], ")"}], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], 
       SubsuperscriptBox["\[CapitalGamma]", "n", 
        RowBox[{"(", 
         SubscriptBox["p", "1"], ")"}]], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", 
         SubscriptBox["p", "M"], ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{"(", "\[VeryThinSpace]", 
        RowBox[{
         UnderoverscriptBox["\[Product]", 
          RowBox[{"i", "=", "2"}], "M"], 
         RowBox[{
          TemplateBox[{
            SuperscriptBox["m", 
             RowBox[{"(", "0", ")"}]]},
           "Bra"], 
          SubsuperscriptBox["\[CapitalDelta]H", "n", 
           RowBox[{"(", 
            StyleBox[
             SubscriptBox["p", "i"],
             FontSize->14], ")"}]], 
          TemplateBox[{
            RowBox[{"\[VeryThinSpace]", 
              SuperscriptBox["m", 
               RowBox[{"(", "0", ")"}]]}]},
           "Ket"]}]}], ")"}], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", 
         StyleBox[
          SubscriptBox["p", "1"],
          FontSize->14], ")"}]], 
       TemplateBox[{
         RowBox[{"\[VeryThinSpace]", 
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]}]},
        "Ket"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.827799866868576*^9, 3.827799874908708*^9}, {
   3.827806315970826*^9, 3.827806317231697*^9}, 3.827806358930523*^9, {
