Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"A", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "\[RightAngleBracket]"}], 
    SuperscriptBox["B", 
     RowBox[{"i", "\[Rule]", "j"}]]}], " ", "=", " ", 
   TagBox[GridBox[{
      {"\[Piecewise]", GridBox[{
         {
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"A", 
             RowBox[{"\[LeftAngleBracket]", 
              RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], 
              "\[RightAngleBracket]"}], "B"}], ")"}], 
           StyleBox[
            RowBox[{
             RowBox[{"\[Alpha]", "-", "2", "+", "i"}], "\[Rule]", 
             RowBox[{"\[Alpha]", "-", "2", "+", "j"}]}],
            FontSize->14]], 
          RowBox[{"\[Beta]", "<", "i"}]},
         {
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"A", 
             RowBox[{"\[LeftAngleBracket]", 
              RowBox[{"\[Alpha]", ",", " ", 
               RowBox[{"\[Beta]", "+", "1"}]}], "\[RightAngleBracket]"}], 
             "B"}], ")"}], 
           StyleBox[
            RowBox[{
             RowBox[{"\[Alpha]", "-", "1", "+", "i"}], "\[Rule]", 
             RowBox[{"\[Alpha]", "-", "2", "+", "j"}]}],
            FontSize->14]], 
          RowBox[{"\[Beta]", "<", "j"}]},
         {
          RowBox[{"A", 
           RowBox[{"\[LeftAngleBracket]", 
            RowBox[{"\[Alpha]", ",", " ", "i"}], "\[RightAngleBracket]"}], 
           "B"}], 
          RowBox[{"\[Beta]", "=", "j"}]},
         {
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"A", 
             RowBox[{"\[LeftAngleBracket]", 
              RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], 
              "\[RightAngleBracket]"}], "B"}], ")"}], 
           StyleBox[
            RowBox[{
             RowBox[{"\[Alpha]", "-", "1", "+", "i"}], "\[Rule]", 
             RowBox[{"\[Alpha]", "-", "1", "+", "j"}]}],
            FontSize->14]], 
          RowBox[{"\[Beta]", ">", "j"}]}
        },
        AllowedDimensions->{2, Automatic},
        Editable->True,
