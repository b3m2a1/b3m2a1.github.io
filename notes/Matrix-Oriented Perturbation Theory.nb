 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["\[CapitalPhi]", "x"], "=", 
      RowBox[{"{", 
       RowBox[{
        SubscriptBox[
         TemplateBox[{"0"},
          "Ket"], "x"], ",", " ", 
        SubscriptBox[
         TemplateBox[{"1"},
          "Ket"], "x"]}], "}"}]}]},
    {
     RowBox[{
      SubscriptBox["\[CapitalPhi]", "y"], "=", 
      RowBox[{"{", 
       RowBox[{
        SubscriptBox[
         TemplateBox[{"0"},
          "Ket"], "y"], ",", " ", 
        SubscriptBox[
         TemplateBox[{"1"},
          "Ket"], "y"]}], "}"}]}]},
    {
     RowBox[{
      SubscriptBox["\[CapitalPhi]", "z"], "=", 
      RowBox[{"{", 
       RowBox[{
        SubscriptBox[
         TemplateBox[{"0"},
          "Ket"], "z"], ",", " ", 
        SubscriptBox[
         TemplateBox[{"1"},
          "Ket"], "z"]}], "}"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
