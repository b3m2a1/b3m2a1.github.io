      FractionBox[
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], "d"}], 
       RowBox[{
        RowBox[{"\[PartialD]", 
         SubscriptBox["r", "i"]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["r", "j"]}]}]], "+", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"4", "\[InvisibleSpace]", "d"}]], 
       FractionBox[
        RowBox[{"\[PartialD]", "\[VeryThinSpace]", "d"}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["r", "i"]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", "\[VeryThinSpace]", "d"}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["r", "j"]}]]}]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
