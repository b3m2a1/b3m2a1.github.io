         RowBox[{
          SubsuperscriptBox["\[CapitalGamma]", "m", 
           RowBox[{"(", 
            SubscriptBox["q", "i"], ")"}]], 
          SubscriptBox["\[Delta]", 
           RowBox[{
            SubscriptBox["\[Tau]", "i"], "1"}]]}]}], ")"}], 
       SubsuperscriptBox["\[CapitalDelta]H", "m", 
        RowBox[{"(", 
         SubscriptBox["q", "N"], ")"}]], 
