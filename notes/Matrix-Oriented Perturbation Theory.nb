        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "2", ")"}]]}], "+", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]]}]}]}]},
    {
     RowBox[{
      SubsuperscriptBox["B", "n", 
       RowBox[{"(", "4", ")"}]], "=", "\[AlignmentMarker]", 
      RowBox[{
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", "4", ")"}]], "+", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "3", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]]}]}]}]},
    {
     RowBox[{"\[AlignmentMarker]", 
      RowBox[{
       RowBox[{
        RowBox[{"+", 
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", "2", ")"}]]}], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "2", ")"}]]}], "+", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "2", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]]}]}]}]},
    {
     RowBox[{"\[AlignmentMarker]", 
      RowBox[{
       RowBox[{
        RowBox[{"+", "\[AlignmentMarker]", 
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", "1", ")"}]]}], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "3", ")"}]]}], "+", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "2", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]]}]}]}]},
    {
     RowBox[{"\[AlignmentMarker]", 
      RowBox[{
       RowBox[{
        RowBox[{"+", 
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", "1", ")"}]]}], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "2", ")"}]]}], "+", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]], 
