          RowBox[{"i", "=", "1"}], 
          RowBox[{"k", "-", "1"}]], 
         RowBox[{
          TemplateBox[{
            RowBox[{
              SuperscriptBox["\[Eta]", 
               RowBox[{"(", 
                 RowBox[{"k", "-", "i"}], ")"}]], " "}], 
