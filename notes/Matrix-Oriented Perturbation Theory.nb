Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], "a"], " ", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {
         RowBox[{"i", "+", "b", "-", "1"}]},
        {
         RowBox[{"b", "-", "1"}]}
       },
       GridBoxAlignment->{"Columns" -> {Center}}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"l", "=", "0"}], 
        RowBox[{"b", "-", "k"}]], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox["c", 
           RowBox[{
            RowBox[{"k", "\[InvisibleSpace]", "l"}], "-", "1"}], 
           RowBox[{"(", 
            RowBox[{"b", "-", "1"}], ")"}]], "+", 
          SubsuperscriptBox["c", 
           RowBox[{"k", "\[InvisibleSpace]", "-", 
            RowBox[{"1", "l"}]}], 
           RowBox[{"(", 
            RowBox[{"b", "-", "1"}], ")"}]], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"b", "-", "1"}], ")"}], 
           SubsuperscriptBox["c", 
            RowBox[{"k", "\[InvisibleSpace]", "l"}], 
            RowBox[{"(", 
             RowBox[{"b", "-", "1"}], ")"}]]}]}], ")"}], 
        SuperscriptBox["i", "l"]}]}], ")"}]}]}], " ", "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"l", "=", "0"}], 
     RowBox[{"b", "-", "k"}]], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["c", 
        RowBox[{
         RowBox[{"k", "\[InvisibleSpace]", "l"}], "-", "1"}], 
        RowBox[{"(", 
         RowBox[{"b", "-", "1"}], ")"}]], "+", 
       SubsuperscriptBox["c", 
        RowBox[{"k", "\[InvisibleSpace]", "-", 
         RowBox[{"1", "l"}]}], 
        RowBox[{"(", 
         RowBox[{"b", "-", "1"}], ")"}]], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"b", "-", "1"}], ")"}], 
        SubsuperscriptBox["c", 
         RowBox[{"k", "\[InvisibleSpace]", "l"}], 
         RowBox[{"(", 
          RowBox[{"b", "-", "1"}], ")"}]]}]}], ")"}], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "0"}], "a"], " ", 
      RowBox[{
       RowBox[{"(", GridBox[{
          {
           RowBox[{"i", "+", "b", "-", "1"}]},
          {
           RowBox[{"b", "-", "1"}]}
         },
         GridBoxAlignment->{"Columns" -> {Center}}], ")"}], " ", 
       SuperscriptBox["i", "l"]}]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
