 FormBox[
  RowBox[{
   RowBox[{"B", "(", 
    RowBox[{"a", ",", " ", "\[Omega]"}], ")"}], " ", "=", " ", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "a"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
