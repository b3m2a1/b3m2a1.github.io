Cell[CellGroupData[{

Cell["\<\
Cursed Attempt with the Bernoulli Numbers and Explicit Factorization\
\>", "Subsubsubsection",
 CellChangeTimes->{{3.88947135954885*^9, 
  3.889471370790616*^9}},ExpressionUUID->"d593d879-16ec-4723-a839-\
ef02f90f23a6"],

Cell["\<\
where polynomials that go out of bounds are uniformly zero, we can then swap \
our summation indices and expand the polynomials to give\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8894482444917088`*^9, 3.8894482678310757`*^9}, {
  3.889448300665668*^9, 
  3.8894483518908663`*^9}},ExpressionUUID->"c4acff0e-5c6d-4a22-a0bd-\
bc31dafc9bf4"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["P", "b", "a"], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "0"}], "b"], "\[VeryThinSpace]", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], "a"], "\[VeryThinSpace] ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"i", "-", "b", "+", "1"}], ")"}], 
            RowBox[{
             SubsuperscriptBox["Q", "k", 
              RowBox[{"(", 
               RowBox[{"b", "-", "1"}], ")"}]], "(", "i", ")"}]}], " ", "+", 
           " ", 
           RowBox[{
            SubsuperscriptBox["Q", 
             RowBox[{"k", "-", "1"}], 
             RowBox[{"(", 
              RowBox[{"b", "-", "1"}], ")"}]], "(", "i", ")"}]}], ")"}], 
         SuperscriptBox["n", "k"]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "0"}], "b"], "\[VeryThinSpace]", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], "a"], "\[VeryThinSpace] ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"i", "-", 
              RowBox[{"(", 
               RowBox[{"b", "-", "1"}], ")"}]}], ")"}], 
            RowBox[{
             UnderoverscriptBox["\[Sum]", 
              RowBox[{"l", "=", "0"}], 
              RowBox[{
               RowBox[{"2", "\[InvisibleSpace]", "b"}], "-", "k", "-", "1"}]],
              "\[VeryThinSpace]", 
             RowBox[{
              SubsuperscriptBox["c", 
               RowBox[{"k", "\[InvisibleSpace]", "l"}], 
               RowBox[{"(", 
                RowBox[{"b", "-", "1"}], ")"}]], 
              SuperscriptBox["i", "l"]}]}]}], "\[InvisibleSpace] ", "+", " ", 
           
           RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{"l", "=", "0"}], 
             RowBox[{
              RowBox[{"2", "\[InvisibleSpace]", "b"}], "-", "k"}]], 
            "\[VeryThinSpace]", 
            RowBox[{
             SubsuperscriptBox["c", 
              RowBox[{"k", "-", 
               RowBox[{"1", "\[InvisibleSpace]", "l"}]}], 
              RowBox[{"(", 
               RowBox[{"b", "-", "1"}], ")"}]], 
             SuperscriptBox["i", "l"]}]}]}], "\[InvisibleSpace]", ")"}], 
         SuperscriptBox["n", "k"]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "0"}], "b"], "\[VeryThinSpace]", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], "a"], "\[VeryThinSpace] ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{"l", "=", "0"}], 
             RowBox[{
              RowBox[{"2", "\[InvisibleSpace]", "b"}], "-", "k", "-", "1"}]], 
            "\[VeryThinSpace]", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               SubsuperscriptBox["c", 
                RowBox[{"k", "\[InvisibleSpace]", "l"}], 
                RowBox[{"(", 
                 RowBox[{"b", "-", "1"}], ")"}]], 
               SuperscriptBox["i", 
                RowBox[{"l", "+", "1"}]]}], "\[InvisibleSpace]", "-", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"b", "-", "1"}], ")"}], 
               SubsuperscriptBox["c", 
                RowBox[{"k", "\[InvisibleSpace]", "l"}], 
                RowBox[{"(", 
                 RowBox[{"b", "-", "1"}], ")"}]], 
               SuperscriptBox["i", "l"]}]}], "\[InvisibleSpace]", ")"}]}], 
           " ", "+", " ", 
           RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{"l", "=", "0"}], 
             RowBox[{
              RowBox[{"2", "\[InvisibleSpace]", "b"}], "-", "k"}]], 
            "\[VeryThinSpace]", 
            RowBox[{
             SubsuperscriptBox["c", 
              RowBox[{"k", "-", 
               RowBox[{"1", "\[InvisibleSpace]", "l"}]}], 
              RowBox[{"(", 
               RowBox[{"b", "-", "1"}], ")"}]], 
             SuperscriptBox["i", "l"]}]}]}], "\[InvisibleSpace]", ")"}], 
         SuperscriptBox["n", "k"]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "0"}], "b"], "\[VeryThinSpace]", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], "a"], "\[VeryThinSpace] ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"l", "=", "0"}], 
            RowBox[{
             RowBox[{"2", "\[InvisibleSpace]", "b"}], "-", "k"}]], 
           "\[VeryThinSpace]", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              SubsuperscriptBox["c", 
               RowBox[{
                RowBox[{"k", "\[InvisibleSpace]", "l"}], "-", "1"}], 
               RowBox[{"(", 
                RowBox[{"b", "-", "1"}], ")"}]], "-", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"b", "-", "1"}], ")"}], 
               SubsuperscriptBox["c", 
                RowBox[{"k", "\[InvisibleSpace]", "l"}], 
                RowBox[{"(", 
                 RowBox[{"b", "-", "1"}], ")"}]]}], "+", 
              SubsuperscriptBox["c", 
               RowBox[{"k", "-", 
                RowBox[{"1", "\[InvisibleSpace]", "l"}]}], 
               RowBox[{"(", 
                RowBox[{"b", "-", "1"}], ")"}]]}], ")"}], 
            SuperscriptBox["i", "l"]}]}], 
          "\[InvisibleSpace]\[InvisibleSpace]", ")"}], 
         SuperscriptBox["n", "k"]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.889297158544037*^9, 3.8892972284816217`*^9}, {
   3.8892984184040318`*^9, 3.889298495516101*^9}, {3.8892985437792053`*^9, 
