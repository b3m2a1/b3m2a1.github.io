        ")"}]}]}]},
    {
     RowBox[{"+=", "                                     ", 
      RowBox[{"+", " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"\[Omega]", "=", "1"}], 
         RowBox[{
          RowBox[{"2", "\[InvisibleSpace]", "b"}], "-", "3"}]], 
        "\[VeryThinSpace] ", 
        RowBox[{
         RowBox[{"(", 
