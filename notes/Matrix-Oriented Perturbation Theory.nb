411fa5b8f9b2"],

Cell["\<\
This is a totally general implementation of non-degenerate perturbation \
theory up to arbitrary order. You\[CloseCurlyQuote]ve got to supply the \
perturbations, though.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.810856178510859*^9, 3.810856208457443*^9}, {
  3.810994355478326*^9, 
  3.810994362306975*^9}},ExpressionUUID->"c2b638bd-949e-43f1-b07d-\
e97cb3e6534e"],

Cell[CellGroupData[{

Cell["getVPT2Corrections", "Subsubsection",
 CellChangeTimes->{
  3.810866723365466*^9},ExpressionUUID->"6ca5f244-f733-4d34-95ff-\
fcdca1c38c87"],

Cell[BoxData[{
 RowBox[{"getVPT2Corrections", "//", "ClearAll"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"getVPT2Corrections", "[", "\[IndentingNewLine]", 
    RowBox[{"n_", ",", " ", "\[IndentingNewLine]", 
     RowBox[{"perts", ":", "_List"}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{"order", ":", "_Integer", ":", "2"}]}], "\[IndentingNewLine]", 
    "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"energies", "=", 
        RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"overlaps", "=", 
        RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"corrs", "=", 
        RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", "e0vec", ",", 
       "\[IndentingNewLine]", "en", ",", "\[IndentingNewLine]", 
       "\[CapitalPi]n", ",", "\[IndentingNewLine]", "eng", ",", 
       "\[IndentingNewLine]", "corr", ",", "\[IndentingNewLine]", "ov", ",", 
       "\[IndentingNewLine]", "nstates"}], "\[IndentingNewLine]", "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"e0vec", "=", 
       RowBox[{"Diagonal", "[", 
        RowBox[{"perts", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"en", "=", 
       RowBox[{"e0vec", "[", 
        RowBox[{"[", "n", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"e0vec", " ", "=", " ", 
       RowBox[{"e0vec", " ", "-", " ", "en"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"e0vec", "[", 
        RowBox[{"[", "n", "]"}], "]"}], " ", "=", " ", "1"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[CapitalPi]n", " ", "=", " ", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"1", "/", "e0vec"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[CapitalPi]n", "[", 
        RowBox[{"[", 
         RowBox[{"n", ",", " ", "n"}], "]"}], "]"}], "=", "0"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nstates", " ", "=", " ", 
       RowBox[{"Length", "[", "e0vec", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"energies", ",", " ", "en"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"overlaps", ",", " ", "1"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"corrs", ",", " ", "\[IndentingNewLine]", 
        RowBox[{"ReplacePart", "[", 
         RowBox[{
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0.", ",", " ", "nstates"}], "]"}], ",", " ", 
          RowBox[{"n", "\[Rule]", "1"}]}], "]"}]}], "\[IndentingNewLine]", 
       "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"AppendTo", "[", "\[IndentingNewLine]", 
          RowBox[{"energies", ",", " ", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "perts", "]"}], ">=", "k"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"perts", "[", 
                RowBox[{"[", "k", "]"}], "]"}], "[", 
               RowBox[{"[", 
                RowBox[{"n", ",", " ", "n"}], "]"}], "]"}], ",", 
              "\[IndentingNewLine]", "0"}], "\[IndentingNewLine]", "]"}], "+",
             "\[IndentingNewLine]", 
            RowBox[{"Sum", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Length", "[", "perts", "]"}], ">=", 
                  RowBox[{"(", 
                   RowBox[{"k", "-", "i"}], ")"}]}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"perts", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "-", "i"}], "]"}], "]"}], "[", 
                   RowBox[{"[", "n", "]"}], "]"}], ".", 
                  RowBox[{"corrs", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", 
                 "\[IndentingNewLine]", "0"}], "\[IndentingNewLine]", "]"}], 
               "-", 
               RowBox[{
                RowBox[{"energies", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", "-", "i"}], "]"}], "]"}], "*", 
                RowBox[{"overlaps", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", "+", "1"}], "]"}], "]"}]}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"i", ",", " ", "1", ",", " ", 
                RowBox[{"k", "-", "2"}]}], "}"}]}], "\[IndentingNewLine]", 
             "]"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", "\[IndentingNewLine]", 
          RowBox[{"overlaps", ",", "\[IndentingNewLine]", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "1"}], "/", "2"}], " ", "*", " ", 
            RowBox[{"Sum", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"corrs", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", "+", "1"}], "]"}], "]"}], ".", 
                RowBox[{"corrs", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", "-", "i"}], "]"}], "]"}]}], ")"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"i", ",", "  ", "1", ",", " ", 
                RowBox[{"k", "-", "2"}]}], "}"}]}], "\[IndentingNewLine]", 
             "]"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", "\[IndentingNewLine]", 
          RowBox[{"corrs", ",", "\[IndentingNewLine]", 
           RowBox[{"Sum", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"\[CapitalPi]n", ".", 
              RowBox[{"(", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"energies", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", "-", "i"}], "]"}], "]"}], "*", 
                 RowBox[{"corrs", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", "+", "1"}], "]"}], "]"}]}], 
                "\[IndentingNewLine]", "-", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Length", "[", "perts", "]"}], ">=", 
                   RowBox[{"(", 
                    RowBox[{"k", "-", "i"}], ")"}]}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"perts", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "-", "i"}], "]"}], "]"}], ".", 
                   RowBox[{"corrs", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{"ConstantArray", "[", 
                   RowBox[{"0", ",", " ", "nstates"}], "]"}]}], 
                 "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
               ")"}]}], ",", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"i", ",", " ", "0", ",", " ", 
               RowBox[{"k", "-", "2"}]}], "}"}]}], "\[IndentingNewLine]", 
            "]"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"corrs", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", " ", "n"}], "]"}], "]"}], "=", 
          RowBox[{"overlaps", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "2", ",", " ", 
          RowBox[{"order", "+", "1"}]}], "}"}]}], "\[IndentingNewLine]", 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
       "energies", ",", "\[IndentingNewLine]", "overlaps", ",", 
        "\[IndentingNewLine]", "corrs"}], "\[IndentingNewLine]", "}"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.810845220994726*^9, 3.8108453382993793`*^9}, {
   3.810845377086297*^9, 3.810845701284471*^9}, {3.810845955883531*^9, 
   3.810846012133095*^9}, {3.810846057185772*^9, 3.810846286415007*^9}, {
   3.810846528797184*^9, 3.810846532909854*^9}, {3.810846577432933*^9, 
   3.8108466471975117`*^9}, 3.810846701957219*^9, {3.81084682109313*^9, 
   3.8108468352805967`*^9}, {3.810848523613305*^9, 3.810848525902225*^9}, {
   3.8108485645637417`*^9, 3.810848574795786*^9}, {3.810848610543318*^9, 
   3.8108486127857723`*^9}, {3.8108487109625797`*^9, 3.810848785484312*^9}, {
   3.810848848019548*^9, 3.810848851111484*^9}, {3.8108489805750933`*^9, 
   3.81084903837074*^9}, {3.810849112319187*^9, 3.8108492356867847`*^9}, 
   3.810849388320364*^9, {3.810849487416497*^9, 3.8108495345974083`*^9}, {
   3.810849565323406*^9, 3.810849781855434*^9}, {3.810849840785452*^9, 
   3.8108498730948257`*^9}, {3.810852362995482*^9, 3.810852383268718*^9}, {
   3.810852413955072*^9, 3.810852561758519*^9}, {3.810852607093987*^9, 
   3.810852794146639*^9}, {3.8108529001574497`*^9, 3.8108529004205008`*^9}, {
   3.8108542787696*^9, 3.810854320412311*^9}, {3.810856161953483*^9, 
   3.810856162353454*^9}, {3.810904331993396*^9, 3.8109044021290617`*^9}, {
   3.810904695017807*^9, 3.8109046952192793`*^9}, {3.810904727662653*^9, 
   3.8109047481018744`*^9}, {3.810912242656673*^9, 3.810912288759988*^9}, {
   3.810912681247984*^9, 3.81091275738873*^9}, {3.810912870615328*^9, 
   3.810913028545836*^9}, {3.810913058573557*^9, 3.8109130879569407`*^9}, {
   3.81091702285832*^9, 3.810917025611322*^9}, {3.810918784077353*^9, 
   3.8109187899129333`*^9}},
