Cell[CellGroupData[{

Cell["Perturbation Theory Extensions", "Section",
 CellChangeTimes->{{3.825687185554212*^9, 3.825687190812457*^9}, {
  3.828033849059355*^9, 3.8280338504720163`*^9}, {3.916906400067976*^9, 
  3.916906400402369*^9}},ExpressionUUID->"e767e8b0-6806-41ab-bf98-\
f07d5ffd1ac6"],

Cell["\<\
We\[CloseCurlyQuote]re going to redo what we did before, but with more \
insight this time. \
\>", "ExpositoryText",
 CellChangeTimes->{{3.825687194548472*^9, 3.825687228183972*^9}, {
   3.8256872657361193`*^9, 3.825687267514983*^9}, 
   3.8256873324982367`*^9},ExpressionUUID->"2b1ed1b8-d040-4024-b742-\
20669adc7623"],

Cell["We start out by defining", "ExpositoryText",
 CellChangeTimes->{{3.825687194548472*^9, 3.825687228183972*^9}, {
  3.8256872657361193`*^9, 
  3.825687267514983*^9}},ExpressionUUID->"8a87c9bd-5581-4e76-a3ac-\
d4f2fd1bbd10"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[CapitalDelta]H", "n", 
    RowBox[{"(", "i", ")"}]], "=", 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["H", 
      RowBox[{"(", "i", ")"}]], "-", 
     SubsuperscriptBox["E", "n", 
      RowBox[{"(", "i", ")"}]]}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8256872452947474`*^9, 
  3.825687270458078*^9}},ExpressionUUID->"7c06bae4-4ce4-4548-acb8-\
42ce48b92876"],

Cell[TextData[{
 "the benefit of this definition is that if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"n"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "367633d1-52fe-4ddc-84cd-18bdab7fd0a4"],
 " is an eigenstate of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]],ExpressionUUID->
  "f9b09697-806d-43d1-830d-4aea3bcdc49a"],
 " then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[CapitalDelta]H", "n", 
      RowBox[{"(", "i", ")"}]], 
     TemplateBox[{"n"},
      "Ket"]}], " ", "=", " ", "\[DoubleStruckZero]"}], TraditionalForm]],
  ExpressionUUID->"c0547a7a-3d14-4529-8df2-f1e63222425c"],
 ". This will allow us to understand the operations in the perturbation \
theory as accounting for the deviation of each applied state from being an \
eigenstate of the operator. "
}], "ExpositoryText",
 CellChangeTimes->{{3.825687272159136*^9, 
  3.825687385484483*^9}},ExpressionUUID->"205866c8-2cfe-4329-8bdb-\
3dc752c884a2"],

Cell["\<\
Next we\[CloseCurlyQuote]ll introduce the concept of a perturbation operator \
which will be an approximate inverse to a term looking like\
\>", "ExpositoryText",
 CellChangeTimes->{{3.825687400496524*^9, 3.82568748521315*^9}, {
  3.8256875448052588`*^9, 
  3.825687547247418*^9}},ExpressionUUID->"923e9182-950c-49f2-afdf-\
7ef283cfe653"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["P", "S", "\[Sigma]"], "=", 
      RowBox[{
       SubscriptBox["P", "S"], "-", 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["s", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"], 
        TemplateBox[{
          SuperscriptBox["s", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"]}]}]}]},
    {
     RowBox[{
      SubsuperscriptBox["\[CapitalPi]", "S", "\[Sigma]"], "=", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox[
         RowBox[{
          SubsuperscriptBox["P", "S", "\[Sigma]"], "(", 
          RowBox[{
           SubsuperscriptBox["H", "S", 
            RowBox[{"(", "0", ")"}]], "-", 
           SubsuperscriptBox["E", "\[Sigma]", 
            RowBox[{"(", "0", ")"}]]}], ")"}], 
         RowBox[{"-", "1"}]]}], 
       SubsuperscriptBox["P", "S", "\[Sigma]"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.82568808986806*^9, 3.8256881882431707`*^9}, {
  3.825688290020306*^9, 3.825688292568527*^9}, {3.825692618430691*^9, 
  3.82569265528485*^9}, {3.825701349423785*^9, 
  3.825701356827602*^9}},ExpressionUUID->"0a51accd-8a42-4ccc-ac2c-\
72f38f5d902f"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["H", "S", 
    RowBox[{"(", "0", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.82568808986806*^9, 3.8256881882431707`*^9}},
  ExpressionUUID->"0d30709f-d431-40ae-9e2f-40aef7348a48"],
 " is an effective zero-order Hamiltonian in the space ",
 StyleBox["S",
  FontSlant->"Italic"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["E", "\[Sigma]", 
    RowBox[{"(", "0", ")"}]], TraditionalForm]],ExpressionUUID->
  "5845231d-28c6-4ad1-93a5-d91f1ef1d4d4"],
 " is the effective energy of the zero-order state ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["\[Sigma]", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "c022a5de-1866-402a-95e5-8fb7229720d0"],
 " in this space. This will be important when we handle degeneracies, as we \
will do this by choosing subspaces where the degeneracies go away."
}], "ExpositoryText",
 CellChangeTimes->{{3.825688193065284*^9, 3.825688349906783*^9}, {
  3.8256926058648233`*^9, 
  3.825692611402419*^9}},ExpressionUUID->"4e952438-b47f-497a-bd72-\
460073614f4b"],

Cell["The systems of equations we\[CloseCurlyQuote]re solving are given by", \
"ExpositoryText",
 CellChangeTimes->{{3.825692129450513*^9, 
  3.825692139363367*^9}},ExpressionUUID->"23baef2d-b645-4c78-88ee-\
7d78ae6cef7c"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[DoubleStruckZero]", " ", "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], "k"], 
    RowBox[{
     SubsuperscriptBox["\[CapitalDelta]H", "n", 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "i", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8256872291775417`*^9, 3.8256872389951677`*^9}, {
  3.825687326142096*^9, 3.825687327096546*^9}, {3.8256921414311867`*^9, 
  3.8256921601279507`*^9}},ExpressionUUID->"295ee1f5-b642-479b-a01d-\
16f0b484fc07"],

Cell[TextData[{
 "up to some maximal order of correction ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "bb95b0f0-00fc-4f22-b48a-e7b6c191d4e7"],
 ". "
}], "ExpositoryText",
 CellChangeTimes->{{3.82569216272435*^9, 
  3.825692179511648*^9}},ExpressionUUID->"bfe3eb35-2d4d-4fa0-9ef0-\
bdee6e738dc4"],

Cell[TextData[{
 "This leads to a straightforward expression for the energy at order ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "d9f72b65-4a06-462e-9383-e1f7acbe26d8"]
}], "ExpositoryText",
 CellChangeTimes->{{3.825692185615271*^9, 3.825692214432034*^9}, {
  3.825692276771833*^9, 
  3.825692330158882*^9}},ExpressionUUID->"7594a119-085e-41fc-818e-\
8ee0a1ad162a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["E", "n", 
    RowBox[{"(", "k", ")"}]], " ", "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     SuperscriptBox["H", 
      RowBox[{"(", "k", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], 
      RowBox[{"k", "-", "1"}]], 
     RowBox[{
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]]},
       "Bra"], 
      SubsuperscriptBox["\[CapitalDelta]H", "n", 
       RowBox[{"(", 
        RowBox[{"k", "-", "i"}], ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825692209079288*^9, 
  3.825692275571329*^9}},ExpressionUUID->"5bcb8ec1-a135-40de-8217-\
a36fe942b2d6"],

Cell[TextData[{
 "where we\[CloseCurlyQuote]ve made use of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     SubsuperscriptBox["\[CapitalDelta]H", "n", 
      RowBox[{"(", "0", ")"}]]}], "=", "\[DoubleStruckZero]"}], 
   TraditionalForm]],ExpressionUUID->"caecc905-ebeb-495e-9fd4-f3b454ee890e"]
}], "ExpositoryText",
 CellChangeTimes->{{3.825692270881221*^9, 
  3.8256923263138533`*^9}},ExpressionUUID->"f4c0623b-e225-4e21-8dc9-\
8e08b1388c71"],

Cell[TextData[{
 "And similarly we able to obtain expressions for most of the correction to \
the wave functions by calling our total state space ",
 StyleBox["T",
  FontSlant->"Italic"],
 " and writing"
}], "ExpositoryText",
 CellChangeTimes->{{3.82569233167197*^9, 3.825692351592855*^9}, {
  3.825692507973672*^9, 
  3.825692563416883*^9}},ExpressionUUID->"af1915fb-fa90-4518-82d3-\
8e216f421361"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["P", "S", "\[Sigma]"], " ", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], " ", "=", 
   RowBox[{
    SubsuperscriptBox["\[CapitalPi]", "S", "\[Sigma]"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], 
      RowBox[{"k", "-", "1"}]], 
     RowBox[{
      SubsuperscriptBox["\[CapitalDelta]H", "n", 
       RowBox[{"(", 
        RowBox[{"k", "-", "i"}], ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825692559712953*^9, 3.825692589956435*^9}, {
  3.825692664472829*^9, 
  3.825692686108691*^9}},ExpressionUUID->"9a79e97f-1806-49ee-9dff-\
24e7f291468e"],

Cell["which coms from", "ExpositoryText",
 CellChangeTimes->{{3.827372585849956*^9, 
  3.827372588741247*^9}},ExpressionUUID->"985c222a-4654-47c5-9155-\
fc958d3f3558"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["P", "U"], "(", 
        RowBox[{"-", 
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", "0", ")"}]]}], ")"}], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Ket"]}], " ", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["P", "U"], "(", 
         RowBox[{"-", 
          SubsuperscriptBox["\[CapitalDelta]H", "n", 
           RowBox[{"(", "0", ")"}]]}], ")"}], 
        SubscriptBox["P", "U"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "k", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        RowBox[{
         SubscriptBox["P", "U"], "(", 
         RowBox[{"-", 
          SubsuperscriptBox["\[CapitalDelta]H", "n", 
           RowBox[{"(", "0", ")"}]]}], ")"}], 
        SubscriptBox["P", "D"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "k", ")"}]]},
         "Ket"]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        SubscriptBox["P", "U"], "(", 
        RowBox[{"-", 
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", "0", ")"}]]}], ")"}], 
       SubscriptBox["P", "U"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Ket"], " ", 
       RowBox[{"(", 
        RowBox[{"by", " ", "commutativity"}], ")"}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       SubscriptBox["P", "U"], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], 
         RowBox[{"k", "-", "1"}]], 
        RowBox[{
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", 
           RowBox[{"k", "-", "i"}], ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.827372594864367*^9, 
  3.827372816021266*^9}},ExpressionUUID->"311a5efd-bb1a-4520-8523-\
86708ce3fad6"],

Cell["so", "Text",
 CellChangeTimes->{{3.827372823862424*^9, 
  3.8273728252882442`*^9}},ExpressionUUID->"7121f522-183b-4ef0-8cd1-\
5eaa5d720984"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["P", "S", "\[Sigma]"], " ", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], " ", "=", 
   RowBox[{
    SubsuperscriptBox["\[CapitalPi]", "S", "\[Sigma]"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], 
      RowBox[{"k", "-", "1"}]], 
     RowBox[{
      SubsuperscriptBox["\[CapitalDelta]H", "n", 
       RowBox[{"(", 
        RowBox[{"k", "-", "i"}], ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825692559712953*^9, 3.825692589956435*^9}, {
  3.825692664472829*^9, 
  3.825692686108691*^9}},ExpressionUUID->"88e09fbd-66c5-49a9-9050-\
7fabe1ca0fac"],

Cell[TextData[{
 "finally by enforcing a normalization criterion and using the fact that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "k", ")"}]], " "}], 
     RowBox[{"\[VeryThinSpace] ", 
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]}]},
    "BraKet"], TraditionalForm]],
  CellChangeTimes->{{3.810298064347456*^9, 3.810298065808156*^9}, {
    3.8256930726581993`*^9, 3.82569310702492*^9}, {3.8256931624983473`*^9, 
    3.82569328647795*^9}, {3.825693322697385*^9, 3.825693342457131*^9}, {
    3.825693472767775*^9, 3.825693558979526*^9}, {3.825693639073412*^9, 
    3.8256936554271183`*^9}, {3.825693797791065*^9, 3.825693826823798*^9}, 
    3.8256938584596786`*^9, {3.8256940194315*^9, 3.8256941792482452`*^9}},
  ExpressionUUID->"1167dbe2-c7d4-442f-9d4a-5f45a1bd65b4"],
 " is the complex conjugate of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]], " "}], 
     RowBox[{"\[VeryThinSpace] ", 
       SuperscriptBox["n", 
        RowBox[{"(", "k", ")"}]]}]},
    "BraKet"], TraditionalForm]],
  CellChangeTimes->{{3.810298064347456*^9, 3.810298065808156*^9}, {
    3.8256930726581993`*^9, 3.82569310702492*^9}, {3.8256931624983473`*^9, 
    3.82569328647795*^9}, {3.825693322697385*^9, 3.825693342457131*^9}, {
    3.825693472767775*^9, 3.825693558979526*^9}, {3.825693639073412*^9, 
    3.8256936554271183`*^9}, {3.825693797791065*^9, 3.825693826823798*^9}, 
    3.8256938584596786`*^9, {3.8256940194315*^9, 3.8256941792482452`*^9}},
  ExpressionUUID->"df8f943a-3092-4c94-a628-bafec9a23b15"],
 " we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.825692786719042*^9, 3.8256928165962267`*^9}, {
  3.825692968040131*^9, 3.825692970690995*^9}, {3.825694192486917*^9, 
  3.8256942091607037`*^9}},ExpressionUUID->"f8e6c9a6-71e5-4f90-a604-\
69d474dff81d"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         RowBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]], " "}], 
         RowBox[{"\[VeryThinSpace] ", 
           SuperscriptBox["n", 
            RowBox[{"(", "k", ")"}]]}]},
        "BraKet"], "+", 
       TemplateBox[{
         RowBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "k", ")"}]], " "}], 
         RowBox[{"\[VeryThinSpace] ", 
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]}]},
        "BraKet"]}], "=", 
      RowBox[{"-", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], 
         RowBox[{"k", "-", "1"}]], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "i", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", 
               RowBox[{"k", "-", "i"}], ")"}]]}]},
         "BraKet"]}]}]}]},
    {
     RowBox[{
      RowBox[{"Re", "(", 
       TemplateBox[{
         RowBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]], " "}], 
         RowBox[{"\[VeryThinSpace] ", 
           SuperscriptBox["n", 
            RowBox[{"(", "k", ")"}]]}]},
        "BraKet"], ")"}], "=", 
      FractionBox[
       RowBox[{
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", "k", ")"}]]}]},
         "BraKet"], "+", 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "k", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]]}]},
         "BraKet"]}], "2"]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], 
         RowBox[{"k", "-", "1"}]], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "i", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", 
               RowBox[{"k", "-", "i"}], ")"}]]}]},
         "BraKet"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.810298064347456*^9, 3.810298065808156*^9}, {
   3.8256930726581993`*^9, 3.82569310702492*^9}, {3.8256931624983473`*^9, 
   3.82569328647795*^9}, {3.825693322697385*^9, 3.825693342457131*^9}, {
   3.825693472767775*^9, 3.825693558979526*^9}, {3.825693639073412*^9, 
   3.8256936554271183`*^9}, {3.825693797791065*^9, 3.825693826823798*^9}, 
   3.8256938584596786`*^9, {3.8256940194315*^9, 3.8256941792482452`*^9}, 
   3.825694520466913*^9},ExpressionUUID->"7fe3a81e-24ea-4abb-9bdf-\
24209dd1b88b"],

Cell[TextData[{
 "and the imaginary part is indeterminate,",
 StyleBox[" so we can choose it to be 0",
  FontWeight->"Bold"],
 " ",
 StyleBox["(check this)",
  FontSlant->"Italic"]
}], "ExpositoryText",
 CellChangeTimes->{{3.8256945291892014`*^9, 
  3.8256945815380774`*^9}},ExpressionUUID->"4f58898b-bbe1-4b9a-b3ad-\
1cdb7618a830"],

Cell[CellGroupData[{

Cell["Formal Analysis of Non-Degenerate Wavefunctions", "Subsubsection",
 CellChangeTimes->{{3.827715416038515*^9, 
  3.827715437950015*^9}},ExpressionUUID->"e3786764-0691-4263-a319-\
724f0021bee0"],

Cell[TextData[{
 "We\[CloseCurlyQuote]ll suppose that for every to order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"j", " ", "<", " ", "k"}], TraditionalForm]], "ExpositoryText",
  ExpressionUUID->"8edc5778-9436-4d96-bcea-0df9fc033732"],
 " we can write"
}], "ExpositoryText",
 CellChangeTimes->{{3.827706807475383*^9, 3.827706808342744*^9}, {
   3.827706868812252*^9, 3.827706954614575*^9}, {3.827706994562725*^9, 
   3.82770699494514*^9}, 
   3.827715434490423*^9},ExpressionUUID->"7d16ea8f-65cf-46a4-942a-\
b195703d2e1a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", "U"], " ", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "j", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    SubscriptBox["\[CapitalPi]", "n"], 
    SubsuperscriptBox["A", "n", 
     RowBox[{"(", "j", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.827706924616128*^9, 3.8277069254469767`*^9}, {
  3.827706956741692*^9, 
  3.827706980221196*^9}},ExpressionUUID->"1333088c-3cd1-46ea-99a7-\
e1ba41d7d740"],

Cell["well then clearly", "ExpositoryText",
 CellChangeTimes->{{3.827706983693192*^9, 
  3.827706986281434*^9}},ExpressionUUID->"8ddbdbe1-dc50-49a1-afd4-\
65c5fc3a14a6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", "U"], " ", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], " ", "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[CapitalPi]", "n"], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "0"}], 
       RowBox[{"k", "-", "1"}]], 
      RowBox[{
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", 
         RowBox[{"k", "-", "i"}], ")"}]], 
       SubscriptBox["\[CapitalPi]", "n"], 
       SubsuperscriptBox["A", "n", 
        RowBox[{"(", "i", ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]}], "+", 
    RowBox[{
     SubsuperscriptBox["\[CapitalDelta]H", "n", 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"], 
     TemplateBox[{
       RowBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]], " "}], 
       RowBox[{"\[VeryThinSpace] ", 
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]]}]},
      "BraKet"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.827706997004712*^9, 
  3.827707008059902*^9}},ExpressionUUID->"7a090024-8035-4ad1-8d63-\
875d618ef757"],

Cell["which means", "ExpositoryText",
 CellChangeTimes->{{3.8277070250028667`*^9, 
