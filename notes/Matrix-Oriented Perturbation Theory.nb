  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"A", "\[InvisibleSpace]", "B"}], ")"}], 
    RowBox[{"-", "1"}]], " ", "=", " ", 
   RowBox[{
    SuperscriptBox["B", 
