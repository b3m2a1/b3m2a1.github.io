Cell[BoxData[
 RowBox[{
  RowBox[{"cMat", "[", "b_", "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"S", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"StirlingS1", "[", 
          RowBox[{"k", ",", "w"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", "b"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"w", ",", "0", ",", "b"}], "}"}]}], "]"}]}], ",", 
      RowBox[{"J", "=", 
       RowBox[{"Array", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"#", ",", 
            RowBox[{"b", "-", "#2"}]}], "]"}], "&"}], ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"b", ",", "b"}], "}"}], "+", "1"}], ",", "0"}], "]"}]}], 
      ",", 
      RowBox[{"W", "=", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Binomial", "[", 
            RowBox[{"b", ",", "w"}], "]"}], "/", 
           RowBox[{"2", "^", "w"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"w", ",", "0", ",", "b"}], "}"}]}], "]"}], "]"}]}]}], 
     "}"}], ",", 
    RowBox[{
     RowBox[{"Transpose", "[", "S", "]"}], ".", 
     RowBox[{"(", 
      RowBox[{"J", ".", "W"}], ")"}], ".", "S"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.891102270779313*^9, 3.8911022707906237`*^9}},
