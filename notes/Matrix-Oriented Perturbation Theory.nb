Cell["and with this we can build up to arbitrary order", "ExpositoryText",
 CellChangeTimes->{{3.8217362624994*^9, 
  3.8217362779905024`*^9}},ExpressionUUID->"ce8e23a9-e6c6-489d-9d94-\
3ecfa4367049"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Degeneracies in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["E", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],ExpressionUUID->
  "bae78922-11f7-4a96-9ae7-0390584c2cd5"]
}], "Subsubsection",
 CellChangeTimes->{{3.821736281757633*^9, 
  3.821736291228383*^9}},ExpressionUUID->"248f5d86-1d2d-44d9-9559-\
2f245895a865"],

Cell[TextData[{
 "On occasion we\[CloseCurlyQuote]ll end with a degeneracy through ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],ExpressionUUID->
  "a9cdae39-4b00-4b96-b485-aae3a3c11717"],
 ". Just because, we\[CloseCurlyQuote]ll pretend that two of the states we \
had in ",
 Cell[BoxData[
  FormBox["D", TraditionalForm]],ExpressionUUID->
  "a5989e91-bc4b-47e8-a554-7e9405b84d9a"],
 " remain degenerate through ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],ExpressionUUID->
  "38399d3b-9130-459c-8f00-15a8d56c2738"],
 ".  This space is now expressed in terms of the zero-order states coming \
from ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]], "ExpositoryText",
  ExpressionUUID->"a7205087-27d8-420c-a64d-33af4a35e70b"],
 ", so the projection onto the twice degenerate space, ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],ExpressionUUID->
  "e2ce9646-2a75-40cc-8d6d-37cfcf93dde2"],
 ", and its complement ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "2b26bdff-d6c6-4232-94a6-038f9f9e88e3"],
 " look like"
}], "ExpositoryText",
 CellChangeTimes->{{3.821736435435191*^9, 3.821736475188756*^9}, {
  3.8217368291828938`*^9, 3.8217368775894413`*^9}, {3.821736982198763*^9, 
  3.821737002314137*^9}, {3.821738046844706*^9, 3.821738079872424*^9}, {
  3.821739545310391*^9, 3.821739572885942*^9}, {3.8217397838306627`*^9, 
  3.82173980134536*^9}},ExpressionUUID->"f2b5406e-918f-4166-ad3c-\
544c573f5cf9"],

