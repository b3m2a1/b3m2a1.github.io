c63c5b83f26d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"(", "\[VeryThinSpace]", 
     SubsuperscriptBox["\[Epsilon]", "2", 
      RowBox[{"(", "2", ")"}]], ")"}], 
    RowBox[{
     SubscriptBox["k", "1"], "\[InvisibleSpace]", 
     SubscriptBox["k", "2"]}]], "=", 
   RowBox[{
    SubsuperscriptBox["E", "n", 
     RowBox[{"(", "2", ")"}]], "-", 
    SubsuperscriptBox["E", "0", 
     RowBox[{"(", "2", ")"}]], "-", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       RowBox[{"k", "=", 
        SubscriptBox["k", "1"]}], ",", 
       SubscriptBox["k", "2"]}]], 
     SubscriptBox[
      RowBox[{"(", "\[VeryThinSpace]", 
       SubsuperscriptBox["\[Epsilon]", "2", 
        RowBox[{"(", "2", ")"}]], ")"}], 
      RowBox[{"k", "\[InvisibleSpace]", "k", "\[InvisibleSpace]"}]]}], "+", 
    SubscriptBox[
     RowBox[{"(", "\[VeryThinSpace]", 
      SubsuperscriptBox["\[Epsilon]", "1", 
       RowBox[{"(", "2", ")"}]], ")"}], "k"]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.814543482501213*^9, 3.814543565811545*^9}, {
  3.814543640646883*^9, 3.814543692986919*^9}, {3.814543731209138*^9, 
  3.814543738847742*^9}, {3.814543786856454*^9, 
  3.814543866955598*^9}},ExpressionUUID->"ccb4e498-0830-484a-99c0-\
cc7ce78d3dc1"],

Cell[TextData[{
 "which gives us a direct way to solve for ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Epsilon]", "2", 
    RowBox[{"(", "2", ")"}]], TraditionalForm]],ExpressionUUID->
  "07e433b8-118e-4d71-a1e4-d3c90c63a5b5"],
 ". Using that info, we can then solve for ",
 Cell[BoxData[
