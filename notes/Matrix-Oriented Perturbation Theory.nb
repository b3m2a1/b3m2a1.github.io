Cell["\<\
where with the appropriate transpositions (not worked out here) we can write\
\>", "ExpositoryText",
 CellChangeTimes->{{3.9197699078396587`*^9, 
  3.919769927730897*^9}},ExpressionUUID->"73c69405-abd7-400e-b011-\
33b74679ab2f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", "Q"], 
    SubscriptBox["G", "Q"]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", "t"], " ", 
     SuperscriptBox[
      RowBox[{"[", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", "Q"], "R"}], 
        RowBox[{"\[LeftAngleBracket]", 
         RowBox[{"2", ",", "1"}], "\[RightAngleBracket]"}], 
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["R", "2"]], "\[InvisibleSpace]", "Q"}], 
        RowBox[{"\[LeftAngleBracket]", 
         RowBox[{"2", ",", "2"}], "\[RightAngleBracket]"}], 
        RowBox[{
         SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", "Q"}], 
        RowBox[{"\[LeftAngleBracket]", 
         RowBox[{"1", ",", "1"}], "\[RightAngleBracket]"}], 
        SubscriptBox["G", "R"]}], "]"}], 
      RowBox[{"[", "t", "]"}]]}], " ", "+", " ", 
    RowBox[{
     UnderscriptBox["\[Sum]", "s"], " ", 
     SuperscriptBox[
      RowBox[{"[", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", "Q"}], 
        RowBox[{"\[LeftAngleBracket]", 
         RowBox[{"1", ",", "3"}], "\[RightAngleBracket]"}], 
        RowBox[{
         SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", "Q"}], 
        RowBox[{"\[LeftAngleBracket]", 
         RowBox[{"1", ",", "2"}], "\[RightAngleBracket]"}], 
        RowBox[{
         SubscriptBox["\[Del]", "Q"], 
         SubscriptBox["G", "R"]}]}], "]"}], 
      RowBox[{"[", "s", "]"}]]}]}]}], 
