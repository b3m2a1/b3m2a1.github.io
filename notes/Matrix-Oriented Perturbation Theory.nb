Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["H", 
       RowBox[{"(", "0", ")"}]], "+", 
      RowBox[{"\[Lambda]", "\[VeryThinSpace]", 
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]]}], "+", 
      RowBox[{
       SuperscriptBox["\[Lambda]", "2"], 
       SuperscriptBox["H", 
        RowBox[{"(", "2", ")"}]]}], "+", "\[Ellipsis]"}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       TemplateBox[{"n"},
        "Ket"], 
       RowBox[{"(", "0", ")"}]], "+", 
      RowBox[{"\[Lambda]", 
       SuperscriptBox[
        TemplateBox[{"n"},
         "Ket"], 
        RowBox[{"(", "1", ")"}]]}], "+", 
      RowBox[{
       SuperscriptBox["\[Lambda]", "2"], 
       SuperscriptBox[
        TemplateBox[{"n"},
         "Ket"], 
        RowBox[{"(", "2", ")"}]]}], "+", "\[Ellipsis]"}], ")"}]}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["E", "n", 
       RowBox[{"(", "0", ")"}]], "+", 
      RowBox[{"\[Lambda]", "\[VeryThinSpace]", 
       SubsuperscriptBox["E", "n", 
        RowBox[{"(", "1", ")"}]]}], "+", 
      RowBox[{
       SuperscriptBox["\[Lambda]", "2"], 
       SubsuperscriptBox["E", "n", 
        RowBox[{"(", "2", ")"}]]}], "+", "\[Ellipsis]"}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       TemplateBox[{"n"},
        "Ket"], 
       RowBox[{"(", "0", ")"}]], "+", 
      RowBox[{"\[Lambda]", 
       SuperscriptBox[
        TemplateBox[{"n"},
         "Ket"], 
        RowBox[{"(", "1", ")"}]]}], "+", 
      RowBox[{
       SuperscriptBox["\[Lambda]", "2"], 
       SuperscriptBox[
        TemplateBox[{"n"},
         "Ket"], 
        RowBox[{"(", "2", ")"}]]}], "+", "\[Ellipsis]"}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.806412007742568*^9, 3.806412038139682*^9}, {
  3.806412135830674*^9, 3.806412153266377*^9}, {3.806412457985156*^9, 
