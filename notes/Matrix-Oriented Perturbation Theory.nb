  "737c8f9b-7669-4544-b5f2-a13c520b3127"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["E", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],ExpressionUUID->
  "a9727c33-7702-4c8c-8dbe-7d2a36869823"],
 " we obtain are to the \[OpenCurlyDoubleQuote]proper\[CloseCurlyDoubleQuote] \
solution since in that case"
}], "ExpositoryText",
