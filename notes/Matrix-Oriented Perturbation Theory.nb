       "]"}], ",", " ", "\[IndentingNewLine]", 
      RowBox[{"figStyleText", "@", "\"\<=\>\""}], ",", "\[IndentingNewLine]", 
      
      RowBox[{"pertPlot", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Phi]", "[", "$ptData", "]"}], "[", "0", "]"}], "}"}], 
       "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"pertPlot", "[", 
       RowBox[{
        RowBox[{"\[CapitalEta]", "[", "$ptData", "]"}], "[", "2", "]"}], 
       "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"pertPlot", "[", 
       RowBox[{"Transpose", "@", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Phi]", "[", "$ptData", "]"}], "[", "0", "]"}], "}"}]}], 
       "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"figStyleText", "@", "\"\<+\>\""}]}], "\[IndentingNewLine]", 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<\>\"", ",", " ", "\"\<\>\"", ",", " ", "\[IndentingNewLine]", 
      RowBox[{"pertPlot", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Phi]", "[", "$ptData", "]"}], "[", "0", "]"}], "}"}], 
       "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"pertPlot", "[", 
       RowBox[{
        RowBox[{"dH", "[", "$ptData", "]"}], "[", "1", "]"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"pertPlot", "[", 
       RowBox[{"Transpose", "@", 
        RowBox[{"{", 
