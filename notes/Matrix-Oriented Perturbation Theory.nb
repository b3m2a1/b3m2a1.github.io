       RowBox[{"A", "(", 
        SubscriptBox["B", "x"], ")"}], 
       RowBox[{"2", ":", "1"}]], ")"}], 
     RowBox[{"a", ":", "1"}]]}]}], TraditionalForm]], "ExpositoryMathCentered",\

