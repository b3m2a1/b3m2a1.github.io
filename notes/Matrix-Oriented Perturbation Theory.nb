             RowBox[{
              RowBox[{"Range", "[", 
               RowBox[{
                RowBox[{"-", "#"}], ",", " ", "#", ",", " ", "2"}], "]"}], 
              "&"}], "/@", "blockSizes"}], "]"}]}], "}"}]}], 
        "\[IndentingNewLine]", "]"}], "//", "Expand"}], "//", 
      RowBox[{"If", "[", 
       RowBox[{"aggregate", ",", " ", "Total", ",", " ", "Identity"}], 
       "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
