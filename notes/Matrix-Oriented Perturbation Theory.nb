Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["Q", "2"]], "G"}], " ", "=", "\[AlignmentMarker] ", 
      RowBox[{
       SubsuperscriptBox["Q", 
        RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "x"}], 
        "2"], "(", 
       RowBox[{
        SubscriptBox[
         RowBox[{"[", 
          RowBox[{
           SubsuperscriptBox["R", 
            RowBox[{
            "x", "\[InvisibleSpace]\[InvisibleSpace]", "k", 
             "\[InvisibleSpace]", "l"}], "2"], 
           SubscriptBox["\[Omega]", "k"]}], "]"}], 
         RowBox[{
          RowBox[{"x", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "l"}], 
          "+", 
          RowBox[{
          "x", "\[InvisibleSpace]", "l", "\[InvisibleSpace]", "k"}]}]], "+", 
        SubsuperscriptBox["G", 
         RowBox[{"x", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "l"}], 
         "1"]}], ")"}]}]},
    {
     RowBox[{"\[AlignmentMarker]  ", 
      RowBox[{
       RowBox[{"+", " ", 
        SubscriptBox[
         RowBox[{"[", 
          RowBox[{
           SubsuperscriptBox["R", 
            RowBox[{
            "i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k", 
             "\[InvisibleSpace]", "l", "\[InvisibleSpace]"}], "3"], 
           SubscriptBox["\[Omega]", "k"]}], "]"}], 
         RowBox[{
          RowBox[{
          "i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k", 
           "\[InvisibleSpace]", "l"}], "+", 
          RowBox[{
          "i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "l", 
           "\[InvisibleSpace]", "k"}]}]]}], "+", 
       SubscriptBox[
        RowBox[{"[", 
         RowBox[{
          SubsuperscriptBox["R", 
           RowBox[{"i", "\[InvisibleSpace]", "a", "\[InvisibleSpace]", "j"}], 
           "2"], 
          SubsuperscriptBox["R", 
           RowBox[{"k", "\[InvisibleSpace]", "a", "\[InvisibleSpace]", "l"}], 
           "2"], 
          SubscriptBox["\[Omega]", "a"]}], "]"}], 
        RowBox[{
         RowBox[{
         "i", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "j", 
          "\[InvisibleSpace]", "l"}], "+", 
         RowBox[{
         "i", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "l", 
          "\[InvisibleSpace]", "j"}]}]]}]}]},
    {
     RowBox[{"\[AlignmentMarker]  ", 
      RowBox[{"+", " ", 
       SubscriptBox[
        RowBox[{"[", 
         RowBox[{
          SubsuperscriptBox["R", 
           RowBox[{"i", "\[InvisibleSpace]", "a", "\[InvisibleSpace]", "j"}], 
           "2"], 
          SubsuperscriptBox["G", 
           RowBox[{"k", "\[InvisibleSpace]", "a", "\[InvisibleSpace]", "l"}], 
           "1"]}], "]"}], 
        RowBox[{
         RowBox[{
         "i", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "j", 
          "\[InvisibleSpace]", "l"}], "+", 
         RowBox[{
         "i", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "l", 
          "\[InvisibleSpace]", "j"}], "+", 
         RowBox[{
         "k", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "j", 
          "\[InvisibleSpace]", "l"}], "+", 
         RowBox[{
         "k", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "l", 
          "\[InvisibleSpace]", "j"}]}]]}]}]},
    {
     RowBox[{"\[AlignmentMarker]  ", 
      RowBox[{"+", " ", 
       SubsuperscriptBox["G", 
        RowBox[{
        "i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k", 
         "\[InvisibleSpace]", "l"}], "2"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCenteredManuallyAligned",
 CellChangeTimes->{{3.921162570453623*^9, 3.921162707775559*^9}, {
   3.921162974286311*^9, 3.9211630475300713`*^9}, {3.9211630842930393`*^9, 
