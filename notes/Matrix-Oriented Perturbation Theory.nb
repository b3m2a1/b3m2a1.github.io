cb1dbe27968d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["R", 
      RowBox[{"(", 
       RowBox[{"i", "+", "2"}], ")"}]]], 
    SubscriptBox["V", "R"]}], " ", "=", " ", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{"p", "\[Element]", 
      RowBox[{"\[ScriptCapitalP]", "(", 
       RowBox[{"i", "+", "2"}], ")"}]}]], " ", 
    RowBox[{
     SubscriptBox["w", "p"], " ", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{"t", "\[Element]", 
        RowBox[{"\[CapitalPi]", "(", "p", ")"}]}]], " ", 
      SuperscriptBox[
       RowBox[{"[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            SubscriptBox["\[Del]", 
             SuperscriptBox["R", 
              SubscriptBox["p", "1"]]], "Q"}], 
           RowBox[{"\[LeftAngleBracket]", 
            RowBox[{
             SubscriptBox["p", "1"], ",", " ", "n"}], 
            "\[RightAngleBracket]"}]}], "..."}], 
         RowBox[{
          SubscriptBox["\[Del]", 
           SuperscriptBox["R", 
            SubscriptBox["p", "l"]]], "Q"}], 
         RowBox[{"\[LeftAngleBracket]", 
          RowBox[{
           SubscriptBox["p", "l"], ",", " ", "1"}], "\[RightAngleBracket]"}], 
         
         RowBox[{
          SubscriptBox["\[Del]", 
           SuperscriptBox["Q", "l"]], "V"}]}], "]"}], 
       RowBox[{"(", "t", ")"}]]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.919769045868779*^9, 3.919769093068997*^9}, {
  3.9197693522830467`*^9, 
  3.919769377622594*^9}},ExpressionUUID->"125133d1-f96d-461b-b8ed-\
fa5fd05ed7a5"],

Cell[TextData[{
 "but of course for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"l", "\[NotEqual]", "2"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "3b8ce62a-8b41-4f98-9c98-187de00f80df"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", 
      SuperscriptBox["Q", "l"]], "V"}], " ", "=", " ", 
    "\[DoubleStruckZero]"}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "b09cc0c1-db9e-4ac4-95a6-3a2ed29bd08f"]
}], "ExpositoryText",
