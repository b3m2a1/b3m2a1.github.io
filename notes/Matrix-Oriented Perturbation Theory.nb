413c89703835"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["Q", "1"], "(", 
    RowBox[{
     RowBox[{"n", ";", "a"}], ",", "b"}], ")"}], " ", "=", " ", 
   RowBox[{
    FormBox[
     RowBox[{
      RowBox[{
       SubsuperscriptBox["P", "b", "a"], "(", "n", ")"}], " ", "-", " ", 
      RowBox[{"2", 
       RowBox[{
        SubsuperscriptBox["P", "b", 
         RowBox[{"a", "-", "1"}]], "(", "n", ")"}]}]}],
     TraditionalForm], " ", "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"\[Omega]", "=", "0"}], "b"], 
     RowBox[{
      FractionBox[
       RowBox[{"\[Omega]", "!"}], 
       SuperscriptBox["2", "\[Omega]"]], 
      SubscriptBox[
       RowBox[{"(", "n", ")"}], 
       RowBox[{"b", "-", "\[Omega]"}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", GridBox[{
            {
             RowBox[{"a", "+", "b"}]},
            {"b"}
           },
           GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
         RowBox[{"(", GridBox[{
            {"b"},
            {"\[Omega]"}
           },
           GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
         RowBox[{"(", GridBox[{
            {"a"},
            {"\[Omega]"}
           },
           GridBoxAlignment->{"Columns" -> {Center}}], ")"}]}], " ", "-", " ", 
        RowBox[{"2", 
