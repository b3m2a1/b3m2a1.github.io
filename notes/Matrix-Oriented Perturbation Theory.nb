          RowBox[{"(", 
           RowBox[{"k", "-", "i"}], ")"}]], ")"}], " ", "\[Backslash]", " ", 
        RowBox[{"{", " ", "e", " ", "}"}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{"(", " ", 
