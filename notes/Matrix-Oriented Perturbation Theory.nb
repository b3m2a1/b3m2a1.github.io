    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"M", "=", "1"}], "k"], " ", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{
        StyleBox["p",
         FontSize->14], "\[Element]", 
