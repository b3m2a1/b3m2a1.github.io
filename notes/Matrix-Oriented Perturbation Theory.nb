         RowBox[{"(", "2", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}], "=", 
      RowBox[{
       RowBox[{
        SuperscriptBox["E", 
         RowBox[{"(", "0", ")"}]], "\[VeryThinSpace]", 
        SubscriptBox["P", "D"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "2", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        SuperscriptBox["E", 
         RowBox[{"(", "2", ")"}]], "\[VeryThinSpace]", 
        SubscriptBox["P", "D"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}]}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["P", "D"], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["P", "U"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "1", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        SubscriptBox["P", "D"], 
        SuperscriptBox["H", 
         RowBox[{"(", "2", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}], "=", 
      RowBox[{
       SuperscriptBox["E", 
        RowBox[{"(", "2", ")"}]], "\[VeryThinSpace]", 
       SubscriptBox["P", "D"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821358598194263*^9, 
  3.821358683545146*^9}},ExpressionUUID->"5c730e7a-3882-470c-9a9a-\
fcc384a08801"],

Cell[TextData[{
 "which is ",
 StyleBox["almost",
  FontSlant->"Italic"],
 " what we had before, but now we need an explicit form for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "U"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "1", ")"}]]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "74650398-afb0-4b54-b0b4-9c04e318cf85"],
 " to substitute and so we go to the set of equations from the non-degenerate \
subspace and apply our relationships"
}], "ExpositoryText",
 CellChangeTimes->{{3.821358684899015*^9, 3.821358736126001*^9}, {
  3.821358785599388*^9, 3.821358800881863*^9}, {3.821358908392118*^9, 
  3.82135891666427*^9}},ExpressionUUID->"e2240744-6988-4a1c-a03f-\
f853ed4f16b5"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["P", "U"], 
        SuperscriptBox["H", 
         RowBox[{"(", "0", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "1", ")"}]]},
         "Ket"]}], " ", "+", 
       RowBox[{
        SubscriptBox["P", "U"], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}], "=", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         SubscriptBox["E", "n"], 
         RowBox[{"(", "0", ")"}]], 
        SubscriptBox["P", "U"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "1", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["E", "n"], 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["P", "U"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}]}]},
    {
     RowBox[{
      SuperscriptBox[
       SubscriptBox["E", "n"], 
       RowBox[{"(", "1", ")"}]], "=", "0"}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["P", "U"], 
        SuperscriptBox["H", 
         RowBox[{"(", "0", ")"}]], 
        SubscriptBox["P", "D"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "1", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        SubscriptBox["P", "U"], 
        SuperscriptBox["H", 
         RowBox[{"(", "0", ")"}]], 
        SubscriptBox["P", "U"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "1", ")"}]]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        SubscriptBox["P", "U"], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}], " ", "=", 
      RowBox[{
       SuperscriptBox[
        SubscriptBox["E", "n"], 
        RowBox[{"(", "0", ")"}]], 
       SubscriptBox["P", "U"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "1", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", "0", ")"}]], 
       SubscriptBox["P", "D"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "1", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       SuperscriptBox[
        SubscriptBox["E", "n"], 
        RowBox[{"(", "0", ")"}]], 
       SubscriptBox["P", "D"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "1", ")"}]]},
        "Ket"], "   ", 
       StyleBox[
        RowBox[{"(", " ", 
         RowBox[{
          RowBox[{"bc", " ", 
           RowBox[{
            UnderscriptBox["\[ForAll]", "d\[Epsilon]D"], 
            RowBox[{
             TemplateBox[{
               SuperscriptBox["d", 
                RowBox[{"(", "0", ")"}]]},
              "Bra"], 
             SuperscriptBox["H", 
              RowBox[{"(", "0", ")"}]], 
             TemplateBox[{
               SuperscriptBox["d", 
                RowBox[{"(", "0", ")"}]]},
              "Ket"]}]}]}], "=", 
          SuperscriptBox["E", 
           RowBox[{"(", "0", ")"}]]}], ")"}],
        FontColor->GrayLevel[0.5]]}]}]},
    {
     RowBox[{
      RowBox[{
       SuperscriptBox[
        SubscriptBox["E", "n"], 
        RowBox[{"(", "0", ")"}]], 
       SubscriptBox["P", "U"], 
       SubscriptBox["P", "D"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "1", ")"}]]},
        "Ket"]}], "=", "\[DoubleStruckZero]"}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["P", "U"], 
        SuperscriptBox["H", 
         RowBox[{"(", "0", ")"}]], 
        SubscriptBox["P", "U"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "1", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        SubscriptBox["P", "U"], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}], "=", 
      RowBox[{
       SuperscriptBox[
        SubscriptBox["E", "n"], 
        RowBox[{"(", "0", ")"}]], 
       SubscriptBox["P", "U"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "1", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["P", "U"], "(", 
        RowBox[{
         SuperscriptBox["H", 
          RowBox[{"(", "0", ")"}]], "-", 
         SuperscriptBox[
          SubscriptBox["E", "n"], 
          RowBox[{"(", "0", ")"}]]}], ")"}], 
       SubscriptBox["P", "U"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "1", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       RowBox[{"-", 
        SubscriptBox["P", "U"]}], 
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{"-", 
        SubscriptBox["P", "U"]}], 
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821358720119993*^9, 3.821358720124404*^9}, {
   3.821358801881914*^9, 3.821358883491147*^9}, {3.8213589181348886`*^9, 
