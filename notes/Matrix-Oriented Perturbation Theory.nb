Cell[CellGroupData[{

Cell[TextData[{
 "Showing That Projecting with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "U"], TraditionalForm]],ExpressionUUID->
  "d5c8cbd4-1fca-4cb8-8c7c-e5822d85ad8c"],
 " Gives Clean Non-Deg PT"
}], "Subsubsubsubsection",
 CellChangeTimes->{{3.8212074569855633`*^9, 
  3.821207473144915*^9}},ExpressionUUID->"78755eec-e3e0-4e4b-87d4-\
76ac1176cda9"],

Cell[TextData[{
 "We will look towards an iterative solution by focusing on the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["k", "th"], TraditionalForm]],ExpressionUUID->
  "42d1998b-2bdd-4beb-a36f-3babd3d1bab2"],
 " order corrections. I.e. at every order ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "0a6d6557-bb0d-4f90-a873-04f46a628c9f"],
 " we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.821202041672821*^9, 3.8212020570521717`*^9}, {
  3.821206529904763*^9, 3.8212065345953827`*^9}, {3.8212066629725647`*^9, 
  3.821206699930073*^9}},ExpressionUUID->"d6433646-bd35-43fb-8f02-\
9acb4b3538e2"],

Cell[BoxData[
 FormBox[
  RowBox[{"0", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", "0", ")"}]], "-", 
       SuperscriptBox[
        SubscriptBox["E", "n"], 
        RowBox[{"(", "0", ")"}]]}], ")"}], 
     SubscriptBox["P", "U"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "k", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", "0", ")"}]], "-", 
       SuperscriptBox[
        SubscriptBox["E", "n"], 
        RowBox[{"(", "0", ")"}]]}], ")"}], 
     SubscriptBox["P", "D"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "k", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], 
      RowBox[{"k", "-", "1"}]], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["H", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], "-", 
        SuperscriptBox[
         SubscriptBox["E", "n"], 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]]}], ")"}], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821202059873084*^9, 
  3.8212021100827436`*^9}},ExpressionUUID->"a54303c6-73bf-4ed8-9580-\
9f8345d2def3"],

Cell[TextData[{
 "and then we can project by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "U"], TraditionalForm]],ExpressionUUID->
  "6df45624-4d9f-44c6-b17e-c7e1a1df4de9"],
