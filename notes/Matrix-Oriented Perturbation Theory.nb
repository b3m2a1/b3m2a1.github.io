   3.813537614234445*^9},ExpressionUUID->"3e269115-48ae-4cae-8671-\
14cbd63b3ed0"],

Cell["and that gives us a key simplification, in ", "ExpositoryText",
 CellChangeTimes->{{3.813537616784163*^9, 
  3.813537650959022*^9}},ExpressionUUID->"cd5447de-eedc-4b7b-a215-\
b20c9cdf9de9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], "A", "\[VeryThinSpace]", "\[CapitalPi]", "\[InvisibleSpace]\[VeryThinSpace]",
     "B", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      SubscriptBox["d", "1"], "=", 
      SubsuperscriptBox["\[CapitalDelta]", "1", "B"]}], 
     SubsuperscriptBox["\[CapitalDelta]", "1", "B"]], 
    RowBox[{"\[Ellipsis]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{
        SubscriptBox["d", "m"], "=", 
        SubsuperscriptBox["\[CapitalDelta]", "m", "B"]}], 
       SubsuperscriptBox["\[CapitalDelta]", "m", "B"]], "\[VeryThinSpace]", 
      RowBox[{
       RowBox[{"\[Pi]", "(", 
        StyleBox["d",
         FontWeight->"Bold"], ")"}], 
       RowBox[{
        UnderscriptBox["\[Product]", "i"], 
        RowBox[{
         RowBox[{
          SubscriptBox["\[Chi]", "A"], "(", 
          RowBox[{
           RowBox[{
            SubscriptBox["n", "i"], "+", 
            SubscriptBox["d", "i"]}], ",", " ", 
           RowBox[{"-", 
            SubscriptBox["d", "i"]}], ",", " ", 
           SubsuperscriptBox["\[CapitalDelta]", "i", "A"]}], ")"}], 
         RowBox[{
          SubscriptBox["\[Chi]", "B"], "(", 
          RowBox[{
           SubscriptBox["n", "i"], ",", " ", 
           SubscriptBox["d", "i"], ",", " ", 
           SubsuperscriptBox["\[CapitalDelta]", "i", "B"]}], 
          ")"}]}]}]}]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.813537652139347*^9, 
  3.813537661800106*^9}},ExpressionUUID->"bccca89b-ec59-44f9-803e-\
0bcb748bd6d6"],

Cell[TextData[{
 "we only get non-zero terms if ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalDelta]", "A"], TraditionalForm]],ExpressionUUID->
  "3955a109-8c6c-4ee4-abb1-c78370cbe679"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalDelta]", "B"], TraditionalForm]],ExpressionUUID->
  "42b9a68a-1f26-427d-bc46-076bb4cea52d"],
 " are able to act on at least one of the same modes. Furthermore, since we\
\[CloseCurlyQuote]re working with raising/lowering terms, we also know that \
for every shared mode, ",
 StyleBox["i",
  FontSlant->"Italic"],
 ",  ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalDelta]", "i", "A"], TraditionalForm]],
  ExpressionUUID->"26aba865-a85a-4bac-bc28-98deba9f7054"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalDelta]", "i", "B"], TraditionalForm]],
  ExpressionUUID->"610fcf9c-31ea-46c9-83f9-5ebcc3cf0ac0"],
 " must both be even or odd and for every ",
 StyleBox["unshared",
  FontSlant->"Italic"],
 " mode, ",
 StyleBox["j",
  FontSlant->"Italic"],
 ", the ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalDelta]", "j", "B"], TraditionalForm]],
  ExpressionUUID->"aea77249-1e1e-4d71-b6b1-f07ad1447efd"],
 " or ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalDelta]", "j", "A"], TraditionalForm]],
  ExpressionUUID->"c32956ca-9ac2-420f-9047-ad525f6bbe6c"],
 " must be even. This gives us pruning rules for terms coming from stuff \
like"
}], "ExpositoryText",
 CellChangeTimes->{{3.813537677358726*^9, 3.8135377723671637`*^9}, {
  3.813538814738494*^9, 3.81353881702421*^9}, {3.81353886147069*^9, 
  3.813538888747428*^9}, {3.813538924314831*^9, 
  3.813539039128791*^9}},ExpressionUUID->"5acb2fcb-aec6-4c18-bef1-\
bed9dde36dac"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Bra"], " ", 
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], 
   SubscriptBox["\[CapitalPi]", "n"], 
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], 
   SubscriptBox["\[CapitalPi]", "n"], 
   SuperscriptBox["H", 
    RowBox[{"(", "2", ")"}]], 
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.813537722090158*^9, 3.813537722094501*^9}, {
  3.8135409563771267`*^9, 3.813540975719706*^9}, {3.813541025876054*^9, 
  3.813541026073797*^9}, {3.813541223344615*^9, 
  3.813541306785509*^9}},ExpressionUUID->"658fd48b-7107-4255-bf48-\
e3c8ef3b7e5e"],

Cell["\<\
which naively would have a very, very large number of possible elements. Just \
taking of of the combinations of terms represented in it, we have\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8135410277662573`*^9, 3.813541034702323*^9}, {
  3.8135410724689913`*^9, 3.813541094068681*^9}, {3.81354120780189*^9, 
  3.813541217260235*^9}, {3.813541310487832*^9, 
  3.813541326126656*^9}},ExpressionUUID->"fdb7ac90-6f18-46ef-b934-\
e4ea6074460f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Bra"], " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "Q"], "G"}], 
      SubscriptBox["\[CircleDot]", "3"], "p"}], "\[InvisibleSpace]", "Q", 
     "\[InvisibleSpace]", "p"}], "\[InvisibleSpace]", ")"}], 
   RowBox[{
    SubscriptBox["\[CapitalPi]", "n"], "(", 
    RowBox[{
     FractionBox["1", "6"], 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["Q", "3"]], "V"}], 
      SubscriptBox["\[CircleDot]", "3"], "Q"}], "\[InvisibleSpace]", "Q", 
     "\[InvisibleSpace]", "Q"}], ")"}], 
   RowBox[{
    SubscriptBox["\[CapitalPi]", "n"], "(", 
    RowBox[{
     FractionBox["1", "4"], 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["Q", "2"]], "G"}], 
      SubscriptBox["\[CircleDot]", "4"], "p"}], "\[InvisibleSpace]", "QQ", 
     "\[InvisibleSpace]", "p"}], "\[InvisibleSpace]", ")"}], 
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.813541327035627*^9, 3.813541358403185*^9}, {
  3.813541413425996*^9, 
  3.8135414390964537`*^9}},ExpressionUUID->"384ab2c9-c351-4ad1-a0cd-\
1795032f1fcd"],

Cell["\<\
and so we\[CloseCurlyQuote]d expect basically our numbers of terms to grow \
like a 10D tensor. But in reality, focussing for now on just the elements of\
\>", "ExpositoryText",
 CellChangeTimes->{{3.813541366496286*^9, 3.8135414172897167`*^9}, {
  3.813541539165265*^9, 3.81354153942625*^9}, {3.813542510112048*^9, 
  3.813542523595976*^9}},ExpressionUUID->"9d13f678-94d0-4552-922a-\
ab0981323d3e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Bra"], " ", "p", "\[InvisibleSpace]", "Q", "\[InvisibleSpace]", "p", 
   "\[InvisibleSpace]", 
   SubscriptBox["\[CapitalPi]", "n"], "Q", "\[InvisibleSpace]", "Q", 
   "\[InvisibleSpace]", "Q", "\[InvisibleSpace]", 
   SubscriptBox["\[CapitalPi]", "n"], "p", "\[InvisibleSpace]", "Q", 
   "\[InvisibleSpace]", "Q", "\[InvisibleSpace]", "p", "\[InvisibleSpace]", 
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.813541418237747*^9, 
  3.813541445584041*^9}},ExpressionUUID->"c38713f9-ccfb-457e-aede-\
8b3f3dbee231"],

Cell[TextData[{
 "we have a much smaller set of allowed bits. We know this because starting \
from the left, we note that ",
 StyleBox["pQp",
  FontSlant->"Italic"],
 " can change one mode by \[PlusMinus]3, \[PlusMinus]2, or \[PlusMinus]1, one \
mode by \[PlusMinus]2 and another mode by \[PlusMinus]1, or three modes by \
\[PlusMinus]1."
}], "ExpositoryText",
 CellChangeTimes->{{3.8135414608556557`*^9, 3.813541475225953*^9}, {
  3.813541517829844*^9, 3.8135415924496393`*^9}, {3.813541627644153*^9, 
  3.8135417079077806`*^9}, {3.813541747033215*^9, 3.813541784950317*^9}, {
  3.813541839184588*^9, 3.813541844655283*^9}, {3.813541888025758*^9, 
  3.813541905160924*^9}, {3.813542040497789*^9, 3.813542045761422*^9}, {
  3.813542496922903*^9, 3.813542545768147*^9}, {3.813542631821637*^9, 
  3.813542658637982*^9}},ExpressionUUID->"a69cfb97-1a13-41d6-860e-\
d4f5b4d70bb0"],

Cell["\<\
How do we know this? Well we can look at the choices of 3 indices and just \
keep the unique ones\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8135414608556557`*^9, 3.813541475225953*^9}, {
   3.813541517829844*^9, 3.8135415924496393`*^9}, {3.813541627644153*^9, 
   3.8135417079077806`*^9}, {3.813541747033215*^9, 3.813541784950317*^9}, {
   3.813541839184588*^9, 3.813541844655283*^9}, {3.813541888025758*^9, 
   3.8135419101072702`*^9}, 
   3.813542661055122*^9},ExpressionUUID->"f72a7df4-fe42-4886-8278-\
2d93d0fe120e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"popTerms", "[", "opDim_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Sort", "@", 
       RowBox[{
        RowBox[{"Tally", "[", "#", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{";;", ",", " ", "2"}], "]"}], "]"}]}], "&"}], "/@", 
     RowBox[{"Tuples", "[", 
      RowBox[{
       RowBox[{"Range", "[", "opDim", "]"}], ",", "opDim"}], "]"}]}], "//", 
    "DeleteDuplicates"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"pQpPerms", "=", 
  RowBox[{"popTerms", "[", "3", "]"}]}]}], "Input",
 CellChangeTimes->{{3.813541787949016*^9, 3.813541794944324*^9}, {
  3.813541846692182*^9, 3.813541871655204*^9}, {3.813541939263256*^9, 
  3.8135419476624537`*^9}, {3.813542077866456*^9, 3.813542079263893*^9}, {
  3.8135425544105873`*^9, 3.81354255999266*^9}, {3.8135871255809402`*^9, 
  3.813587170664565*^9}},
 CellLabel->
  "In[1564]:=",ExpressionUUID->"ec498884-0aca-4827-9137-b2f45dd05b05"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.8135417956525173`*^9, {3.813541849652223*^9, 3.813541872012294*^9}, 
   3.813541948106409*^9, 3.8135420796334333`*^9, {3.813542560391385*^9, 
   3.813542561594099*^9}, 3.813542662089705*^9, 3.8135871713149347`*^9},
 CellLabel->
  "Out[1565]=",ExpressionUUID->"7d436868-71d3-4a4c-9253-79222275aac7"]
}, Open  ]],

Cell["\<\
and then we can expand each of those in terms of their # quanta changes\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8135419176151743`*^9, 3.8135419343157387`*^9}, {
  3.8135870211194553`*^9, 
  3.8135870218235407`*^9}},ExpressionUUID->"8130712a-30b0-41ad-b113-\
f0ff52b292c7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"popChanges", "//", "Clear"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"popChanges", "[", "n_Integer", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"PlusMinus", "/@", 
    RowBox[{"Range", "[", 
     RowBox[{
      RowBox[{"Mod", "[", 
       RowBox[{"n", ",", " ", "2"}], "]"}], ",", " ", "n", ",", " ", "2"}], 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"popChanges", "~", "SetAttributes", "~", "Listable"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"popTups", "[", "changes_", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Tuples", "/@", "changes"}], "//", 
     RowBox[{"Apply", "[", "Join", "]"}]}], "//", 
    RowBox[{"DeleteCases", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"PlusMinus", "[", "0", "]"}], ".."}], "}"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"popTups", "@", 
  RowBox[{"popChanges", "@", "pQpPerms"}]}]}], "Input",
 CellChangeTimes->{{3.81354196710893*^9, 3.8135420212195597`*^9}, {
   3.8135423101730747`*^9, 3.813542397421132*^9}, 3.813542665409339*^9, {
   3.813587226046468*^9, 3.813587268302401*^9}},
 CellLabel->
  "In[1572]:=",ExpressionUUID->"a22a5085-246a-43ef-806b-1e017ab20d2b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[PlusMinus]", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[PlusMinus]", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[PlusMinus]", "1"}], ",", 
     RowBox[{"\[PlusMinus]", "0"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[PlusMinus]", "1"}], ",", 
     RowBox[{"\[PlusMinus]", "2"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[PlusMinus]", "1"}], ",", 
     RowBox[{"\[PlusMinus]", "1"}], ",", 
     RowBox[{"\[PlusMinus]", "1"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.813587268550282*^9},
 CellLabel->
  "Out[1576]=",ExpressionUUID->"eec9b78c-c2d5-40c6-97ec-039741b7c51e"]
}, Open  ]],

Cell[TextData[{
 "this tells us where we can be after applying ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "Q", "\[InvisibleSpace]", "Q", "\[InvisibleSpace]", "Q", 
    "\[InvisibleSpace]", 
    SubscriptBox["\[CapitalPi]", "n"], "p", "\[InvisibleSpace]", "Q", 
    "\[InvisibleSpace]", "Q", "\[InvisibleSpace]", "p"}], TraditionalForm]],
  ExpressionUUID->"a481e10f-11fd-4541-aaae-638c044cacd2"],
 ". So to work backwards, we\[CloseCurlyQuote]ll then see what ",
 StyleBox["QQQ",
  FontSlant->"Italic"],
 " can do (spoiler alert: it has the same effect as ",
 StyleBox["pQp",
  FontSlant->"Italic"],
 ")"
}], "ExpositoryText",
 CellChangeTimes->{{3.813542686766891*^9, 3.81354271703906*^9}, {
  3.813542750208334*^9, 3.813542751383692*^9}, {3.8135870313012953`*^9, 
  3.813587115173452*^9}, {3.813587177613714*^9, 3.8135872064947357`*^9}, {
  3.813587276281349*^9, 
  3.8135872989384327`*^9}},ExpressionUUID->"2912a8b1-d14a-4fd6-be17-\
916a06b6dda1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"popTups", "@", 
  RowBox[{"popChanges", "@", 
   RowBox[{"popTerms", "[", "3", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.813587195737433*^9, 3.813587211841628*^9}, 
   3.8135872727492857`*^9},
 CellLabel->
  "In[1578]:=",ExpressionUUID->"880c05b8-81e1-4251-b62e-5e90a6b59c66"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[PlusMinus]", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[PlusMinus]", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[PlusMinus]", "1"}], ",", 
     RowBox[{"\[PlusMinus]", "0"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[PlusMinus]", "1"}], ",", 
     RowBox[{"\[PlusMinus]", "2"}]}], "}"}], ",", 
   RowBox[{"{", 
