       SubscriptBox["E", "n"], 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"d", "\[Element]", "D"}]], 
        RowBox[{
         SubscriptBox["c", "d"], 
         TemplateBox[{
           SuperscriptBox["d", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821325390801449*^9, 
  3.8213254563864098`*^9}},ExpressionUUID->"cfbb6a74-ea07-4055-9dd3-\
aa394e40b49e"],

Cell["therefore", "ExpositoryText",
 CellChangeTimes->{{3.8213254632273693`*^9, 
  3.8213254668739*^9}},ExpressionUUID->"1e0bf254-0d3b-4b40-a277-4b42b78a3c62"],

