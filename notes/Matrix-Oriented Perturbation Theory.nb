Cell["where, calling the mass-weighted coordinates Y", "ExpositoryText",
 CellChangeTimes->{{3.81127425927341*^9, 3.811274259743825*^9}, {
  3.811274337783791*^9, 
  3.811274346539896*^9}},ExpressionUUID->"9e91e2bb-c343-47ce-9ab8-\
a7556b612159"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{"G", "=", 
      RowBox[{
       SubscriptBox["\[Del]", "Q"], 
       SuperscriptBox[
        RowBox[{"Y", "(", 
         RowBox[{
          SubscriptBox["\[Del]", "Q"], "Y"}], ")"}], "T"]}]}]},
    {
     RowBox[{"\[Gamma]", "=", 
      RowBox[{"ln", " ", 
       FractionBox[
        RowBox[{"\[VerticalSeparator]", 
         SubscriptBox["I", "0"], "\[VerticalSeparator]"}], 
        RowBox[{
         RowBox[{"\[VerticalSeparator]", "G"}], "\[RightBracketingBar]"}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811274260790126*^9, 3.811274336155546*^9}, {
   3.811274522684965*^9, 3.811274533404242*^9}, 
   3.811300436244401*^9},ExpressionUUID->"c23bcb0c-f362-40e2-bbc4-\
f3f1a3f0eb18"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["I", "0"], TraditionalForm]],
  CellChangeTimes->{{3.811274260790126*^9, 3.811274336155546*^9}, {
   3.811274522684965*^9, 3.811274533404242*^9}},ExpressionUUID->
  "ad07a3bf-c7b8-4987-a5dd-d5de842de2fc"],
 " is the moment of inertia tensor. This \[Gamma] term is the natural log of \
the determinant of the inverse vibration-rotation kinetic energy tensor. \
Ignoring the difficulty of getting the \[Gamma] derivatives for the moment \
(we\[CloseCurlyQuote]ll come back to it), we\[CloseCurlyQuote]ll note that we \
can partially factorize this as"
}], "ExpositoryText",
 CellChangeTimes->{{3.811274536491724*^9, 3.811274546429763*^9}, {
  3.8112746674091387`*^9, 3.8112747281603117`*^9}, {3.81127475914382*^9, 
  3.8112747807437963`*^9}, {3.811278611253044*^9, 3.811278619491931*^9}, {
  3.8112787353057528`*^9, 3.81127874834599*^9}, {3.811279635548896*^9, 
  3.811279648599062*^9}, {3.833110033034631*^9, 
  3.8331100893350067`*^9}},ExpressionUUID->"338edbf9-5c75-4b3c-b445-\
43bdfdf162f1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SubscriptBox["G", 
        RowBox[{"i", "\[VeryThinSpace]", "j"}]]}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["q", "i"]}]], 
     FractionBox[
      RowBox[{"\[PartialD]", "\[Gamma]"}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["q", "j"]}]]}], "+", 
    RowBox[{
     SubscriptBox["G", 
      RowBox[{"i", "\[InvisibleSpace]", "j"}]], "(", 
     RowBox[{
      FractionBox[
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], "\[Gamma]"}], 
       RowBox[{
        RowBox[{"\[PartialD]", 
         SubscriptBox["q", "i"]}], 
        SubscriptBox["q", "j"]}]], "+", 
      RowBox[{
       FractionBox["1", "4"], 
       FractionBox[
        RowBox[{"\[PartialD]", "\[Gamma]"}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["q", "i"]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", "\[Gamma]"}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["q", "j"]}]]}]}], ")"}]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["G", 
          RowBox[{"i", "\[VeryThinSpace]", "j"}]]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["q", "i"]}]], "+", 
       RowBox[{
        FractionBox["1", "4"], 
        SubscriptBox["G", 
         RowBox[{"i", "\[InvisibleSpace]", "j"}]], 
        FractionBox[
         RowBox[{"\[PartialD]", "\[Gamma]"}], 
         RowBox[{"\[PartialD]", 
          SubscriptBox["q", "i"]}]]}]}], ")"}], 
     FractionBox[
      RowBox[{"\[PartialD]", "\[Gamma]"}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["q", "j"]}]]}], "+", 
    RowBox[{
     SubscriptBox["G", 
      RowBox[{"i", "\[InvisibleSpace]", "j"}]], 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[PartialD]", "2"], "\[Gamma]"}], 
      RowBox[{
       RowBox[{"\[PartialD]", 
        SubscriptBox["q", "i"]}], 
       SubscriptBox["q", "j"]}]]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8112796669494333`*^9, 3.811279686498064*^9}, {
  3.811279726438429*^9, 
  3.8112797353061438`*^9}},ExpressionUUID->"55e6c245-c8bc-4a03-920a-\
9a349935d1ba"],

Cell["\<\
which is different from the product-rule type factorization that we could \
also try\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8112797414631233`*^9, 
  3.811279755363385*^9}},ExpressionUUID->"d6563d17-6b0b-47c7-8345-\
d32fda0e98a7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SubscriptBox["G", 
        RowBox[{"i", "\[VeryThinSpace]", "j"}]]}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["q", "i"]}]], 
     FractionBox[
      RowBox[{"\[PartialD]", "\[Gamma]"}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["q", "j"]}]]}], "+", 
    RowBox[{
     SubscriptBox["G", 
      RowBox[{"i", "\[InvisibleSpace]", "j"}]], "(", 
     RowBox[{
      FractionBox[
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], "\[Gamma]"}], 
       RowBox[{
        RowBox[{"\[PartialD]", 
         SubscriptBox["q", "i"]}], 
        SubscriptBox["q", "j"]}]], "+", 
      RowBox[{
       FractionBox["1", "4"], 
       FractionBox[
        RowBox[{"\[PartialD]", "\[Gamma]"}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["q", "i"]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", "\[Gamma]"}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["q", "j"]}]]}]}], ")"}]}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["\[PartialD]", 
      RowBox[{"\[PartialD]", 
       SubscriptBox["q", "i"]}]], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["G", 
        RowBox[{"i", "\[VeryThinSpace]", "j"}]], 
       FractionBox[
        RowBox[{"\[PartialD]", "\[Gamma]"}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["q", "j"]}]]}], ")"}]}], "=", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", 
        SubscriptBox["G", 
         RowBox[{"i", "\[VeryThinSpace]", "j"}]]}], 
       RowBox[{"\[PartialD]", 
        SubscriptBox["q", "i"]}]], 
      FractionBox[
       RowBox[{"\[PartialD]", "\[Gamma]"}], 
       RowBox[{"\[PartialD]", 
        SubscriptBox["q", "j"]}]]}], " ", "+", " ", 
     RowBox[{
      SubscriptBox["G", 
       RowBox[{"i", "\[InvisibleSpace]", "j"}]], 
      FractionBox["1", "4"], 
      FractionBox[
       RowBox[{"\[PartialD]", "\[Gamma]"}], 
       RowBox[{"\[PartialD]", 
        SubscriptBox["q", "i"]}]], 
      FractionBox[
       RowBox[{"\[PartialD]", "\[Gamma]"}], 
       RowBox[{"\[PartialD]", 
        SubscriptBox["q", "j"]}]]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811274766844207*^9, 3.811274810452776*^9}, {
  3.811274849215666*^9, 3.8112749067054987`*^9}, {3.811279767763597*^9, 
  3.8112797750778923`*^9}},ExpressionUUID->"dcfe7e47-5a31-4b8c-b0ec-\
644c5e9fa454"],

Cell[TextData[{
 "on the other hand, that first form is potentially more useful, though, \
because assuming we have the tensor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", "Q"], "G"}], TraditionalForm]],
  CellChangeTimes->{{3.811279852500148*^9, 3.811279860656047*^9}},
  ExpressionUUID->"71feb26a-01fa-4964-bada-41104c3e5b4d"],
 " (which we need for the perturbation theory anyway) we can write the total \
sum as"
}], "ExpositoryText",
 CellChangeTimes->{{3.811279812416758*^9, 
  3.8112798833013144`*^9}},ExpressionUUID->"4461c667-67a7-450b-ab05-\
0354da50aa9c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"i", "\[InvisibleSpace]", "j"}]], 
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", 
        SubscriptBox["G", 
         RowBox[{"i", "\[VeryThinSpace]", "j"}]]}], 
       RowBox[{"\[PartialD]", 
        SubscriptBox["q", "i"]}]], 
      FractionBox[
       RowBox[{"\[PartialD]", "\[Gamma]"}], 
       RowBox[{"\[PartialD]", 
        SubscriptBox["q", "j"]}]]}]}], "+", 
    RowBox[{
     SubscriptBox["G", 
      RowBox[{"i", "\[InvisibleSpace]", "j"}]], "(", 
     RowBox[{
      FractionBox[
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], "\[Gamma]"}], 
       RowBox[{
        RowBox[{"\[PartialD]", 
         SubscriptBox["q", "i"]}], 
        SubscriptBox["q", "j"]}]], "+", 
      RowBox[{
       FractionBox["1", "4"], 
       FractionBox[
        RowBox[{"\[PartialD]", "\[Gamma]"}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["q", "i"]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", "\[Gamma]"}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["q", "j"]}]]}]}], ")"}]}], "=", 
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", "i"], 
     RowBox[{
      SubscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[Del]", "Q"], "G"}], ")"}], 
       RowBox[{"i", "\[InvisibleSpace]", "i"}]], 
      RowBox[{
       SubscriptBox["\[Del]", "Q"], "\[Gamma]"}]}]}], "+", 
    RowBox[{"G", 
     SubscriptBox["\[CircleDot]", "2"], 
     RowBox[{
      SubscriptBox["\[Del]", 
       SuperscriptBox["Q", "2"]], "\[Gamma]"}]}], "+", 
    RowBox[{
     FractionBox["1", "4"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"G", 
        RowBox[{
         SubscriptBox["\[Del]", "Q"], "\[Gamma]"}]}], ")"}], 
      StyleBox["T",
       FontSlant->"Plain"]], 
     RowBox[{
      SubscriptBox["\[Del]", "Q"], "\[Gamma]"}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811279852500148*^9, 3.811279860656047*^9}, {
  3.81127993571027*^9, 3.81128003870501*^9}, {3.8112801494873037`*^9, 
  3.811280250178792*^9}},ExpressionUUID->"6da12665-4939-4825-aaca-\
98b2c9316650"],

Cell["and now all that\[CloseCurlyQuote]s left is figuring out how to \
evaluate ", "ExpositoryText",
 CellChangeTimes->{{3.811280262195115*^9, 
  3.8112802732966337`*^9}},ExpressionUUID->"182f5701-7389-48df-a6fb-\
ebc37e9595cb"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[Del]", "Q"], "\[Gamma]"}], ")"}], "i"], "=", 
      RowBox[{
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", 
          SubscriptBox["q", "i"]}]], "ln"}], " ", 
       FractionBox[
        RowBox[{"\[VerticalSeparator]", 
         SubscriptBox["I", "0"], "\[VerticalSeparator]"}], 
        RowBox[{
         RowBox[{"\[VerticalSeparator]", "G"}], 
         "\[RightBracketingBar]"}]]}]}]},
    {
     RowBox[{
      SubscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["Q", "2"]], "\[Gamma]"}], ")"}], 
       RowBox[{"i", "\[InvisibleSpace]", "j"}]], "=", 
      RowBox[{
       RowBox[{
        FractionBox[
         SuperscriptBox["\[PartialD]", "2"], 
         RowBox[{
          RowBox[{"\[PartialD]", 
           SubscriptBox["q", "i"]}], 
          RowBox[{"\[PartialD]", 
           SubscriptBox["q", "j"]}]}]], "ln"}], " ", 
       FractionBox[
        RowBox[{"\[VerticalSeparator]", 
         SubscriptBox["I", "0"], "\[VerticalSeparator]"}], 
        RowBox[{
         RowBox[{"\[VerticalSeparator]", "G"}], "\[RightBracketingBar]"}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811280277367071*^9, 3.811280306494336*^9}, {
  3.811283920828973*^9, 3.811283945616756*^9}, {3.811300431132637*^9, 
  3.811300432166253*^9}},ExpressionUUID->"5c8d24bb-f6f3-4834-a204-\
b8e4907e7b3a"],

Cell["and now the Jacobi formula will be super useful.", "ExpositoryText",
 CellChangeTimes->{{3.81128030947892*^9, 3.8112803255944223`*^9}, 
   3.811283914106206*^9},ExpressionUUID->"1886b474-1159-4c43-a03d-\
e830d9018f91"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", 
          SubscriptBox["q", "i"]}]], "ln"}], " ", 
       FractionBox[
        RowBox[{"\[VerticalSeparator]", 
         SubscriptBox["I", "0"], "\[VerticalSeparator]"}], 
        RowBox[{
         RowBox[{"\[VerticalSeparator]", "G"}], "\[RightBracketingBar]"}]]}], 
      "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
           SubscriptBox["q", "i"]}]], "ln"}], " ", 
        RowBox[{"\[LeftBracketingBar]", 
         SubscriptBox["I", "0"], "\[RightBracketingBar]"}]}], "-", 
       RowBox[{
        RowBox[{
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
           SubscriptBox["q", "i"]}]], "ln"}], 
        RowBox[{
        "\[LeftBracketingBar]", "G", "\[RightBracketingBar]"}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        FractionBox["1", 
         RowBox[{"\[LeftBracketingBar]", 
          SubscriptBox["I", "0"], "\[RightBracketingBar]"}]], 
        RowBox[{
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
           SubscriptBox["q", "i"]}]], 
         RowBox[{"\[LeftBracketingBar]", 
          SubscriptBox["I", "0"], "\[RightBracketingBar]"}]}]}], " ", "-", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"\[LeftBracketingBar]", "G", "\[RightBracketingBar]"}]], 
        RowBox[{
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
           SubscriptBox["q", "i"]}]], 
         RowBox[{
         "\[LeftBracketingBar]", "G", "\[RightBracketingBar]"}]}]}]}]}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox[
         SuperscriptBox["\[PartialD]", "2"], 
         RowBox[{
          RowBox[{"\[PartialD]", 
           SubscriptBox["q", "j"]}], 
          RowBox[{"\[PartialD]", 
           SubscriptBox["q", "i"]}]}]], "ln"}], " ", 
       FractionBox[
        RowBox[{"\[VerticalSeparator]", 
         SubscriptBox["I", "0"], "\[VerticalSeparator]"}], 
        RowBox[{
         RowBox[{"\[VerticalSeparator]", "G"}], "\[RightBracketingBar]"}]]}], 
      "=", 
      RowBox[{
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", 
         SubscriptBox["q", "j"]}]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          FractionBox["1", 
           RowBox[{"\[LeftBracketingBar]", 
            SubscriptBox["I", "0"], "\[RightBracketingBar]"}]], 
          RowBox[{
           FractionBox["\[PartialD]", 
            RowBox[{"\[PartialD]", 
             SubscriptBox["q", "i"]}]], 
           RowBox[{"\[LeftBracketingBar]", 
            SubscriptBox["I", "0"], "\[RightBracketingBar]"}]}]}], " ", "-", 
         RowBox[{
          FractionBox["1", 
           RowBox[{"\[LeftBracketingBar]", "G", "\[RightBracketingBar]"}]], 
          RowBox[{
           FractionBox["\[PartialD]", 
            RowBox[{"\[PartialD]", 
             SubscriptBox["q", "i"]}]], 
           RowBox[{
           "\[LeftBracketingBar]", "G", "\[RightBracketingBar]"}]}]}]}], 
        ")"}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"\[LeftBracketingBar]", 
            SubscriptBox["I", "0"], "\[RightBracketingBar]"}], "2"]]}], 
        FractionBox[
         RowBox[{"\[PartialD]", 
          RowBox[{"\[LeftBracketingBar]", 
           SubscriptBox["I", "0"], "\[RightBracketingBar]"}]}], 
         RowBox[{"\[PartialD]", 
          SubscriptBox["q", "i"]}]], 
        FractionBox[
         RowBox[{"\[PartialD]", 
          RowBox[{"\[LeftBracketingBar]", 
           SubscriptBox["I", "0"], "\[RightBracketingBar]"}]}], 
         RowBox[{"\[PartialD]", 
          SubscriptBox["q", "j"]}]]}], "+", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"\[LeftBracketingBar]", 
          SubscriptBox["I", "0"], "\[RightBracketingBar]"}]], 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[PartialD]", "2"], 
          RowBox[{"\[LeftBracketingBar]", 
           SubscriptBox["I", "0"], "\[RightBracketingBar]"}]}], 
         RowBox[{
          RowBox[{"\[PartialD]", 
           SubscriptBox["q", "j"]}], 
          RowBox[{"\[PartialD]", 
           SubscriptBox["q", "i"]}]}]]}], "-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", 
            SuperscriptBox[
             RowBox[{"\[LeftBracketingBar]", "G", "\[RightBracketingBar]"}], 
             "2"]]}], 
          FractionBox[
           RowBox[{"\[PartialD]", 
            RowBox[{"\[LeftBracketingBar]", "G", "\[RightBracketingBar]"}]}], 
           
           RowBox[{"\[PartialD]", 
            SubscriptBox["q", "i"]}]], 
          FractionBox[
           RowBox[{"\[PartialD]", 
            RowBox[{"\[LeftBracketingBar]", "G", "\[RightBracketingBar]"}]}], 
           
           RowBox[{"\[PartialD]", 
            SubscriptBox["q", "j"]}]]}], "+", 
         RowBox[{
          FractionBox["1", 
           RowBox[{"\[LeftBracketingBar]", "G", "\[RightBracketingBar]"}]], 
          FractionBox[
           RowBox[{
            SuperscriptBox["\[PartialD]", "2"], 
            RowBox[{"\[LeftBracketingBar]", "G", "\[RightBracketingBar]"}]}], 
           
           RowBox[{
            RowBox[{"\[PartialD]", 
             SubscriptBox["q", "j"]}], 
            RowBox[{"\[PartialD]", 
             SubscriptBox["q", "i"]}]}]]}]}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8112839563610363`*^9, 3.811283987383457*^9}, {
  3.811284020189752*^9, 3.8112841289872303`*^9}, {3.8113004250458927`*^9, 
