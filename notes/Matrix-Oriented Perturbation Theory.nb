326ff15817dd"],

Cell["Next we can note that", "ExpositoryText",
 CellChangeTimes->{{3.919769485990714*^9, 
  3.919769488786868*^9}},ExpressionUUID->"37d1b610-8822-4364-904c-\
b18ff7e9d00b"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "Q"], 
       SubscriptBox["G", "Q"]}], " ", "=", " ", 
      RowBox[{
       SubscriptBox["\[Del]", "Q"], 
       RowBox[{"(", " ", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", "Q"}], 
         RowBox[{"\[LeftAngleBracket]", 
          RowBox[{"1", ",", "2"}], "\[RightAngleBracket]"}], 
         RowBox[{
          SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", "Q"}], 
         RowBox[{"\[LeftAngleBracket]", 
          RowBox[{"1", ",", "1"}], "\[RightAngleBracket]"}], 
         SubscriptBox["G", "R"]}], " ", ")"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", "Q"], "R"}], 
        RowBox[{"\[LeftAngleBracket]", 
         RowBox[{"2", ",", "1"}], "\[RightAngleBracket]"}], 
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["R", "2"]], "\[InvisibleSpace]", "Q"}], 
        RowBox[{"\[LeftAngleBracket]", 
         RowBox[{"2", ",", "2"}], "\[RightAngleBracket]"}], 
        RowBox[{
         SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", "Q"}], 
        RowBox[{"\[LeftAngleBracket]", 
         RowBox[{"1", ",", "1"}], "\[RightAngleBracket]"}], 
        SubscriptBox["G", "R"]}], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", "Q"}], 
          RowBox[{"\[LeftAngleBracket]", 
           RowBox[{"1", ",", "3"}], "\[RightAngleBracket]"}], 
          RowBox[{
           SubscriptBox["\[Del]", "Q"], "R"}], 
          RowBox[{"\[LeftAngleBracket]", 
           RowBox[{"2", ",", "1"}], "\[RightAngleBracket]"}], 
          RowBox[{
           SubscriptBox["\[Del]", 
            SuperscriptBox["R", "2"]], "\[InvisibleSpace]", "Q"}], 
          RowBox[{"\[LeftAngleBracket]", 
           RowBox[{"2", ",", "1"}], "\[RightAngleBracket]"}], 
          SubscriptBox["G", "R"]}], ")"}], 
        RowBox[{"2", ":", "1"}]], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", "Q"}], 
          RowBox[{"\[LeftAngleBracket]", 
           RowBox[{"1", ",", "3"}], "\[RightAngleBracket]"}], 
          RowBox[{
           SubscriptBox["\[Del]", "R"], "\[InvisibleSpace]", "Q"}], 
          RowBox[{"\[LeftAngleBracket]", 
           RowBox[{"1", ",", "2"}], "\[RightAngleBracket]"}], 
          RowBox[{
           SubscriptBox["\[Del]", "Q"], 
           SubscriptBox["G", "R"]}]}], ")"}], 
        RowBox[{"3", ":", "1"}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.919769498439225*^9, 3.91976952404922*^9}, {
  3.919769580985652*^9, 3.919769638814645*^9}, {3.919769684993739*^9, 
