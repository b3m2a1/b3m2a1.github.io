  3.889894351629793*^9}},ExpressionUUID->"bab147c7-3df2-429c-a4a1-\
4c824d05f2de"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["S", "b", "a"], "\[InvisibleSpace]", "(", "n", ")"}],
       " ", "=", " ", 
      RowBox[{
       SubsuperscriptBox["S", 
        RowBox[{"b", "-", "a"}], "0"], "(", "n", ")"}]}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{
        SubsuperscriptBox["S", "b", "0"], "(", "n", ")"}], 
       RowBox[{
        SubsuperscriptBox["S", "c", "0"], "\[InvisibleSpace]", "(", 
        RowBox[{"n", "-", "b"}], ")"}]}], " ", "=", " ", 
      RowBox[{
       SubsuperscriptBox["S", 
        RowBox[{"b", "+", "c"}], "0"], "(", "n", ")"}]}]},
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["S", "0", "a"], "(", 
       RowBox[{"n", "-", "c"}], ")"}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["S", "c", "0"], "(", "n", ")"}], " ", 
       RowBox[{
        SubsuperscriptBox["S", "0", 
         RowBox[{"a", "-", "c"}]], "(", "n", ")"}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["S", "b", "0"], "(", 
       RowBox[{"n", "+", "c"}], ")"}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["S", "0", "c"], "(", "n", ")"}], " ", 
       RowBox[{
        SubsuperscriptBox["S", 
         RowBox[{"b", "-", "c"}], "0"], "(", "n", ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.88989387408167*^9, 3.889893919459546*^9}, {
  3.889893952396796*^9, 3.889893971562447*^9}, {3.889894297840982*^9, 
