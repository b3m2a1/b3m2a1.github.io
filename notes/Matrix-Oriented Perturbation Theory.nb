Cell["then we do the usual rearrangement to give us", "ExpositoryText",
 CellChangeTimes->{{3.821324793989327*^9, 
  3.821324800893198*^9}},ExpressionUUID->"d5ccb10d-2af8-4516-806f-\
b5e12e8f7605"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["P", "U"], "(", 
     RowBox[{
      SuperscriptBox["H", 
       RowBox[{"(", "0", ")"}]], "-", 
      SuperscriptBox[
       SubscriptBox["E", "n"], 
       RowBox[{"(", "0", ")"}]]}], ")"}], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], " ", "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], 
     RowBox[{"k", "-", "1"}]], 
    RowBox[{
     RowBox[{
      SubscriptBox["P", "U"], "(", 
      RowBox[{
       SuperscriptBox[
        SubscriptBox["E", "n"], 
        RowBox[{"(", 
         RowBox[{"k", "-", "i"}], ")"}]], "-", 
       SuperscriptBox["H", 
        RowBox[{"(", 
         RowBox[{"k", "-", "i"}], ")"}]]}], ")"}], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "i", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8213248080368977`*^9, 3.8213249201166677`*^9}, {
  3.821325226231365*^9, 
  3.821325228798064*^9}},ExpressionUUID->"339f7196-f4b6-4129-9774-\
0e351cfe787e"],

Cell[TextData[{
 "where you\[CloseCurlyQuote]ll note we\[CloseCurlyQuote]re assuming we have ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", 
        RowBox[{"k", "-", "1"}], ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "02172ba2-46bd-456e-b749-628b8d2f5dc7"],
 ", which seems to be in contradiction to our previous work. Don\
\[CloseCurlyQuote]t worry, we\[CloseCurlyQuote]ll resolve this in a moment."
}], "ExpositoryText",
 CellChangeTimes->{{3.8213252303696747`*^9, 
  3.8213252820305347`*^9}},ExpressionUUID->"185e7aef-3509-430f-8b1d-\
53dfbf93e318"],

Cell["Finally then we add the identity on the left and expand", \
"ExpositoryText",
 CellChangeTimes->{{3.821324938691593*^9, 3.8213249408467407`*^9}, {
  3.821324995859007*^9, 3.821325013258945*^9}, {3.821325055303472*^9, 
  3.821325056848975*^9}, {3.821325283694256*^9, 
  3.821325288263288*^9}},ExpressionUUID->"ba7fbfb4-1925-453b-9dfd-\
0421393c4012"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["P", "U"], "(", 
     RowBox[{
      SuperscriptBox["H", 
       RowBox[{"(", "0", ")"}]], "-", 
      SuperscriptBox[
       SubscriptBox["E", "n"], 
       RowBox[{"(", "0", ")"}]]}], ")"}], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], " ", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["P", "U"], "(", 
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", "0", ")"}]], "-", 
       SuperscriptBox[
        SubscriptBox["E", "n"], 
        RowBox[{"(", "0", ")"}]]}], ")"}], 
     SubscriptBox["P", "U"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "k", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["P", "U"], "(", 
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", "0", ")"}]], "-", 
       SuperscriptBox[
        SubscriptBox["E", "n"], 
        RowBox[{"(", "0", ")"}]]}], ")"}], 
     SubscriptBox["P", "D"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "k", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8213248080368977`*^9, 3.8213249201166677`*^9}, {
  3.821325226231365*^9, 3.821325228798064*^9}, {3.821325294288226*^9, 
  3.821325332007873*^9}},ExpressionUUID->"8836ffb9-1620-452f-98f7-\
719a20a55152"],

Cell[TextData[{
 "and then we note that any linear combination of states in the degenerate \
subspace is an eigenstate of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "0", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.8213248080368977`*^9, 3.8213249201166677`*^9}, {
   3.821325226231365*^9, 3.821325228798064*^9}, {3.821325294288226*^9, 
   3.821325332007873*^9}},ExpressionUUID->
  "82bc2ad7-4101-4de0-8041-aaf61fe489e8"],
 " with eigenvalue ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["E", "n"], 
    RowBox[{"(", "0", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.8213248080368977`*^9, 3.8213249201166677`*^9}, {
   3.821325226231365*^9, 3.821325228798064*^9}, {3.821325294288226*^9, 
   3.821325332007873*^9}},ExpressionUUID->
  "965e1dbe-632f-4e0e-8112-a6177372e627"],
 ", since"
}], "ExpositoryText",
 CellChangeTimes->{{3.821325337046585*^9, 
  3.8213253884370527`*^9}},ExpressionUUID->"2dc54010-0eda-4875-adda-\
64d87f940cfa"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", "0", ")"}]], 
