f653228efed7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Given", " ", "a", " ", "tensor", " ", 
    StyleBox["A",
     FontWeight->"Bold"], " ", "with", " ", "axes", " ", 
    SubscriptBox[
     StyleBox["i",
      FontSlant->"Italic"], "1"]}], ",", " ", 
   SubscriptBox[
    StyleBox["i",
     FontSlant->"Italic"], "2"], ",", " ", 
   RowBox[{"...", " ", 
    SubscriptBox[
     StyleBox["i",
      FontSlant->"Italic"], "N"]}], ",", " ", 
   RowBox[{
    RowBox[{"assuming", " ", "WLOG", " ", "that", " ", "n"}], ">", "m"}]}], 
  TraditionalForm]], "ExpositoryMath",
 CellChangeTimes->{{3.7927845151789227`*^9, 3.7927845197128973`*^9}, {
  3.792784555042465*^9, 
