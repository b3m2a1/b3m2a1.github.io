Cell[TextData[{
 "we can build the first order correction to the wave function in the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "n"], TraditionalForm]],ExpressionUUID->
  "6ac4ebd0-101f-43c7-8f5e-1ad27000e6cf"],
 " subspace by first building an energy-shifted perturbation and applying \
this to the zero-order state to get an unperturbed correction"
}], "ExpositoryText",
 CellChangeTimes->{{3.821641247436636*^9, 3.821641249156386*^9}, {
   3.821641833152177*^9, 3.8216418602261763`*^9}, {3.821642613344026*^9, 
   3.821642619744227*^9}, {3.821642748798414*^9, 3.821642755284432*^9}, {
   3.821642831507193*^9, 3.8216429118865843`*^9}, 
   3.8216451152321167`*^9},ExpressionUUID->"084cb791-5716-4d53-a364-\
b43d664c80e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "@", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
     "figStyleText", "[", 
      "\"\<\[CapitalDelta]\!\(\*SuperscriptBox[StyleBox[\"n\",FontSlant->\"\
Italic\"], RowBox[{\"(\", \"1\", \")\"}]]\)\>\"", "]"}], ",", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"figStyleText", "@", "\"\<=\>\""}], ",", "\[IndentingNewLine]", 
     RowBox[{"pertPlot", "[", "\[IndentingNewLine]", 
      RowBox[{"Transpose", "@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[CapitalDelta]n", "[", "$ptData", "]"}], "[", 
         RowBox[{
          RowBox[{"\[ScriptCapitalT]", "[", "$ptData", "]"}], ",", " ", "1", 
          ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1"}], "}"}]}], "]"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"figStyleText", "@", "\"\<=\>\""}], ",", "\[IndentingNewLine]", 
     RowBox[{"RawBoxes", "@", 
      RowBox[{"RowBox", "@", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"StyleBox", "[", 
          RowBox[{"\"\<(\>\"", ",", " ", "$figTextStyles"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"ToBoxes", "@", 
          RowBox[{"pertPlot", "[", 
           RowBox[{
            RowBox[{"\[CapitalEta]", "[", "$ptData", "]"}], "[", "1", "]"}], 
           "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"ToBoxes", "@", 
          RowBox[{"figStyleText", "@", "\"\<-\>\""}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"ToBoxes", "@", 
          RowBox[{"pertPlot", "[", 
           RowBox[{"DiagonalMatrix", "[", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"\[CapitalEpsilon]", "[", "$ptData", "]"}], "[", "1", 
               "]"}], ",", " ", 
              RowBox[{"$ptData", "[", 
               RowBox[{"[", "\"\<NDim\>\"", "]"}], "]"}]}], " ", "]"}], "]"}],
            "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"StyleBox", "[", 
          RowBox[{"\"\<)\>\"", ",", " ", "$figTextStyles"}], "]"}]}], 
        "\[IndentingNewLine]", "}"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"pertPlot", "[", 
      RowBox[{"Transpose", "@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Phi]", "[", "$ptData", "]"}], "[", "0", "]"}], "}"}]}], 
      "]"}]}], "\[IndentingNewLine]", "}"}], "\[IndentingNewLine]", 
   "}"}]}]], "Input",
