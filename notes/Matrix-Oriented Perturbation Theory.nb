6c424401adaa"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Chi]", "B"], "(", 
       RowBox[{
        SubscriptBox["n", "j"], ",", " ", "0", ",", " ", "4"}], ")"}], "=", 
      "\[VeryThinSpace]", 
      RowBox[{
       FractionBox[
        RowBox[{"(", 
         RowBox[{"1", "-", 
          SubscriptBox["\[Delta]", "000"]}], ")"}], 
        RowBox[{
         SubscriptBox["d", "j"], "\[InvisibleSpace]", 
         SubscriptBox["\[Omega]", "j"]}]], 
       RowBox[{
        SubscriptBox["\[Rho]", 
         RowBox[{"\[InvisibleSpace]", 
          RowBox[{"Q", "\[InvisibleSpace]", "p"}]}]], "(", 
        RowBox[{
         RowBox[{
          RowBox[{
           SubscriptBox["n", "j"], "+", 
           SubscriptBox["d", "j"]}], " ", ";", " ", "0"}], ",", " ", "2"}], 
        ")"}], 
       RowBox[{
        SubscriptBox["\[Rho]", 
         StyleBox["qq",
          FontSlant->"Italic"]], "(", 
        RowBox[{
         RowBox[{
          SubscriptBox["n", "j"], " ", ";", " ", "0"}], ",", " ", "2"}], 
        ")"}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Chi]", "B"], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["n", "i"], ",", " ", "0", ",", " ", "2"}], ")"}]}], "=",
       "\[VeryThinSpace]", 
      RowBox[{
       FractionBox[
        RowBox[{"(", 
         RowBox[{"1", "-", 
          SubscriptBox["\[Delta]", "000"]}], ")"}], 
        RowBox[{
         SubscriptBox["d", "i"], "\[InvisibleSpace]", 
         SubscriptBox["\[Omega]", "i"]}]], 
       RowBox[{
        SubscriptBox["\[Rho]", 
         RowBox[{"\[InvisibleSpace]\[InvisibleSpace]", "p"}]], "(", 
        RowBox[{
         RowBox[{
          RowBox[{
           SubscriptBox["n", "i"], "+", 
           SubscriptBox["d", "i"]}], " ", ";", " ", "0"}], ",", " ", "1"}], 
        ")"}], 
       RowBox[{
        SubscriptBox["\[Rho]", 
         StyleBox["q",
          FontSlant->"Italic"]], "(", 
        RowBox[{
         RowBox[{
          SubscriptBox["n", "i"], " ", ";", " ", "0"}], ",", " ", "1"}], 
        ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8135373576320133`*^9, 3.8135373582980757`*^9}, {
  3.813537395399353*^9, 
  3.813537535726742*^9}},ExpressionUUID->"eb052b32-89b3-44fa-b66b-\
9a7753323c1b"],

Cell[TextData[{
 "we see, even totally ignoring everything on the right, that the \
perturbation operator term has made this zero. We could also have applied the \
same logic to the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", "(", 
    StyleBox["d",
     FontWeight->"Bold"], ")"}], TraditionalForm]],ExpressionUUID->
  "95086268-29fe-438b-af2e-3fbaa1104f3b"],
 " term in the earlier summation. Therefore, "
}], "ExpositoryText",
 CellChangeTimes->{{3.8135375375117617`*^9, 
  3.81353761201546*^9}},ExpressionUUID->"f13c040b-4116-4cea-aa26-\
43230b335023"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], 
    SubscriptBox["q", "k"], "\[InvisibleSpace]", 
    SubscriptBox["q", "k"], "\[CapitalPi]", "\[VeryThinSpace]", 
    SubscriptBox[
     RowBox[{"p", "\[InvisibleSpace]"}], "i"], "\[InvisibleSpace]", 
    SubscriptBox[
     RowBox[{"Q", "\[InvisibleSpace]"}], "j"], "\[InvisibleSpace]", 
    SubscriptBox["p", "j"], "\[InvisibleSpace]", "\[CapitalPi]", "\[InvisibleSpace]\[VeryThinSpace]", 
    SubscriptBox["q", "j"], "\[InvisibleSpace]", 
    SubscriptBox[
     RowBox[{"q", "\[InvisibleSpace]"}], "j"], "\[InvisibleSpace]", 
    SubscriptBox["q", "i"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], "=", "0"}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.81353400504825*^9, 3.813534183993164*^9}, {
   3.813534293788464*^9, 3.813534301080258*^9}, {3.8135343394933167`*^9, 
   3.813534434322995*^9}, {3.8135346463027287`*^9, 3.813534659309725*^9}, {
   3.81353475485942*^9, 3.8135347953422117`*^9}, {3.813534843009605*^9, 
   3.813534848346739*^9}, {3.813535033172475*^9, 3.8135350935776567`*^9}, {
   3.813535385134471*^9, 3.8135354695754213`*^9}, {3.8135359647553577`*^9, 
   3.81353601163146*^9}, {3.8135361261765413`*^9, 3.813536165120452*^9}, {
   3.8135363208542233`*^9, 3.813536368539447*^9}, {3.8135364166823063`*^9, 
   3.813536442310855*^9}, {3.8135364790619*^9, 3.813536490810783*^9}, {
   3.813536525907126*^9, 3.813536570522444*^9}, {3.813536691757083*^9, 
   3.8135366950868683`*^9}, {3.813536921186365*^9, 3.813536931074243*^9}, {
   3.813537093174944*^9, 3.813537135301662*^9}, {3.813537178533146*^9, 
