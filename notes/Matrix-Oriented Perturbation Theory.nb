48ddd46f0549"],

Cell["\<\
But it might be possible to provide a bound on the size of the off-diagonal \
terms. To do that, we\[CloseCurlyQuote]ll note that\
\>", "ExpositoryText",
 CellChangeTimes->{{3.82699158129496*^9, 
  3.826991598578614*^9}},ExpressionUUID->"ed874620-9b22-46d3-9909-\
2e45b3015eac"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox["\[ScriptCapitalH]", 
       RowBox[{"(", 
        RowBox[{"a", "+", "1"}], ")"}]], "=", 
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", 
         RowBox[{"a", "+", "1"}], ")"}]], "+", 
       SubsuperscriptBox["J", "a", 
        RowBox[{"(", "1", ")"}]]}]}]},
    {
     RowBox[{
      SubsuperscriptBox["J", "a", 
       RowBox[{"(", "m", ")"}]], "=", 
      RowBox[{
       SubsuperscriptBox["J", 
        RowBox[{"a", "-", "1"}], 
        RowBox[{"(", 
         RowBox[{"m", "+", "1"}], ")"}]], "+", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"b", "=", "0"}], 
         RowBox[{"a", "-", "1"}]], 
        RowBox[{
         SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
          RowBox[{"(", "a", ")"}]], 
         RowBox[{
          SubsuperscriptBox["\[CapitalPi]", "U", 
           RowBox[{"(", "b", ")"}]], "(", 
          RowBox[{
           SuperscriptBox["\[CapitalDelta]H", 
            RowBox[{"(", 
             RowBox[{"b", "+", "m"}], ")"}]], "+", 
           SubsuperscriptBox["J", "b", 
            RowBox[{"(", "m", ")"}]]}], ")"}]}]}]}]}]},
    {
     RowBox[{
      SubsuperscriptBox["J", 
       RowBox[{"a", "-", "1"}], 
       RowBox[{"(", 
        RowBox[{"m", "+", "1"}], ")"}]], "=", 
      RowBox[{
       SubsuperscriptBox["J", 
        RowBox[{"a", "-", "2"}], 
        RowBox[{"(", 
         RowBox[{"m", "+", "2"}], ")"}]], "+", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"b", "=", "0"}], 
         RowBox[{"a", "-", "2"}]], 
        RowBox[{
         SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
          RowBox[{"(", 
           RowBox[{"a", "-", "1"}], ")"}]], 
         RowBox[{
          SubsuperscriptBox["\[CapitalPi]", "U", 
           RowBox[{"(", "b", ")"}]], "(", 
          RowBox[{
           SuperscriptBox["\[CapitalDelta]H", 
            RowBox[{"(", 
             RowBox[{"b", "+", "m", "+", "1"}], ")"}]], "+", 
           SubsuperscriptBox["J", "b", 
            RowBox[{"(", 
             RowBox[{"m", "+", "1"}], ")"}]]}], ")"}]}]}]}]}]},
    {
     RowBox[{
      SubsuperscriptBox["J", "a", 
       RowBox[{"(", "m", ")"}]], "=", 
      RowBox[{
       SubsuperscriptBox["J", 
        RowBox[{"a", "-", "2"}], 
        RowBox[{"(", 
         RowBox[{"m", "+", "2"}], ")"}]], "+", 
       RowBox[{
        SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
         RowBox[{"(", "a", ")"}]], 
        RowBox[{
         SubsuperscriptBox["\[CapitalPi]", "U", 
          RowBox[{"(", 
           RowBox[{"a", "-", "1"}], ")"}]], "(", 
         RowBox[{
          SuperscriptBox["\[CapitalDelta]H", 
           RowBox[{"(", 
            RowBox[{"a", "-", "1", "+", "m"}], ")"}]], "+", 
          SubsuperscriptBox["J", 
           RowBox[{"a", "-", "1"}], 
           RowBox[{"(", "m", ")"}]]}], ")"}]}], " ", "+", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"b", "=", "0"}], 
         RowBox[{"a", "-", "2"}]], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
            RowBox[{"(", "a", ")"}]], "+", 
           SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
            RowBox[{"(", 
             RowBox[{"a", "-", "1"}], ")"}]]}], ")"}], 
         RowBox[{
          SubsuperscriptBox["\[CapitalPi]", "U", 
           RowBox[{"(", "b", ")"}]], "(", 
          RowBox[{
           SuperscriptBox["\[CapitalDelta]H", 
            RowBox[{"(", 
             RowBox[{"b", "+", "m"}], ")"}]], "+", 
           SubsuperscriptBox["J", "b", 
            RowBox[{"(", "m", ")"}]], "+", 
           SuperscriptBox["\[CapitalDelta]H", 
            RowBox[{"(", 
             RowBox[{"b", "+", "m", "+", "1"}], ")"}]], "+", 
           SubsuperscriptBox["J", "b", 
            RowBox[{"(", 
             RowBox[{"m", "+", "1"}], ")"}]]}], ")"}]}]}]}]}]},
    {
     RowBox[{
      SubsuperscriptBox["J", "a", 
       RowBox[{"(", "1", ")"}]], "=", 
      RowBox[{
       SubsuperscriptBox["J", 
        RowBox[{"a", "-", "1"}], 
        RowBox[{"(", "2", ")"}]], "+", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"b", "=", "0"}], 
         RowBox[{"a", "-", "1"}]], 
        RowBox[{
         SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
          RowBox[{"(", "a", ")"}]], 
         SubsuperscriptBox["\[CapitalPi]", "U", 
          RowBox[{"(", "b", ")"}]], 
         SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
          RowBox[{"(", 
           RowBox[{"b", "+", "1"}], ")"}]]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
