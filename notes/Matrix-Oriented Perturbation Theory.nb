Cell["and then determine how many states they represent", "ExpositoryText",
 CellChangeTimes->{{3.81712241851412*^9, 3.817122421368404*^9}, {
  3.817122482703598*^9, 
  3.8171225165097847`*^9}},ExpressionUUID->"a788cd9f-3665-43c2-9ac4-\
0fbc50eebc86"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Total", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"numPerms", "[", 
     RowBox[{"#", ",", " ", "9"}], "]"}], "&"}], "/@", 
   RowBox[{"TakeWhile", "[", 
    RowBox[{
     RowBox[{"IntegerPartitions", "[", "10", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"#", "\[NotEqual]", 
       RowBox[{"{", 
        RowBox[{
        "4", ",", " ", "3", ",", " ", "1", ",", " ", "1", ",", " ", "1"}], 
        "}"}]}], "&"}]}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.817122486025647*^9, 3.8171225207322283`*^9}},
 CellLabel->
  "In[1706]:=",ExpressionUUID->"4c79e847-0d79-479d-9d66-93e3453354f8"],

Cell[BoxData["15831"], "Output",
 CellChangeTimes->{{3.8171224954705677`*^9, 3.8171225211111927`*^9}},
 CellLabel->
  "Out[1706]=",ExpressionUUID->"def846aa-73f2-4abe-a6da-b631f29924fc"]
}, Open  ]],

Cell["adding on the number of states with fewer than 10 quanta", \
"ExpositoryText",
 CellChangeTimes->{{3.817122524856827*^9, 
  3.817122537656706*^9}},ExpressionUUID->"f801d157-8b8a-4a5d-873f-\
95c22a5eb105"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{"numStates", "[", 
     RowBox[{"i", ",", " ", "9"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", "9"}], "}"}]}], "]"}], "+", "\[IndentingNewLine]", 
  RowBox[{"Total", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"numPerms", "[", 
      RowBox[{"#", ",", " ", "9"}], "]"}], "&"}], "/@", 
    RowBox[{"TakeWhile", "[", 
     RowBox[{
      RowBox[{"IntegerPartitions", "[", "10", "]"}], ",", " ", 
      RowBox[{
       RowBox[{"#", "\[NotEqual]", 
        RowBox[{"{", 
         RowBox[{
         "4", ",", " ", "3", ",", " ", "1", ",", " ", "1", ",", " ", "1"}], 
         "}"}]}], "&"}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.817122486025647*^9, 3.817122559966011*^9}},
 CellLabel->
  "In[1712]:=",ExpressionUUID->"096cdd8a-5554-4864-ab68-f64a0966cd79"],

Cell[BoxData["64450"], "Output",
 CellChangeTimes->{{3.817122560501494*^9, 3.817122569981533*^9}},
 CellLabel->
  "Out[1712]=",ExpressionUUID->"be5650b6-3d96-4c5c-9ac8-6a8461c7be6d"]
}, Open  ]],

Cell[TextData[{
 "and now we have our ",
 StyleBox["baseline",
  FontSlant->"Italic"],
 " for getting the index. That was the easy part."
}], "ExpositoryText",
 CellChangeTimes->{{3.817122575673748*^9, 
  3.8171226014267597`*^9}},ExpressionUUID->"2b4a29a6-fccd-4cee-98fb-\
94c1e629d3f8"],

Cell["\<\
Next when do our reverse sorting, we can capture a permutation that orders \
the partition\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8171226245237913`*^9, 
  3.817122703215839*^9}},ExpressionUUID->"d6b99510-72c4-4e6a-82a9-\
afde3fdccccf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Ordering", "[", 
   RowBox[{"{", 
    RowBox[{
    "1", ",", "4", ",", "3", ",", "1", ",", "0", ",", "0", ",", "0", ",", "1",
      ",", "0"}], "}"}], "]"}], "//", "Reverse"}]], "Input",
 CellChangeTimes->{{3.817122683105194*^9, 3.817122721291471*^9}},
 CellLabel->
  "In[1713]:=",ExpressionUUID->"b2b64cee-80e5-44f7-b031-d08756df25bd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "2", ",", "3", ",", "8", ",", "4", ",", "1", ",", "9", ",", "7", ",", "6", 
   ",", "5"}], "}"}]], "Output",
 CellChangeTimes->{3.8171227215985193`*^9},
 CellLabel->
  "Out[1713]=",ExpressionUUID->"35bfeb7e-5403-4ae7-8169-c2e5d9c971e2"]
}, Open  ]],

Cell["we now need to provide a way to index permutations. ", "ExpositoryText",
 CellChangeTimes->{{3.817122761503118*^9, 3.817122827822069*^9}, {
   3.817123392552799*^9, 3.8171234148358927`*^9}, {3.81712346101967*^9, 
   3.8171234669182453`*^9}, 
   3.817123627885993*^9},ExpressionUUID->"824a825c-4a73-4648-b381-\
6c3125aa62e3"],

Cell[TextData[{
 "A classic algorithm is the ",
 StyleBox["Lehmer code",
  FontSlant->"Italic"],
 " which computes a bit string representation of an index, or alternately a \
representation in a factorial base. This is constructed iteratively by \
recognizing that given a permutation like"
}], "ExpositoryText",
 CellChangeTimes->{{3.817122761503118*^9, 3.817122827822069*^9}, {
  3.817123392552799*^9, 3.8171234148358927`*^9}, {3.81712346101967*^9, 
  3.8171234669182453`*^9}, {3.817123635797187*^9, 3.817123649169767*^9}, {
  3.817123695480629*^9, 3.817123751165161*^9}, {3.817124498288567*^9, 
  3.817124548216426*^9}, {3.8171247005306597`*^9, 3.817124729826486*^9}, {
  3.817124805828066*^9, 
  3.817124828849112*^9}},ExpressionUUID->"743413f0-496a-4f70-a86c-\
52d1575bb32c"],

Cell[BoxData[
 FormBox[
  RowBox[{"p", "=", 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["p", "1"], ",", " ", 
     SubscriptBox["p", "2"], ",", " ", "..."}], " ", ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.817124732764222*^9, 3.817124732770454*^9}, {
  3.817124830684737*^9, 
  3.817124839788171*^9}},ExpressionUUID->"943bf2d0-459d-4d79-ae32-\
262384f3efdf"],

Cell["at each step there are", "ExpositoryText",
 CellChangeTimes->{{3.81712484330515*^9, 
  3.8171248476946697`*^9}},ExpressionUUID->"2e05528b-1c2c-4fba-bc1a-\
05879666a41d"],

Cell["\<\
 The issue with this is that it doesn't account for the lack of uniqueness of \
the various terms. OTOH, it's a good starting point for what we're going. So \
first, we calculate the Lehmer code, which will \
\>", "ExpositoryText",
 CellChangeTimes->{{3.817122761503118*^9, 3.817122827822069*^9}, {
  3.817123392552799*^9, 3.8171234148358927`*^9}, {3.81712346101967*^9, 
  3.8171234669182453`*^9}, {3.817123635797187*^9, 3.817123649169767*^9}, {
  3.817123695480629*^9, 3.817123751165161*^9}, {3.817124498288567*^9, 
  3.817124548216426*^9}},ExpressionUUID->"4f22d909-e7cf-47ae-9d70-\
f9c1daa2b807"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tree Viz", "Subsubsection",
 CellChangeTimes->{{3.81993649916887*^9, 
  3.819936501878201*^9}},ExpressionUUID->"0d27c5e6-ca08-4bd0-a6f0-\
d2c5550cbcdc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"baseTree", "=", 
   RowBox[{"GroupBy", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Permutations", "[", 
      RowBox[{"{", 
       RowBox[{
       "2", ",", " ", "1", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], 
       "}"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"First", "\[Rule]", "Rest"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Nest", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", "g", "}"}], ",", " ", 
         RowBox[{
          RowBox[{"GroupBy", "[", 
           RowBox[{"#", ",", " ", 
            RowBox[{"First", "\[Rule]", "Rest"}], ",", " ", "g"}], "]"}], 
          "&"}]}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"GroupBy", "[", 
        RowBox[{"First", "\[Rule]", "Rest"}], "]"}], ",", 
       "\[IndentingNewLine]", "2"}], "\[IndentingNewLine]", "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"normTree", "=", 
   RowBox[{"Nest", "[", 
    RowBox[{"Normal", ",", " ", "baseTree", ",", " ", "5"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"simpTree", "=", 
   RowBox[{"List", "[", 
    RowBox[{
     RowBox[{"normTree", "//.", 
      RowBox[{
       RowBox[{"Rule", "[", 
        RowBox[{"a_", ",", " ", "b_"}], "]"}], "\[RuleDelayed]", 
       RowBox[{"a", "[", "b", "]"}]}]}], "//.", 
     RowBox[{
      RowBox[{"List", "[", "x__", "]"}], "\[RuleDelayed]", "x"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.81993635500103*^9, 3.8199364538241997`*^9}, {
  3.819936486513464*^9, 3.819936493564288*^9}, {3.819937003050261*^9, 
  3.8199370121726847`*^9}, {3.819937054195937*^9, 3.819937056074748*^9}},
 CellLabel->
  "In[978]:=",ExpressionUUID->"78a4416e-3445-4b22-9ef4-9928c68174d8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"makeTree", "[", 
   RowBox[{"nodes_", ",", "renderFunc_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"counter", "=", "0"}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"traverse", "[", 
       RowBox[{"h_", "[", "childs___", "]"}], "]"}], ":=", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"id", "=", "counter"}], "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"UndirectedEdge", "[", 
             RowBox[{"id", ",", 
              RowBox[{"++", "counter"}]}], "]"}], ",", 
            RowBox[{"counter", "\[Rule]", 
             RowBox[{"renderFunc", "[", "#", "]"}]}], ",", 
            RowBox[{"traverse", "[", "#", "]"}]}], "}"}], "&"}], "/@", 
         RowBox[{"{", "childs", "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"traverse", "[", "_", "]"}], ":=", 
      RowBox[{"Sequence", "[", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"TreeGraph", "[", 
        RowBox[{"#1", ",", 
         RowBox[{"VertexShape", "\[Rule]", "#2"}]}], "]"}], "&"}], "@@", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Partition", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"traverse", "[", "nodes", "]"}], "]"}], ",", "2"}], "]"}], 
       "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.819936859560611*^9, 3.819936859564209*^9}, {
   3.8199368922979593`*^9, 3.819936896316465*^9}, 3.819936991836747*^9},
 CellLabel->
  "In[962]:=",ExpressionUUID->"f212ba6c-bac6-4f68-9ece-f30e4cbba083"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"labStyle", "=", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Style", "[", "\[IndentingNewLine]", 
     RowBox[{"#", ",", "\[IndentingNewLine]", 
      RowBox[{"FontSize", "\[Rule]", "24"}], ",", "\[IndentingNewLine]", 
      RowBox[{"FontWeight", "\[Rule]", "Bold"}], ",", "\[IndentingNewLine]", 
      " ", 
      RowBox[{"FontColor", "\[Rule]", "Black"}], ",", " ", 
      RowBox[{"FontFamily", "\[Rule]", "\"\<Helvetica\>\""}]}], "]"}], 
    "&"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"initTree", "=", "\[IndentingNewLine]", 
   RowBox[{"makeTree", "[", "\[IndentingNewLine]", 
    RowBox[{"simpTree", ",", " ", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"labStyle", "@", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", "#", "]"}], " ", "===", " ", "Integer"}], ",", 
         " ", "#", ",", " ", 
         RowBox[{"Head", "[", "#", "]"}]}], "]"}]}], "&"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"valMap", "=", "\[IndentingNewLine]", 
   RowBox[{"PropertyValue", "[", "\[IndentingNewLine]", 
    RowBox[{"initTree", ",", "\[IndentingNewLine]", "VertexShape"}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.8199372634093237`*^9, 3.819937326299103*^9}, {
  3.819937476829322*^9, 3.819937541047222*^9}, {3.819937584811335*^9, 
  3.8199375850270348`*^9}},
 CellLabel->
  "In[1029]:=",ExpressionUUID->"46d74586-4334-42da-b5d4-dd1efa3c7042"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"TreePlot", "[", "\[IndentingNewLine]", 
   RowBox[{"initTree", ",", "\[IndentingNewLine]", 
    RowBox[{"PlotTheme", "\[Rule]", "\"\<Web\>\""}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"VertexShapeFunction", "\[Rule]", "\[IndentingNewLine]", 
     RowBox[{"(", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"White", ",", " ", 
           RowBox[{"Disk", "[", 
            RowBox[{"#", ",", " ", ".2"}], "]"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{"Black", ",", "\[IndentingNewLine]", 
           RowBox[{"Inset", "[", 
            RowBox[{
             RowBox[{"Lookup", "[", 
              RowBox[{"valMap", ",", " ", "#2", ",", " ", 
               RowBox[{"labStyle", "@", "\"\<{}\>\""}]}], "]"}], ",", " ", 
             "#"}], "]"}]}], "\[IndentingNewLine]", "}"}]}], 
        "\[IndentingNewLine]", "}"}], "&"}], "\[IndentingNewLine]", ")"}]}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{"ImageSize", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"Automatic", ",", " ", "500"}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "imageify"}]], "Input",
 CellChangeTimes->{{3.8199368645957937`*^9, 3.8199370150762043`*^9}, {
  3.819937094840866*^9, 3.8199371011878633`*^9}, {3.819937147875955*^9, 
