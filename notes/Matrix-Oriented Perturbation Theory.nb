11dd4ccb3d18"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{
     SubscriptBox["D", "e"], "(", 
     RowBox[{"1", "-", 
      SuperscriptBox["e", 
       RowBox[{
        RowBox[{"-", "\[Alpha]"}], "\[VeryThinSpace]", 
        "\[CapitalDelta]r"}]]}], ")"}], "2"], " ", "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "2"}], "\[Infinity]"], " ", 
    RowBox[{
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "i"], 
      RowBox[{"i", "\[VeryThinSpace]", "!"}]], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["2", "i"], "-", "2"}], ")"}], 
     SubscriptBox["D", "e"], "\[VeryThinSpace]", 
     SuperscriptBox["a", "i"], "\[CapitalDelta]", "\[InvisibleSpace]", 
     SuperscriptBox["r", "i"], " "}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
