Cell["\<\
We\[CloseCurlyQuote]ll focus on the inertia tensor for now, but note that \
everything will work the same for G. For the first derivatives we have\
\>", "ExpositoryText",
 CellChangeTimes->{{3.811284365706358*^9, 3.81128437162923*^9}, {
  3.811381468349533*^9, 
  3.81138148629976*^9}},ExpressionUUID->"81d45722-add6-416f-b011-\
039e552c3091"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox["\[PartialD]", 
     RowBox[{"\[PartialD]", 
      SubscriptBox["q", "i"]}]], 
    RowBox[{"\[LeftBracketingBar]", 
     SuperscriptBox["I", "0"], "\[RightBracketingBar]"}]}], "=", 
   RowBox[{"Tr", "(", 
    RowBox[{
     RowBox[{"Adj", "(", 
      SubscriptBox["I", "0"], ")"}], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SubscriptBox["I", "0"]}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["q", "i"]}]]}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811267980105794*^9, 3.811268043099012*^9}, {
   3.8112841666923103`*^9, 3.811284175449643*^9}, 3.811285022203511*^9, 
   3.8112851114799843`*^9, {3.811300420696946*^9, 
   3.811300422350287*^9}},ExpressionUUID->"da512d9d-d75c-457d-842f-\
89f589e2a816"],

Cell[TextData[{
 "where Adj is the ",
 StyleBox["adjugate matrix",
  FontSlant->"Italic"],
 ". In general, it\[CloseCurlyQuote]s the transpose of the ",
 StyleBox["cofactor matrix",
  FontSlant->"Italic"],
 ", but since ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["I", "0"], TraditionalForm]],ExpressionUUID->
  "9868eb76-2b57-4bce-9c91-8b42d8d7508f"],
 " is invertible we have "
}], "ExpositoryText",
 CellChangeTimes->{{3.8112850241277647`*^9, 3.811285039800297*^9}, {
  3.8112850951839542`*^9, 3.811285146958652*^9}, {3.81128689388416*^9, 
  3.811286921754251*^9}},ExpressionUUID->"81e48e58-1f9c-4c4a-880d-\
ca63563249bb"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"Adj", "(", 
       SubscriptBox["I", "0"], ")"}], "=", 
      RowBox[{
       SuperscriptBox[
        SubscriptBox["I", "0"], 
        RowBox[{"-", "1"}]], 
       RowBox[{"\[LeftBracketingBar]", 
        SubscriptBox["I", "0"], "\[RightBracketingBar]"}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "Q"], 
       RowBox[{"Adj", "(", 
        SubscriptBox["I", "0"], ")"}]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"\[LeftBracketingBar]", 
         SubscriptBox["I", "0"], "\[RightBracketingBar]"}], 
        RowBox[{
         SubscriptBox["\[Del]", "Q"], 
         SuperscriptBox[
          SubscriptBox["I", "0"], 
          RowBox[{"-", "1"}]]}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", "Q"], " ", 
         RowBox[{"\[LeftBracketingBar]", 
          SubscriptBox["I", "0"], "\[RightBracketingBar]"}]}], 
        "\[CircleTimes]", 
        SuperscriptBox[
         SubscriptBox["I", "0"], 
         RowBox[{"-", "1"}]]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811285036103492*^9, 3.811285093814386*^9}, {
  3.8112851281460743`*^9, 3.8112851585329313`*^9}, {3.811285189121462*^9, 
  3.8112852059492893`*^9}, {3.81128596856492*^9, 3.8112859687606564`*^9}, {
  3.8112869257630577`*^9, 3.811286928831415*^9}, {3.811300412304722*^9, 
  3.811300418897952*^9}, {3.833147526788295*^9, 
  3.83314759227335*^9}},ExpressionUUID->"63908c5e-3843-46bd-83aa-\
6018a25ade65"],

Cell["and looking towards the second derivatives we note that", \
"ExpositoryText",
 CellChangeTimes->{{3.81128450169433*^9, 3.8112845119662323`*^9}, {
  3.8112845505662622`*^9, 3.811284604638566*^9}, {3.811285953427182*^9, 
