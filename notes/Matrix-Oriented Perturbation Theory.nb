              SubscriptBox["Q", "y"], 
              SuperscriptBox[
               SubscriptBox["Q", "z"], "2"]}], ")"}]}
          },
          GridBoxAlignment->{"Columns" -> {{Center}}}], ")"}]},
       {
        RowBox[{"(", GridBox[{
           {
            RowBox[{"(", 
             RowBox[{
