   3.825696732002599*^9, 3.825696741368223*^9}, {3.825698547745413*^9, 
   3.825698552909367*^9}, {3.825698993654249*^9, 
   3.8256989938424873`*^9}},ExpressionUUID->"9573586f-acfa-437c-a0e1-\
333996213504"],

Cell["which is what we wanted.", "ExpositoryText",
 CellChangeTimes->{{3.825698995127614*^9, 
  3.8256990001807013`*^9}},ExpressionUUID->"95ff063d-dfbc-4df6-895c-\
88365cae82df"],

Cell[TextData[{
 "Next we\[CloseCurlyQuote]ll go to order 2, assuming the degeneracy persists \
through ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["E", "n", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.825696493964294*^9, 3.825696494560236*^9}, {
    3.825696528898571*^9, 3.8256965968869743`*^9}, 3.8256966839488564`*^9, {
    3.825696732002599*^9, 3.825696741368223*^9}, {3.825698547745413*^9, 
    3.825698552909367*^9}, {3.825698993654249*^9, 3.8256989938424873`*^9}},
  ExpressionUUID->"878c531c-ae14-40ea-a530-d51c97b4996b"],
 ", meaning ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["P", "D"], 
     SuperscriptBox["H", 
      RowBox[{"(", "1", ")"}]], 
     SubscriptBox["P", "D"], 
     TemplateBox[{"n"},
      "Ket"]}], "=", "\[DoubleStruckZero]"}], TraditionalForm]],
  CellChangeTimes->{{3.825696493964294*^9, 3.825696494560236*^9}, {
    3.825696528898571*^9, 3.8256965968869743`*^9}, 3.8256966839488564`*^9, {
    3.825696732002599*^9, 3.825696741368223*^9}, {3.825698547745413*^9, 
