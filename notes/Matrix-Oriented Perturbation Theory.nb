06a6fc71dee8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], 
     RowBox[{"k", "-", "1"}]], " ", 
    RowBox[{
     SubscriptBox["P", "D"], 
     SuperscriptBox["H", 
