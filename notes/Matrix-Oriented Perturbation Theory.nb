Cell[TextData[{
 "and we\[CloseCurlyQuote]ll start by noticing that \[CapitalLambda] is very \
closely related to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["S", "1"], "\[InvisibleSpace]", "P", "\[InvisibleSpace]", 
      SubscriptBox["S", "2"]}], ")"}], 
    RowBox[{"-", "1"}]], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "76286be0-d502-4411-a58e-23fbc3c27d3e"],
 ", and in fact they\[CloseCurlyQuote]re related by an element-wise product \
with"
}], "ExpositoryText",
 CellChangeTimes->{{3.891681326664768*^9, 3.891681385968453*^9}, {
