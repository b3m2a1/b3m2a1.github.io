Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[ForAll]", "i"], " ", 
       SubsuperscriptBox["J", "1", 
        RowBox[{"(", 
         RowBox[{"k", ",", "i"}], ")"}]]}], "=", 
      RowBox[{
       SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
        RowBox[{"(", "1", ")"}]], 
       SubsuperscriptBox["\[CapitalPi]", 
        SuperscriptBox["U", 
         RowBox[{"(", "0", ")"}]], "n"], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", 
         RowBox[{"k", "-", "i"}], ")"}]]}]}]},
    {
     RowBox[{"=", 
      RowBox[{"\[DoubleStruckZero]", " ", "+", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"b", "=", "0"}], "0"], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            SuperscriptBox["\[CapitalDelta]H", 
             RowBox[{"(", "1", ")"}]], 
            SubsuperscriptBox["\[CapitalPi]", "U", 
             RowBox[{"(", "b", ")"}]]}], "+", 
           SubsuperscriptBox["\[DoubleStruckZero]\[CapitalPi]", "U", 
            RowBox[{"(", "b", ")"}]]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           SubsuperscriptBox["J", "b", 
            RowBox[{"(", 
             RowBox[{"k", ",", "i"}], ")"}]], "+", 
           SuperscriptBox["\[CapitalDelta]H", 
            RowBox[{"(", 
             RowBox[{"k", "+", "b", "-", "i"}], ")"}]]}], ")"}]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       SuperscriptBox["\[CapitalDelta]H", 
        RowBox[{"(", "1", ")"}]], 
       SubsuperscriptBox["\[CapitalPi]", "U", 
        RowBox[{"(", "0", ")"}]], 
       SuperscriptBox["\[CapitalDelta]H", 
        RowBox[{"(", 
         RowBox[{"k", "-", "i"}], ")"}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825821464090979*^9, 3.825821464855678*^9}, {
