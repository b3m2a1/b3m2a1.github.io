Cell["Setup", "Subsubsubsubsubsection",
 CellChangeTimes->{{3.9204636737171793`*^9, 
  3.920463674469062*^9}},ExpressionUUID->"15ced5b8-4992-4942-ad88-\
0f024170d463"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "evalH1H1Terms", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"evalH1H1Terms", "[", 
    RowBox[{
    "termGen_", ",", " ", "termGen2_", ",", " ", "blockSizes_", ",", " ", 
     RowBox[{"aggregate", ":", 
      RowBox[{"True", "|", "False"}], ":", "True"}]}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"crds", "=", 
        RowBox[{"Array", "[", 
         RowBox[{"\[FormalN]", ",", " ", 
          RowBox[{"Length", "@", "blockSizes"}]}], "]"}]}], ",", 
       RowBox[{"\[Omega]", "=", 
        RowBox[{"Array", "[", 
         RowBox[{"\[FormalOmega]", ",", " ", 
          RowBox[{"Length", "@", "blockSizes"}]}], "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Total", "[", 
             RowBox[{"Abs", "[", "path", "]"}], "]"}], "==", "0"}], ",", " ", 
           "\[IndentingNewLine]", "Nothing", ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"termGen", "[", 
             RowBox[{
              RowBox[{"Sequence", "@@", "path"}], ",", " ", 
              RowBox[{"Sequence", "@@", "crds"}]}], "]"}], "*", 
            RowBox[{
             RowBox[{"termGen2", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Sequence", "@@", 
                RowBox[{"(", 
                 RowBox[{"-", "path"}], ")"}]}], ",", " ", 
               "\[IndentingNewLine]", 
               RowBox[{"Sequence", "@@", 
                RowBox[{"(", 
                 RowBox[{"crds", "+", "path"}], ")"}]}]}], 
              "\[IndentingNewLine]", "]"}], "/", 
             RowBox[{"Total", "[", 
              RowBox[{"\[Omega]", "*", "path"}], "]"}]}]}]}], 
          "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"path", ",", 
           RowBox[{"Tuples", "[", 
