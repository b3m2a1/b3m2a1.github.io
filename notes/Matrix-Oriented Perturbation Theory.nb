Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["P", "b", "a"], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"n", "+", "a", "-", "b", "+", "1"}], ")"}], 
     SubsuperscriptBox["P", 
      RowBox[{"b", "-", "1"}], "a"]}], " ", "+", " ", 
    SubsuperscriptBox["P", "b", 
     RowBox[{"a", "-", "1"}]]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.8896243644537497`*^9, 
