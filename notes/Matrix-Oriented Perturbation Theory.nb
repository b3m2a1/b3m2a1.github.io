        SubscriptBox["\[CapitalPi]", "n"], 
        SubscriptBox["P", "D"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]]}]}]}]},
    {
     RowBox[{"\[AlignmentMarker]", 
      RowBox[{
       RowBox[{
        RowBox[{"+", 
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", "1", ")"}]]}], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubscriptBox["P", "O"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "2", ")"}]]}], "+", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubscriptBox["P", "D"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "2", ")"}]]}], "+"}]}]},
    {
     RowBox[{"\[AlignmentMarker]", 
      RowBox[{
       RowBox[{
        RowBox[{"+", 
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", "1", ")"}]]}], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubscriptBox["P", "O"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubscriptBox["P", "O"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]]}], "+", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubscriptBox["P", "O"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubscriptBox["P", "D"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]]}]}]}]},
    {
     RowBox[{"\[AlignmentMarker]", 
      RowBox[{
       RowBox[{
        RowBox[{"+", 
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", "1", ")"}]]}], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubscriptBox["P", "D"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubscriptBox["P", "O"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]]}], "+", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubscriptBox["P", "D"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubscriptBox["P", "D"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "1", ")"}]]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCenteredManuallyAligned",
 CellChangeTimes->{{3.82805199953102*^9, 3.828052001770055*^9}, {
   3.8280520415681143`*^9, 3.828052076570458*^9}, {3.828052110066807*^9, 
   3.828052317190997*^9}, 3.8280525531972637`*^9, {3.828052721290851*^9, 
   3.828052723765136*^9}, {3.828053043879674*^9, 
   3.828053178624308*^9}},ExpressionUUID->"b54743cb-71c4-4c77-b21d-\
32c9b39069f2"],

Cell[TextData[{
 "and we see that we really only have one term that is order 2 in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPi]", "n"], 
    SubscriptBox["P", "D"]}], TraditionalForm]],
  CellChangeTimes->{{3.82805199953102*^9, 3.828052001770055*^9}, {
    3.8280520415681143`*^9, 3.828052076570458*^9}, {3.828052110066807*^9, 
    3.828052317190997*^9}, 3.8280525531972637`*^9, {3.828052721290851*^9, 
    3.828052723765136*^9}, {3.828053043879674*^9, 3.828053178624308*^9}},
  ExpressionUUID->"0137b326-9226-4969-90fd-6e064de7f97c"],
 " even in ",
 Cell[BoxData[
  SubsuperscriptBox["B", "n", 
   RowBox[{"(", "3", ")"}]]],
  CellChangeTimes->{{3.82805199953102*^9, 3.828052001770055*^9}, {
    3.8280520415681143`*^9, 3.828052076570458*^9}, {3.828052110066807*^9, 
    3.828052317190997*^9}, 3.8280525531972637`*^9, {3.828052721290851*^9, 
    3.828052723765136*^9}, {3.828053043879674*^9, 3.828053178624308*^9}},
  ExpressionUUID->"ce7a3cc9-9459-48ef-8d3d-2e63b10cccff"],
 " and we can get a potentially better basis for the variational calculation \
by leaving the order 1 terms in."
}], "ExpositoryText",
 InitializationCell->True,
 CellChangeTimes->{{3.8280531805871162`*^9, 
  3.828053301769195*^9}},ExpressionUUID->"61d46fbc-1f5f-4ff0-a079-\
3177cc93f4f2"],

Cell[TextData[{
 "Okay! Now we will go back and suppose that for every ",
 Cell[BoxData[
  FormBox[
   RowBox[{"j", " ", "<", " ", "k"}], TraditionalForm]],ExpressionUUID->
  "aa981f2d-1288-44e1-b324-a9533b951049"],
 " it is possible to write"
}], "ExpositoryText",
 CellChangeTimes->{{3.828053322599918*^9, 3.828053350167013*^9}, {
  3.828053401417235*^9, 3.828053414533085*^9}, {3.828053739784836*^9, 
  3.828053752815488*^9}},ExpressionUUID->"967b5506-eadc-4b12-b28a-\
dce19865d471"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["A", "n", 
    RowBox[{"(", "j", ")"}]], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"a", "=", "0"}], 
     RowBox[{"j", "-", "1"}]], " ", 
    SubsuperscriptBox["\[ScriptCapitalA]", "n", 
     RowBox[{"(", 
      RowBox[{"j", ",", " ", "a"}], ")"}]]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8280533513472443`*^9, 
  3.82805345249959*^9}},ExpressionUUID->"09ddfc2a-d227-4e36-a832-\
dcc39797ad15"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[ScriptCapitalA]", "n", 
    RowBox[{"(", 
     RowBox[{"j", ",", " ", "a"}], ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.8280533513472443`*^9, 3.82805345249959*^9}},
  ExpressionUUID->"42944b9c-0e7c-4d22-bc3e-6667aba4ab06"],
 " only contains terms which are order ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "3a850e11-27f2-4da3-b5dc-a4d73597eeb1"],
 " in ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalPi]", "n"], 
   SubscriptBox["P", "D"]}]],
  CellChangeTimes->{{3.82805199953102*^9, 3.828052001770055*^9}, {
    3.8280520415681143`*^9, 3.828052076570458*^9}, {3.828052110066807*^9, 
    3.828052317190997*^9}, 3.8280525531972637`*^9, {3.828052721290851*^9, 
    3.828052723765136*^9}, {3.828053043879674*^9, 3.828053178624308*^9}},
  ExpressionUUID->"7adec792-8507-4dd9-838f-3be4c14e2622"],
 ". It should be clear from what we just did that this is possible through \
3rd order."
}], "ExpositoryText",
 CellChangeTimes->{{3.828053455964655*^9, 3.828053492704939*^9}, {
  3.828053922848127*^9, 
  3.82805394632539*^9}},ExpressionUUID->"4e135364-5b6e-4e67-b52b-\
da9eb5e8a6fe"],

Cell[" Now with that we can write", "ExpositoryText",
 CellChangeTimes->{{3.828053455964655*^9, 3.828053492704939*^9}, {
  3.828053922848127*^9, 
  3.828053925262982*^9}},ExpressionUUID->"301a23ba-3589-4c99-9336-\
7244000c62d5"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["A", "n", 
       RowBox[{"(", "k", ")"}]], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], 
        RowBox[{"k", "-", "1"}]], 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], "(", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[CapitalPi]", "n"], 
          SubscriptBox["P", "O"], 
          SubsuperscriptBox["A", "n", 
           RowBox[{"(", "i", ")"}]]}], "+", 
         RowBox[{
          SubscriptBox["\[CapitalPi]", "n"], 
          SubscriptBox["P", "D"], 
          SubsuperscriptBox["A", "n", 
           RowBox[{"(", "i", ")"}]]}], "+", 
         TemplateBox[{
           RowBox[{
             SuperscriptBox["n", 
              RowBox[{"(", "0", ")"}]], " "}], 
           RowBox[{"\[VeryThinSpace] ", 
             SuperscriptBox["n", 
              RowBox[{"(", "i", ")"}]]}]},
          "BraKet"]}], ")"}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], 
         RowBox[{"k", "-", "1"}]], 
        RowBox[{
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", 
           RowBox[{"k", "-", "i"}], ")"}]], 
         TemplateBox[{
           RowBox[{
             SuperscriptBox["n", 
              RowBox[{"(", "0", ")"}]], " "}], 
           RowBox[{"\[VeryThinSpace] ", 
             SuperscriptBox["n", 
              RowBox[{"(", "i", ")"}]]}]},
          "BraKet"]}]}], " ", "+", " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], 
         RowBox[{"k", "-", "1"}]], " ", 
        RowBox[{
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", 
           RowBox[{"k", "-", "i"}], ")"}]], 
         SubscriptBox["\[CapitalPi]", "n"], 
         SubscriptBox["P", "O"], 
         SubsuperscriptBox["A", "n", 
          RowBox[{"(", "i", ")"}]]}]}], "+", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], 
         RowBox[{"k", "-", "1"}]], 
        RowBox[{
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", 
           RowBox[{"k", "-", "i"}], ")"}]], 
