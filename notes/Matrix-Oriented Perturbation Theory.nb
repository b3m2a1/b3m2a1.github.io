              RowBox[{"(", "0", ")"}]]},
            "Ket"], 
           TemplateBox[{
             SuperscriptBox["d", 
              RowBox[{"(", "0", ")"}]]},
            "Bra"]}]}], "-", 
         SubsuperscriptBox["E", "\[Eta]", 
          RowBox[{"(", "a", ")"}]]}], ")"}], " ", "-", " ", 
       RowBox[{"(", " ", 
        RowBox[{
         RowBox[{
          UnderscriptBox["\[Sum]", 
           RowBox[{"d", "\[Element]", 
            SuperscriptBox["D", 
             RowBox[{"(", 
