Cell[TextData[{
 "Clearly this means we need to adapt our hypothesis. Rather than having one \
degenerate subspace, we\[CloseCurlyQuote]ll have a degenerate subspace and \
non-degenerate subspace at each order ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "c5b323d8-b776-49d8-9596-02778e19ee33"],
 ", given by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["D", 
    RowBox[{"(", "a", ")"}]], TraditionalForm]],ExpressionUUID->
  "cbabc388-cbe5-44e8-bcec-9c535a46446f"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["U", 
    RowBox[{"(", "a", ")"}]], TraditionalForm]],ExpressionUUID->
  "a658ddb0-4ec9-4721-b6d1-0430d2a1f01c"],
 " respectively."
}], "ExpositoryText",
 CellChangeTimes->{{3.825774937380658*^9, 3.825774949146594*^9}, {
  3.8257750076059713`*^9, 
  3.825775071857731*^9}},ExpressionUUID->"5fd38cee-47cd-4f25-995e-\
ab9c80c40955"],

Cell["\<\
Now we rebuild our intuition. We start by noting that when we have only a \
single degenerate space\
\>", "ExpositoryText",
 CellChangeTimes->{{3.825774937380658*^9, 3.825774949146594*^9}, {
  3.8257750076059713`*^9, 3.825775082967681*^9}, {3.8257751208780203`*^9, 
