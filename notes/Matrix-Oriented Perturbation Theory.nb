  3.8438439446618443`*^9}},ExpressionUUID->"50f75453-920e-4900-81bd-\
3639d93301d9"],

Cell[BoxData[
 FormBox[
  RowBox[{"H", " ", "=", " ", 
   RowBox[{
    RowBox[{
     FractionBox["\[HBar]\[Omega]", 
      RowBox[{"2", "\[InvisibleSpace]"}]], 
     RowBox[{"(", "\[VeryThinSpace]", 
      RowBox[{
       SuperscriptBox["p", "2"], " ", "+", " ", 
       SuperscriptBox["q", "2"]}], ")"}]}], " ", "+", " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "3"}], "\[Infinity]"], " ", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "i"], 
      FractionBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["2", "i"], "-", "2"}], ")"}], 
       RowBox[{"i", "\[VeryThinSpace]", "!"}]], 
      SuperscriptBox["\[HBar]", 
       RowBox[{"(", 
        RowBox[{"i", "/", "\[VeryThinSpace]", "2"}], ")"}]], 
      SuperscriptBox[
       RowBox[{
        SubscriptBox["D", "e"], "\[VeryThinSpace]", "(", 
        SqrtBox[
         RowBox[{
          RowBox[{
           SuperscriptBox["a", "2"], "/", "\[Mu]"}], "\[VeryThinSpace]", 
          "\[Omega]"}]], ")"}], "i"], 
      SuperscriptBox["q", "i"], " "}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.84384387883806*^9, 3.8438438793370256`*^9}, {
   3.8438439511854553`*^9, 3.843843973698641*^9}, {3.8438440161508837`*^9, 
