Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       SubscriptBox["E", "m"], 
       RowBox[{"(", "0", ")"}]], "-", 
      SuperscriptBox[
       SubscriptBox["E", "n"], 
       RowBox[{"(", "0", ")"}]]}], ")"}], 
    TemplateBox[{
      RowBox[{
        SuperscriptBox["m", 
         RowBox[{"(", "0", ")"}]], " "}], 
