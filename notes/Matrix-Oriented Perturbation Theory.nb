      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], 
    SubsuperscriptBox["A", "n", 
     RowBox[{"(", "k", ")"}]], 
    TemplateBox[{
      SuperscriptBox["m", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "64196e9f-f37c-4a2e-8ea6-cc5360c762bc"],
 ", which will be much easier if we can relate ",
 Cell[BoxData[
