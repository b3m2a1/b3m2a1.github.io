           RowBox[{"(", 
            RowBox[{
             SubscriptBox["E", "\[Beta]"], "-", 
             SubscriptBox["E", "n"]}], ")"}], 
           RowBox[{"(", 
            RowBox[{
             SubscriptBox["E", "\[Beta]"], "-", 
             SubscriptBox["E", "m"]}], ")"}]}]]}]}], "-", 
       RowBox[{
        UnderscriptBox["\[Sum]", "\[Beta]"], 
        FractionBox[
         RowBox[{
          SubsuperscriptBox[
           StyleBox["H",
            FontWeight->"Bold"], 
           RowBox[{"\[Beta]", "\[InvisibleSpace]", "n"}], 
           RowBox[{"(", "i", ")"}]], "(", 
          RowBox[{"1", "-", 
           SubscriptBox["\[Delta]", 
            RowBox[{"\[Beta]", "\[VeryThinSpace]", "n"}]]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["E", "n"], "-", 
           SubscriptBox["E", "m"]}], ")"}]], " "}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "0", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubscriptBox["\[CapitalPi]", "m"], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
