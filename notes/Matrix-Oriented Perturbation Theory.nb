 CellChangeTimes->{{3.9212522693559437`*^9, 3.921252428726137*^9}, {
   3.921252510710616*^9, 3.921252518842565*^9}, {3.921252661859428*^9, 
   3.9212527901278343`*^9}, {3.921252832103312*^9, 3.921252876210786*^9}, 
   3.921252990027869*^9, {3.921253192383931*^9, 3.9212532656462812`*^9}, {
   3.9212533281955748`*^9, 
   3.921253503582815*^9}},ExpressionUUID->"bff41970-19dd-4697-b7e6-\
7c8e59a9928b"],

Cell["which we can aggregate like", "ExpositoryText",
 CellChangeTimes->{{3.921259137492217*^9, 
  3.9212591428687487`*^9}},ExpressionUUID->"05963c2e-4b24-4cad-b5c6-\
2f2f2de12879"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "9"]}], 
    RowBox[{
     UnderscriptBox["\[Sum]", "a"], 
     RowBox[{
      FractionBox["1", 
       SubscriptBox["\[Omega]", "a"]], "\[InvisibleSpace]", 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         SubscriptBox["\[Omega]", "k"], 
         SubscriptBox["\[Omega]", "l"]], "+", 
        FractionBox[
         SubscriptBox["\[Omega]", "l"], 
         SubscriptBox["\[Omega]", "k"]]}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["V", 
          RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "a"}], 
          "3"], "\[InvisibleSpace]", 
         SubsuperscriptBox["V", 
          RowBox[{"a", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "l"}], 
          "3"]}], " ", "+", 
        RowBox[{
         FractionBox["1", "4"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            SubsuperscriptBox["V", 
             RowBox[{
             "i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "a"}], "3"], 
            "\[InvisibleSpace]", 
            SubsuperscriptBox["V", 
             RowBox[{
             "k", "\[InvisibleSpace]", "l", "\[InvisibleSpace]", "a"}], 
             "3"]}], "+", 
           RowBox[{
            SubsuperscriptBox["V", 
             RowBox[{
             "i", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "a"}], "3"], 
            "\[InvisibleSpace]", 
            SubsuperscriptBox["V", 
             RowBox[{
             "j", "\[InvisibleSpace]", "l", "\[InvisibleSpace]", "a"}], 
             "3"]}], "+", 
           RowBox[{
            SubsuperscriptBox["V", 
             RowBox[{
             "i", "\[InvisibleSpace]", "l", "\[InvisibleSpace]", "a"}], "3"], 
            "\[InvisibleSpace]", 
            SubsuperscriptBox["V", 
             RowBox[{
             "j", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "a"}], 
             "3"]}]}], ")"}]}]}], ")"}]}]}]}], " ", "-", 
   RowBox[{
    SubsuperscriptBox["V", 
     RowBox[{"i", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "a"}], "3"], 
    "\[InvisibleSpace]", 
    SubsuperscriptBox["V", 
     RowBox[{"j", "\[InvisibleSpace]", "l", "\[InvisibleSpace]", "a"}], "3"], 
    
    FractionBox["1", 
     SubscriptBox["\[Omega]", "k"]], 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       SubscriptBox["\[Omega]", "a"], 
       SubscriptBox["\[Omega]", "j"]], "+", 
      FractionBox[
       SubscriptBox["\[Omega]", "a"], 
       SubscriptBox["\[Omega]", "l"]]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.921259146821311*^9, 3.921259202847165*^9}, {
  3.921259242891575*^9, 3.921259342006678*^9}, {3.921259481553898*^9, 
  3.921259488179884*^9}},ExpressionUUID->"1fd23575-747e-45f3-adb2-\
0a683a24c42c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Redux", "Subsection",
 CellChangeTimes->{{3.921338236236258*^9, 
  3.921338238288172*^9}},ExpressionUUID->"ae659a53-ad36-4f53-b41f-\
982f91ecb8f2"],

Cell[TextData[{
 "Given an expansion of the potential as an expansion in coordinates ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "a729333d-971f-4808-b3e6-25793837d39b"],
 ", expressed as dimensionless normal modes with respect to some underlying \
set of coordinates"
}], "ExpositoryText",
 InitializationCell->True,
 CellChangeTimes->{{3.92133824394346*^9, 
  3.921338304371043*^9}},ExpressionUUID->"58249604-0ceb-4061-aa68-\
21422653cdd9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"V", "(", "R", ")"}], " ", "=", " ", 
   RowBox[{
    UnderscriptBox["\[Sum]", "n"], " ", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"n", "!"}]], 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["R", "n"]], "V"}], "\[CircleDot]", 
      SuperscriptBox["V", "n"]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.921338255310437*^9, 3.921338258600478*^9}, {
  3.921338948720374*^9, 
  3.9213389932894983`*^9}},ExpressionUUID->"486da5d0-38e2-4579-bd66-\
2a698745950a"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["R", "n"]], "V"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "d0eeaf5b-b063-46b1-b144-2cf5f69c35ce"],
 " is the tensor of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "f327c736-3ef5-4197-ad15-26d19bfd31d3"],
 "th derivatives of ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "7c691042-2f69-4d07-8d55-a606f1cf801d"],
 " with respect to the different combinations of ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "e46ae702-b638-40ba-9047-f342979c93e0"],
 " coordinates"
}], "ExpositoryText",
 CellChangeTimes->{{3.921339002947975*^9, 
  3.921339033960733*^9}},ExpressionUUID->"b46a18da-4ade-4d27-aa89-\
2a8578aac4d9"],

Cell[TextData[{
 "If we want to transform to a different set of dimensionless normal \
coordinates ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "73c286e7-9b79-4541-ad18-482ec31febd2"],
 " where all of the anharmonicity is in the kinetic energy, this means for \
all ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", " ", ">", " ", "2"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "034b1133-e1e3-4afb-b37a-ff656ced2f13"],
 ", "
}], "ExpositoryText",
 CellChangeTimes->{{3.921339035732678*^9, 
  3.921339099917438*^9}},ExpressionUUID->"de4c692f-61a7-4d9d-9e63-\
2126f1681299"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["Q", "n"]], "V"}], " ", "=", " ", "\[DoubleStruckZero]"}],
   TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.921339101223308*^9, 
  3.921339109674849*^9}},ExpressionUUID->"d1d32cb3-3abe-49ac-9467-\
a22c9d904ab9"],

Cell["\<\
which we can do order-by-order by first noting that by the chain rule\
\>", "ExpositoryText",
 CellChangeTimes->{{3.921339113317462*^9, 3.921339123145317*^9}, {
  3.921339160299974*^9, 
  3.921339175082179*^9}},ExpressionUUID->"22ac867b-c117-456d-bcce-\
1f3ab921fff0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", "Q"], "V"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Del]", "Q"], "R"}], ")"}], "\[InvisibleSpace]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Del]", "R"], "V"}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9213391658985777`*^9, 
  3.921339191932808*^9}},ExpressionUUID->"416324c4-7ed5-4c0c-9cfa-\
b8b830fb50ec"],

Cell[TextData[{
 "and then we will make use of the fact that, since we have dimensionless \
normal modes, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "Q"], "R"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Del]", "R"], "Q"}], " ", "=", " ", "I"}]}], 
   TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "8d064d69-8a7d-482f-a960-0ca4ac6355eb"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", 
      SuperscriptBox["Q", "2"]], "V"}], " ", "=", " ", 
    RowBox[{
     SubscriptBox["\[Del]", 
      SuperscriptBox["R", "2"]], "V"}]}], TraditionalForm]],ExpressionUUID->
  "b8f93052-152d-4c3d-80fd-7b32ff08fed7"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["Q", "2"]], "V"}], ")"}], 
     RowBox[{"i", "\[InvisibleSpace]", "j"}]], " ", "=", " ", 
    RowBox[{
     SubscriptBox["\[Omega]", "i"], 
     SubscriptBox["\[Delta]", 
      RowBox[{"i", "\[InvisibleSpace]", "j"}]]}]}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "f910dee2-a3ce-4610-ad50-bb1c476cfc21"]
}], "ExpositoryText",
 CellChangeTimes->{{3.921339193418531*^9, 
  3.921339358288368*^9}},ExpressionUUID->"bc094133-4d27-4c0c-97a2-\
990c6b97cd98"],

Cell[TextData[{
 "Then if we turn the crank on the derivatives we can express ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["Q", "3"]], "V"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "53db6f45-295c-4860-bdf3-5a5dfd8c0759"],
 " in terms of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["R", "3"]], "V"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "79a5189d-47c0-498e-8c8b-0afa3a8ca1dd"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["R", "2"]], "V"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "e16f598f-d495-4e4f-9f8f-ba8704435ebc"],
 " and after some simplification we can show that one possible coordinate \
transformation to eliminate the cubic portion of the potential is given by"
}], "ExpositoryText",
 CellChangeTimes->{{3.9213393614580173`*^9, 
  3.921339394484125*^9}},ExpressionUUID->"e00579e3-1a6b-43f9-b89f-\
b255645842fe"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Del]", 
       SuperscriptBox["Q", "2"]], "R"}], "\[InvisibleSpace]", ")"}], 
    RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", 
      RowBox[{"3", 
       SubscriptBox["\[Omega]", "k"]}]]}], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["R", "3"]], "V"}], ")"}], 
     RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.92114217326726*^9, 
  3.921142188317675*^9}},ExpressionUUID->"1440bb3f-47f0-47e4-9755-\
fcc862d9c085"],

Cell[TextData[{
 "By differentiating ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[Del]", "Q"], "R"}], 
     RowBox[{
      SubscriptBox["\[Del]", "R"], "Q"}]}], " ", "=", " ", "I"}], 
   TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "6c95118a-5ea8-4488-94af-5588e579ccd6"],
 " we can also show that"
}], "ExpositoryText",
 CellChangeTimes->{{3.921339397713818*^9, 
  3.921339427707312*^9}},ExpressionUUID->"c08bc7e5-3dba-410b-9c51-\
e3a9d58bba3c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["Q", "2"]], "R"}], " ", "=", " ", 
   RowBox[{"-", 
    RowBox[{
     SubscriptBox["\[Del]", 
      SuperscriptBox["R", "2"]], "Q"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.921339431102683*^9, 
  3.921339435773901*^9}},ExpressionUUID->"4570f306-e93c-4b72-b5a8-\
a901be3034fe"],

Cell[TextData[{
 "The higher derivatives get somewhat more complicated but we can also show \
that (letting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["V", "3"], " ", "=", " ", 
    RowBox[{
     SubscriptBox["\[Del]", 
      SuperscriptBox["R", "3"]], "V"}]}], TraditionalForm]],
  CellChangeTimes->{{3.921339485581294*^9, 3.9213395255362377`*^9}, {
   3.921339621438483*^9, 3.9213396261632147`*^9}},ExpressionUUID->
  "78bf3f8b-9bb3-4e98-a2da-ffb5f418b5a6"],
 ")"
}], "ExpositoryText",
 CellChangeTimes->{{3.921339437837762*^9, 3.921339453593742*^9}, {
  3.921339617190604*^9, 
  3.921339644795018*^9}},ExpressionUUID->"1d5aa023-8269-4d1f-a314-\
3922e8e0bd7d"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["Q", "3"]], "R"}], "  ", "=", " ", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", 
         RowBox[{"4", 
          SubscriptBox["\[Omega]", "l"]}]]}], 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["V", 
          RowBox[{
          "i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k", 
           "\[InvisibleSpace]", "l"}], "4"], " ", "-", " ", 
         RowBox[{
          UnderscriptBox["\[Sum]", "a"], "\[VeryThinSpace]", 
          RowBox[{
           FractionBox["5", 
            RowBox[{"9", 
             SubscriptBox["\[Omega]", "\[Alpha]"]}]], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              SubsuperscriptBox["V", 
               RowBox[{
               "i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "a"}], 
               "3"], "\[InvisibleSpace]", 
              SubsuperscriptBox["V", 
               RowBox[{
               "k", "\[InvisibleSpace]", "l", "\[InvisibleSpace]", "a"}], 
               "3"]}], "+", 
             RowBox[{
              SubsuperscriptBox["V", 
               RowBox[{
               "i", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "a"}], 
               "3"], "\[InvisibleSpace]", 
              SubsuperscriptBox["V", 
               RowBox[{
               "j", "\[InvisibleSpace]", "l", "\[InvisibleSpace]", "a"}], 
               "3"]}], "+", 
             RowBox[{
              SubsuperscriptBox["V", 
               RowBox[{
               "i", "\[InvisibleSpace]", "l", "\[InvisibleSpace]", "a"}], 
               "3"], "\[InvisibleSpace]", 
              SubsuperscriptBox["V", 
               RowBox[{
               "j", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "a"}], 
               "3"]}]}], ")"}]}]}]}], ")"}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["R", "3"]], "Q"}], " ", "=", " ", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"4", 
         SubscriptBox["\[Omega]", "l"]}]], 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["V", 
          RowBox[{
          "i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k", 
           "\[InvisibleSpace]", "l"}], "4"], " ", "-", " ", 
         RowBox[{
          UnderscriptBox["\[Sum]", "a"], "\[VeryThinSpace]", 
          RowBox[{
           FractionBox["1", 
            RowBox[{"9", 
             SubscriptBox["\[Omega]", "\[Alpha]"]}]], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              SubsuperscriptBox["V", 
               RowBox[{
               "i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "a"}], 
               "3"], "\[InvisibleSpace]", 
              SubsuperscriptBox["V", 
               RowBox[{
               "k", "\[InvisibleSpace]", "l", "\[InvisibleSpace]", "a"}], 
               "3"]}], "+", 
             RowBox[{
              SubsuperscriptBox["V", 
               RowBox[{
               "i", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "a"}], 
               "3"], "\[InvisibleSpace]", 
              SubsuperscriptBox["V", 
               RowBox[{
               "j", "\[InvisibleSpace]", "l", "\[InvisibleSpace]", "a"}], 
               "3"]}], "+", 
             RowBox[{
              SubsuperscriptBox["V", 
               RowBox[{
               "i", "\[InvisibleSpace]", "l", "\[InvisibleSpace]", "a"}], 
               "3"], "\[InvisibleSpace]", 
              SubsuperscriptBox["V", 
               RowBox[{
               "j", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "a"}], 
               "3"]}]}], ")"}]}]}]}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.921339485581294*^9, 3.9213395255362377`*^9}, {
  3.921339621438483*^9, 
  3.921339630207233*^9}},ExpressionUUID->"b93d0159-6882-4618-a2a3-\
629a4d42b522"],

Cell[TextData[{
 "and it\[CloseCurlyQuote]s possible to show that in general we can always \
express ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["Q", "n"]], "R"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "6d3764a7-34df-474a-9a3c-b60e07fb6f05"],
 " in terms of lower-order corrections and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["R", "n"]], "Q"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "5610022c-cd7a-4248-bc45-e44085316a83"],
 " in terms of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["Q", "n"]], "R"}], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "23a12776-e132-4cad-bd64-b817352578c2"],
 " (plus lower order corrections)"
}], "ExpositoryText",
 CellChangeTimes->{{3.921339528745347*^9, 
  3.92133957414812*^9}},ExpressionUUID->"e2f78356-e959-4b64-9a6b-\
8cc9e6a227ac"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "865ef85c-90bb-41fd-b431-9dcf73070597"],
 "-matrix then contains all of the anharmonicity, and working through a \
similar process we can show that"
}], "ExpositoryText",
 CellChangeTimes->{{3.921339575932362*^9, 
  3.921339597066992*^9}},ExpressionUUID->"4f9bf69b-e144-4252-9b79-\
248746ec2432"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", "Q"], 
    SubscriptBox["G", 
     RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]]}], 
   " ", "=", " ", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "R"], 
     SubscriptBox["G", 
      RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]]}], 
    " ", "+", " ", 
    RowBox[{
     FractionBox[
      SubsuperscriptBox["V", 
       RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}], 
       "3"], "3"], "\[InvisibleSpace]", 
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        SuperscriptBox[
         SubscriptBox["\[Omega]", "j"], "2"], "+", 
        SuperscriptBox[
         SubscriptBox["\[Omega]", "k"], "2"]}], 
       RowBox[{
        SubscriptBox["\[Omega]", "j"], 
        SubscriptBox["\[Omega]", "k"], "\[InvisibleSpace]"}]], ")"}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.921169527442912*^9, 3.921169527454835*^9}, {
   3.921169559887142*^9, 3.921169571598487*^9}, {3.921250771611794*^9, 
   3.921250779942511*^9}, {3.921251926181326*^9, 3.921251945413885*^9}, 
   3.921339616153656*^9},ExpressionUUID->"f30e8cd7-3a63-4349-b110-\
0040085b35ba"],

Cell[TextData[{
 "and I don\[CloseCurlyQuote]t have a simplified form for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["Q", "2"]], "G"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "7cdbede7-12b2-47d7-b7f0-faa3064b3304"],
 " yet, but in general it is just a bunch of matrix multiplications and \
transpositions (which I do have implemented)"
}], "ExpositoryText",
 CellChangeTimes->{{3.9213396574274187`*^9, 3.92133969707201*^9}, {
  3.921340370714216*^9, 
  3.9213403742727547`*^9}},ExpressionUUID->"d2fab9ff-097c-4936-b79e-\
229774fe9374"],

Cell["\<\
This has the benefit of being entirely black box, but it \
isn\[CloseCurlyQuote]t necessarily unique, as the determining criterion is \
that \
\>", "ExpositoryText",
 CellChangeTimes->{{3.921339699059041*^9, 3.921339713744049*^9}, {
  3.921340040547103*^9, 3.921340062190036*^9}, {3.921340116453023*^9, 
  3.9213401177738543`*^9}},ExpressionUUID->"3adbc547-dc76-4e04-a594-\
03578e30298f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox["Q", "2"]], "R"}], "\[InvisibleSpace]", ")"}], 
      RowBox[{"j", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "i"}]], 
     SubscriptBox["\[Omega]", "i"]}], " ", "+", " ", 
    RowBox[{
     SubscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox["Q", "2"]], "R"}], "\[InvisibleSpace]", ")"}], 
      RowBox[{"i", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "j"}]], 
     SubscriptBox["\[Omega]", "j"]}], " ", "+", " ", 
    RowBox[{
     SubscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox["Q", "2"]], "R"}], "\[InvisibleSpace]", ")"}], 
      RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]], 
     SubscriptBox["\[Omega]", "k"]}]}], " ", "=", " ", 
   RowBox[{"-", 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["R", "3"]], "V"}], ")"}], 
     RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
