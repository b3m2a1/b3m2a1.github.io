     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"w", "!"}], "/", 
        RowBox[{"2", "^", "w"}]}], " ", "*", 
       RowBox[{"Binomial", "[", 
        RowBox[{"b", ",", " ", "w"}], "]"}], "*", 
       RowBox[{"Binomial", "[", 
        RowBox[{"a", ",", " ", "w"}], "]"}], "*", 
       RowBox[{"FactorialPower", "[", 
        RowBox[{"n", ",", " ", 
         RowBox[{"b", "-", "w"}]}], "]"}]}], "//", "FunctionExpand"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"w", ",", " ", "0", ",", " ", "b"}], "}"}]}], 
    "\[IndentingNewLine]", "]"}]}]}]], "Input",
