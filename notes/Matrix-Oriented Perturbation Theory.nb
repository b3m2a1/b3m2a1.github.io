  3.832966450977026*^9}},ExpressionUUID->"2326041b-32c5-4d24-ac49-\
216b8a3dd09d"],

Cell["then we know elementwise that ", "ExpositoryText",
 CellChangeTimes->{{3.832966173773134*^9, 
  3.832966187282052*^9}},ExpressionUUID->"09a9644e-4c2e-483d-bbc3-\
48b71311d176"],

