Cell[TextData[{
 "With more knowledge of how V' arises from ",
 ButtonBox["Frederick",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://aip.scitation.org/doi/10.1063/1.480101"], None},
  ButtonNote->"http://aip.scitation.org/doi/10.1063/1.480101"],
 ", we can focus on the vibrational part and write"
}], "ExpositoryText",
