Cell[TextData[{
 "This new form has the benefit of reducing the annoying algebra we need to \
do to simply products of terms which are products of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalOmega]", "n", 
    RowBox[{"(", 
     SubscriptBox["p", "i"], ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.827876086077504*^9, 3.827876152374495*^9}, {
   3.8278762528083973`*^9, 3.8278763040383053`*^9}},ExpressionUUID->
  "269a5b5a-22b1-45ae-9b79-7b330ad1b33e"],
 " terms. We will look at a general one of these terms and reverse an earlier \
conversion to write ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", "m"], "=", 
    RowBox[{
     SubscriptBox["\[CapitalPi]", "m"], 
     SubsuperscriptBox["\[CapitalDelta]H", "m", 
      RowBox[{"(", "0", ")"}]]}]}], TraditionalForm]],ExpressionUUID->
  "a208e2d5-c5cc-4254-8a17-445e6d3e4011"]
}], "ExpositoryText",
 CellChangeTimes->{{3.827876316738253*^9, 3.827876371624679*^9}, {
  3.827876417227063*^9, 3.827876422619773*^9}, {3.827876484436716*^9, 
  3.827876494065276*^9}, {3.827928147621396*^9, 3.827928149555355*^9}, {
  3.8279320751234694`*^9, 3.827932078378209*^9}, {3.828037792285741*^9, 
  3.828037792722476*^9}, {3.828038099934853*^9, 3.828038107520219*^9}, {
  3.8280382304461727`*^9, 3.8280382564872713`*^9}, {3.828038502925935*^9, 
  3.82803851609197*^9}},ExpressionUUID->"bbc0138a-a233-490b-af5b-\
1918e8a07871"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["m", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], 
        SubsuperscriptBox["\[GothicCapitalO]", "n", 
         RowBox[{"(", "p", ")"}]]}], 
       SubsuperscriptBox["\[VerticalSeparator]", "a", "b"], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["m", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], "(", "\[VeryThinSpace]", 
        RowBox[{
         UnderoverscriptBox["\[Product]", 
          RowBox[{"i", "=", 
           RowBox[{"a", "+", "1"}]}], 
          RowBox[{"b", "-", "1"}]], 
         SubsuperscriptBox["\[CapitalOmega]", "n", 
          RowBox[{"(", 
           SubscriptBox["p", "i"], ")"}]]}], ")"}], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", 
         StyleBox[
          SubscriptBox["p", "b"],
          FontSize->14], ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["m", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], "(", "\[VeryThinSpace]", 
        RowBox[{
         UnderoverscriptBox["\[Product]", 
          RowBox[{"i", "=", 
           RowBox[{"a", "+", "1"}]}], 
          RowBox[{"b", "-", "1"}]], 
         RowBox[{
          SubsuperscriptBox["\[CapitalDelta]H", "n", 
           RowBox[{"(", 
            StyleBox[
             SubscriptBox["p", "i"],
             FontSize->14], ")"}]], 
          SubscriptBox["\[CapitalPi]", "n"], 
          SubscriptBox["R", "m"]}]}], ")"}], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", 
         StyleBox[
          SubscriptBox["p", "b"],
          FontSize->14], ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.828038249897216*^9, 3.82803830773142*^9}, {
  3.828038542044568*^9, 
  3.828038543102324*^9}},ExpressionUUID->"21a0b469-5cf0-4ecf-94ff-\
deeb977dc677"],

Cell[TextData[{
 "and it should be noted that, while annoying, this expression is not \
actually problematic to evaluate since we don\[CloseCurlyQuote]t need to \
worry about ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox["E", "m", 
      RowBox[{"(", "0", ")"}]], "-", 
     SubsuperscriptBox["E", "n", 
      RowBox[{"(", "0", ")"}]]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.827787068614751*^9, 3.827787080575087*^9}, {
   3.82778711921703*^9, 3.827787119623231*^9}, {3.8277880751576233`*^9, 
   3.827788091046792*^9}, {3.827788137225522*^9, 3.827788142574342*^9}, {
   3.827928246247395*^9, 3.827928248059978*^9}, {3.8279282800072393`*^9, 
   3.827928331259759*^9}, {3.827928364519987*^9, 3.827928367219597*^9}, {
   3.8279309973075943`*^9, 3.827931024364018*^9}, {3.82793105980718*^9, 
   3.827931063931376*^9}, {3.827931344124167*^9, 3.827931370518993*^9}, {
   3.827936304969411*^9, 3.82793635451012*^9}, {3.828037679280917*^9, 
   3.8280376970137253`*^9}, {3.828037733176909*^9, 3.828037781531168*^9}},
  ExpressionUUID->"2b686f29-df81-4b69-91c3-8c0fd1ab5c46"],
 " being small, as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox["E", "m", 
      RowBox[{"(", "0", ")"}]], "-", 
     SubsuperscriptBox["E", "n", 
      RowBox[{"(", "0", ")"}]]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.827787068614751*^9, 3.827787080575087*^9}, {
   3.82778711921703*^9, 3.827787119623231*^9}, {3.8277880751576233`*^9, 
   3.827788091046792*^9}, {3.827788137225522*^9, 3.827788142574342*^9}, {
   3.827928246247395*^9, 3.827928248059978*^9}, {3.8279282800072393`*^9, 
   3.827928331259759*^9}, {3.827928364519987*^9, 3.827928367219597*^9}, {
   3.8279309973075943`*^9, 3.827931024364018*^9}, {3.82793105980718*^9, 
   3.827931063931376*^9}, {3.827931344124167*^9, 3.827931370518993*^9}, {
   3.827936304969411*^9, 3.82793635451012*^9}, {3.828037679280917*^9, 
   3.8280376970137253`*^9}, {3.828037733176909*^9, 3.828037781531168*^9}},
  ExpressionUUID->"30fb0bac-02fb-4fb0-ab91-b73f4870583f"],
 " can never be in the denominator. We can go a step further, though, and say \
that maybe there\[CloseCurlyQuote]s another state ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["\[Eta]", 
      RowBox[{"(", "0", ")"}]]},
    "Bra"], TraditionalForm]],ExpressionUUID->
  "3cd411f5-80d0-401a-85ed-46a36e472272"],
 " where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox["E", "\[Eta]", 
      RowBox[{"(", "0", ")"}]], "-", 
     SubsuperscriptBox["E", "n", 
      RowBox[{"(", "0", ")"}]]}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.827787068614751*^9, 3.827787080575087*^9}, {
   3.82778711921703*^9, 3.827787119623231*^9}, {3.8277880751576233`*^9, 
   3.827788091046792*^9}, {3.827788137225522*^9, 3.827788142574342*^9}, {
   3.827928246247395*^9, 3.827928248059978*^9}, {3.8279282800072393`*^9, 
   3.827928331259759*^9}, {3.827928364519987*^9, 3.827928367219597*^9}, {
   3.8279309973075943`*^9, 3.827931024364018*^9}, {3.82793105980718*^9, 
   3.827931063931376*^9}, {3.827931344124167*^9, 3.827931370518993*^9}, {
   3.827936304969411*^9, 3.82793635451012*^9}, {3.828037679280917*^9, 
   3.8280376970137253`*^9}, {3.828037733176909*^9, 3.828037781531168*^9}},
  ExpressionUUID->"c0517957-48da-4def-b597-cf42013e8ef4"],
 " is also small. For that we can play the exact same trick as before and \
write"
}], "ExpositoryText",
 CellChangeTimes->{{3.82803860222797*^9, 3.828038660464571*^9}, {
  3.828038696831758*^9, 3.828038725488133*^9}, {3.828039056939116*^9, 
