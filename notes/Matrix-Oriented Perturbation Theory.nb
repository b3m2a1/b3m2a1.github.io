 CellChangeTimes->{{3.836740724184257*^9, 
  3.8367407657446423`*^9}},ExpressionUUID->"678e9bad-eb71-4cf2-9c05-\
91ba6e2eafee"],

Cell["so ", "ExpositoryText",
 CellChangeTimes->{{3.836740768747981*^9, 
  3.8367407690443583`*^9}},ExpressionUUID->"528ed8c8-d437-4535-9af4-\
e48442866d23"],

