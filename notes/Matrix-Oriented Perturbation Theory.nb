Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["\[Aleph]", "m", 
        RowBox[{"(", "p", ")"}]], "(", 
       RowBox[{
       "b", ",", " ", "\[Sigma]", ",", " ", "\[Tau]", ",", " ", "\[Rho]"}], 
       ")"}], "=", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{
         RowBox[{"\[LeftBracketingBar]", 
          RowBox[{"ones", "(", "\[Sigma]", ")"}], "\[RightBracketingBar]"}], 
         "+", 
         RowBox[{"\[LeftBracketingBar]", 
          RowBox[{"ones", "(", "\[Tau]", ")"}], "\[RightBracketingBar]"}]}]], 
       
       SuperscriptBox[
        SubsuperscriptBox["E", "n", 
         RowBox[{"(", "0", ")"}]], 
        RowBox[{"ones", "(", "\[Sigma]", ")"}]], 
       RowBox[{
        SubsuperscriptBox["\[GothicCapitalE]", "m", 
         RowBox[{"(", "p", ")"}]], "(", 
        RowBox[{"\[Tau]", ",", " ", "\[Rho]"}], ")"}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["\[Aleph]", "n", 
        RowBox[{"(", "p", ")"}]], "(", 
       RowBox[{
       "b", ",", " ", "\[Sigma]", ",", " ", "\[Tau]", ",", " ", "\[Rho]"}], 
       ")"}], "=", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{
         RowBox[{"\[LeftBracketingBar]", 
          RowBox[{"ones", "(", "\[Sigma]", ")"}], "\[RightBracketingBar]"}], 
         "+", 
         RowBox[{"\[LeftBracketingBar]", 
          RowBox[{"ones", "(", "\[Tau]", ")"}], "\[RightBracketingBar]"}]}]], 
       
       SuperscriptBox[
        SubsuperscriptBox["E", "m", 
         RowBox[{"(", "0", ")"}]], 
        RowBox[{"ones", "(", "\[Sigma]", ")"}]], 
       RowBox[{
        SubsuperscriptBox["\[GothicCapitalE]", "n", 
         RowBox[{"(", "p", ")"}]], "(", 
        RowBox[{"\[Tau]", ",", " ", "\[Rho]"}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
