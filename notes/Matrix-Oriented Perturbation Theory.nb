Cell[TextData[{
 "now if we can show that every ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["J", "a", 
    RowBox[{"(", 
     RowBox[{"k", ",", "i"}], ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.82582080808532*^9, 3.825820816415576*^9}, {
   3.825821174266798*^9, 3.82582117970197*^9}},ExpressionUUID->
  "66af3519-8a5b-47d2-84af-a7096b7147e3"],
 " can be evaluated ",
 StyleBox["without",
  FontSlant->"Italic"],
 " using ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["E", 
    RowBox[{"(", 
     RowBox[{"k", "+", "a"}], ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.82582080808532*^9, 3.825820816415576*^9}, {
