   3.825816486968265*^9, 
   3.8258164978443127`*^9}},ExpressionUUID->"efe65572-7cad-4eff-9d6a-\
8a3a9128928e"],

Cell[TextData[{
 "Now if degeneracies persist through order ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "2868071d-5d68-46ef-919a-40e60d574c31"],
 " as usual we\[CloseCurlyQuote]ll call the corresponding degenerate subspace \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", 
    SuperscriptBox["D", 
     RowBox[{"(", "a", ")"}]]], TraditionalForm]],ExpressionUUID->
  "0c6463ec-d8c8-454f-82b4-0f5f021f58cb"],
 " and then at order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "+", "1"}], TraditionalForm]],ExpressionUUID->
  "1161be1c-453f-4a00-9820-543a14e38dfe"],
 " we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.825787613848144*^9, 3.825787633025079*^9}, {
  3.8257885929030952`*^9, 
  3.825788612779508*^9}},ExpressionUUID->"717ed73f-93f5-4a73-9760-\
1206c02d46a6"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", 
        SuperscriptBox["D", 
         RowBox[{"(", "a", ")"}]]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], 
         RowBox[{"a", "+", "1"}]], 
        RowBox[{
         SuperscriptBox["\[CapitalDelta]H", 
          RowBox[{"(", 
           RowBox[{"a", "+", "1", "-", "i"}], ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", 
              RowBox[{"k", "+", "j"}], ")"}]]},
          "Ket"]}]}]}], "=", 
      RowBox[{
       RowBox[{
        SubscriptBox["P", 
         SuperscriptBox["D", 
          RowBox[{"(", "a", ")"}]]], 
        SuperscriptBox["\[CapitalDelta]H", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "k", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        SubscriptBox["P", 
         SuperscriptBox["D", 
