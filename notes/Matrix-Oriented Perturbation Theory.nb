  3.82664581973582*^9}},ExpressionUUID->"4167cb68-deaa-4289-887e-\
3730ce5b9928"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
    RowBox[{"(", "a", ")"}]], "=", 
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"d", "\[Element]", 
       SuperscriptBox["D", 
        RowBox[{"(", 
         RowBox[{"a", "+", "1"}], ")"}]]}]], 
     RowBox[{
      SubsuperscriptBox["E", "d", 
       RowBox[{"(", "a", ")"}]], 
      TemplateBox[{
        SuperscriptBox["d", 
         RowBox[{"(", "0", ")"}]]},
       "Ket"], 
      TemplateBox[{
        SuperscriptBox["d", 
         RowBox[{"(", "0", ")"}]]},
       "Bra"]}]}], "-", 
    SubsuperscriptBox["E", "\[Eta]", 
     RowBox[{"(", "a", ")"}]]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.826645820853992*^9, 
  3.826645888481329*^9}},ExpressionUUID->"50b530a1-44e3-43c9-a7f4-\
1b9d646b3bdb"],

Cell["and by the definition of degeneracy", "ExpositoryText",
 CellChangeTimes->{{3.826645900200466*^9, 
