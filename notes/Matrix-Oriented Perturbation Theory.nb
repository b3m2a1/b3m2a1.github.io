Cell[BoxData[
 FormBox[
  RowBox[{"Given", " ", "a", " ", "swap", " ", 
   SuperscriptBox[
    StyleBox["A",
     FontWeight->"Bold"], 
    RowBox[{"n", "\[Rule]", "m"}]], " ", "and", " ", "a", " ", "single", " ", 
   "cordinate", " ", 
   StyleBox["x",
    FontSlant->"Italic"], " "}], TraditionalForm]], "ExpositoryMath",
 CellChangeTimes->{{3.7927982288484793`*^9, 3.792798281525384*^9}, {
