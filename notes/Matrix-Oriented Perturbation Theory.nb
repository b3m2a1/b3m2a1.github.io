          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", 
               RowBox[{"k", "+", "j"}], ")"}]]},
           "Ket"]}]}]}], "+", 
       RowBox[{
        SubscriptBox["P", 
         SuperscriptBox["D", 
          RowBox[{"(", 
           RowBox[{"a", "-", "1"}], ")"}]]], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"i", "=", "0"}], 
          RowBox[{"k", "-", "1"}]], 
         RowBox[{
          SuperscriptBox["\[CapitalDelta]H", 
           RowBox[{"(", 
            RowBox[{"k", "+", "a", "-", "i"}], ")"}]], 
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "i", ")"}]]},
           "Ket"]}]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        SubscriptBox["P", 
         SuperscriptBox["D", 
          RowBox[{"(", 
           RowBox[{"a", "-", "1"}], ")"}]]], 
        SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
         RowBox[{"(", "a", ")"}]], 
        SubscriptBox["P", 
         SuperscriptBox["D", 
          RowBox[{"(", 
           RowBox[{"a", "-", "1"}], ")"}]]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "k", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        SubscriptBox["P", 
         SuperscriptBox["D", 
          RowBox[{"(", 
           RowBox[{"a", "-", "1"}], ")"}]]], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"j", "=", "0"}], "a"], 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"i", "=", "0"}], 
           RowBox[{"k", "-", "1"}]], 
          RowBox[{
           SubsuperscriptBox["J", "a", 
            RowBox[{"(", "j", ")"}]], 
           SubsuperscriptBox["\[CapitalDelta]H", "n", 
            RowBox[{"(", 
             RowBox[{"k", "+", "a", "-", "j", "-", "i"}], ")"}]], 
           TemplateBox[{
             SuperscriptBox["n", 
              RowBox[{"(", "i", ")"}]]},
            "Ket"]}]}]}]}]}]}]}
