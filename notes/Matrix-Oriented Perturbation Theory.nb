Cell[TextData[{
 "We can compare this to the model that we get for the pure position \
operations which differs only in the sign flip, adding in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{"a", "+", "b"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "a161f346-63f4-4e63-a487-331dd719e015"],
 " term for foreshadowing, we have"
}], "Text",
 CellChangeTimes->{{3.891255690452322*^9, 3.89125579816409*^9}, {
  3.8912579432353983`*^9, 
  3.891257963864843*^9}},ExpressionUUID->"32b09fb6-63b3-411b-a598-\
41ca6f7a89bc"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["h", "\[Omega]", 
     RowBox[{"(", "k", ")"}]], "(", 
    RowBox[{"a", ",", " ", "b"}], ")"}], " ", "=", " ", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"(", 
      RowBox[{"a", "+", "b"}], ")"}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"b", "\[VeryThinSpace]", 
       RowBox[{
        SubsuperscriptBox["h", "\[Omega]", 
         RowBox[{"(", 
          RowBox[{"k", "-", "1"}], ")"}]], "(", 
        RowBox[{"a", ",", " ", 
         RowBox[{"b", "-", "1"}]}], ")"}]}], "+", 
      RowBox[{
       FractionBox[
        RowBox[{"2", 
         RowBox[{"b", "\[VeryThinSpace]", "(", 
          RowBox[{"a", "-", "\[Omega]", "+", "1"}], ")"}], 
         "\[InvisibleSpace]"}], "\[Omega]"], 
       RowBox[{
        SubsuperscriptBox["h", 
         RowBox[{"\[Omega]", "-", "1"}], 
         RowBox[{"(", 
          RowBox[{"k", "-", "1"}], ")"}]], "(", 
        RowBox[{"a", ",", " ", 
         RowBox[{"b", "-", "1"}]}], ")"}]}], "+", 
      RowBox[{"a", "\[VeryThinSpace]", 
       RowBox[{
        SubsuperscriptBox["h", "\[Omega]", 
         RowBox[{"(", 
          RowBox[{"k", "-", "1"}], ")"}]], "(", 
        RowBox[{
         RowBox[{"a", "-", "1"}], ",", " ", "b"}], ")"}]}]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8912557763023643`*^9, 3.891255818406126*^9}, {
  3.891257936342717*^9, 
