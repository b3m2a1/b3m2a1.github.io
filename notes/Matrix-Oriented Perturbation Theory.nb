Cell[CellGroupData[{

Cell["\<\
A Generic Algorithm for the Transformation of G-Matrix Derivatives\
\>", "Subsection",
 CellChangeTimes->{{3.92168608600592*^9, 
  3.9216861193166113`*^9}},ExpressionUUID->"066e7163-38c0-4115-b866-\
24ac672d6eb9"],

Cell[TextData[{
 "We begin by noting that given the ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "5f8f9e0a-64d0-4a0b-b7d0-e09ed2e342cb"],
 "-matrix in terms of a set of coordinates, ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "151047a5-f423-4617-a73a-df9f019a1c50"],
 ", it may be re-expressed in any set of coordinates, ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "021084b3-eb60-4b53-8d43-788e691c5a81"],
 ", by writing"
}], "ExpositoryText",
 CellChangeTimes->{{3.9216861257010193`*^9, 
  3.921686198897662*^9}},ExpressionUUID->"cf54fae6-db7d-4c9a-bc75-\
f5c8290b9092"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["G", "Q"], " ", "=", " ", 
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Del]", "R"], "Q"}], ")"}], 
     RowBox[{"a", "\[InvisibleSpace]", "i"}]], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Del]", "R"], "Q"}], ")"}], 
     RowBox[{"b", "\[InvisibleSpace]", "j"}]], 
    SubscriptBox[
     RowBox[{"(", 
      SubscriptBox["G", "R"], ")"}], 
     RowBox[{"a", "\[InvisibleSpace]", "b"}]]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9216861605364103`*^9, 3.921686161715672*^9}, {
  3.9216862013649673`*^9, 3.92168625346535*^9}, {3.921686317715289*^9, 
  3.921686322805007*^9}},ExpressionUUID->"7f52a2ed-9dd9-4b3e-9887-\
ba977d2e0928"],

Cell["or in basic matrix notation", "ExpositoryText",
 CellChangeTimes->{{3.921686326848731*^9, 
  3.921686337587352*^9}},ExpressionUUID->"9ff67b14-a335-4c3c-9ac1-\
68e021f2553d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["G", "Q"], " ", "=", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Del]", "R"], "Q"}], ")"}], "T"], "\[InvisibleSpace]", 
    RowBox[{"(", 
     SubscriptBox["G", "R"], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Del]", "R"], "Q"}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.92168634135639*^9, 
  3.921686384663307*^9}},ExpressionUUID->"f065acd6-ee68-4ad0-b691-\
6ed129fb6e5a"],

Cell["We will find it convenient to write", "ExpositoryText",
 CellChangeTimes->{{3.921686553315358*^9, 
  3.921686559438512*^9}},ExpressionUUID->"ba0076f4-46ae-4353-bb4e-\
23781619e734"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["R", "n"]], "Q"}], " ", "=", " ", 
      SuperscriptBox["R", 
       RowBox[{"(", "n", ")"}]]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["Q", "k"]], "R"}], " ", "=", " ", 
      SuperscriptBox["Q", 
       RowBox[{"(", "k", ")"}]]}]},
    {
     RowBox[{
      SuperscriptBox["\[CapitalGamma]", 
       RowBox[{"(", "m", ")"}]], " ", "=", " ", 
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["Q", "m"]], 
       SubscriptBox["G", "Q"]}]}]},
    {
     RowBox[{
      SuperscriptBox["G", 
       RowBox[{"(", "m", ")"}]], " ", "=", " ", 
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["R", "m"]], 
       SubscriptBox["G", "R"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9216865604382477`*^9, 3.921686612745851*^9}, {
  3.921686703988296*^9, 
  3.921686712563163*^9}},ExpressionUUID->"d2dfede6-ebc3-4772-907e-\
e89e07854d3b"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox["G", 
       RowBox[{"(", "1", ")"}]], " ", "=", " ", 
      RowBox[{
       SubscriptBox["\[Del]", "R"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"[", 
          RowBox[{
           SubscriptBox["R", 
            RowBox[{"a", "\[InvisibleSpace]", "i"}]], 
           SubscriptBox["R", 
            RowBox[{"b", "\[InvisibleSpace]", "j"}]]}], "]"}], "[", 
         SubsuperscriptBox["G", 
          RowBox[{"a", "\[InvisibleSpace]", "b"}], "0"], "]"}], ")"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SubscriptBox[
        RowBox[{
         RowBox[{"[", 
          RowBox[{
           SubsuperscriptBox["R", 
            RowBox[{"x", "\[InvisibleSpace]", "a", "\[InvisibleSpace]", "i"}],
             "1"], 
           SubscriptBox["R", 
            RowBox[{"b", "\[InvisibleSpace]", "j"}]]}], "]"}], "[", 
         SubsuperscriptBox["G", 
          RowBox[{"a", "\[InvisibleSpace]", "b"}], "0"], "]"}], 
        RowBox[{"x", "(", 
         RowBox[{
          RowBox[{"i", "\[InvisibleSpace]", "j"}], "+", 
          RowBox[{"j", "\[InvisibleSpace]", "i"}]}], ")"}]], " ", "+", " ", 
       SubscriptBox[
        RowBox[{
         RowBox[{"[", 
          RowBox[{
           SubscriptBox["R", 
            RowBox[{"a", "\[InvisibleSpace]", "i"}]], 
           SubscriptBox["R", 
            RowBox[{"b", "\[InvisibleSpace]", "j"}]]}], "]"}], "[", 
         SubsuperscriptBox["G", 
          RowBox[{"x", "\[InvisibleSpace]", "a", "\[InvisibleSpace]", "b"}], 
          "1"], "]"}], 
        RowBox[{"x", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "j"}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.926243509843288*^9, 3.926243588079767*^9}, {
  3.926243636267366*^9, 
  3.926243657167857*^9}},ExpressionUUID->"d62a2763-cd75-4e2b-a866-\
bae33b0d3a91"],

Cell["\<\
and with this in hand we\[CloseCurlyQuote]ll enumerate a few terms to see the \
patterns\
\>", "ExpositoryText",
