Cell["\<\
This is already bad for studying the entire space of highly-excited \
vibrations. On the other hand, we\[CloseCurlyQuote]re mostly interested in \
vibrations that put up to two quanta in given modes, and especially up to two \
quanta in modes we care about.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.811760783564248*^9, 3.8117608195220613`*^9}, {
  3.81176238434614*^9, 
  3.8117624315008698`*^9}},ExpressionUUID->"b52bc23a-1b24-4de8-8f9b-\
89c0fbb2ee71"],

Cell["\<\
To that effect, rather than computing our Hamiltonian elements in the total \
set of possibly-coupled states, we\[CloseCurlyQuote]d like to take a set of \
initial states of interest and generate the space of states that really do \
couple to those ones. To generate this space, we need to understand how our \
zero-order transform under application of our perturbations. We\
\[CloseCurlyQuote]ll do this with the harmonic Hamiltonian that we\
\[CloseCurlyQuote]re mostly to want to use, but the ideas apply to any \
initial basis you might care about.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8117626882353487`*^9, 3.811762743711316*^9}, {
   3.8117628280652323`*^9, 3.811762860857646*^9}, 3.811762946800452*^9, {
   3.811763026252287*^9, 
   3.811763158525823*^9}},ExpressionUUID->"95fb4ef2-155c-4081-bc67-\
ca5e6d94426b"],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  SuperscriptBox["H", 
   RowBox[{"(", "1", ")"}]], 
  TraditionalForm]],ExpressionUUID->"c16e25b7-3d4c-439c-8b9e-691f6f536409"]], \
"Subsubsection",
 CellChangeTimes->{{3.811765229353528*^9, 
  3.8117652614209127`*^9}},ExpressionUUID->"38633b16-f47c-4fb9-9d9a-\
c572748c6409"],

Cell[TextData[{
 "By assumption, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "0", ")"}]], TraditionalForm]],ExpressionUUID->
  "925da952-ae63-4d74-8690-cd337e2a219b"],
 " is diagonal, so first we\[CloseCurlyQuote]ll focus in on ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],ExpressionUUID->
  "6a1a5961-4929-49d3-8ff8-b317cea78f68"],
 " where we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.811763172255664*^9, 3.811763191113123*^9}, {
  3.811763250087647*^9, 3.811763253377205*^9}, {3.811763787713942*^9, 
  3.81176378851527*^9}},ExpressionUUID->"8342ffa0-65ef-47fe-b1ce-\
a21c53bc4502"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "Q"], "G"}], "\[CircleDot]", "p"}], 
     "\[InvisibleSpace]", "Q", "\[InvisibleSpace]", "p"}], "+", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "Q"], "F"}], "\[CircleDot]", "Q"}], 
     "\[InvisibleSpace]", "Q", "\[InvisibleSpace]", "Q"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8117632548087797`*^9, 3.8117632901965513`*^9}, {
  3.8117634118331003`*^9, 
  3.8117634151499233`*^9}},ExpressionUUID->"ff395049-39ba-4174-aef8-\
725616c57a50"],

Cell["and now if we stick any two states in there we have", "ExpositoryText",
 CellChangeTimes->{{3.811763294027405*^9, 
  3.8117633276394167`*^9}},ExpressionUUID->"a5be9df9-ceae-4baa-b148-\
8cd409379c87"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      RowBox[{
        SubscriptBox["n", "1"], ",", " ", 
        SubscriptBox["n", "2"], ",", " ", "..."}]},
     "Bra"], 
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], 
    TemplateBox[{
      RowBox[{
        SubscriptBox["m", "1"], ",", " ", 
        SubscriptBox["m", "2"], ",", " ", "..."}]},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "Q"], "G"}], "\[CircleDot]", 
      TemplateBox[{
        RowBox[{
          SubscriptBox["n", "1"], ",", " ", 
          SubscriptBox["n", "2"], ",", " ", "..."}]},
       "Bra"]}], "p", "\[InvisibleSpace]", "Q", "\[InvisibleSpace]", "p", 
     TemplateBox[{
       RowBox[{
         SubscriptBox["m", "1"], ",", " ", 
         SubscriptBox["m", "2"], ",", " ", "..."}]},
      "Ket"]}], "+", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "Q"], "F"}], "\[CircleDot]", 
      TemplateBox[{
        RowBox[{
          SubscriptBox["n", "1"], ",", " ", 
          SubscriptBox["n", "2"], ",", " ", "..."}]},
       "Bra"]}], "Q", "\[InvisibleSpace]", "Q", "\[InvisibleSpace]", "Q", 
     TemplateBox[{
       RowBox[{
         SubscriptBox["m", "1"], ",", " ", 
         SubscriptBox["m", "2"], ",", " ", "..."}]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811763329083808*^9, 
  3.811763420525474*^9}},ExpressionUUID->"c20a3c28-6031-4757-9f4e-\
3eeacaaa49c5"],

Cell["and now we have to deal with the terms that look like", "ExpositoryText",
 CellChangeTimes->{{3.8117634382195797`*^9, 3.811763453298491*^9}, {
  3.811763515358738*^9, 3.811763536995384*^9}, {3.8117635799372463`*^9, 
  3.811763586119153*^9}},ExpressionUUID->"c7f3a272-94c5-43a0-8e4c-\
f9421d707988"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         RowBox[{
           SubscriptBox["n", "1"], ",", " ", 
           SubscriptBox["n", "2"], ",", " ", "..."}]},
        "Bra"], 
       SubscriptBox["p", "i"], "\[InvisibleSpace]", 
       SubscriptBox["Q", "j"], "\[InvisibleSpace]", 
       SubscriptBox["p", "k"], 
       TemplateBox[{
         RowBox[{
           SubscriptBox["m", "1"], ",", " ", 
           SubscriptBox["m", "2"], ",", " ", "..."}]},
        "Ket"]}], "=", 
      RowBox[{
       TemplateBox[{
         RowBox[{
           SubscriptBox["n", "i"], ",", " ", 
           SubscriptBox["n", "j"], ",", " ", 
           SubscriptBox["n", "k"]}]},
        "Bra"], 
       SubscriptBox["p", "i"], "\[InvisibleSpace]", 
       SubscriptBox["Q", "j"], "\[InvisibleSpace]", 
       SubscriptBox["p", "k"], 
       TemplateBox[{
         RowBox[{
           SubscriptBox["m", "i"], ",", " ", 
           SubscriptBox["m", "j"], ",", " ", 
           SubscriptBox["m", "k"]}]},
        "Ket"], 
       TemplateBox[{
         RowBox[{
           RowBox[{"{", 
             SubscriptBox["n", "l"], "}"}], "\[Backslash]", 
           RowBox[{"{", 
             RowBox[{"i", ",", " ", "j", ",", " ", "k"}], "}"}], 
           "\[VeryThinSpace]"}], 
         RowBox[{" ", 
           RowBox[{
             RowBox[{"{", 
               SubscriptBox["m", "l"], "}"}], "\[Backslash]", 
             RowBox[{"{", 
               RowBox[{"i", ",", " ", "j", ",", " ", "k"}], "}"}]}]}]},
        "BraKet"]}]}]},
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         RowBox[{
           SubscriptBox["n", "1"], ",", " ", 
           SubscriptBox["n", "2"], ",", " ", "..."}]},
        "Bra"], 
       SubscriptBox["Q", "i"], "\[InvisibleSpace]", 
       SubscriptBox["Q", "j"], "\[InvisibleSpace]", 
       SubscriptBox["Q", "k"], 
       TemplateBox[{
         RowBox[{
           SubscriptBox["m", "1"], ",", " ", 
           SubscriptBox["m", "2"], ",", " ", "..."}]},
        "Ket"]}], "=", 
      RowBox[{
       TemplateBox[{
         RowBox[{
           SubscriptBox["n", "i"], ",", " ", 
           SubscriptBox["n", "j"], ",", " ", 
           SubscriptBox["n", "k"]}]},
        "Bra"], 
       SubscriptBox["Q", "i"], "\[InvisibleSpace]", 
       SubscriptBox["Q", "j"], "\[InvisibleSpace]", 
       SubscriptBox["Q", "k"], 
       TemplateBox[{
         RowBox[{
           SubscriptBox["m", "i"], ",", " ", 
           SubscriptBox["m", "j"], ",", " ", 
           SubscriptBox["m", "k"]}]},
        "Ket"], 
       TemplateBox[{
         RowBox[{
           RowBox[{"{", 
             SubscriptBox["n", "l"], "}"}], "\[Backslash]", 
           RowBox[{"{", 
             RowBox[{"i", ",", " ", "j", ",", " ", "k"}], "}"}], 
           "\[VeryThinSpace]"}], 
         RowBox[{" ", 
           RowBox[{
             RowBox[{"{", 
               SubscriptBox["m", "l"], "}"}], "\[Backslash]", 
             RowBox[{"{", 
               RowBox[{"i", ",", " ", "j", ",", " ", "k"}], "}"}]}]}]},
        "BraKet"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811763455086947*^9, 3.811763510621833*^9}, {
  3.811763560024541*^9, 
  3.811763779628681*^9}},ExpressionUUID->"3804d0f0-19bf-46be-9fe7-\
ae51fb9f77ad"],

Cell["the overlap term is just a big pile of delta functions", \
"ExpositoryText",
 CellChangeTimes->{{3.811763781243497*^9, 
  3.811763811198048*^9}},ExpressionUUID->"d15d3a94-3456-4e7a-95cb-\
c9f93a2bb187"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     RowBox[{
       RowBox[{"{", 
         SubscriptBox["n", "l"], "}"}], "\[Backslash]", 
       RowBox[{"{", 
         RowBox[{"i", ",", " ", "j", ",", " ", "k"}], "}"}], 
       "\[VeryThinSpace]"}], 
     RowBox[{" ", 
       RowBox[{
         RowBox[{"{", 
           SubscriptBox["m", "l"], "}"}], "\[Backslash]", 
         RowBox[{"{", 
           RowBox[{"i", ",", " ", "j", ",", " ", "k"}], "}"}]}]}]},
    "BraKet"], "=", 
   RowBox[{
    UnderscriptBox["\[Product]", 
     RowBox[{"\[Alpha]", "\[NotElement]", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", 
        RowBox[{"j", " ", "k"}]}], "}"}]}]], " ", 
    SubscriptBox["\[Delta]", 
     RowBox[{
      SubscriptBox["n", "\[Alpha]"], 
      SubscriptBox["m", "\[Alpha]"]}]]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811763801555717*^9, 
  3.811763858770939*^9}},ExpressionUUID->"2904a070-f727-4edd-8cf2-\
8ea6811b1632"],

Cell[TextData[{
 "and so we can clearly only ever change ",
 StyleBox["at most",
  FontSlant->"Italic"],
 " three indices at once through ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],ExpressionUUID->
  "14a5841b-9d12-4311-960c-ac7bc519774b"],
 ". "
}], "ExpositoryText",
 CellChangeTimes->{{3.8117638676607428`*^9, 3.8117639222548122`*^9}, 
   3.811764064073999*^9},ExpressionUUID->"f38bcd00-b83e-45f7-bce0-\
1e60fe5d0077"],

Cell[TextData[{
 "Next we need to consider the three cases for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"i", ",", " ", "j", ",", " ", "k"}], "}"}], TraditionalForm]],
  ExpressionUUID->"c5487a33-a9b1-4d58-9fe7-9c3ab2e754f8"]
}], "ExpositoryText",
 CellChangeTimes->{{3.8117638676607428`*^9, 3.8117639222548122`*^9}, {
  3.8117640659748077`*^9, 
  3.8117640789097967`*^9}},ExpressionUUID->"5b0d8801-9fcb-4831-a520-\
4f47313f242f"],

Cell[CellGroupData[{

Cell[TextData[{
 "Case 1: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "=", 
    RowBox[{"j", "=", "k"}]}], TraditionalForm]],ExpressionUUID->
  "827fd681-c378-42d7-bb0a-96fcb8108023"]
}], "Subsubsubsection",
 CellChangeTimes->{{3.8117640816544037`*^9, 
  3.8117640899908657`*^9}},ExpressionUUID->"69a45074-b3a5-4e38-aa83-\
241b74b707d1"],

Cell["\<\
This is the simplest case, where we\[CloseCurlyQuote]ve got the same index \
three times. From our \[Delta] terms, this means we can only change one mode. \
Constructing our raising/lower representation of the operators we have\
\>", "ExpositoryText",
 CellChangeTimes->{{3.811764095380043*^9, 3.811764127994836*^9}, {
  3.811764189644112*^9, 3.811764210873218*^9}, {3.811764437407117*^9, 
  3.811764499599524*^9}},ExpressionUUID->"2f5c6a0d-ae74-4c87-9619-\
5bffc3f1772e"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["p", "i"], "\[InvisibleSpace]", 
       SubscriptBox["Q", "i"], "\[InvisibleSpace]", 
       SubscriptBox["p", "i"]}], "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["a", "i"], "-", 
         SubsuperscriptBox["a", "i", "\[Dagger]"]}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["a", "i"], "+", 
         SubsuperscriptBox["a", "i", "\[Dagger]"]}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["a", "i"], "-", 
         SubsuperscriptBox["a", "i", "\[Dagger]"]}], ")"}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["a", "i"], "-", 
         SubsuperscriptBox["a", "i", "\[Dagger]"]}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["a", "i"], 
          SubscriptBox["a", "i"]}], "+", 
         RowBox[{
          SubsuperscriptBox["a", "i", "\[Dagger]"], 
          SubscriptBox["a", "i"]}], "-", 
         RowBox[{
          SubsuperscriptBox["a", "i", "\[Dagger]"], 
          SubsuperscriptBox["a", "i", "\[Dagger]"]}]}], ")"}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        SubscriptBox["a", "i"], 
        SubscriptBox["a", "i"], 
        SubscriptBox["a", "i"]}], "-", 
       RowBox[{
        SubsuperscriptBox["a", "i", "\[Dagger]"], 
        SubscriptBox["a", "i"], 
        SubscriptBox["a", "i"]}], "-", 
       RowBox[{
        SubsuperscriptBox["a", "i", "\[Dagger]"], 
        SubsuperscriptBox["a", "i", "\[Dagger]"], 
        SubscriptBox["a", "i"]}], "+", 
       RowBox[{
        SubsuperscriptBox["a", "i", "\[Dagger]"], 
        SubsuperscriptBox["a", "i", "\[Dagger]"], 
        SubsuperscriptBox["a", "i", "\[Dagger]"]}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["Q", "i"], "\[InvisibleSpace]", 
       SubscriptBox["Q", "i"], "\[InvisibleSpace]", 
       SubscriptBox["Q", "i"]}], "=", 
      RowBox[{
       RowBox[{
        SubscriptBox["a", "i"], 
        SubscriptBox["a", "i"], 
        SubscriptBox["a", "i"]}], "+", 
       RowBox[{
        SubsuperscriptBox["a", "i", "\[Dagger]"], 
        SubscriptBox["a", "i"], 
        SubscriptBox["a", "i"]}], "+", 
       RowBox[{
        SubsuperscriptBox["a", "i", "\[Dagger]"], 
        SubsuperscriptBox["a", "i", "\[Dagger]"], 
        SubscriptBox["a", "i"]}], "+", 
       RowBox[{
        SubsuperscriptBox["a", "i", "\[Dagger]"], 
        SubsuperscriptBox["a", "i", "\[Dagger]"], 
        SubsuperscriptBox["a", "i", "\[Dagger]"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811764502328965*^9, 3.811764522017395*^9}, {
  3.811764628983981*^9, 3.8117646569388447`*^9}, {3.8117646956992407`*^9, 
  3.811764704534732*^9}, {3.811764740941201*^9, 
  3.811764862077702*^9}},ExpressionUUID->"c33642e1-5308-421c-b83c-\
64a5380f4e61"],

Cell["\<\
which means we can raise/lower our quanta by one or three through this \
operator\
\>", "ExpositoryText",
 CellChangeTimes->{{3.811764834855125*^9, 
  3.811764892982484*^9}},ExpressionUUID->"3ee95a28-103b-4b43-9ab5-\
34170e0b2e11"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Case 2: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"i", "\[NotEqual]", "j"}], "=", "k"}], TraditionalForm]],
  ExpressionUUID->"b959b51f-5561-4892-aad3-e07e61b549ef"]
}], "Subsubsubsection",
 CellChangeTimes->{{3.8117640816544037`*^9, 3.8117640899908657`*^9}, {
  3.811764993639592*^9, 
  3.8117650024977837`*^9}},ExpressionUUID->"bd98e8a3-c4d7-4db1-9432-\
f3e911335d44"],

Cell["\<\
In this case, we can change up to two modes. Constructing our raising/lower \
representation of the operators we have a few different flavors, based on the \
different permutations we of the indices we can do, but \
we\[CloseCurlyQuote]ll focus on \
\>", "ExpositoryText",
 CellChangeTimes->{{3.811764095380043*^9, 3.811764127994836*^9}, {
  3.811764189644112*^9, 3.811764210873218*^9}, {3.811764437407117*^9, 
  3.811764499599524*^9}, {3.811765009853471*^9, 
  3.811765066863605*^9}},ExpressionUUID->"af30fea8-badb-46bc-b548-\
082e8d35aadd"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["Q", "i"], "\[InvisibleSpace]", 
       SubscriptBox["Q", "j"], "\[InvisibleSpace]", 
       SubscriptBox["Q", "j"]}], "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["a", "i"], "+", 
         SubsuperscriptBox["a", "i", "\[Dagger]"]}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["a", "j"], "+", 
         SubsuperscriptBox["a", "j", "\[Dagger]"]}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["a", "j"], "+", 
         SubsuperscriptBox["a", "j", "\[Dagger]"]}], ")"}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["a", "i"], "+", 
         SubsuperscriptBox["a", "i", "\[Dagger]"]}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["a", "j"], 
          SubscriptBox["a", "j"]}], "+", 
         RowBox[{
          SubsuperscriptBox["a", "j", "\[Dagger]"], 
          SubscriptBox["a", "j"]}], "+", 
         RowBox[{
          SubsuperscriptBox["a", "j", "\[Dagger]"], 
          SubsuperscriptBox["a", "j", "\[Dagger]"]}]}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8117650680475903`*^9, 
  3.811765122707082*^9}},ExpressionUUID->"a5be7831-266a-43b9-83d0-\
79feec8304c8"],

Cell["\<\
and from this we can change one mode by up to 2 and another mode by one\
\>", "ExpositoryText",
 CellChangeTimes->{{3.811764834855125*^9, 3.811764892982484*^9}, {
  3.8117651263269672`*^9, 
  3.811765148286346*^9}},ExpressionUUID->"4b5cf3e1-bdd2-462a-8f91-\
9ef8136a111b"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Case 3: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "\[NotEqual]", "j", "\[NotEqual]", "k"}], TraditionalForm]],
  ExpressionUUID->"98cb3969-e0e0-41cc-8313-8735bdffa22f"]
}], "Subsubsubsection",
 CellChangeTimes->{{3.8117640816544037`*^9, 3.8117640899908657`*^9}, {
  3.811764993639592*^9, 3.8117650024977837`*^9}, {3.811765154807322*^9, 
  3.811765159232294*^9}},ExpressionUUID->"def8dfdc-ef60-47f2-8286-\
83f002796fe2"],

Cell["\<\
We\[CloseCurlyQuote]re just gonna jump ahead to the punch-line and leave \
working it out to the reader. We can change three modes at a time and each \
mode can change by one quantum.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.811765160896454*^9, 
  3.811765210127771*^9}},ExpressionUUID->"396b1081-62e5-421c-866d-\
cd14cdf903da"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  SuperscriptBox["H", 
   RowBox[{"(", "2", ")"}]], 
  TraditionalForm]],ExpressionUUID->"b2a12696-bb39-409b-aaf9-6ba3957a96c6"]], \
"Subsubsection",
 CellChangeTimes->{{3.811765229353528*^9, 
  3.8117652548461857`*^9}},ExpressionUUID->"17f9b051-8b1f-4d6c-967c-\
4ebaca64a75b"],

Cell["We\[CloseCurlyQuote]ll recall ", "ExpositoryText",
 CellChangeTimes->{{3.811765264997242*^9, 
  3.811765270880727*^9}},ExpressionUUID->"ecbb580b-103a-43d5-822d-\
5fc982b290ae"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["Q", "2"]], "G"}], "\[CircleDot]", "p"}], "\[InvisibleSpace]\[InvisibleSpace]",
      "Q", "\[InvisibleSpace]", "Q", "\[InvisibleSpace]", "p"}], "+", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["Q", "2"]], "F"}], "\[CircleDot]", "Q"}], 
     "\[InvisibleSpace]", "Q", "\[InvisibleSpace]", "Q", "\[InvisibleSpace]", 
     "Q"}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8117632548087797`*^9, 3.8117632901965513`*^9}, {
  3.8117634118331003`*^9, 3.8117634151499233`*^9}, {3.811765278724126*^9, 
  3.811765294150537*^9}},ExpressionUUID->"70b4237a-9923-4ddb-ae92-\
f48cdc3185b6"],

Cell["\<\
this will allow things to change by up to 4 quanta in up to 4 modes.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.811765388138981*^9, 3.811765399748641*^9}, {
  3.8117659888610477`*^9, 3.811765991647016*^9}, {3.811766292470624*^9, 
  3.81176630854002*^9}, {3.811766368909477*^9, 
  3.811766369141178*^9}},ExpressionUUID->"7746890c-1ec5-470a-a9a4-\
007bc350bf44"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Orthogonality", "Subsection",
 CellChangeTimes->{{3.82372561971406*^9, 
  3.8237256252196007`*^9}},ExpressionUUID->"57d8c105-de5a-461a-a91d-\
9251fa9735b6"],

Cell[TextData[{
 "When we have an operator like ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Q", "i"], "\[InvisibleSpace]", 
    SubscriptBox["Q", "j"], "\[InvisibleSpace]"}], TraditionalForm]],
  CellChangeTimes->{{3.8117650680475903`*^9, 3.811765122707082*^9}},
  ExpressionUUID->"d5a3ecda-617b-4585-817d-dcf5b364353e"],
 ", any modes ",
 StyleBox["not",
  FontSlant->"Italic"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["q", "i"], ",", " ", 
     SubscriptBox["q", "j"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "eba14ce3-5756-44a0-b992-7fde28484026"],
 " are unaffected by its operation, so if e.g. if we have a set of modes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["q", "a"], ",", " ", 
    SubscriptBox["q", "b"], ",", " ", 
    SubscriptBox["q", "c"], ",", " ", 
    SubscriptBox["q", "d"]}], TraditionalForm]],ExpressionUUID->
  "e8dcb1e9-9dba-4d75-bb03-b29246b98b85"],
 " and want to know if two states ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{
       SubscriptBox["n", "a"], ",", " ", 
       SubscriptBox["n", "b"], ",", " ", 
       SubscriptBox["n", "c"], ",", " ", 
       SubscriptBox["n", "d"]}]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "3a20a8cd-35f9-4db2-a87b-329c5a3c7174"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{
       SubscriptBox["m", "a"], ",", " ", 
       SubscriptBox["m", "b"], ",", " ", 
       SubscriptBox["m", "c"], ",", " ", 
       SubscriptBox["m", "d"]}]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "34051491-41f7-4a5d-b2d1-4a84ec95deb8"],
 " are possibly coupled through the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Q", "b"], 
    SubscriptBox["Q", "c"]}], TraditionalForm]], "ExpositoryText",
  ExpressionUUID->"d11f6b7e-84f7-40de-ae74-d998f507be41"],
 " we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.823725627982831*^9, 3.823725738237907*^9}, {
  3.82372576913815*^9, 3.823725769944726*^9}, {3.823725801237627*^9, 
  3.823725851286292*^9}},ExpressionUUID->"622894f0-3eaa-41f4-a05e-\
2c5c1511ac22"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["n", "a"], "\[Equal]", 
    SubscriptBox["m", "a"]}], "&&", 
   RowBox[{
    SubscriptBox["n", "d"], "\[Equal]", 
    SubscriptBox["m", "d"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.823725853645277*^9, 
  3.823725886534037*^9}},ExpressionUUID->"d0575171-249a-4bc3-ad0c-\
efcee3ff594f"],

Cell[TextData[{
 "but now we also know we\[CloseCurlyQuote]ll need to check this for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Q", "b"], 
    SubscriptBox["Q", "d"]}], TraditionalForm]],ExpressionUUID->
  "e85ddbe6-4774-44df-97ca-19afe558f6a8"],
 "  and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Q", "a"], 
    SubscriptBox["Q", "b"]}], TraditionalForm]],ExpressionUUID->
  "09bf03b6-1583-4c0f-b1cb-02f7a47216a3"],
 ", etc. so if there\[CloseCurlyQuote]s a way to reuse information to compute \
fewer orthogonality checks that would pay dividends."
}], "ExpositoryText",
 CellChangeTimes->{{3.823725891431584*^9, 3.8237259245408573`*^9}, {
  3.823726012861958*^9, 
  3.823726048749007*^9}},ExpressionUUID->"09fdf3a2-0dee-4595-974c-\
16499c578eb2"],

Cell[TextData[{
 "To that effect, we\[CloseCurlyQuote]ll do a bunch of Boolean algebra. First \
we\[CloseCurlyQuote]ll assume we have set of states which \
we\[CloseCurlyQuote]ll denote by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "i", "}"}], TraditionalForm]],ExpressionUUID->
  "9176fa84-87b2-41ed-9c00-2e61d8ada15f"],
 ". Then we\[CloseCurlyQuote]ll assume we have an operator that couples \
states ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], TraditionalForm]],
  ExpressionUUID->"ae3756b8-cc84-427d-ba0f-829a8417b802"],
 " and write whether a state can couple through this operator as"
}], "ExpositoryText",
 InitializationCell->True,
 CellChangeTimes->{{3.823727584175148*^9, 3.82372766817356*^9}, {
  3.823727708400228*^9, 3.823727737656884*^9}, {3.8237277951005297`*^9, 
  3.823727812472831*^9}},ExpressionUUID->"2b230d4b-9883-4b73-b112-\
ac391e741015"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"C", "(", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ")"}], " ", "=", " ", 
   RowBox[{
    UnderscriptBox["\[And]", 
     RowBox[{"i", " ", "\[NotElement]", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}]], " ", 
    RowBox[{
     SubscriptBox["n", "i"], "\[Equal]", 
     SubscriptBox["m", "i"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.823727682152413*^9, 3.8237277012893667`*^9}, {
  3.823727740515788*^9, 
  3.823727791610815*^9}},ExpressionUUID->"7678b538-8a9c-47b2-aed3-\
89786037a0cd"],

Cell[TextData[{
 "next if we have an operator that couples states ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], 
   TraditionalForm]],ExpressionUUID->"ec67a0fc-7630-4ed3-81ea-9806a7c7837c"],
 " we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.82372781728507*^9, 3.823727835416971*^9}, {
  3.823727872899403*^9, 3.82372787405787*^9}, {3.823727917656377*^9, 
  3.8237279179740877`*^9}},ExpressionUUID->"e33902f3-d78c-488e-959c-\
b106d131ff24"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"C", "(", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ")"}],
    " ", "=", " ", 
   RowBox[{
    UnderscriptBox["\[And]", 
     RowBox[{"i", " ", "\[NotElement]", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}]}]], 
    " ", 
    RowBox[{
     SubscriptBox["n", "i"], "\[Equal]", 
     SubscriptBox["m", "i"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.823727876021531*^9, 3.823727881343207*^9}, {
  3.823727919382092*^9, 
  3.823727922096023*^9}},ExpressionUUID->"7f4a2993-2350-4743-b091-\
91b5ea09ec36"],

Cell[TextData[{
 "and it would be nice to be able to express this in terms of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], TraditionalForm]],
  ExpressionUUID->"9de9fd01-ca3f-41c4-92d8-751d7c1f4d2d"],
 " if possible. "
}], "ExpositoryText",
 CellChangeTimes->{{3.82372788590196*^9, 
  3.823727950516419*^9}},ExpressionUUID->"aac8d893-42c9-41ef-b34d-\
8c603526f7b8"],

Cell["For that, we can write", "ExpositoryText",
 CellChangeTimes->{{3.82372788590196*^9, 
  3.823727950024201*^9}},ExpressionUUID->"723726ac-27dd-424b-bdb0-\
43bc4953b39a"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"C", "(", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], 
       ")"}], " ", "=", 
      RowBox[{
       RowBox[{"(", " ", 
        RowBox[{
         UnderscriptBox["\[And]", 
          RowBox[{"i", " ", "\[NotElement]", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}]], " ", 
         RowBox[{
          SubscriptBox["n", "i"], "\[Equal]", 
          SubscriptBox["m", "i"]}]}], ")"}], " ", "\[Or]", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["n", "4"], "\[NotEqual]", 
          SubscriptBox["m", "4"]}], " ", "\[And]", " ", 
         RowBox[{"(", 
          RowBox[{
           UnderscriptBox["\[And]", 
            RowBox[{"i", " ", "\[NotElement]", " ", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], 
              "}"}]}]], " ", 
           RowBox[{
            SubscriptBox["n", "i"], "\[Equal]", 
            SubscriptBox["m", "i"]}]}], ")"}]}], ")"}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{"C", "(", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ")"}], "\[Or]", 
       " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["n", "4"], "\[NotEqual]", 
          SubscriptBox["m", "4"]}], " ", "\[And]", " ", 
         RowBox[{"(", 
          RowBox[{
           UnderscriptBox["\[And]", 
            RowBox[{"i", " ", "\[NotElement]", " ", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], 
              "}"}]}]], " ", 
           RowBox[{
            SubscriptBox["n", "i"], "\[Equal]", 
            SubscriptBox["m", "i"]}]}], ")"}]}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.823727948258856*^9, 3.823728050275003*^9}, {
  3.823728264229719*^9, 
  3.823728268889967*^9}},ExpressionUUID->"679de6c6-1f07-493a-9482-\
8baac3b6ea13"],

Cell[TextData[{
 "which works because we\[CloseCurlyQuote]ve now got both ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["n", "4"], "\[NotEqual]", 
    SubscriptBox["m", "4"]}], TraditionalForm]],ExpressionUUID->
  "8d627938-4962-4e55-8165-6a77b56e4951"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["n", "4"], "\[Equal]", 
    SubscriptBox["m", "4"]}], TraditionalForm]],ExpressionUUID->
  "40ef218a-1b60-49dc-bf67-a4e68b769429"],
 " accounted for. "
}], "ExpositoryText",
 CellChangeTimes->{{3.823728035248686*^9, 
  3.823728094406797*^9}},ExpressionUUID->"d8101d79-3ece-4d47-95ad-\
41aeeb5744ed"],

Cell[TextData[{
 "The problem is that this is ",
 StyleBox["more",
  FontSlant->"Italic"],
 " computationally expensive that just computing ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ")"}],
    TraditionalForm]],ExpressionUUID->
  "7ee398c1-0334-4f0c-aa3f-a580e3326497"],
 " directly, since you\[CloseCurlyQuote]ll notice that it includes ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ")"}],
    TraditionalForm]],ExpressionUUID->
  "827b94d6-71aa-4e07-9f83-a1bffd1a7beb"],
 " itself..."
}], "ExpositoryText",
 CellChangeTimes->{{3.823728035248686*^9, 3.8237281023048677`*^9}, {
  3.8237281447190638`*^9, 3.823728154864965*^9}, {3.8237281966844463`*^9, 
  3.8237282149368553`*^9}},ExpressionUUID->"160da99a-833e-4b49-8482-\
9028ec0c7204"],

Cell["\<\
We\[CloseCurlyQuote]re going to reexpress this, though, in terms of Boolean \
algebra in the hope that it will give us a better route forward. To that end, \
we\[CloseCurlyQuote]ll say\
\>", "ExpositoryText",
 CellChangeTimes->{{3.823728272666748*^9, 
  3.823728334861629*^9}},ExpressionUUID->"36c3c931-29ab-44d1-988a-\
a7042a4d69a2"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{"A", "=", 
      RowBox[{"C", "(", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], 
       ")"}]}]},
    {
     RowBox[{"B", "=", 
      RowBox[{"C", "(", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ")"}]}]},
    {
     RowBox[{"D", "=", 
      RowBox[{
       SubscriptBox["n", "4"], "\[NotEqual]", 
       SubscriptBox["m", "4"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.823728324924659*^9, 
  3.823728361877496*^9}},ExpressionUUID->"d71f969c-5af2-41ce-ab97-\
0d6affdafc4e"],

Cell["giving us", "ExpositoryText",
 CellChangeTimes->{{3.823729269357127*^9, 
  3.823729271933565*^9}},ExpressionUUID->"93100da9-65df-4bab-adfb-\
b22dd7e6c353"],

Cell[BoxData[
 FormBox[
  RowBox[{"A", "=", 
   RowBox[{"B", "\[Or]", 
    RowBox[{"(", 
     RowBox[{"D", "\[And]", "A"}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.823729273170154*^9, 
  3.823729288603512*^9}},ExpressionUUID->"34f5c1c5-9e4a-4386-8ff6-\
5c41f912266b"],

Cell["\<\
and then to have expressions that work in terms of 0 and 1 we write\
\>", "ExpositoryText",
 CellChangeTimes->{{3.823728392452115*^9, 3.823728394724255*^9}, {
  3.8237296534437523`*^9, 
  3.823729662454134*^9}},ExpressionUUID->"2f45d198-4863-4bc6-a5da-\
52764373a2c9"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"x", "\[And]", "y"}], "=", 
      RowBox[{"x", "\[InvisibleSpace]", "y"}]}]},
    {
     RowBox[{
      RowBox[{"x", "\[Or]", "y"}], "=", 
      RowBox[{"x", "+", "y", "-", 
       RowBox[{"x", "\[InvisibleSpace]", "y"}]}]}]},
    {
     RowBox[{
      RowBox[{"\[Not]", "x"}], "=", 
      RowBox[{"1", "-", "x"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.823728396239456*^9, 
  3.823728428973013*^9}},ExpressionUUID->"66031ed4-339e-4403-8be7-\
2d9f89805c99"],

Cell["which when applied to what we had before gives us", "ExpositoryText",
 CellChangeTimes->{{3.823728363253878*^9, 3.823728365130706*^9}, {
  3.823728433971963*^9, 
  3.823728439574926*^9}},ExpressionUUID->"a59f51aa-1c7b-4c82-8ad7-\
a1411a65ea2b"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{"A", "=", 
      RowBox[{"B", "+", 
       RowBox[{"D", "\[VeryThinSpace]", "A"}], "-", 
       RowBox[{
       "B", "\[InvisibleSpace]", "D", "\[InvisibleSpace]", "A"}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{"B", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "B"}], ")"}], "D", "\[VeryThinSpace]", "A"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.823728366276898*^9, 3.8237283889524307`*^9}, {
   3.8237284322285624`*^9, 3.8237284841541443`*^9}, {3.8237285300096197`*^9, 
   3.8237285611286917`*^9}, {3.8237287106471024`*^9, 3.823728728184577*^9}, 
   3.823822440613412*^9},ExpressionUUID->"5e2a73fb-9d22-4354-bc7f-\
31b9737c0d47"],

Cell[TextData[{
 "and we note from this that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"B", "=", 
    RowBox[{
     RowBox[{"1", " ", "\[Implies]", " ", "A"}], "=", "B"}]}], 
   TraditionalForm]],ExpressionUUID->"73f9821c-2b1a-4262-8823-d5abd8d88d7b"],
 " and similarly when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"B", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "a134f5c7-4b0b-4c22-90e3-351750da9506"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"D", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "0123b28c-65ed-41ca-9d9d-7807cbea8144"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "5174ab9a-a933-4ec5-b879-2d3c4648945a"],
 ", which just means we don\[CloseCurlyQuote]t need to calculate anything \
there. Finally, when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"B", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "dcccf5b8-f5b1-4ca0-b4b8-260cf1f68512"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"D", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "676914bf-4302-4e8d-82cd-543a1f4ac475"],
 " we get a tautology and so we need to just calculate ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "62618a25-e908-418d-bc93-aa5f47c94deb"],
 " directly in that case. OTOH this means we\[CloseCurlyQuote]ve cut down the \
amount of work we need to do pretty dramatically, since we only need to \
calculate things for the intersection of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Not]", "B"}], TraditionalForm]],ExpressionUUID->
  "09b12fb9-f253-447a-ad55-83f0eae7e77d"],
 " and ",
 Cell[BoxData[
  FormBox["D", TraditionalForm]],ExpressionUUID->
  "2e17bee4-c91c-4b42-914f-b267c0356475"],
 "."
}], "ExpositoryText",
 CellChangeTimes->{{3.823822443067128*^9, 3.8238224585027857`*^9}, {
