d40d13213f6a"],

Cell[TextData[{
 "Which we can express in terms of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "l"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "cd8ddcd7-e72c-4bda-814a-b177c6b93dcd"],
 " as [Note that I fucked with the expression a bit after checking against \
the code--RHS is fine] [Also note that this expression involving ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "2"], TraditionalForm]],
  CellChangeTimes->{{3.889465914002426*^9, 3.8894660400473833`*^9}, {
    3.8894660833195972`*^9, 3.889466143406452*^9}, {3.88946627962398*^9, 
