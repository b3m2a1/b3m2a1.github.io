Cell[TextData[{
 "we see that this is basically ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Delta]E", "n", 
      RowBox[{"(", "1", ")"}]], "[", 
     RowBox[{"U", ":", 
      SubsuperscriptBox["\[CapitalPi]", "n", 
       RowBox[{"(", "0", ")"}]], ":", "U"}], "]"}], 
    TemplateBox[{
      RowBox[{"T", ":", "\[VeryThinSpace]", 
        RowBox[{
          UnderoverscriptBox[
           RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}], 
           StyleBox["1", FontSize -> 14], "1"], 
          RowBox[{"(", 
            RowBox[{"k", "+", "1"}], ")"}]}]}]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "bccdd095-dcef-4a0d-996f-e63265fe9352"],
 " with the component along ",
 Cell[BoxData[
  FormBox["D", TraditionalForm]],ExpressionUUID->
  "114532f0-ce9b-4689-aa8e-c03f4e170b7c"],
 " factored out for the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "+", "1"}], TraditionalForm]],ExpressionUUID->
  "2860ebbf-3f92-4e05-9018-0a75a66dc98c"],
 " state and of course "
}], "ExpositoryText",
 CellChangeTimes->{{3.821582917965667*^9, 3.821582961982998*^9}, {
