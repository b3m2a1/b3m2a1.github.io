       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], 
       RowBox[{
        SubscriptBox["\[GothicCapitalC]", "n"], "(", 
        RowBox[{"M", ",", " ", "p", ",", " ", "t"}], ")"}], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       FractionBox["1", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubsuperscriptBox["E", "m", 
            RowBox[{"(", "0", ")"}]], "-", 
           SubsuperscriptBox["E", "n", 
            RowBox[{"(", "0", ")"}]]}], ")"}], 
         RowBox[{"count", "(", 
          RowBox[{"t", ",", "1"}], ")"}]]], 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], "(", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[GothicCapitalD]", "n"], "(", 
          RowBox[{"M", ",", " ", "p", ",", " ", "t"}], ")"}], 
         TemplateBox[{
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8277881645267067`*^9, 3.827788286804654*^9}, {
  3.827788707224998*^9, 
  3.827788759652714*^9}},ExpressionUUID->"a7bd3aac-4aa7-4d66-bb19-\
3f1e50e66f27"],

Cell["which gives us", "ExpositoryText",
 CellChangeTimes->{{3.827788827953453*^9, 3.827788830699839*^9}, {
  3.827788868367227*^9, 
  3.827788868550191*^9}},ExpressionUUID->"5fd4e259-3df7-4b0b-850b-\
3e7e982dea60"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], 
    RowBox[{
     SubscriptBox["\[GothicCapitalB]", "n"], "(", 
     RowBox[{"M", ",", " ", "p", ",", " ", "s"}], ")"}], 
    TemplateBox[{
      SuperscriptBox["m", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    TemplateBox[{
      RowBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]], " "}], 
      RowBox[{"\[VeryThinSpace] ", 
        SuperscriptBox["n", 
         RowBox[{"(", 
           SubscriptBox["p", "M"], ")"}]]}]},
     "BraKet"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], 
    RowBox[{
     SubscriptBox["\[GothicCapitalC]", "n"], "(", 
     RowBox[{
      RowBox[{"M", "-", "1"}], ",", " ", 
      RowBox[{"p", "[", 
       RowBox[{":", 
        RowBox[{"-", "1"}]}], "]"}], ",", " ", "s"}], ")"}], 
    TemplateBox[{
      SuperscriptBox["m", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.82778883477324*^9, 
  3.827788857100995*^9}},ExpressionUUID->"68ae6396-14bc-4a88-bc36-\
419ad8c8f66b"],

Cell["and so for whatever it\[CloseCurlyQuote]s worth we can write", \
"ExpositoryText",
 CellChangeTimes->{{3.827788876114849*^9, 
  3.827788919413085*^9}},ExpressionUUID->"6417d2dd-8513-4630-ba12-\
7722a672606e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["p",
       FontSize->14], "\[Element]", 
      StyleBox[
       SubsuperscriptBox["\[CapitalXi]", "k", "M"],
       FontSize->14]}]], 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["s",
        FontSize->14], "\[Element]", 
       StyleBox[
        SuperscriptBox["S", 
         RowBox[{"M", "-", "2"}]],
        FontSize->14]}]], 
     RowBox[{
      SubscriptBox["\[GothicCapitalB]", "n"], "(", 
      RowBox[{"M", ",", " ", "p", ",", " ", "s"}], ")"}]}]}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], 
     RowBox[{"k", "-", "1"}]], 
    RowBox[{
     TemplateBox[{
       RowBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]], " "}], 
       RowBox[{"\[VeryThinSpace] ", 
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]]}]},
      "BraKet"], 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{
        StyleBox["g",
         FontSize->14], "\[Element]", 
        StyleBox[
         SubsuperscriptBox["\[CapitalXi]", 
          RowBox[{"k", "-", "i"}], 
          RowBox[{"M", "-", "1"}]],
         FontSize->14]}]], 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{
         StyleBox["t",
          FontSize->14], "\[Element]", 
         StyleBox[
          SuperscriptBox["S", 
           RowBox[{"M", "-", "2"}]],
          FontSize->14]}]], 
       RowBox[{
        SubscriptBox["\[GothicCapitalC]", "n"], "(", 
        RowBox[{
         RowBox[{"M", "-", "1"}], ",", " ", "g", ",", " ", "t"}], 
        ")"}]}]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8277889127848997`*^9, 3.827789034581971*^9}, 
   3.8279286848593893`*^9},ExpressionUUID->"2fff622b-8b01-4a9a-be37-\
6876bab939ba"],

Cell[TextData[{
 "which should be no surprise given our other way of defining ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "n"], TraditionalForm]],ExpressionUUID->
  "e66c817a-8ae3-4f1f-8bf5-7191697348bd"],
 ", but which does let us write"
}], "ExpositoryText",
 CellChangeTimes->{{3.827789039782434*^9, 3.827789056215205*^9}, {
  3.8279284353502083`*^9, 
  3.8279284399319553`*^9}},ExpressionUUID->"f03abb6e-618f-4f0d-b2ec-\
da82d54d403c"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["A", "n", 
       RowBox[{"(", "k", ")"}]], "=", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"M", "=", "1"}], "k"], " ", 
        RowBox[{
         UnderscriptBox["\[Sum]", 
          RowBox[{
           StyleBox["p",
            FontSize->14], "\[Element]", 
           StyleBox[
            SubsuperscriptBox["\[CapitalXi]", "k", "M"],
            FontSize->14]}]], 
         RowBox[{
          UnderscriptBox["\[Sum]", 
           RowBox[{
            StyleBox["s",
             FontSize->14], "\[Element]", 
            StyleBox[
             SuperscriptBox["S", 
              RowBox[{"M", "-", "2"}]],
             FontSize->14]}]], 
          RowBox[{
           SubscriptBox["\[GothicCapitalB]", "n"], "(", 
           RowBox[{"M", ",", " ", "p", ",", " ", "s"}], ")"}]}]}]}], " ", "+", 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{
          StyleBox["t",
           FontSize->14], "\[Element]", 
          StyleBox[
           SuperscriptBox["S", 
            RowBox[{"M", "-", "1"}]],
           FontSize->14]}]], 
        RowBox[{
         SubscriptBox["\[GothicCapitalC]", "n"], "(", 
         RowBox[{"M", ",", " ", "p", ",", " ", "t"}], ")"}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"M", "=", "1"}], "k"], 
        RowBox[{
         UnderscriptBox["\[Sum]", 
          RowBox[{
           StyleBox["p",
            FontSize->14], "\[Element]", 
           StyleBox[
            SubsuperscriptBox["\[CapitalXi]", "k", "M"],
            FontSize->14]}]], 
         RowBox[{
          UnderscriptBox["\[Sum]", 
           RowBox[{
            StyleBox["t",
             FontSize->14], "\[Element]", 
            StyleBox[
             SuperscriptBox["S", 
              RowBox[{"M", "-", "1"}]],
             FontSize->14]}]], 
          RowBox[{
           SubscriptBox["\[GothicCapitalC]", "n"], "(", 
           RowBox[{"M", ",", " ", "p", ",", " ", "t"}], ")"}]}]}]}], " ", "+",
        " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], 
         RowBox[{"k", "-", "1"}]], 
        RowBox[{
         TemplateBox[{
           RowBox[{
             SuperscriptBox["n", 
              RowBox[{"(", "0", ")"}]], " "}], 
           RowBox[{"\[VeryThinSpace] ", 
             SuperscriptBox["n", 
              RowBox[{"(", "i", ")"}]]}]},
          "BraKet"], 
         RowBox[{
          UnderscriptBox["\[Sum]", 
           RowBox[{
            StyleBox["g",
             FontSize->14], "\[Element]", 
            StyleBox[
             SubsuperscriptBox["\[CapitalXi]", 
              RowBox[{"k", "-", "i"}], 
              RowBox[{"M", "-", "1"}]],
             FontSize->14]}]], 
          RowBox[{
           UnderscriptBox["\[Sum]", 
            RowBox[{
             StyleBox["t",
              FontSize->14], "\[Element]", 
             StyleBox[
              SuperscriptBox["S", 
               RowBox[{"M", "-", "2"}]],
              FontSize->14]}]], 
           RowBox[{
            SubscriptBox["\[GothicCapitalC]", "n"], "(", 
            RowBox[{
             RowBox[{"M", "-", "1"}], ",", " ", "g", ",", " ", "t"}], 
            ")"}]}]}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.827928441192596*^9, 3.8279284446973257`*^9}, {
   3.8279284893687487`*^9, 3.8279285018224583`*^9}, 3.827928630446698*^9, 
   3.827928720472046*^9},ExpressionUUID->"c7b70a56-9c37-4fbe-8d4b-\
47b5fafe2c00"],

Cell[TextData[{
 "We do, however, get from this that all we need to resolve is how to relate ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], "(", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[GothicCapitalD]", "n"], "(", 
      RowBox[{"M", ",", " ", "p", ",", " ", "t"}], ")"}], 
     TemplateBox[{
       SuperscriptBox["m", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}]}], TraditionalForm]],
  CellChangeTimes->{{3.8277881645267067`*^9, 3.827788286804654*^9}, {
   3.827788707224998*^9, 3.827788759652714*^9}},ExpressionUUID->
  "2f370b07-7f04-446a-80ad-7370a04fb671"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], "(", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[GothicCapitalD]", "m"], "(", 
      RowBox[{"M", ",", " ", "p", ",", " ", "t"}], ")"}], 
     TemplateBox[{
       SuperscriptBox["m", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}]}], TraditionalForm]],
  CellChangeTimes->{{3.8277881645267067`*^9, 3.827788286804654*^9}, {
   3.827788707224998*^9, 3.827788759652714*^9}},ExpressionUUID->
  "baa3a333-bb05-4f8e-967c-463d2111b311"],
 ", as the latter will come half the time and the former will come in half \
the time."
}], "ExpositoryText",
 CellChangeTimes->{{3.827789062634356*^9, 
  3.827789157526576*^9}},ExpressionUUID->"11d58b0d-cdc4-46ab-85e5-\
f13109f031f7"],

Cell["\<\
For that, we can consider another potential simplification. First we note that\
\>", "ExpositoryText",
 CellChangeTimes->{{3.827789167312887*^9, 3.827789170355406*^9}, {
  3.827789243187963*^9, 3.827789250460554*^9}, {3.827789383675963*^9, 
  3.827789387208323*^9}},ExpressionUUID->"0638876c-9f96-40ba-bd19-\
76a38c0d0876"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], 
    RowBox[{
     SubscriptBox["\[GothicCapitalD]", "n"], "(", 
     RowBox[{"M", ",", " ", "p", ",", " ", "t"}], ")"}], 
    TemplateBox[{
      SuperscriptBox["m", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], "(", "\[VeryThinSpace]", 
     RowBox[{
      RowBox[{
       UnderoverscriptBox["\[Product]", 
        RowBox[{"i", "=", "1"}], 
        RowBox[{"M", "-", "1"}]], 
       RowBox[{
        SubsuperscriptBox["\[CapitalOmega]", "n", 
         RowBox[{"(", 
          SubscriptBox["p", "i"], ")"}]], 
        SubscriptBox["\[Delta]", 
         RowBox[{
          SubscriptBox["t", "i"], "0"}]]}]}], "+", 
      RowBox[{
       SubsuperscriptBox["\[CapitalGamma]", "n", 
        RowBox[{"(", 
         SubscriptBox["p", "i"], ")"}]], 
       SubscriptBox["\[Delta]", 
        RowBox[{
         SubscriptBox["t", "i"], "1"}]]}]}], ")"}], 
    SubsuperscriptBox["\[CapitalDelta]H", "n", 
     RowBox[{"(", 
      SubscriptBox["p", "M"], ")"}]], 
    TemplateBox[{
      SuperscriptBox["m", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.827789257716805*^9, 
  3.827789287544784*^9}},ExpressionUUID->"6fe0d9f3-501d-42b0-a817-\
5ac7f87433e6"],

Cell[TextData[{
 "and written out we get series of terms that pairwise either look like ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", "n", 
     RowBox[{"(", 
      SubscriptBox["p", "i"], ")"}]], 
    SubsuperscriptBox["\[CapitalGamma]", "n", 
     RowBox[{"(", 
      SubscriptBox["p", 
       RowBox[{"i", "+", "1"}]], ")"}]]}], TraditionalForm]],ExpressionUUID->
  "cdb155e1-0fb4-48e0-b7c2-ec04a6ae5e07"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", "n", 
     RowBox[{"(", 
      SubscriptBox["p", "i"], ")"}]], 
    SubsuperscriptBox["\[CapitalOmega]", "n", 
     RowBox[{"(", 
      SubscriptBox["p", 
       RowBox[{"i", "+", "1"}]], ")"}]]}], TraditionalForm]],ExpressionUUID->
  "35f10ab4-19ab-46a2-8032-d3e9cbb897aa"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalOmega]", "n", 
     RowBox[{"(", 
      SubscriptBox["p", "i"], ")"}]], 
    SubsuperscriptBox["\[CapitalGamma]", "n", 
     RowBox[{"(", 
      SubscriptBox["p", 
       RowBox[{"i", "+", "1"}]], ")"}]]}], TraditionalForm]],ExpressionUUID->
  "160a19ec-a8ac-4f58-952d-3b1b3175f928"],
 ", or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalOmega]", "n", 
     RowBox[{"(", 
      SubscriptBox["p", "i"], ")"}]], 
    SubsuperscriptBox["\[CapitalOmega]", "n", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["p", "i"], "+", "1"}], ")"}]]}], TraditionalForm]],
  ExpressionUUID->"61c01f21-436b-401c-81be-3eb3c5876e84"],
 ", and we can enumerate the effect of the ones of these that will turn out \
to be relevant"
}], "ExpositoryText",
 CellChangeTimes->{{3.8277893886526012`*^9, 3.827789441757618*^9}, {
  3.8277894739136467`*^9, 3.827789541480586*^9}, {3.827790718056398*^9, 
  3.827790737586822*^9}, {3.827840800965773*^9, 3.827840801302718*^9}, {
  3.8278771606724377`*^9, 
  3.827877168939192*^9}},ExpressionUUID->"55369597-deca-4c92-b138-\
b6a56ba50b3e"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["\[CapitalGamma]", "n", 
        RowBox[{"(", 
         SubscriptBox["p", "i"], ")"}]], 
       SubsuperscriptBox["\[CapitalGamma]", "n", 
        RowBox[{"(", 
         SubscriptBox["p", 
          RowBox[{"i", "+", "1"}]], ")"}]]}], "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], 
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", 
           StyleBox[
            SubscriptBox["p", 
             RowBox[{"i", "+", "1"}]],
            FontSize->14], ")"}]], 
         TemplateBox[{
           RowBox[{"\[VeryThinSpace]", 
             SuperscriptBox["m", 
              RowBox[{"(", "0", ")"}]]}]},
          "Ket"]}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", 
           StyleBox[
            SubscriptBox["p", "i"],
            FontSize->14], ")"}]], 
         TemplateBox[{
           RowBox[{"\[VeryThinSpace]", 
             SuperscriptBox["m", 
              RowBox[{"(", "0", ")"}]]}]},
          "Ket"], 
         TemplateBox[{
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"]}], ")"}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       SubsuperscriptBox["\[CapitalGamma]", "n", 
        RowBox[{"(", 
         SubscriptBox["p", "i"], ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", 
         StyleBox[
          SubscriptBox["p", 
           RowBox[{"i", "+", "1"}]],
          FontSize->14], ")"}]], 
       TemplateBox[{
         RowBox[{"\[VeryThinSpace]", 
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]}]},
        "Ket"]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["\[CapitalGamma]", "n", 
         RowBox[{"(", 
          SubscriptBox["p", "i"], ")"}]], 
        TemplateBox[{
          SuperscriptBox["m", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], 
        SuperscriptBox["H", 
         RowBox[{"(", 
          SubscriptBox["p", 
           RowBox[{"i", "+", "1"}]], ")"}]], 
        TemplateBox[{
          RowBox[{"\[VeryThinSpace]", 
            SuperscriptBox["m", 
             RowBox[{"(", "0", ")"}]]}]},
         "Ket"]}], "-", 
       RowBox[{
        SubsuperscriptBox["\[CapitalGamma]", "n", 
         RowBox[{"(", 
          SubscriptBox["p", "i"], ")"}]], 
        SubsuperscriptBox["E", "n", 
         RowBox[{"(", 
          SubscriptBox["p", 
           RowBox[{"i", "+", "1"}]], ")"}]]}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["\[CapitalOmega]", "n", 
        RowBox[{"(", 
         SubscriptBox["p", "i"], ")"}]], 
       SubsuperscriptBox["\[CapitalOmega]", "n", 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["p", "i"], "+", "1"}], ")"}]]}], "=", 
      RowBox[{
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", 
         StyleBox[
          SubscriptBox["p", "i"],
          FontSize->14], ")"}]], 
       SubscriptBox["\[CapitalPi]", "n"], 
       SubscriptBox["\[CapitalPi]", "m"], 
       SubsuperscriptBox["\[CapitalDelta]H", "m", 
        RowBox[{"(", "0", ")"}]], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", 
         StyleBox[
          SubscriptBox["p", 
           RowBox[{"i", "+", "1"}]],
          FontSize->14], ")"}]], 
       SubscriptBox["\[CapitalPi]", "n"], 
       SubscriptBox["\[CapitalPi]", "m"], 
       SubsuperscriptBox["\[CapitalDelta]H", "m", 
        RowBox[{"(", "0", ")"}]]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", 
          StyleBox[
           SubscriptBox["p", "i"],
           FontSize->14], ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubscriptBox["\[CapitalPi]", "m"], 
        SubsuperscriptBox["\[CapitalDelta]H", "m", 
         RowBox[{"(", "0", ")"}]], 
        SuperscriptBox["H", 
         RowBox[{"(", 
          StyleBox[
           SubscriptBox["p", 
            RowBox[{"i", "+", "1"}]],
           FontSize->14], ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubscriptBox["\[CapitalPi]", "m"], 
        SubsuperscriptBox["\[CapitalDelta]H", "m", 
         RowBox[{"(", "0", ")"}]]}], "+", 
       RowBox[{
        SubsuperscriptBox["E", "n", 
         RowBox[{"(", 
          SubscriptBox["p", 
           RowBox[{"i", "+", "1"}]], ")"}]], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", 
          StyleBox[
           SubscriptBox["p", "i"],
           FontSize->14], ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SubscriptBox["\[CapitalPi]", "m"], 
        SubsuperscriptBox["\[CapitalDelta]H", "m", 
         RowBox[{"(", "0", ")"}]]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8277895449411287`*^9, 3.8277895986070013`*^9}, {
   3.827789667719618*^9, 3.8277896938127337`*^9}, {3.827789747802396*^9, 
   3.8277897615086737`*^9}, {3.827790300103307*^9, 3.8277903603691387`*^9}, {
   3.8277906320999823`*^9, 3.827790710903926*^9}, {3.8277908407774267`*^9, 
   3.82779087998114*^9}, {3.8278065040188227`*^9, 3.827806505706069*^9}, 
   3.8278407929516363`*^9, {3.827840831520825*^9, 3.827840848125903*^9}, {
   3.827876172022483*^9, 3.827876172799253*^9}, 
   3.8278771799305077`*^9},ExpressionUUID->"ff561188-107a-4192-9919-\
a60aca349843"],

Cell[TextData[{
 "The first of these provides the key motif that will simplify these terms \
down to forms that can negate one another. As an example, we know we\
\[CloseCurlyQuote]ll some ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "52811981-5dfb-43c0-9d90-0c5ffa754fa2"],
 " which is just all 1s, giving us (assuming len(p) > 1, but the final \
conclusion is valid without it)"
}], "ExpositoryText",
 CellChangeTimes->{{3.827790890931407*^9, 3.8277909324684973`*^9}, {
