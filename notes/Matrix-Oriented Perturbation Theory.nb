864eba15a196"],

Cell[TextData[{
 "and so we want determine what the extra polynomial contribution is (since \
we note we\[CloseCurlyQuote]ll always divide out by ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["S", 
    RowBox[{"sum", "(", "b", ")"}], 
    RowBox[{"sum", "(", "a", ")"}]], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "8095603e-7471-49f7-a5b3-3b3a0ee09a2c"],
 ")"
}], "ExpositoryText",
