 RowBox[{
  RowBox[{
   RowBox[{"inert", "[", "pos_", "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "3", "]"}], "*", 
       RowBox[{"Dot", "[", 
        RowBox[{"p", ",", " ", "p"}], "]"}]}], "-", 
      RowBox[{"Outer", "[", 
