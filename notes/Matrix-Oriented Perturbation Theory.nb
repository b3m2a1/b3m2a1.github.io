      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], " ", 
    SuperscriptBox["H", 
     RowBox[{"(", 
      RowBox[{"k", "-", "i"}], ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "i", ")"}]]},
     "Ket"]}], " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
