  3.833136229495454*^9}},ExpressionUUID->"d34442fa-e024-45cc-9c35-\
47ee3991e046"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["Q", "2"]], 
       RowBox[{"Tr", "(", "A", ")"}]}], " ", "=", " ", 
      RowBox[{"Tr", "(", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Del]", "Q"], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             SubscriptBox["\[Del]", "Q"], "A"}], ")"}], 
           RowBox[{"1", ":", "3"}]]}], ")"}], 
        RowBox[{"1", ":", "3"}]], ")"}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{"Tr", "(", 
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox["Q", "2"]], 
        SuperscriptBox["A", 
         RowBox[{"2", ":", 
          SuperscriptBox["4", 
           RowBox[{"1", ":", "3"}]]}]]}], ")"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.833132904333046*^9, 3.833132977814962*^9}, {
