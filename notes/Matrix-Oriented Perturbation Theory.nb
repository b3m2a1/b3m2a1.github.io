Cell["Trying a different tack, writing ", "ExpositoryText",
 CellChangeTimes->{{3.8120251576185503`*^9, 
  3.8120251767855787`*^9}},ExpressionUUID->"8a8ce7a0-51a8-417a-b981-\
b11cbce8b6f3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[Del]", 
       SuperscriptBox["q", "3"]], "V"}], "\[CircleDot]", "q"}], 
    "\[InvisibleSpace]", "q", "\[InvisibleSpace]\[InvisibleSpace]", "q"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811988828970687*^9, 
  3.81198886142519*^9}},ExpressionUUID->"f3c0c0cf-7534-4eea-8d7a-\
3611e944c7ae"],

Cell["we\[CloseCurlyQuote]ll note that ", "ExpositoryText",
 CellChangeTimes->{{3.812025182580868*^9, 
  3.8120251853065233`*^9}},ExpressionUUID->"f7faf273-b35c-419c-84ec-\
30a2c83d3b44"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], 
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], "\[CapitalPi]", "\[InvisibleSpace]", 
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", "\[Alpha]\[Beta]\[Gamma]"], 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
      "i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k", 
       "\[InvisibleSpace]"}]], " ", 
     RowBox[{
      SubscriptBox[
       RowBox[{"(", 
        SuperscriptBox["V", 
         RowBox[{"(", "3", ")"}]], ")"}], "\[Alpha]\[Beta]\[Gamma]"], 
      SubscriptBox[
       RowBox[{"(", 
        SuperscriptBox["V", 
         RowBox[{"(", "3", ")"}]], ")"}], 
       RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]]},
       "Bra"], 
      SubscriptBox["q", "\[Alpha]"], 
      SubscriptBox["q", "\[Beta]"], 
      SubscriptBox["q", "\[Gamma]"], "\[CapitalPi]", "\[InvisibleSpace]", 
      SubscriptBox["q", "i"], 
      SubscriptBox["q", "j"], 
      SubscriptBox["q", "k"], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.812024241225793*^9, 3.81202432309907*^9}, {
  3.812024380662732*^9, 3.8120244209395237`*^9}, {3.812025039783084*^9, 
  3.812025094261054*^9}, {3.8120251495212193`*^9, 3.8120251552645683`*^9}, {
  3.8120251879467382`*^9, 
  3.8120252155587378`*^9}},ExpressionUUID->"b521a7db-ce1f-491f-80f3-\
8c1c9abedd1d"],

Cell["\<\
and now writing down (from raising/lowering operators, will explain in more \
detail below)\
\>", "ExpositoryText",
 CellChangeTimes->{{3.812025190060762*^9, 3.812025251444276*^9}, {
  3.81202541116464*^9, 
  3.8120254197035837`*^9}},ExpressionUUID->"3a473d3c-c4f8-4b92-8a61-\
fc5e6186eec6"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SuperscriptBox["q", "k"], 
       TemplateBox[{
         SubscriptBox["n", "i"]},
        "Ket"]}], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", 
         RowBox[{"-", "k"}]}], "k"], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          UnderscriptBox["\[Sum]", 
           RowBox[{"g", "\[Element]", 
            SubsuperscriptBox["P", "a", "\[Alpha]"]}]], " ", 
          RowBox[{
           UnderscriptBox["\[Product]", 
            RowBox[{"l", "\[VeryThinSpace]", "\[Element]", "g"}]], 
           SqrtBox[
            RowBox[{
             SubscriptBox["n", "i"], "+", "l"}]]}]}], ")"}], 
        TemplateBox[{
          RowBox[{
            SubscriptBox["n", "i"], "+", "j"}]},
         "Ket"]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", 
         RowBox[{"-", "k"}]}], "k"], 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["\[Rho]", "j", "k"], "(", 
         SubscriptBox["n", "i"], ")"}], 
        TemplateBox[{
          RowBox[{
            SubscriptBox["n", "i"], "+", "j"}]},
         "Ket"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8120189399713783`*^9, 3.8120189542669363`*^9}, {
   3.812018984709425*^9, 3.812018994322439*^9}, {3.812019076139845*^9, 
   3.812019172938554*^9}, {3.812019230062146*^9, 3.8120192394022913`*^9}, {
   3.812019322056819*^9, 3.812019390413857*^9}, 3.812019491347191*^9, {
   3.812019542164609*^9, 3.812019581743684*^9}, {3.81201963975729*^9, 
   3.812019674539228*^9}, {3.812020864053795*^9, 3.812020874918763*^9}, {
   3.8120227490154953`*^9, 3.8120227530820208`*^9}, {3.812023247307775*^9, 
   3.812023265880575*^9}, {3.812025396542099*^9, 3.8120254046430407`*^9}, {
   3.812029410541395*^9, 3.812029413094556*^9}, 3.812029837398779*^9, {
   3.812029963921937*^9, 
   3.8120299680408983`*^9}},ExpressionUUID->"4d615a66-722b-4391-a43a-\
560386454dbe"],

Cell["we get", "ExpositoryText",
 CellChangeTimes->{{3.812025253294118*^9, 
  3.812025254065031*^9}},ExpressionUUID->"89408fb0-630c-4250-ba3c-\
5d3b249fbf47"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[CapitalPi]", "\[InvisibleSpace]\[VeryThinSpace]", 
    SubsuperscriptBox["q", "i", "a"], 
    TemplateBox[{
      SubscriptBox["n", "i"]},
     "Ket"], 
    SubsuperscriptBox["q", "j", "b"], 
    TemplateBox[{
      SubscriptBox["n", "j"]},
     "Ket"], 
    SubsuperscriptBox["q", "k", "c"], 
    TemplateBox[{
      SubscriptBox["n", "k"]},
     "Ket"]}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"-", "a"}]}], "a"], " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"\[Beta]", "=", 
       RowBox[{"-", "b"}]}], "b"], " ", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"\[Gamma]", "=", 
        RowBox[{"-", "c"}]}], "c"], " ", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{
          SubsuperscriptBox["\[Rho]", "\[Alpha]", "a"], "(", 
          SubscriptBox["n", "i"], ")"}], 
         RowBox[{
          SubsuperscriptBox["\[Rho]", "\[Beta]", "b"], "(", 
          SubscriptBox["n", "j"], ")"}], 
         RowBox[{
          SubsuperscriptBox["\[Rho]", "\[Gamma]", "c"], "(", 
          SubscriptBox["n", "k"], ")"}]}], 
        RowBox[{
         SubscriptBox["\[Alpha]\[Omega]", "i"], "+", 
         SubscriptBox["\[Beta]\[Omega]", "j"], "+", 
         SubscriptBox["\[Gamma]\[Omega]", "k"]}]], 
       TemplateBox[{
         RowBox[{
           SubscriptBox["n", "i"], "+", "\[Alpha]"}]},
        "Ket"], 
       TemplateBox[{
         RowBox[{
           SubscriptBox["n", "j"], "+", "\[Beta]"}]},
        "Ket"], 
       RowBox[{
        TemplateBox[{
          RowBox[{
            SubscriptBox["n", "k"], "+", "\[Gamma]"}]},
         "Ket"], "(", 
        RowBox[{"1", "-", 
         SubscriptBox["\[Delta]", 
          RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "\[Gamma]", ",", "0"}]]}], 
        ")"}]}]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8120252553949747`*^9, 3.812025277791541*^9}, {
   3.8120254335764523`*^9, 3.812025544802099*^9}, {3.812025685719198*^9, 
   3.8120257513746223`*^9}, {3.8120258700458317`*^9, 3.812025966676682*^9}, {
   3.8120261088314857`*^9, 3.8120261254483023`*^9}, {3.8120261877320147`*^9, 
   3.812026199997304*^9}, 
   3.812026728540187*^9},ExpressionUUID->"c3e96295-c1d0-425a-af5f-\
37b69e99946a"],

Cell[TextData[{
 "where when, e.g. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "952f807d-8bcb-4ae9-ad9f-c020d08a109f"],
 " this is actually totally clean, since \[Beta] is always 0 and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      RowBox[{
        SubscriptBox["n", "j"], "+", "\[Beta]"}]},
     "Ket"], "=", 
    TemplateBox[{
      SubscriptBox["n", "j"]},
     "Ket"]}], TraditionalForm]],
  CellChangeTimes->{{3.8120252553949747`*^9, 3.812025277791541*^9}, {
   3.8120254335764523`*^9, 3.812025544802099*^9}, {3.812025685719198*^9, 
   3.8120257513746223`*^9}, {3.8120258700458317`*^9, 3.812025966676682*^9}, {
   3.8120261088314857`*^9, 3.8120261254483023`*^9}},ExpressionUUID->
  "5002ca7a-4add-45fd-b197-2fc384d56375"],
 "  which means it just comes directly out of the sum. One thing worth noting \
is that we have a 4D Kronecker-delta-esque thing here which is just a way of \
writing"
}], "ExpositoryText",
 CellChangeTimes->{{3.8120261481975727`*^9, 
  3.812026252781226*^9}},ExpressionUUID->"d51ccb10-0c76-456f-96cc-\
4a9787a08730"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "-", 
     SubscriptBox["\[Delta]", 
      RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "\[Gamma]", ",", "0"}]]}], 
    ")"}], " ", "=", " ", 
   TagBox[GridBox[{
      {"\[Piecewise]", GridBox[{
         {"0", 
          RowBox[{"\[Alpha]", "=", 
           RowBox[{"\[Beta]", "=", 
            RowBox[{"\[Gamma]", "=", "0"}]}]}]},
         {"1", "else"}
        },
        AllowedDimensions->{2, Automatic},
        Editable->True,
        GridBoxAlignment->{
         "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
          "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
        GridBoxItemSize->{
         "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}},
           "RowsIndexed" -> {}},
        GridBoxSpacings->{"Columns" -> {
            Offset[0.27999999999999997`], {
             Offset[0.84]}, 
            Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, 
          "Rows" -> {
            Offset[0.2], {
             Offset[0.4]}, 
            Offset[0.2]}, "RowsIndexed" -> {}},
        Selectable->True]}
     },
     GridBoxAlignment->{
      "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
       "RowsIndexed" -> {}},
     GridBoxItemSize->{
      "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}}, 
       "RowsIndexed" -> {}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.35]}, 
         Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}, "RowsIndexed" -> {}}],
    "Piecewise",
    DeleteWithContents->True,
    Editable->False,
    SelectWithContents->True,
    Selectable->False,
    StripWrapperBoxes->True]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.81202625112118*^9, 
  3.812026270368883*^9}},ExpressionUUID->"0a73b4a4-ed6b-46d8-956a-\
5b877bea8a3c"],

Cell[TextData[{
 "Now we ",
 StyleBox["could",
  FontSlant->"Italic"],
 " just go straight to writing out an explicit form for"
}], "ExpositoryText",
 CellChangeTimes->{{3.812026046754738*^9, 
  3.8120260679611473`*^9}},ExpressionUUID->"ce7b9d38-838b-4546-a274-\
ea3c4b8d648f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["q", "\[Alpha]"], 
   SubscriptBox["q", "\[Beta]"], 
   SubscriptBox["q", "\[Gamma]"], "\[CapitalPi]", "\[InvisibleSpace]", 
   SubscriptBox["q", "i"], 
   SubscriptBox["q", "j"], 
   SubscriptBox["q", "k"], 
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.812026062547242*^9, 
  3.8120260715923986`*^9}},ExpressionUUID->"18a9c9d2-3c11-448c-839f-\
8e2be4a810d2"],

Cell["but instead we should note that we have", "ExpositoryText",
 CellChangeTimes->{{3.812026325376116*^9, 
  3.812026337235991*^9}},ExpressionUUID->"e47d04a1-1d85-489b-bf23-\
8cd01d71a3ba"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Bra"], 
   SubscriptBox["q", "\[Alpha]"], 
   SubscriptBox["q", "\[Beta]"], 
   SubscriptBox["q", "\[Gamma]"], "\[CapitalPi]", "\[InvisibleSpace]", 
   SubscriptBox["q", "i"], 
   SubscriptBox["q", "j"], 
   SubscriptBox["q", "k"], 
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.812026361972972*^9, 
  3.812026369139431*^9}},ExpressionUUID->"5a06463b-1b3a-4897-99b3-\
bd29669053ed"],

Cell[TextData[{
 "and so only the operations of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["q", "\[Alpha]"], 
    SubscriptBox["q", "\[Beta]"], 
    SubscriptBox["q", "\[Gamma]"]}], TraditionalForm]],ExpressionUUID->
  "6d40b2a7-4c4e-491e-8e18-e89d75ee9528"],
 " that will reverse the operation of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["q", "i"], 
    SubscriptBox["q", "j"], 
    SubscriptBox["q", "k"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "a3b99a67-addf-4cb9-946f-3c839cb4013c"],
 " or which already lead to a non-zero integral in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], 
    SubscriptBox["q", "\[Alpha]"], 
    SubscriptBox["q", "\[Beta]"], 
    SubscriptBox["q", "\[Gamma]"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], TraditionalForm]],
  CellChangeTimes->{{3.812026361972972*^9, 3.812026369139431*^9}},
  ExpressionUUID->"b5965981-479b-47a7-8865-26608dd223ef"],
 " can contribute. "
}], "ExpositoryText",
 CellChangeTimes->{{3.8120263716890993`*^9, 3.812026459109209*^9}, {
  3.812026516220879*^9, 
  3.812026551733397*^9}},ExpressionUUID->"2358292c-92a0-424d-bd2d-\
318e8e9f7474"],

Cell["\<\
At the end of the day, then, this means we\[CloseCurlyQuote]ll get things \
that look like\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8120266658175287`*^9, 
  3.812026702505795*^9}},ExpressionUUID->"3d3bb7ea-701e-42e0-98c4-\
09766cfcb7c0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SubscriptBox["n", "i"]},
     "Bra"], 
    SubsuperscriptBox["q", "i", 
     SuperscriptBox["a", "\[Prime]"]], 
    TemplateBox[{
      SubscriptBox["n", "j"]},
     "Bra"], "\[InvisibleSpace]", 
    SubsuperscriptBox["q", "j", 
     SuperscriptBox["b", "\[Prime]"]], 
    TemplateBox[{
      SubscriptBox["n", "k"]},
     "Bra"], "\[InvisibleSpace]", 
    SubsuperscriptBox["q", "k", 
     SuperscriptBox["c", "\[Prime]"]], "\[InvisibleSpace]", "\[CapitalPi]", "\[InvisibleSpace]\[VeryThinSpace]", 
    SubsuperscriptBox["q", "i", "a"], 
    TemplateBox[{
      SubscriptBox["n", "i"]},
     "Ket"], 
    SubsuperscriptBox["q", "j", "b"], 
    TemplateBox[{
      SubscriptBox["n", "j"]},
     "Ket"], 
    SubsuperscriptBox["q", "k", "c"], 
    TemplateBox[{
      SubscriptBox["n", "k"]},
     "Ket"]}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"-", "a"}]}], "a"], " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"\[Beta]", "=", 
       RowBox[{"-", "b"}]}], "b"], " ", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"\[Gamma]", "=", 
        RowBox[{"-", "c"}]}], "c"], " ", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{
          SubsuperscriptBox["\[Rho]", "\[Alpha]", "a"], "(", 
          SubscriptBox["n", "i"], ")"}], 
         RowBox[{
          SubsuperscriptBox["\[Rho]", 
           RowBox[{"-", "\[Alpha]"}], 
           SuperscriptBox["a", "\[Prime]"]], "(", 
          RowBox[{
           SubscriptBox["n", "i"], "+", "\[Alpha]"}], ")"}], 
         RowBox[{
          SubsuperscriptBox["\[Rho]", "\[Beta]", "b"], "(", 
          SubscriptBox["n", "j"], ")"}], 
         RowBox[{
          SubsuperscriptBox["\[Rho]", 
           RowBox[{"-", "\[Beta]"}], 
           SuperscriptBox["b", "\[Prime]"]], "(", 
          RowBox[{
           SubscriptBox["n", "j"], "+", "\[Beta]"}], ")"}], 
         RowBox[{
          SubsuperscriptBox["\[Rho]", "\[Gamma]", "c"], "(", 
          SubscriptBox["n", "k"], ")"}], 
         SubsuperscriptBox["\[Rho]", 
          RowBox[{"-", "\[Gamma]"}], 
          SuperscriptBox["c", "\[Prime]"]], 
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["n", "k"], "+", "\[Beta]"}], ")"}]}], 
        RowBox[{
         SubscriptBox["\[Alpha]\[Omega]", "i"], "+", 
         SubscriptBox["\[Beta]\[Omega]", "j"], "+", 
         SubscriptBox["\[Gamma]\[Omega]", "k"]}]], 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SubscriptBox["\[Delta]", 
          RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "\[Gamma]", ",", "0"}]]}], 
        ")"}]}]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8120252553949747`*^9, 3.812025277791541*^9}, {
   3.8120254335764523`*^9, 3.812025544802099*^9}, {3.812025685719198*^9, 
   3.8120257513746223`*^9}, {3.8120258700458317`*^9, 3.812025966676682*^9}, {
   3.8120261088314857`*^9, 3.8120261254483023`*^9}, {3.8120261877320147`*^9, 
   3.812026199997304*^9}, {3.812026711485095*^9, 3.812026724955296*^9}, {
   3.8120267820813923`*^9, 3.8120268951402082`*^9}, {3.812028382886897*^9, 
   3.8120284599245977`*^9}, {3.812039332122802*^9, 3.812039368534232*^9}, 
   3.812099885854528*^9},ExpressionUUID->"2914fa25-464f-4422-b4b8-\
bc48cd07b871"],

Cell[TextData[{
 "we\[CloseCurlyQuote]ll ignore, just for the moment, how the derivatives \
play into all of this, but we\[CloseCurlyQuote]ll note that from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["q", "i", "a"], 
    SubsuperscriptBox["q", "j", "b"], 
    SubsuperscriptBox["q", "k", "c"]}], TraditionalForm]],
  CellChangeTimes->{{3.8120252553949747`*^9, 3.812025277791541*^9}, {
   3.8120254335764523`*^9, 3.812025544802099*^9}, {3.812025685719198*^9, 
   3.8120257513746223`*^9}, {3.8120258700458317`*^9, 3.812025966676682*^9}, {
   3.8120261088314857`*^9, 3.8120261254483023`*^9}, {3.8120261877320147`*^9, 
   3.812026199997304*^9}, {3.812026711485095*^9, 3.812026724955296*^9}, {
   3.8120267820813923`*^9, 3.8120268951402082`*^9}, {3.812028382886897*^9, 
   3.8120284599245977`*^9}},ExpressionUUID->
  "e61ef518-93ae-4e13-9a7f-232d9d2eae14"],
 " we can work back to its corresponding derivative tensor element."
}], "ExpositoryText",
 CellChangeTimes->{{3.812028339001905*^9, 3.81202834287245*^9}, {
  3.812028509778569*^9, 3.8120285156850986`*^9}, {3.812028634931044*^9, 
  3.812028639106781*^9}, {3.8120286841261597`*^9, 
  3.812028763881424*^9}},ExpressionUUID->"43a20a01-2df8-41bd-a691-\
0aa26c10c943"],

Cell["Let\[CloseCurlyQuote]s look at some concrete examples", "ExpositoryText",
 CellChangeTimes->{{3.81209962367793*^9, 3.812099637970805*^9}, {
  3.812099934042371*^9, 
  3.8120999401609697`*^9}},ExpressionUUID->"6efc0694-4415-4da2-8f19-\
0abd16835347"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SubscriptBox["n", "i"]},
        "Bra"], 
       SuperscriptBox[
        SubscriptBox["q", "i"], "3"], "\[InvisibleSpace]", "\[CapitalPi]", 
       "\[InvisibleSpace]", 
       SuperscriptBox[
        SubscriptBox["q", "i"], "3"], 
       TemplateBox[{
         SubscriptBox["n", "i"]},
        "Ket"]}], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Alpha]", "=", 
         RowBox[{"-", "3"}]}], 
        RowBox[{" ", "3"}]], " ", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{
           SubsuperscriptBox["\[Rho]", "\[Alpha]", "3"], "(", 
           SubscriptBox["n", "i"], ")"}], 
          RowBox[{
           SubsuperscriptBox["\[Rho]", 
            RowBox[{"-", "\[Alpha]"}], "3"], "(", 
           RowBox[{
            SubscriptBox["n", "i"], "+", "\[Alpha]"}], ")"}]}], 
         SubscriptBox["\[Alpha]\[Omega]", "i"]], 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          SubscriptBox["\[Delta]", 
           RowBox[{"\[Alpha]", "\[InvisibleSpace]", "0"}]]}], ")"}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{
          SubsuperscriptBox["\[Rho]", 
           RowBox[{"-", "3"}], "3"], "(", 
          SubscriptBox["n", "i"], ")"}], 
         RowBox[{
          SubsuperscriptBox["\[Rho]", "3", "3"], "(", 
          RowBox[{
           SubscriptBox["n", "i"], "-", "3"}], ")"}]}], 
        RowBox[{
         RowBox[{"-", "3"}], 
         SubscriptBox["\[Omega]", "i"]}]], "+", 
       FractionBox[
        RowBox[{
         RowBox[{
          SubsuperscriptBox["\[Rho]", 
           RowBox[{"-", "1"}], "3"], "(", 
          SubscriptBox["n", "i"], ")"}], 
         RowBox[{
          SubsuperscriptBox["\[Rho]", "1", "3"], "(", 
          RowBox[{
           SubscriptBox["n", "i"], "-", "1"}], ")"}]}], 
        RowBox[{"-", 
         SubscriptBox["\[Omega]", "i"]}]], "+", 
       FractionBox[
        RowBox[{
         RowBox[{
          SubsuperscriptBox["\[Rho]", "1", "3"], "(", 
          SubscriptBox["n", "i"], ")"}], 
         RowBox[{
          SubsuperscriptBox["\[Rho]", 
           RowBox[{"-", "1"}], "3"], "(", 
          RowBox[{
           SubscriptBox["n", "i"], "+", "1"}], ")"}]}], 
        SubscriptBox["\[Omega]", "i"]], "+", 
       FractionBox[
        RowBox[{
         RowBox[{
          SubsuperscriptBox["\[Rho]", "3", "3"], "(", 
          SubscriptBox["n", "i"], ")"}], 
         RowBox[{
          SubsuperscriptBox["\[Rho]", 
           RowBox[{"-", "3"}], "3"], "(", 
          RowBox[{
           SubscriptBox["n", "i"], "+", "3"}], ")"}]}], 
        RowBox[{"3", 
         SubscriptBox["\[Omega]", "i"]}]]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        FractionBox["1", 
         RowBox[{"3", 
          SubscriptBox["\[Omega]", "i"]}]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            SubsuperscriptBox["\[Rho]", "3", "3"], "(", 
            SubscriptBox["n", "i"], ")"}], 
           RowBox[{
            SubsuperscriptBox["\[Rho]", 
             RowBox[{"-", "3"}], "3"], "(", 
            RowBox[{
             SubscriptBox["n", "i"], "+", "3"}], ")"}]}], "-", 
          RowBox[{
           RowBox[{
            SubsuperscriptBox["\[Rho]", 
             RowBox[{"-", "3"}], "3"], "(", 
            SubscriptBox["n", "i"], ")"}], 
           RowBox[{
            SubsuperscriptBox["\[Rho]", "3", "3"], "(", 
            RowBox[{
             SubscriptBox["n", "i"], "-", "3"}], ")"}]}]}], ")"}]}], "+", 
       RowBox[{
        FractionBox["1", 
         SubscriptBox["\[Omega]", "i"]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            SubsuperscriptBox["\[Rho]", "1", "3"], "(", 
            SubscriptBox["n", "i"], ")"}], 
           RowBox[{
            SubsuperscriptBox["\[Rho]", 
             RowBox[{"-", "1"}], "3"], "(", 
            RowBox[{
             SubscriptBox["n", "i"], "+", "1"}], ")"}]}], "-", 
          RowBox[{
           RowBox[{
            SubsuperscriptBox["\[Rho]", 
             RowBox[{"-", "1"}], "3"], "(", 
            SubscriptBox["n", "i"], ")"}], 
           RowBox[{
            SubsuperscriptBox["\[Rho]", "1", "3"], "(", 
            RowBox[{
             SubscriptBox["n", "i"], "-", "1"}], ")"}]}]}], ")"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8120996415132523`*^9, 3.812099740826569*^9}, {
  3.812099805150506*^9, 3.81209991972631*^9}, {3.812100178083403*^9, 
  3.812100226348467*^9}, {3.8121002791585293`*^9, 3.8121004032961397`*^9}, {
  3.812100436329794*^9, 3.812100465841919*^9}, {3.8121009654149723`*^9, 
  3.81210097073442*^9}},ExpressionUUID->"fdb8b978-862e-4f52-9f54-\
d4a19d479e55"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SubscriptBox["n", "i"]},
        "Bra"], 
       SuperscriptBox[
        SubscriptBox["q", "i"], "2"], 
       SubscriptBox["q", "j"], "\[InvisibleSpace]", "\[CapitalPi]", 
       "\[InvisibleSpace]", 
       SuperscriptBox[
        SubscriptBox["q", "i"], "3"], 
       TemplateBox[{
         SubscriptBox["n", "i"]},
        "Ket"]}], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Alpha]", "=", 
         RowBox[{"-", "3"}]}], 
        RowBox[{" ", "3"}]], "  ", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{
           SubsuperscriptBox["\[Rho]", "\[Alpha]", "3"], "(", 
           SubscriptBox["n", "i"], ")"}], 
          RowBox[{
           SubsuperscriptBox["\[Rho]", 
            RowBox[{"-", "\[Alpha]"}], "2"], "(", 
           RowBox[{
            SubscriptBox["n", "i"], "+", "\[Alpha]"}], ")"}], 
          RowBox[{
           SubsuperscriptBox["\[Rho]", "0", "1"], "(", 
           SubscriptBox["n", "j"], ")"}], 
          RowBox[{
           SubsuperscriptBox["\[Rho]", "0", "0"], "(", 
           SubscriptBox["n", "i"], ")"}]}], 
         SubscriptBox["\[Alpha]\[Omega]", "i"]], 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          SubscriptBox["\[Delta]", 
           RowBox[{"\[Alpha]", "\[InvisibleSpace]", "0"}]]}], ")"}]}]}]}]},
    {
     RowBox[{"=", "0"}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8120996415132523`*^9, 3.812099740826569*^9}, {
  3.812099805150506*^9, 3.81209991972631*^9}, {3.812100178083403*^9, 
  3.812100226348467*^9}, {3.8121002791585293`*^9, 3.8121004032961397`*^9}, {
  3.812100436329794*^9, 3.812100465841919*^9}, {3.8121009654149723`*^9, 
  3.81210097073442*^9}, {3.812101503983539*^9, 3.812101543362969*^9}, {
  3.8121016082899227`*^9, 
  3.812101702280538*^9}},ExpressionUUID->"ea49eea7-29f9-4aed-a1bd-\
3e133547bc4f"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SubscriptBox["n", "j"]},
        "Bra"], 
       TemplateBox[{
         SubscriptBox["n", "i"]},
        "Bra"], 
       SubscriptBox["q", "i"], 
       SuperscriptBox[
        SubscriptBox["q", "j"], "2"], "\[InvisibleSpace]", "\[CapitalPi]", 
       "\[InvisibleSpace]", 
       SuperscriptBox[
        SubscriptBox["q", "i"], "3"], 
       TemplateBox[{
         SubscriptBox["n", "i"]},
        "Ket"], 
       TemplateBox[{
         SubscriptBox["n", "j"]},
        "Ket"]}], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Alpha]", "=", 
         RowBox[{"-", "3"}]}], "3"], "  ", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{
           SubsuperscriptBox["\[Rho]", "\[Alpha]", "3"], "(", 
           SubscriptBox["n", "i"], ")"}], 
          RowBox[{
           SubsuperscriptBox["\[Rho]", 
            RowBox[{"-", "\[Alpha]"}], "1"], "(", 
           RowBox[{
            SubscriptBox["n", "i"], "+", "\[Alpha]"}], ")"}], 
          RowBox[{
           SubsuperscriptBox["\[Rho]", "0", "0"], "(", 
           SubscriptBox["n", "j"], ")"}], 
          RowBox[{
           SubsuperscriptBox["\[Rho]", "0", "2"], "(", 
           SubscriptBox["n", "j"], ")"}]}], 
         SubscriptBox["\[Alpha]\[Omega]", "i"]], 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          SubscriptBox["\[Delta]", 
           RowBox[{"\[Alpha]", "\[InvisibleSpace]", "0"}]]}], ")"}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       FractionBox["1", 
        SubscriptBox["\[Omega]", "i"]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           SubsuperscriptBox["\[Rho]", "1", "3"], "(", 
           SubscriptBox["n", "i"], ")"}], 
          RowBox[{
           SubsuperscriptBox["\[Rho]", 
            RowBox[{"-", "1"}], "1"], "(", 
           RowBox[{
            SubscriptBox["n", "i"], "+", "1"}], ")"}]}], "-", 
         RowBox[{
          RowBox[{
           SubsuperscriptBox["\[Rho]", 
            RowBox[{"-", "1"}], "3"], "(", 
           SubscriptBox["n", "i"], ")"}], 
          RowBox[{
           SubsuperscriptBox["\[Rho]", "1", "1"], "(", 
           RowBox[{
            SubscriptBox["n", "i"], "-", "1"}], ")"}]}]}], ")"}], 
       RowBox[{
        SubsuperscriptBox["\[Rho]", "0", "0"], "(", 
        SubscriptBox["n", "j"], ")"}], 
       RowBox[{
        SubsuperscriptBox["\[Rho]", "0", "2"], "(", 
        SubscriptBox["n", "j"], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8121017038448763`*^9, 3.812101895096439*^9}, {
  3.812106598940835*^9, 3.8121066163723507`*^9}, {3.812107245696165*^9, 
  3.8121072599711933`*^9}},ExpressionUUID->"c4ba65ce-ef26-42b5-be95-\
972825ef0a13"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SubscriptBox["n", "k"]},
        "Bra"], 
       TemplateBox[{
         SubscriptBox["n", "j"]},
        "Bra"], 
       TemplateBox[{
         SubscriptBox["n", "i"]},
        "Bra"], 
       SubscriptBox["q", "i"], 
       SubscriptBox["q", "j"], 
       SubscriptBox["q", "k"], "\[InvisibleSpace]", "\[CapitalPi]", 
       "\[InvisibleSpace]", 
       SubscriptBox["q", "i"], 
       SubscriptBox["q", "j"], 
       SubscriptBox["q", "k"], 
       TemplateBox[{
         SubscriptBox["n", "i"]},
        "Ket"], 
       TemplateBox[{
         SubscriptBox["n", "j"]},
        "Ket"], 
       TemplateBox[{
         SubscriptBox["n", "k"]},
        "Ket"]}], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Alpha]", "=", 
         RowBox[{"-", "1"}]}], "1"], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"\[Beta]", "=", 
          RowBox[{"-", "1"}]}], "1"], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"\[Gamma]", "=", 
           RowBox[{"-", "1"}]}], "1"], "  ", 
         RowBox[{
          FractionBox[
           RowBox[{
            RowBox[{
             SubsuperscriptBox["\[Rho]", "\[Alpha]", "1"], "(", 
             SubscriptBox["n", "i"], ")"}], 
            RowBox[{
             SubsuperscriptBox["\[Rho]", 
              RowBox[{"-", "\[Alpha]"}], "1"], "(", 
             RowBox[{
              SubscriptBox["n", "i"], "+", "\[Alpha]"}], ")"}], 
            RowBox[{
             SubsuperscriptBox["\[Rho]", "\[Beta]", "1"], "(", 
             SubscriptBox["n", "j"], ")"}], 
            RowBox[{
             SubsuperscriptBox["\[Rho]", 
              RowBox[{"-", "\[Beta]"}], "1"], "(", 
             RowBox[{
              SubscriptBox["n", "i"], "+", "\[Beta]"}], ")"}], 
            RowBox[{
             SubsuperscriptBox["\[Rho]", "\[Gamma]", "1"], "(", 
             SubscriptBox["n", "k"], ")"}], 
            RowBox[{
             SubsuperscriptBox["\[Rho]", 
              RowBox[{"-", "\[Gamma]"}], "1"], "(", 
             RowBox[{
              SubscriptBox["n", "k"], "+", "\[Gamma]"}], ")"}]}], 
           RowBox[{
            SubscriptBox["\[Alpha]\[Omega]", "i"], "+", 
            SubscriptBox["\[Beta]\[Omega]", "j"], "+", 
            SubscriptBox["\[Gamma]\[Omega]", "k"]}]], 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            SubscriptBox["\[Delta]", 
             RowBox[{
             "\[Alpha]", "\[InvisibleSpace]", ",", "\[Beta]", ",", "\[Gamma]",
               ",", "0"}]]}], ")"}]}]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderscriptBox["\[Product]", "z"], 
       RowBox[{
        FractionBox["1", 
         SubscriptBox["\[Omega]", "z"]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            SubsuperscriptBox["\[Rho]", "1", "1"], "(", 
            SubscriptBox["n", "z"], ")"}], 
           RowBox[{
            SubsuperscriptBox["\[Rho]", 
             RowBox[{"-", "1"}], "1"], "(", 
            RowBox[{
             SubscriptBox["n", "z"], "+", "1"}], ")"}]}], "-", 
          RowBox[{
           RowBox[{
            SubsuperscriptBox["\[Rho]", 
             RowBox[{"-", "1"}], "1"], "(", 
            SubscriptBox["n", "z"], ")"}], 
           RowBox[{
            SubsuperscriptBox["\[Rho]", "1", "1"], "(", 
            RowBox[{
             SubscriptBox["n", "z"], "-", "1"}], ")"}]}]}], ")"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8121017038448763`*^9, 3.812101895096439*^9}, {
  3.812106545553658*^9, 3.812106645945855*^9}, {3.812106709272581*^9, 
  3.8121067555168943`*^9}, {3.812106813681637*^9, 3.812106859951703*^9}, {
  3.8121070656142387`*^9, 3.812107122106617*^9}, {3.812107178837508*^9, 
  3.812107191261087*^9}},ExpressionUUID->"a9d1c42e-7ade-4086-967d-\
bdd9468e185b"],

Cell["\<\
And now the hard part begins, because our goal setting out has always been to \
coerce this into a form that looks like\
\>", "ExpositoryText",
 CellChangeTimes->{{3.812027667481333*^9, 3.8120276872100286`*^9}, {
   3.812027738305429*^9, 3.8120277495709743`*^9}, 3.81209962136697*^9, 
   3.812107075562907*^9},ExpressionUUID->"5630f69b-b394-4166-858b-\
19aa8c0b0006"],

Cell[BoxData[
 FormBox[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    RowBox[{"i", "\[InvisibleSpace]", "j"}]], 
   RowBox[{
    RowBox[{
     SubscriptBox["x", 
      RowBox[{"i", "\[InvisibleSpace]", "j"}]], "(", 
     RowBox[{
      SubscriptBox["n", "i"], "+", 
      FractionBox["1", "2"]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["n", "j"], "+", 
      FractionBox["1", "2"]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.812020251383144*^9, 3.812020274186142*^9}, {
  3.8120281618532867`*^9, 
  3.812028167771679*^9}},ExpressionUUID->"a183700e-5a9a-46d9-b421-\
cc39eac1d3ef"],

Cell[TextData[{
 "and so here we need to note two things: a) this form is honestly pretty \
clunky for the equations we have, given that ours have 3 indices and this has \
2, and b) we\[CloseCurlyQuote]re going to need to figure out what the deal is \
with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Rho]", "\[Alpha]", "a"], "(", 
    SubscriptBox["n", "i"], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.8120252553949747`*^9, 3.812025277791541*^9}, {
   3.8120254335764523`*^9, 3.812025544802099*^9}, {3.812025685719198*^9, 
   3.8120257513746223`*^9}, {3.8120258700458317`*^9, 3.812025966676682*^9}, {
   3.8120261088314857`*^9, 3.8120261254483023`*^9}, {3.8120261877320147`*^9, 
   3.812026199997304*^9}, {3.812026711485095*^9, 3.812026724955296*^9}, {
   3.8120267820813923`*^9, 3.8120268951402082`*^9}, {3.812028382886897*^9, 
   3.8120284599245977`*^9}},ExpressionUUID->
  "df9b8599-3f0f-4c0e-8e7e-f1fd1b9679ed"],
 "."
}], "ExpositoryText",
 CellChangeTimes->{{3.812029027256528*^9, 3.812029144916143*^9}, {
  3.812105533343869*^9, 
  3.812105534225946*^9}},ExpressionUUID->"151099a0-3958-4b94-abde-\
4054b0fd022b"],

Cell["To focus on that second part, we\[CloseCurlyQuote]ll note that", \
"ExpositoryText",
 CellChangeTimes->{{3.812029127297307*^9, 3.812029154795933*^9}, {
   3.81202943790977*^9, 3.812029442120363*^9}, {3.812045262065773*^9, 
   3.812045262299708*^9}, {3.8121055895686283`*^9, 3.8121055948478527`*^9}, 
   3.812107515637479*^9},ExpressionUUID->"7fe6f93c-d837-41af-96d2-\
96b8a7db500e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[Rho]", "N", "\[Alpha]"], "(", 
    SubscriptBox["n", "i"], ")"}], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{"p", "\[Element]", 
      StyleBox[
       SubsuperscriptBox["P", "N", 
        RowBox[{" ", "\[Alpha]"}]],
       FontSize->14]}]], " ", 
    RowBox[{
     UnderscriptBox["\[Product]", 
      RowBox[{"l", "\[VeryThinSpace]", "\[Element]", "p"}]], 
     SqrtBox[
      FractionBox[
       RowBox[{
        SubscriptBox["n", "i"], "+", "l"}], "2"]]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8120294342277737`*^9, 3.812029467278864*^9}, 
   3.812029842761486*^9, {3.812029932665978*^9, 3.8120299552063932`*^9}, {
   3.8120459233981133`*^9, 3.8120459653035393`*^9}, {3.812105558759919*^9, 
   3.812105567189725*^9}},ExpressionUUID->"0693efa6-bc82-4ddd-b6d9-\
b7a74fa2e1be"],

Cell[TextData[{
 "Notes on generating the paths are given below. This means that for a path \
of length ",
 StyleBox["N",
  FontSlant->"Italic"],
 " we get a leading term of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SuperscriptBox[
     SqrtBox["2"], "N"]}], TraditionalForm]],ExpressionUUID->
  "ffa6d866-4577-4261-acec-eb9185ca65ba"],
 ", and so for even N we have a power of 1/2."
}], "ExpositoryText",
 CellChangeTimes->{{3.812105573640657*^9, 3.8121056065000134`*^9}, {
   3.812107528424807*^9, 3.812107603754005*^9}, 
   3.81210765971313*^9},ExpressionUUID->"395037b7-4d12-4c57-b101-\
660a7c130360"],

Cell["\<\
Next, we're unfortunately going to need to tabulate the relevant cases\
\>", "ExpositoryText",
 CellChangeTimes->{{3.812105573640657*^9, 3.8121056065000134`*^9}, {
  3.812107528424807*^9, 3.812107603754005*^9}, {3.8121076631334963`*^9, 
