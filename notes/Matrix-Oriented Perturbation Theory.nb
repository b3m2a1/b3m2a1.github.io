      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], 
       RowBox[{
        SubscriptBox["\[GothicCapitalB]", "n"], "(", 
