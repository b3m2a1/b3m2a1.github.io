Cell[BoxData[
 RowBox[{
  RowBox[{"cQMat2", "[", "b_", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"bigS1", "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{
        RowBox[{"b", "+", "1"}], ";;", "1", ";;", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{";;", 
        RowBox[{"b", "+", "1"}]}]}], "]"}], "]"}], "]"}], ".", 
   "\[IndentingNewLine]", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Binomial", "[", 
        RowBox[{"b", ",", " ", "w"}], "]"}], "/", 
       RowBox[{"2", "^", "w"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"w", ",", " ", "0", ",", " ", "b"}], "}"}]}], "]"}], "]"}], 
   ".", "\[IndentingNewLine]", 
   RowBox[{"bigS1", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{";;", 
       RowBox[{"b", "+", "1"}]}], ",", " ", 
      RowBox[{";;", 
       RowBox[{"b", "+", "1"}]}]}], "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.890829933099998*^9, 3.890830026260746*^9}, {
  3.890830057965108*^9, 3.890830062547358*^9}, {3.890830116285321*^9, 
  3.8908301182844133`*^9}},ExpressionUUID->"a7b56571-a18d-43f7-a43e-\
79fddcd366c0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"cMat", "[", "b_", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"With", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"S", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"StirlingS1", "[", 
          RowBox[{"k", ",", " ", "w"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "0", ",", " ", "b"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"w", ",", " ", "0", ",", " ", "b"}], "}"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"J", "=", 
       RowBox[{"Array", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"#", ",", " ", 
            RowBox[{"b", "-", "#2"}]}], "]"}], "&"}], ",", " ", 
         RowBox[{
          RowBox[{"{", 
