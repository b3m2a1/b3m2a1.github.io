        RowBox[{"(", 
         RowBox[{"a", "-", "i", "+", "n", "-", "1"}], ")"}]}]}]}]},
    {
     RowBox[{
      SubsuperscriptBox["P", "2", "a"], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
