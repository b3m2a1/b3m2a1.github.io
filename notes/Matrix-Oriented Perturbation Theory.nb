Cell[TextData[{
 "and in general we need to evaluate overlaps to get the correction to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "1", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "0cd0c9b6-fc27-4e48-91b3-88481f0c26cd"],
 " along ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "bedd83cc-0100-44d4-be32-377b2c21b401"],
 " but that is always 0 at first order so we\[CloseCurlyQuote]ll ignore it \
here."
}], "ExpositoryText",
 CellChangeTimes->{{3.821643421493403*^9, 
  3.821643486252832*^9}},ExpressionUUID->"dde49244-bdd7-4f61-84bf-\
31403717fbb9"],

Cell[TextData[{
 "Moving to second order stuff gets more interesting ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["E", 
    RowBox[{"(", "2", ")"}]], TraditionalForm]],ExpressionUUID->
  "4e5a6d92-2cc1-45f4-97e1-372a51fddf7e"],
 " now has a component from ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "c285588d-6e05-4604-a358-4a220899046a"],
 " but now also has a ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "1", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "17912541-cfe4-4cd1-978f-80445402d649"],
 " part from an energy shifted version of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],ExpressionUUID->
  "a0f78f12-8dc3-4baf-bc47-4e80c92a395d"]
}], "ExpositoryText",
 CellChangeTimes->{{3.821644436808179*^9, 3.821644446428823*^9}, {
   3.8216445541310263`*^9, 3.8216445932391653`*^9}, {3.8216448780955133`*^9, 
   3.821644890915207*^9}, 
   3.8216451906881104`*^9},ExpressionUUID->"982433aa-6377-4c33-835d-\
8edf2e0157b3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"$ptData", "[", 
    RowBox[{"[", 
     RowBox[{"\"\<E\>\"", ",", " ", "3"}], "]"}], "]"}], "=", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Dot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Phi]", "[", "$ptData", "]"}], "[", "0", "]"}], ",", " ", 
      RowBox[{
       RowBox[{"\[CapitalEta]", "[", "$ptData", "]"}], "[", "2", "]"}], ",", 
      " ", 
      RowBox[{
       RowBox[{"\[Phi]", "[", "$ptData", "]"}], "[", "0", "]"}]}], "]"}], "+",
     "\[IndentingNewLine]", 
    RowBox[{"Dot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Phi]", "[", "$ptData", "]"}], "[", "0", "]"}], ",", " ", 
      RowBox[{
       RowBox[{"\[CapitalDelta]n", "[", "$ptData", "]"}], "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalT]", "[", "$ptData", "]"}], ",", " ", "2", 
        ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{"Grid", "@", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
