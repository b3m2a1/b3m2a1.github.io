           RowBox[{
            SubscriptBox["\[Del]", "X"], "B"}], ")"}], 
          RowBox[{"2", "\[Rule]", "1"}]]}], ")"}], 
       RowBox[{"2", "\[Rule]", "1"}]], ")"}], 
     RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.7927858777962418`*^9, 3.7927859126262903`*^9}, 
   3.792786345521242*^9},ExpressionUUID->"d8c3f6cf-91b6-44bd-93e7-\
3a9f47b1ee6b"],

Cell["next splitting this term-wise by Property 5 we have", "Text",
 CellChangeTimes->{{3.792785989610825*^9, 3.792785993110677*^9}, {
  3.792787556022914*^9, 3.7927875567898417`*^9}, {3.7927878519286346`*^9, 
  3.79278786249535*^9}},ExpressionUUID->"56b473f5-b14f-4b25-9dd3-\
e1e70f18557b"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox[
       RowBox[{
        StyleBox["(",
         FontSlant->"Plain"], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[Del]", "X"], "A"}], ")"}], "\[CircleDot]", "B"}], 
        ")"}], 
       RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]], 
      "=", 
      RowBox[{
       SubscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Del]", "X"], "A"}], 
         StyleBox[")",
          FontSlant->"Plain"]}], 
        RowBox[{"i", "\[InvisibleSpace]", "j"}]], "\[CenterDot]", 
       SubscriptBox["B", 
        RowBox[{":", "k"}]]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{"(", 
        SubscriptBox[
         RowBox[{"(", 
          RowBox[{
           FractionBox["\[PartialD]", 
            RowBox[{"\[PartialD]", 
             SubscriptBox[
              StyleBox["x",
               FontSlant->"Italic"], "i"]}]], 
           SubscriptBox["A", 
            RowBox[{"j", "\[InvisibleSpace]", "n"}]]}], ")"}], 
         RowBox[{
          RowBox[{"n", "=", "1"}], ",", "\[VeryThinSpace]", "\[Ellipsis]", 
          ",", "\[VeryThinSpace]", 
          StyleBox["N",
           FontSlant->"Plain"]}]], ")"}], "\[CenterDot]", 
       RowBox[{"(", 
        SubscriptBox[
         RowBox[{"(", 
          SubscriptBox["B", 
           RowBox[{"n", "\[InvisibleSpace]\[InvisibleSpace]", "k"}]], ")"}], 
         RowBox[{
          RowBox[{"n", "=", "1"}], ",", "\[VeryThinSpace]", "\[Ellipsis]", 
          ",", "\[VeryThinSpace]", 
          StyleBox["N",
           FontSlant->"Plain"]}]], ")"}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"n", "=", "1"}], "N"], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox["\[PartialD]", 
           RowBox[{"\[PartialD]", 
            SubscriptBox[
             StyleBox["x",
              FontSlant->"Italic"], "i"]}]], 
          SubscriptBox["A", 
           RowBox[{"j", "\[InvisibleSpace]", "n"}]]}], ")"}], 
        SubscriptBox["B", 
         RowBox[{"n", "\[InvisibleSpace]\[InvisibleSpace]", "k"}]]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.7927859950247593`*^9, 3.792786011849875*^9}, {
  3.792786048384823*^9, 3.792786097013842*^9}, {3.792786138276535*^9, 
  3.792786177596869*^9}, {3.7927862580266*^9, 3.792786298561615*^9}, {
  3.792786641060604*^9, 3.792786641923993*^9}, {3.792787606235362*^9, 
  3.7927876191075487`*^9}},ExpressionUUID->"1b5d2db1-4e8f-4f33-bb5c-\
afc497ade56a"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox[
       RowBox[{
        StyleBox["(",
         FontSlant->"Plain"], 
        SubscriptBox[
         RowBox[{"(", 
          RowBox[{"A", "\[CircleDot]", 
           SubscriptBox[
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["\[Del]", "X"], "B"}], ")"}], 
            RowBox[{"2", "\[Rule]", "1"}]]}], ")"}], 
         RowBox[{"2", "\[Rule]", "1"}]], ")"}], 
       RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]], 
      "=", 
      SubscriptBox[
       RowBox[{
        StyleBox["(",
         FontSlant->"Plain"], 
        RowBox[{"A", "\[CircleDot]", 
         SubscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Del]", "X"], "B"}], ")"}], 
          RowBox[{"2", "\[Rule]", "1"}]]}], ")"}], 
       RowBox[{"ji", "\[InvisibleSpace]", "k"}]]}]},
    {
     RowBox[{"=", 
      RowBox[{
       SubscriptBox["A", "j"], "\[CenterDot]", 
       SubscriptBox[
        RowBox[{"(", 
         SubscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Del]", "X"], "B"}], ")"}], 
          RowBox[{"2", "\[Rule]", "1"}]], ")"}], 
        RowBox[{":", "ik"}]]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       SubscriptBox["A", "j"], "\[CenterDot]", 
       SubscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Del]", "X"], "B"}], ")"}], 
        RowBox[{"i", ":", "k"}]]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{"(", 
        SubscriptBox[
         RowBox[{"(", 
          SubscriptBox["A", 
           RowBox[{"j", "\[InvisibleSpace]", "n"}]], ")"}], 
         RowBox[{
          RowBox[{"n", "=", "1"}], ",", "\[VeryThinSpace]", "\[Ellipsis]", 
          ",", "\[VeryThinSpace]", 
          StyleBox["N",
           FontSlant->"Plain"]}]], ")"}], "\[CenterDot]", 
       RowBox[{"(", 
        SubscriptBox[
         RowBox[{"(", 
          RowBox[{
           FractionBox["\[PartialD]", 
            RowBox[{"\[PartialD]", 
             SubscriptBox[
              StyleBox["x",
               FontSlant->"Italic"], "i"]}]], 
           SubscriptBox["B", 
            RowBox[{"n", "\[InvisibleSpace]", "k"}]]}], ")"}], 
         RowBox[{
          RowBox[{"n", "=", "1"}], ",", "\[VeryThinSpace]", "\[Ellipsis]", 
          ",", "\[VeryThinSpace]", 
          StyleBox["N",
           FontSlant->"Plain"]}]], ")"}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"n", "=", "1"}], "N"], 
       RowBox[{
        RowBox[{"(", 
         SubscriptBox["A", 
          RowBox[{"j", "\[InvisibleSpace]", "n"}]], ")"}], 
        RowBox[{
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
           SubscriptBox[
            StyleBox["x",
             FontSlant->"Italic"], "i"]}]], 
         SubscriptBox["B", 
          RowBox[{"n", "\[InvisibleSpace]\[InvisibleSpace]", "k"}]]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.7927859950247593`*^9, 3.792786011849875*^9}, {
   3.792786048384823*^9, 3.792786097013842*^9}, {3.792786138276535*^9, 
   3.792786177596869*^9}, {3.7927862580266*^9, 3.792786298561615*^9}, {
   3.792786333708181*^9, 3.79278650677658*^9}, 3.792786611040431*^9, 
   3.7927867213478928`*^9, {3.792787063382565*^9, 3.792787069869957*^9}, {
