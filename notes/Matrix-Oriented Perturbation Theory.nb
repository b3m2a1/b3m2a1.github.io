Cell[CellGroupData[{

Cell["Lattice Paths / Raising-Lowering Relations", "Section",
 CellChangeTimes->{{3.888338412919734*^9, 
  3.8883384239304447`*^9}},ExpressionUUID->"ee7347da-b1e4-4f1c-8c88-\
77b509e13358"],

Cell["\<\
We can encode any string of raising/lowering operations as a lattice paths on \
a diagonal grid, for instance, here are the paths of length 16 that have \
value 6 after 8 steps\
\>", "ExpositoryText",
 CellChangeTimes->{{3.889010016990842*^9, 
  3.889010062912739*^9}},ExpressionUUID->"57b295ab-ac5d-4816-ab06-\
326cfb8ad75f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"quickBlock", "[", 
  RowBox[{"8", ",", " ", "2"}], "]"}]], "Input",
 CellChangeTimes->{{3.889010038578474*^9, 3.8890100414623137`*^9}},
 CellLabel->
  "In[2228]:=",ExpressionUUID->"81b6961e-8e77-4cbd-9417-4838aed75837"],

Cell[BoxData[
 GraphicsBox[
  GeometricTransformationBox[{
    LineBox[{{{0, 0}, {0, 8}}, {{1, 0}, {1, 8}}, {{2, 0}, {2, 8}}, {{3, 0}, {
     3, 8}}, {{4, 0}, {4, 8}}, {{5, 0}, {5, 8}}, {{6, 0}, {6, 8}}, {{7, 0}, {
     7, 8}}, {{8, 0}, {8, 8}}, {{0, 0}, {8, 0}}, {{0, 1}, {8, 1}}, {{0, 2}, {
     8, 2}}, {{0, 3}, {8, 3}}, {{0, 4}, {8, 4}}, {{0, 5}, {8, 5}}, {{0, 6}, {
     8, 6}}, {{0, 7}, {8, 7}}, {{0, 8}, {8, 8}}}], 
    {RGBColor[1, 0, 0], Thickness[Large], 
     LineBox[{{{0, 0}, {0, 5}}, {{1, 0}, {1, 5}}, {{2, 0}, {2, 5}}, {{3, 0}, {
      3, 5}}, {{0, 0}, {3, 0}}, {{0, 1}, {3, 1}}, {{0, 2}, {3, 2}}, {{0, 3}, {
      3, 3}}, {{0, 4}, {3, 4}}, {{0, 5}, {3, 5}}}], 
     LineBox[{{{3, 5}, {3, 8}}, {{4, 5}, {4, 8}}, {{5, 5}, {5, 8}}, {{6, 5}, {
      6, 8}}, {{7, 5}, {7, 8}}, {{8, 5}, {8, 8}}, {{3, 5}, {8, 5}}, {{3, 6}, {
      8, 6}}, {{3, 7}, {8, 7}}, {{3, 8}, {8, 8}}}]}}, {{{0.7071067811865475, 
    0.7071067811865475}, {-0.7071067811865475, 0.7071067811865475}}, 
    Center}]]], "Output",
 CellChangeTimes->{3.8890100417075872`*^9},
 CellLabel->
  "Out[2228]=",ExpressionUUID->"b846a52e-7898-41f9-88ea-7009c64f36ff"]
}, Open  ]],

Cell[TextData[{
 "For any two blocks that meet at a point, we can express the total \
polynomial from the combination of those paths as the product of two \
polynomial terms, e.g. for the block above the total polynomial for those \
paths is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["K", "3", "5"], "(", "n", ")"}], 
    RowBox[{
     SubsuperscriptBox["K", "3", "5"], "(", "n", ")"}]}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "174a8e28-b990-4cc6-860b-c5847829a0c2"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["K", "b", "a"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "d994a519-ee21-4fdc-8900-186b7a7371f1"],
 " indicates that we have gone up ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "a3188e32-3fe0-4e8f-90c5-f001b7472e1d"],
 " steps and down ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "a9c5a823-6f5d-4bd4-b88e-dd195febd6e6"],
 " steps"
}], "ExpositoryText",
 CellChangeTimes->{{3.889010081293022*^9, 
  3.889010187634351*^9}},ExpressionUUID->"a7592b18-b86b-422c-b8eb-\
5e35012fa17a"],

Cell[TextData[{
 "Naturally, from this we see that to get the total polynomial over these 16 \
steps, we can add up the polynomials induced by each point in the center (and \
in fact we can add up the polynomials induced by ",
 StyleBox["any",
  FontSlant->"Italic"],
 " column), giving us"
}], "ExpositoryText",
 CellChangeTimes->{{3.8890102263661747`*^9, 
  3.889010289748149*^9}},ExpressionUUID->"435b2704-315d-46cd-bef5-\
6d2fe491c9c2"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["K", "8", "8"], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          SubsuperscriptBox["K", "0", "8"], "(", "n", ")"}], 
         RowBox[{
          SubsuperscriptBox["K", "8", "0"], "(", "n", ")"}]}], " ", "+", " ", 
        
        RowBox[{
         RowBox[{
          SubsuperscriptBox["K", "1", "7"], "(", "n", ")"}], 
         RowBox[{
          SubsuperscriptBox["K", "7", "1"], "(", "n", ")"}]}], " ", "+", " ", 
        
        RowBox[{
         RowBox[{
          SubsuperscriptBox["K", "2", "6"], "(", "n", ")"}], 
         RowBox[{
          SubsuperscriptBox["K", "6", "2"], "(", "n", ")"}]}], " ", "+"}], 
       " ", "..."}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "8"], " ", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["K", "i", 
          RowBox[{"8", "-", "i"}]], "(", "n", ")"}], 
        RowBox[{
         SubsuperscriptBox["K", 
          RowBox[{"8", "-", "i"}], "i"], "(", "n", ")"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.889010291495682*^9, 3.889010315639368*^9}, {
  3.889010365912188*^9, 
  3.889010475092277*^9}},ExpressionUUID->"79e3fbb0-de2f-4b0c-a45f-\
21efb3f55a9c"],

Cell["We can show, moreover, that", "ExpositoryText",
 CellChangeTimes->{{3.889010204188534*^9, 3.88901020867271*^9}, {
  3.889010508432787*^9, 3.889010512256351*^9}, {3.88901056615114*^9, 
