f017bdb07935"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["A", "n", 
       RowBox[{"(", "k", ")"}]], "=", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"M", "=", "1"}], "k"], " ", 
        RowBox[{
         UnderscriptBox["\[Sum]", 
          RowBox[{
           StyleBox["p",
            FontSize->14], "\[Element]", 
           StyleBox[
            SubsuperscriptBox["\[CapitalXi]", "k", "M"],
            FontSize->14]}]], " ", 
         RowBox[{
          RowBox[{"(", "\[VeryThinSpace]", 
           RowBox[{
            UnderoverscriptBox["\[Product]", 
             RowBox[{"i", "=", "1"}], 
             RowBox[{"M", "-", "2"}]], 
            RowBox[{
             SubsuperscriptBox["\[CapitalDelta]H", "n", 
              RowBox[{"(", 
               StyleBox[
                SubscriptBox["p", "i"],
                FontSize->14], ")"}]], 
             RowBox[{
              SubscriptBox["\[CapitalPi]", "n"], "(", 
              RowBox[{
               RowBox[{
                SubscriptBox["\[CapitalPi]", "m"], 
                SubsuperscriptBox["\[CapitalDelta]H", "m", 
                 RowBox[{"(", "0", ")"}]]}], "+", 
               SubscriptBox["P", "m"]}], ")"}]}]}], ")"}], 
          SubsuperscriptBox["\[CapitalDelta]H", "n", 
           RowBox[{"(", 
            SubscriptBox["p", 
             RowBox[{"M", "-", "1"}]], ")"}]], 
          TemplateBox[{
            RowBox[{
              SuperscriptBox["n", 
               RowBox[{"(", "0", ")"}]], " "}], 
            RowBox[{"\[VeryThinSpace] ", 
              SuperscriptBox["n", 
               RowBox[{"(", 
                 SubscriptBox["p", "M"], ")"}]]}]},
           "BraKet"]}]}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", "\[VeryThinSpace]", 
         RowBox[{
          UnderoverscriptBox["\[Product]", 
           RowBox[{"i", "=", "1"}], 
           RowBox[{"M", "-", "1"}]], 
          RowBox[{
           SubsuperscriptBox["\[CapitalDelta]H", "n", 
            RowBox[{"(", 
             StyleBox[
              SubscriptBox["p", "i"],
              FontSize->14], ")"}]], 
           RowBox[{
            SubscriptBox["\[CapitalPi]", "n"], "(", 
            RowBox[{
             RowBox[{
              SubscriptBox["\[CapitalPi]", "m"], 
              SubsuperscriptBox["\[CapitalDelta]H", "m", 
               RowBox[{"(", "0", ")"}]]}], "+", 
             SubscriptBox["P", "m"]}], ")"}]}]}], ")"}], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", 
          SubscriptBox["p", "M"], ")"}]]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"M", "=", "1"}], "k"], " ", 
        RowBox[{
         UnderscriptBox["\[Sum]", 
          RowBox[{
           StyleBox["p",
            FontSize->14], "\[Element]", 
           StyleBox[
            SubsuperscriptBox["\[CapitalXi]", "k", "M"],
            FontSize->14]}]], " ", 
         RowBox[{
          RowBox[{"(", "\[VeryThinSpace]", 
           RowBox[{
            UnderoverscriptBox["\[Product]", 
             RowBox[{"i", "=", "1"}], 
             RowBox[{"M", "-", "2"}]], 
            RowBox[{
             SubsuperscriptBox["\[CapitalDelta]H", "n", 
              RowBox[{"(", 
               StyleBox[
                SubscriptBox["p", "i"],
                FontSize->14], ")"}]], "(", 
             RowBox[{
              RowBox[{
               SubscriptBox["\[CapitalPi]", "n"], 
               SubscriptBox["\[CapitalPi]", "m"], 
               SubsuperscriptBox["\[CapitalDelta]H", "m", 
                RowBox[{"(", "0", ")"}]]}], "+", 
              FractionBox[
               RowBox[{
                TemplateBox[{
                  RowBox[{"\[VeryThinSpace]", 
                    SuperscriptBox["m", 
                    RowBox[{"(", "0", ")"}]]}]},
                 "Ket"], 
                TemplateBox[{
                  SuperscriptBox["m", 
                   RowBox[{"(", "0", ")"}]]},
                 "Bra"]}], 
               RowBox[{
                SubsuperscriptBox["E", "m", 
                 RowBox[{"(", "0", ")"}]], "-", 
                SubsuperscriptBox["E", "n", 
                 RowBox[{"(", "0", ")"}]]}]]}], ")"}]}], ")"}], 
          SubsuperscriptBox["\[CapitalDelta]H", "n", 
           RowBox[{"(", 
            SubscriptBox["p", 
             RowBox[{"M", "-", "1"}]], ")"}]], 
          TemplateBox[{
            RowBox[{
              SuperscriptBox["n", 
               RowBox[{"(", "0", ")"}]], " "}], 
            RowBox[{"\[VeryThinSpace] ", 
              SuperscriptBox["n", 
               RowBox[{"(", 
                 SubscriptBox["p", "M"], ")"}]]}]},
           "BraKet"]}]}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", "\[VeryThinSpace]", 
         RowBox[{
          UnderoverscriptBox["\[Product]", 
           RowBox[{"i", "=", "1"}], 
           RowBox[{"M", "-", "1"}]], 
          RowBox[{
           SubsuperscriptBox["\[CapitalDelta]H", "n", 
            RowBox[{"(", 
             StyleBox[
              SubscriptBox["p", "i"],
              FontSize->14], ")"}]], "(", 
