   3.827714929408407*^9}},ExpressionUUID->"dbaaf8df-7fd1-41bf-ba9c-\
0d7b0b65975f"],

Cell[TextData[{
 "with this we can see that the form of our terms will come out so that the \
sum of all of the exponents is always ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "d9555329-da8d-4a4b-8766-2930da1dabf1"],
 ". Furthermore, we\[CloseCurlyQuote]ll note that we can add up these \
coefficients in strings of up to length ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "e49bc8e5-74d3-4980-ac5a-06a69f40c525"],
 ". Our inductive hypothesis will be as follows. For every ",
 Cell[BoxData[
  FormBox[
   RowBox[{"j", "<", "k"}], TraditionalForm]],ExpressionUUID->
  "ec264aa6-ef59-4956-9276-7786616fab47"],
 ", we will denote the set of all unique permutations of integer partitions \
of ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "1d440794-94ee-4b6f-96d9-f63649441de5"],
 " of length ",
 StyleBox["M",
  FontSlant->"Italic"],
 " as ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalXi]", "j", "M"], TraditionalForm]],
  ExpressionUUID->"f818fb05-5fc4-4e2e-89cb-ebe4ff6a9a10"],
 " (these may be indexed, like the Schur Polynomials, by the semistandard \
Young Tableaux) and suppose"
}], "ExpositoryText",
 CellChangeTimes->{{3.8277147803349752`*^9, 3.827714834380781*^9}, {
  3.827715327308277*^9, 3.827715398237859*^9}, {3.82771546557323*^9, 
  3.8277155481550903`*^9}, {3.827715676858425*^9, 3.827715681723735*^9}, {
  3.827716117461231*^9, 3.827716144077504*^9}, {3.827716291454958*^9, 
  3.82771635938391*^9}, {3.827760761106083*^9, 
  3.827760778945819*^9}},ExpressionUUID->"52d03ed0-ede3-4021-91b5-\
899c34aa8fdf"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["A", "n", 
    RowBox[{"(", "j", ")"}]], "=", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"M", "=", "1"}], "j"], " ", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{"p", "\[Element]", 
        StyleBox[
         SubsuperscriptBox["\[CapitalXi]", "j", "M"],
         FontSize->14]}]], 
      RowBox[{
       RowBox[{"(", "\[VeryThinSpace]", 
        RowBox[{
         UnderoverscriptBox["\[Product]", 
          RowBox[{"i", "=", "1"}], 
          RowBox[{"M", "-", "2"}]], 
         RowBox[{
          SubsuperscriptBox["\[CapitalDelta]H", "n", 
           RowBox[{"(", 
            StyleBox[
             SubscriptBox["p", "i"],
             FontSize->14], ")"}]], 
          SubscriptBox["\[CapitalPi]", "n"]}]}], ")"}], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", 
         SubscriptBox["p", 
          RowBox[{"M", "-", "1"}]], ")"}]], 
       TemplateBox[{
         RowBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]], " "}], 
         RowBox[{"\[VeryThinSpace] ", 
           SuperscriptBox["n", 
            RowBox[{"(", 
              SubscriptBox["p", "M"], ")"}]]}]},
        "BraKet"]}]}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"(", "\[VeryThinSpace]", 
      RowBox[{
       UnderoverscriptBox["\[Product]", 
        RowBox[{"i", "=", "1"}], 
        RowBox[{"M", "-", "1"}]], 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", 
          StyleBox[
           SubscriptBox["p", "i"],
           FontSize->14], ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"]}]}], ")"}], 
     SubsuperscriptBox["\[CapitalDelta]H", "n", 
      RowBox[{"(", 
       SubscriptBox["p", "M"], ")"}]]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.827715985727779*^9, 3.8277161539403133`*^9}, {
   3.82771628055515*^9, 3.827716284715293*^9}, {3.8277163218125153`*^9, 
   3.827716327334283*^9}, {3.827716366077015*^9, 3.827716463471806*^9}, 
   3.827716532247507*^9},ExpressionUUID->"8c504f76-b58c-4d29-95cf-\
7fb7bc4122e3"],

Cell[TextData[{
 "where we\[CloseCurlyQuote]re just defining ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalDelta]H", "n", 
     RowBox[{"(", 
      SubscriptBox["p", 
       RowBox[{"M", "-", "1"}]], ")"}]], "=", "\[DoubleStruckZero]"}], 
   TraditionalForm]],
  CellChangeTimes->{{3.827715985727779*^9, 3.8277161539403133`*^9}, {
   3.82771628055515*^9, 3.827716284715293*^9}, {3.8277163218125153`*^9, 
   3.827716327334283*^9}, {3.827716366077015*^9, 3.827716463471806*^9}},
  ExpressionUUID->"7f390104-a373-485d-83d7-316855965f56"],
 " if ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "\[LessEqual]", "1"}], TraditionalForm]], "ExpositoryText",
  ExpressionUUID->"dded62ac-bdfb-45a0-a7be-7b9b9c97adcc"]
}], "ExpositoryText",
 CellChangeTimes->{{3.827716496140065*^9, 
  3.827716529641244*^9}},ExpressionUUID->"39252a19-c51d-4a25-9ebe-\
ce00fc218d45"],

Cell["\<\
Now, I know this doesn\[CloseCurlyQuote]t seem like a nice inductive \
hypothesis, but if we can prove that it holds this will bear fruit. So now we\
\[CloseCurlyQuote]ll note that \
\>", "ExpositoryText",
 CellChangeTimes->{{3.8277165468898687`*^9, 
  3.82771657771521*^9}},ExpressionUUID->"b6891d99-5394-43d5-b470-\
c3cebce95a41"],

