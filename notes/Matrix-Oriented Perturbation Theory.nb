Cell["\<\
By doing this, we\[CloseCurlyQuote]re able to get the kinds of total \
transformations that are supported...which isn\[CloseCurlyQuote]t actually \
quite the question we wanted to answer initially (but it still useful as it \
gives a sense for the number of index combos we need to consider). What we \
really want is to know which operators contribute...to do that, we actually \
need to keep more information as we consider our cases. In particular, when \
we do our paring of the Cartesian products of terms, we need to track which \
set of indices the terms came from, which will allow us to track what changes \
we have overall.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8135972823813257`*^9, 3.813597377667658*^9}, {
  3.813600834564074*^9, 3.8136008957157173`*^9}, {3.813600929835341*^9, 
  3.8136009927320223`*^9}},ExpressionUUID->"eebef7ec-a696-4440-af53-\
f00d063e59c4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Inverting The X-Matrix", "Subsection",
 CellChangeTimes->{{3.814536297426162*^9, 
  3.814536315458869*^9}},ExpressionUUID->"c48b3842-63a7-46c2-bf72-\
f87d5b37e676"],

Cell["\<\
An alternate approach to get things like the X matrix and Y tensor is to \
simply generate enough perturbation theory results that we can invert to get \
them.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.814536317311726*^9, 
  3.814536373912237*^9}},ExpressionUUID->"de5c9ed2-60e4-4a31-8bad-\
bf8090a4ed81"],

Cell["We\[CloseCurlyQuote]ll write out the energy in general as", \
"ExpositoryText",
 CellChangeTimes->{{3.814536404470693*^9, 
  3.814536413965116*^9}},ExpressionUUID->"7cbe7699-f0f9-4151-9c2f-\
28e2c3f2f217"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["E", 
    StyleBox["n",
     FontWeight->"Bold"], 
    RowBox[{"(", "o", ")"}]], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"k", "=", "0"}], "m"], "\[VeryThinSpace]", 
    RowBox[{
     SubsuperscriptBox["\[Epsilon]", "k", 
      RowBox[{"(", "o", ")"}]], 
     SubscriptBox["\[CircleDot]", "k"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        StyleBox["n",
         FontWeight->"Bold"], "+", 
        FractionBox["1", "2"]}], ")"}], "k"]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.814536415968026*^9, 3.8145365059353733`*^9}, {
   3.814538636747016*^9, 3.814538637118484*^9}, {3.814539185090823*^9, 
   3.814539214172648*^9}, {3.814539351858555*^9, 3.814539352636023*^9}, 
   3.8145401595161743`*^9},ExpressionUUID->"e670f31a-659b-4901-a74d-\
af9c5ae2c7de"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Epsilon]", "k", 
    RowBox[{"(", "o", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.814536415968026*^9, 3.8145365059353733`*^9}},
  ExpressionUUID->"30860f89-41a4-4b41-b6c0-2884a82c3719"],
 " is the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["k", "th"], TraditionalForm]],ExpressionUUID->
  "3ec25b77-8a95-4978-b57d-90e1b2ee94b9"],
 " order tensor correction to the energy at the ",
 Cell[BoxData[
  FormBox["o", TraditionalForm]],ExpressionUUID->
  "8dc43ef7-42e3-4335-a860-eb6cc58c5d5f"],
 " order of PT. The exact relationship between the order of PT we use and the \
max ",
 StyleBox["m",
  FontSlant->"Italic"],
 " isn\[CloseCurlyQuote]t totally obvious, but at the very least we know that \
we get an extra order of correction for every 2 orders of PT."
}], "ExpositoryText",
 CellChangeTimes->{{3.814536507673483*^9, 3.8145365269656067`*^9}, {
  3.8145392179920607`*^9, 3.814539241054406*^9}, {3.814540176438436*^9, 
  3.8145402600756493`*^9}},ExpressionUUID->"f0ffc4d8-2c20-445a-ab76-\
4db273479956"],

Cell["\<\
We can string this all out into one rather long and involved summation as\
\>", "ExpositoryText",
 CellChangeTimes->{{3.814581867979465*^9, 
  3.814581891174818*^9}},ExpressionUUID->"e040d746-e6c6-4b39-877b-\
008af78258cb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["E", 
    StyleBox["n",
     FontWeight->"Bold"], 
    RowBox[{"(", "o", ")"}]], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"k", "=", "0"}], "m"], "\[VeryThinSpace] ", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"p", "\[Element]", 
       RowBox[{"inds", "(", "k", ")"}]}]], 
     RowBox[{
      SubscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox["\[Epsilon]", "k", 
         RowBox[{"(", "o", ")"}]], ")"}], "p"], 
      RowBox[{
       UnderscriptBox["\[Product]", 
        RowBox[{"i", "\[Element]", "p"}]], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["n", "i"], "+", 
         FractionBox["1", "2"]}], ")"}]}]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.814581896671731*^9, 3.814581967302969*^9}, {
  3.814582170033942*^9, 
  3.814582175825738*^9}},ExpressionUUID->"c437ebfc-0a29-4c34-ab29-\
a201f026f81f"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"inds", 
    RowBox[{"(", "k", ")"}]}], TraditionalForm]],ExpressionUUID->
  "caf923c1-58b7-4f9a-84b3-0f61b5a42d58"],
 " is just the set of indices appropriate for the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["k", "th"], TraditionalForm]],ExpressionUUID->
  "7242347b-cecd-4c54-b53d-2a61777385b9"],
 " energy correction tensor."
}], "ExpositoryText",
 CellChangeTimes->{{3.8145819927438717`*^9, 
  3.814582025678089*^9}},ExpressionUUID->"db20f0d2-4233-459d-b78b-\
ee4fe7f00b27"],

Cell[TextData[{
 "Why is this nice? Well if we have energies for enough sets of ",
 Cell[BoxData[
  FormBox[
   StyleBox["n",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "47844afd-e693-4027-94f8-b955bdde080c"],
 ", we can string them together and use"
}], "ExpositoryText",
 CellChangeTimes->{{3.814582027795391*^9, 3.8145821036544867`*^9}, {
  3.814582143743704*^9, 
  3.8145821446753473`*^9}},ExpressionUUID->"17540e8f-c400-4e1f-b39f-\
4f4a19203ee3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["C", 
    StyleBox[
     RowBox[{
      StyleBox["n",
       FontWeight->"Bold"], "p"}]]], "=", 
   RowBox[{
    UnderscriptBox["\[Product]", 
     RowBox[{"i", "\[Element]", "p"}]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["n", "i"], "+", 
      FractionBox["1", "2"]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.814582105040215*^9, 
  3.8145821390635633`*^9}},ExpressionUUID->"15ee1bb8-bdaf-4693-bba8-\
04fef00aefc3"],

Cell[TextData[{
 "to get a big ol\[CloseCurlyQuote] set of linear equations that we can \
directly invert. This will give us a vector representation of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"(", 
     SubsuperscriptBox["\[Epsilon]", "k", 
      RowBox[{"(", "o", ")"}]], ")"}], "p"], TraditionalForm]],
  CellChangeTimes->{{3.814581896671731*^9, 3.814581967302969*^9}, {
   3.814582170033942*^9, 3.814582175825738*^9}},ExpressionUUID->
  "852bdc0e-d8c1-4fea-b958-d5fd78c9022b"],
 " that we\[CloseCurlyQuote]ll need to reshape into its proper tensors."
}], "ExpositoryText",
 CellChangeTimes->{{3.814582107452601*^9, 3.814582118255802*^9}, {
  3.8145821488824167`*^9, 
  3.814582196910942*^9}},ExpressionUUID->"cd39150b-528e-4414-a924-\
9d49c02c9b10"],

Cell["We\[CloseCurlyQuote]ll make a replacement where we say", \
"ExpositoryText",
 CellChangeTimes->{{3.814578723049903*^9, 
  3.814578744624816*^9}},ExpressionUUID->"4ddf3d92-8957-4791-9383-\
eed1eb476f2f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["a", "i"], "=", 
   RowBox[{
    SubscriptBox["n", "i"], "+", 
    FractionBox["1", "2"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8145788191207523`*^9, 
  3.814578839128459*^9}},ExpressionUUID->"f5f0224f-4160-4403-8aec-\
d548f431053b"],

Cell["which is nice because we can then write", "ExpositoryText",
 CellChangeTimes->{{3.8145788287428427`*^9, 3.814578833814917*^9}, {
  3.814578926214897*^9, 
  3.814578927288774*^9}},ExpressionUUID->"52c5144d-9b36-4b27-ad6c-\
33f2f3754787"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["E", 
    StyleBox["n",
     FontWeight->"Bold"], 
    RowBox[{"(", "o", ")"}]], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"k", "=", "0"}], "m"], "\[VeryThinSpace]", 
    RowBox[{
     SubsuperscriptBox["\[Epsilon]", "k", 
      RowBox[{"(", "o", ")"}]], 
     SubscriptBox["\[CircleDot]", "k"], 
     SuperscriptBox[
      StyleBox["a",
       FontWeight->"Bold"], "k"]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.814578857761878*^9, 3.8145788584508877`*^9}, {
  3.814578930700182*^9, 3.814578936420968*^9}, {3.814579112017164*^9, 
  3.81457911293574*^9}},ExpressionUUID->"ee05e91d-0230-4b3c-a11c-\
1794952be2e6"],

Cell[TextData[{
 "which is just notationally simpler. It should be noted that the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["a",
     FontWeight->"Bold"], "k"], TraditionalForm]],
  CellChangeTimes->{{3.814578857761878*^9, 3.8145788584508877`*^9}, {
   3.814578930700182*^9, 3.814578936420968*^9}},ExpressionUUID->
  "a073e20f-e76a-450c-8d85-e9b6e60c992b"],
 " is the iterated outer product of the ",
 Cell[BoxData[
  FormBox[
   StyleBox["a",
    FontWeight->"Bold"], TraditionalForm]],
  CellChangeTimes->{{3.814578857761878*^9, 3.8145788584508877`*^9}, {
   3.814578930700182*^9, 3.814578936420968*^9}},ExpressionUUID->
  "63eb2fd0-794f-4546-be18-3b6a961ea72a"],
 " vector with itself."
}], "ExpositoryText",
 CellChangeTimes->{{3.8145789427819777`*^9, 3.814578951498912*^9}, {
  3.814579042146059*^9, 
  3.814579068000692*^9}},ExpressionUUID->"bcea8a0b-bb2a-4d84-8f5e-\
4025cac4d4e0"],

Cell[CellGroupData[{

Cell["First-Order Correction", "Subsubsection",
 CellChangeTimes->{{3.814579411450358*^9, 
  3.8145794240698357`*^9}},ExpressionUUID->"4b996ef4-8fff-4766-b7f3-\
844c7e7a7346"],

Cell[TextData[{
 "We\[CloseCurlyQuote]d like to be able to back-out what the ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Epsilon]", "k", 
    RowBox[{"(", "o", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.814578857761878*^9, 3.8145788584508877`*^9}, {
   3.814578930700182*^9, 3.814578936420968*^9}},ExpressionUUID->
  "76647029-e76d-42a3-989b-95de494a4230"],
 " terms look like from the energies, assuming this ansatz. We\
\[CloseCurlyQuote]ll start with just the first-order terms and see if we can \
work out what\[CloseCurlyQuote]s going on there."
}], "ExpositoryText",
 CellChangeTimes->{{3.814578961535532*^9, 3.814578999591998*^9}, {
  3.814579132691486*^9, 3.8145791345018377`*^9}, {3.814579442204502*^9, 
  3.81457945813523*^9}},ExpressionUUID->"16f584b6-b491-4c1e-87bb-\
5634cf02f9e3"],

Cell["To do that, we\[CloseCurlyQuote]ll start with", "ExpositoryText",
 CellChangeTimes->{{3.8145801087133417`*^9, 
  3.814580145209158*^9}},ExpressionUUID->"ac338a2c-40db-4aa5-8b3c-\
cf2c3f34673d"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["E", 
        SubscriptBox["n", "i"], 
        RowBox[{"(", "o", ")"}]], "-", 
       SubsuperscriptBox["E", "0", 
        RowBox[{"(", "o", ")"}]]}], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "0"}], "m"], "\[VeryThinSpace]", 
       RowBox[{
        SubsuperscriptBox["\[Epsilon]", "k", 
         RowBox[{"(", "o", ")"}]], 
        SubscriptBox["\[CircleDot]", "k"], 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              SubscriptBox["n", "i"], "\[InvisibleSpace]", 
              SubscriptBox["\[Delta]", "i"]}], "+", 
             FractionBox["1", "2"]}], ")"}], "k"], "-", 
          SuperscriptBox[
           RowBox[{"(", 
            FractionBox["1", "2"], ")"}], "k"]}], ")"}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "1"}], "m"], " ", 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"p", "\[Element]", 
          RowBox[{"inds", "(", "k", ")"}]}]], 
        RowBox[{
         SubscriptBox[
          RowBox[{"(", 
           SubsuperscriptBox["\[Epsilon]", "k", 
            RowBox[{"(", "o", ")"}]], ")"}], "p"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               SubscriptBox["n", "i"], "+", 
               FractionBox["1", "2"]}], ")"}], 
             RowBox[{"count", "(", 
              RowBox[{"p", ",", " ", "i"}], ")"}]], 
            SuperscriptBox[
             RowBox[{"(", 
              FractionBox["1", "2"], ")"}], 
             RowBox[{
              FractionBox["1", "2"], 
              RowBox[{"(", 
               RowBox[{"k", "-", 
                RowBox[{"count", "(", 
                 RowBox[{"p", ",", " ", "i"}], ")"}]}], ")"}]}]]}], "-"}], 
          ")"}]}]}]}]}]},
    {"="}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8145801365088387`*^9, 3.8145802378810577`*^9}, {
  3.814580379922646*^9, 3.814580402438699*^9}, {3.814580984186591*^9, 
  3.814581072494637*^9}, {3.81458110444585*^9, 3.814581220705886*^9}, {
  3.8145812544121323`*^9, 3.814581263003825*^9}, {3.814581293498564*^9, 
  3.814581325046446*^9}, {3.8145813989241323`*^9, 3.81458150134834*^9}},
 FontSize->18,ExpressionUUID->"18c772e2-d99a-459d-9d6d-544288fa251c"],

Cell["and to make sense of this, we note that we can write", "ExpositoryText",
 CellChangeTimes->{{3.8145803361801443`*^9, 
  3.814580346375761*^9}},ExpressionUUID->"b529d61d-3498-4dc9-a04b-\
82161bb6540c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    StyleBox["a",
     FontWeight->"Bold"], "k"], "=", 
   RowBox[{
    StyleBox["a",
     FontWeight->"Bold"], "\[CircleTimes]", 
    SuperscriptBox[
     StyleBox["a",
      FontWeight->"Bold"], 
     RowBox[{"k", "-", "1"}]]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.814579116596404*^9, 
  3.814579126846149*^9}},ExpressionUUID->"c05ac8a8-faf9-41e1-bbfb-\
c1b70f0a65ac"],

Cell["where \[CircleTimes] is a Kronecker product. Then if we have", \
"ExpositoryText",
 CellChangeTimes->{{3.814579128090413*^9, 
  3.814579182516254*^9}},ExpressionUUID->"2ac8b47d-325c-4df3-9abd-\
98598e0dd46d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["b",
    FontWeight->"Bold"], "=", 
   RowBox[{
    StyleBox["a",
     FontWeight->"Bold"], " ", "+", " ", 
    StyleBox["\[CapitalDelta]",
     FontWeight->"Bold"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.814579184265462*^9, 3.814579212439507*^9}, {
  3.814579685944055*^9, 
  3.814579691124074*^9}},ExpressionUUID->"4a3a77c9-101a-4564-b10c-\
3453b1688293"],

Cell["we get", "ExpositoryText",
 CellChangeTimes->{{3.8145792209846478`*^9, 
  3.814579221914774*^9}},ExpressionUUID->"b1cc3c9e-b99d-4ba5-a3f7-\
78e1c14fcffe"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox[
       StyleBox["b",
        FontWeight->"Bold"], "k"], "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         StyleBox["a",
          FontWeight->"Bold"], " ", "+", " ", 
         StyleBox["\[CapitalDelta]",
          FontWeight->"Bold"]}], ")"}], "\[CircleTimes]", 
       SuperscriptBox[
        StyleBox["b",
         FontWeight->"Bold"], 
        RowBox[{"k", "-", "1"}]]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        StyleBox["a",
         FontWeight->"Bold"], "\[CircleTimes]", 
        SuperscriptBox[
         StyleBox["b",
          FontWeight->"Bold"], 
         RowBox[{"k", "-", "1"}]]}], " ", "+", " ", 
       RowBox[{
        StyleBox["\[CapitalDelta]",
         FontWeight->"Bold"], "\[CircleTimes]", 
        SuperscriptBox[
         StyleBox["b",
          FontWeight->"Bold"], 
         RowBox[{"k", "-", "1"}]]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8145795818942957`*^9, 3.8145796253471212`*^9}, {
  3.8145796937538557`*^9, 
  3.814579698946941*^9}},ExpressionUUID->"5e65f0df-5dea-4df1-9635-\
796370a811be"],

Cell["or in other words, building up combinatorially ", "ExpositoryText",
 CellChangeTimes->{{3.814579650109581*^9, 
  3.814579661855772*^9}},ExpressionUUID->"c1a22a9b-8d40-4971-a86d-\
b36df28be7a5"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      StyleBox["b",
       FontWeight->"Bold"], "=", 
      RowBox[{
       StyleBox["a",
        FontWeight->"Bold"], " ", "+", " ", 
       StyleBox["\[CapitalDelta]",
        FontWeight->"Bold"]}]}]},
    {
     RowBox[{" ", 
      RowBox[{
       SuperscriptBox[
        StyleBox["b",
         FontWeight->"Bold"], "2"], "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          StyleBox["a",
           FontWeight->"Bold"], " ", "+", " ", 
          StyleBox["\[CapitalDelta]",
           FontWeight->"Bold"]}], ")"}], "\[CircleTimes]", 
        RowBox[{"(", 
         RowBox[{
          StyleBox["a",
           FontWeight->"Bold"], " ", "+", " ", 
          StyleBox["\[CapitalDelta]",
           FontWeight->"Bold"]}], ")"}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       SuperscriptBox[
        StyleBox["a",
         FontWeight->"Bold"], "2"], "+", 
       RowBox[{
        StyleBox["a",
         FontWeight->"Bold"], 
        StyleBox["\[CircleTimes]",
         FontWeight->"Plain"], 
        StyleBox["\[CapitalDelta]",
         FontWeight->"Bold"]}], "+", 
       RowBox[{
        StyleBox["\[CapitalDelta]",
         FontWeight->"Bold"], 
        StyleBox["\[CircleTimes]",
         FontWeight->"Plain"], 
        StyleBox["a",
         FontWeight->"Bold"]}], "+", 
       SuperscriptBox[
        StyleBox["\[CapitalDelta]",
         FontWeight->"Bold"], "2"]}]}]},
    {
     RowBox[{
      SuperscriptBox[
       StyleBox["b",
        FontWeight->"Bold"], "3"], "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         StyleBox["a",
          FontWeight->"Bold"], " ", "+", " ", 
         StyleBox["\[CapitalDelta]",
          FontWeight->"Bold"]}], ")"}], "\[CircleTimes]", 
       RowBox[{"(", 
        RowBox[{
         StyleBox["a",
          FontWeight->"Bold"], " ", "+", " ", 
         StyleBox["\[CapitalDelta]",
          FontWeight->"Bold"]}], ")"}], "\[CircleTimes]", 
       RowBox[{"(", 
        RowBox[{
         StyleBox["a",
          FontWeight->"Bold"], " ", "+", " ", 
         StyleBox["\[CapitalDelta]",
          FontWeight->"Bold"]}], ")"}]}]}]},
    {"\[Ellipsis]"}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.814579184265462*^9, 3.814579212439507*^9}, {
  3.814579678833658*^9, 3.814579743128927*^9}, {3.8145797928680773`*^9, 
  3.814579817552182*^9}, {3.814579892027587*^9, 3.814579897271207*^9}, {
  3.814580000471149*^9, 3.814580033713402*^9}, {3.814580069917919*^9, 
  3.814580078915819*^9}, {3.8145808585857763`*^9, 
  3.81458090597141*^9}},ExpressionUUID->"ef0274d5-4746-421d-b65e-\
2d29f14b326b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Not Quite Right Stuff (But Useful Ideas)", "Subsubsection",
 CellChangeTimes->{{3.814578710977491*^9, 3.814578714304336*^9}, {
  3.814578800345068*^9, 
  3.814578808880312*^9}},ExpressionUUID->"c59f27cb-17b7-456f-821d-\
c28d7bc02092"],

Cell[CellGroupData[{

Cell["The X-Matrix and 2nd Order PT", "Subsubsubsection",
 CellChangeTimes->{{3.8145363844366693`*^9, 
  3.814536390539958*^9}},ExpressionUUID->"03f3fb1b-2756-40ac-9fc0-\
2f9381d0ec9a"],

Cell["We can write", "ExpositoryText",
 CellChangeTimes->{{3.8145363931750507`*^9, 3.814536402422318*^9}, {
  3.814538448485146*^9, 3.814538506672125*^9}, {3.814538620620881*^9, 
  3.81453864527277*^9}, {3.814539155518229*^9, 3.814539159696164*^9}, {
  3.8145392492030582`*^9, 3.814539278552472*^9}, {3.8145393985406837`*^9, 
  3.814539400411813*^9}},ExpressionUUID->"8237ac9c-941a-47d8-8ae3-\
859c9722aa91"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["E", "n", 
        RowBox[{"(", "2", ")"}]], "-", 
       SubsuperscriptBox["E", "0", 
        RowBox[{"(", "2", ")"}]]}], "=", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["\[Epsilon]", "2", 
         RowBox[{"(", "2", ")"}]], 
        SubscriptBox["\[CircleDot]", "2"], 
        SuperscriptBox[
         RowBox[{"(", 
          StyleBox["n",
           FontWeight->"Bold"], ")"}], "2"]}], "+", 
       RowBox[{
        SubsuperscriptBox["\[Epsilon]", "1", 
         RowBox[{"(", "2", ")"}]], "\[CircleDot]", 
        StyleBox["n",
         FontWeight->"Bold"]}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["E", "n", 
        RowBox[{"(", "2", ")"}]], "-", 
       SubsuperscriptBox["E", "n", 
        RowBox[{"(", "1", ")"}]]}], "=", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["\[Epsilon]", "2", 
         RowBox[{"(", "2", ")"}]], 
        SubscriptBox["\[CircleDot]", "2"], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           StyleBox["n",
            FontWeight->"Bold"], "+", 
           FractionBox["1", "2"]}], ")"}], "2"]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox["\[Epsilon]", "1", 
           RowBox[{"(", "2", ")"}]], "-", 
          SubsuperscriptBox["\[Epsilon]", "1", 
           RowBox[{"(", "1", ")"}]]}], ")"}], "\[CircleDot]", 
        RowBox[{"(", 
         RowBox[{
          StyleBox["n",
           FontWeight->"Bold"], "+", 
          FractionBox["1", "2"]}], ")"}]}], "+", 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["\[Epsilon]", "0", 
          RowBox[{"(", "2", ")"}]], "-", 
         SubsuperscriptBox["\[Epsilon]", "0", 
          RowBox[{"(", "1", ")"}]]}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8145392977767477`*^9, 3.8145395164507437`*^9}, {
  3.814539565495068*^9, 3.814539620319025*^9}, {3.814540102925145*^9, 
  3.8145401053162117`*^9}, {3.814540390237661*^9, 
  3.814540395019607*^9}},ExpressionUUID->"abfa4e34-16f7-4723-b458-\
38a89dda44e8"],

Cell["and then as", "ExpositoryText",
