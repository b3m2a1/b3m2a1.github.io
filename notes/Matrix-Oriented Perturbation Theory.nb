Cell[TextData[{
 "the first of these gives rise to the non-degenerate case from before, as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["H", 
       RowBox[{"(", "0", ")"}]], "-", 
      SuperscriptBox[
       SubscriptBox["E", "n"], 
       RowBox[{"(", "0", ")"}]]}], ")"}], 
    SubscriptBox["P", "U"]}], TraditionalForm]],ExpressionUUID->
  "aff50f06-bde0-4fc6-999a-ac8602ac8618"],
 " is cleanly invertible. This gives us a way to obtain ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "U"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "e4e3c556-de05-4dd7-b49e-b0a1a736973f"],
 "."
}], "ExpositoryText",
 CellChangeTimes->{{3.8212035271005373`*^9, 3.821203615925168*^9}, {
