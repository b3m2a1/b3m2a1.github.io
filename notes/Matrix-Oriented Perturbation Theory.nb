Cell[CellGroupData[{

Cell[TextData[{
 "Degeneracies in ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["P", "G"], " ", 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["H", 
      RowBox[{"(", "2", ")"}]], "-", 
