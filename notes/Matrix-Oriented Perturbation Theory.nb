          SubscriptBox["q", "6"]}], ")"}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCenteredManuallyAligned",
 CellChangeTimes->{{3.82594149419061*^9, 3.825941497834675*^9}, {
