    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], 
      RowBox[{"k", "-", "1"}]], 
     RowBox[{
      SubscriptBox["P", "U"], 
      SuperscriptBox["H", 
       RowBox[{"(", 
        RowBox[{"k", "-", "i"}], ")"}]], 
