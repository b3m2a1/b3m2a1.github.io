Cell[CellGroupData[{

Cell["State Orthogonality", "Section",
 CellChangeTimes->{{3.888228265152402*^9, 3.888228268608165*^9}, 
   3.889548207853551*^9, 
   3.936190977293023*^9},ExpressionUUID->"b6178b3a-0b67-4c23-b465-\
a51b1fbb9f02"],

Cell["We\[CloseCurlyQuote]ll consider", "ExpositoryText",
 CellChangeTimes->{{3.8882282700149813`*^9, 
  3.888228272503462*^9}},ExpressionUUID->"23ff57ca-0a0b-4a7c-a9a1-\
0fa69c660dd7"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      TemplateBox[{
        RowBox[{"n", "\[ThinSpace]"}], 
        RowBox[{" ", "m"}]},
       "BraKet"], " ", "=", " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "k"], "\[VeryThinSpace]", 
       SuperscriptBox[
        TemplateBox[{
          RowBox[{"n", "\[ThinSpace]"}], 
          RowBox[{" ", "m"}]},
         "BraKet"], 
        RowBox[{"(", "k", ")"}]]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "k"], "\[VeryThinSpace] ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], "k"], " ", 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", 
               RowBox[{"k", "-", "i"}], ")"}]], "\[ThinSpace]"}], 
          RowBox[{" ", 
            SuperscriptBox["m", 
             RowBox[{"(", "i", ")"}]]}]},
         "BraKet"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.888228273864563*^9, 3.888228329384981*^9}, {
  3.888228422687666*^9, 
  3.888228449559051*^9}},ExpressionUUID->"e4b36859-b812-4033-8836-\
5f8ea9b6a53d"],

Cell[TextData[{
 "and by the recursive definition of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "i", ")"}]]},
    "Ket"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "d592cdb0-2bc1-458c-89f8-d89fea34dbba"],
 " we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.8882284601072407`*^9, 
  3.8882284932458*^9}},ExpressionUUID->"13fafdbc-d29c-4dc4-bbef-bdf4d10bebd2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    TemplateBox[{
      RowBox[{"n", "\[ThinSpace]"}], 
      RowBox[{" ", "m"}]},
     "BraKet"], 
    RowBox[{"(", "k", ")"}]], " ", "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], "k"], "\[VeryThinSpace]", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"s", "\[Element]", 
       RowBox[{"P", "(", 
        RowBox[{"k", "-", "i"}], ")"}]}]], 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{"r", "\[Element]", 
        RowBox[{"P", "(", "i", ")"}]}]], " ", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       RowBox[{"(", 
        RowBox[{
         UnderscriptBox["\[Product]", 
          RowBox[{
           SubscriptBox["s", "a"], "\[Element]", "s"}]], 
         RowBox[{
          SubsuperscriptBox["\[CapitalDelta]H", "n", 
           RowBox[{"(", 
            SubscriptBox["s", "a"], ")"}]], 
          SubscriptBox["\[CapitalPi]", "n"]}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         UnderscriptBox["\[Product]", 
          RowBox[{
           SubscriptBox["r", "b"], "\[Element]", "r"}]], 
         RowBox[{
          SubscriptBox["\[CapitalPi]", "m"], 
          SubsuperscriptBox["\[CapitalDelta]H", "m", 
           RowBox[{"(", 
            SubscriptBox["r", "b"], ")"}]]}]}], ")"}], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.888228501354525*^9, 3.8882287022394037`*^9}, {
  3.888235625954693*^9, 
  3.88823568485336*^9}},ExpressionUUID->"0c612122-7576-4bc9-914d-\
39b5791236fb"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "(", 
    RowBox[{"k", "\[Minus]", "i"}], ")"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "b34fa16b-cafa-4304-bdef-f9b61eddbfb5"],
 " is the set of permutations of integer partitions of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "\[Minus]", "i"}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "9a76994c-ba0d-45c6-ab46-7f8a1aedb1ab"]
}], "ExpositoryText",
 InitializationCell->True,
 CellChangeTimes->{{3.888235689569598*^9, 
  3.888235717553323*^9}},ExpressionUUID->"580a04b0-eeb9-4817-a46a-\
151b5b217a88"],

Cell[TextData[{
 "Our goal will to be to find rules that allow every pair of sequences ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"s", ",", "\[VeryThinSpace]", "r"}], ")"}], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "53d66eb3-0c60-4828-adb3-b9b0694c2963"],
 " to be at least partially canceled by another sequence"
}], "ExpositoryText",
 CellChangeTimes->{{3.888228743619463*^9, 3.888228796750491*^9}, {
  3.8882291484642467`*^9, 3.8882291536523533`*^9}, {3.8882357233651533`*^9, 
  3.888235733325779*^9}},ExpressionUUID->"8c937be7-c590-49bf-a539-\
a4340889d380"],

Cell["\<\
To do this, we will need a bit of helpful notation, first we will say\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8882288039325027`*^9, 3.888228815941058*^9}, {
  3.8882290422986727`*^9, 3.888229047227456*^9}, {3.888229087913155*^9, 
  3.888229110106596*^9}},ExpressionUUID->"2c179015-b5ac-4d52-b3a5-\
673beb7c2afb"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox["S", 
       RowBox[{"(", "k", ")"}]], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", 
           SubscriptBox["s", "1"], ")"}]], 
         SubscriptBox["\[CapitalPi]", "n"]}], "..."}], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", 
         SubscriptBox["s", "k"], ")"}]], 
       SubscriptBox["\[CapitalPi]", "n"]}]}]},
    {
     RowBox[{
      SuperscriptBox["R", 
       RowBox[{"(", "j", ")"}]], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["\[CapitalPi]", "m"], 
         SubsuperscriptBox["\[CapitalDelta]H", "m", 
          RowBox[{"(", 
           SubscriptBox["r", "j"], ")"}]]}], "..."}], 
       SubscriptBox["\[CapitalPi]", "m"], 
       SubsuperscriptBox["\[CapitalDelta]H", "m", 
        RowBox[{"(", 
         SubscriptBox["r", "1"], ")"}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.888229122960227*^9, 3.888229183433257*^9}, {
  3.888229266879218*^9, 3.888229269456366*^9}, {3.888229304330042*^9, 
  3.8882293712694798`*^9}, {3.888229852074276*^9, 3.8882298806171837`*^9}, {
  3.888230667978971*^9, 
  3.8882306891798162`*^9}},ExpressionUUID->"5e4d9313-cdd5-456b-a77a-\
30f2aad63503"],

Cell["and then we\[CloseCurlyQuote]ll define the \
\[OpenCurlyDoubleQuote]reduced\[CloseCurlyDoubleQuote] sequences", \
"ExpositoryText",
 CellChangeTimes->{{3.888229376707924*^9, 
  3.888229387471738*^9}},ExpressionUUID->"e5fba708-91ef-4c80-915f-\
4523c1e1c224"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["S", "-", 
       RowBox[{"(", "k", ")"}]], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", 
           SubscriptBox["s", "1"], ")"}]], 
         SubscriptBox["\[CapitalPi]", "n"]}], "..."}], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", 
         SubscriptBox["s", "k"], ")"}]]}]}]},
    {
     RowBox[{
      SubsuperscriptBox["R", "-", 
       RowBox[{"(", "j", ")"}]], " ", "=", " ", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "m", 
         RowBox[{"(", 
          SubscriptBox["r", "j"], ")"}]], "..."}], 
       SubscriptBox["\[CapitalPi]", "m"], 
       SubsuperscriptBox["\[CapitalDelta]H", "m", 
        RowBox[{"(", 
         SubscriptBox["r", "1"], ")"}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.888229122960227*^9, 3.888229183433257*^9}, {
  3.888229266879218*^9, 3.888229269456366*^9}, {3.888229304330042*^9, 
  3.8882294038649883`*^9}, {3.888229889929207*^9, 3.88822990436292*^9}, {
  3.888230698060689*^9, 
  3.8882307078118143`*^9}},ExpressionUUID->"6728f195-e334-43a0-b143-\
716e302c9ebb"],

Cell["\<\
we do this because we have two sequence rules that we can express in terms of \
these reduced sequences\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8882294067364693`*^9, 3.888229427712825*^9}, {
  3.8882295415574293`*^9, 
  3.888229542331336*^9}},ExpressionUUID->"57036e01-51b1-42f5-a164-\
d91efc6fc21e"],

Cell[TextData[{
 "First, any sequence ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["S", 
    RowBox[{"(", "k", ")"}]], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "1d0c0d86-b5a0-4839-941e-679c2e2ce9a7"],
 " unpaired with an ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["R", 
    RowBox[{"(", "j", ")"}]], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "1bbbc975-3399-4362-8809-f0838ed45acd"],
 " can be expressed in terms of its reduced sequence and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]E", " ", "=", " ", 
    RowBox[{
     SubsuperscriptBox["E", "n", 
      RowBox[{"(", "0", ")"}]], "-", 
     SubsuperscriptBox["E", "m", 
      RowBox[{"(", "0", ")"}]]}]}], TraditionalForm]], "ExpositoryTextInline",
  
  FormatType->TraditionalForm,ExpressionUUID->
  "1fcc6328-bdfc-4fb9-bd3d-fc3b92da23db"],
 "\[VeryThinSpace]and vice versa"
}], "ExpositoryText",
 CellChangeTimes->{{3.888229714299767*^9, 
  3.888229806831355*^9}},ExpressionUUID->"e05371a2-befd-473f-acb2-\
d5f07313ef66"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SuperscriptBox["S", 
        RowBox[{"(", "k", ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], " ", "=", " ", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SubsuperscriptBox["S", "-", 
        RowBox[{"(", "k", ")"}]], 
       SubscriptBox["\[CapitalPi]", "n"], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       FractionBox["1", "\[CapitalDelta]E"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SubsuperscriptBox["S", "-", 
        RowBox[{"(", "k", ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SuperscriptBox["R", 
        RowBox[{"(", "j", ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], " ", "=", " ", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SubscriptBox["\[CapitalPi]", "m"], 
       SubsuperscriptBox["R", "-", 
        RowBox[{"(", "j", ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "\[CapitalDelta]E"]}], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SubsuperscriptBox["R", "-", 
        RowBox[{"(", "j", ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.888229547544778*^9, 3.8882295858610086`*^9}, {
  3.8882296314318132`*^9, 3.888229702271068*^9}, {3.888229768394987*^9, 
  3.888229819010651*^9}},ExpressionUUID->"bd28ff13-b6aa-45c1-8265-\
d719fa2be5e9"],

Cell["\<\
Second, by properties of the resolvent, for any paired sequence, we have\
\>", "ExpositoryText",
 CellChangeTimes->{{3.888230272775947*^9, 
  3.88823029428205*^9}},ExpressionUUID->"77eb74a6-7192-4de2-8767-\
21f9e173de54"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SuperscriptBox["S", 
        RowBox[{"(", "k", ")"}]], 
       SuperscriptBox["R", 
        RowBox[{"(", "j", ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], " ", "=", " ", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SubsuperscriptBox["S", "-", 
        RowBox[{"(", "k", ")"}]], 
       SubscriptBox["\[CapitalPi]", "n"], 
       SubscriptBox["\[CapitalPi]", "m"], 
       SubsuperscriptBox["R", "-", 
        RowBox[{"(", "j", ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       FractionBox["1", "\[CapitalDelta]E"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       RowBox[{
        SubsuperscriptBox["S", "-", 
         RowBox[{"(", "k", ")"}]], "(", 
        RowBox[{
         SubscriptBox["\[CapitalPi]", "m"], "-", 
         SubscriptBox["\[CapitalPi]", "n"]}], ")"}], 
       SubsuperscriptBox["R", "-", 
        RowBox[{"(", "j", ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       FractionBox["1", "\[CapitalDelta]E"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]]},
           "Bra"], " ", 
          SubsuperscriptBox["S", "-", 
           RowBox[{"(", "k", ")"}]], 
          SuperscriptBox["R", 
           RowBox[{"(", "j", ")"}]], 
          TemplateBox[{
            SuperscriptBox["m", 
             RowBox[{"(", "0", ")"}]]},
           "Ket"]}], " ", "-", " ", 
         RowBox[{
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]]},
           "Bra"], " ", 
          SuperscriptBox["S", 
           RowBox[{"(", "k", ")"}]], 
          SubsuperscriptBox["R", "-", 
           RowBox[{"(", "j", ")"}]], 
          TemplateBox[{
            SuperscriptBox["m", 
             RowBox[{"(", "0", ")"}]]},
           "Ket"]}]}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8882288192001457`*^9, 3.8882288263707123`*^9}, {
  3.888230286768322*^9, 3.888230347973474*^9}, {3.888230396200622*^9, 
  3.8882304114418*^9}},ExpressionUUID->"5c7aa9da-699d-41de-b1bb-6b0658027f13"],

Cell["We can look at this now with an instructive example", "ExpositoryText",
 CellChangeTimes->{{3.8882305075530767`*^9, 3.888230620747169*^9}, {
  3.8882309028156643`*^9, 
  3.888230906093162*^9}},ExpressionUUID->"5f8d9649-73ef-40d9-ac37-\
0103c253a23e"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", "1", ")"}]], 
       SubscriptBox["\[CapitalPi]", "n"], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", "2", ")"}]], 
       SubscriptBox["\[CapitalPi]", "n"], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", "1", ")"}]], 
       SubscriptBox["\[CapitalPi]", "n"], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], " ", "=", " ", 
      RowBox[{
       FractionBox["1", "\[CapitalDelta]E"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", "1", ")"}]], 
       SubscriptBox["\[CapitalPi]", "n"], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", "2", ")"}]], 
       SubscriptBox["\[CapitalPi]", "n"], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", "1", ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", "1", ")"}]], 
       SubscriptBox["\[CapitalPi]", "n"], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", "2", ")"}]], 
       SubscriptBox["\[CapitalPi]", "n"], 
       SubscriptBox["\[CapitalPi]", "m"], 
       SubsuperscriptBox["\[CapitalDelta]H", "m", 
        RowBox[{"(", "1", ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], " ", "=", " ", 
      RowBox[{
       FractionBox["1", "\[CapitalDelta]E"], "[", 
       RowBox[{
        RowBox[{
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], " ", 
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", "1", ")"}]], 
         SubscriptBox["\[CapitalPi]", "n"], 
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", "2", ")"}]], 
         SubscriptBox["\[CapitalPi]", "m"], 
         SubsuperscriptBox["\[CapitalDelta]H", "m", 
          RowBox[{"(", "1", ")"}]], 
         TemplateBox[{
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"]}], "-", 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], " ", 
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", "1", ")"}]], 
         SubscriptBox["\[CapitalPi]", "n"], 
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", "2", ")"}]], 
         SubscriptBox["\[CapitalPi]", "n"], 
