Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox["G", "R", 
         RowBox[{"(", "1", ")"}]], ")"}], 
       RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]], 
      " ", "=", " ", 
      RowBox[{
       FractionBox["1", "2"], 
       SubscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Del]", "R"], 
          SubscriptBox["G", "R"]}], ")"}], 
        RowBox[{
        "j", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "k"}]]}]}]},
    {
     RowBox[{
      SubscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox["G", "R", 
         RowBox[{"(", "2", ")"}]], ")"}], 
       RowBox[{
       "i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k", 
        "\[InvisibleSpace]", "l"}]], " ", "=", " ", 
      RowBox[{
       FractionBox["1", "4"], 
       SubscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Del]", 
           SuperscriptBox["R", "2"]], 
          SubscriptBox["G", "R"]}], ")"}], 
        RowBox[{
        "k", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "j", 
         "\[InvisibleSpace]", "l"}]]}]}]},
    {
     RowBox[{
      SubsuperscriptBox["V", "R", 
       RowBox[{"(", "1", ")"}]], " ", "=", " ", 
      RowBox[{
       FractionBox["1", "6"], " ", 
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox["R", "3"]], 
        SubscriptBox["V", "R"], " "}]}]}]},
    {
     RowBox[{
      SubsuperscriptBox["V", "R", 
       RowBox[{"(", "2", ")"}]], " ", "=", " ", 
      RowBox[{
       FractionBox["1", "24"], 
       SubscriptBox["V", 
        SuperscriptBox["R", "4"]], "\[InvisibleSpace]", 
       SubscriptBox["V", "R"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.9209031140881367`*^9, 3.9209032027506933`*^9}, {
