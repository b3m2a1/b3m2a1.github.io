      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], 
         RowBox[{"k", "-", "1"}]], " ", 
        RowBox[{
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", 
           RowBox[{"k", "-", "i"}], ")"}]], 
         TemplateBox[{
           RowBox[{
             SuperscriptBox["n", 
              RowBox[{"(", "0", ")"}]], " "}], 
           RowBox[{"\[VeryThinSpace] ", 
             SuperscriptBox["n", 
              RowBox[{"(", "i", ")"}]]}]},
          "BraKet"]}]}], "+", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], 
         RowBox[{"i", "-", "1"}]], 
        RowBox[{
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", 
           RowBox[{"k", "-", "i"}], ")"}]], 
         SubscriptBox["\[CapitalPi]", "n"], 
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", 
           RowBox[{"i", "-", "j"}], ")"}]], 
         TemplateBox[{
           RowBox[{
             SuperscriptBox["n", 
              RowBox[{"(", "0", ")"}]], " "}], 
           RowBox[{"\[VeryThinSpace] ", 
