              RowBox[{"b", ",", " ", 
               RowBox[{"k", "-", "i"}]}], ")"}]], " ", "+", " ", 
            SuperscriptBox["\[CapitalDelta]H", 
             RowBox[{"(", 
              RowBox[{"b", "+", "k", "-", "i"}], ")"}]]}], ")"}], 
