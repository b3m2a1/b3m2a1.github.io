  TraditionalForm], "\[IndentingNewLine]", 
 FormBox[
  RowBox[{"\t", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[Implies]", " ", 
       RowBox[{"we", " ", "need", " ", "to", " ", "find", " ", "an", " ", 
        StyleBox["ordering",
         FontSlant->"Italic"], 
        StyleBox[" ",
         FontSlant->"Plain"], 
        StyleBox["of",
         FontSlant->"Plain"], 
        StyleBox[" ",
         FontSlant->"Plain"], 
