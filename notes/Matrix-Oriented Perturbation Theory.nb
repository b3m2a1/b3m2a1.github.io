  3.8119591388141737`*^9}},ExpressionUUID->"e7d98615-d3a8-4147-aa5c-\
a3fb0c346b53"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox[
       RowBox[{"(", 
        SubscriptBox["\[CapitalPi]", "n"], ")"}], 
       RowBox[{"m", "\[InvisibleSpace]", "m"}]], "=", 
      SubscriptBox[
       RowBox[{"(", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["H", 
            RowBox[{"(", "0", ")"}]], "-", 
           SuperscriptBox["E", 
            RowBox[{"(", "0", ")"}]]}], ")"}], 
         RowBox[{"-", "1"}]], ")"}], 
       RowBox[{"m", "\[InvisibleSpace]", "m"}]]}]},
    {
     RowBox[{"=", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          UnderscriptBox["\[Sum]", "i"], 
          RowBox[{
           SubscriptBox["\[Omega]", "i"], "(", 
           RowBox[{
            SubscriptBox["m", "i"], "+", 
            FractionBox["1", "2"]}], ")"}]}], "-", 
         RowBox[{
          SubscriptBox["\[Omega]", "i"], "(", 
          RowBox[{
           SubscriptBox["n", "i"], "+", 
           FractionBox["1", "2"]}], ")"}]}], ")"}], 
       RowBox[{"-", "1"}]]}]},
    {
     RowBox[{"=", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         UnderscriptBox["\[Sum]", "i"], 
         RowBox[{
          SubscriptBox["\[Omega]", "i"], "(", 
          RowBox[{
           SubscriptBox["m", "i"], "-", 
           SubscriptBox["n", "i"]}], ")"}]}], ")"}], 
       RowBox[{"-", "1"}]]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811959140287465*^9, 3.811959163876751*^9}, {
   3.8119595818160887`*^9, 3.811959582165248*^9}, 
   3.811988038445269*^9},ExpressionUUID->"80d69e95-3bfe-4809-8655-\
099ad0c78254"],

Cell[TextData[{
 "assuming, of course, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "\[NotEqual]", "m"}], TraditionalForm]],ExpressionUUID->
  "a276ef36-5d17-4860-8ed9-54d851a2b349"],
 " since we already projected that out. The most important feature of this, \
for what we\[CloseCurlyQuote]re doing here, is that it\[CloseCurlyQuote]s \
diagonal. For the ease of notation, we\[CloseCurlyQuote]ll write ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPi]", "n"], "=", "\[CapitalPi]"}], 
   TraditionalForm]],
  CellChangeTimes->{{3.811959140287465*^9, 3.811959163876751*^9}, {
    3.8119595818160887`*^9, 3.811959582165248*^9}, 3.811988038445269*^9},
  ExpressionUUID->"c3f9a9da-a64f-4730-8132-4512d63d4a89"],
 " and let the ",
 StyleBox["n",
  FontSlant->"Italic"],
 " be implicit."
}], "ExpositoryText",
 CellChangeTimes->{{3.811959169967492*^9, 3.811959194732423*^9}, 
   3.811959357684613*^9, {3.811962253821496*^9, 3.811962270625552*^9}, {
   3.811988053579894*^9, 3.8119880977745533`*^9}, 
   3.811990345339278*^9},ExpressionUUID->"25d4101f-1623-4897-81ab-\
3a45c1fb5196"],

Cell["Next, we\[CloseCurlyQuote]ll write ", "ExpositoryText",
 CellChangeTimes->{{3.811987851252611*^9, 
  3.811987864575816*^9}},ExpressionUUID->"b9bd39ef-ad09-4074-938c-\
ba162bd0ae54"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], 
