  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"condensePTTerms", "[", "expr_", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"GroupBy", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"List", "@@", "expr"}], ",", " ", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"leadingNeg", "[", 
           RowBox[{"simpDenom", "[", "#", "]"}], "]"}], ",", " ", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"simpDenom", "[", "#", "]"}]}], "//", "Simplify"}], ",", 
          " ", "\[IndentingNewLine]", 
          RowBox[{"simpDenom", "[", "#", "]"}]}], "\[IndentingNewLine]", 
         "]"}], "&"}], ")"}], "->", "\[IndentingNewLine]", 
      RowBox[{"(", 
