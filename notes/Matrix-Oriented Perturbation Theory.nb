Cell["Proof", "Subsubsubsubsection",
 CellChangeTimes->{{3.7927840679437428`*^9, 
  3.7927840701808968`*^9}},ExpressionUUID->"5f3ca039-0986-4a8c-ac82-\
898044bb628e"],

Cell[TextData[{
 "We\[CloseCurlyQuote]ll look at this element-wise assuming that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a",
     FontSlant->"Italic"], "=", 
    RowBox[{
     StyleBox["b",
      FontSlant->"Italic"], "=", "2"}]}], TraditionalForm]],ExpressionUUID->
  "ff4339d0-9fa9-4757-bfd5-b4dc5e82f0a4"],
 " and that the shared axis of ",
 StyleBox["A",
  FontWeight->"Bold"],
 " and ",
 StyleBox["B",
  FontWeight->"Bold"],
 " is of size ",
 StyleBox["N",
  FontSlant->"Italic"],
 ". To start, we know that:"
}], "Text",
 CellChangeTimes->{{3.792784111607471*^9, 3.7927841184722424`*^9}, {
  3.792784368055909*^9, 3.792784369104885*^9}, {3.79278586289758*^9, 
  3.792785868089011*^9}, {3.792785935055846*^9, 3.792785963843686*^9}, {
  3.7927862218432837`*^9, 3.7927862266356363`*^9}, {3.792787403593802*^9, 
  3.7927874099850683`*^9}},ExpressionUUID->"0affce54-57b1-4fb8-9bbf-\
23a605de6308"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[Del]", "X"], 
         RowBox[{"(", 
          RowBox[{"A", "\[CircleDot]", "B"}], ")"}]}], 
        StyleBox[")",
         FontSlant->"Plain"]}], 
       RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]], 
      "=", 
      RowBox[{
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", "i"]}]], 
       SubscriptBox[
        RowBox[{"(", 
         RowBox[{"A", "\[CircleDot]", "B"}], ")"}], 
        RowBox[{"j", "\[InvisibleSpace]", "k"}]]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", "i"]}]], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["A", "j"], "\[CenterDot]", 
         SubscriptBox["B", 
          RowBox[{":", "k"}]]}], ")"}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", "i"]}]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"n", "=", "1"}], "N"], 
        RowBox[{
         SubscriptBox["A", "jn"], 
         SubscriptBox["B", "nk"]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"n", "=", "1"}], "N"], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           FractionBox["\[PartialD]", 
            RowBox[{"\[PartialD]", 
             SubscriptBox["x", "i"]}]], 
           SubscriptBox["A", "jn"]}], ")"}], 
         SubscriptBox["B", "nk"]}]}], "+", 
       RowBox[{
        SubscriptBox["A", "jn"], "(", 
        RowBox[{
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
           SubscriptBox["x", "i"]}]], 
         SubscriptBox["B", "nk"]}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.792787412080328*^9, 3.792787540738138*^9}, {
  3.792787636226742*^9, 
  3.792787640106694*^9}},ExpressionUUID->"b7255c9e-6dbb-45a7-80a7-\
5ea2e38c15ec"],

Cell["Then from our theorem we have", "Text",
 CellChangeTimes->{{3.792787548101729*^9, 
  3.7927875530465107`*^9}},ExpressionUUID->"9b068351-baa0-4f8c-a807-\
19a4b008c4e5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Del]", "X"], 
      RowBox[{"(", 
       RowBox[{"A", "\[CircleDot]", "B"}], ")"}]}], 
     StyleBox[")",
      FontSlant->"Plain"]}], 
    RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]], 
   StyleBox["=",
    FontSlant->"Plain"], 
   RowBox[{
    SubscriptBox[
     RowBox[{
      StyleBox["(",
       FontSlant->"Plain"], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[Del]", "X"], "A"}], ")"}], "\[CircleDot]", "B"}], 
      ")"}], 
