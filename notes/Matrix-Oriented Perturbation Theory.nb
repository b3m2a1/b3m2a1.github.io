  3.828037157354084*^9}},ExpressionUUID->"bc95f14a-0292-4615-8419-\
4f6314b70228"],

Cell[TextData[{
 "Next, we\[CloseCurlyQuote]ll note that there is a sequence ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox["r", "j"], "}"}], TraditionalForm]],ExpressionUUID->
  "5728404d-d008-45e3-8714-d3962b771419"],
 " of length ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", "r", "\[RightBracketingBar]"}], 
   TraditionalForm]],ExpressionUUID->"215e64a2-f0fc-404c-83e5-d8ca60978bb9"],
 " that provides the positions of every 1 in ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "5eef45e9-e53a-4e4f-a7ab-d914f503e823"],
 ", so making use of the fact that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", "n", 
     RowBox[{"(", 
      SubscriptBox["p", "i"], ")"}]], "=", 
    RowBox[{
     SubsuperscriptBox["\[CapitalDelta]H", "n", 
      RowBox[{"(", 
       StyleBox[
        SubscriptBox["p", "i"],
        FontSize->14], ")"}]], 
     TemplateBox[{
       RowBox[{"\[VeryThinSpace]", 
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]}]},
      "Ket"], 
     TemplateBox[{
       SuperscriptBox["m", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"]}]}], TraditionalForm]],
  CellChangeTimes->{{3.827786390869034*^9, 3.827786438557829*^9}, {
   3.827786529928946*^9, 3.8277866664818583`*^9}, {3.827786883483182*^9, 
   3.8277869023045177`*^9}},ExpressionUUID->
  "589559a4-072c-46f2-a3e6-db0eb745e557"],
 " this splits our expression into a much more compact one"
}], "ExpositoryText",
 CellChangeTimes->{{3.8280369837229357`*^9, 3.8280369911994343`*^9}, {
  3.8280370667669573`*^9, 3.828037080057815*^9}, {3.828037160152392*^9, 
  3.8280372065551243`*^9}},ExpressionUUID->"5ab4d78f-25fe-47d3-a9c8-\
94192b3dffa6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[GothicCapitalD]", "n"], "(", 
    RowBox[{"M", ",", " ", "p", ",", " ", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{"(", "\[VeryThinSpace]", 
     RowBox[{
      UnderoverscriptBox["\[Product]", 
       RowBox[{"i", "=", "1"}], 
       RowBox[{
        SubscriptBox["r", "1"], "-", "1"}]], 
      SubsuperscriptBox["\[CapitalOmega]", "n", 
       RowBox[{"(", 
        SubscriptBox["p", "i"], ")"}]]}], ")"}], 
    SubsuperscriptBox["\[CapitalDelta]H", "n", 
     RowBox[{"(", 
      StyleBox[
       SubscriptBox["p", 
        SubscriptBox["r", "1"]],
       FontSize->14], ")"}]], 
    RowBox[{
     TemplateBox[{
       RowBox[{"\[VeryThinSpace]", 
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]}]},
      "Ket"], "(", 
     RowBox[{
      UnderoverscriptBox["\[Product]", 
       RowBox[{"j", "=", "2"}], 
       RowBox[{
        RowBox[{"\[LeftBracketingBar]", "r", "\[RightBracketingBar]"}], "-", 
        "1"}]], 
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["m", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], "(", "\[VeryThinSpace]", 
        RowBox[{
         UnderoverscriptBox["\[Product]", 
          RowBox[{"i", "=", 
           RowBox[{
            SubscriptBox["r", "j"], "+", "1"}]}], 
          RowBox[{
           SubscriptBox["r", 
            RowBox[{"j", "+", "1"}]], "-", "1"}]], 
         SubsuperscriptBox["\[CapitalOmega]", "n", 
          RowBox[{"(", 
           SubscriptBox["p", "i"], ")"}]]}], ")"}], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", 
         SubscriptBox["r", 
          RowBox[{"j", "+", "1"}]], ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}], ")"}], 
    RowBox[{
     TemplateBox[{
       SuperscriptBox["m", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], "(", "\[VeryThinSpace]", 
     RowBox[{
      UnderoverscriptBox["\[Product]", 
       RowBox[{"i", "=", 
        RowBox[{
         SubscriptBox["r", 
          RowBox[{"\[LeftBracketingBar]", "r", "\[RightBracketingBar]"}]], 
         "+", "1"}]}], 
       RowBox[{"M", "-", "1"}]], 
      SubsuperscriptBox["\[CapitalOmega]", "n", 
       RowBox[{"(", 
        SubscriptBox["p", "i"], ")"}]]}], ")"}], 
    SubsuperscriptBox["\[CapitalDelta]H", "n", 
     RowBox[{"(", "M", ")"}]]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.827876086077504*^9, 3.827876152374495*^9}, {
   3.8278762528083973`*^9, 3.8278763040383053`*^9}, {3.827931235289926*^9, 
   3.827931238681518*^9}, {3.8279323483170843`*^9, 3.8279323956612043`*^9}, {
   3.827932445336987*^9, 3.827932448125495*^9}, {3.828037168456148*^9, 
   3.828037172408407*^9}, 
   3.8280374012568073`*^9},ExpressionUUID->"2e5d11e6-d4cf-4952-afef-\
f7cd776582dc"],

Cell["and we\[CloseCurlyQuote]ll drop some brackets by writing", \
"ExpositoryText",
 CellChangeTimes->{{3.827932088907178*^9, 3.827932110726033*^9}, 
   3.82793216575099*^9, {3.828037210777554*^9, 
   3.8280372111116333`*^9}},ExpressionUUID->"93000978-0ce3-4259-96a0-\
2195f5fc3014"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", "\[VeryThinSpace]", 
     RowBox[{
      UnderoverscriptBox["\[Product]", 
       RowBox[{"i", "=", 
        RowBox[{"a", "+", "1"}]}], 
       RowBox[{"b", "-", "1"}]], 
      SubsuperscriptBox["\[CapitalOmega]", "n", 
       RowBox[{"(", 
        SubscriptBox["p", "i"], ")"}]]}], ")"}], 
    SubsuperscriptBox["\[CapitalDelta]H", "n", 
     RowBox[{"(", 
      StyleBox[
       SubscriptBox["p", "b"],
       FontSize->14], ")"}]]}], "=", 
   RowBox[{
    SubsuperscriptBox["\[GothicCapitalO]", "n", 
     RowBox[{"(", "p", ")"}]], 
    SubsuperscriptBox["\[VerticalSeparator]", "a", "b"]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8279320975778027`*^9, 3.827932098229569*^9}, {
  3.8279321681211452`*^9, 3.8279322836496897`*^9}, {3.827932414504693*^9, 
  3.827932415022462*^9}},ExpressionUUID->"5bb60151-2f1a-4c39-94c2-\
5aef13185bed"],

Cell["so", "ExpositoryText",
 CellChangeTimes->{{3.8279322935224123`*^9, 
  3.82793229367069*^9}},ExpressionUUID->"5bf3c1b0-05d1-47e8-b51d-\
ef0b30a50190"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[GothicCapitalD]", "n"], "(", 
    RowBox[{"M", ",", " ", "p", ",", " ", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", " ", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Product]", 
         RowBox[{"j", "=", "2"}], 
         RowBox[{
          RowBox[{"\[LeftBracketingBar]", "r", "\[RightBracketingBar]"}], "-",
           "1"}]], 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], 
         SubsuperscriptBox["\[GothicCapitalO]", "n", 
          RowBox[{"(", "p", ")"}]]}]}], 
       SubsuperscriptBox["\[VerticalSeparator]", 
        SubscriptBox["r", "j"], 
        SubscriptBox["r", 
         RowBox[{"j", "+", "1"}]]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], ")"}], 
     SubsuperscriptBox["\[GothicCapitalO]", "n", 
      RowBox[{"(", "p", ")"}]]}], 
    SubsuperscriptBox["\[VerticalSeparator]", "0", 
     SubscriptBox["r", "1"]], 
    RowBox[{
     TemplateBox[{
       RowBox[{"\[VeryThinSpace]", 
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]}]},
      "Ket"], 
     TemplateBox[{
       SuperscriptBox["m", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     SubsuperscriptBox["\[GothicCapitalO]", "n", 
      RowBox[{"(", "p", ")"}]]}], 
    SubsuperscriptBox["\[VerticalSeparator]", 
     SubscriptBox["r", 
      StyleBox[
       RowBox[{"\[LeftBracketingBar]", "r", "\[RightBracketingBar]"}],
       FontSize->10]], "M"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.827876086077504*^9, 3.827876152374495*^9}, {
   3.8278762528083973`*^9, 3.8278763040383053`*^9}, {3.827931235289926*^9, 
   3.827931238681518*^9}, {3.827932303350358*^9, 3.8279323158614273`*^9}, 
   3.8279323572852907`*^9, 3.827932421601675*^9, {3.827932481587873*^9, 
   3.827932539351695*^9}, {3.828037409279112*^9, 
   3.8280374269816628`*^9}},ExpressionUUID->"ae98ae82-ed13-449e-9ffe-\
386570e32f22"],

Cell["\<\
and returning to the forms of the integral that motivated this all\
\>", "ExpositoryText",
 CellChangeTimes->{{3.828037487757642*^9, 
  3.8280375222781067`*^9}},ExpressionUUID->"581ba14d-b3e7-489a-90ad-\
ada4e78b2d6c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], 
    RowBox[{
     SubscriptBox["\[GothicCapitalD]", "n"], "(", 
     RowBox[{"M", ",", " ", "p", ",", " ", "t"}], ")"}], 
    TemplateBox[{
      SuperscriptBox["m", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", " ", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Product]", 
         RowBox[{"j", "=", "2"}], 
         RowBox[{
          RowBox[{"\[LeftBracketingBar]", "r", "\[RightBracketingBar]"}], "-",
           "1"}]], 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], 
         SubsuperscriptBox["\[GothicCapitalO]", "n", 
          RowBox[{"(", "p", ")"}]]}]}], 
       SubsuperscriptBox["\[VerticalSeparator]", 
        SubscriptBox["r", "j"], 
        SubscriptBox["r", 
         RowBox[{"j", "+", "1"}]]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], ")"}], 
     TemplateBox[{
       SuperscriptBox["m", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     SubsuperscriptBox["\[GothicCapitalO]", "n", 
      RowBox[{"(", "p", ")"}]]}], 
    SubsuperscriptBox["\[VerticalSeparator]", 
     SubscriptBox["r", 
      StyleBox[
       RowBox[{"\[LeftBracketingBar]", "r", "\[RightBracketingBar]"}],
       FontSize->10]], "M"], 
    RowBox[{
     TemplateBox[{
       SuperscriptBox["m", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     SubsuperscriptBox["\[GothicCapitalO]", "n", 
      RowBox[{"(", "p", ")"}]]}], 
    SubsuperscriptBox["\[VerticalSeparator]", "0", 
     SubscriptBox["r", "1"]], 
    TemplateBox[{
      RowBox[{"\[VeryThinSpace]", 
        SuperscriptBox["m", 
         RowBox[{"(", "0", ")"}]]}]},
     "Ket"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.828037527258321*^9, 3.82803753882022*^9}, {
  3.828037571577496*^9, 
  3.8280375855550623`*^9}},ExpressionUUID->"483c4b2e-c262-4f73-abd3-\
0824d0a18bdd"],

Cell[TextData[{
 "which interestingly means we only have one integral between ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Bra"], TraditionalForm]],ExpressionUUID->
  "21be6bcf-72ef-4100-970a-e8ec6836067a"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["m", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "412bec68-ce95-4fca-823e-42082f02c558"],
 " to evaluate, although of course sum over all possible sequences, so every \
sequence of integrals will be evaluated."
}], "ExpositoryText",
 CellChangeTimes->{{3.8280375935969057`*^9, 
  3.828037654312914*^9}},ExpressionUUID->"d3c55c5a-cd94-481e-b2e0-\
fc188978d836"],

Cell["\<\
Now, we\[CloseCurlyQuote]ll introduce our (hopefully) final notation for this \
specific form of terms as\
\>", "ExpositoryText",
 CellChangeTimes->{{3.827927760005227*^9, 3.827927780580347*^9}, {
   3.827927830974382*^9, 3.827927841776318*^9}, 3.8279325855069427`*^9, {
   3.8280376599297333`*^9, 
   3.828037661662712*^9}},ExpressionUUID->"eb2d96a0-8b82-4fc9-9816-\
016a34d13f2a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], 
    RowBox[{
     SubscriptBox["\[GothicCapitalF]", "n"], "(", 
     RowBox[{"M", ",", " ", "p", ",", " ", "r"}], ")"}], 
    TemplateBox[{
      SuperscriptBox["m", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     SubsuperscriptBox["\[GothicCapitalO]", "n", 
      RowBox[{"(", "p", ")"}]]}], 
    SubsuperscriptBox["\[VerticalSeparator]", "0", 
     SubscriptBox["r", "1"]], 
    RowBox[{
     TemplateBox[{
       RowBox[{"\[VeryThinSpace]", 
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]}]},
      "Ket"], 
     TemplateBox[{
       SuperscriptBox["m", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     SubsuperscriptBox["\[GothicCapitalO]", "n", 
      RowBox[{"(", "p", ")"}]]}], 
    SubsuperscriptBox["\[VerticalSeparator]", 
     SubscriptBox["r", 
      StyleBox[
       RowBox[{"\[LeftBracketingBar]", "r", "\[RightBracketingBar]"}],
       FontSize->10]], "M"], 
    RowBox[{
     TemplateBox[{
       SuperscriptBox["m", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"], 
     RowBox[{
      UnderoverscriptBox["\[Product]", 
       RowBox[{"j", "=", "2"}], 
       RowBox[{
        RowBox[{"\[LeftBracketingBar]", "r", "\[RightBracketingBar]"}], "-", 
        "1"}]], 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], 
       SubsuperscriptBox["\[GothicCapitalO]", "n", 
        RowBox[{"(", "p", ")"}]]}]}]}], 
    SubsuperscriptBox["\[VerticalSeparator]", 
     SubscriptBox["r", "j"], 
     SubscriptBox["r", 
      RowBox[{"j", "+", "1"}]]], 
    TemplateBox[{
      SuperscriptBox["m", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.827876086077504*^9, 3.827876152374495*^9}, {
   3.8278762528083973`*^9, 3.8278763040383053`*^9}, {3.8279278647896147`*^9, 
   3.827927873630622*^9}, 3.827931272578971*^9, 
   3.827932583565517*^9},ExpressionUUID->"8d54ba2d-1821-45e2-a480-\
b794908442cf"],

Cell[TextData[{
 "which just is a rewriting of the previous term over sequences in ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "a4132a00-8e84-41bc-9328-94e7a4138ece"],
 "."
}], "ExpositoryText",
 CellChangeTimes->{{3.827932587759227*^9, 3.827932605331318*^9}, 
   3.8280376678020782`*^9},ExpressionUUID->"b373d897-9b36-4053-baca-\
94d8bc7d8f9a"],

Cell[TextData[{
 "it is worth noting for every ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "5861bf05-76f1-4eaa-8d54-a482093db017"],
 " there is a corresponding ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "c0789218-d009-4ce6-a00d-73532d9230a1"],
 " and vice verse, and in fact the set of all of these ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "164279a6-6874-4fdb-8d23-f0db29ace007"],
 " terms is just the power set of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[DoubleStruckCapitalN]", "M"], TraditionalForm]],
  ExpressionUUID->"df720055-4826-4346-ba1f-94ad4d7c9faf"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalP]", "M"], TraditionalForm]],ExpressionUUID->
  "32c0afa7-cb79-421e-83db-a587fa2d20bb"],
 ", meaning we can now write"
}], "ExpositoryText",
 CellChangeTimes->{{3.827927881108536*^9, 3.827927913547784*^9}, {
  3.827927998653738*^9, 3.827928003247035*^9}, {3.8279280719709787`*^9, 
  3.827928113209303*^9}, {3.8279281436272373`*^9, 3.8279281459584007`*^9}, {
  3.827928225199004*^9, 3.8279282318634863`*^9}, {3.827931285340437*^9, 
  3.82793130808292*^9}},ExpressionUUID->"638ad257-58ff-4ea5-b0cf-\
d0a665c4b00a"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], 
       SubsuperscriptBox["A", "n", 
        RowBox[{"(", "k", ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], " ", "=", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"M", "=", "1"}], "k"], " ", 
        RowBox[{
         UnderscriptBox["\[Sum]", 
          RowBox[{
           StyleBox["p",
            FontSize->14], "\[Element]", 
           StyleBox[
            SubsuperscriptBox["\[CapitalXi]", "k", "M"],
            FontSize->14]}]], 
         RowBox[{
          UnderscriptBox["\[Sum]", 
           RowBox[{
            StyleBox["r",
             FontSize->14], "\[Element]", 
            SuperscriptBox["\[ScriptCapitalP]", 
             RowBox[{"M", "-", "2"}]]}]], " ", 
          RowBox[{
           FractionBox[
            TemplateBox[{
              RowBox[{
                SuperscriptBox["n", 
                 RowBox[{"(", "0", ")"}]], " "}], 
              RowBox[{"\[VeryThinSpace] ", 
                SuperscriptBox["n", 
                 RowBox[{"(", 
                   SubscriptBox["p", "M"], ")"}]]}]},
             "BraKet"], 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               SubsuperscriptBox["E", "m", 
                RowBox[{"(", "0", ")"}]], "-", 
               SubsuperscriptBox["E", "n", 
                RowBox[{"(", "0", ")"}]]}], ")"}], 
             RowBox[{"\[LeftBracketingBar]", "r", "\[RightBracketingBar]"}]]], 
           TemplateBox[{
             SuperscriptBox["n", 
              RowBox[{"(", "0", ")"}]]},
            "Bra"], 
           RowBox[{
            SubscriptBox["\[GothicCapitalF]", "n"], "(", 
            RowBox[{
             RowBox[{"M", "-", "1"}], ",", " ", 
             RowBox[{"p", "[", 
              RowBox[{":", 
               RowBox[{"-", "1"}]}], "]"}], ",", " ", "r"}], ")"}], 
           TemplateBox[{
             SuperscriptBox["m", 
              RowBox[{"(", "0", ")"}]]},
            "Ket"]}]}]}]}], " ", "+", 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"q", "\[Element]", 
          SuperscriptBox["\[ScriptCapitalP]", 
           RowBox[{"M", "-", "1"}]]}]], 
        RowBox[{
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             SubsuperscriptBox["E", "m", 
              RowBox[{"(", "0", ")"}]], "-", 
             SubsuperscriptBox["E", "n", 
              RowBox[{"(", "0", ")"}]]}], ")"}], 
           RowBox[{"\[LeftBracketingBar]", "q", "\[RightBracketingBar]"}]]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], 
         RowBox[{
          SubscriptBox["\[GothicCapitalF]", "n"], "(", 
          RowBox[{"M", ",", " ", "p", ",", " ", "q"}], ")"}], 
         TemplateBox[{
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"]}]}]}]}]},
    {
     RowBox[{
      RowBox[{"=", 
       RowBox[{
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"M", "=", "1"}], "k"], " ", 
         RowBox[{
          UnderscriptBox["\[Sum]", 
           RowBox[{
            StyleBox["p",
             FontSize->14], "\[Element]", 
            StyleBox[
             SubsuperscriptBox["\[CapitalXi]", "k", "M"],
             FontSize->14]}]], " ", 
          RowBox[{
           UnderscriptBox["\[Sum]", 
            RowBox[{
             StyleBox["r",
              FontSize->14], "\[Element]", 
             SuperscriptBox["\[ScriptCapitalP]", 
              RowBox[{"M", "-", "2"}]]}]], " ", 
           RowBox[{
            FractionBox[
             TemplateBox[{
               RowBox[{
                 SuperscriptBox["n", 
                  RowBox[{"(", "0", ")"}]], " "}], 
               RowBox[{"\[VeryThinSpace] ", 
                 SuperscriptBox["n", 
                  RowBox[{"(", 
                    SubscriptBox["p", "M"], ")"}]]}]},
              "BraKet"], 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                SubsuperscriptBox["E", "m", 
                 RowBox[{"(", "0", ")"}]], "-", 
                SubsuperscriptBox["E", "n", 
                 RowBox[{"(", "0", ")"}]]}], ")"}], 
              RowBox[{
              "\[LeftBracketingBar]", "r", "\[RightBracketingBar]"}]]], 
            TemplateBox[{
              SuperscriptBox["n", 
               RowBox[{"(", "0", ")"}]]},
             "Bra"], 
            SubsuperscriptBox["\[GothicCapitalO]", "n", 
             RowBox[{"(", "p", ")"}]]}]}]}]}], 
        SubsuperscriptBox["\[VerticalSeparator]", "0", 
         SubscriptBox["r", "1"]], 
        RowBox[{
         TemplateBox[{
           RowBox[{"\[VeryThinSpace]", 
             SuperscriptBox["m", 
              RowBox[{"(", "0", ")"}]]}]},
          "Ket"], 
         TemplateBox[{
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], 
         SubsuperscriptBox["\[GothicCapitalO]", "n", 
          RowBox[{"(", "p", ")"}]]}], 
        SubsuperscriptBox["\[VerticalSeparator]", 
         SubscriptBox["r", 
          StyleBox[
           RowBox[{"\[LeftBracketingBar]", "r", "\[RightBracketingBar]"}],
           FontSize->10]], "M"], 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"], 
         RowBox[{
          UnderoverscriptBox["\[Product]", 
           RowBox[{"j", "=", "2"}], 
           RowBox[{
            RowBox[{"\[LeftBracketingBar]", "r", "\[RightBracketingBar]"}], 
            "-", "1"}]], 
          RowBox[{
           TemplateBox[{
             SuperscriptBox["m", 
              RowBox[{"(", "0", ")"}]]},
            "Bra"], 
           SubsuperscriptBox["\[GothicCapitalO]", "n", 
            RowBox[{"(", "p", ")"}]]}]}]}], 
        SubsuperscriptBox["\[VerticalSeparator]", 
         SubscriptBox["r", "j"], 
         SubscriptBox["r", 
          RowBox[{"j", "+", "1"}]]], 
        TemplateBox[{
          SuperscriptBox["m", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}], "\[LineSeparator]", 
      RowBox[{
       RowBox[{"+", 
        RowBox[{
         UnderscriptBox["\[Sum]", 
          RowBox[{"q", "\[Element]", 
           SuperscriptBox["\[ScriptCapitalP]", 
            RowBox[{"M", "-", "1"}]]}]], 
         RowBox[{
          FractionBox["1", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              SubsuperscriptBox["E", "m", 
               RowBox[{"(", "0", ")"}]], "-", 
              SubsuperscriptBox["E", "n", 
               RowBox[{"(", "0", ")"}]]}], ")"}], 
            RowBox[{"\[LeftBracketingBar]", "q", "\[RightBracketingBar]"}]]], 
          
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]]},
           "Bra"], 
          SubsuperscriptBox["\[GothicCapitalO]", "n", 
           RowBox[{"(", "p", ")"}]]}]}]}], 
       SubsuperscriptBox["\[VerticalSeparator]", "0", 
        SubscriptBox["q", "1"]], 
       RowBox[{
        TemplateBox[{
          RowBox[{"\[VeryThinSpace]", 
            SuperscriptBox["m", 
             RowBox[{"(", "0", ")"}]]}]},
         "Ket"], 
        TemplateBox[{
          SuperscriptBox["m", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], 
        SubsuperscriptBox["\[GothicCapitalO]", "n", 
         RowBox[{"(", "p", ")"}]]}], 
       SubsuperscriptBox["\[VerticalSeparator]", 
        SubscriptBox["q", 
         StyleBox[
          RowBox[{"\[LeftBracketingBar]", "q", "\[RightBracketingBar]"}],
          FontSize->10]], "M"], 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["m", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"], 
        RowBox[{
         UnderoverscriptBox["\[Product]", 
          RowBox[{"j", "=", "2"}], 
          RowBox[{
           RowBox[{"\[LeftBracketingBar]", "q", "\[RightBracketingBar]"}], 
           "-", "1"}]], 
         RowBox[{
          TemplateBox[{
            SuperscriptBox["m", 
             RowBox[{"(", "0", ")"}]]},
           "Bra"], 
          SubsuperscriptBox["\[GothicCapitalO]", "n", 
           RowBox[{"(", "p", ")"}]]}]}]}], 
       SubsuperscriptBox["\[VerticalSeparator]", 
        SubscriptBox["q", "j"], 
        SubscriptBox["q", 
         RowBox[{"j", "+", "1"}]]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.827787068614751*^9, 3.827787080575087*^9}, {
  3.82778711921703*^9, 3.827787119623231*^9}, {3.8277880751576233`*^9, 
