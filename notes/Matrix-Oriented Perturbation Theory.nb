    SubscriptBox["\[Del]", "x"], 
    RowBox[{"(", 
     RowBox[{"A", "\[CircleDot]", "B"}], ")"}]}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["A", "x"], "B"}], "+", 
