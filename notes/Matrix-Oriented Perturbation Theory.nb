          RowBox[{"(", "0", ")"}]]},
        "Bra"], 
       SubscriptBox["P", "D"], 
       SuperscriptBox["H", 
        RowBox[{"(", 
         RowBox[{"k", "-", "i"}], ")"}]]}]}], "-", 
     RowBox[{
      SuperscriptBox["E", 
       RowBox[{"(", 
        RowBox[{"k", "-", "i"}], ")"}]], 
      SubscriptBox["P", "D"], 
      TemplateBox[{
        SuperscriptBox["n", 
