Cell[CellGroupData[{

Cell["Degeneracies", "Subsection",
 CellChangeTimes->{{3.828036394031848*^9, 
  3.828036395579587*^9}},ExpressionUUID->"53414dee-60b7-45d2-b77c-\
b5853dc83e15"],

Cell[CellGroupData[{

Cell["First-Brush at Degeneracies", "Subsubsection",
 CellChangeTimes->{{3.8270050293199263`*^9, 
  3.8270050351889*^9}},ExpressionUUID->"16d858d4-6b35-48ed-a8a1-3d9071eec90d"],

Cell[TextData[{
 "Including degeneracies, now, we\[CloseCurlyQuote]ll assume we have some \
space of degenerate states ",
 StyleBox["D",
  FontSlant->"Italic"],
 " and that there is some order of correction, ",
 Cell[BoxData[
  FormBox["\[CapitalOmega]", TraditionalForm]],ExpressionUUID->
  "31fbc653-4e7f-4539-a6a5-7a8f038478b4"],
 ", such that the states are no longer degenerate. To obtain the \
transformation to a new subspace where the prior equations will apply we will \
expand our equations to the appropriate order as"
}], "ExpositoryText",
 CellChangeTimes->{{3.8256960354843683`*^9, 3.825696154311708*^9}, {
  3.825696248594798*^9, 3.8256962696136227`*^9}, {3.825696301718824*^9, 
  3.825696327085147*^9}, {3.825696383308442*^9, 3.825696383363665*^9}, {
  3.825696418619548*^9, 
  3.825696492857926*^9}},ExpressionUUID->"acb2e739-a6a3-435c-bb34-\
073fee2eaa54"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["P", "D"], 
     SuperscriptBox["H", 
      RowBox[{"(", "\[CapitalOmega]", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     SubscriptBox["P", "D"], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}], "\[CapitalOmega]"], 
      RowBox[{
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", 
         RowBox[{"\[CapitalOmega]", "-", "i"}], ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]]},
        "Ket"]}]}]}]}], " ", "=", 
   RowBox[{
    SubscriptBox["P", "D"], 
    SubsuperscriptBox["E", "n", 
     RowBox[{"(", "\[CapitalOmega]", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"], " "}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825696493964294*^9, 3.825696494560236*^9}, {
   3.825696528898571*^9, 3.8256965968869743`*^9}, 3.8256966839488564`*^9, {
   3.825696722319591*^9, 
   3.825696726440159*^9}},ExpressionUUID->"eb0a49e1-5cf0-44a5-868e-\
1496b24f08d5"],

Cell["\<\
and the goal will be to set up an effective zero-order Hamiltonian in this \
new space so that we can write\
\>", "ExpositoryText",
 CellChangeTimes->{{3.825696520382276*^9, 3.825696526480542*^9}, {
  3.825696566469142*^9, 
  3.825696611032277*^9}},ExpressionUUID->"e24817f3-21dd-4459-844b-\
d907fb7ddfd2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[ScriptCapitalH]", "D", 
     RowBox[{"(", "k", ")"}]], 
    TemplateBox[{
      SuperscriptBox["\[Eta]", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], " ", "=", 
   RowBox[{
    SubsuperscriptBox["E", "\[Eta]", 
     RowBox[{"(", "k", ")"}]], 
    TemplateBox[{
      SuperscriptBox["\[Eta]", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"], " "}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825696493964294*^9, 3.825696494560236*^9}, {
  3.825696528898571*^9, 3.825696647746936*^9}, {3.8257027075993*^9, 
  3.825702744027812*^9}},ExpressionUUID->"11591edd-c1bd-44d5-b091-\
90b2fec0c1e5"],

Cell["\<\
and build as usual. We are going to build a general solution by induction, \
but we'll start with the first-order case to get our intuition in place\
\>", "ExpositoryText",
 CellChangeTimes->{{3.825696650951397*^9, 
  3.825696671170244*^9}},ExpressionUUID->"0bee445c-af75-4b61-b607-\
748c5d2416b6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["P", "D"], 
     SuperscriptBox["H", 
      RowBox[{"(", "1", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     SubscriptBox["P", "D"], 
     SubsuperscriptBox["\[CapitalDelta]H", "n", 
      RowBox[{"(", "0", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "1", ")"}]]},
      "Ket"]}]}], " ", "=", 
   RowBox[{
    SubscriptBox["P", "D"], 
    SubsuperscriptBox["E", "n", 
     RowBox[{"(", "1", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"], " "}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825696493964294*^9, 3.825696494560236*^9}, {
   3.825696528898571*^9, 3.8256965968869743`*^9}, 3.8256966839488564`*^9, {
   3.825696732002599*^9, 3.825696741368223*^9}, {3.825698547745413*^9, 
   3.825698552909367*^9}},ExpressionUUID->"4a66c354-d902-44fc-812a-\
37d54a9ab1be"],

Cell[TextData[{
 "Now we\[CloseCurlyQuote]ll note the fact that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[CapitalDelta]H", "n", 
      RowBox[{"(", "0", ")"}]], 
     SubscriptBox["P", "U"]}], "=", 
    RowBox[{
     SubscriptBox["P", "U"], 
     SubsuperscriptBox["\[CapitalDelta]H", "n", 
      RowBox[{"(", "0", ")"}]]}]}], TraditionalForm]],
  CellChangeTimes->{{3.825698600816967*^9, 3.8256986088723383`*^9}},
  ExpressionUUID->"d4c3ca61-cbc9-4c1c-b723-a16df6ac770e"],
 " by the fact that ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalDelta]H", "n", 
    RowBox[{"(", "0", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.825698600816967*^9, 3.8256986088723383`*^9}},
  ExpressionUUID->"8771b95a-3136-44fd-86c0-52fbcb1716c9"],
 " is diagonal in the total space and then use the degeneracy to write"
}], "ExpositoryText",
 CellChangeTimes->{{3.8256985386598873`*^9, 
  3.825698699627002*^9}},ExpressionUUID->"28c2462d-caed-4364-89ce-\
a0b4d2244bdb"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "D"], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", "0", ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "1", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       SubscriptBox["P", "D"], 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "0", ")"}]], "(", 
        RowBox[{
         SubscriptBox["P", "D"], "+", 
         SubscriptBox["P", "U"]}], ")"}], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "1", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        SubscriptBox["P", "D"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "0", ")"}]], 
        SubscriptBox["P", "D"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "1", ")"}]]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        SubscriptBox["P", "D"], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "0", ")"}]], 
        SubscriptBox["P", "U"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "1", ")"}]]},
         "Ket"]}]}]}]},
    {
     RowBox[{"=", "\[DoubleStruckZero]"}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825698600816967*^9, 3.8256986088723383`*^9}, {
  3.825698677836418*^9, 
  3.8256987168801603`*^9}},ExpressionUUID->"cfc4df85-2358-43fe-bf6e-\
cd89c4a841ad"],

Cell["so now we have", "ExpositoryText",
 CellChangeTimes->{{3.8256988644234657`*^9, 
  3.825698867080401*^9}},ExpressionUUID->"d1687d86-fe04-451b-9004-\
26c07728e72f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", "D"], 
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], " ", "=", 
   RowBox[{
    SubscriptBox["P", "D"], 
    SubsuperscriptBox["E", "n", 
     RowBox[{"(", "1", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
