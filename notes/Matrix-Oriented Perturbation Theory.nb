  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.83296646943221*^9, 3.832966475984145*^9}, {
  3.832966511661994*^9, 3.832966521975116*^9}, {3.832966552058927*^9, 
