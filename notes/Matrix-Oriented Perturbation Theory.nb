 RowBox[{
  RowBox[{
   RowBox[{"pertPlot", "[", "mat_", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"Dimensions", "[", "mat", "]"}], "]"}], "\[Equal]", "1"}], 
         ",", " ", 
         RowBox[{"Transpose", "@", 
          RowBox[{"{", "mat", "}"}]}], ",", " ", "mat"}], "]"}]}], "}"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"figMatrixPlot", "[", 
      RowBox[{"m", ",", " ", "\[IndentingNewLine]", 
       RowBox[{"ImageSize", "\[Rule]", 
        RowBox[{"Replace", "[", 
         RowBox[{
          RowBox[{"pixelsPerState", "*", 
           RowBox[{"Replace", "[", 
            RowBox[{
             RowBox[{"Dimensions", "[", 
              RowBox[{"Transpose", "@", "m"}], "]"}], ",", " ", 
             RowBox[{"1", "\[Rule]", "0"}], ",", " ", "1"}], "]"}]}], ",", 
          " ", 
          RowBox[{"0", "\[Rule]", "Automatic"}], ",", " ", "1"}], "]"}]}], 
       ",", " ", "\[IndentingNewLine]", 
       RowBox[{"AspectRatio", "\[Rule]", "Automatic"}]}], 
      "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], 
