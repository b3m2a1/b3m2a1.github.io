Cell[BoxData["\<\"H = \\\\frac{\\\\hbar \\\\omega }{2}\\\\left(\\\\, p^2 + \
q^2\\\\right) + \\\\sum _{i=3}^{\\\\infty }  \
(-1)^i\\\\frac{\\\\left(2^i-2\\\\right)}{i\\\\, !}\\\\hbar ^{(i/\\\\, \
2)}D_e\\\\, \\\\left(\\\\sqrt{\\\\left.a^2\\\\right/\\\\mu \\\\, \\\\omega \
}\\\\right){}^iq^i\"\>"], "Output",
 CellChangeTimes->{3.8438459326675158`*^9},
 CellLabel->
  "Out[412]=",ExpressionUUID->"013d7ae8-f224-4379-91fb-7184ef605b38"]
}, Open  ]],

Cell[TextData[{
 "The potential can also be expressed in terms of \[Omega] and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "\[InvisibleSpace]", "x"}], TraditionalForm]],
  ExpressionUUID->"cc93a87b-c76d-4e97-bde4-e206758b1af6"],
 " through the relations ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["D", "e"], " ", "=", " ", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[HBar]\[Omega]", "2"], "/", "4"}], "\[Omega]", 
     "\[InvisibleSpace]", "x"}]}], TraditionalForm]],ExpressionUUID->
  "4c55f0e9-9600-4fa1-b821-5dca13b20ea4"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", 
    SqrtBox[
     RowBox[{
     "2", "\[Mu]", "\[VeryThinSpace]", "\[Omega]", "\[InvisibleSpace]", 
      RowBox[{"x", "\[ThinSpace]", "/", "\[VeryThinSpace]", "\[HBar]"}]}]]}], 
   TraditionalForm]],ExpressionUUID->"f4c0ed20-13f7-4a06-8c8f-d19ad935452e"],
 " as"
}], "ExpositoryText",
 CellChangeTimes->{{3.8438444756032333`*^9, 3.843844494325712*^9}, {
  3.843844554711082*^9, 3.843844594144949*^9}, {3.843844841461485*^9, 
  3.8438448434752207`*^9}},ExpressionUUID->"0b9fa345-cd7d-4c81-8aac-\
edd7395eb394"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"V", "(", 
    RowBox[{
     RowBox[{"q", ";", " ", "\[Omega]"}], ",", " ", 
     RowBox[{"\[Omega]", "\[InvisibleSpace]", "x"}]}], ")"}], " ", "=", " ", 
   RowBox[{"\[HBar]\[Omega]", " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "2"}], "\[Infinity]"], " ", 
     RowBox[{
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "i"], 
       RowBox[{"i", "\[VeryThinSpace]", "!"}]], " ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["2", 
         RowBox[{"i", "-", "1"}]], "-", "1"}], ")"}], 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox[
         RowBox[{"2", "\[Omega]", "\[InvisibleSpace]", "x", "\[ThinSpace]"}], 
         "\[Omega]"], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"i", "/", "2"}], "-", "1"}], ")"}]], 
      SuperscriptBox["q", "i"]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.84384461853401*^9, 3.843844656336606*^9}, {
  3.843844853391863*^9, 
  3.843844873118596*^9}},ExpressionUUID->"af38730c-aaa9-448d-82ef-\
6a7d620ab4ba"],

Cell[TextData[{
 "but it is worth noting that by introducing ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "\[InvisibleSpace]", "x"}], TraditionalForm]],
  ExpressionUUID->"16d54332-8e93-4b94-9dee-89897c97e0a1"],
 " we have lost the explicit ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[HBar]", 
    RowBox[{"(", 
     RowBox[{"i", "/", "2"}], ")"}]], TraditionalForm]],ExpressionUUID->
  "bddcae71-ec13-4860-bb8f-aef54b8418a1"],
 " form and so [[Equation ??]] will be used to expand the Hamiltonian as "
}], "ExpositoryText",
