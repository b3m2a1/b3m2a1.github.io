Cell["is pretty clearly given by ", "ExpositoryText",
 CellChangeTimes->{{3.890485824319296*^9, 
  3.890485828319087*^9}},ExpressionUUID->"a08e23a1-a07d-470e-b029-\
05e8995c5983"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"N", "(", 
    RowBox[{"a", ",", " ", "b"}], ")"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"N", "(", 
     RowBox[{
      RowBox[{"a", "-", "1"}], ",", " ", "b"}], ")"}], " ", "+", " ", 
    RowBox[{"N", "(", 
     RowBox[{"a", ",", " ", 
      RowBox[{"b", "-", "1"}]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.890485848614307*^9, 
  3.890485873190618*^9}},ExpressionUUID->"b38f70c8-0804-459f-a49b-\
b806e05958f2"],

Cell[TextData[{
 "which we can recognize pretty quickly as the binomial coefficient ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {
       RowBox[{"a", "+", "b"}]},
      {"b"}
     },
     GridBoxAlignment->{"Columns" -> {Center}}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.889297158544037*^9, 3.8892972284816217`*^9}, {
   3.889302209795473*^9, 3.889302221121471*^9}},ExpressionUUID->
  "d0828c8b-4c1c-4d85-837a-44e7512e6b67"],
 " which should be unsurprising as we are essentially trying to fit ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "611c3517-df80-4960-ae88-785aec6a1dac"],
 " lowering operations into ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "+", "b"}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "63d2129b-0117-4000-a796-73811ec72d72"],
 " steps"
}], "ExpositoryText",
 CellChangeTimes->{{3.890486873942692*^9, 3.890486941451538*^9}, {
  3.890486973652602*^9, 3.8904869768511057`*^9}, {3.890487013620975*^9, 
  3.890487058118177*^9}},ExpressionUUID->"53b7470b-a5a1-4e34-8d3b-\
d974ee502930"],

