       RowBox[{
        SubscriptBox["\[CapitalPi]", "m"], "(", "\[VeryThinSpace]", 
        RowBox[{
         RowBox[{
          UnderoverscriptBox["\[Product]", 
           RowBox[{"i", "=", "1"}], 
           RowBox[{"N", "-", "2"}]], " ", 
          RowBox[{
           SubsuperscriptBox["\[CapitalOmega]", "m", 
            RowBox[{"(", 
             SubscriptBox["q", "i"], ")"}]], 
