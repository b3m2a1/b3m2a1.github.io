Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "polyGen", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"polyGen", "[", "0", "]"}], "=", "1"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"polyGen", "[", "1", "]"}], "=", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", "\[FormalA]"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"\[FormalA]", "+", 
      RowBox[{"2", " ", "\[FormalN]"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"polyGen", "[", "b_", "]"}], ":=", 
   RowBox[{
    RowBox[{"polyGen", "[", "b", "]"}], "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[FormalA]", "=", "0"}], "\[FormalI]"], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[FormalN]", "+", "\[FormalA]", "-", "b", "+", "1"}], ")"}],
         " ", 
        RowBox[{"polyGen", "[", 
         RowBox[{"b", "-", "1"}], "]"}]}]}], "/.", "\[VeryThinSpace]", 
      RowBox[{"\[FormalI]", "\[Rule]", "\[FormalA]"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"reducedPolyGen", "[", "b_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"polyGen", "[", "b", "]"}], " ", 
     RowBox[{
      SuperscriptBox["2", "b"], " ", "/", 
      RowBox[{"Binomial", "[", 
       RowBox[{
        RowBox[{"\[FormalA]", "+", "b"}], ",", " ", "b"}], "]"}]}]}], "//", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"polyGen", "[", 
    RowBox[{"a_", ",", " ", "b_"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"a", "==", "0"}], "||", 
      RowBox[{"b", "==", "0"}]}], ",", "\[IndentingNewLine]", "1", ",", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"b", ">", "a"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"polyGen", "[", "a", "]"}], "/.", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"\[FormalA]", "->", "b"}], ",", "\[IndentingNewLine]", 
           RowBox[{"\[FormalN]", "->", 
            RowBox[{"(", 
             RowBox[{"\[FormalN]", "+", 
              RowBox[{"(", 
               RowBox[{"a", "-", "b"}], ")"}]}], ")"}]}]}], 
          "\[IndentingNewLine]", "}"}]}], "//", "Expand"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"polyGen", "[", "b", "]"}], "/.", 
        RowBox[{"\[FormalA]", "->", "a"}]}]}], "\[IndentingNewLine]", "]"}]}],
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"polyGen", "[", 
    RowBox[{"a_", ",", " ", "b_", ",", " ", "shift_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"polyGen", "[", 
     RowBox[{"a", ",", " ", "b"}], "]"}], "/.", 
    RowBox[{"\[FormalN]", "->", 
     RowBox[{"\[FormalN]", "+", "shift"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"polySqrtGen", "[", 
    RowBox[{"a_", ",", " ", "b_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"polyGen", "[", 
     RowBox[{"a", ",", " ", "b"}], "]"}], "*", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"b", ">", "a"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Product", "[", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"\[FormalN]", "-", "i"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "0", ",", " ", 
          RowBox[{"b", "-", "a", "-", "1"}]}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Product", "[", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"\[FormalN]", "+", "i"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "1", ",", " ", 
          RowBox[{"a", "-", "b"}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"polySqrtGen", "[", 
    RowBox[{"a_", ",", " ", "b_", ",", " ", "shift_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"polySqrtGen", "[", 
     RowBox[{"a", ",", " ", "b"}], "]"}], "/.", 
    RowBox[{"\[FormalN]", "->", 
     RowBox[{"\[FormalN]", "+", "shift"}]}]}]}], ";"}]}], "Input",
