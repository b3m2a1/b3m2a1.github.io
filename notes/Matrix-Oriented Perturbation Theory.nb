     RowBox[{
      RowBox[{
       RowBox[{"Cmat", "[", 
        RowBox[{"[", "b", "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"w", "+", "1"}], "]"}], "]"}], "*", 
      RowBox[{"zTerm", "[", 
       RowBox[{"b", ",", " ", "k", ",", " ", "j", ",", " ", "w"}], "]"}]}], 
     ",", "\[IndentingNewLine]", 
