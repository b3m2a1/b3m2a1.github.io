Cell[TextData[{
 "Next we can note that for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SuperscriptBox["A", 
      RowBox[{"i", "\[Rule]", "j"}]], ")"}], 
    RowBox[{"k", "\[Rule]", "l"}]], TraditionalForm]],ExpressionUUID->
  "6198dcef-397f-457a-9ff0-324f27704dd6"],
 ", assuming ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", ">", "j"}], TraditionalForm]],ExpressionUUID->
  "2446975d-3e9f-4e16-9d37-85a217401131"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", ">", "l"}], TraditionalForm]],ExpressionUUID->
  "b76e6ff8-08be-4e13-b5b7-995d08774dbf"],
 ", we can rewrite this in a canonically ordered form as"
}], "ExpositoryText",
 CellChangeTimes->{{3.8329766700460987`*^9, 3.83297667715919*^9}, {
  3.832978296425386*^9, 3.83297831067314*^9}, {3.832978693034719*^9, 
  3.832978694674295*^9}},ExpressionUUID->"66fcffb6-750d-4875-83d7-\
d4125c60fc7a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     SuperscriptBox["A", 
      RowBox[{"i", "\[Rule]", "j"}]], ")"}], 
    RowBox[{"k", "\[Rule]", "l"}]], "=", 
   TagBox[GridBox[{
      {"\[Piecewise]", GridBox[{
         {"A", 
          RowBox[{"j", "=", 
           RowBox[{
            RowBox[{"k", " ", "and", " ", "l"}], "=", "i"}]}]},
         {
          SuperscriptBox["A", 
           RowBox[{"i", "\[Rule]", "l"}]], 
          RowBox[{"j", "=", "k"}]},
         {
          SuperscriptBox[
           RowBox[{"(", 
            SuperscriptBox["A", 
             RowBox[{"k", "\[Rule]", "l"}]], ")"}], 
           RowBox[{"i", "\[Rule]", "j"}]], 
          RowBox[{"k", "<", 
           RowBox[{"i", " ", "and", " ", "l"}], "<", "i", " "}]},
         {
          SuperscriptBox[
           RowBox[{"(", 
            SuperscriptBox["A", 
             RowBox[{"k", "\[Rule]", "l"}]], ")"}], 
           RowBox[{
            RowBox[{"i", "-", "1"}], "\[Rule]", "j"}]], 
          RowBox[{"k", "<", 
           RowBox[{"i", " ", "and", " ", "l"}], "<", "j"}]},
         {
          SuperscriptBox[
           RowBox[{"(", 
            SuperscriptBox["A", 
             RowBox[{"k", "\[Rule]", "l"}]], ")"}], 
           RowBox[{
            RowBox[{"i", "-", "1"}], "\[Rule]", 
            RowBox[{"j", "-", "1"}]}]], 
          RowBox[{"k", "<", 
           RowBox[{"i", " ", "and", " ", "l"}], ">", "j"}]},
         {
          SuperscriptBox[
           RowBox[{"(", 
            SuperscriptBox["A", 
             RowBox[{"i", "\[Rule]", "j"}]], ")"}], 
           RowBox[{"k", "\[Rule]", "l"}]], "else"}
        },
        AllowedDimensions->{2, Automatic},
        Editable->True,
        GridBoxAlignment->{
         "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
          "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
        GridBoxItemSize->{
         "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}},
           "RowsIndexed" -> {}},
        GridBoxSpacings->{"Columns" -> {
            Offset[0.27999999999999997`], {
             Offset[0.84]}, 
            Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, 
          "Rows" -> {
            Offset[0.2], {
             Offset[0.4]}, 
            Offset[0.2]}, "RowsIndexed" -> {}},
        Selectable->True]}
     },
     GridBoxAlignment->{
      "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
       "RowsIndexed" -> {}},
     GridBoxItemSize->{
      "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}}, 
       "RowsIndexed" -> {}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.35]}, 
         Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}, "RowsIndexed" -> {}}],
    "Piecewise",
    DeleteWithContents->True,
    Editable->False,
    SelectWithContents->True,
    Selectable->False,
    StripWrapperBoxes->True]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8329767030165*^9, 3.832976735140023*^9}, {
  3.83297676873367*^9, 3.832976865502388*^9}, {3.832977277504271*^9, 
  3.832977280497383*^9}, {3.832977615686823*^9, 3.832977619461742*^9}, {
  3.832977680553515*^9, 3.832977711799942*^9}, {3.8329778674884253`*^9, 
  3.8329778942147017`*^9}, {3.832978150000906*^9, 3.832978198899218*^9}, {
  3.832978269592351*^9, 3.832978284102798*^9}, {3.8329783229837418`*^9, 
  3.83297832532557*^9}, {3.832978652759028*^9, 
  3.832978685364695*^9}},ExpressionUUID->"8ade9a58-9301-4a58-9710-\
67641087a5de"],

Cell[TextData[{
 "where we can also use the fact that if we have ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["A", 
       RowBox[{"i", "\[Rule]", "j"}]], ")"}], 
     RowBox[{"i", "\[Rule]", "j"}]], 
    RowBox[{"i", "\[Rule]", 
     RowBox[{"j", "..."}]}]], TraditionalForm]],ExpressionUUID->
  "77098772-6474-48f5-95bb-dc6a5181b0d0"],
 " where we iterate ",
 Cell[BoxData[
  FormBox[
   RowBox[{"j", "-", "i", "+", "1"}], TraditionalForm]],ExpressionUUID->
  "1abefabd-5a41-4654-8b7f-94f9500f6334"],
 " times we get the identity. Similarly, given ",
 Cell[BoxData[
  FormBox[
   RowBox[{"j", " ", "<", " ", "i"}], TraditionalForm]],ExpressionUUID->
  "e08be2d5-7634-45d9-af43-cdb3202ced17"],
 " we have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", 
     RowBox[{"i", "\[Rule]", "j"}]], " ", "=", " ", 
    SuperscriptBox[
     SuperscriptBox[
      RowBox[{"(", 
       SuperscriptBox["A", 
        RowBox[{"j", "\[Rule]", "i"}]], ")"}], 
      RowBox[{"j", "\[Rule]", "i"}]], 
     RowBox[{"j", "\[Rule]", 
      RowBox[{"i", "..."}]}]], " "}], TraditionalForm]],
  CellChangeTimes->{{3.8329787790963297`*^9, 3.8329788059965076`*^9}},
  ExpressionUUID->"fbb9890a-73ca-496a-943d-226fc7039435"],
 " where we iterate exactly ",
 Cell[BoxData[
  FormBox[
   RowBox[{"j", "-", "i"}], TraditionalForm]],ExpressionUUID->
  "0583e117-94b7-47a6-9103-8c427b89c88b"],
 " times (you can see how these two come together nicely). With canonical \
ordering this mean we\[CloseCurlyQuote]re hopefully going to get fully \
simplified terms."
}], "ExpositoryText",
 CellChangeTimes->{{3.8329767030165*^9, 3.832976735140023*^9}, {
   3.83297676873367*^9, 3.832976865502388*^9}, {3.832977277504271*^9, 
   3.832977280497383*^9}, {3.832977615686823*^9, 3.832977619461742*^9}, {
   3.832977680553515*^9, 3.832977711799942*^9}, {3.8329778674884253`*^9, 
   3.8329778942147017`*^9}, 3.832978175497107*^9, {3.832978250124854*^9, 
   3.832978272202648*^9}, {3.832978697191395*^9, 3.832978774449587*^9}, {
   3.832978813107703*^9, 
   3.832978886831604*^9}},ExpressionUUID->"c45bb1d1-dc3d-446d-aaed-\
65dfb346c7cd"],

Cell[CellGroupData[{

Cell["Mixed Term", "Subsubsection",
 CellChangeTimes->{{3.832984363384612*^9, 
  3.832984365393095*^9}},ExpressionUUID->"bc614346-f0fa-4631-ab3d-\
f4abda19af28"],

Cell["\<\
The most important term to be able to simplify out for are expandable as\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8329843667638893`*^9, 3.8329843790733137`*^9}, {
  3.8329858558554487`*^9, 3.832985922241843*^9}, {3.8329860600152607`*^9, 
  3.832986060104926*^9}, {3.832986096648782*^9, 
  3.832986099704192*^9}},ExpressionUUID->"cd585bb8-e8f3-4c3c-ad9f-\
432ad6ebb589"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "Q"], 
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox["X", "2"]], "V"}]}], "=", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "Q"], "X"}], 
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox["X", "3"]], "V"}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["Q", "2"]], 
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox["X", "2"]], "V"}]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["Q", "2"]], "X"}], 
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["X", "2"]], "V"}]}], "+", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", "Q"], "X"}], 
        RowBox[{"\[LeftAngleBracket]", "2", "\[RightAngleBracket]"}], 
        RowBox[{
         SubscriptBox["\[Del]", "Q"], "X"}], 
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["X", "4"]], "V"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.80607416078712*^9, 3.806074161684207*^9}, {
   3.8060742074013863`*^9, 3.8060742918699913`*^9}, 3.806074494917165*^9, 
   3.83298659272558*^9},ExpressionUUID->"49bc83c0-678a-4733-ba1d-\
c6912f79795c"],

Cell["and so we can factor these terms out", "ExpositoryText",
 CellChangeTimes->{{3.832985981042554*^9, 3.832985981309639*^9}, {
  3.832986101938916*^9, 
  3.8329861089727287`*^9}},ExpressionUUID->"15751459-aa52-4f94-be84-\
cc1c8a3ab88b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["Q", "2"]], "\[InvisibleSpace]", 
    RowBox[{
     SubscriptBox["\[Del]", 
      SuperscriptBox["X", "2"]], "V"}]}], " ", "=", " ", 
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["Q", "2"]], "\[InvisibleSpace]", 
    RowBox[{
     SubscriptBox["\[Del]", 
      SuperscriptBox["X", "2"]], "V"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.832985926106564*^9, 
  3.832985931122139*^9}},ExpressionUUID->"b4cb5235-5671-4847-a38a-\
