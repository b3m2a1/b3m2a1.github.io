Cell[TextData[{
 "which is a non-trivially solvable problem (honestly it might ",
 StyleBox["not",
  FontSlant->"Italic"],
 " be generally solvable), but which ",
 StyleBox["does",
  FontSlant->"Italic"],
 " give us a way to measure how the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.821911029115279*^9, 3.821911032684766*^9}, {
