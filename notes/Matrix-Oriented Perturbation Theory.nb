        RowBox[{
         RowBox[{
          UnderoverscriptBox["\[Product]", 
           RowBox[{"i", "=", "1"}], 
           RowBox[{"M", "-", "1"}]], " ", 
          RowBox[{
           SubsuperscriptBox["\[CapitalOmega]", "n", 
            RowBox[{"(", 
             SubscriptBox["p", "i"], ")"}]], 
           SubscriptBox["\[Delta]", 
            RowBox[{
             SubscriptBox["t", "i"], "0"}]]}]}], "+", 
         RowBox[{
          SubsuperscriptBox["\[CapitalGamma]", "n", 
           RowBox[{"(", 
            SubscriptBox["p", "i"], ")"}]], 
          SubscriptBox["\[Delta]", 
           RowBox[{
            SubscriptBox["t", "i"], "1"}]]}]}], ")"}], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", 
