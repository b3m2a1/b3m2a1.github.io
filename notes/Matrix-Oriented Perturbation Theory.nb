Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["c", 
     RowBox[{"k", "\[InvisibleSpace] ", "-", "1"}], 
     RowBox[{"(", 
      RowBox[{"b", "-", "1"}], ")"}]], "=", 
    RowBox[{
     SubsuperscriptBox["c", 
      RowBox[{
       RowBox[{"k", " ", "2", "\[InvisibleSpace]", "b"}], "-", "k"}], 
      RowBox[{"(", 
       RowBox[{"b", "-", "1"}], ")"}]], " ", "=", " ", "0"}]}], 
   TraditionalForm]], "ExpositoryTextInline",
