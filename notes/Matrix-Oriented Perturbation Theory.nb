Cell[TextData[{
 "and then with this we can get ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "D"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "1", ")"}]]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "17dfbdf0-a5fb-4124-8b32-1ab850a4a62b"],
 " (since we\[CloseCurlyQuote]re at order 1 the overlap part is zero)"
}], "ExpositoryText",
 CellChangeTimes->{{3.8217344362205973`*^9, 3.821734453284276*^9}, {
  3.821736229002275*^9, 
  3.821736237663027*^9}},ExpressionUUID->"14c92843-5d77-4033-af92-\
fd8b9d620b93"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"$dD", "[", 
    RowBox[{"[", 
     RowBox[{"\"\<n\>\"", ",", " ", "2"}], "]"}], "]"}], "=", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ReplacePart", "[", 
     RowBox[{
      RowBox[{"$dD", "[", 
       RowBox[{"[", 
