Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["A", "n", 
        RowBox[{"(", "i", ")"}]], 
       SubscriptBox["\[CapitalPi]", "n"], 
       SubscriptBox["\[CapitalPi]", "m"], 
       SubsuperscriptBox["A", "m", 
        RowBox[{"(", 
         RowBox[{"k", "-", "i"}], ")"}]]}], "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"M", "=", "1"}], "i"], " ", 
          RowBox[{
           UnderscriptBox["\[Sum]", 
            RowBox[{
             StyleBox["p",
              FontSize->14], "\[Element]", 
             StyleBox[
              SubsuperscriptBox["\[CapitalXi]", "i", "M"],
              FontSize->14]}]], 
           RowBox[{
            UnderscriptBox["\[Sum]", 
             RowBox[{
              StyleBox["s",
               FontSize->14], "\[Element]", 
              StyleBox[
               SuperscriptBox["S", 
                RowBox[{"M", "-", "2"}]],
               FontSize->14]}]], 
            RowBox[{
             SubscriptBox["\[GothicCapitalB]", "n"], "(", 
             RowBox[{"M", ",", " ", "p", ",", " ", "s"}], ")"}]}]}]}], " ", 
         "+", 
         RowBox[{
          UnderscriptBox["\[Sum]", 
           RowBox[{
            StyleBox["t",
             FontSize->14], "\[Element]", 
            StyleBox[
             SuperscriptBox["S", 
              RowBox[{"M", "-", "1"}]],
             FontSize->14]}]], 
          RowBox[{
           SubscriptBox["\[GothicCapitalC]", "n"], "(", 
           RowBox[{"M", ",", " ", "p", ",", " ", "t"}], ")"}]}]}], ")"}], 
       SubscriptBox["\[CapitalPi]", "n"], 
       RowBox[{
        SubscriptBox["\[CapitalPi]", "m"], "(", 
        RowBox[{
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"M", "=", "1"}], 
           RowBox[{"k", "-", "i"}]], " ", 
          RowBox[{
           UnderscriptBox["\[Sum]", 
            RowBox[{
             StyleBox["p",
              FontSize->14], "\[Element]", 
             StyleBox[
              SubsuperscriptBox["\[CapitalXi]", 
               RowBox[{"k", "-", "i"}], "M"],
              FontSize->14]}]], 
           RowBox[{
            UnderscriptBox["\[Sum]", 
             RowBox[{
              StyleBox["s",
               FontSize->14], "\[Element]", 
              StyleBox[
               SuperscriptBox["S", 
                RowBox[{"M", "-", "2"}]],
               FontSize->14]}]], 
            RowBox[{
             SubscriptBox["\[GothicCapitalB]", "m"], "(", 
             RowBox[{"M", ",", " ", "p", ",", " ", "s"}], ")"}]}]}]}], " ", 
         "+", 
         RowBox[{
          UnderscriptBox["\[Sum]", 
           RowBox[{
            StyleBox["t",
             FontSize->14], "\[Element]", 
            StyleBox[
             SuperscriptBox["S", 
              RowBox[{"M", "-", "1"}]],
             FontSize->14]}]], 
          RowBox[{
           SubscriptBox["\[GothicCapitalC]", "m"], "(", 
           RowBox[{"M", ",", " ", "p", ",", " ", "t"}], ")"}]}]}], 
        ")"}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"M", "=", "1"}], "i"], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"N", "=", "1"}], 
         RowBox[{"k", "-", "i"}]], 
        RowBox[{
         UnderscriptBox["\[Sum]", 
          RowBox[{
           StyleBox["p",
            FontSize->14], "\[Element]", 
           StyleBox[
            SubsuperscriptBox["\[CapitalXi]", "i", "M"],
            FontSize->14]}]], 
         RowBox[{
          UnderscriptBox["\[Sum]", 
           RowBox[{
            StyleBox["q",
             FontSize->14], "\[Element]", 
            StyleBox[
             SubsuperscriptBox["\[CapitalXi]", 
              RowBox[{"k", "-", "i"}], "N"],
             FontSize->14]}]], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             UnderscriptBox["\[Sum]", 
              RowBox[{
               StyleBox["s",
                FontSize->14], "\[Element]", 
               StyleBox[
                SuperscriptBox["S", 
                 RowBox[{"M", "-", "2"}]],
                FontSize->14]}]], 
             RowBox[{
              UnderscriptBox["\[Sum]", 
               RowBox[{"\[Sigma]", "\[Element]", 
                StyleBox[
                 SuperscriptBox["S", 
                  RowBox[{"N", "-", "2"}]],
                 FontSize->14]}]], 
              RowBox[{
               RowBox[{
                SubscriptBox["\[GothicCapitalB]", "n"], "(", 
                RowBox[{"M", ",", " ", "p", ",", " ", "s"}], ")"}], 
               SubscriptBox["\[CapitalPi]", "n"], 
               SubscriptBox["\[CapitalPi]", "m"], 
               RowBox[{
                SubscriptBox["\[GothicCapitalB]", "m"], "(", 
                RowBox[{"M", ",", " ", "q", ",", " ", "\[Sigma]"}], 
                ")"}]}]}]}], "+", 
            RowBox[{
             UnderscriptBox["\[Sum]", 
              RowBox[{"s", "\[Element]", 
               StyleBox[
                SuperscriptBox["S", 
                 RowBox[{"M", "-", "2"}]],
                FontSize->14]}]], 
             RowBox[{
              UnderscriptBox["\[Sum]", 
               RowBox[{"\[Tau]", "\[Element]", 
                StyleBox[
                 SuperscriptBox["S", 
                  RowBox[{"N", "-", "1"}]],
                 FontSize->14]}]], 
              RowBox[{
               RowBox[{
                SubscriptBox["\[GothicCapitalB]", "n"], "(", 
                RowBox[{"M", ",", " ", "p", ",", " ", "s"}], ")"}], 
               SubscriptBox["\[CapitalPi]", "n"], 
               SubscriptBox["\[CapitalPi]", "m"], 
               RowBox[{
                SubscriptBox["\[GothicCapitalC]", "m"], "(", 
                RowBox[{"M", ",", " ", "q", ",", " ", "\[Tau]"}], ")"}]}]}]}],
             "\[LineSeparator]", "+", 
            RowBox[{
             UnderscriptBox["\[Sum]", 
              RowBox[{
               StyleBox["t",
                FontSize->14], "\[Element]", 
               StyleBox[
                SuperscriptBox["S", 
                 RowBox[{"M", "-", "1"}]],
                FontSize->14]}]], 
             RowBox[{
              UnderscriptBox["\[Sum]", 
               RowBox[{"\[Sigma]", "\[Element]", 
                StyleBox[
                 SuperscriptBox["S", 
                  RowBox[{"N", "-", "2"}]],
                 FontSize->14]}]], 
              RowBox[{
               RowBox[{
                SubscriptBox["\[GothicCapitalC]", "n"], "(", 
                RowBox[{"M", ",", " ", "p", ",", " ", "t"}], ")"}], 
               SubscriptBox["\[CapitalPi]", "n"], 
               SubscriptBox["\[CapitalPi]", "m"], 
               RowBox[{
                SubscriptBox["\[GothicCapitalB]", "m"], "(", 
                RowBox[{"M", ",", " ", "q", ",", " ", "\[Sigma]"}], 
                ")"}]}]}]}], "+", 
            RowBox[{
             UnderscriptBox["\[Sum]", 
              RowBox[{
               StyleBox["t",
                FontSize->14], "\[Element]", 
               StyleBox[
                SuperscriptBox["S", 
                 RowBox[{"M", "-", "1"}]],
                FontSize->14]}]], 
             RowBox[{
              UnderscriptBox["\[Sum]", 
               RowBox[{"\[Tau]", "\[Element]", 
                StyleBox[
                 SuperscriptBox["S", 
                  RowBox[{"N", "-", "1"}]],
                 FontSize->14]}]], 
              RowBox[{
               RowBox[{
                SubscriptBox["\[GothicCapitalC]", "n"], "(", 
                RowBox[{"M", ",", " ", "p", ",", " ", "t"}], ")"}], 
               SubscriptBox["\[CapitalPi]", "n"], 
               SubscriptBox["\[CapitalPi]", "m"], 
               RowBox[{
                SubscriptBox["\[GothicCapitalC]", "m"], "(", 
                RowBox[{"M", ",", " ", "q", ",", " ", "\[Tau]"}], 
                ")"}]}]}]}]}], ")"}]}]}]}]}]}]}
