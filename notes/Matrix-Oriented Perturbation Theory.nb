   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], " ", 
    SubsuperscriptBox["P", "D", 
     RowBox[{"(", "\[Beta]", ")"}]], 
    SuperscriptBox["\[ScriptCapitalH]", 
     RowBox[{"(", "\[Beta]", ")"}]], 
    SubsuperscriptBox["P", "D", 
     RowBox[{"(", "\[Beta]", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
