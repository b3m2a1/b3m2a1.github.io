      RowBox[{
       RowBox[{"i", "-", "m"}], ",", " ", "j"}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", 
        SubscriptBox["\[Delta]", 
         RowBox[{"\[Omega]", "\[InvisibleSpace]", "m"}]]}], "-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{"m", "-", "\[Omega]"}]]}], ")"}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"b", "-", "m", "+", "1"}], ")"}], 
      RowBox[{"[", 
