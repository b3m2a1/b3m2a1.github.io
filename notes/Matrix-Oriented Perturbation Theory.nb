29e656896ea2"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "k"], 
       TemplateBox[{
         RowBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]], " "}], 
         RowBox[{"\[VeryThinSpace] ", 
           SuperscriptBox["m", 
            RowBox[{"(", 
              RowBox[{"k", "-", "i"}], ")"}]]}]},
        "BraKet"]}], "=", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", "i", "k"], " ", 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Bra"], 
         SubscriptBox["P", 
          SubscriptBox["U", "n"]], 
         SubscriptBox["P", 
          SubscriptBox["U", "m"]], " ", 
         TemplateBox[{
           SuperscriptBox["m", 
            RowBox[{"(", 
              RowBox[{"k", "-", "i"}], ")"}]]},
          "Ket"]}]}], "+", 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "i", ")"}]]},
         "Bra"], 
        SubscriptBox["P", 
         SubscriptBox["U", "n"]], " ", 
        TemplateBox[{
          SuperscriptBox["m", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["m", 
             RowBox[{"(", "0", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["m", 
             RowBox[{"(", 
               RowBox[{"k", "-", "i"}], ")"}]]}]},
         "BraKet"]}], "+", 
       RowBox[{
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "i", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]]}]},
         "BraKet"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], 
        SubscriptBox["P", 
         SubscriptBox["U", "m"]], " ", 
        TemplateBox[{
          SuperscriptBox["m", 
           RowBox[{"(", 
             RowBox[{"k", "-", "i"}], ")"}]]},
         "Ket"]}]}]}]},
    {
     RowBox[{"=", "0"}]},
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]]},
        "Bra"], 
       SubscriptBox["P", 
        SubscriptBox["U", "n"]], 
       SubscriptBox["P", 
        SubscriptBox["U", "m"]], " ", 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", 
            RowBox[{"k", "-", "i"}], ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"j", "=", "0"}], 
          RowBox[{"i", "-", "1"}]], 
         RowBox[{
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "j", ")"}]]},
           "Bra"], 
          SubsuperscriptBox["\[CapitalDelta]H", "n", 
           RowBox[{"(", 
            RowBox[{"i", "-", "j"}], ")"}]], 
          SubscriptBox["\[CapitalPi]", "n"]}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"l", "=", "0"}], 
          RowBox[{"k", "-", "i", "-", "1"}]], 
         RowBox[{
          SubscriptBox["\[CapitalPi]", "m"], 
          SubsuperscriptBox["\[CapitalDelta]H", "m", 
           RowBox[{"(", 
            RowBox[{"k", "-", "i", "-", "l"}], ")"}]], 
          TemplateBox[{
            SuperscriptBox["m", 
             RowBox[{"(", "l", ")"}]]},
           "Ket"]}]}], " ", ")"}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"l", "=", "0"}], 
        RowBox[{"k", "-", "i", "-", "1"}]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], 
         RowBox[{"i", "-", "1"}]], 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "j", ")"}]]},
          "Bra"], 
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", 
           RowBox[{"i", "-", "j"}], ")"}]], 
         SubscriptBox["\[CapitalPi]", "n"], 
         SubscriptBox["\[CapitalPi]", "m"], 
         SubsuperscriptBox["\[CapitalDelta]H", "m", 
          RowBox[{"(", 
           RowBox[{"k", "-", "i", "-", "l"}], ")"}]], 
         TemplateBox[{
           SuperscriptBox["m", 
            RowBox[{"(", "l", ")"}]]},
          "Ket"]}]}]}]}]},
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
