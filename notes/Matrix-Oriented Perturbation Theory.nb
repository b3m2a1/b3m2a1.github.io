        RowBox[{"(", "k", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     SubsuperscriptBox["P", "D", 
      RowBox[{"(", 
       RowBox[{"a", "+", "1"}], ")"}]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "0"}], 
       RowBox[{"k", "-", "1"}]], 
      RowBox[{
       SubsuperscriptBox["\[CapitalDelta]J", "n", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"a", "+", "1"}], ",", " ", 
          RowBox[{"k", "-", "i"}]}], ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]]},
        "Ket"]}]}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"O", "(", 
      RowBox[{"\[Delta]E", " ", 
       SubscriptBox[
        RowBox[{"\[LeftBracketingBar]", 
         RowBox[{"\[LeftBracketingBar]", 
          SubsuperscriptBox["P", "D", 
           RowBox[{"(", 
            RowBox[{"a", "+", "1"}], ")"}]], "\[RightBracketingBar]"}], 
         "\[RightBracketingBar]"}], "2"]}], ")"}], " ", 
     SubsuperscriptBox["P", "D", 
      RowBox[{"(", 
       RowBox[{"a", "+", "1"}], ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", 
          RowBox[{"k", "+", "1"}], ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
