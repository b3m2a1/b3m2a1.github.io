Cell["When constructing the set of terms like", "ExpositoryText",
 CellChangeTimes->{{3.8900522257509003`*^9, 
  3.890052242679864*^9}},ExpressionUUID->"f653a96c-9f34-4c2b-8918-\
3dda972e0010"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SubsuperscriptBox["K", 
        SubscriptBox["b", "1"], 
        SubscriptBox["a", "1"]], "\[InvisibleSpace]", "(", "n", ")"}], 
      RowBox[{
       SubsuperscriptBox["K", 
        SubscriptBox["b", "2"], 
        SubscriptBox["a", "2"]], "\[InvisibleSpace]", "(", 
       RowBox[{"n", "+", 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["a", "1"], "-", 
          SubscriptBox["b", "2"]}], ")"}]}], ")"}]}], "..."}], 
    RowBox[{
     SubsuperscriptBox["K", 
      SubscriptBox["b", "N"], 
      SubscriptBox["a", "N"]], "\[InvisibleSpace]", "(", 
     RowBox[{"n", "+", "k", "-", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["a", "N"], "-", 
        SubscriptBox["b", "N"]}], ")"}]}], ")"}]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SubsuperscriptBox["P", 
        RowBox[{
         RowBox[{
          SubscriptBox["b", "1"], "\[InvisibleSpace]", 
          SubscriptBox["b", "2"]}], "..."}], 
        RowBox[{
         RowBox[{
          SubscriptBox["a", "1"], "\[InvisibleSpace]", 
          SubscriptBox["a", "2"]}], "..."}]], "(", "n", ")"}], "\[InvisibleSpace] ", 
      RowBox[{
       SubsuperscriptBox["S", 
        SubscriptBox["b", "1"], 
        SubscriptBox["a", "1"]], "\[InvisibleSpace]", "(", "n", ")"}], 
      RowBox[{
       SubsuperscriptBox["S", 
        SubscriptBox["b", "2"], 
        SubscriptBox["a", "2"]], "\[InvisibleSpace]", "(", 
       RowBox[{"n", "+", 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["a", "1"], "-", 
          SubscriptBox["b", "2"]}], ")"}]}], ")"}]}], "..."}], 
    RowBox[{
     SubsuperscriptBox["S", 
      SubscriptBox["b", "N"], 
      SubscriptBox["a", "N"]], "\[InvisibleSpace]", "(", 
     RowBox[{"n", "+", "k", "-", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["a", "N"], "-", 
        SubscriptBox["b", "N"]}], ")"}]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8900522439345493`*^9, 
  3.890052244522263*^9}},ExpressionUUID->"591986b5-8f97-4992-aa86-\
b72eaa659fc3"],

Cell["\<\
it ends up being fastest to do this recursively, where we\[CloseCurlyQuote]ll \
build off of our processes for building the possible paths\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8900522458856792`*^9, 3.8900522544320097`*^9}, {
  3.890052671721429*^9, 
  3.890052708497817*^9}},ExpressionUUID->"7065d8c0-800b-4964-a1d2-\
86f63f93eb5d"],

Cell[TextData[{
 "In that process, we built up the possible ",
 Cell[BoxData[
  FormBox["K", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "6029ccef-a97a-4138-8ae9-523ebaa4a35b"],
 " products one by one, adding on newer terms at the end, subject to the \
constraint that we will eventually end up at the appropriate change in \
quanta, as so with ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "a5957c8d-1dc4-4091-a12a-7354da49648c"],
 " terms that change quanta by ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "7c518bf0-4e08-4d93-9c48-949e6916bf6c"],
 ", we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.8900527342314453`*^9, 3.890052737493574*^9}, {
  3.8900527715275593`*^9, 3.890052804130705*^9}, {3.890052890522243*^9, 
