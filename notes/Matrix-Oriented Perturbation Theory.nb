         RowBox[{"(", "0", ")"}]]},
       "Ket"]}], "+", " ", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}], 
       RowBox[{"k", "-", "1"}]], " ", 
      RowBox[{
       TemplateBox[{
