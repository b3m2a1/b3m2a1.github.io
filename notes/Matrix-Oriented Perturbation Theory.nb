Cell["\<\
which we\[CloseCurlyQuote]ll express in terms of the rising factorials \
through the use of the Stirling numbers of the second kind, as this sum can \
be handled very cleanly analytically (for \[Omega] > 0)\
\>", "ExpositoryText",
 CellChangeTimes->{{3.889468527447112*^9, 3.8894685607838306`*^9}, {
  3.8894724455440397`*^9, 
  3.889472449260118*^9}},ExpressionUUID->"69881c0d-a856-4ba8-9bff-\
