Cell["which gives us", "ExpositoryText",
 CellChangeTimes->{{3.828231466784074*^9, 3.828231471270746*^9}, {
  3.828231661521667*^9, 
  3.828231663821185*^9}},ExpressionUUID->"6743f8e9-8ddf-44e6-b4e5-\
c87e9781fa92"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], 
    SubsuperscriptBox["\[GothicCapitalH]", "m", 
     RowBox[{"(", "i", ")"}]], 
    SubscriptBox["\[CapitalPi]", "m"], 
    SuperscriptBox["H", 
     RowBox[{"(", 
      RowBox[{"k", "-", "i"}], ")"}]], 
    TemplateBox[{
      SuperscriptBox["m", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     SubsuperscriptBox["\[GothicCapitalH]", "m", 
      RowBox[{"(", "i", ")"}]], 
     SubscriptBox["\[CapitalPi]", "m"], 
     SubscriptBox["\[CapitalPi]", "n"], 
     SubsuperscriptBox["\[CapitalDelta]H", "n", 
      RowBox[{"(", "0", ")"}]], 
     SuperscriptBox["H", 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]], 
     TemplateBox[{
       SuperscriptBox["m", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], " ", "-", " ", 
    RowBox[{
     FractionBox["1", 
      RowBox[{
       SubscriptBox["E", "n"], "-", 
       SubscriptBox["E", "m"]}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     SubsuperscriptBox["\[GothicCapitalH]", "m", 
      RowBox[{"(", "i", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     SuperscriptBox["H", 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]], 
     TemplateBox[{
       SuperscriptBox["m", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.828231666985671*^9, 3.828231687169847*^9}, {
  3.8282317362377377`*^9, 3.8282317395400133`*^9}, {3.828231859124034*^9, 
