       SubscriptBox["S", "1"], "\[InvisibleSpace]", "P"}], ")"}], 
     RowBox[{
      RowBox[{"\[Omega]", "+", "1"}], ";"}]]}], " ", "=", " ", 
   RowBox[{
    SubscriptBox["S", "2"], "\[CapitalPhi]", "\[InvisibleSpace]", "D", 
    "\[InvisibleSpace]", 
    SubscriptBox["S", "1"], "\[InvisibleSpace]", "P"}]}], 
