Cell[CellGroupData[{

Cell["Hermiticity", "Subsubsubsection",
 CellChangeTimes->{{3.8280364695706472`*^9, 
  3.8280364718720617`*^9}},ExpressionUUID->"287f350d-f561-4638-9cfd-\
a035ea5fa366"],

Cell[TextData[{
 "Finally, this ",
 StyleBox["also",
  FontSlant->"Italic"],
 " tells us that if each ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalDelta]H", "n", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]],ExpressionUUID->
  "8617f9d1-6d1e-4140-8491-0c011a6ae045"],
 " is Hermitian, ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["A", "n", 
    RowBox[{"(", "k", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.827719648262286*^9, 3.827719650707158*^9}, {
    3.8277197714224253`*^9, 3.827719857817995*^9}, {3.82772018193576*^9, 
    3.8277201861987886`*^9}, {3.827720321203558*^9, 3.8277203546598043`*^9}, {
    3.8277204045027*^9, 3.827720577786134*^9}, {3.827720824918646*^9, 
    3.8277209612118587`*^9}, 3.8277210891430807`*^9},ExpressionUUID->
  "360ccb62-98c3-4745-84fa-cadacdb730c3"],
 " is also Hermitian. The proof is straightforward. We start by writing"
}], "ExpositoryText",
 CellChangeTimes->{{3.827761189349312*^9, 3.827761294887731*^9}, {
  3.8277618888996553`*^9, 
  3.8277618933606243`*^9}},ExpressionUUID->"4e7cda0d-5c3e-4f7b-a816-\
c5561b0bbbb2"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox[
       SubsuperscriptBox["A", "n", 
        RowBox[{"(", "k", ")"}]], "\[Dagger]"], "=", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"M", "=", "1"}], "k"], " ", 
        RowBox[{
         UnderscriptBox["\[Sum]", 
          RowBox[{
           StyleBox["p",
            FontSize->14], "\[Element]", 
           StyleBox[
            SubsuperscriptBox["\[CapitalXi]", "k", "M"],
            FontSize->14]}]], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", "\[VeryThinSpace]", 
             RowBox[{
              UnderoverscriptBox["\[Product]", 
               RowBox[{"i", "=", "1"}], 
               RowBox[{"M", "-", "2"}]], 
              RowBox[{
               SubsuperscriptBox["\[CapitalDelta]H", "n", 
                RowBox[{"(", 
                 StyleBox[
                  SubscriptBox["p", "i"],
                  FontSize->14], ")"}]], 
               SubscriptBox["\[CapitalPi]", "n"]}]}], ")"}], 
            SubsuperscriptBox["\[CapitalDelta]H", "n", 
             RowBox[{"(", 
              SubscriptBox["p", 
               RowBox[{"M", "-", "1"}]], ")"}]], 
            TemplateBox[{
              RowBox[{
                SuperscriptBox["n", 
                 RowBox[{"(", "0", ")"}]], " "}], 
              RowBox[{"\[VeryThinSpace] ", 
                SuperscriptBox["n", 
                 RowBox[{"(", 
                   SubscriptBox["p", "M"], ")"}]]}]},
             "BraKet"]}], ")"}], "\[Dagger]"]}]}], " ", "+", " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", "\[VeryThinSpace]", 
           RowBox[{
            UnderoverscriptBox["\[Product]", 
             RowBox[{"i", "=", "1"}], 
             RowBox[{"M", "-", "1"}]], 
            RowBox[{
             SubsuperscriptBox["\[CapitalDelta]H", "n", 
              RowBox[{"(", 
               StyleBox[
                SubscriptBox["p", "i"],
                FontSize->14], ")"}]], 
             SubscriptBox["\[CapitalPi]", "n"]}]}], ")"}], 
          SubsuperscriptBox["\[CapitalDelta]H", "n", 
           RowBox[{"(", 
            SubscriptBox["p", "M"], ")"}]]}], ")"}], "\[Dagger]"]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"M", "=", "1"}], "k"], " ", 
        RowBox[{
         UnderscriptBox["\[Sum]", 
          RowBox[{
           StyleBox["p",
            FontSize->14], "\[Element]", 
           StyleBox[
            SubsuperscriptBox["\[CapitalXi]", "k", "M"],
            FontSize->14]}]], 
         RowBox[{
          RowBox[{
           SubsuperscriptBox["\[CapitalDelta]H", "n", 
            RowBox[{"(", 
             SubscriptBox["p", 
              RowBox[{"M", "-", "1"}]], ")"}]], "(", "\[VeryThinSpace]", 
           RowBox[{
            UnderoverscriptBox["\[Product]", 
             RowBox[{"i", "=", 
              RowBox[{"M", "-", "2"}]}], "1"], 
            RowBox[{
             SubscriptBox["\[CapitalPi]", "n"], 
             SubsuperscriptBox["\[CapitalDelta]H", "n", 
              RowBox[{"(", 
               StyleBox[
                SubscriptBox["p", "i"],
                FontSize->14], ")"}]]}]}], ")"}], 
          TemplateBox[{
            RowBox[{
              SuperscriptBox["n", 
               RowBox[{"(", 
                 SubscriptBox["p", "M"], ")"}]], " "}], 
            RowBox[{"\[VeryThinSpace] ", 
              SuperscriptBox["n", 
               RowBox[{"(", "0", ")"}]]}]},
           "BraKet"]}]}]}], "+", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", 
          SubscriptBox["p", "M"], ")"}]], "(", "\[VeryThinSpace]", 
        RowBox[{
         UnderoverscriptBox["\[Product]", 
          RowBox[{"i", "=", 
           RowBox[{"M", "-", "1"}]}], "1"], 
         RowBox[{
          SubscriptBox["\[CapitalPi]", "n"], 
          SubsuperscriptBox["\[CapitalDelta]H", "n", 
           RowBox[{"(", 
            StyleBox[
             SubscriptBox["p", "i"],
             FontSize->14], ")"}]]}]}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8277612965493803`*^9, 3.8277612972962027`*^9}, {
  3.8277614839972477`*^9, 3.8277615734416933`*^9}, {3.827761776151943*^9, 
  3.827761785609873*^9}, {3.827761875722159*^9, 
  3.8277618771111307`*^9}},ExpressionUUID->"3a1a45f8-1e21-41f5-b9a3-\
f119af827b67"],

