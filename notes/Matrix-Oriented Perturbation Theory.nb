    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{"(", 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox["1", "2"], ")"}], 
         RowBox[{"\[Omega]", "+", "1"}]], ")"}], 
