Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"(", GridBox[{
      {
       SubsuperscriptBox["E", "n", "*"], 
       SubscriptBox["H", 
        RowBox[{
         RowBox[{"n", "\[InvisibleSpace]", "n"}], "+", "k"}]], 
       SubscriptBox["H", 
        RowBox[{"n", "\[InvisibleSpace]", "m"}]], 
       SubscriptBox["H", 
        RowBox[{"n", "\[InvisibleSpace]", "l"}]]},
      {" ", 
       SubsuperscriptBox["E", 
        RowBox[{"n", "+", "k"}], "*"], 
       SubscriptBox["H", 
        RowBox[{"n", "+", 
         RowBox[{"k", "\[InvisibleSpace]", "m"}]}]], 
       SubscriptBox["H", 
        RowBox[{"n", "+", 
         RowBox[{"k", "\[InvisibleSpace]", "l"}]}]]},
      {" ", " ", 
       SubsuperscriptBox["E", "m", "*"], 
       SubscriptBox["H", 
        RowBox[{"m", "\[InvisibleSpace]", "l"}]]},
      {" ", " ", " ", 
       SubsuperscriptBox["E", "l", "*"]}
     }], ")"}], " ", "\[Implies]", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{
        SubsuperscriptBox["E", "n", "*"], "+", "\[Delta]"}], 
       SubscriptBox["H", 
        RowBox[{
         RowBox[{"n", "\[InvisibleSpace]", "n"}], "+", "k"}]], 
       SubscriptBox["H", 
        RowBox[{"n", "\[InvisibleSpace]", "m"}]], 
       SubscriptBox["H", 
        RowBox[{"n", "\[InvisibleSpace]", "l"}]]},
      {" ", 
       RowBox[{
        SubsuperscriptBox["E", 
         RowBox[{"n", "+", "k"}], "*"], "+", "\[Delta]"}], 
       SubscriptBox["H", 
        RowBox[{"n", "+", 
         RowBox[{"k", "\[InvisibleSpace]", "m"}]}]], 
       SubscriptBox["H", 
        RowBox[{"n", "+", 
         RowBox[{"k", "\[InvisibleSpace]", "l"}]}]]},
      {" ", " ", 
       SubsuperscriptBox["E", "m", "*"], 
       SubscriptBox["H", 
        RowBox[{"m", "\[InvisibleSpace]", "l"}]]},
      {" ", " ", " ", 
       SubsuperscriptBox["E", "l", "*"]}
     }], ")"}]}], TraditionalForm]], "ExpositoryMathCentered",
