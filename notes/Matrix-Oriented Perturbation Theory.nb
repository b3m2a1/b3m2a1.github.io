     RowBox[{"k", ",", "i"}], ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.825821227641254*^9, 3.82582126620644*^9}},
  ExpressionUUID->"07dfd975-07c3-4735-b1e3-7da3f4ca0cea"],
 " to establish where it comes from, since we\[CloseCurlyQuote]re build this \
up iteratively as well."
}], "ExpositoryText",
 CellChangeTimes->{{3.825821289778713*^9, 
  3.825821337700508*^9}},ExpressionUUID->"b4048b9c-f186-437a-b360-\
c3a8876978f6"],

Cell[TextData[{
 "First we note that at order 0 we have no degenerate subspace (i.e. there is \
no ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["P", "D", 
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}]], TraditionalForm]],ExpressionUUID->
  "89c6d195-f733-42eb-9e59-5a3f9d472bb3"],
 ") and moreover we just have"
}], "ExpositoryText",
