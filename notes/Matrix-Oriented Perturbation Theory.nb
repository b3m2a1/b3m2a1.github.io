Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox["\[CapitalGamma]", 
       RowBox[{"(", "0", ")"}]], " ", "=", " ", 
      RowBox[{
       RowBox[{"[", 
        RowBox[{
         SubscriptBox["R", 
          RowBox[{"a", "\[InvisibleSpace]", "i"}]], 
         SubscriptBox["R", 
          RowBox[{"b", "\[InvisibleSpace]", "j"}]]}], "]"}], "[", 
       SubsuperscriptBox["G", 
        RowBox[{"a", "\[InvisibleSpace]", "b"}], "0"], "]"}]}]},
    {"..."}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.921686741854549*^9, 3.9216867684936447`*^9}, {
  3.921686816653346*^9, 
  3.9216868171827583`*^9}},ExpressionUUID->"0156bac2-a10b-4c45-885f-\
d46be29cf62d"],

Cell["\<\
from this we\[CloseCurlyQuote]ll note that this is better written as a \
standard coordinate transformation of the form\
\>", "ExpositoryText",
 CellChangeTimes->{{3.921686818727399*^9, 
  3.9216868358934717`*^9}},ExpressionUUID->"8bf40b7b-e85a-4219-b346-\
2a3ac75936fb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["\[CapitalGamma]", 
    RowBox[{"(", "n", ")"}]], " ", "=", " ", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{"p", "\[Element]", 
      RowBox[{"\[ScriptCapitalP]", "(", "n", ")"}]}]], " ", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"t", "\[Element]", 
       RowBox[{"\[CapitalPi]", "(", "p", ")"}]}]], " ", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{
        RowBox[{
         SuperscriptBox["Q", 
          RowBox[{"(", 
           SubscriptBox["p", "1"], ")"}]], 
         RowBox[{"\[LeftAngleBracket]", "\[RightAngleBracket]"}]}], "..."}], 
       RowBox[{"\[LeftAngleBracket]", "\[RightAngleBracket]"}], 
       SuperscriptBox["Q", 
        RowBox[{"(", 
         SubscriptBox["p", "m"], ")"}]], 
       RowBox[{"\[LeftAngleBracket]", "\[RightAngleBracket]"}], 
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox["R", "m"]], 
        SuperscriptBox["\[CapitalGamma]", 
         RowBox[{"(", "0", ")"}]]}]}], "]"}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.921686836954508*^9, 3.9216869303314047`*^9}, {
  3.921687062154305*^9, 
  3.9216870651966057`*^9}},ExpressionUUID->"ada6a520-210e-455a-8f62-\
3f482b69e334"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", "\[RightAngleBracket]"}], " ", "=", " ", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "3"}]}], "\[RightAngleBracket]"}]}], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "25688e5e-43a6-4a3c-9eca-5001b2153fdd"],
 " and "
}], "ExpositoryText",
 CellChangeTimes->{{3.921686954063109*^9, 3.921686958953897*^9}, {
  3.92168707513349*^9, 
  3.921687091662786*^9}},ExpressionUUID->"17c96c07-f1d1-4bc3-95e4-\
6df426c86711"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "R"], "\[CapitalGamma]"}], " ", "=", " ", 
      RowBox[{
       SubscriptBox[
        RowBox[{
         RowBox[{"[", 
          RowBox[{
           SubsuperscriptBox["R", 
            RowBox[{"x", "\[InvisibleSpace]", "a", "\[InvisibleSpace]", "i"}],
             "2"], 
           SubscriptBox["R", 
            RowBox[{"b", "\[InvisibleSpace]", "j"}]]}], "]"}], "[", 
         SubsuperscriptBox["G", 
          RowBox[{"a", "\[InvisibleSpace]", "b"}], "0"], "]"}], 
        RowBox[{
         RowBox[{"x", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "j"}], 
         "+", 
         RowBox[{"x", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "i"}]}]],
        " ", "+", " ", 
       SubscriptBox[
        RowBox[{
         RowBox[{"[", 
          RowBox[{
           SubscriptBox["R", 
            RowBox[{"a", "\[InvisibleSpace]", "i"}]], 
           SubscriptBox["R", 
            RowBox[{"b", "\[InvisibleSpace]", "j"}]]}], "]"}], "[", 
         SubsuperscriptBox["G", 
          RowBox[{"x", "\[InvisibleSpace]", "a", "\[InvisibleSpace]", "b"}], 
          "1"], "]"}], 
        RowBox[{
        "x", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "j"}]]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["R", "2"]], "\[CapitalGamma]"}], " ", "=", " ", 
      RowBox[{
       SubscriptBox[
        RowBox[{
         RowBox[{"[", 
          RowBox[{
           SubsuperscriptBox["R", 
            RowBox[{
            "x", "\[InvisibleSpace]", "y", "\[InvisibleSpace]", "a", 
             "\[InvisibleSpace]", "i"}], "3"], 
           SubscriptBox["R", 
            RowBox[{"b", "\[InvisibleSpace]", "j"}]]}], "]"}], "[", 
         SubsuperscriptBox["G", 
          RowBox[{"a", "\[InvisibleSpace]", "b"}], "0"], "]"}], 
        RowBox[{
         RowBox[{
         "x", "\[InvisibleSpace]", "y", "\[InvisibleSpace]", "i", 
          "\[InvisibleSpace]", "j"}], "+", 
         RowBox[{
         "x", "\[InvisibleSpace]", "y", "\[InvisibleSpace]", "j", 
          "\[InvisibleSpace]", "i"}]}]], " ", "+", " ", 
       SubscriptBox[
        RowBox[{
         RowBox[{"[", 
          RowBox[{
           SubsuperscriptBox["R", 
            RowBox[{
            "x", "\[InvisibleSpace]\[InvisibleSpace]", "a", 
             "\[InvisibleSpace]", "i"}], "2"], 
           SubsuperscriptBox["R", 
            RowBox[{"y", "\[InvisibleSpace]", "b", "\[InvisibleSpace]", "j"}],
             "2"]}], "]"}], "[", 
         SubsuperscriptBox["G", 
          RowBox[{"a", "\[InvisibleSpace]", "b"}], "0"], "]"}], 
        RowBox[{
         RowBox[{
         "x", "\[InvisibleSpace]", "y", "\[InvisibleSpace]", "i", 
          "\[InvisibleSpace]", "j"}], "+", 
         RowBox[{
         "x", "\[InvisibleSpace]", "y", "\[InvisibleSpace]", "j", 
          "\[InvisibleSpace]", "i"}]}]], " ", "+", " ", 
       SubscriptBox[
        RowBox[{
         RowBox[{"[", 
          RowBox[{
           SubsuperscriptBox["R", 
            RowBox[{"x", "\[InvisibleSpace]", "a", "\[InvisibleSpace]", "i"}],
             "2"], 
           SubscriptBox["R", 
            RowBox[{"b", "\[InvisibleSpace]", "j"}]]}], "]"}], "[", 
         SubsuperscriptBox["G", 
          RowBox[{"\[InvisibleSpace]", 
           RowBox[{
           "y", "\[InvisibleSpace]", "a", "\[InvisibleSpace]", "b"}]}], "1"], 
         "]"}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"x", "\[InvisibleSpace]", "y"}], "\[InvisibleSpace]", "+", 
           
           RowBox[{"y", "\[InvisibleSpace]", "x"}]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"i", "\[InvisibleSpace]", "j"}], "+", 
           RowBox[{"j", "\[InvisibleSpace]", "i"}]}], ")"}]}]], " ", "+", " ", 
       SubscriptBox[
        RowBox[{
         RowBox[{"[", 
          RowBox[{
           SubscriptBox["R", 
            RowBox[{"a", "\[InvisibleSpace]", "i"}]], 
           SubscriptBox["R", 
            RowBox[{"b", "\[InvisibleSpace]", "j"}]]}], "]"}], "[", 
         SubsuperscriptBox["G", 
          RowBox[{
          "x", "\[InvisibleSpace]", "y", "\[InvisibleSpace]", "a", 
           "\[InvisibleSpace]", "b"}], "2"], "]"}], 
        RowBox[{
        "x", "\[InvisibleSpace]", "y", "\[InvisibleSpace]", "i", 
         "\[InvisibleSpace]", "j"}]]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["R", "3"]], "\[CapitalGamma]"}], " ", "=", " ", 
      SubscriptBox[
       RowBox[{
        RowBox[{"[", 
         RowBox[{
          SubsuperscriptBox["R", 
           RowBox[{
           "x", "\[InvisibleSpace]", "y", "\[InvisibleSpace]", "z", 
            "\[InvisibleSpace]", "a", "\[InvisibleSpace]", "i"}], "4"], 
          SubscriptBox["R", 
           RowBox[{"b", "\[InvisibleSpace]", "j"}]]}], "]"}], "[", 
        SubsuperscriptBox["G", 
         RowBox[{"a", "\[InvisibleSpace]", "b"}], "0"], "]"}], 
       RowBox[{
        RowBox[{
        "x", "\[InvisibleSpace]", "y", "\[InvisibleSpace]", "z", 
         "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "j"}], "+", 
        RowBox[{
        "x", "\[InvisibleSpace]", "y", "\[InvisibleSpace]", "z", 
         "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "i"}]}]], " "}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.921686960447846*^9, 3.9216870430497847`*^9}, {
