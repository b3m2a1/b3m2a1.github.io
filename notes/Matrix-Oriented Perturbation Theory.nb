                  SubscriptBox["r", "i"]}]], 
                FractionBox[
                 RowBox[{"\[PartialD]", "\[VeryThinSpace]", "d"}], 
                 RowBox[{"\[PartialD]", 
                  SubscriptBox["r", "j"]}]]}]}], ")"}]}], ")"}]}]}]}]}]}]}]}
