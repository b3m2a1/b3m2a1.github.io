Cell[CellGroupData[{

Cell["Partition Indexing", "Subsection",
 CellChangeTimes->{{3.8313851135035667`*^9, 
  3.831385116264962*^9}},ExpressionUUID->"665c079b-afef-423d-aca7-\
35cea60bbba4"],

Cell["\<\
We can get nice recurrences to give us ways to count the number of partitions \
of an integer with given properties. We\[CloseCurlyQuote]ll let it be stated \
without proof that\
\>", "Text",
 CellChangeTimes->{{3.831385117638055*^9, 3.8313851716474533`*^9}, {
  3.831385229013831*^9, 
  3.831385235189608*^9}},ExpressionUUID->"02420950-0e0e-43a9-b56e-\
97ff474c8b60"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"p", "(", 
    RowBox[{"n", ",", " ", "M", ",", " ", "L"}], ")"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"p", "(", 
     RowBox[{"n", ",", " ", "M", ",", " ", 
      RowBox[{"L", "-", "1"}]}], ")"}], " ", "+", " ", 
    RowBox[{"p", "(", 
     RowBox[{
      RowBox[{"n", "-", "L"}], ",", " ", 
      RowBox[{"M", "-", "1"}], ",", " ", "L"}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.831385172733482*^9, 3.831385221236246*^9}, {
  3.831389857856905*^9, 
  3.831389858412245*^9}},ExpressionUUID->"57134d8d-5f12-491c-a513-\
c54084cd5cc5"],

Cell[TextData[{
 "is the number of partitions of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "eb62b597-ecf7-4c44-9e32-84b1ef3c4b7c"],
 " that have at most ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]],ExpressionUUID->
  "ff5f92b4-dae0-42a1-8f68-5ecdfefc0767"],
 " elements where each element is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LessEqual]", "M"}], TraditionalForm]],ExpressionUUID->
  "6d6cd4e8-7abf-4fdc-b5e0-377cf59dc2c3"],
 ". We will also find it useful to note that we can write the number of terms \
with ",
 StyleBox["exactly",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]],ExpressionUUID->
  "6f2fd147-86e9-4b53-9f06-f53af38b3aac"],
 " elements and max-size ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],ExpressionUUID->
  "8ec971f6-d8bb-4927-887b-d7088defdc13"],
 " as"
}], "Text",
 CellChangeTimes->{{3.831385225512293*^9, 3.831385396880913*^9}, {
  3.831385749927854*^9, 
  3.831385782577773*^9}},ExpressionUUID->"9c899abf-a4c5-4e37-b9c3-\
54cd40c9bf40"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"q", "(", 
       RowBox[{"n", ",", " ", "M", ",", " ", "L"}], ")"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"p", "(", 
        RowBox[{"n", ",", " ", "M", ",", " ", "L"}], ")"}], " ", "-", " ", 
       RowBox[{"p", "(", 
        RowBox[{"n", ",", " ", "M", ",", " ", 
         RowBox[{"L", "-", "1"}]}], ")"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{"p", "(", 
        RowBox[{"n", ",", " ", "M", ",", " ", 
         RowBox[{"L", "-", "1"}]}], ")"}], " ", "+", " ", 
       RowBox[{"p", "(", 
        RowBox[{
         RowBox[{"n", "-", "L"}], ",", " ", 
         RowBox[{"M", "-", "1"}], ",", " ", "L"}], ")"}], " ", "-", " ", 
       RowBox[{"p", "(", 
        RowBox[{"n", ",", " ", "M", ",", " ", 
         RowBox[{"L", "-", "1"}]}], ")"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{"p", "(", 
       RowBox[{
        RowBox[{"n", "-", "L"}], ",", " ", 
        RowBox[{"M", "-", "1"}], ",", " ", "L"}], ")"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.831385783834196*^9, 3.8313858084653263`*^9}, {
  3.831389876145073*^9, 
  3.831389955563303*^9}},ExpressionUUID->"24bc29bb-0381-4095-a8a1-\
643fd5c246c1"],

Cell[TextData[{
 "and then furthermore we\[CloseCurlyQuote]ll also often want the number of \
terms with ",
 StyleBox["exactly",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]],ExpressionUUID->
  "1d83b152-08c1-43b0-9aea-3b1d9a8e2ace"],
 " elements with max-size ",
 StyleBox["greater",
  FontSlant->"Italic"],
 " than ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],ExpressionUUID->
  "dacecf14-d3c3-4f2f-99b6-d6d0e9a944cc"],
 " and ",
 StyleBox["less than",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "56982543-d678-4c0d-9b7b-e0f40d1a517c"],
 ", which is given by"
}], "Text",
 CellChangeTimes->{{3.83138587039826*^9, 3.831385917194689*^9}, {
  3.8313946953017483`*^9, 
  3.831394705796459*^9}},ExpressionUUID->"0a6b9401-ef4c-4685-8738-\
5708cf274ea5"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"g", "(", 
       RowBox[{"n", ",", " ", "m", ",", " ", "M", ",", " ", "L"}], ")"}], " ",
       "=", " ", 
      RowBox[{
       RowBox[{"q", "(", 
        RowBox[{"n", ",", " ", "m", ",", " ", "L"}], ")"}], " ", "-", " ", 
       RowBox[{"q", "(", 
        RowBox[{"n", ",", " ", "M", ",", " ", "L"}], ")"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{"p", "(", 
        RowBox[{
         RowBox[{"n", "-", "L"}], ",", " ", 
         RowBox[{"m", "-", "1"}], ",", " ", "L"}], ")"}], " ", "-", " ", 
       RowBox[{"p", "(", 
        RowBox[{
         RowBox[{"n", "-", "L"}], ",", " ", 
         RowBox[{"M", "-", "1"}], ",", " ", "L"}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8313859209306107`*^9, 3.8313859794979362`*^9}, 
   3.831386071362072*^9, {3.83138671191882*^9, 3.8313867830456047`*^9}, {
   3.8313899635639153`*^9, 3.831389966129561*^9}, {3.831394710363805*^9, 
   3.831394716266247*^9}},ExpressionUUID->"a6fc609c-7a5c-4dd3-b23c-\
585004237379"],

Cell[TextData[{
 "Next, if we order our partitions in reverse lexicographic order, \
prioritizing shorter partitions, we know that the number of partitions ",
 StyleBox["before",
  FontSlant->"Italic"],
 " a given partition ",
 Cell[BoxData[
  FormBox["\[Sigma]", TraditionalForm]],ExpressionUUID->
  "7891b2c0-bbea-4537-86a2-af5bd38909e6"],
 " of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "bc32624e-5c54-4f3a-977f-04a58c135151"],
 " with length ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]],ExpressionUUID->
  "35cdfc14-3b89-4d92-90d6-f9e099362116"],
 " and max-size ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],ExpressionUUID->
  "2725c08b-1359-4c9c-bec6-f8ef0d6f2a7d"],
 " is given by"
}], "Text",
 CellChangeTimes->{{3.831385225512293*^9, 
  3.831385396880913*^9}},ExpressionUUID->"93cca7a4-0e78-4dae-9dee-\
9d6608f2b8fe"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"idx", "(", 
    RowBox[{"\[Sigma]", ",", " ", "n", ",", " ", "M", ",", " ", "L"}], ")"}], 
   " ", "=", " ", 
   RowBox[{
    RowBox[{"p", "(", 
     RowBox[{"n", ",", " ", "n", ",", " ", 
      RowBox[{"L", "-", "1"}]}], ")"}], " ", "+", " ", 
    RowBox[{"idxL", "(", 
     RowBox[{"\[Sigma]", ",", " ", "n", ",", " ", "M", ",", " ", "L"}], 
     ")"}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.83138537268782*^9, 3.831385446689315*^9}, 
   3.831385531172344*^9},ExpressionUUID->"d3d57dbd-ab14-4847-b947-\
0d6a9e2a02ee"],

Cell[CellGroupData[{

Cell["WARNING: There are some fucked up indices here", "Subsubsection",
 CellChangeTimes->{{3.831395512119919*^9, 
  3.831395520435165*^9}},ExpressionUUID->"75d725dd-ff43-43e5-a22f-\
437cf2157e80"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox["idxL", TraditionalForm]],ExpressionUUID->
  "e368f89f-b7b0-4324-a4c7-aa685f126890"],
 " counts the number of partitions with ",
 StyleBox["exactly",
  FontSlant->"Italic"],
 " length ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]],ExpressionUUID->
  "35777ad9-e9b1-451b-90de-a90d6bd90ba8"],
 " that precede ",
 Cell[BoxData[
  FormBox["\[Sigma]", TraditionalForm]],ExpressionUUID->
  "b985d961-d203-4176-b024-6ee916fbf71d"],
 " and is recursively defined as"
}], "ExpositoryText",
 CellChangeTimes->{{3.8313854484553823`*^9, 
  3.831385478653235*^9}},ExpressionUUID->"955f9405-99ec-4585-835a-\
eb607b152dfc"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"idxL", "(", 
       RowBox[{"\[Sigma]", ",", " ", "n", ",", " ", "M", ",", " ", "L"}], 
       ")"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"g", "(", 
        RowBox[{"n", ",", " ", 
         RowBox[{"\[Sigma]", "[", "0", "]"}], ",", " ", "M", ",", " ", "L"}], 
        ")"}], " ", "+", " ", 
       RowBox[{"idxL", "(", 
        RowBox[{
         RowBox[{"\[Sigma]", "[", 
          RowBox[{"1", ":"}], "]"}], ",", " ", 
         RowBox[{"n", " ", "-", " ", "M"}], ",", " ", 
         RowBox[{"\[Sigma]", "[", "1", "]"}], ",", " ", 
         RowBox[{"L", "-", "1"}]}], ")"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{"g", "(", 
        RowBox[{"n", ",", " ", "n", ",", " ", "M", ",", " ", "L"}], ")"}], 
       " ", "+", " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], "L"], " ", 
        RowBox[{"g", "(", 
         RowBox[{
          RowBox[{"n", "-", 
           RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{"j", "=", "0"}], 
             RowBox[{"i", "-", "1"}]], 
            RowBox[{"\[Sigma]", "[", "j", "]"}]}]}], ",", " ", 
          RowBox[{"\[Sigma]", "[", 
           RowBox[{"i", "-", "1"}], "]"}], ",", " ", 
          RowBox[{"\[Sigma]", "[", "i", "]"}], ",", " ", 
          RowBox[{"L", "-", "i"}]}], ")"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8313854861197166`*^9, 3.8313855369269533`*^9}, {
  3.8313855866822987`*^9, 3.831385622702264*^9}, {3.8313858439901237`*^9, 
  3.831385860003591*^9}, {3.831386077561021*^9, 3.8313862817768173`*^9}, {
  3.831394728529114*^9, 3.831394732916011*^9}, {3.831394802747778*^9, 
  3.831394804065362*^9}, {3.831394838626906*^9, 
  3.8313948567126493`*^9}},ExpressionUUID->"6ca63db7-93d8-4d02-b361-\
9a6236b8522b"],

Cell[TextData[{
 "we can recognize, though, that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", " ", "=", " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "0"}], 
      RowBox[{"L", "-", "1"}]], 
     SubscriptBox["\[Sigma]", "j"]}]}], TraditionalForm]],ExpressionUUID->
  "81103116-eff4-4295-b727-e4e10220d88c"],
 ", therefore we can say"
}], "ExpositoryText",
 CellChangeTimes->{{3.831387095356517*^9, 3.8313871388853407`*^9}, {
  3.831387223414921*^9, 
  3.831387224825925*^9}},ExpressionUUID->"39e8b5d6-14be-4f60-a503-\
31e9254c577a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["s", "i"], "(", "\[Sigma]", ")"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"n", "-", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"j", "=", "0"}], 
       RowBox[{"i", "-", "1"}]], 
      SubscriptBox["\[Sigma]", "j"]}]}], " ", "=", " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "i"}], 
      RowBox[{"L", "-", "1"}]], "\[InvisibleSpace]", 
     SubscriptBox["\[Sigma]", "j"]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.831387147481666*^9, 
  3.831387228963763*^9}},ExpressionUUID->"393fc29e-417c-4ffc-ae0d-\
b586c33b99db"],

