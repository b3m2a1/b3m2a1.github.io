  ExpressionUUID->"3e9d02d3-66f1-4ac7-ba2c-a132a3ce5778"]
}], "ExpositoryText",
 CellChangeTimes->{{3.825699002549284*^9, 
  3.825699094257965*^9}},ExpressionUUID->"215a9946-f1c5-4cfa-99db-\
cd4109501887"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["P", "D"], 
     SuperscriptBox["H", 
      RowBox[{"(", "2", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     SubscriptBox["P", "D"], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}], "2"], 
      RowBox[{
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", 
         RowBox[{"2", "-", "i"}], ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]]},
        "Ket"]}]}]}]}], " ", "=", 
   RowBox[{
    SubscriptBox["P", "D"], 
    SubsuperscriptBox["E", "n", 
     RowBox[{"(", "2", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
