Cell["and now we get the second order energy correction using", \
"ExpositoryText",
 CellChangeTimes->{{3.821731892027215*^9, 
  3.821731908871089*^9}},ExpressionUUID->"4e486ea1-60d3-42d6-93ee-\
2f3e57c05c8f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["E", 
    RowBox[{"(", "k", ")"}]], "=", " ", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     SuperscriptBox["H", 
      RowBox[{"(", "k", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], " ", "+", " ", 
    RowBox[{
     TemplateBox[{
       RowBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]], ":", "T"}]},
      "Bra"], " ", 
     SubsuperscriptBox["\[Delta]H", "n", 
      RowBox[{"(", "1", ")"}]], 
     TemplateBox[{
       RowBox[{"U", ":", 
         SuperscriptBox["n", 
          RowBox[{"(", 
            RowBox[{"k", "-", "1"}], ")"}]]}]},
      "Ket"]}], " ", "+", " ", 
    RowBox[{
     TemplateBox[{
       RowBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]], ":", "T"}]},
      "Bra"], " ", 
     RowBox[{
      UnderoverscriptBox["\[CapitalDelta]H", 
       StyleBox["1",
        FontSize->14], 
       StyleBox["2",
        FontSize->14]], "(", "k", ")"}], 
     TemplateBox[{
       RowBox[{"T", ":", 
         RowBox[{"\[CapitalDelta]", "\[InvisibleSpace]", "n"}]}]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8217319100702*^9, 3.821731910777964*^9}, 
   3.821732385653213*^9, {3.821733318864588*^9, 3.8217333207345057`*^9}, 
   3.821734099972312*^9},ExpressionUUID->"0ee0b1af-3da1-404a-a258-\
7ade9ee4b849"],

Cell["\<\
which we will only illustrate in part, since it gets tedious to type out\
\>", "ExpositoryText",
 CellChangeTimes->{{3.821734340978175*^9, 
  3.82173435762393*^9}},ExpressionUUID->"de34e7af-5aa7-4115-ade6-\
a2745ebc159a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"$dD", "[", 
    RowBox[{"[", 
     RowBox[{"\"\<E\>\"", ",", " ", "3"}], "]"}], "]"}], "=", 
   RowBox[{"Dot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Phi]", "[", "$dD", "]"}], "[", "0", "]"}], ",", " ", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Dot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[CapitalEta]", "[", "$dD", "]"}], "[", "2", "]"}], ",", 
        RowBox[{
         RowBox[{"\[Phi]", "[", "$dD", "]"}], "[", "0", "]"}]}], "]"}], " ", 
      "+", " ", "\[IndentingNewLine]", 
      RowBox[{"Dot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"dH", "[", "$dD", "]"}], "[", "1", "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"\[ScriptCapitalP]\[ScriptR]", "[", "$dD", "]"}], "[", 
          "\[ScriptCapitalU]", "]"}], ".", 
         RowBox[{
          RowBox[{"\[Phi]", "[", "$dD", "]"}], "[", "1", "]"}]}]}], "]"}], 
      "+", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[CapitalDelta]n", "[", "$dD", "]"}], "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalT]", "[", "$dD", "]"}], ",", " ", "2", ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "@", 
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
     "figStyleText", "[", 
      "\"\<\!\(\*SubsuperscriptBox[\(E\), \(n\), \((2)\)]\)\>\"", "]"}], ",", 
     
     RowBox[{"figStyleText", "@", "\"\<=\>\""}], ",", "\[IndentingNewLine]", 
     RowBox[{"pertPlot", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Phi]", "[", "$dD", "]"}], "[", "0", "]"}], "}"}], "]"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"pertPlot", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Dot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[CapitalEta]", "[", "$dD", "]"}], "[", "2", "]"}], ",", 
         RowBox[{
          RowBox[{"\[Phi]", "[", "$dD", "]"}], "[", "0", "]"}]}], "]"}], " ", 
       "+", " ", "\[IndentingNewLine]", 
       RowBox[{"Dot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"dH", "[", "$dD", "]"}], "[", "1", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"\[ScriptCapitalP]\[ScriptR]", "[", "$dD", "]"}], "[", 
           "\[ScriptCapitalU]", "]"}], ".", 
          RowBox[{
           RowBox[{"\[Phi]", "[", "$dD", "]"}], "[", "1", "]"}]}]}], "]"}], 
       "+", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[CapitalDelta]n", "[", "$dD", "]"}], "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalT]", "[", "$dD", "]"}], ",", " ", "2", ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]}], 
      "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "}"}], 
   "}"}]}]}], "Input",
 CellChangeTimes->{{3.8216453653206253`*^9, 3.821645406409251*^9}, {
