903f375d3ef8"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["c", "k", 
       RowBox[{"(", 
        RowBox[{"a", ",", "b"}], ")"}]], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "a"], " ", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"a", "-", "i"}], ")"}]], 
        RowBox[{"(", " ", 
         RowBox[{
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"j", "=", "0"}], 
            RowBox[{"b", "-", "1"}]], " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               FractionBox["1", 
                SuperscriptBox["2", 
                 RowBox[{"b", "-", "1", "+", "k"}]]], 
               SubsuperscriptBox["f", 
                RowBox[{"k", "\[InvisibleSpace]", "j"}], 
                RowBox[{"\[VeryThinSpace]", 
                 RowBox[{"(", 
                  RowBox[{"b", "-", "1"}], ")"}]}]]}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"i", "-", "k", "+", "1"}], ")"}], 
               FractionBox["1", 
                SuperscriptBox["2", 
                 RowBox[{"b", "-", "1", "+", "k", "-", "1"}]]], 
               SubsuperscriptBox["f", 
                RowBox[{"k", "-", 
                 RowBox[{"1", "\[InvisibleSpace]", "j"}]}], 
                RowBox[{"\[VeryThinSpace]", 
                 RowBox[{"(", 
                  RowBox[{"b", "-", "1"}], ")"}]}]]}]}], ")"}], 
            SuperscriptBox["i", "j"]}]}], " ", "+", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "i"], " ", 
           RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{"j", "=", "0"}], 
             RowBox[{"b", "-", "1", "+", "k", "-", "1"}]], " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               SubsuperscriptBox["g", 
                RowBox[{"k", "\[InvisibleSpace]", "j"}], 
                RowBox[{"\[VeryThinSpace]", 
                 RowBox[{"(", 
                  RowBox[{"b", "-", "1"}], ")"}]}]], "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"i", "-", "k", "+", "1"}], ")"}], 
                SubsuperscriptBox["g", 
                 RowBox[{"k", "-", 
                  RowBox[{"1", "\[InvisibleSpace]", "j"}]}], 
                 RowBox[{"\[VeryThinSpace]", 
                  RowBox[{"(", 
                   RowBox[{"b", "-", "1"}], ")"}]}]]}]}], ")"}], 
             SuperscriptBox["i", "j"]}]}]}]}], ")"}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], "b"], " ", 
        RowBox[{
         FractionBox["1", 
          SuperscriptBox["2", 
           RowBox[{"b", "+", "k"}]]], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", 
            SubsuperscriptBox["f", 
             RowBox[{"k", "\[InvisibleSpace]", "j"}], 
             RowBox[{"\[VeryThinSpace]", 
              RowBox[{"(", 
               RowBox[{"b", "-", "1"}], ")"}]}]]}], "-", 
           RowBox[{"4", 
            RowBox[{"(", 
             RowBox[{"k", "-", "1"}], ")"}], 
            SubsuperscriptBox["f", 
             RowBox[{"k", "-", 
              RowBox[{"1", "\[InvisibleSpace]", "j"}]}], 
             RowBox[{"\[VeryThinSpace]", 
              RowBox[{"(", 
               RowBox[{"b", "-", "1"}], ")"}]}]]}], "+", 
           RowBox[{"4", 
            SubsuperscriptBox["f", 
             RowBox[{"k", "-", 
              RowBox[{"1", "\[InvisibleSpace]", "j"}], "-", "1"}], 
             RowBox[{"\[VeryThinSpace]", 
              RowBox[{"(", 
               RowBox[{"b", "-", "1"}], ")"}]}]]}]}], ")"}], 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"i", "=", "0"}], "a"], " ", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], 
            RowBox[{"(", 
             RowBox[{"a", "-", "i"}], ")"}]], 
           SuperscriptBox["i", "j"]}]}]}]}], " ", "+", " ", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], 
         RowBox[{"(", "a", ")"}]], " ", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"j", "=", "0"}], 
          RowBox[{"b", "+", "k", "-", "1"}]], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            SubsuperscriptBox["g", 
             RowBox[{"k", "\[InvisibleSpace]", "j"}], 
             RowBox[{"\[VeryThinSpace]", 
              RowBox[{"(", 
               RowBox[{"b", "-", "1"}], ")"}]}]], "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"k", "-", "1"}], ")"}], 
             SubsuperscriptBox["g", 
              RowBox[{"k", "-", 
               RowBox[{"1", "\[InvisibleSpace]", "j"}]}], 
              RowBox[{"\[VeryThinSpace]", 
               RowBox[{"(", 
                RowBox[{"b", "-", "1"}], ")"}]}]]}], "+", 
            SubsuperscriptBox["g", 
             RowBox[{"k", "-", 
              RowBox[{"1", "\[InvisibleSpace]", "j"}], "-", "1"}], 
             RowBox[{"\[VeryThinSpace]", 
              RowBox[{"(", 
               RowBox[{"b", "-", "1"}], ")"}]}]]}], ")"}], 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"i", "=", "0"}], "a"], 
           SuperscriptBox["i", "j"]}]}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.891544891133116*^9, 3.8915450969014673`*^9}, {
