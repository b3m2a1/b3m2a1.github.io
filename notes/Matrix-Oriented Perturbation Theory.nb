af56db9c0456"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["R", 
      RowBox[{"(", 
       RowBox[{"i", "+", "2"}], ")"}]]], 
    SubscriptBox["V", "R"]}], " ", "=", " ", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{"p", "\[Element]", 
      RowBox[{"\[ScriptCapitalP]", "(", 
       RowBox[{
        RowBox[{"i", "+", "2"}], ",", " ", "2"}], ")"}]}]], " ", 
    RowBox[{
     SubscriptBox["w", "p"], " ", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
