Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"perturbedState", "=", "6"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$ptData", "=", 
   RowBox[{"initializePTData", "[", 
    RowBox[{"perturbations", ",", " ", "perturbedState"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"$ptData", "[", 
    RowBox[{"[", 
     RowBox[{"\"\<n\>\"", ",", " ", "1"}], "]"}], "]"}], "=", 
   "\[IndentingNewLine]", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"perturbedState", "-", "1"}]}], "]"}], ",", " ", 
     RowBox[{"{", "1", "}"}], ",", 
     RowBox[{"ConstantArray", " ", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{
        RowBox[{"$ptData", "[", 
         RowBox[{"[", "\"\<NDim\>\"", "]"}], "]"}], "-", "perturbedState"}]}],
       "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "@", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"figStyleText", "[", "\"\<\!\(\*TemplateBox[{
SuperscriptBox[
StyleBox[\"n\", FontSlant -> \"Italic\"], 
RowBox[{\"(\", \"0\", \")\"}]]},\"Ket\"]\)\>\"", "]"}], ",", " ", 
     RowBox[{"figStyleText", "@", "\"\<=\>\""}], ",", "\[IndentingNewLine]", 
     RowBox[{"pertPlot", "[", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Phi]", "[", "$ptData", "]"}], "[", "0", "]"}], "}"}], 
       "]"}], "]"}]}], "\[IndentingNewLine]", "}"}], "\[IndentingNewLine]", 
   "}"}]}]}], "Input",
