Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"symBF", "[", 
    RowBox[{"b_", ",", " ", 
     RowBox[{"F_", ":", "\[FormalCapitalF]"}]}], "]"}], ":=", 
   RowBox[{"Array", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"#2", "<=", "#"}], ",", " ", 
        RowBox[{
         RowBox[{"F", "[", "b", "]"}], "[", "##", "]"}], ",", " ", "0"}], 
       "]"}], "&"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"b", "+", "1"}], ",", " ", 
       RowBox[{"b", "+", "1"}]}], "}"}], ",", " ", "0"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"shiftMat", "[", 
    RowBox[{"b_", ",", " ", "k_"}], "]"}], ":=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{"1", ",", " ", 
       RowBox[{"b", "+", "1", "-", 
        RowBox[{"Abs", "[", "k", "]"}]}]}], "]"}], ",", " ", 
     RowBox[{"-", "k"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rangeMat", "[", "b_", "]"}], ":=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "b"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"slam", "[", 
    RowBox[{"b_", ",", " ", "padding_"}], "]"}], ":=", 
   RowBox[{"ArrayPad", "[", 
    RowBox[{
     RowBox[{"tfLamMat", "[", "b", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "padding"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "padding"}], "}"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fContribs", "[", "1", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"slam", "[", 
     RowBox[{"1", ",", " ", "0"}], "]"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fContribs", "[", "b_", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"old", "=", 
      RowBox[{"fContribs", "[", 
       RowBox[{"b", "-", "1"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Join", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"IdentityMatrix", "[", 
            RowBox[{"b", "+", "1"}], "]"}], "-", 
           RowBox[{
            RowBox[{"shiftMat", "[", 
             RowBox[{"b", ",", " ", "1"}], "]"}], ".", 
            RowBox[{"rangeMat", "[", "b", "]"}]}]}], ")"}], ".", 
         "\[IndentingNewLine]", 
         RowBox[{"ArrayPad", "[", 
          RowBox[{"#", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}]}], "]"}]}], "&"}], 
       "/@", "old"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"shiftMat", "[", 
          RowBox[{"b", ",", " ", "1"}], "]"}], ".", 
         RowBox[{"ArrayPad", "[", 
          RowBox[{"#", ",", " ", 
           RowBox[{"{", 
            RowBox[{
