         RowBox[{"(", "0", ")"}]]},
       "Bra"], " ", 
      SubsuperscriptBox["\[CapitalDelta]H", "n", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "\[InvisibleSpace]", "k"}], "+", "1", "-", "i"}], 
        ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}], " ", "+", " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"a", "=", "1"}], "k"], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "0"}], "k"], 
      RowBox[{
       TemplateBox[{
         RowBox[{"\[InvisibleSpace]", 
           SuperscriptBox["n", 
            RowBox[{"(", "a", ")"}]]}]},
        "Bra"], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "k"}], "+", "1", "-", "a", "-", "i"}], ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]]},
        "Ket"]}]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
