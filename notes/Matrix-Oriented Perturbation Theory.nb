  3.8259402995290537`*^9}},ExpressionUUID->"8a14def5-feaa-48c4-bd45-\
33c97c5f681f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"S", "(", 
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], ")"}], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox["\[ScriptCapitalP]", "1"], "(", 
     RowBox[{"S", "(", 
      RowBox[{
       SubscriptBox["q", "1"], 
       SubscriptBox["q", "1"], 
       SubscriptBox["q", "1"]}], ")"}], ")"}], " ", "\[Union]", " ", 
    RowBox[{
     SuperscriptBox["\[ScriptCapitalP]", "2"], "(", 
     RowBox[{"S", "(", 
      RowBox[{
       SubscriptBox["q", "1"], 
       SubscriptBox["q", "1"], 
       SubscriptBox["q", "2"]}], ")"}], ")"}], " ", "\[Union]", " ", 
    RowBox[{
     SuperscriptBox["\[ScriptCapitalP]", "3"], "(", 
     RowBox[{"S", "(", 
      RowBox[{
       SubscriptBox["q", "1"], 
       SubscriptBox["q", "2"], 
       SubscriptBox["q", "3"]}], ")"}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.82594127359604*^9, 3.825941346949606*^9}, {
  3.825941389465212*^9, 
  3.8259413976472282`*^9}},ExpressionUUID->"97f74ae6-1972-48c3-978f-\
ecba3f047ae7"],

Cell["which gives us three equivalence classes of operations. ", \
"ExpositoryText",
