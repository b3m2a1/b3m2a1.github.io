Cell[TextData[{
 "where we simply switched the roles of ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "b03b8bcf-ac92-4a47-8854-6c307cb3d9cc"],
 " and ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "540edd9b-aee4-417a-abb4-0f59a29c4d89"],
 " (so where ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "d1061329-4aa7-4d99-aea6-84615491a299"],
 " was originally the number of lowering operations, now \
it\[CloseCurlyQuote]s the number of raising operations) and so if ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", " ", ">", " ", "a"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "c92fb28a-a407-42ae-bf46-80c848d25530"]
}], "ExpositoryText",
