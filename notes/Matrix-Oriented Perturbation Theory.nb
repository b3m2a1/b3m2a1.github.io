Cell[CellGroupData[{

Cell["Young Diagrams and Permutation/Partition Representations", "Section",
 CellChangeTimes->{{3.826031196467063*^9, 
  3.826031208578018*^9}},ExpressionUUID->"43a94672-db54-49b4-bc02-\
4d32b4dbed3b"],

Cell[TextData[{
 "We\[CloseCurlyQuote]ll note that quantum numbers for every state for a \
multidimensional H.O. with ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],ExpressionUUID->
  "190f3bbc-a2bf-45b2-abd5-b5c25375c63c"],
 " quanta of excitation can be written like"
}], "ExpositoryText",
 CellChangeTimes->{{3.826031213763583*^9, 3.826031251035939*^9}, {
  3.826031286094284*^9, 
  3.826031294960764*^9}},ExpressionUUID->"d3f0e4f0-1165-4f02-8cb0-\
40686165480f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     RowBox[{
       SubscriptBox["n", "1"], ",", " ", 
       SubscriptBox["n", "2"], ",", " ", "...", ",", " ", 
       SubscriptBox["n", "D"]}]},
    "Ket"], " ", "~", " ", 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[Pi]", "D"], ",", " ", 
     SubsuperscriptBox["\[Lambda]", "D", "N"]}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826031241926606*^9, 3.82603132810362*^9}, {
  3.826031471628302*^9, 
  3.826031478509099*^9}},ExpressionUUID->"bfd6888b-6443-42a5-ac6f-\
f11085693321"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Pi]", "D"], TraditionalForm]],
  CellChangeTimes->{{3.826031241926606*^9, 3.82603132810362*^9}, {
   3.826031471628302*^9, 3.826031478509099*^9}},ExpressionUUID->
  "f6efcc28-f457-419c-81e1-1508a51bc196"],
 " is a permutation of length ",
 Cell[BoxData[
  FormBox["D", TraditionalForm]],ExpressionUUID->
  "29bf1210-ff13-425a-b0cf-c1e3022b69f2"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Lambda]", "D", "N"], TraditionalForm]],
