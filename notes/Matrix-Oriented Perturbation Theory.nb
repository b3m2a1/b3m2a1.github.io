  FormBox["a", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "0be2c9df-e40d-44ea-a132-81201b6ceee8"],
 " terms, which we do with another rearrangement (changing ",
 Cell[BoxData[
  FormBox["l", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "2d6be39e-d619-49c2-83f7-2fc4c9fde313"],
 " to \[Omega] for ease of reading) and an application of the Bernoulli \
numbers"
}], "ExpositoryText",
 CellChangeTimes->{{3.889449025487204*^9, 3.889449056351327*^9}, {
  3.889449194026266*^9, 3.889449201757708*^9}, {3.889449269495203*^9, 
