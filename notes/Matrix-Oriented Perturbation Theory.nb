Cell[CellGroupData[{

Cell["General Case", "Subsection",
 CellChangeTimes->{{3.832961332945837*^9, 
  3.8329613344028797`*^9}},ExpressionUUID->"f8952d4e-c7fe-45aa-a423-\
7f775ced6278"],

Cell["\<\
We don\[CloseCurlyQuote]t want to write more terms out by hand, so we note \
that in general we have\
\>", "ExpositoryText",
 CellChangeTimes->{{3.832961349016128*^9, 3.8329613732979193`*^9}, {
  3.83296320737532*^9, 3.832963213705151*^9}, {3.832964200626417*^9, 
  3.832964222568881*^9}, {3.8329644215992203`*^9, 3.832964454912998*^9}, {
  3.832964524972186*^9, 
  3.832964592448307*^9}},ExpressionUUID->"c9a23d23-de3c-494e-8c0d-\
7b5c237ce6a0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", "Q"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["Q", "n"]], "X"}], 
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{"i", ",", "j"}], "\[RightAngleBracket]"}], 
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["X", "m"]], "V"}]}], ")"}]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[Del]", 
       SuperscriptBox["Q", 
        RowBox[{"n", "+", "1"}]]], "X"}], 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       RowBox[{"i", "+", "1"}], ",", "j"}], "\[RightAngleBracket]"}], 
     RowBox[{
      SubscriptBox["\[Del]", 
       SuperscriptBox["X", "m"]], "V"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Del]", "Q"], "X"}], 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{"2", ",", " ", "n"}], "\[RightAngleBracket]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox["Q", "n"]], "X"}], 
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{"i", ",", 
         RowBox[{"j", "+", "1"}]}], "\[RightAngleBracket]"}], 
       RowBox[{
        SubscriptBox["\[Del]", 
         SuperscriptBox["X", 
          RowBox[{"m", "+", "1"}]]], "V"}]}], ")"}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.806061371146659*^9, 3.806061405016197*^9}, {
   3.8329614065865192`*^9, 3.8329614896796503`*^9}, 3.832963247688736*^9, {
   3.832964605838608*^9, 3.83296460768617*^9}, {3.832965303137704*^9, 
   3.832965312301087*^9}, {3.8329660200917587`*^9, 
   3.832966045507614*^9}},ExpressionUUID->"f8e4a322-e355-4895-beca-\
d185c412d812"],

Cell[TextData[{
 "which we can see by considering that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{"i", ",", " ", "j"}], "\[RightAngleBracket]"}], TraditionalForm]],
  ExpressionUUID->"1b1d41da-3de0-409a-9f57-9af82a197bca"],
 " can be written as a matrix multiplication where axis ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],ExpressionUUID->
  "b4281f73-7759-4b40-ae79-6a8c069a8c33"],
 " is shifted to the end of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["Q", "n"]], "X"}], TraditionalForm]],
  CellChangeTimes->{{3.806061371146659*^9, 3.806061405016197*^9}, {
    3.8329614065865192`*^9, 3.8329614896796503`*^9}, 3.832963247688736*^9, {
    3.832964605838608*^9, 3.83296460768617*^9}, {3.832965303137704*^9, 
    3.832965312301087*^9}},ExpressionUUID->
  "984f58dc-9873-44ce-9b7a-2c5e20ef4448"],
 " and axis ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "c6592e5f-c47a-4ff2-805c-7e4d497c2afc"],
 " is shifted to the start of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["X", 
      RowBox[{"m", "+", "1"}]]], "V"}], TraditionalForm]],ExpressionUUID->
  "76c23404-ce4c-4926-bf77-9a01f4402fca"],
 " and the two are then reshaped down to and matrix multiplied together and \
so the regular product rule properties apply, but every time we add an axis \
the contracted axes shift by one. The general form for this is given by"
}], "Text",
 CellChangeTimes->{{3.832965337188973*^9, 3.832965346758275*^9}, {
  3.832965379443421*^9, 3.832965385706908*^9}, {3.83296553329821*^9, 
  3.832965631101199*^9}, {3.832965696485783*^9, 3.832965720539692*^9}, {
  3.83296579356143*^9, 3.832965797056738*^9}, {3.8329658341138*^9, 
  3.832965858769414*^9}, {3.832966359454966*^9, 3.832966368826016*^9}, {
  3.832966409522567*^9, 3.8329664208558083`*^9}, {3.832967125998369*^9, 
  3.832967130653866*^9}, {3.832967185214315*^9, 
  3.832967195254978*^9}},ExpressionUUID->"fdc2a215-31bf-4a96-85f7-\
a3bae0b6bcc1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", "Q"], 
    RowBox[{"(", 
     RowBox[{"A", 
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "\[RightAngleBracket]"}], 
      "B"}], ")"}]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[Del]", "Q"], "A"}], 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       RowBox[{"\[Alpha]", "+", "1"}], ",", " ", "\[Beta]"}], 
      "\[RightAngleBracket]"}], "B"}], " ", "+", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"A", 
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{"\[Alpha]", ",", " ", 
         RowBox[{"\[Beta]", "+", "1"}]}], "\[RightAngleBracket]"}], " ", 
       RowBox[{
        SubscriptBox["\[Del]", "Q"], "B"}]}], ")"}], 
     RowBox[{"n", "\[Rule]", "1"}]]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8329670276650457`*^9, 3.832967086831736*^9}, {
  3.832967140182444*^9, 3.832967167955949*^9}, {3.832967220103116*^9, 
  3.8329672237552557`*^9}},ExpressionUUID->"018f992f-fabc-45b2-b06f-\
a0b75ebfd2df"],

