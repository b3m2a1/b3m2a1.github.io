           RowBox[{"Simplify", "[", 
            RowBox[{"simpDenom", "[", "#", "]"}], "]"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Numerator", "[", "#", "]"}]}], "/", 
           RowBox[{"denomPrefactor", "[", "#", "]"}]}], " ", ",", " ", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Numerator", "[", "#", "]"}], "/", 
           RowBox[{"denomPrefactor", "[", "#", "]"}]}]}], 
         "\[IndentingNewLine]", "]"}], "&"}], ")"}]}], ",", " ", 
     "\[IndentingNewLine]", 
