Cell["and so", "ExpositoryText",
 CellChangeTimes->{{3.889450273242076*^9, 
  3.889450274123602*^9}},ExpressionUUID->"03635e21-e2c4-4f74-b6d3-\
90ee1016468d"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["c", 
       RowBox[{"k", "\[InvisibleSpace]\[VeryThinSpace]", "0"}], 
       RowBox[{"(", "b", ")"}]], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"b", "-", "1"}], ")"}]}], 
        SubsuperscriptBox["c", 
         RowBox[{"k", "\[InvisibleSpace]\[VeryThinSpace]", ",", "0"}], 
         RowBox[{"(", 
          RowBox[{"b", "-", "1"}], ")"}]]}], "+", 
       SubsuperscriptBox["c", 
        RowBox[{
         RowBox[{"k", "-", "1"}], "\[InvisibleSpace]", ",", "0"}], 
        RowBox[{"(", 
         RowBox[{"b", "-", "1"}], ")"}]]}]}]},
    {
     RowBox[{
      SubsuperscriptBox["c", 
       RowBox[{"k", "\[InvisibleSpace]\[VeryThinSpace]", "p"}], 
       RowBox[{"(", "b", ")"}]], " ", "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Omega]", "=", 
         RowBox[{"p", "-", "1"}]}], 
        RowBox[{
         RowBox[{"2", "\[InvisibleSpace]", "b"}], "-", "k"}]], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox["c", 
           RowBox[{
            RowBox[{"k", "\[InvisibleSpace]", "\[Omega]"}], "-", "1"}], 
           RowBox[{"(", 
            RowBox[{"b", "-", "1"}], ")"}]], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"b", "-", "1"}], ")"}], 
           SubsuperscriptBox["c", 
            RowBox[{"k", "\[InvisibleSpace]", "\[Omega]"}], 
            RowBox[{"(", 
             RowBox[{"b", "-", "1"}], ")"}]]}], "+", 
          SubsuperscriptBox["c", 
           RowBox[{"k", "-", 
            RowBox[{"1", "\[InvisibleSpace]", "\[Omega]"}]}], 
           RowBox[{"(", 
            RowBox[{"b", "-", "1"}], ")"}]]}], ")"}], " ", 
        FractionBox[
         RowBox[{
          RowBox[{"(", "\[Omega]", ")"}], "!"}], 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Omega]", "+", "1", "-", "p"}], ")"}], "!"}], 
          RowBox[{
           RowBox[{"(", "p", ")"}], "!"}]}]], 
        SubsuperscriptBox["B", 
         RowBox[{"\[Omega]", "+", "1", "-", "p"}], "+"]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Omega]", "=", "0"}], 
        RowBox[{
         RowBox[{"2", "\[InvisibleSpace]", "b"}], "+", "1", "-", 
         RowBox[{"(", 
          RowBox[{"k", "+", "p"}], ")"}]}]], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox["c", 
           RowBox[{
            RowBox[{"k", "\[InvisibleSpace] ", "\[Omega]"}], "+", "p", "-", 
            "2"}], 
           RowBox[{"(", 
            RowBox[{"b", "-", "1"}], ")"}]], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"b", "-", "1"}], ")"}], 
           SubsuperscriptBox["c", 
            RowBox[{
             RowBox[{"k", "\[InvisibleSpace] ", "\[Omega]"}], "+", "p", "-", 
             "1"}], 
            RowBox[{"(", 
             RowBox[{"b", "-", "1"}], ")"}]]}], "+", 
          SubsuperscriptBox["c", 
           RowBox[{"k", "-", 
            RowBox[{"1", "\[InvisibleSpace]", "\[Omega]"}], "+", "p", "-", 
            "1"}], 
           RowBox[{"(", 
            RowBox[{"b", "-", "1"}], ")"}]]}], ")"}], " ", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Omega]", "+", "p", "-", "1"}], ")"}], "!"}], 
         RowBox[{
          RowBox[{
           RowBox[{"(", "\[Omega]", ")"}], "!"}], 
          RowBox[{
           RowBox[{"(", "p", ")"}], "!"}]}]], 
        SubsuperscriptBox["B", "\[Omega]", "+"]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Omega]", "=", "0"}], 
        RowBox[{
         RowBox[{"2", "\[InvisibleSpace]", "b"}], "+", "1", "-", 
         RowBox[{"(", 
          RowBox[{"k", "+", "p"}], ")"}]}]], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox["c", 
           RowBox[{
            RowBox[{"k", "\[InvisibleSpace] ", "\[Omega]"}], "+", "p", "-", 
            "2"}], 
           RowBox[{"(", 
            RowBox[{"b", "-", "1"}], ")"}]], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"b", "-", "1"}], ")"}], 
           SubsuperscriptBox["c", 
            RowBox[{
             RowBox[{"k", "\[InvisibleSpace] ", "\[Omega]"}], "+", "p", "-", 
             "1"}], 
            RowBox[{"(", 
             RowBox[{"b", "-", "1"}], ")"}]]}], "+", 
          SubsuperscriptBox["c", 
           RowBox[{"k", "-", 
            RowBox[{"1", "\[InvisibleSpace]", "\[Omega]"}], "+", "p", "-", 
            "1"}], 
           RowBox[{"(", 
            RowBox[{"b", "-", "1"}], ")"}]]}], ")"}], " ", 
        RowBox[{"(", " ", 
         RowBox[{
          UnderoverscriptBox["\[Product]", 
           RowBox[{"j", "=", "1"}], 
           RowBox[{"p", "-", "1"}]], " ", 
          FractionBox[
           RowBox[{"\[Omega]", "+", "j"}], 
           RowBox[{"1", "+", "j"}]]}], ")"}], 
        SubsuperscriptBox["B", "\[Omega]", "+"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.889450341416072*^9, 3.889450377073707*^9}, 
   3.889450956852933*^9, {3.889463537963354*^9, 3.889463605994399*^9}, {
   3.889464048823285*^9, 3.889464056481135*^9}, {3.889464126135285*^9, 
   3.8894641847880907`*^9}},ExpressionUUID->"25d3145f-4635-46a4-9b97-\
b4beaa306df7"],

Cell[TextData[{
 "and now we get to try to simplify these coefficient expressions, first off, \
it\[CloseCurlyQuote]s possible to see through a recurrence that ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["c", 
    RowBox[{"k", "\[InvisibleSpace]\[VeryThinSpace]", "0"}], 
    RowBox[{"(", "b", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.889450341416072*^9, 3.889450377073707*^9}},
  ExpressionUUID->"913d97ed-e15d-449d-93ea-ae42fe1bb782"],
 " is a Stirling number of the first kind"
}], "ExpositoryText",
 CellChangeTimes->{{3.889450397294488*^9, 3.8894504131706553`*^9}, {
  3.889450632756531*^9, 3.889450698577447*^9}, {3.88945415203223*^9, 
  3.889454153129183*^9}},ExpressionUUID->"f3582fe3-7759-4254-b007-\
4939ecbe087a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["c", 
    RowBox[{"k", "\[InvisibleSpace]\[VeryThinSpace]", "0"}], 
    RowBox[{"(", "b", ")"}]], " ", "=", " ", 
   RowBox[{
    SubscriptBox["S", "1"], "(", 
    RowBox[{"b", ",", " ", "k"}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8894506604259*^9, 
  3.8894506870218973`*^9}},ExpressionUUID->"55d6582f-e9e6-400a-92cd-\
b3ae3dedc44a"],

Cell[TextData[{
 "Next, we know empirically, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["Q", "k", 
     RowBox[{"(", "b", ")"}]], "(", "a", ")"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "693b51ce-5cce-4b02-9a12-524e9e5f09f3"],
 " is proportional to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", GridBox[{
       {
        RowBox[{"a", "+", "b"}]},
       {"b"}
      },
      GridBoxAlignment->{"Columns" -> {Center}}], ")"}], " ", "=", " ", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"b", "!"}]], 
     RowBox[{
      UnderoverscriptBox["\[Product]", 
       RowBox[{"j", "=", "1"}], "b"], 
      RowBox[{"(", 
       RowBox[{"a", "+", "j"}], ")"}]}]}]}], TraditionalForm]],
  CellChangeTimes->{{3.889456987047215*^9, 3.8894570138735*^9}, {
   3.889457052364588*^9, 3.889457129465434*^9}},ExpressionUUID->
  "eda035dc-5fcf-49c7-ac6c-ea783857bd38"],
 ", and so we can iteratively divide these terms out, i.e. we can write"
}], "ExpositoryText",
 CellChangeTimes->{{3.88945771397155*^9, 
  3.8894578320587997`*^9}},ExpressionUUID->"88c69fce-623b-4095-b7ae-\
b7314681925f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox[
     OverscriptBox["Q", "~"], "k", 
     RowBox[{"(", "b", ")"}]], "(", "a", ")"}], " ", "=", 
   RowBox[{
    RowBox[{"(", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["Q", "k", 
          RowBox[{"(", "b", ")"}]], "(", "a", ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"a", "+", "1"}], ")"}]}], ")"}], " ", "/", 
      RowBox[{"(", 
       RowBox[{"a", "+", "2"}], ")"}]}], ")"}], "/.", ".."}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.889457833663891*^9, 3.889457912376515*^9}, {
  3.88946064199195*^9, 
  3.8894606424215317`*^9}},ExpressionUUID->"d2eaa0c6-c985-4346-9d0c-\
ff96b9bb279e"],

Cell["\<\
This is possible using \[OpenCurlyDoubleQuote]synthetic division\
\[CloseCurlyDoubleQuote] which algorithmically can be defined recursively as\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8894579566657248`*^9, 3.889457984238237*^9}, {
  3.8894585149579697`*^9, 
  3.889458524014503*^9}},ExpressionUUID->"4281a955-d175-4a65-acab-\
276ad450f2ab"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", "0"}], "L"], 
      RowBox[{
       SubscriptBox["c", "k"], 
       SuperscriptBox["a", "k"]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"a", "+", "j"}], ")"}]}], " ", "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"k", "=", "0"}], 
     RowBox[{"L", "-", "1"}]], " ", 
    RowBox[{
     SubsuperscriptBox["c", "k", 
      RowBox[{"(", "j", ")"}]], 
     SuperscriptBox["a", "k"]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.889457980171164*^9, 3.8894581406449957`*^9}, 
   3.889458362912468*^9, {3.889458508864555*^9, 
   3.8894585455660954`*^9}},ExpressionUUID->"8b15e167-e444-4adc-a8dd-\
17f4e9504e16"],

Cell["where", "ExpositoryText",
 CellChangeTimes->{{3.889458551050715*^9, 
  3.889458551460832*^9}},ExpressionUUID->"f6a1cd6f-1a8c-4c00-9c26-\
2769beb4733a"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["c", 
       RowBox[{"L", "-", "1"}], 
       RowBox[{"(", "j", ")"}]], " ", "=", " ", 
      SubscriptBox["c", "L"]}]},
    {
     RowBox[{
      SubsuperscriptBox["c", "k", 
       RowBox[{"(", "j", ")"}]], " ", "=", " ", 
      RowBox[{
       SubscriptBox["c", 
        RowBox[{"k", "+", "1"}]], "-", 
       RowBox[{"j", "\[VeryThinSpace]", 
        SubsuperscriptBox["c", 
         RowBox[{"k", "+", "1"}], 
         RowBox[{"(", "j", ")"}]]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8894585563315887`*^9, 3.8894585939832363`*^9}, {
  3.88945866341*^9, 3.889458678884265*^9}, {3.889459290059936*^9, 
  3.889459290384078*^9}},ExpressionUUID->"bb4c2af0-be7d-49b1-a093-\
2feaab184078"],

Cell[TextData[{
 "and if we let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"j", "=", "1"}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "3121ee61-daa9-4519-b6af-a56b98c6495b"],
 " and iterate this process, we find that we get"
}], "ExpositoryText",
 CellChangeTimes->{{3.889460540817177*^9, 
  3.8894605868870897`*^9}},ExpressionUUID->"a9526f12-4c69-4c0a-abb6-\
8635900d6ba4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox[
     OverscriptBox["Q", "~"], "k", 
     RowBox[{"(", "b", ")"}]], "(", "a", ")"}], " ", "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"p", "=", "0"}], "b"], " ", 
    RowBox[{
     SubsuperscriptBox[
      OverscriptBox["c", "~"], 
      RowBox[{"k", "\[InvisibleSpace]", "p"}], 
      RowBox[{"(", "b", ")"}]], 
     SuperscriptBox["a", "p"]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
