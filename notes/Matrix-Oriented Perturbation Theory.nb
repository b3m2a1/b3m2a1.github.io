          SubscriptBox["R", 
           RowBox[{"b", "\[InvisibleSpace]", "j"}]]}], "]"}], "[", 
        SubsuperscriptBox["G", 
         RowBox[{"x", "\[InvisibleSpace]", "a", "\[InvisibleSpace]", "b"}], 
