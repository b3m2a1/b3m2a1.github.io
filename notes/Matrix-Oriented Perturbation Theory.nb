        "Ket"]}]}], ")"}], 
    RowBox[{
     TemplateBox[{
       SuperscriptBox["m", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], "(", "\[VeryThinSpace]", 
     RowBox[{
      UnderoverscriptBox["\[Product]", 
       RowBox[{"i", "=", 
        RowBox[{
         SubscriptBox["r", 
          RowBox[{"\[LeftBracketingBar]", "r", "\[RightBracketingBar]"}]], 
         "+", "1"}]}], 
       RowBox[{"M", "-", "1"}]], 
      SubsuperscriptBox["\[CapitalOmega]", "n", 
       RowBox[{"(", 
        SubscriptBox["p", "i"], ")"}]]}], ")"}], 
    SubsuperscriptBox["\[CapitalDelta]H", "n", 
     RowBox[{"(", "M", ")"}]], 
    TemplateBox[{
      SuperscriptBox["m", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}]}], TraditionalForm]], "ExpositoryMathCentered",
