Cell[TextData[{
 "Note that for the terms of degree ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "7c4f17b8-93c1-43fc-992e-a5df5a420d7f"],
