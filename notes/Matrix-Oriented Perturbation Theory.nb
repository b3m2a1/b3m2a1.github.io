  3.8213211117049847`*^9}},ExpressionUUID->"0538ab19-2a65-4051-a3e7-\
5b42c29f4251"],

Cell["but then we\[CloseCurlyQuote]ll need to pull out one more term", \
"ExpositoryText",
 CellChangeTimes->{{3.8213210439217653`*^9, 3.821321062481152*^9}, {
  3.82132114746594*^9, 
  3.821321154449539*^9}},ExpressionUUID->"2ec3823b-85f0-4ace-867a-\
6ebea50db0d6"],

