9b6c11f345ec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"polyGenCoeffs", "[", 
   RowBox[{"a_", ",", " ", "b_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Binomial", "[", 
    RowBox[{
     RowBox[{"a", "+", "b"}], ",", " ", "a"}], "]"}], 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Sum", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"w", "!"}], "/", 
         RowBox[{"2", "^", "w"}]}], " ", "*", 
        RowBox[{"Binomial", "[", 
         RowBox[{"b", ",", " ", "w"}], "]"}], "*", 
        RowBox[{"Binomial", "[", 
         RowBox[{"a", ",", " ", "w"}], "]"}], "*", 
        RowBox[{"StirlingS1", "[", 
         RowBox[{
          RowBox[{"b", "-", "w"}], ",", " ", "j"}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"w", ",", " ", "0", ",", " ", 
         RowBox[{"b", "-", "j"}]}], "}"}]}], "\[IndentingNewLine]", "]"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "0", ",", " ", "b"}], "}"}]}], 
    "\[IndentingNewLine]", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.8966562276769533`*^9, 3.8966562908986692`*^9}, {
  3.89665653582209*^9, 
  3.896656540215979*^9}},ExpressionUUID->"ffe28de4-a61f-461d-9bb5-\
d2fa7d80d42d"]
}, Closed]]
}, Open  ]],

