       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], 
         RowBox[{"k", "-", "1"}]], 
        RowBox[{
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", 
           RowBox[{"k", "-", "i"}], ")"}]], 
         SubscriptBox["\[CapitalPi]", "n"], 
         SuperscriptBox["A", 
          RowBox[{"(", "i", ")"}]]}]}], "+", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
