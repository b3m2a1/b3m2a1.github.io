     RowBox[{"fgC", "[", 
      RowBox[{"b", ",", " ", "k"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", "b"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fRec", "[", 
   RowBox[{"b_", ",", " ", "k_", ",", " ", "j_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Sum", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"fgC", "[", 
       RowBox[{"b", ",", " ", 
        RowBox[{"w", "+", "1"}]}], "]"}], "*", 
      RowBox[{"zTerm", "[", 
       RowBox[{"b", ",", " ", "k", ",", " ", "j", ",", " ", "w"}], "]"}]}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"w", ",", " ", "0", ",", " ", 
       RowBox[{"k", "-", "j"}]}], "}"}]}], "\[IndentingNewLine]", "]"}], "//",
    "Quiet"}]}], "\n", 
 RowBox[{
  RowBox[{"zTerm", "[", 
   RowBox[{"b_", ",", " ", "k_", ",", " ", "j_", ",", " ", "w_"}], "]"}], ":=",
   "\[IndentingNewLine]", 
  RowBox[{"Sum", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
