         RowBox[{"\[LeftAngleBracket]", 
          RowBox[{
           SubscriptBox["p", "1"], ",", " ", "2"}], "\[RightAngleBracket]"}], 
         
         RowBox[{
          SubscriptBox["\[Del]", 
           SuperscriptBox["R", 
            SubscriptBox["p", "2"]]], "Q"}], 
         RowBox[{"\[LeftAngleBracket]", 
          RowBox[{
           SubscriptBox["p", "2"], ",", " ", "1"}], "\[RightAngleBracket]"}], 
         
