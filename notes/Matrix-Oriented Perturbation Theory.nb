Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SuperscriptBox[
        SubscriptBox["q", "i"], "3"], "\[InvisibleSpace]", "\[CapitalPi]", 
       "\[InvisibleSpace]", 
       SuperscriptBox[
        SubscriptBox["q", "i"], "3"]}], "=", 
      FractionBox[
       RowBox[{"7", "+", 
        RowBox[{"60", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            FractionBox["1", "2"], "+", 
            SubscriptBox["n", "i"]}], ")"}], "2"]}]}], 
       RowBox[{"16", " ", 
        SubscriptBox["\[Omega]", "i"]}]]}]},
    {
     RowBox[{
      RowBox[{
       SuperscriptBox[
        SubscriptBox["q", "i"], "3"], "\[InvisibleSpace]", "\[CapitalPi]", 
       "\[InvisibleSpace]", 
       SuperscriptBox[
        SubscriptBox["q", "i"], "1"], 
       SuperscriptBox[
        SubscriptBox["q", "j"], "2"]}], "=", 
      FractionBox[
       RowBox[{"3", " ", 
        RowBox[{"(", 
         RowBox[{
          FractionBox["1", "2"], "+", 
          SubscriptBox["n", "i"]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          FractionBox["1", "2"], "+", 
          SubscriptBox["n", "j"]}], ")"}]}], 
       RowBox[{"2", " ", 
        SubscriptBox["\[Omega]", "i"]}]]}]},
    {
     RowBox[{
      RowBox[{
       SuperscriptBox[
        SubscriptBox["q", "i"], "2"], 
       SubscriptBox["q", "j"], "\[InvisibleSpace]", "\[CapitalPi]", 
       "\[InvisibleSpace]", 
       SuperscriptBox[
        SubscriptBox["q", "j"], "3"]}], "=", 
      FractionBox[
       RowBox[{"3", " ", 
        RowBox[{"(", 
         RowBox[{
          FractionBox["1", "2"], "+", 
          SubscriptBox["n", "i"]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          FractionBox["1", "2"], "+", 
          SubscriptBox["n", "j"]}], ")"}]}], 
       RowBox[{"2", " ", 
        SubscriptBox["\[Omega]", "j"]}]]}]},
    {
     RowBox[{
      RowBox[{
       SuperscriptBox[
        SubscriptBox["q", "i"], "2"], 
       SubscriptBox["q", "j"], "\[InvisibleSpace]", "\[CapitalPi]", 
       "\[InvisibleSpace]", 
       SuperscriptBox[
        SubscriptBox["q", "i"], "2"], 
       SubscriptBox["q", "j"]}], "=", 
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"-", "32"}], " ", 
         RowBox[{"(", 
          RowBox[{
           FractionBox["1", "2"], "+", 
           SubscriptBox["n", "i"]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           FractionBox["1", "2"], "+", 
           SubscriptBox["n", "j"]}], ")"}], " ", 
         SubscriptBox["\[Omega]", "i"], " ", 
         SubscriptBox["\[Omega]", "j"]}], "+", 
        RowBox[{"3", " ", 
         SubsuperscriptBox["\[Omega]", "j", "2"]}], "-", 
        RowBox[{"4", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            FractionBox["1", "2"], "+", 
            SubscriptBox["n", "i"]}], ")"}], "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"8", " ", 
            SubsuperscriptBox["\[Omega]", "i", "2"]}], "-", 
           RowBox[{"3", " ", 
            SubsuperscriptBox["\[Omega]", "j", "2"]}]}], ")"}]}]}], 
       RowBox[{"16", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "4"}], " ", 
           SubsuperscriptBox["\[Omega]", "i", "2"], " ", 
           SubscriptBox["\[Omega]", "j"]}], "+", 
          SubsuperscriptBox["\[Omega]", "j", "3"]}], ")"}]}]]}]},
    {
     RowBox[{
      RowBox[{
       SuperscriptBox[
        SubscriptBox["q", "i"], "2"], 
       SubscriptBox["q", "j"], "\[InvisibleSpace]", "\[CapitalPi]", 
       "\[InvisibleSpace]", 
       SubscriptBox["q", "j"], 
       SuperscriptBox[
        SubscriptBox["q", "k"], "2"]}], "=", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox["1", "2"], "+", 
          SubscriptBox["n", "i"]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          FractionBox["1", "2"], "+", 
          SubscriptBox["n", "k"]}], ")"}]}], 
       RowBox[{"2", " ", 
        SubscriptBox["\[Omega]", "j"]}]]}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["q", "i"], 
        SubscriptBox["q", "j"], 
        SubscriptBox["q", "k"], "\[InvisibleSpace]", "\[CapitalPi]", 
        "\[InvisibleSpace]", 
        SubscriptBox["q", "i"], 
        SubscriptBox["q", "j"], 
        SubscriptBox["q", "k"]}], "=", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"32", " ", 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Omega]", "i"], "-", 
            SubscriptBox["\[Omega]", "j"], "-", 
            SubscriptBox["\[Omega]", "k"]}], ")"}]}]], "-", 
        FractionBox["1", 
         RowBox[{"32", " ", 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Omega]", "i"], "+", 
            SubscriptBox["\[Omega]", "j"], "-", 
            SubscriptBox["\[Omega]", "k"]}], ")"}]}]], "-", 
        FractionBox["1", 
         RowBox[{"32", " ", 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Omega]", "i"], "-", 
            SubscriptBox["\[Omega]", "j"], "+", 
            SubscriptBox["\[Omega]", "k"]}], ")"}]}]], "+", 
        FractionBox["1", 
         RowBox[{"32", " ", 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Omega]", "i"], "+", 
            SubscriptBox["\[Omega]", "j"], "+", 
            SubscriptBox["\[Omega]", "k"]}], ")"}]}]], "+", 
        "\[LineSeparator]", 
        RowBox[{
         FractionBox["1", "8"], " ", 
         RowBox[{"(", 
          RowBox[{
           FractionBox["1", "2"], "+", 
           SubscriptBox["n", "j"]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           FractionBox["1", "2"], "+", 
           SubscriptBox["n", "k"]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           FractionBox["1", 
            RowBox[{
             SubscriptBox["\[Omega]", "i"], "-", 
             SubscriptBox["\[Omega]", "j"], "-", 
             SubscriptBox["\[Omega]", "k"]}]], "+", 
           FractionBox["1", 
            RowBox[{
             SubscriptBox["\[Omega]", "i"], "+", 
             SubscriptBox["\[Omega]", "j"], "-", 
             SubscriptBox["\[Omega]", "k"]}]], "+", 
           FractionBox["1", 
            RowBox[{
             SubscriptBox["\[Omega]", "i"], "-", 
             SubscriptBox["\[Omega]", "j"], "+", 
             SubscriptBox["\[Omega]", "k"]}]], "+", 
           FractionBox["1", 
            RowBox[{
             SubscriptBox["\[Omega]", "i"], "+", 
             SubscriptBox["\[Omega]", "j"], "+", 
             SubscriptBox["\[Omega]", "k"]}]]}], ")"}]}]}]}], 
      "\[LineSeparator]", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            FractionBox["1", "2"], "+", 
            SubscriptBox["n", "i"]}], ")"}], 
          RowBox[{"(", 
           RowBox[{
            FractionBox["1", "2"], "+", 
            SubscriptBox["n", "j"]}], ")"}], " ", 
          SubscriptBox["\[Omega]", "k"], " ", 
          RowBox[{"(", 
           RowBox[{
            SubsuperscriptBox["\[Omega]", "i", "2"], "+", 
            SubsuperscriptBox["\[Omega]", "j", "2"], "-", 
            SubsuperscriptBox["\[Omega]", "k", "2"]}], ")"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            FractionBox["1", "2"], "+", 
            SubscriptBox["n", "i"]}], ")"}], 
          RowBox[{"(", 
           RowBox[{
            FractionBox["1", "2"], "+", 
            SubscriptBox["n", "k"]}], ")"}], " ", 
          SubscriptBox["\[Omega]", "j"], " ", 
          RowBox[{"(", 
           RowBox[{
            SubsuperscriptBox["\[Omega]", "i", "2"], "-", 
            SubsuperscriptBox["\[Omega]", "j", "2"], "+", 
            SubsuperscriptBox["\[Omega]", "k", "2"]}], ")"}]}]}], 
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[Omega]", "i"], "-", 
           SubscriptBox["\[Omega]", "j"], "-", 
           SubscriptBox["\[Omega]", "k"]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[Omega]", "i"], "+", 
           SubscriptBox["\[Omega]", "j"], "-", 
           SubscriptBox["\[Omega]", "k"]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[Omega]", "i"], "-", 
           SubscriptBox["\[Omega]", "j"], "+", 
           SubscriptBox["\[Omega]", "k"]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[Omega]", "i"], "+", 
           SubscriptBox["\[Omega]", "j"], "+", 
           SubscriptBox["\[Omega]", "k"]}], ")"}]}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8121090633240633`*^9, 3.812109089120929*^9}, {
   3.8121098810033283`*^9, 3.812109910945717*^9}, {3.8121099845175257`*^9, 
