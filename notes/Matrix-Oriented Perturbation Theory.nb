 FormBox[
  RowBox[{
   SubsuperscriptBox["T", 
    SubscriptBox["b", "i"], 
    SubscriptBox["a", "i"]], " ", "=", " ", 
   SubsuperscriptBox["S", 
    RowBox[{"min", "(", 
     RowBox[{
      RowBox[{
       SubscriptBox["b", "i"], "-", 
       SubscriptBox["a", "i"]}], ",", "0"}], ")"}], 
    RowBox[{"max", "(", 
     RowBox[{
      RowBox[{
       SubscriptBox["a", "i"], "-", 
       SubscriptBox["b", "i"]}], ",", "0"}], ")"}]]}], 
  TraditionalForm]], "ExpositoryMathCentered",
