Cell[CellGroupData[{

Cell["Towards Analytic Expressions", "Section",
 CellChangeTimes->{{3.811955997244495*^9, 3.811956006398954*^9}, {
  3.811964555237267*^9, 3.8119645564494553`*^9}, {3.814106526465149*^9, 
  3.814106532202436*^9}, {3.814748759092141*^9, 
  3.814748760570256*^9}},ExpressionUUID->"2a899d85-1ae4-48c8-bdc6-\
7dc6a1eab1b2"],

Cell["\<\
We would like to take this very elegant way of doing perturbation theory \
based on the iterative corrections given by\
\>", "ExpositoryText",
 CellChangeTimes->{{3.811956010522622*^9, 3.8119560340276003`*^9}, 
   3.811957841015905*^9},ExpressionUUID->"e604b23b-2ad7-43f5-8b06-\
92ed04171e1d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    SubscriptBox["E", "n"], 
    RowBox[{"(", "k", ")"}]], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], " ", 
     SuperscriptBox["H", 
      RowBox[{"(", "k", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], " ", "+", " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], 
      RowBox[{"k", "-", "1"}]], 
     RowBox[{
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]]},
       "Bra"], " ", 
      SuperscriptBox["H", 
       RowBox[{"(", 
        RowBox[{"k", "-", "i"}], ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}], " ", "-", " ", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["E", "n"], 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]], 
     TemplateBox[{
       RowBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]], " "}], 
       RowBox[{"\[VeryThinSpace] ", 
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]]}]},
      "BraKet"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8119560589102287`*^9, 
  3.811956059622684*^9}},ExpressionUUID->"8518ba3a-4d47-4985-8e95-\
69fc1c18635f"],

Cell[TextData[{
 "and use it to derive the next order of correction when \
we\[CloseCurlyQuote]re using a set of harmonic zero-order states, assuming we \
have lower-order expressions in terms of the \[OpenCurlyDoubleQuote]classical \
actions\[CloseCurlyDoubleQuote] (i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["n", "k"], "+", 
    FractionBox["1", "2"]}], TraditionalForm]],ExpressionUUID->
  "be43d237-f33d-47e4-9304-263f0d2c2828"],
 "). We\[CloseCurlyQuote]re not aiming for any flavor of explicit formula. \
Instead our goal will be to generate the coefficient matrix through the \
tensor operations, rather than to write them down by hand."
}], "ExpositoryText",
 CellChangeTimes->{{3.811956061062764*^9, 3.8119561085523577`*^9}, {
  3.8119564114304037`*^9, 3.81195645515106*^9}, {3.811966713745254*^9, 
  3.81196676897075*^9}},ExpressionUUID->"fbac2c93-b4c6-4a18-a6ea-\
0d7d7f031228"],

Cell["\<\
To see if this is even feasible, we\[CloseCurlyQuote]ll start by trying to \
rewrite the second-order energy as\
\>", "ExpositoryText",
 CellChangeTimes->{{3.811956529071537*^9, 3.811956547083518*^9}, {
  3.811957850890687*^9, 
  3.811957857246278*^9}},ExpressionUUID->"2dfeb2b0-8fb3-4d14-86c7-\
3fb5e008344f"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox[
       SubscriptBox["E", "n"], 
       RowBox[{"(", "2", ")"}]], "=", 
      RowBox[{"X", "\[CircleDot]", 
       SuperscriptBox["a", "2"]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{"i", "\[InvisibleSpace]", "j"}]], 
       RowBox[{
        RowBox[{
         SubscriptBox["x", 
          RowBox[{"i", "\[InvisibleSpace]", "j"}]], "(", 
         RowBox[{
          SubscriptBox["n", "i"], "+", 
          FractionBox["1", "2"]}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["n", "j"], "+", 
          FractionBox["1", "2"]}], ")"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.81195616060509*^9, 3.811956220859634*^9}, {
  3.811957562502832*^9, 
  3.811957571501989*^9}},ExpressionUUID->"5e6b4079-cdc7-43e7-8332-\
14959c118cf5"],

