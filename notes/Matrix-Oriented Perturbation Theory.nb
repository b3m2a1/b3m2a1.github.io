   3.8215777472691097`*^9, 3.821577983547103*^9}, {3.821578563657338*^9, 
   3.82157857070404*^9}, {3.821578610866733*^9, 3.8215786161211863`*^9}, {
   3.82157867789042*^9, 3.821578679789487*^9}, {3.821579358951417*^9, 
   3.821579360024152*^9}},ExpressionUUID->"9dac75f2-c642-46cd-8a62-\
b6166a97e5e6"],

Cell[TextData[{
 "We\[CloseCurlyQuote]ll pick some state and call it ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "33e1c406-6590-41bc-89f0-9e8c23b6754a"],
 ". In the non-degenerate case this defines ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "86571f7f-e745-420a-a3ce-e8fc9ac27bc6"],
 "."
}], "ExpositoryText",
