c4e24b22a0c2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox["c", "~"], 
    RowBox[{"k", "\[InvisibleSpace]", "p"}], 
    RowBox[{"(", 
     RowBox[{"b", "-", "1"}], ")"}]], " ", "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"j", "=", "0"}], 
     RowBox[{"\[InvisibleSpace]", 
      RowBox[{"b", "-", "p"}]}]], " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"(", 
       RowBox[{"j", "+", "b"}], ")"}]], 
     RowBox[{
      SubscriptBox["S", "2"], "(", 
      RowBox[{
       RowBox[{"j", "+", "b", "-", "2"}], ",", " ", 
       RowBox[{"b", "-", "1"}]}], ")"}], 
