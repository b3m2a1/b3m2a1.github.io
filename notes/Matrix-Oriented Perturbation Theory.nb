        RowBox[{"(", 
         RowBox[{"a", "+", "1", "-", "j"}], ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Ket"]}]}]}], "+", 
    RowBox[{
     SubscriptBox["P", 
      SuperscriptBox["D", 
       RowBox[{"(", "a", ")"}]]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"j", "=", "1"}], "a"], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], 
        RowBox[{"k", "-", "1"}]], 
       RowBox[{
        SubsuperscriptBox["J", "a", 
         RowBox[{"(", "j", ")"}]], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", 
          RowBox[{"k", "+", "a", "+", "1", "-", "j", "-", "i"}], ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "i", ")"}]]},
