Cell[TextData[{
 "we see that we can\[CloseCurlyQuote]t eliminate any of the existing \
possibilities, but at least we ",
 StyleBox["can",
  FontSlant->"Italic"],
 " eliminate some of what ",
 StyleBox["pQQp",
  FontSlant->"Italic"],
 " can do."
}], "ExpositoryText",
 CellChangeTimes->{{3.8135906070389557`*^9, 3.8135906583933287`*^9}, {
  3.813591766001183*^9, 
  3.8135917675223827`*^9}},ExpressionUUID->"db1bd540-4c9e-44d4-9fc6-\
f4cd89367295"],

Cell["\<\
So that\[CloseCurlyQuote]s all well and good, but how can we do this \
programmatically? Well basically we can write an algorithm to do what we just \
did, but programmatically. It will start from the left-most operator, \
determine which transformations it can do, then take a reduced Cartesian \
product with the next operator where two conditions are satisfied\
\>", "ExpositoryText",
 CellChangeTimes->{{3.813591773418188*^9, 3.813591884076108*^9}, {
  3.813593121118126*^9, 
  3.813593130803526*^9}},ExpressionUUID->"15f8c072-6622-4252-9d05-\
f33e6f3f6fba"],

Cell[BoxData[{
 FormBox[
  RowBox[{
  "1.", " ", "the", " ", "identity", " ", "transform", " ", "is", " ", 
   "forbidden"}], TraditionalForm], "\[IndentingNewLine]", 
 FormBox[
  RowBox[{
  "2.", " ", "the", " ", "total", " ", "number", " ", "of", " ", "quanta", 
   " ", "changed", " ", "is", " ", "less", " ", "than", " ", "or", " ", 
   "equal", " ", "to", " ", "the", " ", "sum", " ", "of", " ", "the", " ", 
   "dimension", " ", "of", " ", "the", " ", "remaining", " ", "transforms"}], 
  TraditionalForm]}], "ExpositoryMath",
 CellChangeTimes->{{3.81359188625453*^9, 3.813591976477847*^9}, 
   3.8135931680191507`*^9},ExpressionUUID->"983d8831-64ef-4805-ab6b-\
8087aed44bae"],

Cell["\<\
we do this until the second to last operator, then we figure out which of \
these transformations have inverses in the ones supported by the final \
operator\
\>", "ExpositoryText",
 CellChangeTimes->{{3.813593169525094*^9, 
  3.813593209329095*^9}},ExpressionUUID->"0ae07d59-bc68-4984-9375-\
e5a332d6aa60"],

Cell[BoxData[{
 RowBox[{"pertPopTerms", "//", "Clear"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pertPopTerms", "[", 
   RowBox[{"opDims", ":", 
    RowBox[{"{", 
     RowBox[{"_Integer", ",", " ", "__Integer"}], "}"}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Block", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
     "getTerms", ",", "getChanges", ",", "getTransfs", ",", 
      "\[IndentingNewLine]", "possibleTransfs", ",", "reduceTransfs", ",", 
      "\[IndentingNewLine]", "checkTerm", ",", "\[IndentingNewLine]", 
      "reducedProduct", ",", "\[IndentingNewLine]", "terms", ",", " ", 
      "finale"}], "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"getTerms", "[", "n_Integer", "]"}], ":=", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"getTerms", "[", "n", "]"}], "=", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sort", "@", 
           RowBox[{
            RowBox[{"Tally", "[", "#", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", " ", "2"}], "]"}], "]"}]}], "&"}], "/@", 
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"Range", "[", "n", "]"}], ",", "n"}], "]"}]}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"getTerms", "[", 
       RowBox[{"n_Integer", ",", " ", "dim_"}], "]"}], ":=", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"PadRight", "[", 
         RowBox[{"#", ",", " ", "dim", ",", " ", "0"}], "]"}], "&"}], "/@", 
       RowBox[{"getTerms", "[", "n", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"getChanges", "~", "SetAttributes", "~", "Listable"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"getChanges", "[", "n_Integer", "]"}], ":=", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"getChanges", "[", "n", "]"}], "=", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"-", "n"}], ",", " ", "n", ",", " ", "2"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"getTransfs", "[", "changes_", "]"}], ":=", 
      RowBox[{"(*", " ", 
       RowBox[{
       "we", " ", "keep", " ", "all", " ", "the", " ", "permutations", " ", 
        "in", " ", "memory", " ", "because", " ", "this", " ", "will", " ", 
        "allow", " ", "for", " ", "better", " ", "parallelization"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Developer`ToPackedArray", "@", 
       RowBox[{"Apply", "[", 
        RowBox[{"Join", ",", " ", 
         RowBox[{"Tuples", "/@", "changes"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"possibleTransfs", "[", "dim_", "]"}], ":=", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"getTransfs", "@", 
         RowBox[{"getChanges", "@", 
          RowBox[{"getTerms", "[", 
           RowBox[{"#", ",", "#"}], "]"}]}]}], "&"}], "@", "dim"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"reduceTransfs", "[", "transfs_", "]"}], ":=", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Sort", "@", 
           RowBox[{"DeleteCases", "[", 
            RowBox[{"#", ",", " ", "0"}], "]"}]}], "&"}], "/@", "transfs"}], "//",
         "DeleteDuplicates"}], "//", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{"{", "}"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"checkTerm", "[", 
       RowBox[{"a_", ",", " ", "b_", ",", " ", "dim_"}], "]"}], ":=", 
      "\[IndentingNewLine]", 
      RowBox[{"Block", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"d", "=", 
           RowBox[{"Min", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Length", "[", "a", "]"}], ",", " ", 
              RowBox[{"Length", "[", "b", "]"}]}], "}"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"mD", "=", 
           RowBox[{"Max", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Length", "[", "a", "]"}], ",", " ", 
              RowBox[{"Length", "[", "b", "]"}]}], "}"}], "]"}]}], ",", 
          "\[IndentingNewLine]", "shared", ",", "\[IndentingNewLine]", "sdim",
           ",", "\[IndentingNewLine]", "rest", ",", "\[IndentingNewLine]", 
          "rdim"}], "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
        
        RowBox[{
         RowBox[{"shared", "=", 
          RowBox[{
           RowBox[{"a", "[", 
            RowBox[{"[", 
             RowBox[{";;", "d"}], "]"}], "]"}], "+", 
           RowBox[{"b", "[", 
            RowBox[{"[", 
             RowBox[{";;", "d"}], "]"}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"rest", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "a", "]"}], ">", "d"}], ",", " ", 
            RowBox[{"a", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"d", "+", "1"}], ";;"}], "]"}], "]"}], ",", " ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "b", "]"}], ">", "d"}], ",", " ", 
              RowBox[{"b", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"d", "+", "1"}], ";;"}], "]"}], "]"}], ",", " ", 
              RowBox[{"{", "}"}]}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"sdim", "=", 
          RowBox[{"Total", "[", 
           RowBox[{"Abs", "@", "shared"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"rdim", "=", 
          RowBox[{"Total", "[", 
           RowBox[{"Abs", "@", "rest"}], "]"}]}], ";", "\[IndentingNewLine]", 
         
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"rdim", "+", "sdim"}], ">", "dim"}], " ", "||", " ", 
            RowBox[{
             RowBox[{"rdim", "+", "sdim"}], "\[Equal]", "0"}]}], ",", " ", 
           "\[IndentingNewLine]", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"dim", "+", "1"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"i", ",", " ", "mD"}], "}"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Join", "[", 
            RowBox[{"shared", ",", " ", "rest"}], "]"}]}], 
          "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"reducedProduct", "[", 
       RowBox[{"termsA_", ",", " ", "termsB_", ",", " ", "dim_"}], "]"}], ":=",
       "\[IndentingNewLine]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"mD", "=", 
          RowBox[{"Max", "@", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Length", "[", 
              RowBox[{"termsA", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", " ", 
             RowBox[{"Length", "[", 
              RowBox[{"termsB", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}]}]}], "}"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"Block", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"set", "=", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"dim", "+", "1"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", "mD"}], "}"}]}], "]"}], "\[Rule]", 
              "1"}], "|>"}]}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"set", "[", 
               RowBox[{"checkTerm", "[", 
                RowBox[{"a", ",", " ", "b", ",", " ", "dim"}], "]"}], "]"}], 
              "=", "1"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"a", ",", " ", "termsA"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"b", ",", " ", "termsB"}], "}"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Rest", "@", 
            RowBox[{"Keys", "[", "set", "]"}]}]}]}], 
         RowBox[{"(*", " ", 
          RowBox[{"drops", " ", "the", " ", "null", " ", "term"}], " ", 
          "*)"}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"terms", "=", 
      RowBox[{"possibleTransfs", "[", 
       RowBox[{"opDims", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Echo", "[", 
         RowBox[{
          RowBox[{"Total", "@", 
           RowBox[{"opDims", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"i", "+", "1"}], ";;"}], "]"}], "]"}]}], ",", " ", 
          "i"}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"terms", "=", "\[IndentingNewLine]", 
        RowBox[{"reducedProduct", "[", "\[IndentingNewLine]", 
         RowBox[{"terms", ",", "\[IndentingNewLine]", 
          RowBox[{"possibleTransfs", "[", 
           RowBox[{"opDims", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Total", "@", 
           RowBox[{"opDims", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"i", "+", "1"}], ";;"}], "]"}], "]"}]}]}], 
         "\[IndentingNewLine]", "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "2", ",", " ", 
         RowBox[{
          RowBox[{"Length", "[", "opDims", "]"}], "-", "1"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"finale", "=", 
      RowBox[{"getTransfs", "@", 
       RowBox[{"getChanges", "@", 
        RowBox[{"getTerms", "[", 
         RowBox[{"opDims", "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Intersection", "[", " ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "assuming", " ", "totally", " ", "symmetric", " ", "transformations", 
         " ", "this", " ", "works"}], "..."}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"reduceTransfs", "[", "terms", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"reduceTransfs", "@", "finale"}]}], "\[IndentingNewLine]", 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
