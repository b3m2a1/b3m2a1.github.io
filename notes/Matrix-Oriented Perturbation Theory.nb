  3.810514589728591*^9}},ExpressionUUID->"d38d3f8e-bd09-480d-a803-\
467cf09c21e9"],

Cell[TextData[{
 "The third derivatives require a bit of care, as we start with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", 
     SuperscriptBox["q", "2"]], 
    RowBox[{
     SubscriptBox["\[Del]", "X"], 
     SubscriptBox["\[Mu]", "\[Alpha]"]}]}], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "0392cfba-63bc-465a-9b82-8d890a64f5a7"],
 " and so we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.810514387324992*^9, 3.810514398804113*^9}, {
  3.8105146034655027`*^9, 3.8105146344621887`*^9}, {3.810514823357432*^9, 
  3.810514832644301*^9}},ExpressionUUID->"bff0e283-508b-4f73-9bb7-\
4b46a00eda4b"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["Q", "2"]], 
       RowBox[{
        SubscriptBox["\[Del]", "X"], 
        SubscriptBox["\[Mu]", "\[Alpha]"]}]}], "=", 
      RowBox[{
       SubscriptBox["\[Del]", "Q"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[Del]", "Q"], "q"}], 
         RowBox[{
          SubscriptBox["\[Del]", "q"], 
          RowBox[{
           SubscriptBox["\[Del]", "X"], 
           SubscriptBox["\[Mu]", "\[Alpha]"]}]}]}], ")"}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["Q", "2"]], "q"}], 
        RowBox[{
         SubscriptBox["\[Del]", "q"], 
         RowBox[{
          SubscriptBox["\[Del]", "X"], 
          SubscriptBox["\[Mu]", "\[Alpha]"]}]}]}], "+", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", "Q"], "q"}], 
        RowBox[{"\[LeftAngleBracket]", "2", "\[RightAngleBracket]"}], 
        RowBox[{
         SubscriptBox["\[Del]", "Q"], "q"}], 
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["q", "2"]], 
         RowBox[{
          SubscriptBox["\[Del]", "X"], 
          SubscriptBox["\[Mu]", "\[Alpha]"]}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.810514635796927*^9, 
  3.8105148455813513`*^9}},ExpressionUUID->"58dc06ab-c496-4103-b5aa-\
9f775c0688ff"],

