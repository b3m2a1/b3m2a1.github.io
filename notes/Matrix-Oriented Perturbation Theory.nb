Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "G"], 
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]], 
       SubscriptBox["\[CapitalPi]", 
        RowBox[{"V", "\[VeryThinSpace]"}]]}], "=", 
      RowBox[{
       SubscriptBox["P", "G"], 
       SubscriptBox["P", "D"], 
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]], 
       SubscriptBox["P", "D"], 
       SuperscriptBox[
        RowBox[{
