          SuperscriptBox[
           SubscriptBox["q", "1"], "3"], 
          SubscriptBox["q", "2"], 
          SubscriptBox["q", "3"], 
          SubscriptBox["q", "4"]}], ")"}], ")"}], "\[Union]"}]}]},
    {
     RowBox[{"\[AlignmentMarker]   ", 
      RowBox[{
