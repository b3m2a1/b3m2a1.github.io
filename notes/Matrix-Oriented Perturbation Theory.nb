            RowBox[{"(", 
             RowBox[{"i", "-", "b", "+", "1"}], ")"}], 
            RowBox[{
             SubsuperscriptBox["Q", "k", 
              RowBox[{"(", 
               RowBox[{"b", "-", "1"}], ")"}]], "(", "i", ")"}], 
            SuperscriptBox["n", "k"]}]}]}]}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["Q", "k", 
          RowBox[{"(", 
           RowBox[{"b", "-", "1"}], ")"}]], "(", "i", ")"}], 
        SuperscriptBox["n", 
         RowBox[{"k", "+", "1"}]]}]}]}]},
    {
