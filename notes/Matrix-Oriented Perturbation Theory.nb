41d87757c0ac"],

Cell[TextData[{
 "By the same diagonality/degeneracy at order 0 we can eliminate the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "D"], 
    SubsuperscriptBox["\[CapitalDelta]H", "n", 
     RowBox[{"(", "0", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "2", ")"}]]},
