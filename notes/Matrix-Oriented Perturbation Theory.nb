Cell[TextData[{
 "and then the question is simply how to evaluate the ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Zeta]", 
    RowBox[{"i", "\[VeryThinSpace]", "j"}], "\[Tau]"], TraditionalForm]],
  ExpressionUUID->"88d9000a-9232-4cff-812a-22bff3519563"],
 " terms. Those are defined as "
}], "ExpositoryText",
 CellChangeTimes->{{3.811078569112302*^9, 
  3.81107861563433*^9}},ExpressionUUID->"930131d1-4644-4f88-b355-\
f16192cedf6d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Zeta]", 
    RowBox[{"i", "\[VeryThinSpace]", "j"}], "z"], "=", 
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", "n"], 
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", 
        SubscriptBox["x", "n"]}], 
       RowBox[{"\[PartialD]", 
        SubscriptBox["Q", "i"]}]], 
      FractionBox[
       RowBox[{"\[PartialD]", 
        SubscriptBox["y", "n"]}], 
       RowBox[{"\[PartialD]", 
        SubscriptBox["Q", "j"]}]]}]}], "-", 
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SubscriptBox["x", "n"]}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["Q", "j"]}]], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SubscriptBox["y", "n"]}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["Q", "i"]}]]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811078720125298*^9, 
  3.811078743052318*^9}},ExpressionUUID->"791e6a96-666d-4ae4-9828-\
4d4dffbec89f"],

Cell["which can be rewritten as", "ExpositoryText",
 CellChangeTimes->{{3.811078744710064*^9, 
  3.811078749429448*^9}},ExpressionUUID->"6cd3dd3d-489c-4172-b350-\
0bb122b4f942"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Zeta]", 
    RowBox[{"i", "\[VeryThinSpace]", "j"}], "z"], "=", 
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", "n"], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{"\[PartialD]", 
          SubscriptBox["x", "n"]}], 
         RowBox[{"\[PartialD]", 
          SubscriptBox["Q", "i"]}]], "+", 
        FractionBox[
         RowBox[{"\[PartialD]", 
          SubscriptBox["y", "n"]}], 
         RowBox[{"\[PartialD]", 
          SubscriptBox["Q", "i"]}]]}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubscriptBox["x", "n"]}], 
          RowBox[{"\[PartialD]", 
           SubscriptBox["Q", "j"]}]]}], "+", 
        FractionBox[
         RowBox[{"\[PartialD]", 
          SubscriptBox["y", "n"]}], 
         RowBox[{"\[PartialD]", 
          SubscriptBox["Q", "j"]}]]}], ")"}]}]}], "-", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["y", "n"]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["Q", "i"]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["y", "n"]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["Q", "j"]}]]}], "-", 
      RowBox[{
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", "n"]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["Q", "i"]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", "n"]}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["Q", "j"]}]]}]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811078750677526*^9, 3.811078845274353*^9}, 
   3.81108036527967*^9, {3.811080424151595*^9, 
   3.811080439820805*^9}},ExpressionUUID->"3f125b7e-384c-40eb-b5db-\
455f59f6cab3"],

Cell[TextData[{
 "Why is this nice? Well it makes the operator form of this clearer. Letting ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", "\[Element]", 
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c"}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"fdfb1de4-5919-4c45-9ec2-cda6a35ba013"],
 " and defining two transpositions of the Jacobian like"
}], "ExpositoryText",
 CellChangeTimes->{{3.811079105778201*^9, 3.8110791225415907`*^9}, {
  3.811081056486291*^9, 3.811081096406063*^9}, {3.811081287267378*^9, 
  3.811081292445291*^9}, {3.811124552773497*^9, 
  3.8111245555215816`*^9}},ExpressionUUID->"f37a8a76-0644-47d6-9c82-\
3fd17a686ca1"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     FormBox[
      RowBox[{
       SubscriptBox["J", 
        RowBox[{"n", "\[VeryThinSpace]", "i", "\[VeryThinSpace]", "\[Tau]"}]],
        "=", 
       FractionBox[
        RowBox[{"\[PartialD]", 
         SubscriptBox["\[Tau]", "n"]}], 
        SubscriptBox[
         SubscriptBox["\[PartialD]", "Q"], "i"]]}],
      TraditionalForm]},
    {
     RowBox[{
      SubscriptBox[
       RowBox[{"J", "\[Transpose]"}], 
       RowBox[{
       "n", "\[VeryThinSpace]\[VeryThinSpace]", "\[Tau]", "\[VeryThinSpace]", 
        "i"}]], "=", 
      FractionBox[
       RowBox[{"\[PartialD]", 
        SubscriptBox["\[Tau]", "n"]}], 
       SubscriptBox[
        SubscriptBox["\[PartialD]", "Q"], "i"]]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811081069190844*^9, 3.811081069859076*^9}, {
  3.8110811004322968`*^9, 3.8110811103777857`*^9}, {3.8110812638988867`*^9, 
  3.81108127573508*^9}},ExpressionUUID->"5e6517a8-3cb3-4869-a46c-\
4f4d06259d35"],

Cell["we can write", "ExpositoryText",
 CellChangeTimes->{{3.811081123373712*^9, 
  3.8110811249966097`*^9}},ExpressionUUID->"d0be1ce7-036a-447a-819c-\
1fb143ec4ea9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Zeta]", 
    RowBox[{"i", "\[VeryThinSpace]", "j"}], "\[Tau]"], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", "n"], 
    RowBox[{
     SubscriptBox["J", 
      RowBox[{"n", "\[VeryThinSpace]", "i", "\[InvisibleSpace]"}]], 
     SuperscriptBox["\[CurlyEpsilon]", 
      RowBox[{"(", "\[Alpha]\[Beta]", ")"}]], 
     SubscriptBox[
      RowBox[{"J", "\[Transpose]"}], 
      RowBox[{
      "j", "\[VeryThinSpace]", "n", 
       "\[VeryThinSpace]\[VeryThinSpace]"}]]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811080471114698*^9, 3.81108047667769*^9}, 
   3.811080543381793*^9, {3.8110805777276287`*^9, 3.811080622836236*^9}, {
   3.811080704723144*^9, 3.811080759849679*^9}, {3.811080964134513*^9, 
   3.81108100247683*^9}},ExpressionUUID->"1a85afa6-f4fa-47bb-a5e1-\
1dc1d3cc8c4c"],

Cell[TextData[{
 "and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CurlyEpsilon]", 
    RowBox[{"(", "\[Alpha]\[Beta]", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.811080471114698*^9, 3.81108047667769*^9}, 
    3.811080543381793*^9, {3.8110805777276287`*^9, 3.811080622836236*^9}, {
    3.811080704723144*^9, 3.811080759849679*^9}},ExpressionUUID->
  "3f9bd8ae-a054-46ce-9dee-d66c517af618"],
 " is the 2D Levi-Civita tensor (antisymmetric tensor) defined for \[Alpha], \
\[Beta]\[Element]{a, b, c}\\{\[Tau]}. And so then we can build the entirety \
of ",
 Cell[BoxData[
  FormBox["\[Zeta]", TraditionalForm]],ExpressionUUID->
  "57a431e2-734e-4335-9580-0b12efbdcfbb"],
 " in one go by"
}], "ExpositoryText",
 CellChangeTimes->{{3.8110807625379257`*^9, 3.8110808255894537`*^9}, {
   3.8110808649314938`*^9, 3.811080912278822*^9}, {3.8110810373708067`*^9, 
   3.811081038457415*^9}, 3.811081133261219*^9, {3.8110812079194736`*^9, 
   3.811081211271821*^9}, {3.8110876822042847`*^9, 3.811087682487303*^9}, {
   3.8111245590729923`*^9, 
   3.8111245629274387`*^9}},ExpressionUUID->"20168316-45fa-4c48-bf3f-\
744e4baded5b"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Zeta]", "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", "n"], 
    RowBox[{
     SubscriptBox["J", 
      RowBox[{"\[InvisibleSpace]", "n"}]], "\[CurlyEpsilon]", 
     "\[VeryThinSpace]", 
     SubscriptBox[
      RowBox[{"J", "\[Transpose]"}], "n"]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811080916693625*^9, 3.8110809309671307`*^9}, {
  3.811081213064033*^9, 
  3.8110812526459427`*^9}},ExpressionUUID->"abac91e9-dd3f-4129-952c-\
c391e7967240"],

Cell["where \[CurlyEpsilon] is now the proper 3D Levi-Civita tensor.", \
"ExpositoryText",
 CellChangeTimes->{{3.8110813131517677`*^9, 3.811081357200843*^9}, 
   3.811087684568968*^9},ExpressionUUID->"94264400-d426-4466-a215-\
981d06acf6b3"],

Cell[TextData[{
 "Unit-wise, things are kinda annoying. We note that we expect ",
 StyleBox["J ",
  FontSlant->"Italic"],
 "to be the matrix of derivatives of the mass-weighted Cartesian coordinates \
with respect to the dimensionless normal modes. If this is the case, we know \
that "
}], "ExpositoryText",
 CellChangeTimes->{{3.8111125379720697`*^9, 3.8111125529922647`*^9}, {
  3.811112629203546*^9, 3.811112656213829*^9}, {3.8111127358142567`*^9, 
  3.811112748873539*^9}},ExpressionUUID->"2fe6d81e-59e8-4fc0-91b1-\
da6a5ff3ce20"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     SuperscriptBox["J", 
      RowBox[{"-", "1"}]], "T"], 
    SuperscriptBox["J", 
     RowBox[{"-", "1"}]]}], "=", "G"}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811112749948428*^9, 3.811112778612771*^9}, {
  3.811112838963602*^9, 3.811112839441174*^9}, {3.811112976080228*^9, 
  3.811113014891347*^9}},ExpressionUUID->"1d6ec23f-e6f7-44ba-b791-\
b7b18238c23e"],

Cell[TextData[{
 "and so all of these products should have units of energy. If everything is \
internally consistent and in atomic units, specifically this energy unit is \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "h"], TraditionalForm]],ExpressionUUID->
  "153fb5e9-f99b-4a05-acf2-8d0ba7873896"],
 ". That means we expect \[Zeta] to have units of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SubscriptBox["E", "h"]}], TraditionalForm]],ExpressionUUID->
  "8c40d8bd-a84b-42e6-b731-40e28a2de2d4"],
 "...but that doesn\[CloseCurlyQuote]t work with the expression"
}], "ExpositoryText",
 CellChangeTimes->{{3.81111284111928*^9, 3.811112888193084*^9}, {
  3.811113025703492*^9, 3.811113055478786*^9}, {3.811113703592463*^9, 
  3.811113714087739*^9}},ExpressionUUID->"3d5cc999-b6ba-4dda-8c25-\
3758c54fc923"],

Cell[BoxData[
 FormBox[
  RowBox[{
   UnderscriptBox["\[Sum]", "\[Tau]"], 
   RowBox[{
    SubsuperscriptBox["B", "e", "\[Tau]"], 
    SubsuperscriptBox["\[Zeta]", 
     RowBox[{"i", "\[VeryThinSpace]", "j"}], "\[Tau]"], 
    RowBox[{
     SubsuperscriptBox["\[Zeta]", 
      RowBox[{"k", "\[VeryThinSpace]", "l"}], "\[Tau]"], "(", 
     FractionBox[
      RowBox[{
       SubscriptBox["\[Omega]", "j"], 
       SubscriptBox["\[Omega]", "l"]}], 
      RowBox[{
       SubscriptBox["\[Omega]", "i"], 
       SubscriptBox["\[Omega]", "k"]}]], ")"}], 
    SubscriptBox["p", "i"], 
    SubscriptBox["q", "j"], 
    SubscriptBox["p", "l"], 
    SubscriptBox["q", "k"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811113720986601*^9, 
  3.811113786552026*^9}},ExpressionUUID->"f0b64a3d-6de7-407f-a6eb-\
fe16df8b426d"],

Cell[TextData[{
 "which is supposed to be the Coriolis correction in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "2", ")"}]], TraditionalForm]],ExpressionUUID->
  "8463f0d1-ef7d-464f-aa40-c828ae485384"],
 "...because ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["B", "e", "\[Tau]"], TraditionalForm]],
  CellChangeTimes->{{3.811113720986601*^9, 3.811113786552026*^9}},
  ExpressionUUID->"60e72007-73d6-43b1-87d7-9b72cec94b46"],
 " should ",
 StyleBox["also",
  FontSlant->"Italic"],
 " have units of energy and this would end up giving something with units of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SubscriptBox["E", "h"]}], TraditionalForm]],ExpressionUUID->
  "95cb2a8a-bb0d-49dd-be7b-77fc05f42a59"],
 "."
}], "ExpositoryText",
 CellChangeTimes->{{3.811113794286409*^9, 
  3.811113876845235*^9}},ExpressionUUID->"7f816214-8ae3-4bea-a1da-\
3e82801f8667"],

Cell[CellGroupData[{

Cell["Coriolis Derivatives", "Subsection",
 CellChangeTimes->{{3.92714507229745*^9, 
  3.9271450756380873`*^9}},ExpressionUUID->"a1fe30eb-2943-4449-8b93-\
43ae9b84c996"],

Cell["We start with", "ExpositoryText",
 CellChangeTimes->{{3.927145077800095*^9, 
  3.9271450792357807`*^9}},ExpressionUUID->"89b82ac4-ea6f-4274-9464-\
e86dc4cb50ab"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Zeta]", 
    RowBox[{"r", "\[InvisibleSpace]", "s"}], "\[Alpha]"], " ", "=", " ", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"\[VeryThinSpace]", "\[Beta]"}]], " ", 
     RowBox[{
      UnderscriptBox["\[Sum]", "k"], " ", 
      SubscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[Del]", "Q"], "Y"}], "\[CircleTimes]", 
         RowBox[{
          SubscriptBox["\[Del]", "Q"], "Y"}]}], ")"}], 
       RowBox[{
        RowBox[{"r", "(", 
         RowBox[{"k", ",", "\[Beta]"}], ")"}], ",", 
        RowBox[{"s", "(", 
         RowBox[{"k", ",", "\[Gamma]"}], ")"}]}]]}]}], " ", "-", " ", 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "Q"], "Y"}], "\[CircleTimes]", 
       RowBox[{
        SubscriptBox["\[Del]", "Q"], "Y"}]}], ")"}], 
     RowBox[{
      RowBox[{"r", "(", 
       RowBox[{"k", ",", "\[Gamma]"}], ")"}], ",", 
      RowBox[{"s", "(", 
       RowBox[{"k", ",", "\[Beta]"}], ")"}]}]]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.906881789176012*^9, 3.906881823010481*^9}, {
   3.906882368170149*^9, 3.906882380708997*^9}, {3.906883194159746*^9, 
   3.9068832555947237`*^9}, 3.906883295875146*^9, {3.90688342819773*^9, 
   3.906883439645666*^9}, 3.906883494316102*^9, {3.906883527996385*^9, 
   3.906883609023731*^9}, {3.906883657770183*^9, 3.9068836708872547`*^9}, {
   3.906883751927638*^9, 3.9068837549275227`*^9}, {3.906883841853363*^9, 
   3.9068839053595333`*^9}, {3.9271453738023443`*^9, 
   3.927145442105682*^9}},ExpressionUUID->"f21474f3-cdb2-4623-bad0-\
d8f05df73c81"],

Cell[TextData[{
 "for the cyclic permutations ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[VeryThinSpace]", 
    RowBox[{
     RowBox[{"\[Beta]", " ", "=", " ", 
      RowBox[{"\[Alpha]", "+", 
       RowBox[{"1", " ", "mod", " ", "3"}]}]}], ",", " ", 
     RowBox[{"\[Gamma]", " ", "=", " ", 
      RowBox[{"\[Alpha]", "+", 
       RowBox[{"2", " ", "mod", " ", "3"}]}]}]}]}], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "d856f406-18e4-4d34-a1a7-54a09170d7c0"]
}], "ExpositoryText",
 CellChangeTimes->{{3.927145449866941*^9, 
  3.927145457623666*^9}},ExpressionUUID->"0af75b0f-af4f-4215-a652-\
6a7ebee17e35"],

Cell[TextData[{
 "So when we differentiate, we\[CloseCurlyQuote]re really just expanding out ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "Q"], "Y"}], "\[CircleTimes]", 
    RowBox[{
     SubscriptBox["\[Del]", "Q"], "Y"}]}], TraditionalForm]],ExpressionUUID->
  "e10bc294-a7e1-4679-aed2-54c5ffc0a2db"]
}], "ExpositoryText",
 CellChangeTimes->{{3.927145470149061*^9, 
  3.927145501654333*^9}},ExpressionUUID->"16f2b56c-76f8-451c-bbbb-\
792704b316a8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Rexpanding", "Subsection",
 CellChangeTimes->{{3.947930428967185*^9, 
  3.9479304328161907`*^9}},ExpressionUUID->"6ba95517-d487-4b29-9d06-\
2af55cf5018f"],

Cell["We start with ", "ExpositoryText",
 CellChangeTimes->{{3.947930434560521*^9, 
  3.947930437361813*^9}},ExpressionUUID->"3776ba59-a61e-43c8-8d84-\
ceb385d7af8f"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{"Z", " ", "=", " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "\[Tau]"], 
       RowBox[{
        SubsuperscriptBox["B", "e", "\[Tau]"], 
        SubsuperscriptBox["\[Zeta]", 
         RowBox[{"i", "\[VeryThinSpace]", "j"}], "\[Tau]"], 
        SubsuperscriptBox["\[Zeta]", 
         RowBox[{"k", "\[VeryThinSpace]", "l"}], "\[Tau]"]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       SubscriptBox["B", "e"], 
       RowBox[{"\[LeftAngleBracket]", "\[RightAngleBracket]"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Zeta]", "[", 
           RowBox[{"2", ",", " ", "3"}], "]"}], "\[CircleTimes]", 
          RowBox[{"[", 
           RowBox[{"2", ",", " ", "3"}], "]"}]}], "\[Zeta]"}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.94793044909264*^9, 
  3.947930535548435*^9}},ExpressionUUID->"5ed402b9-02ca-4a45-9b8d-\
9a61826325bd"],

Cell[TextData[{
 "and then if we have some transformation mapping ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", " ", "\[Rule]", " ", "R"}], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "7dd123c0-9904-4433-a995-ea625a2c1f6a"],
 ", we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.947930611162972*^9, 
  3.947930632443136*^9}},ExpressionUUID->"6d624ef3-3565-45ca-8c1b-\
4acc031d12bf"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    SuperscriptBox["\[Zeta]", "\[Alpha]"], 
    RowBox[{"(", "R", ")"}]], " ", "=", " ", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", "R"], 
     RowBox[{"Q", "(", 
      SuperscriptBox[
       SuperscriptBox["\[Zeta]", "\[Alpha]"], 
       RowBox[{"(", "Q", ")"}]], ")"}]}], 
    RowBox[{
     SubscriptBox["\[Del]", "R"], 
     SuperscriptBox["Q", "T"]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.947930636486787*^9, 
  3.94793077138417*^9}},ExpressionUUID->"5870f71a-7dc0-45c2-b7b5-\
d508b6f0e129"],

Cell["i.e. it expands just like any second order term", "ExpositoryText",
 CellChangeTimes->{{3.947930774262916*^9, 
  3.947930799815054*^9}},ExpressionUUID->"06fb4174-a5e6-4912-9cfa-\
47cea660386d"],

Cell[TextData[{
 "The same applies to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "e"], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "42a21fbc-2f17-4c4f-a49c-cc83c11b5113"]
}], "ExpositoryText",
 CellChangeTimes->{{3.947930801967574*^9, 
  3.94793080739121*^9}},ExpressionUUID->"1a984960-09c1-4169-9431-\
d65f2e4ae0e9"],

Cell[TextData[{
 "Unfortunately, in the absence of a Cartesian embedding........we actually \
can\[CloseCurlyQuote]t do this. Because expanding ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "e"], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"d111ab27-c349-4dc4-9e7b-4c458c3bda09"],
 " is entirely dependent on having the expansion in "
}], "ExpositoryText",
 CellChangeTimes->{{3.94793105252332*^9, 
  3.947931126807166*^9}},ExpressionUUID->"cb51fbe4-e78f-4f1f-8144-\
45bc929e3358"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Potential-Like Terms", "Section",
 CellChangeTimes->{{3.81126114995993*^9, 3.811261153091988*^9}, {
  3.811591305521576*^9, 
  3.811591309433696*^9}},ExpressionUUID->"a82570cf-04cf-4278-aa1d-\
0b0a20b38ee8"],

Cell["\<\
Come out of the how the inertia tensor transforms in internal coordinates. \
Add a brief overview.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.811591314990555*^9, 
  3.81159135778197*^9}},ExpressionUUID->"c03ec4ed-debc-4114-9b96-\
84ec27280fa9"],

Cell[CellGroupData[{

Cell["The Watson Term", "Subsection",
 CellChangeTimes->{{3.811591345120626*^9, 
  3.8115913478646183`*^9}},ExpressionUUID->"ceb9b0dc-9c8b-44d1-aa82-\
3ac930b3d339"],

Cell["\<\
Add some notes about how you need the U term to get a ZPE that agrees with \
Gaussian in Cartesian  displacements (linearized internals). \
\>", "ExpositoryText",
 CellChangeTimes->{{3.811261154785386*^9, 3.8112611712082243`*^9}, {
  3.811263178144109*^9, 
  3.811263232674268*^9}},ExpressionUUID->"9b0670c6-f636-4d65-a8ba-\
3fa59c6bad72"]
