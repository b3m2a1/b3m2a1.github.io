Cell[TextData[{
 "We\[CloseCurlyQuote]ve shown how to reduce terms in ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["A", "n", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]],ExpressionUUID->
  "b240ed65-3883-4f0d-8961-68b3bb548564"],
