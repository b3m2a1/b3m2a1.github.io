Cell[CellGroupData[{

Cell["Operator Representations", "Subsection",
 CellChangeTimes->{{3.8109471358105793`*^9, 
  3.8109471674916267`*^9}},ExpressionUUID->"c98988bc-e0cc-4d4d-b82e-\
bd285414e8ef"],

Cell[TextData[{
 "Often we have an operator ",
 StyleBox["A",
  FontSlant->"Italic"],
 " and need to get something like "
}], "ExpositoryText",
 CellChangeTimes->{{3.810947168749248*^9, 
  3.8109472174375668`*^9}},ExpressionUUID->"95f1467c-3bb5-4a14-a7f4-\
70ed697e9f7b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{"n"},
     "Bra"], "A", 
    TemplateBox[{"m"},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Sum]", "k"], 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Bra"], 
       SuperscriptBox["\[Lambda]", "k"]}]}], ")"}], 
    RowBox[{"A", "(", 
     RowBox[{
      SubscriptBox["\[Sum]", "k"], 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "l", ")"}]]},
        "Ket"], 
       SuperscriptBox["\[Lambda]", "k"]}]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.810947180617646*^9, 3.810947197250568*^9}, {
  3.810947373143491*^9, 3.8109474064255753`*^9}, {3.8109475444162416`*^9, 
  3.810947545852582*^9}},ExpressionUUID->"6ef0707a-1853-4305-a238-\
b24ee990330c"],

Cell[TextData[{
 "naively, we might think that we can just evaluate this out directly. \
Unfortunately, because of the truncation done in the perturbation expansion, \
this would introduce errors. Instead, we need to first expand ",
 StyleBox["A ",
  FontSlant->"Italic"],
 "itself out as a series of perturbations"
}], "ExpositoryText",
 CellChangeTimes->{{3.810947258595654*^9, 3.810947260839233*^9}, {
  3.8109473240562057`*^9, 3.810947352654707*^9}, {3.8109474082180843`*^9, 
  3.810947475952235*^9}},ExpressionUUID->"b51b380f-b1aa-4cdc-bd90-\
203469d72e5f"],

Cell[BoxData[
 FormBox[
  RowBox[{"A", "=", 
   RowBox[{
    SubscriptBox["\[Sum]", "k"], 
    RowBox[{
     SuperscriptBox["A", 
      RowBox[{"(", "k", ")"}]], 
     SuperscriptBox["\[Lambda]", "k"]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8109473535399427`*^9, 3.8109473542024307`*^9}, {
  3.810947478031784*^9, 3.81094748327216*^9}, {3.8109475368016167`*^9, 
  3.8109475421292667`*^9}},ExpressionUUID->"1e982432-63de-4838-be7e-\
d849d2cff237"],

Cell[TextData[{
 "and then we can compute the perturbative correction to the expectation \
value by matching up terms with the same total value of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Lambda]", "k"], TraditionalForm]],ExpressionUUID->
  "dc4b702f-5761-4e24-99e8-e12c4140142b"],
 ". Since we\[CloseCurlyQuote]re going to be adding up terms that look like"
}], "ExpositoryText",
 CellChangeTimes->{{3.810947486091051*^9, 3.810947585826165*^9}, {
  3.810947950856928*^9, 3.810947962151072*^9}, {3.810948010317154*^9, 
  3.810948010317225*^9}},ExpressionUUID->"a12ea31a-3a39-4df9-a0d2-\
a71bdc2b945c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "\[Alpha]", ")"}]]},
    "Bra"], 
   SuperscriptBox["A", 
    RowBox[{"(", "\[Gamma]", ")"}]], 
   TemplateBox[{
     SuperscriptBox["m", 
      RowBox[{"(", "\[Beta]", ")"}]]},
    "Ket"]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.810947967549038*^9, 
  3.810947983635026*^9}},ExpressionUUID->"5cfad03a-db29-43f4-b974-\
17d7b6418fca"],

Cell["\<\
we unfortunately have three indices to sum over, i.e. we\[CloseCurlyQuote]re \
looking for non-negative, integral solutions to\
\>", "ExpositoryText",
 CellChangeTimes->{{3.810947986658945*^9, 3.8109480232597847`*^9}, {
  3.8109480545052547`*^9, 
  3.810948068563322*^9}},ExpressionUUID->"6e707b71-f73b-47f1-aac1-\
9c728ed82d04"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Alpha]", "+", "\[Beta]", "+", "\[Gamma]"}], "=", "k"}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.810948013451318*^9, 
  3.810948028935454*^9}},ExpressionUUID->"ba0d6deb-cf5a-4b91-b68c-\
80a0a585ca27"],

Cell["which we\[CloseCurlyQuote]ll want to do in two steps:", "ExpositoryText",
 CellChangeTimes->{{3.810948031463786*^9, 3.810948032196104*^9}, {
  3.81094807050702*^9, 
  3.8109481098312273`*^9}},ExpressionUUID->"9185c73b-f936-441a-831c-\
eda644806274"],

Cell["Fix a value for \[Alpha]\[Element]{0...k}", "MathItem",
 CellChangeTimes->{{3.810948111458622*^9, 
  3.8109481482911873`*^9}},ExpressionUUID->"e090ab14-2f7e-44dd-a2e5-\
57157bb49056"],

Cell[TextData[{
 "Sum over the solutions to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Beta]", "+", "\[Gamma]"}], "=", 
    RowBox[{"k", "-", "\[Alpha]"}]}], TraditionalForm]],ExpressionUUID->
  "cdfe15d1-5cee-4f80-9690-eab387868adf"]
}], "MathItem",
 CellChangeTimes->{{3.810948111458622*^9, 
  3.810948212692569*^9}},ExpressionUUID->"2336e52d-a5e7-49f5-8dfb-\
d9b2714fa026"],

Cell["or written out explicitly", "ExpositoryText",
 CellChangeTimes->{{3.810948186310256*^9, 
  3.8109482070710382`*^9}},ExpressionUUID->"67f4a6cd-e92b-421c-902e-\
cc5abb85618e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{"n"},
     "Bra"], "A", 
    SuperscriptBox[
     TemplateBox[{"m"},
      "Ket"], 
     RowBox[{"(", "k", ")"}]]}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"\[Alpha]", "=", "0"}], "k"], " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"\[Beta]", "=", "0"}], 
      RowBox[{"k", "-", "\[Alpha]"}]], " ", 
     RowBox[{
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "\[Alpha]", ")"}]]},
       "Bra"], 
      SuperscriptBox["A", 
       RowBox[{"(", 
        RowBox[{"k", "-", "\[Alpha]", "-", "\[Beta]"}], ")"}]], 
      TemplateBox[{
        SuperscriptBox["m", 
         RowBox[{"(", "\[Beta]", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8109481965316067`*^9, 
  3.810948271850223*^9}},ExpressionUUID->"df7614cf-74a6-4791-8005-\
0f81245b13be"],

Cell[TextData[{
 "which if done out explicitly for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "=", "2"}], TraditionalForm]],ExpressionUUID->
  "baa1357c-f9da-4cb7-b9e8-8c6266b4d07f"],
 " gives us"
}], "ExpositoryText",
 CellChangeTimes->{{3.8109482767693453`*^9, 3.8109482878118343`*^9}, {
  3.8109483243321667`*^9, 3.8109483243322353`*^9}, {3.8109484205245028`*^9, 
  3.810948423721764*^9}},ExpressionUUID->"a47a1b73-bdab-4afe-b93a-\
443728cfb0c8"],

Cell[BoxData[{
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{"n"},
     "Bra"], "A", 
    SuperscriptBox[
     TemplateBox[{"m"},
      "Ket"], 
     RowBox[{"(", "2", ")"}]]}], "=", " ", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     SuperscriptBox["A", 
      RowBox[{"(", "2", ")"}]], 
     TemplateBox[{
       SuperscriptBox["m", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     SuperscriptBox["A", 
      RowBox[{"(", "1", ")"}]], 
     TemplateBox[{
       SuperscriptBox["m", 
        RowBox[{"(", "1", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     SuperscriptBox["A", 
      RowBox[{"(", "0", ")"}]], 
     TemplateBox[{
       SuperscriptBox["m", 
        RowBox[{"(", "2", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "1", ")"}]]},
      "Bra"], 
     SuperscriptBox["A", 
      RowBox[{"(", "1", ")"}]], 
     TemplateBox[{
       SuperscriptBox["m", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}]}]}], TraditionalForm], "\[LineSeparator]", 
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"+", 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "1", ")"}]]},
      "Bra"]}], 
    SuperscriptBox["A", 
     RowBox[{"(", "0", ")"}]], 
    TemplateBox[{
      SuperscriptBox["m", 
       RowBox[{"(", "1", ")"}]]},
     "Ket"]}], "+", 
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "2", ")"}]]},
     "Bra"], 
    SuperscriptBox["A", 
     RowBox[{"(", "0", ")"}]], 
    TemplateBox[{
      SuperscriptBox["m", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}]}], TraditionalForm]}], "ExpositoryMathCentered",
 CellChangeTimes->{{3.81094829104031*^9, 
  3.810948451415682*^9}},ExpressionUUID->"80bdcef3-1b7a-4249-b8e3-\
78ef0d5171e5"],

Cell[CellGroupData[{

Cell["Selection Rules", "Subsubsection",
 CellChangeTimes->{{3.814751786173966*^9, 
  3.814751788481908*^9}},ExpressionUUID->"be0dc7a7-95b8-40f0-bb9e-\
7c9572a7e36d"],

Cell["\<\
It\[CloseCurlyQuote]s worth considering how this play with selection rules, \
to improve efficiency. First off, we will note that when we have\
\>", "ExpositoryText",
 CellChangeTimes->{{3.814751791677474*^9, 
  3.814751835401596*^9}},ExpressionUUID->"d5fca7f6-dd73-43a6-99ae-\
5cff732e7965"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "\[Alpha]", ")"}]]},
    "Bra"], 
   SuperscriptBox["A", 
    RowBox[{"(", 
     RowBox[{"k", "-", "\[Alpha]", "-", "\[Beta]"}], ")"}]], 
   TemplateBox[{
     SuperscriptBox["m", 
      RowBox[{"(", "\[Beta]", ")"}]]},
    "Ket"]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.814751836523962*^9, 
  3.814751837134448*^9}},ExpressionUUID->"14c2a430-1d7d-42f4-8d01-\
91a2b118269c"],

Cell[TextData[{
 "in general ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "\[Alpha]", ")"}]]},
    "Bra"], TraditionalForm]],
  CellChangeTimes->{{3.814751836523962*^9, 3.814751837134448*^9}},
  ExpressionUUID->"cbca5375-d67e-4aaf-8e48-2d8727964805"],
 " will be an expansion over a select set of initial states and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["m", 
      RowBox[{"(", "\[Beta]", ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.814751836523962*^9, 3.814751837134448*^9}},
  ExpressionUUID->"f45936a9-d9e4-4870-9976-14e3c5409389"],
 " will be an expansion over a different one. We\[CloseCurlyQuote]ll write \
this as "
}], "ExpositoryText",
 CellChangeTimes->{{3.8147518450297623`*^9, 3.814751873230103*^9}, {
  3.814751945574294*^9, 3.8147519482384357`*^9}, {3.8147519860431557`*^9, 
  3.814751986902875*^9}},ExpressionUUID->"696f1dba-4613-4815-bcd8-\
158f3b1d172e"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "\[Alpha]", ")"}]]},
       "Bra"], " ", "=", " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "k"], " ", 
       RowBox[{
        SubsuperscriptBox["c", "k", 
         RowBox[{"(", "n", ")"}]], 
        TemplateBox[{
          SubsuperscriptBox["\[Phi]", "k", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"]}]}]}]},
    {
     RowBox[{
      TemplateBox[{
        SuperscriptBox["m", 
         RowBox[{"(", "\[Beta]", ")"}]]},
       "Ket"], " ", "=", " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "j"], " ", 
       RowBox[{
        SubsuperscriptBox["c", "j", 
         RowBox[{"(", "m", ")"}]], 
        TemplateBox[{
          SuperscriptBox[
           SubscriptBox["\[Phi]", "j"], 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.814751952030486*^9, 3.814752054409567*^9}, {
  3.814752366477911*^9, 
  3.814752373072791*^9}},ExpressionUUID->"46fcc425-14a2-4b8a-b7a4-\
db53e7b069a7"],

Cell[TextData[{
 "Now if ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", 
    RowBox[{"(", 
     RowBox[{"k", "-", "\[Alpha]", "-", "\[Beta]"}], ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.814751836523962*^9, 3.814751837134448*^9}},
  ExpressionUUID->"42988931-3b5b-474e-87b9-8488f6c41ca2"],
 " has an associated set of selection rules, {\[CapitalDelta]}, then we can \
generate the set of transformed states"
}], "ExpositoryText",
 CellChangeTimes->{{3.8147518798857393`*^9, 3.814751943974495*^9}, {
  3.81475205877358*^9, 3.814752092818013*^9}, {3.814752209767994*^9, 
  3.814752221324987*^9}},ExpressionUUID->"03556908-f24d-45a4-a498-\
6605127aeaa2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"{", "\[CapitalDelta]", "}"}], "\[CircleTimes]", 
   RowBox[{"{", 
    TemplateBox[{
      SuperscriptBox[
       SubscriptBox["\[Phi]", "j"], 
       RowBox[{"(", "0", ")"}]]},
     "Ket"], "}"}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8147522298484583`*^9, 3.814752234384861*^9}, {
  3.814752265896698*^9, 3.8147522713310833`*^9}, {3.8147523792510557`*^9, 
  3.814752379523231*^9}},ExpressionUUID->"895d6cd7-99d0-452b-87ed-\
a23f52724743"],

Cell[TextData[{
 "and take the intersection of this set with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    TemplateBox[{
      SubsuperscriptBox["\[Phi]", "k", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], "}"}], TraditionalForm]],ExpressionUUID->
  "15a0c92f-b192-4139-b63c-66f72018485d"],
 " to determine what our active space is."
}], "ExpositoryText",
 CellChangeTimes->{{3.814752241020829*^9, 3.814752274150453*^9}, {
  3.8147523067411222`*^9, 3.814752307499043*^9}, {3.814752376774822*^9, 
  3.814752413632481*^9}},ExpressionUUID->"4ccd8528-b435-4c34-890a-\
e3d12871d7cc"],

Cell[TextData[{
 "Alternately, as long as our operator is Hermitian, we can apply {\
\[CapitalDelta]} to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    TemplateBox[{
      SubsuperscriptBox["\[Phi]", "k", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], "}"}], TraditionalForm]],ExpressionUUID->
  "0b2c7d83-a68a-4f01-8653-fc0a5f19c08d"]
}], "ExpositoryText",
 CellChangeTimes->{{3.814752416165264*^9, 
  3.814752464620276*^9}},ExpressionUUID->"827168b0-3761-45f1-b046-\
de97c064b972"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Degeneracies Derivation", "Subsection",
 CellChangeTimes->{{3.8109942825269814`*^9, 3.810994284443563*^9}, {
  3.821409628011078*^9, 
  3.821409630080318*^9}},ExpressionUUID->"e826433c-c487-46a2-9dae-\
2540e703a65e"],

Cell[TextData[{
 "We\[CloseCurlyQuote]d like a more-elegant way to manage the degeneracies. \
To that effect, we\[CloseCurlyQuote]ll modify our existing perturbation \
operator. We start with a state of interest, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"n"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "0100c7c3-d72a-4a6b-b9de-ec7eeeb46fb2"],
 ", and identifying a space of degenerate states which can couple to it, ",
 Cell[BoxData[
  FormBox["D", TraditionalForm]],ExpressionUUID->
  "7d0ad3ac-93a0-44c5-8c50-b4fc9038544a"],
 " (and crucially including ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"n"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "d398f517-32e5-4a97-82a1-74b852524e01"],
 " itself in this subspace) we can write our projection operator as"
}], "ExpositoryText",
 CellChangeTimes->{{3.8211095626324053`*^9, 3.821109740717311*^9}, {
  3.8211098023056593`*^9, 3.8211098038632936`*^9}, {3.821110824087181*^9, 
  3.821110895217985*^9}},ExpressionUUID->"a4edfee5-0aff-4fc1-9a7f-\
0e81f0a46a68"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["R", "n"], "=", 
   RowBox[{"(", 
    RowBox[{"I", "-", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{"d", "\[Element]", "D"}]], 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["d", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"], 
       TemplateBox[{
         SuperscriptBox["d", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"]}]}]}], ")"}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8211097418999968`*^9, 3.821109782621215*^9}, {
  3.8211108159349823`*^9, 3.821110821014057*^9}, {3.821110871286153*^9, 
  3.821110875322969*^9}},ExpressionUUID->"815c4234-4d0b-42f7-a860-\
6eb1863ff593"],

Cell[TextData[{
 "and so we are able to project onto the non-degenerate subspace for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"n"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "605bf206-b32a-4fb7-a302-de15b9304916"],
 "."
}], "ExpositoryText",
 CellChangeTimes->{{3.821109784465845*^9, 3.821109848459746*^9}, {
  3.821110906940173*^9, 
  3.8211109092703123`*^9}},ExpressionUUID->"5e57b639-eabd-4c35-9cd0-\
ca7a356a4640"],

Cell["\<\
We can then apply non-degenerate perturbation theory as usual.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.821109850671863*^9, 
  3.821109863251615*^9}},ExpressionUUID->"081b3a5a-1baf-4b66-8285-\
942a5ca37593"],

Cell[TextData[{
 "Then when looking at the corrections to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"n"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "066035cd-d5bb-43b2-bb28-0489d37c6cab"],
 " we have "
}], "ExpositoryText",
 CellChangeTimes->{{3.821109933311757*^9, 3.82110995625812*^9}, {
   3.821110373589905*^9, 3.8211103917506857`*^9}, {3.821110639656164*^9, 
   3.821110642758296*^9}, {3.821110708581739*^9, 3.821110731720727*^9}, 
   3.821110797012051*^9},ExpressionUUID->"f13927b9-5329-4466-88f8-\
26e5965786d1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "k", ")"}]]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], 
      RowBox[{"k", "-", "1"}]], " ", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[CapitalPi]", "n"], "(", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["E", "n"], 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], "-", 
        SuperscriptBox["H", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]]}], ")"}], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}], "+", 
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"], 
     TemplateBox[{
       RowBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]], " "}], 
       RowBox[{"\[VeryThinSpace] ", 
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]}]},
      "BraKet"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821110732632661*^9, 
  3.8211107408047323`*^9}},ExpressionUUID->"6edf32c1-c846-472b-8dfc-\
cae80dd182ca"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPi]", "n"], TraditionalForm]],
  CellChangeTimes->{{3.821110732632661*^9, 3.8211107408047323`*^9}},
  ExpressionUUID->"44f889d3-c50b-4272-b905-5b6deeb2cc7e"],
 " will now remove any contribution from ",
 Cell[BoxData[
  FormBox["D", TraditionalForm]],ExpressionUUID->
  "284aa2b7-d8f8-4df8-9423-2a7de794e423"],
 ", meaning that at all levels of correction ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "k", ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.821110732632661*^9, 3.8211107408047323`*^9}},
  ExpressionUUID->"b774a772-1182-46db-806c-cf21b1f7ce4b"],
 " has no contribution from ",
 Cell[BoxData[
  FormBox["D", TraditionalForm]],ExpressionUUID->
  "2cb7d0bd-91fb-428e-ac4a-d096d230a95e"],
 ". We would now like to recover these contributions. That means we\
\[CloseCurlyQuote]d like to be able to write"
}], "ExpositoryText",
 CellChangeTimes->{{3.821110803230462*^9, 3.821110813540141*^9}, {
  3.821110914409685*^9, 3.821110930467811*^9}, {3.821111192784025*^9, 
  3.821111259983754*^9}, {3.8211907501910963`*^9, 
  3.821190756084588*^9}},ExpressionUUID->"74f7360c-03ba-4286-985d-\
9a14a8caff18"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "k", ")"}]]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], 
      RowBox[{"k", "-", "1"}]], " ", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[CapitalPi]", "n"], "(", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["E", "n"], 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], "-", 
        SuperscriptBox["H", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]]}], ")"}], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}], "+", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"d", "\[Element]", "D"}]], 
     RowBox[{
      TemplateBox[{
        SuperscriptBox["d", 
         RowBox[{"(", "0", ")"}]]},
       "Ket"], 
      TemplateBox[{
        RowBox[{
          SuperscriptBox["d", 
           RowBox[{"(", "0", ")"}]], " "}], 
        RowBox[{"\[VeryThinSpace] ", 
          SuperscriptBox["n", 
           RowBox[{
             RowBox[{"(", "k", ")"}], "\[VeryThinSpace]"}]]}]},
       "BraKet"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821110732632661*^9, 3.8211107408047323`*^9}, {
  3.821190769198382*^9, 
  3.82119080848178*^9}},ExpressionUUID->"60d3a3ef-cf63-4d90-9ec1-\
971dc5f46ffa"],

Cell[TextData[{
 "In the single state case we set ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", "n"}], TraditionalForm]],ExpressionUUID->
  "4cc84901-c7e3-417a-a0b4-4281dfa5540b"],
 " in"
}], "ExpositoryText",
 CellChangeTimes->{{3.821190811721747*^9, 3.821190813200688*^9}, {
  3.821190843775186*^9, 3.8211908554403267`*^9}, {3.821190890695224*^9, 
  3.8211908970761642`*^9}},ExpressionUUID->"dc7be512-174f-4a71-a2b5-\
9ce5ccfb09cd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      RowBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]], " "}], 
      RowBox[{"\[VeryThinSpace] ", 
        SuperscriptBox["m", 
         RowBox[{"(", "k", ")"}]]}]},
     "BraKet"], "+", 
    TemplateBox[{
      RowBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "k", ")"}]], " "}], 
      RowBox[{"\[VeryThinSpace] ", 
        SuperscriptBox["m", 
         RowBox[{"(", "0", ")"}]]}]},
     "BraKet"]}], "=", 
   RowBox[{"-", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], 
      RowBox[{"k", "-", "1"}]], 
     TemplateBox[{
       RowBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]], " "}], 
       RowBox[{"\[VeryThinSpace] ", 
         SuperscriptBox["m", 
          RowBox[{"(", 
            RowBox[{"k", "-", "i"}], ")"}]]}]},
      "BraKet"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.810302159305826*^9, 
  3.810302218358946*^9}},ExpressionUUID->"20fe43f5-af23-4d9d-8323-\
bd943ab3558f"],

Cell["but now that will not save us. ", "ExpositoryText",
 CellChangeTimes->{{3.8211909177374763`*^9, 3.821190935956152*^9}, {
   3.821190986252303*^9, 3.821190988729909*^9}, {3.821191043674699*^9, 
   3.8211910592287188`*^9}, {3.821191121954719*^9, 3.8211911251133842`*^9}, {
   3.82119133754945*^9, 3.821191415828539*^9}, {3.821191463330123*^9, 
   3.8211914681859007`*^9}, 
   3.821191956720767*^9},ExpressionUUID->"6b73c3e5-6b3b-4815-9d09-\
0b0de827a3fd"],

Cell["Instead all we have is", "ExpositoryText",
 CellChangeTimes->{{3.8211909177374763`*^9, 3.821190935956152*^9}, {
  3.821190986252303*^9, 3.821190988729909*^9}, {3.821191043674699*^9, 
  3.8211910592287188`*^9}, {3.821191121954719*^9, 3.8211911251133842`*^9}, {
  3.82119133754945*^9, 3.821191415828539*^9}, {3.821191463330123*^9, 
  3.8211914681859007`*^9}},ExpressionUUID->"11fd1862-52aa-48ca-bf32-\
109866f3f947"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     RowBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "k", ")"}]], " "}], 
     RowBox[{"\[VeryThinSpace] ", 
       SuperscriptBox["m", 
        RowBox[{"(", "0", ")"}]]}]},
    "BraKet"], "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}], 
       RowBox[{"k", "-", "1"}]], 
      TemplateBox[{
        RowBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "i", ")"}]], " "}], 
        RowBox[{"\[VeryThinSpace] ", 
          SuperscriptBox["m", 
           RowBox[{"(", 
             RowBox[{"k", "-", "i"}], ")"}]]}]},
       "BraKet"]}]}], " ", "-", " ", 
    TemplateBox[{
      RowBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]], " "}], 
      RowBox[{"\[VeryThinSpace] ", 
        SuperscriptBox["m", 
         RowBox[{"(", "k", ")"}]]}]},
     "BraKet"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.810302159305826*^9, 3.810302218358946*^9}, {
  3.821191476374868*^9, 3.8211914812502203`*^9}, {3.8211915606604137`*^9, 
  3.821191568405027*^9}},ExpressionUUID->"c0277fc1-7868-4755-87bd-\
3143c2cd4460"],

Cell["and so we have an apparently under-determined system.", "ExpositoryText",
 CellChangeTimes->{{3.821191879946705*^9, 3.821191897935861*^9}, {
  3.82119195109978*^9, 3.821191951279544*^9}, {3.821192135974017*^9, 
  3.821192137120776*^9}},ExpressionUUID->"9a871b71-ad5a-459f-a54e-\
67f6d8737e1f"],

Cell[CellGroupData[{

Cell["A Return to Sakurai", "Subsubsection",
 CellChangeTimes->{{3.821315351017867*^9, 
  3.821315356267498*^9}},ExpressionUUID->"3ed45cbd-0652-492f-bd50-\
1f1318be086f"],

Cell["\<\
As Sakurai points out, even though our states begin life as degenerate, the \
effect of the perturbation is generally to remove this degeneracy. To that \
effect, we expand in our degenerate states as\
\>", "ExpositoryText",
 CellChangeTimes->{{3.821315362016465*^9, 3.8213154379926987`*^9}, {
  3.8213154893171673`*^9, 
  3.821315503031809*^9}},ExpressionUUID->"172a6646-a71e-4f73-b025-\
971d6f5eea4f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{"d", "\[Element]", "D"}]], 
    RowBox[{
     TemplateBox[{
       RowBox[{
         SuperscriptBox["d", 
          RowBox[{"(", "0", ")"}]], " "}], 
       RowBox[{" ", 
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]}]},
      "BraKet"], 
     TemplateBox[{
       SuperscriptBox["d", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821315298402728*^9, 3.821315315748667*^9}, {
  3.82131546071799*^9, 3.821315511393529*^9}, {3.821315543274995*^9, 
  3.821315554638135*^9}},ExpressionUUID->"df5d0f17-fb14-4fd9-9825-\
9cee9d8d4768"],

Cell[TextData[{
 "which, if all states ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["d", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.821315298402728*^9, 3.821315315748667*^9}, {
   3.82131546071799*^9, 3.821315511393529*^9}},ExpressionUUID->
  "8a144aba-ee6f-48a6-828f-54bb3e5555ca"],
 " have the same energy, will still be an eigenstate of the zero-order \
Hamiltonian."
}], "ExpositoryText",
 CellChangeTimes->{{3.821315514618918*^9, 
  3.821315590586966*^9}},ExpressionUUID->"56b4ecaa-933b-48f5-a8b6-\
cbb9d226429a"],

Cell[TextData[{
 "Beyond this, we\[CloseCurlyQuote]ll write ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"n"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "07cac1e5-10b1-4d38-aa1c-9f815ee8e0fc"],
 " as usual as"
}], "ExpositoryText",
 CellChangeTimes->{{3.821315746803576*^9, 
  3.821315771127604*^9}},ExpressionUUID->"bc368ddc-e4a3-487e-8a73-\
feedb527f7b7"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      TemplateBox[{"n"},
       "Ket"], "=", 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}]], 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "i", ")"}]]},
         "Ket"], 
        SuperscriptBox["\[Lambda]", "i"]}]}]}]},
    {
     RowBox[{"H", "=", 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}]], 
       RowBox[{
        SuperscriptBox["H", 
         RowBox[{"(", "i", ")"}]], 
        SuperscriptBox["\[Lambda]", "i"]}]}]}]},
    {
     RowBox[{"E", "=", 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}]], 
       RowBox[{
        SuperscriptBox["E", 
         RowBox[{"(", "i", ")"}]], 
        SuperscriptBox["\[Lambda]", "i"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8213157722333813`*^9, 3.821315796343837*^9}, {
  3.821316059788916*^9, 
  3.821316077479357*^9}},ExpressionUUID->"9f050a08-d402-4323-9227-\
8f60b62de137"],

Cell[TextData[{
 "and as usual we\[CloseCurlyQuote]ll assume ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "c794d018-e849-4e4a-8ed4-3ab692bf3da7"],
 ", but keep in mind that the equations we\[CloseCurlyQuote]ll write must \
work for ",
 StyleBox["any",
  FontSlant->"Italic"],
 " choice of ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]],ExpressionUUID->
  "435ef288-e697-472a-a3f1-35dff18d8c9d"],
 "."
}], "ExpositoryText",
 CellChangeTimes->{{3.821315799428089*^9, 
  3.8213158338722067`*^9}},ExpressionUUID->"d515030e-8f47-44e6-aef6-\
1ef420daa139"],

Cell["\<\
Dope. Now we\[CloseCurlyQuote]ll introduce a separation into a degenerate and \
non-degenerate subspace as\
\>", "ExpositoryText",
 CellChangeTimes->{{3.821312989514566*^9, 3.8213129948308907`*^9}, {
  3.82131318277514*^9, 3.8213131880093403`*^9}, {3.8213138645295467`*^9, 
  3.8213138661579857`*^9}, {3.821314948356442*^9, 3.8213149590975533`*^9}, {
  3.821315322198337*^9, 3.821315326181831*^9}, {3.821315685243553*^9, 
  3.821315697407321*^9}, {3.8213158370214033`*^9, 3.821315838443433*^9}, {
  3.82131611660515*^9, 
  3.8213161177584763`*^9}},ExpressionUUID->"36fc3750-57f6-48f7-aa91-\
8f66ef97d756"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["P", "D"], "=", 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{"d", "\[Element]", "D"}]], 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["d", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"], 
        TemplateBox[{
          SuperscriptBox["d", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"]}]}]}]},
    {
     RowBox[{
      SubscriptBox["P", "U"], "=", 
      RowBox[{"I", "-", 
       SubscriptBox["P", "D"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.82131589075746*^9, 
  3.821315953281561*^9}},ExpressionUUID->"177c0caf-0372-45ae-beed-\
f6fa477e7557"],

Cell["then we can write", "ExpositoryText",
 CellChangeTimes->{{3.821315962763276*^9, 
  3.821315967643112*^9}},ExpressionUUID->"5663db31-909c-4991-ba02-\
5034c4b0d0bd"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"H", 
       TemplateBox[{"n"},
        "Ket"]}], "=", 
      RowBox[{
       RowBox[{"E", "(", 
        RowBox[{
         SubscriptBox["P", "U"], "+", 
         SubscriptBox["P", "D"]}], ")"}], 
       TemplateBox[{"n"},
        "Ket"]}]}]},
    {
     RowBox[{
      RowBox[{"H", "\[VeryThinSpace]", 
       TemplateBox[{"n"},
        "Ket"]}], "=", 
      RowBox[{
       RowBox[{"E", "\[VeryThinSpace]", 
        SubscriptBox["P", "U"], 
        TemplateBox[{"n"},
         "Ket"]}], "+", 
       RowBox[{"E", "\[VeryThinSpace]", 
        SubscriptBox["P", "D"], 
        TemplateBox[{"n"},
         "Ket"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821315974403734*^9, 3.821316054519475*^9}, {
  3.821316125720236*^9, 3.821316163259894*^9}, {3.821316460122601*^9, 
  3.82131646662573*^9}},ExpressionUUID->"2828193c-0c4d-4d6d-97b9-\
a2b7f16014f7"],

Cell[TextData[{
 "and then turn this into two equations by projecting using ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "U"], TraditionalForm]],ExpressionUUID->
  "34756a7c-6397-4de3-9cbe-9d9cda70fbf2"],
 " or ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "D"], TraditionalForm]],ExpressionUUID->
  "56687acd-09e6-4fe4-bab2-0f234fd81c70"],
 " respectively"
}], "ExpositoryText",
 CellChangeTimes->{{3.8213160410318737`*^9, 3.821316041972282*^9}, {
  3.82131616526064*^9, 
  3.8213161950898523`*^9}},ExpressionUUID->"bff1509f-c4db-4ea0-9a80-\
751953a1750f"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "U"], "H", "\[VeryThinSpace]", 
       TemplateBox[{"n"},
        "Ket"]}], "=", 
      RowBox[{
       RowBox[{
        SubscriptBox["P", "U"], "E", "\[VeryThinSpace]", 
        SubscriptBox["P", "U"], 
        TemplateBox[{"n"},
         "Ket"]}], "+", 
       RowBox[{
        SubscriptBox["P", "U"], "E", "\[VeryThinSpace]", 
        SubscriptBox["P", "D"], 
        TemplateBox[{"n"},
         "Ket"]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        SubscriptBox["P", "U"], "E", "\[VeryThinSpace]", 
        SubscriptBox["P", "U"], 
        TemplateBox[{"n"},
         "Ket"]}], "+", 
       RowBox[{"E", "\[VeryThinSpace]", 
        SubscriptBox["P", "U"], 
        SubscriptBox["P", "D"], 
        TemplateBox[{"n"},
         "Ket"]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{"E", "\[VeryThinSpace]", 
       SubscriptBox["P", "U"], 
       TemplateBox[{"n"},
        "Ket"]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "D"], "H", "\[VeryThinSpace]", 
       TemplateBox[{"n"},
        "Ket"]}], "=", 
      RowBox[{
       RowBox[{
        SubscriptBox["P", "D"], "E", "\[VeryThinSpace]", 
        SubscriptBox["P", "U"], 
        TemplateBox[{"n"},
         "Ket"]}], "+", 
       RowBox[{
        SubscriptBox["P", "D"], "E", "\[VeryThinSpace]", 
        SubscriptBox["P", "D"], 
        TemplateBox[{"n"},
         "Ket"]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{"E", "\[VeryThinSpace]", 
       SubscriptBox["P", "D"], 
       TemplateBox[{"n"},
        "Ket"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8213162017276373`*^9, 3.821316223700755*^9}, {
   3.821316273822598*^9, 3.821316317389687*^9}, 3.8213164355919847`*^9, {
   3.821316472563299*^9, 
   3.821316480288516*^9}},ExpressionUUID->"729ef772-60a5-4ac4-a77f-\
63878b6fbda1"],

Cell["we\[CloseCurlyQuote]ll look at the first of these and note that if we \
define", "ExpositoryText",
 CellChangeTimes->{{3.821316503010559*^9, 
  3.8213165842600393`*^9}},ExpressionUUID->"a5ff0c9e-7ee4-4a83-a159-\
c292af645aa1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[CapitalPi]", "D"], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{
      SubscriptBox["P", "U"], "(", 
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", "0", ")"}]], "-", 
       SuperscriptBox[
        SubscriptBox["E", "n"], 
        RowBox[{"(", "0", ")"}]]}], ")"}], 
     RowBox[{"-", "1"}]], 
    SubscriptBox["P", "U"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821316585502214*^9, 
  3.821316606580014*^9}},ExpressionUUID->"0d5dd0a1-30dc-4c1b-93eb-\
21a5cc091f9b"],

Cell[TextData[{
 "we can solve for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "U"], 
    TemplateBox[{"n"},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "3c17289d-9698-4f29-9d6d-af2f4fe2c70c"],
 " using the normal approach, given all the lower-order corrections, which \
will of course include ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.821318279962414*^9, 3.8213182806058197`*^9}},
  ExpressionUUID->"900c8783-e075-4bef-aa0c-105a1bae8ebf"],
 " which is currently undetermined. We\[CloseCurlyQuote]ll go into this more \
in a bit."
}], "ExpositoryText",
 CellChangeTimes->{{3.8213166098302183`*^9, 3.821316648605818*^9}, 
   3.821317242368471*^9, {3.821317517770438*^9, 3.821317520669519*^9}, {
   3.821317931081457*^9, 3.8213179349686613`*^9}, {3.82131845299715*^9, 
   3.8213184849547358`*^9}, {3.82132228019908*^9, 
   3.821322290431287*^9}},ExpressionUUID->"10accd98-5428-456c-b517-\
54bcb07b9853"],

Cell[TextData[{
 "Looking at the second, we\[CloseCurlyQuote]ll expand out the first two \
Trash Equations, because we\[CloseCurlyQuote]ll basically be doing strong \
induction with base case of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "39fe8fbe-f2f2-4d64-b210-93ea52bae5d2"]
}], "ExpositoryText",
 CellChangeTimes->{{3.821315206047348*^9, 3.821315232952527*^9}, {
  3.8213169899978313`*^9, 
  3.821317003088928*^9}},ExpressionUUID->"dea2d3ff-8318-46a0-8d2b-\
781a688f6a9e"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "D"], 
       SuperscriptBox["H", 
        RowBox[{"(", "0", ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       SuperscriptBox["E", 
        RowBox[{"(", "0", ")"}]], "\[VeryThinSpace]", 
       SubscriptBox["P", "D"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["P", "D"], 
        SuperscriptBox["H", 
         RowBox[{"(", "0", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "1", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        SubscriptBox["P", "D"], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}], "=", 
      RowBox[{
       RowBox[{
        SuperscriptBox["E", 
         RowBox[{"(", "0", ")"}]], "\[VeryThinSpace]", 
        SubscriptBox["P", "D"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "1", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        SuperscriptBox["E", 
         RowBox[{"(", "1", ")"}]], "\[VeryThinSpace]", 
        SubscriptBox["P", "D"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821315236235359*^9, 3.821315268496941*^9}, {
  3.8213170142723227`*^9, 3.821317077218361*^9}, {3.821317144471191*^9, 
  3.821317185539167*^9}},ExpressionUUID->"8eeae555-682e-4d38-9bbe-\
922e493706a6"],

Cell["\<\
the first of these isn\[CloseCurlyQuote]t particularly interesting, but in \
the second we\[CloseCurlyQuote]ll insert the identity operator again, this \
time on the left\
\>", "ExpositoryText",
 CellChangeTimes->{{3.821317262633082*^9, 
  3.821317296570704*^9}},ExpressionUUID->"9faa2d29-ec65-41be-943d-\
2614b62f3351"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["P", "D"], 
     SuperscriptBox["H", 
      RowBox[{"(", "0", ")"}]], 
     SubscriptBox["P", "D"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "1", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     SubscriptBox["P", "D"], 
     SuperscriptBox["H", 
      RowBox[{"(", "0", ")"}]], 
     SubscriptBox["P", "U"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "1", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     SubscriptBox["P", "D"], 
     SuperscriptBox["H", 
      RowBox[{"(", "1", ")"}]], 
     SubscriptBox["P", "D"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     SubscriptBox["P", "D"], 
     SuperscriptBox["H", 
      RowBox[{"(", "1", ")"}]], 
     SubscriptBox["P", "U"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}]}], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox["E", 
      RowBox[{"(", "0", ")"}]], "\[VeryThinSpace]", 
     SubscriptBox["P", "D"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "1", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     SuperscriptBox["E", 
      RowBox[{"(", "1", ")"}]], "\[VeryThinSpace]", 
     SubscriptBox["P", "D"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821317300600974*^9, 3.821317339347581*^9}, {
  3.8213176364380093`*^9, 3.821317642629953*^9}, {3.8213176834669237`*^9, 
  3.8213176883394833`*^9}},ExpressionUUID->"da168810-3b64-49a6-80f2-\
a3a6cefc7cc2"],

Cell["now we\[CloseCurlyQuote]ll note that by construction", "ExpositoryText",
 CellChangeTimes->{{3.821317964359737*^9, 
  3.821317984241029*^9}},ExpressionUUID->"b4d43ce3-827c-4465-be71-\
d23ad2a13017"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "D"], 
       SuperscriptBox["H", 
        RowBox[{"(", "0", ")"}]], 
       SubscriptBox["P", "U"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "1", ")"}]]},
        "Ket"]}], "=", "0"}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "D"], 
       SuperscriptBox["H", 
        RowBox[{"(", "0", ")"}]], 
       SubscriptBox["P", "D"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "1", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       SuperscriptBox["E", 
        RowBox[{"(", "0", ")"}]], 
       SubscriptBox["P", "D"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "1", ")"}]]},
        "Ket"], "     ", 
       StyleBox[
        RowBox[{"(", " ", 
         RowBox[{
          RowBox[{"bc", " ", 
           RowBox[{
            UnderscriptBox["\[ForAll]", "d\[Epsilon]D"], 
            RowBox[{
             TemplateBox[{
               SuperscriptBox["d", 
                RowBox[{"(", "0", ")"}]]},
              "Bra"], 
             SuperscriptBox["H", 
              RowBox[{"(", "0", ")"}]], 
             TemplateBox[{
               SuperscriptBox["d", 
                RowBox[{"(", "0", ")"}]]},
              "Ket"]}]}]}], "=", 
          SuperscriptBox["E", 
           RowBox[{"(", "0", ")"}]]}], ")"}],
        FontColor->GrayLevel[0.5]]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "U"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{"0", "    ", 
       StyleBox[
        RowBox[{"(", " ", 
         RowBox[{
          RowBox[{"bc", " ", 
           TemplateBox[{
             SuperscriptBox["n", 
              RowBox[{"(", "0", ")"}]]},
            "Ket"]}], "=", 
          RowBox[{
           UnderscriptBox["\[Sum]", 
            RowBox[{"d", "\[Element]", "D"}]], 
           RowBox[{
            TemplateBox[{
              RowBox[{
                SuperscriptBox["d", 
                 RowBox[{"(", "0", ")"}]], " "}], 
              RowBox[{" ", 
                SuperscriptBox["n", 
                 RowBox[{"(", "0", ")"}]]}]},
             "BraKet"], 
            TemplateBox[{
              SuperscriptBox["d", 
               RowBox[{"(", "0", ")"}]]},
             "Ket"]}]}]}], " ", ")"}],
        FontColor->GrayLevel[0.5]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821317985518387*^9, 3.8213180162466803`*^9}, {
  3.821318061051216*^9, 3.821318178304266*^9}, {3.82132743184446*^9, 
  3.8213274605361557`*^9}},ExpressionUUID->"3248983e-833e-4329-bb98-\
715be9ec0ee3"],

Cell["so we get", "ExpositoryText",
 CellChangeTimes->{{3.821318023644787*^9, 
  3.82131802495986*^9}},ExpressionUUID->"2e1f4a3d-ebc7-4fa7-84df-\
b238355c8a71"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["P", "D"], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["P", "D"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        SubscriptBox["P", "D"], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["P", "U"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}], "=", 
      RowBox[{
       SuperscriptBox["E", 
        RowBox[{"(", "1", ")"}]], "\[VeryThinSpace]", 
       SubscriptBox["P", "D"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "D"], 
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]], 
       SubscriptBox["P", "D"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       SuperscriptBox["E", 
        RowBox[{"(", "1", ")"}]], "\[VeryThinSpace]", 
       SubscriptBox["P", "D"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.82131802833759*^9, 3.821318029100585*^9}, {
  3.821318201095233*^9, 3.821318251664781*^9}, {3.821327421405449*^9, 
  3.821327422340626*^9}},ExpressionUUID->"6754d0f9-9332-4b1c-9f2e-\
c870d9c4c5d7"],

Cell["which gives us a concrete way to evaluate", "ExpositoryText",
 CellChangeTimes->{{3.82131825934443*^9, 
  3.821318278269834*^9}},ExpressionUUID->"1e2540a7-3169-41f2-b3cc-\
e6cb096e3053"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{"d", "\[Element]", "D"}]], 
    RowBox[{
     TemplateBox[{
       RowBox[{
         SuperscriptBox["d", 
          RowBox[{"(", "0", ")"}]], " "}], 
       RowBox[{" ", 
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]}]},
      "BraKet"], 
     TemplateBox[{
       SuperscriptBox["d", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821318279962414*^9, 
  3.8213182806058197`*^9}},ExpressionUUID->"602ab4a8-da9b-4b01-97e7-\
d330ae904230"],

Cell[TextData[{
 StyleBox["and",
  FontSlant->"Italic"],
 " simultaneously get ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["E", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.82131802833759*^9, 3.821318029100585*^9}, {
   3.821318201095233*^9, 3.821318251664781*^9}},ExpressionUUID->
  "90b8b10c-8337-49eb-96cc-1e162a475ebe"],
 " which is pretty cool. It\[CloseCurlyQuote]s worth pointing out that ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["E", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],ExpressionUUID->
  "a1d7de8e-97bf-4f06-847f-bfa2b52e5aa7"],
 " doesn\[CloseCurlyQuote]t need to be 0 in this construction, even for the \
H.O. basis."
}], "ExpositoryText",
 CellChangeTimes->{{3.821318286289873*^9, 3.8213182998773623`*^9}, {
  3.821318340620317*^9, 3.821318385282631*^9}, {3.8213185088527107`*^9, 
  3.821318547024846*^9}},ExpressionUUID->"38465143-c278-411a-a0b0-\
411478314385"],

Cell[TextData[{
 "With that in place, we can now get ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "U"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "1", ")"}]]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "50ca105c-9ffb-4e78-8fb9-5659a1c0d374"],
 "."
}], "ExpositoryText",
 CellChangeTimes->{{3.821318565732902*^9, 
  3.8213186341130037`*^9}},ExpressionUUID->"db777f09-67a2-4f05-aa21-\
d4c11f013310"],

Cell[TextData[{
 "Moving on to the general case, we can ",
 StyleBox["always",
  FontSlant->"Italic"],
 " write"
}], "ExpositoryText",
 CellChangeTimes->{{3.8213186355455008`*^9, 3.821318643150853*^9}, {
  3.8213191556460457`*^9, 
  3.82131916595798*^9}},ExpressionUUID->"20dbb1bd-bd18-400d-95cf-\
8e115c7dec04"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{" ", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["P", "D"], 
         SuperscriptBox["H", 
          RowBox[{"(", "0", ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "k", ")"}]]},
          "Ket"]}], "+", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"i", "=", "0"}], 
          RowBox[{"k", "-", "1"}]], " ", 
         RowBox[{
          SubscriptBox["P", "D"], 
          SuperscriptBox["H", 
           RowBox[{"(", 
            RowBox[{"k", "-", "i"}], ")"}]], 
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "i", ")"}]]},
           "Ket"]}]}]}], "=", 
       RowBox[{
        RowBox[{
         SubscriptBox["P", "D"], 
         SuperscriptBox["E", 
          RowBox[{"(", "0", ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "k", ")"}]]},
          "Ket"]}], "+", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"i", "=", "0"}], 
          RowBox[{"k", "-", "1"}]], " ", " ", 
         RowBox[{
          SubscriptBox["P", "D"], 
          SuperscriptBox["E", 
           RowBox[{"(", 
            RowBox[{"k", "-", "i"}], ")"}]], 
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "i", ")"}]]},
           "Ket"]}]}]}]}]}]},
    {
     RowBox[{
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], 
        RowBox[{"k", "-", "1"}]], " ", 
       RowBox[{
        SubscriptBox["P", "D"], 
        SuperscriptBox["H", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "i", ")"}]]},
         "Ket"]}]}], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], 
        RowBox[{"k", "-", "1"}]], " ", " ", 
       RowBox[{
        SubscriptBox["P", "D"], 
        SuperscriptBox["E", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "i", ")"}]]},
         "Ket"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821318644106174*^9, 3.8213186441113663`*^9}, {
  3.821319167892445*^9, 3.8213192193874598`*^9}, {3.82131933391693*^9, 
  3.821319411165935*^9}, {3.821319469597809*^9, 
  3.8213194750864067`*^9}},ExpressionUUID->"bdaf2db4-dba2-434e-8c2f-\
ec4422bd5dd7"],

Cell[TextData[{
 "which is pretty slick, but also means that if we ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "D"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "ca2e5f2e-8a6a-4c78-a3ab-25d068cbfdf5"],
 " we actually need to go to order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "+", "1"}], TraditionalForm]],ExpressionUUID->
  "9027fb96-7203-46cd-acb7-74bab485bdfa"],
 ". "
}], "ExpositoryText",
 CellChangeTimes->{{3.8213194648082323`*^9, 
  3.821319534597591*^9}},ExpressionUUID->"bce5d624-c2ea-4281-9a6d-\
068b23c06d48"],

Cell[TextData[{
 "In any case, we\[CloseCurlyQuote]ll try to find a general way to get ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["E", 
    RowBox[{"(", "k", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.821318644106174*^9, 3.8213186441113663`*^9}, {
   3.821319167892445*^9, 3.8213192193874598`*^9}, {3.82131933391693*^9, 
   3.821319411165935*^9}, {3.821319469597809*^9, 3.8213194750864067`*^9}},
  ExpressionUUID->"f4644e2c-d818-4541-bce5-576ede69ce89"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "D"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", 
         RowBox[{"k", "-", "1"}], ")"}]]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "bca7e4a8-d178-4eca-8a8d-f4e5df955641"],
 " assuming we know the lower-order stuff. To do that, we\[CloseCurlyQuote]ll \
basically just take a note from what we did in the non-degenerate case and \
apply ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Bra"], TraditionalForm]],ExpressionUUID->
  "711c0703-efca-49e1-a4ca-22ff21e1d063"],
 " on the left"
}], "ExpositoryText",
 CellChangeTimes->{{3.8213194648082323`*^9, 3.8213196151125107`*^9}, {
  3.8213196534764767`*^9, 3.8213196919110737`*^9}, {3.821320668425316*^9, 
  3.821320693686075*^9}},ExpressionUUID->"cdfe3bd6-605c-4004-9373-\
5825339b8ce7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], 
     RowBox[{"k", "-", "1"}]], " ", 
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     SubscriptBox["P", "D"], 
     SuperscriptBox["H", 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "i", ")"}]]},
      "Ket"]}]}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], 
     RowBox[{"k", "-", "1"}]], "  ", 
    RowBox[{
     SuperscriptBox["E", 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     SubscriptBox["P", "D"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "i", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821320694916465*^9, 3.8213207594937477`*^9}, 
   3.82132094891063*^9, {3.821320979103142*^9, 
   3.8213209854029837`*^9}},ExpressionUUID->"aab5bf91-ee16-4522-a43d-\
81a278259fcc"],

Cell["\<\
then we\[CloseCurlyQuote]ll isolate and rearrange stuff so things look the \
way the did in the non-degenerate case\
\>", "ExpositoryText",
 CellChangeTimes->{{3.821320788391074*^9, 3.8213208294605217`*^9}, {
  3.8213208645359287`*^9, 3.821320865194055*^9}, {3.82132109678126*^9, 
  3.821321100106985*^9}, {3.821321137359786*^9, 
  3.821321145562481*^9}},ExpressionUUID->"c27e6dfb-ee87-42e9-84fc-\
bc97ff40b074"],

Cell[BoxData[
 FormBox[
  RowBox[{" ", 
   RowBox[{
    RowBox[{
     SuperscriptBox["E", 
      RowBox[{"(", "k", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
