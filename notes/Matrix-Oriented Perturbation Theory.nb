Notebook[{

Cell[CellGroupData[{
Cell["Matrix Oriented Perturbation Theory", "Title",
 CellChangeTimes->{{3.916345479352017*^9, 
  3.9163454844104357`*^9}},ExpressionUUID->"72ec6033-e010-4686-aa6e-\
153196480307"],

Cell["Mark Boyer, Feb 7. 2024", "ExpositoryText",
 CellChangeTimes->{{3.9163454884723787`*^9, 
  3.91634549541164*^9}},ExpressionUUID->"2f639365-c586-4873-a1e5-\
6ea2b59b79fe"],

Cell["\<\
These comprise a series of notes written while developing a library for \
performing vibrational perturbation theory. Some of the work, particularly \
that involving the lattice-path/combinatoric approach is unpublished but the \
primary theory can be seen in these two papers \
[https://doi.org/10.1063/5.0080892, https://doi.org/10.1063/5.0121915]. A \
library implementing much of this can be found here \
[https://github.com/McCoyGroup/Psience]\
\>", "ExpositoryText",
 CellChangeTimes->{{3.916345496806398*^9, 3.91634554863837*^9}, {
  3.9163455971453867`*^9, 
  3.9163456983741617`*^9}},ExpressionUUID->"50e21b4f-aac1-4648-894d-\
00ea839f8e4a"],

Cell["\<\
There may be errors and many sections end abruptly, these are/were personal \
notes. Many sections with code and images are excluded from the PDF export, \
but the notebook with implementations is available upon request.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.916345632561702*^9, 3.916345653418035*^9}, {
  3.916345702396925*^9, 3.916345705371416*^9}, {3.916345857723001*^9, 
  3.916345911227107*^9}},ExpressionUUID->"ec3b92fb-dbb0-413b-9507-\
68c229259c1e"],

Cell[CellGroupData[{

Cell["Perturbation Theory Formalism", "Section",
 CellChangeTimes->{{3.8064112704084597`*^9, 
  3.806411276584777*^9}},ExpressionUUID->"f392c502-f2fc-4108-b146-\
544ee7026e85"],

Cell["\<\
This approach tries to bridge the approach presented by J. J. Sakurai and \
which you find on the web with the more standard approach \
we\[CloseCurlyQuote]d see on, e.g., Wikipedia. The idea is to convert things \
into matrix operations so as to make the logic of the problem more obvious.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8064522146477537`*^9, 
  3.806452299845903*^9}},ExpressionUUID->"6fd6e5dd-bd16-46f3-b464-\
7513bda8db79"],

Cell[CellGroupData[{

Cell["Derivation", "Subsection",
 CellChangeTimes->{{3.8109463219396067`*^9, 
  3.810946323206657*^9}},ExpressionUUID->"cd45555f-d888-4524-8c53-\
f8e0375f455e"],

Cell["We\[CloseCurlyQuote]ll write our Hamiltonian out as", "ExpositoryText",
 CellChangeTimes->{{3.806411465599264*^9, 3.806411494790038*^9}, {
  3.806412059188068*^9, 
  3.806412066722385*^9}},ExpressionUUID->"3f3b6097-650a-45b0-8537-\
98887e99f78a"],

Cell[BoxData[
 FormBox[
  RowBox[{"H", "=", 
   RowBox[{
    SuperscriptBox["H", 
     RowBox[{"(", "0", ")"}]], "+", 
    RowBox[{"\[Lambda]", "\[VeryThinSpace]", 
     SuperscriptBox["H", 
      RowBox[{"(", "1", ")"}]]}], "+", 
    RowBox[{
     SuperscriptBox["\[Lambda]", "2"], 
     SuperscriptBox["H", 
      RowBox[{"(", "2", ")"}]]}], "+", "\[Ellipsis]"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8064114854127483`*^9, 3.80641150126344*^9}, {
  3.80641245349781*^9, 
  3.8064124547847433`*^9}},ExpressionUUID->"7dd71d56-b426-4ff5-91fe-\
6fc808ae0ba8"],

Cell["and we\[CloseCurlyQuote]ll write our states out as", "ExpositoryText",
 CellChangeTimes->{{3.806411584767536*^9, 3.806411609719487*^9}, {
  3.8064118470782757`*^9, 3.806411853860845*^9}, {3.806412069475711*^9, 
  3.806412084389477*^9}},ExpressionUUID->"2c1e7286-58e5-4d6f-ba0e-\
6d75f7864d8d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{"n"},
    "Ket"], "=", 
   RowBox[{
    SuperscriptBox[
     TemplateBox[{"n"},
      "Ket"], 
     RowBox[{"(", "0", ")"}]], "+", 
    RowBox[{"\[Lambda]", 
     SuperscriptBox[
      TemplateBox[{"n"},
       "Ket"], 
      RowBox[{"(", "1", ")"}]]}], "+", 
    RowBox[{
     SuperscriptBox["\[Lambda]", "2"], 
     SuperscriptBox[
      TemplateBox[{"n"},
       "Ket"], 
      RowBox[{"(", "2", ")"}]]}], "+", "\[Ellipsis]"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.806411610985836*^9, 3.8064116429112597`*^9}, {
  3.806411854957388*^9, 3.806411868284384*^9}, {3.806411955616455*^9, 
  3.806411957878035*^9}, {3.806412082610836*^9, 
  3.80641208293013*^9}},ExpressionUUID->"9315c640-24b9-43b8-9fb8-\
c68488b21daf"],

Cell["where", "ExpositoryText",
