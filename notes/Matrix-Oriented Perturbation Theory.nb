Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"aSeqGen", "[", 
    RowBox[{"b_", ",", " ", "k_"}], "]"}], ":=", 
   RowBox[{"Sum", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"j", "==", "0"}], ",", " ", "j", ",", " ", 
         RowBox[{"j", "+", "1"}]}], "]"}]], 
      RowBox[{
       RowBox[{"Cmat", "[", 
        RowBox[{"[", "b", "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"k", "-", "j", "+", "1"}], "]"}], "]"}], 
      RowBox[{"Pochhammer", "[", 
       RowBox[{
        RowBox[{"b", "-", "k", "+", "1"}], ",", " ", "j"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "0", ",", " ", "k"}], "}"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"aSeqGen2", "[", 
    RowBox[{"b_", ",", " ", "k_"}], "]"}], ":=", 
   RowBox[{"Sum", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"j", "==", "k"}], ",", " ", "0", ",", " ", 
         RowBox[{"k", "-", "j", "+", "1"}]}], "]"}]], 
      RowBox[{
       RowBox[{"Cmat", "[", 
        RowBox[{"[", "b", "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"j", "+", "1"}], "]"}], "]"}], 
      RowBox[{"Pochhammer", "[", 
       RowBox[{
        RowBox[{"b", "-", "k", "+", "1"}], ",", " ", 
        RowBox[{"k", "-", "j"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "0", ",", " ", "k"}], "}"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fTermGen", "[", 
    RowBox[{"b_", ",", " ", "i_", ",", " ", "j_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"aSeqMat", "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{"b", "+", "1"}], ",", " ", 
       RowBox[{"i", "-", "j", "+", "1"}]}], "]"}], "]"}], "*", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"2", "^", 
       RowBox[{"(", 
        RowBox[{"b", "+", 
         RowBox[{"(", 
          RowBox[{"i", "-", "j"}], ")"}]}], ")"}]}], ")"}]}], "*", 
    RowBox[{"Binomial", "[", 
     RowBox[{
      RowBox[{"b", "-", 
       RowBox[{"(", 
        RowBox[{"i", "-", "j"}], ")"}]}], ",", " ", "j"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fGen", "[", 
   RowBox[{"b_", ",", " ", "i_", ",", " ", "j_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Sum", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"aSeqMat", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"b", "+", "1"}], ",", " ", 
        RowBox[{"m", "+", "1"}]}], "]"}], "]"}], "*", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"2", "^", 
        RowBox[{"(", 
         RowBox[{"b", "+", "m"}], ")"}]}], ")"}]}], "*", 
     RowBox[{"Binomial", "[", 
      RowBox[{
       RowBox[{"b", "-", "m"}], ",", " ", 
       RowBox[{"i", "-", "m"}]}], "]"}], 
     RowBox[{"StirlingS1", "[", 
      RowBox[{
       RowBox[{"i", "-", "m"}], ",", " ", "j"}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"m", ",", " ", "0", ",", " ", 
      RowBox[{"i", "-", "j"}]}], "}"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
