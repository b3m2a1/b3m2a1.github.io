  CellChangeTimes->{{3.8145392977767477`*^9, 3.8145395164507437`*^9}, {
   3.814539565495068*^9, 3.814539620319025*^9}, {3.814540102925145*^9, 
   3.8145401053162117`*^9}, {3.814540327467417*^9, 3.814540401397697*^9}},
  ExpressionUUID->"83d003c7-33a5-4950-832f-7cad79a318b7"],
 "."
}], "ExpositoryText",
 CellChangeTimes->{{3.814543893744492*^9, 3.8145439114623623`*^9}, {
  3.814544122179336*^9, 
