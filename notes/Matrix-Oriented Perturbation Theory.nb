  3.889470358598051*^9}},ExpressionUUID->"67cfeae9-e676-4c96-9928-\
f1750a71d260"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"j", "=", "0"}], "\[Omega]"], " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"l", "=", "1"}], 
      RowBox[{"j", "+", "1"}]], " ", 
     RowBox[{
      RowBox[{
       SubscriptBox["S", "2"], "(", 
       RowBox[{"\[Omega]", ",", " ", "j"}], ")"}], 
      FractionBox["b", 
       RowBox[{"b", "+", "j", "+", "1"}]], " ", 
      RowBox[{
       SubscriptBox["S", "1"], "(", 
       RowBox[{
        RowBox[{"j", "+", "1"}], ",", " ", "l"}], ")"}], 
      SuperscriptBox["a", "l"]}]}]}], " ", "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"l", "=", "1"}], "\[Omega]"], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", "l"}], 
        RowBox[{"\[Omega]", "+", "1"}]], "  ", 
       RowBox[{
        RowBox[{
         SubscriptBox["S", "2"], "(", 
         RowBox[{"\[Omega]", ",", " ", "j"}], ")"}], 
        FractionBox["b", 
         RowBox[{"b", "+", "j"}]], " ", 
        RowBox[{
         SubscriptBox["S", "1"], "(", 
         RowBox[{"j", ",", " ", "l"}], ")"}]}]}], ")"}], 
     SuperscriptBox["a", "l"]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.889465914002426*^9, 3.8894660400473833`*^9}, {
   3.8894660833195972`*^9, 3.889466143406452*^9}, {3.88946627962398*^9, 
   3.889466297569705*^9}, 3.8894663551334457`*^9, {3.889466434368544*^9, 
   3.8894664553988113`*^9}, {3.889466721056975*^9, 3.889466721799039*^9}, {
   3.889467568431904*^9, 3.889467610909577*^9}, {3.889467660906369*^9, 
   3.889467695140182*^9}, {3.889468141444375*^9, 3.88946819509651*^9}, {
   3.8894683240807133`*^9, 3.889468365779113*^9}, {3.889468573644895*^9, 
   3.8894685966551847`*^9}, {3.889468654354072*^9, 3.88946867122362*^9}, {
   3.889468830849325*^9, 3.889468884460628*^9}, {3.889468984742216*^9, 
   3.889469011654874*^9}, {3.889469637404029*^9, 3.889469643902707*^9}, {
   3.889469709242173*^9, 3.8894697396782837`*^9}, {3.889474827113578*^9, 
   3.889474856652133*^9}, 3.8894751450746527`*^9, {3.890647912003675*^9, 
   3.890648005760869*^9}, {3.890648256321645*^9, 3.890648262048238*^9}, {
   3.8906482924948*^9, 3.890648303444641*^9}, 
   3.890649081075884*^9},ExpressionUUID->"f2df186e-9dba-4291-b7d2-\
ae9745d0426e"],

Cell["\<\
To do this for all possible choices of \[Omega], we can recognize this as the \
matrix transform\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8906490849969797`*^9, 3.890649122153693*^9}, {
  3.890649192414956*^9, 
  3.890649243107102*^9}},ExpressionUUID->"c4da75d9-5198-4d65-98da-\
0cd31e041d23"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["A", 
    RowBox[{"(", "b", ")"}]], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["S", "2"], "(", 
     FractionBox["b", 
      RowBox[{"b", "+", "j"}]], ")"}], 
    SubscriptBox["S", "1"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.890649245026781*^9, 
  3.890649292956498*^9}},ExpressionUUID->"b420a409-57b1-4e40-973c-\
1bd4033b465e"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  RowBox[{"(", 
   FractionBox["b", 
    RowBox[{"b", "+", "j"}]], ")"}]],
  CellChangeTimes->{{3.890649245026781*^9, 3.890649292956498*^9}},
  ExpressionUUID->"4af82b14-571a-403d-884e-a6e9b4f1d808"],
 " is the diagonal matrix constructed by taking ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "24ffc17b-d4cf-4e3f-afbf-d7744b72e9a0"],
 " to be the appropriate row/column"
}], "ExpositoryText",
 CellChangeTimes->{{3.890649298869647*^9, 3.89064929957327*^9}, {
  3.890649377981724*^9, 3.890649382963067*^9}, {3.8906494147626457`*^9, 
  3.89064945806288*^9}},ExpressionUUID->"9be1d75a-685a-4569-80d2-\
6611c3ca0791"],

Cell[TextData[{
 "The upshot of this is twofold, first off this shows that we\
\[CloseCurlyQuote]re really just transforming from plain polynomials to \
rising factorials, scaling by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"b", "/", "b"}], "+", "j"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "89393050-31f1-46bf-9ac7-1351d696bfe9"],
 ", and transforming back, second, this can help with later recurrences"
}], "ExpositoryText",
 CellChangeTimes->{{3.890649461115429*^9, 3.890649507691306*^9}, {
  3.890649932219768*^9, 
  3.890649996025021*^9}},ExpressionUUID->"cc4fca2d-82d9-4702-91d8-\
ffac2e456bbc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"s2Mat", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"StirlingS2", "[", 
      RowBox[{"i", ",", " ", "j"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "0", ",", " ", "10"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", "0", ",", " ", "10"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s1Mat", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"StirlingS1", "[", 
      RowBox[{"i", ",", " ", "j"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "0", ",", "10"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", "0", ",", " ", "10"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"testMat", "=", "\[IndentingNewLine]", 
   RowBox[{"s2Mat", ".", "\[IndentingNewLine]", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"b", "/", 
      RowBox[{"(", 
       RowBox[{"b", "+", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", "10"}], "]"}]}], ")"}]}], "]"}], ".", 
    "\[IndentingNewLine]", "s1Mat"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.890648777013584*^9, 3.8906488392901506`*^9}, {
  3.890747758295786*^9, 3.89074784460315*^9}},
 CellLabel->
  "In[230]:=",ExpressionUUID->"e9a8cddb-17b1-4334-8887-0d97c0ffea16"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"bigS2", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"StirlingS2", "[", 
      RowBox[{"i", ",", " ", "j"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "0", ",", " ", "100"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", "0", ",", " ", "100"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bigS1", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"StirlingS1", "[", 
      RowBox[{"i", ",", " ", "j"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "0", ",", " ", "100"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", "0", ",", " ", "100"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ABmat", "[", "b_Integer", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bigS2", "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{";;", 
        RowBox[{"b", "+", "1"}]}], ",", 
       RowBox[{";;", 
        RowBox[{"b", "+", "1"}]}]}], "]"}], "]"}], ".", "\[IndentingNewLine]", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"b", "/", 
      RowBox[{"(", 
       RowBox[{"b", "+", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", "b"}], "]"}]}], ")"}]}], "]"}], ".", 
    "\[IndentingNewLine]", 
    RowBox[{"bigS1", "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{";;", 
        RowBox[{"b", "+", "1"}]}], ",", " ", 
       RowBox[{";;", 
        RowBox[{"b", "+", "1"}]}]}], "]"}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.8907524407293987`*^9, 3.8907524614451838`*^9}, {
  3.8907525360692463`*^9, 3.890752553950384*^9}},
 CellLabel->
  "In[282]:=",ExpressionUUID->"0de28813-8f8b-4319-8abb-49c8df6da525"],

Cell[TextData[{
 "Then we can re-aggregate and gather once again in powers of ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "0c17a8f5-0bf4-417a-8f5f-de20d294b7cf"],
 ", giving us"
}], "ExpositoryText",
 CellChangeTimes->{{3.8894686758877783`*^9, 3.8894687073780003`*^9}, {
  3.8894701782616997`*^9, 
  3.8894701849671392`*^9}},ExpressionUUID->"f3f71c96-d15b-422f-9782-\
6c1492d8528c"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Omega]", "=", "0"}], 
        RowBox[{"b", "-", "k"}]], 
       RowBox[{
        RowBox[{"(", "...", ")"}], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"i", "=", "0"}], "a"], " ", 
         RowBox[{
          RowBox[{"(", GridBox[{
             {
              RowBox[{"i", "+", "b", "-", "1"}]},
             {
              RowBox[{"b", "-", "1"}]}
            },
            GridBoxAlignment->{"Columns" -> {Center}}], ")"}], " ", 
          SuperscriptBox["i", "\[Omega]"]}]}]}]}], " ", "=", 
      RowBox[{
       RowBox[{"(", GridBox[{
          {
           RowBox[{"a", "+", "b"}]},
          {"b"}
         },
         GridBoxAlignment->{"Columns" -> {Center}}], ")"}], " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"\[Omega]", "=", "0"}], 
         RowBox[{"b", "-", "k"}]], " ", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"l", "=", "1"}], "\[Omega]"], " ", 
         RowBox[{
          RowBox[{"(", "...", ")"}], " ", 
          RowBox[{"(", 
           RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{"j", "=", "l"}], 
             RowBox[{"\[Omega]", "+", "1"}]], "  ", 
            RowBox[{
             RowBox[{
              SubscriptBox["S", "2"], "(", 
              RowBox[{"\[Omega]", ",", " ", "j"}], ")"}], 
             FractionBox["b", 
              RowBox[{"b", "+", "j"}]], " ", 
             RowBox[{
              SubscriptBox["S", "1"], "(", 
              RowBox[{"j", ",", " ", "l"}], ")"}]}]}], ")"}], 
          SuperscriptBox["a", "l"]}]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{"(", GridBox[{
          {
           RowBox[{"a", "+", "b"}]},
          {"b"}
         },
         GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"l", "=", "1"}], 
         RowBox[{"b", "-", "k"}]], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"\[Omega]", "=", 
             RowBox[{"l", "+", "1"}]}], 
            RowBox[{"b", "-", "k"}]], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              SubsuperscriptBox["c", 
               RowBox[{
                RowBox[{"k", "\[InvisibleSpace]", "\[Omega]"}], "-", "1"}], 
               RowBox[{"(", 
                RowBox[{"b", "-", "1"}], ")"}]], "-", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"b", "-", "1"}], ")"}], 
               SubsuperscriptBox["c", 
                RowBox[{"k", "\[InvisibleSpace]", "\[Omega]"}], 
                RowBox[{"(", 
                 RowBox[{"b", "-", "1"}], ")"}]]}], " ", "+", " ", 
              SubsuperscriptBox["c", 
               RowBox[{"k", "-", 
                RowBox[{"1", "\[InvisibleSpace]", "\[Omega]"}]}], 
               RowBox[{"(", 
                RowBox[{"b", "-", "1"}], ")"}]]}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              UnderoverscriptBox["\[Sum]", 
               RowBox[{"j", "=", "l"}], 
               RowBox[{"\[Omega]", "+", "1"}]], "  ", 
              RowBox[{
               RowBox[{
                SubscriptBox["S", "2"], "(", 
                RowBox[{"\[Omega]", ",", " ", "j"}], ")"}], 
               FractionBox["b", 
                RowBox[{"b", "+", "j"}]], " ", 
               RowBox[{
                SubscriptBox["S", "1"], "(", 
                RowBox[{"j", ",", " ", "l"}], ")"}]}]}], ")"}]}]}], ")"}], 
         SuperscriptBox["a", "l"]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{"(", GridBox[{
          {
           RowBox[{"a", "+", "b"}]},
          {"b"}
         },
         GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"l", "=", "1"}], 
         RowBox[{"b", "-", "k"}]], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"\[Omega]", "=", 
             RowBox[{"l", "+", "1"}]}], 
            RowBox[{"b", "-", "k"}]], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              SubsuperscriptBox["c", 
               RowBox[{
                RowBox[{"k", "\[InvisibleSpace]", "\[Omega]"}], "-", "1"}], 
               RowBox[{"(", 
                RowBox[{"b", "-", "1"}], ")"}]], "-", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"b", "-", "1"}], ")"}], 
               SubsuperscriptBox["c", 
                RowBox[{"k", "\[InvisibleSpace]", "\[Omega]"}], 
                RowBox[{"(", 
                 RowBox[{"b", "-", "1"}], ")"}]]}], " ", "+", " ", 
              SubsuperscriptBox["c", 
               RowBox[{"k", "-", 
                RowBox[{"1", "\[InvisibleSpace]", "\[Omega]"}]}], 
               RowBox[{"(", 
                RowBox[{"b", "-", "1"}], ")"}]]}], ")"}], 
            SubscriptBox[
             RowBox[{"(", 
              SuperscriptBox["A", 
               RowBox[{"(", "b", ")"}]], ")"}], 
             RowBox[{"\[Omega]", "\[InvisibleSpace]", "l"}]]}]}], ")"}], 
         SuperscriptBox["a", "l"]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
