       SuperscriptBox[
        RowBox[{"(", 
         FractionBox["1", "2"], ")"}], 
        RowBox[{"\[Omega]", "-", "m", "+", "1"}]], 
       SubscriptBox[
        RowBox[{"(", 
         SuperscriptBox[
          RowBox[{"(", 
