Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", 
     SuperscriptBox["D", 
      RowBox[{"(", 
       RowBox[{"a", "-", "1"}], ")"}]]], "=", 
    RowBox[{
     SubscriptBox["P", 
      SuperscriptBox["D", 
       RowBox[{"(", "a", ")"}]]], "+", 
     SubscriptBox["P", 
      SuperscriptBox["U", 
       RowBox[{"(", "a", ")"}]]]}]}], TraditionalForm]],ExpressionUUID->
  "e96ad7d6-ba75-4b44-a63d-b6e54b7ee428"],
 " and use the commutativity of ",
 Cell[BoxData[
  FormBox[
