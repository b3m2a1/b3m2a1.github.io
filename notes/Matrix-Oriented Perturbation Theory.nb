             RowBox[{
              RowBox[{"\[Omega]", "+", "1"}], ";"}]]}], ")"}], 
          RowBox[{"j", "\[InvisibleSpace]", "0"}]]}]}]}]}]},
    {
     RowBox[{
      SubsuperscriptBox[
       RowBox[{"(", "g", ")"}], 
       RowBox[{"k", "\[InvisibleSpace]", "l"}], 
       RowBox[{"(", "b", ")"}]], " ", "=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", "0"}], 
        RowBox[{"b", "+", "k", "-", "1"}]], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox["g", 
           RowBox[{"k", "\[InvisibleSpace]", "j"}], 
           RowBox[{"\[VeryThinSpace]", 
            RowBox[{"(", 
             RowBox[{"b", "-", "1"}], ")"}]}]], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"k", "-", "1"}], ")"}], 
           SubsuperscriptBox["g", 
            RowBox[{"k", "-", 
             RowBox[{"1", "\[InvisibleSpace]", "j"}]}], 
            RowBox[{"\[VeryThinSpace]", 
             RowBox[{"(", 
              RowBox[{"b", "-", "1"}], ")"}]}]]}], "+", 
          SubsuperscriptBox["g", 
           RowBox[{"k", "-", 
            RowBox[{"1", "\[InvisibleSpace]", "j"}], "-", "1"}], 
           RowBox[{"\[VeryThinSpace]", 
            RowBox[{"(", 
             RowBox[{"b", "-", "1"}], ")"}]}]]}], ")"}], 
        SubscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["S", "2"], 
           SubscriptBox[
            RowBox[{"\[CapitalPhi]", "\[VeryThinSpace]", "(", 
             RowBox[{
              SubscriptBox["S", "1"], "\[InvisibleSpace]", "P"}], ")"}], 
            RowBox[{
             RowBox[{"\[Omega]", "+", "1"}], ";"}]]}], ")"}], 
         RowBox[{"j", "\[InvisibleSpace]", "l"}]]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
