Cell[TextData[{
 "but now we need an expression for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", 
     SuperscriptBox["D", 
      RowBox[{"(", "1", ")"}]]], 
    SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
     RowBox[{"(", "2", ")"}]], 
    SubscriptBox["P", 
     SuperscriptBox["U", 
      RowBox[{"(", "1", ")"}]]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], TraditionalForm]],
  CellChangeTimes->{{3.825775297263338*^9, 3.825775319653659*^9}, {
   3.825775387380598*^9, 3.825775473768024*^9}, {3.825775599021833*^9, 
   3.825775627626049*^9}, {3.8257757038569937`*^9, 3.8257758643788223`*^9}, {
   3.825776072712221*^9, 3.82577610107617*^9}},ExpressionUUID->
  "454c59e4-5e8d-47d2-bda1-6fa72a57dbad"],
 ". We get that by noting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", 
     SuperscriptBox["U", 
      RowBox[{"(", "1", ")"}]]], "\[Subset]", 
    SubscriptBox["P", 
     SuperscriptBox["D", 
      RowBox[{"(", "0", ")"}]]]}], TraditionalForm]],ExpressionUUID->
  "39b5b545-0e55-4f63-9d87-fd0ee095afcb"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["P", 
      SuperscriptBox["D", 
       RowBox[{"(", "1", ")"}]]], 
     SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
      RowBox[{"(", "1", ")"}]], 
     SubscriptBox["P", 
      SuperscriptBox["D", 
       RowBox[{"(", "1", ")"}]]], 
     TemplateBox[{
       SuperscriptBox["n", 
