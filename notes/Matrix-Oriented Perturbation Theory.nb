56e35c32ba7b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["n", "i"], "=", 
   RowBox[{"\[Piecewise]", GridBox[{
      {"1", 
       RowBox[{"i", "=", 
        RowBox[{
         RowBox[{
          SubscriptBox["k", "1"], " ", "or", " ", "i"}], "=", 
         SubscriptBox["k", "2"]}]}]},
      {"0", "else"}
     }]}]}], TraditionalForm]], "ExpositoryMathCentered",
