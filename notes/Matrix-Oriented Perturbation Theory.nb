Cell[CellGroupData[{

Cell["Generalization & Higher-Order Corrections", "Subsubsection",
 CellChangeTimes->{{3.80645285827124*^9, 3.806452861645773*^9}, {
  3.810046573369698*^9, 3.8100465751170464`*^9}, {3.810047138809062*^9, 
  3.810047145246113*^9}},ExpressionUUID->"d6ca4780-3a88-4589-8eb8-\
00af89e4e9d7"],

Cell["\<\
Rather than work out every order of correction on by one, \
we\[CloseCurlyQuote]ll reorganize things to give a cleaner formulation. To \
start, we\[CloseCurlyQuote]ll rewrite our Trash Equations in a more general \
form as \
\>", "ExpositoryText",
 CellChangeTimes->{{3.810046582317521*^9, 3.810046620663837*^9}, {
  3.8100466605899773`*^9, 
  3.8100466833572683`*^9}},ExpressionUUID->"778bdf12-85b7-4f07-9537-\
85d7beb58819"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], "k"], 
    RowBox[{
     SuperscriptBox["H", 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "i", ")"}]]},
      "Ket"]}]}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], "k"], 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["E", "n"], 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "i", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.810046685081461*^9, 3.810046761718396*^9}, {
  3.810053860753112*^9, 
  3.810053861116617*^9}},ExpressionUUID->"52288111-8e56-40ef-be4a-\
5f19401ff6b9"],

Cell[TextData[{
 "we can then operate again on both sides with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
