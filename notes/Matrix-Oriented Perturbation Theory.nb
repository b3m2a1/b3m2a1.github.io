       TemplateBox[{
         RowBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]], " "}], 
         RowBox[{"\[VeryThinSpace] ", 
           SuperscriptBox["n", 
            RowBox[{"(", 
              SubscriptBox["p", "M"], ")"}]]}]},
        "BraKet"]}]}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"(", "\[VeryThinSpace]", 
      RowBox[{
       UnderoverscriptBox["\[Product]", 
        RowBox[{"i", "=", "1"}], 
        RowBox[{"M", "-", "1"}]], 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", 
          StyleBox[
           SubscriptBox["p", "i"],
           FontSize->14], ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"]}]}], ")"}], 
     SubsuperscriptBox["\[CapitalDelta]H", "n", 
      RowBox[{"(", 
       SubscriptBox["p", "M"], ")"}]]}]}]}], 
