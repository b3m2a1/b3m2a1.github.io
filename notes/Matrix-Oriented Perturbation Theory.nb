   RowBox[{"polyGenP", "[", 
    RowBox[{"a_", ",", " ", "0"}], "]"}], "=", "1"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"polyGenP", "[", 
    RowBox[{"a_", ",", " ", "b_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"polyGenP", "[", 
     RowBox[{"a", ",", " ", "b"}], "]"}], "=", 
    RowBox[{"(", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"\[FormalI]", "=", "0"}], "a"], 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"a", "-", "\[FormalI]"}], ")"}]], 
       RowBox[{"(", 
        RowBox[{"\[FormalN]", "+", "\[FormalI]", "-", "b", "+", "1"}], ")"}], 
       " ", 
       RowBox[{"polyGenP", "[", 
        RowBox[{"\[FormalI]", ",", " ", 
         RowBox[{"b", "-", "1"}]}], "]"}]}]}], ")"}]}]}], ";"}]}], "Input",
