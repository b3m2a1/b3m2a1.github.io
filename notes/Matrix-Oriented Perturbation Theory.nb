}, Closed]],

Cell[CellGroupData[{

Cell["Degenerate Case", "Subsubsection",
 CellChangeTimes->{{3.82164590585579*^9, 3.8216459105136213`*^9}, {
  3.821646042349539*^9, 
  3.8216460433797398`*^9}},ExpressionUUID->"2b73baa3-8b75-4989-ad32-\
59e135fbfb72"],

Cell[TextData[{
 "We\[CloseCurlyQuote]ll pull out a subspace of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "0", ")"}]], TraditionalForm]],ExpressionUUID->
  "41f19054-7fed-4283-acbd-b87ac1ad1829"],
 " where the energies are close enough that we\[CloseCurlyQuote]ll call them \
degenerate (I\[CloseCurlyQuote]m picking randomly, JSYK, so this will \
actually introduce some degree of error). We\[CloseCurlyQuote]re going to \
show how to get perturbation corrections for these states."
}], "ExpositoryText",
 CellChangeTimes->{{3.821646044862611*^9, 3.821646125190694*^9}, {
  3.82164928129592*^9, 
  3.8216493028835173`*^9}},ExpressionUUID->"99171a97-6230-4c8e-86cf-\
b5b4af393cb5"],

