              SuperscriptBox["2", 
               RowBox[{"\[Omega]", "+", "1"}]]]}]}]}]}], " ", "+", " ", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"j", "=", "0"}], 
           RowBox[{"b", "+", "k"}]], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SubsuperscriptBox["g", 
              RowBox[{"k", "\[InvisibleSpace]", "j"}], 
              RowBox[{"\[VeryThinSpace]", 
