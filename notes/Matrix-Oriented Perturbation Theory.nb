        RowBox[{"(", 
         RowBox[{"a", "-", 
          RowBox[{"(", 
           RowBox[{"a", "-", "2"}], ")"}], "+", 
          RowBox[{"2", "\[InvisibleSpace]", "n"}]}], ")"}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", "n", ")"}], 
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
