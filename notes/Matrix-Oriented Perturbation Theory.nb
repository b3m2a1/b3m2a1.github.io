              RowBox[{"\[Beta]", "\[VeryThinSpace]", "m"}]]}], ")"}], 
           SubscriptBox["\[Delta]", 
            RowBox[{"\[Beta]", "\[VeryThinSpace]", "n"}]]}], 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["E", "\[Beta]"], "-", 
            SubscriptBox["E", "m"]}], ")"}]], 
         SubsuperscriptBox[
          StyleBox["H",
           FontWeight->"Bold"], 
          RowBox[{"n", "\[InvisibleSpace]", "m"}], 
          RowBox[{"(", "i", ")"}]]}]}]}]}]}
