Cell[CellGroupData[{

Cell["The General Case", "Subsubsubsubsection",
 CellChangeTimes->{{3.821381896709189*^9, 
  3.821381903721862*^9}},ExpressionUUID->"3e79ff62-6f88-49dc-b5d8-\
e788db7d11b1"],

Cell[TextData[{
 "It\[CloseCurlyQuote]d be nice to have a general way to obtain results in \
the case where the first ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "86e7df68-8d31-473d-a180-4f431e7b32c5"],
 " perturbations don\[CloseCurlyQuote]t resolve the degeneracy. Our first \
approach will be in the case of no coupling. The case of degeneracies \
persisting through the perturbation will be treated later. To that effect, we \
write"
}], "ExpositoryText",
 CellChangeTimes->{{3.821381905461684*^9, 3.821381962304203*^9}, {
  3.821382060021473*^9, 
  3.821382091991364*^9}},ExpressionUUID->"53f24a41-a5e8-4b5c-9e2a-\
796f2e1dca33"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[ForAll]", 
     RowBox[{"i", " ", "\[LessEqual]", " ", "j"}]], 
    RowBox[{
     SubscriptBox["P", "D"], 
     SuperscriptBox["H", 
      RowBox[{"(", "i", ")"}]], 
     SubscriptBox["P", "D"]}]}], " ", "=", " ", "\[DoubleStruckZero]"}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821381927108597*^9, 3.821381943394247*^9}, {
