Cell[TextData[{
 "and now we\[CloseCurlyQuote]ll introduce the same set of indexing sequences \
as before, just to pick which path we take, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["S", "M"], TraditionalForm]],ExpressionUUID->
  "24004769-d3e9-4e63-a286-dc2209f2da6a"],
 " being the set of all possible sets of ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]],ExpressionUUID->
  "81665ad6-ef6f-4118-9b1c-ededde56fc22"],
 " and ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]],ExpressionUUID->
  "227bce72-754d-4299-9aeb-6276b825e267"],
 " of length ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],ExpressionUUID->
  "9c34717e-e309-4485-8a8f-3e4f928c6325"],
 ", giving us "
}], "ExpositoryText",
 CellChangeTimes->{{3.827786866623391*^9, 3.8277868747529182`*^9}, {
  3.8277869219556103`*^9, 
  3.827786945201199*^9}},ExpressionUUID->"420ceed2-8fed-45b9-8615-\
2c171234fc93"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["A", "n", 
    RowBox[{"(", "k", ")"}]], "=", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"M", "=", "1"}], "k"], " ", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{
        StyleBox["p",
         FontSize->14], "\[Element]", 
        StyleBox[
         SubsuperscriptBox["\[CapitalXi]", "k", "M"],
         FontSize->14]}]], 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{
         StyleBox["s",
          FontSize->14], "\[Element]", 
         StyleBox[
          SuperscriptBox["S", 
           RowBox[{"M", "-", "2"}]],
          FontSize->14]}]], " ", 
       RowBox[{
        RowBox[{"(", "\[VeryThinSpace]", 
         RowBox[{
          RowBox[{
           UnderoverscriptBox["\[Product]", 
            RowBox[{"i", "=", "1"}], 
            RowBox[{"M", "-", "2"}]], " ", 
           RowBox[{
            SubsuperscriptBox["\[CapitalOmega]", "n", 
             RowBox[{"(", 
              SubscriptBox["p", "i"], ")"}]], 
            SubscriptBox["\[Delta]", 
             RowBox[{
              SubscriptBox["s", "i"], "0"}]]}]}], "+", 
          RowBox[{
           FractionBox["1", 
            RowBox[{
             SubsuperscriptBox["E", "m", 
              RowBox[{"(", "0", ")"}]], "-", 
             SubsuperscriptBox["E", "n", 
              RowBox[{"(", "0", ")"}]]}]], 
           SubsuperscriptBox["\[CapitalGamma]", "n", 
            RowBox[{"(", 
             SubscriptBox["p", "i"], ")"}]], 
           SubscriptBox["\[Delta]", 
            RowBox[{
             SubscriptBox["s", "i"], "1"}]]}]}], ")"}], 
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", 
          SubscriptBox["p", 
           RowBox[{"M", "-", "1"}]], ")"}]], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", 
               SubscriptBox["p", "M"], ")"}]]}]},
         "BraKet"]}]}]}]}], " ", "+", " ", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["t",
        FontSize->14], "\[Element]", 
       StyleBox[
        SuperscriptBox["S", 
         RowBox[{"M", "-", "1"}]],
        FontSize->14]}]], " ", 
     RowBox[{
      RowBox[{"(", "\[VeryThinSpace]", 
       RowBox[{
        RowBox[{
         UnderoverscriptBox["\[Product]", 
          RowBox[{"i", "=", "1"}], 
          RowBox[{"M", "-", "1"}]], 
         RowBox[{
          SubsuperscriptBox["\[CapitalOmega]", "n", 
           RowBox[{"(", 
            SubscriptBox["p", "i"], ")"}]], 
          SubscriptBox["\[Delta]", 
           RowBox[{
            SubscriptBox["t", "i"], "0"}]]}]}], "+", 
        RowBox[{
         FractionBox["1", 
          RowBox[{
           SubsuperscriptBox["E", "m", 
            RowBox[{"(", "0", ")"}]], "-", 
           SubsuperscriptBox["E", "n", 
            RowBox[{"(", "0", ")"}]]}]], 
         SubsuperscriptBox["\[CapitalGamma]", "n", 
          RowBox[{"(", 
           SubscriptBox["p", "i"], ")"}]], 
         SubscriptBox["\[Delta]", 
          RowBox[{
           SubscriptBox["t", "i"], "1"}]]}]}], ")"}], 
      SubsuperscriptBox["\[CapitalDelta]H", "n", 
       RowBox[{"(", 
        SubscriptBox["p", "M"], ")"}]]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.827779039976139*^9, 3.827779099371428*^9}, {
