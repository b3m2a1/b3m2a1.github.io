Cell[BoxData[{
 RowBox[{"pathsNi", "//", "Clear"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pathsNi", "[", 
    RowBox[{"steps_", ",", " ", "target_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Block", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"perms", "=", 
        RowBox[{"Join", "@@", 
         RowBox[{"Permutations", "/@", 
          RowBox[{"IntegerPartitions", "[", 
           RowBox[{"target", ",", 
            RowBox[{"{", "steps", "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}]}]}]}], ",", 
       "\[IndentingNewLine]", "states", ",", "\[IndentingNewLine]", "paths"}],
       "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"states", "=", 
       RowBox[{"Accumulate", "/@", "perms"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"states", "+", 
       RowBox[{"Unitize", "[", 
        RowBox[{"perms", "-", "1"}], "]"}]}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rhoNi", "[", 
   RowBox[{"steps_", ",", " ", "target_", ",", " ", "ni_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Sum", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"2", "^", "steps"}], "]"}]}], "*", "\[IndentingNewLine]", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Times", "@@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"NumericQ", "[", "ni", "]"}], ",", " ", 
             RowBox[{"UnitStep", "[", "#", "]"}], ",", " ", "1"}], "]"}], "*",
            "#"}], ")"}]}], "&"}], "[", 
       RowBox[{"ni", "+", "p"}], "]"}], "]"}]}], ",", " ", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", 
      RowBox[{"pathsNi", "[", 
       RowBox[{"steps", ",", " ", "target"}], "]"}]}], "}"}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.812100478942655*^9, 3.8121004917186823`*^9}, {
