   3.843845255350113*^9},ExpressionUUID->"d5478723-5a51-4abe-87af-\
d12c88777fbc"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["D", "e"], TraditionalForm]],ExpressionUUID->
  "24ef1184-5458-410f-836b-4e71132659d5"],
 " is the dissociation energy and \[Alpha] is the Morse parameter. We can \
expand the potential as"
}], "ExpositoryText",
 CellChangeTimes->{{3.8438217394428587`*^9, 3.843821750573038*^9}, {
  3.8438221022503853`*^9, 3.8438221098044357`*^9}, {3.843843808687024*^9, 
