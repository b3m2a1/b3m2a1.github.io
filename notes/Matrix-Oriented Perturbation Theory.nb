Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"$ptData", "[", 
    RowBox[{"[", 
     RowBox[{"\"\<E\>\"", ",", " ", "2"}], "]"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Phi]", "[", "$ptData", "]"}], "[", "0", "]"}], ".", 
    RowBox[{
     RowBox[{"\[CapitalEta]", "[", "$ptData", "]"}], "[", "1", "]"}], ".", 
    RowBox[{
     RowBox[{"\[Phi]", "[", "$ptData", "]"}], "[", "0", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "@", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
     "figStyleText", "[", "\"\<\!\(\*SuperscriptBox[\(E\), \((1)\)]\)\>\"", 
      "]"}], ",", " ", "\[IndentingNewLine]", 
     RowBox[{"figStyleText", "@", "\"\<=\>\""}], ",", "\[IndentingNewLine]", 
     RowBox[{"pertPlot", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Phi]", "[", "$ptData", "]"}], "[", "0", "]"}], "}"}], 
      "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"pertPlot", "[", 
      RowBox[{
       RowBox[{"\[CapitalEta]", "[", "$ptData", "]"}], "[", "1", "]"}], "]"}],
      ",", "\[IndentingNewLine]", 
     RowBox[{"pertPlot", "[", 
      RowBox[{"Transpose", "@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Phi]", "[", "$ptData", "]"}], "[", "0", "]"}], "}"}]}], 
      "]"}]}], "\[IndentingNewLine]", "}"}], "\[IndentingNewLine]", 
   "}"}]}]}], "Input",
