      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "1", ")"}]]},
         "Bra"], 
        SuperscriptBox["A", 
         RowBox[{"(", "0", ")"}]], 
        TemplateBox[{
          SuperscriptBox["m", 
