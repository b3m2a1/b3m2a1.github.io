  3.8894489839764633`*^9}},ExpressionUUID->"35717e56-e255-4bf8-8ec8-\
54d427095187"],

Cell[TextData[{
 "Finally, we need to express all the ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "4e0c9cc5-564a-48f7-8b06-9a2284cd1cc2"],
 " terms as ",
