  3.821739820254663*^9, 
  3.821739820746167*^9}},ExpressionUUID->"55b8f7a4-d901-4bc8-b88b-\
e3e0fbb293fc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pertH2", "=", 
   RowBox[{
    RowBox[{"\[ScriptCapitalP]", "[", "\[ScriptCapitalD]", "]"}], "**", 
    RowBox[{"Dot", "[", "\[IndentingNewLine]", 
     RowBox[{
     "\[ScriptCapitalP]\[ScriptR]\[ScriptCapitalG]", ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalEta]", "[", "$dD", "]"}], "[", "2", "]"}], " ", "-",
        " ", 
       RowBox[{"Dot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[CapitalEta]", "[", "$dD", "]"}], "[", "1", "]"}], ",", 
         " ", 
         RowBox[{
          RowBox[{"\[CapitalPi]", "[", "$dD", "]"}], "[", 
          RowBox[{"\[ScriptCapitalU]", ",", " ", "0"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"\[CapitalEta]", "[", "$dD", "]"}], "[", "1", "]"}]}], 
        "]"}]}], ",", "\[IndentingNewLine]", 
      "\[ScriptCapitalP]\[ScriptR]\[ScriptCapitalG]"}], "\[IndentingNewLine]",
      "]"}], "**", 
    RowBox[{"\[ScriptCapitalP]", "[", "\[ScriptCapitalD]", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"pixelsPerState", "=", "40"}], "}"}], ",", "\[IndentingNewLine]", 
   
   RowBox[{"pertPlot", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[ScriptCapitalP]", "[", "\[ScriptCapitalD]", "]"}], "**", 
     RowBox[{"Dot", "[", "\[IndentingNewLine]", 
      RowBox[{
      "\[ScriptCapitalP]\[ScriptR]\[ScriptCapitalG]", ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"\[CapitalEta]", "[", "$dD", "]"}], "[", "2", "]"}], " ", 
        "-", " ", 
        RowBox[{"Dot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\[CapitalEta]", "[", "$dD", "]"}], "[", "1", "]"}], ",", 
          " ", 
          RowBox[{
           RowBox[{"\[CapitalPi]", "[", "$dD", "]"}], "[", 
           RowBox[{"\[ScriptCapitalU]", ",", " ", "0"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"\[CapitalEta]", "[", "$dD", "]"}], "[", "1", "]"}]}], 
         "]"}]}], ",", "\[IndentingNewLine]", 
       "\[ScriptCapitalP]\[ScriptR]\[ScriptCapitalG]"}], 
      "\[IndentingNewLine]", "]"}], "**", 
     RowBox[{"\[ScriptCapitalP]", "[", "\[ScriptCapitalD]", "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.821737183484561*^9, 3.8217372024195843`*^9}, {
  3.821737259844573*^9, 3.821737296349181*^9}, {3.821737364788685*^9, 
  3.8217373660393753`*^9}, {3.821737407908723*^9, 3.821737418818762*^9}, {
  3.821737494284*^9, 3.821737532033924*^9}, {3.821737565502555*^9, 
  3.821737577021926*^9}, {3.8217380050125103`*^9, 3.821738020758666*^9}, {
