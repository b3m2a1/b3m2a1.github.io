Cell["or the other way around", "ExpositoryText",
 CellChangeTimes->{{3.83298342222831*^9, 
  3.8329834269134893`*^9}},ExpressionUUID->"4b0db371-1dcd-4677-b561-\
a8cf4d83700c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["A", 
     RowBox[{"i", "\[Rule]", "j"}]], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "\[RightAngleBracket]"}], 
    "B"}], " ", "=", " ", 
   TagBox[GridBox[{
      {"\[Piecewise]", GridBox[{
         {
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"A", 
             RowBox[{"\[LeftAngleBracket]", 
              RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], 
              "\[RightAngleBracket]"}], "B"}], ")"}], 
           StyleBox[
            RowBox[{"i", "\[Rule]", "j"}],
            FontSize->14]], 
          RowBox[{"\[Alpha]", ">", "j"}]},
         {
          RowBox[{"A", 
           RowBox[{"\[LeftAngleBracket]", 
            RowBox[{"i", ",", " ", "\[Beta]"}], "\[RightAngleBracket]"}], 
           "B"}], 
          RowBox[{"\[Alpha]", "=", "j"}]},
         {
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"A", 
             RowBox[{"\[LeftAngleBracket]", 
              RowBox[{
               RowBox[{"\[Alpha]", "+", "1"}], ",", " ", "\[Beta]"}], 
              "\[RightAngleBracket]"}], "B"}], ")"}], 
           StyleBox[
            RowBox[{"i", "\[Rule]", 
             RowBox[{"j", "-", "1"}]}],
            FontSize->14]], 
          RowBox[{"\[Alpha]", "\[GreaterEqual]", "i"}]},
         {
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"A", 
             RowBox[{"\[LeftAngleBracket]", 
              RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], 
              "\[RightAngleBracket]"}], "B"}], ")"}], 
           StyleBox[
            RowBox[{
             RowBox[{"i", "-", "1"}], "\[Rule]", 
             RowBox[{"j", "-", "1"}]}],
            FontSize->14]], 
          RowBox[{"\[Alpha]", "<", "i"}]}
        },
        AllowedDimensions->{2, Automatic},
        Editable->True,
        GridBoxAlignment->{
         "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
