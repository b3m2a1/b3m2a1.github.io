Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SuperscriptBox["S", 
        RowBox[{"(", 
         RowBox[{"k", "+", "i"}], ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], " ", "=", " ", 
      RowBox[{
       FractionBox["1", "\[CapitalDelta]E"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SuperscriptBox["S", 
        RowBox[{"(", "k", ")"}]], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", "i", ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SuperscriptBox["R", 
        RowBox[{"(", 
         RowBox[{"j", "+", "i"}], ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "\[CapitalDelta]E"]}], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SubsuperscriptBox["\[CapitalDelta]H", "m", 
        RowBox[{"(", "i", ")"}]], 
       SuperscriptBox["R", 
        RowBox[{"(", "j", ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.888232869585019*^9, 3.888232917029991*^9}, 
   3.8882344224799423`*^9, {3.888235503559564*^9, 
   3.888235513096128*^9}},ExpressionUUID->"e96f04a5-35d5-4469-bd1b-\
26e3c7065b2f"],

Cell["\<\
but even then, these will simply partially cancel with terms generated by \
other sequences\
\>", "ExpositoryText",
 CellChangeTimes->{{3.888235514664448*^9, 
  3.888235566990624*^9}},ExpressionUUID->"efce7690-8ce0-43e4-9a48-\
4e15824c5588"],

Cell[TextData[{
 "Next, we note that this occurs for every order ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "4a65a52f-8da0-492a-9092-833b5e5031b9"],
 " and every possible sequence ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["S", 
    RowBox[{"(", "k", ")"}]], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "366a77e3-48ed-478d-981d-e333c1df4b8f"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["R", 
    RowBox[{"(", "j", ")"}]], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "9bda45db-82eb-4d2c-bdfd-f80b2d551fc1"],
 ", meaning we end up with"
}], "ExpositoryText",
 CellChangeTimes->{{3.888235571915435*^9, 
  3.888235602338928*^9}},ExpressionUUID->"5c46fff6-a524-4521-bd81-\
6e1d949b83aa"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    TemplateBox[{
      RowBox[{"n", "\[ThinSpace]"}], 
      RowBox[{" ", "m"}]},
     "BraKet"], 
    RowBox[{"(", "k", ")"}]], " ", "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"j", "=", "1"}], "k"], " ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], 
      RowBox[{"k", "-", "j"}]], " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["E", "n", 
         RowBox[{"(", "j", ")"}]], "-", 
        SubsuperscriptBox["E", "m", 
         RowBox[{"(", "j", ")"}]]}], ")"}], " \[VeryThinSpace]", 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{"s", "\[Element]", 
         RowBox[{"P", "(", 
          RowBox[{"k", "-", "i", "-", "j"}], ")"}]}]], 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"r", "\[Element]", 
          RowBox[{"P", "(", "i", ")"}]}]], " ", 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], " ", 
         RowBox[{"(", 
          RowBox[{
           UnderscriptBox["\[Product]", 
            RowBox[{
             SubscriptBox["s", "a"], "\[Element]", "s"}]], 
           RowBox[{
            SubsuperscriptBox["\[CapitalDelta]H", "n", 
             RowBox[{"(", 
              SubscriptBox["s", "a"], ")"}]], 
            SubscriptBox["\[CapitalPi]", "n"]}]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           UnderscriptBox["\[Product]", 
            RowBox[{
             SubscriptBox["r", "b"], "\[Element]", "r"}]], 
           RowBox[{
            SubscriptBox["\[CapitalPi]", "m"], 
            SubsuperscriptBox["\[CapitalDelta]H", "m", 
             RowBox[{"(", 
              SubscriptBox["r", "b"], ")"}]]}]}], ")"}], 
         TemplateBox[{
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"]}]}]}]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.888228501354525*^9, 3.8882287022394037`*^9}, {
  3.888235625954693*^9, 3.88823568485336*^9}, {3.888235747934779*^9, 
  3.888235816111305*^9}},ExpressionUUID->"2e40494f-f398-4236-9e2a-\
16dc7142f5d8"],

Cell[TextData[{
 "but that inner loop is the same as ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    TemplateBox[{
      RowBox[{"n", "\[ThinSpace]"}], 
      RowBox[{" ", "m"}]},
     "BraKet"], 
    RowBox[{"(", "j", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.888228501354525*^9, 3.8882287022394037`*^9}, {
   3.888235625954693*^9, 3.88823568485336*^9}, {3.888235747934779*^9, 
   3.888235816111305*^9}},ExpressionUUID->
  "572ddd1f-0413-4e64-859a-34caeadeb24d"],
 " meaning at the end of the day we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.888235827946253*^9, 
  3.888235862614396*^9}},ExpressionUUID->"91b46773-c690-40a5-a7ea-\
913560a60a75"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    TemplateBox[{
      RowBox[{"n", "\[VeryThinSpace]\[VeryThinSpace]\[VeryThinSpace]"}], 
      RowBox[{" \[VeryThinSpace]", "m", "\[VeryThinSpace]"}]},
     "BraKet"], 
    RowBox[{"(", "k", ")"}]], " ", "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], "k"], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["E", "n", 
        RowBox[{"(", "i", ")"}]], "-", 
       SubsuperscriptBox["E", "m", 
        RowBox[{"(", "i", ")"}]]}], ")"}], 
     SuperscriptBox[
      TemplateBox[{
        RowBox[{"n", "\[VeryThinSpace]\[VeryThinSpace]\[VeryThinSpace]"}], 
        RowBox[{" \[VeryThinSpace]", "m", "\[VeryThinSpace]"}]},
       "BraKet"], 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8882330188566103`*^9, 3.888233107929144*^9}, 
   3.888235877370286*^9},ExpressionUUID->"eadad8eb-bd0f-4970-adb8-\
5d43f30494a6"],

Cell[TextData[{
 "and if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     TemplateBox[{
       RowBox[{"n", "\[VeryThinSpace]\[VeryThinSpace]\[VeryThinSpace]"}], 
       RowBox[{" \[VeryThinSpace]", "m", "\[VeryThinSpace]"}]},
      "BraKet"], 
     RowBox[{"(", 
      RowBox[{"k", "\[Minus]", "i"}], ")"}]], " ", "=", " ", "0"}], 
   TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "a328408f-9bab-4293-a33e-e76ac638534f"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", ">", "0"}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "45ed8d83-e5cd-4502-8412-39fa66814ad7"],
 ", inductively "
}], "ExpositoryText",
 CellChangeTimes->{{3.888235864968485*^9, 
  3.888235908199111*^9}},ExpressionUUID->"77213769-8310-4d79-9e0b-\
7047b4a2170f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    TemplateBox[{
      RowBox[{"n", "\[VeryThinSpace]\[VeryThinSpace]\[VeryThinSpace]"}], 
      RowBox[{" \[VeryThinSpace]", "m", "\[VeryThinSpace]"}]},
     "BraKet"], 
    RowBox[{"(", "k", ")"}]], " ", "=", " ", "0"}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8882359104781*^9, 
  3.888235911995112*^9}},ExpressionUUID->"f3d20fb7-c29b-49cd-9124-\
5eb066ecd4c0"]
}, Closed]],

