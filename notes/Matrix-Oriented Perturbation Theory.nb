     RowBox[{
      RowBox[{"momC", "[", 
       RowBox[{"k", ",", " ", "a", ",", " ", "b"}], "]"}], "=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], 
          RowBox[{"a", "-", "i"}]], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"momC", "[", 
            RowBox[{"k", ",", " ", "i", ",", " ", 
             RowBox[{"b", "-", "1"}]}], "]"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"i", "-", "k", "+", "1"}], ")"}], "*", 
            RowBox[{"momC", "[", 
             RowBox[{
              RowBox[{"k", "-", "1"}], ",", " ", "i", ",", " ", 
              RowBox[{"b", "-", "1"}]}], "]"}]}]}], ")"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "0", ",", " ", "a"}], "}"}]}], "]"}]}]}], 
