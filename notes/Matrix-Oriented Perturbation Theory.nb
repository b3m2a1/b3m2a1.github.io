Cell[TextData[{
 "Cool. And from this we can see that at order 1 we don\[CloseCurlyQuote]t \
need terms involving ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "+", "1"}], TraditionalForm]],ExpressionUUID->
  "7ec85aa9-a582-4f7c-b785-ea5391e06864"],
 ". So we\[CloseCurlyQuote]ll assume that up to order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "-", "1"}], TraditionalForm]],ExpressionUUID->
  "eb21e8c5-a144-4a84-b267-16e77f9519ed"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ForAll]", "i"], " ", 
    SubsuperscriptBox["J", 
     RowBox[{"a", "-", "1"}], 
     RowBox[{"(", 
      RowBox[{"k", ",", "i"}], ")"}]]}], TraditionalForm]],ExpressionUUID->
  "1eebceaf-f727-4766-bd5e-4730288a09d9"],
 " doesn\[CloseCurlyQuote]t require terms involving ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "+", "a", "-", "1"}], TraditionalForm]],ExpressionUUID->
  "8b377a0f-89fc-4f76-b789-6fd26e5e228a"],
 ". Then at order ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "a846a69f-ffea-42b8-a588-66d9d3cec20f"],
 " we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.825821922893005*^9, 
  3.825822107334032*^9}},ExpressionUUID->"dacf5cc8-9599-4e6d-be43-\
2cc371260c5c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["J", "a", 
    RowBox[{"(", 
     RowBox[{"k", "-", "i"}], ")"}]], "=", 
   RowBox[{
    SubsuperscriptBox["J", 
     RowBox[{"a", "-", "1"}], 
     RowBox[{"(", 
      RowBox[{"k", "+", "1", "-", "i"}], ")"}]], "+", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"b", "=", "0"}], 
      RowBox[{"a", "-", "1"}]], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["\[CapitalDelta]H", 
         RowBox[{"(", "a", ")"}]], "+", 
        SubsuperscriptBox["J", 
         RowBox[{"a", "-", "1"}], 
         RowBox[{"(", "1", ")"}]]}], ")"}], 
      RowBox[{
       SubsuperscriptBox["\[CapitalPi]", "U", 
        RowBox[{"(", "b", ")"}]], "(", 
       RowBox[{
        SuperscriptBox["\[CapitalDelta]H", 
         RowBox[{"(", 
          RowBox[{"k", "+", "b", "-", "i"}], ")"}]], "+", 
        SubsuperscriptBox["J", "b", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]]}], ")"}]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825822108129904*^9, 3.825822108674412*^9}, {
  3.826912166328459*^9, 3.82691218481277*^9}, {3.826915840435149*^9, 
  3.826915871652199*^9}},ExpressionUUID->"24225615-0d29-41a7-9991-\
6bf79e35e7ce"],

Cell[TextData[{
 "and clearly since we are only allowing ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "8610fa8f-d7d8-4649-88e0-b91e564a26b9"],
 " to go to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "-", "1"}], TraditionalForm]],ExpressionUUID->
  "3704487b-f3aa-459b-9da0-6c533bfe2841"],
 ", the only terms here that can involve ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "+", "a"}], TraditionalForm]],ExpressionUUID->
  "0d58940f-287d-4663-a5a0-a8d375346cc4"],
 " come from the terms looking like ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["J", 
    RowBox[{"a", "-", "1"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"k", "+", "1"}], ",", "i"}], ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.825822108129904*^9, 3.825822108674412*^9}},
  ExpressionUUID->"e71eeef3-e960-46f1-99f1-f32d2a7cb825"],
 ". Inductively, though, we said ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["J", 
    RowBox[{"a", "-", "1"}], 
    RowBox[{"(", 
     RowBox[{"k", ",", "i"}], ")"}]], TraditionalForm]],ExpressionUUID->
  "a612e1b4-e405-487d-acc0-3d2e83539e81"],
 " doesn\[CloseCurlyQuote]t require terms involving ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "+", "a", "-", "1"}], TraditionalForm]],ExpressionUUID->
  "28c47450-422f-40ca-b3b8-0aab8d09287a"],
 ", so ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["J", 
    RowBox[{"a", "-", "1"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"k", "+", "1"}], ",", "i"}], ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.825822108129904*^9, 3.825822108674412*^9}},
  ExpressionUUID->"510ab888-c376-4cbc-8b54-5b148daf86d4"],
 " cannot require terms involving  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "+", "a"}], TraditionalForm]],ExpressionUUID->
  "07da3acb-a0a5-4fad-bb84-a50de4f18707"],
 ". Kinda a dumb proof, but a necessary one."
}], "ExpositoryText",
 CellChangeTimes->{{3.825822120168766*^9, 
  3.825822239673109*^9}},ExpressionUUID->"5836ca46-89ad-4c85-bc89-\
31cfd69f9264"],

Cell["Therefore!", "ExpositoryText",
 CellChangeTimes->{{3.8258222446044607`*^9, 
  3.8258222461529837`*^9}},ExpressionUUID->"04153009-b2b0-4a10-929d-\
b138ef89685a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["E", 
    RowBox[{"(", 
     RowBox[{"k", "+", "a"}], ")"}]], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], " ", 
     SuperscriptBox["H", 
      RowBox[{"(", 
       RowBox[{"k", "+", "a"}], ")"}]]}], "+", 
    RowBox[{
     SubsuperscriptBox["J", "a", 
      RowBox[{"(", "k", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], 
      RowBox[{"k", "-", "1"}]], 
     RowBox[{
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]]},
       "Bra"], " ", 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["J", "a", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], "+", 
        SuperscriptBox["\[CapitalDelta]H", 
         RowBox[{"(", 
          RowBox[{"k", "+", "a", "-", "i"}], ")"}]]}], ")"}], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.82582080808532*^9, 3.825820816415576*^9}, {
  3.825821174266798*^9, 3.82582117970197*^9}, {3.82691582595401*^9, 
  3.8269158301188173`*^9}},ExpressionUUID->"dec790b1-9848-44ce-8a70-\
4f7d1441dd1d"],

Cell["and we can be sure this is possible to evaluate", "ExpositoryText",
 CellChangeTimes->{{3.825822256189999*^9, 
  3.825822262464432*^9}},ExpressionUUID->"4c27ef32-e235-4382-9515-\
1cc82d8ef23a"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Nearly-Degenerate Error Analysis", "Subsubsection",
 CellChangeTimes->{{3.826645326663252*^9, 
  3.826645335125401*^9}},ExpressionUUID->"41c444a5-737a-42c2-9a5c-\
fe235cfc1ee5"],

Cell[CellGroupData[{

Cell["Setup", "Subsubsubsection",
 CellChangeTimes->{{3.826911379152608*^9, 
  3.8269113801447153`*^9}},ExpressionUUID->"9458cbb1-5c07-45a7-a626-\
15f037009f23"],

Cell[TextData[{
 "This is formally only correct when we have ",
 StyleBox["true",
  FontSlant->"Italic"],
 " degeneracies, that is when a set of states have ",
 StyleBox["exactly",
  FontSlant->"Italic"],
 " the same energy and thus may be factored out. We now consider the \
magnitude of the error induced by ",
 StyleBox["approximating",
  FontSlant->"Italic"],
 " nearly-degenerate states as truly degenerate. To start, we will assume \
there is some energy window ",
 Cell[BoxData[
  FormBox["\[Delta]E", TraditionalForm]],ExpressionUUID->
  "2f562334-3a57-43b5-a9d7-1b7f20ffaaa2"],
 " and given a target zero-order state ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "964281cd-6cd3-49e7-8784-e102adaa4cb5"],
 " we will say that any state ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["m", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "154d6cda-44e1-49b7-9503-a1a4a5d577e6"],
 " such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     RowBox[{
      SubsuperscriptBox["E", "n", 
       RowBox[{"(", "0", ")"}]], "-", 
      SubsuperscriptBox["E", "m", 
       RowBox[{"(", "0", ")"}]]}], "\[RightBracketingBar]"}], " ", "<", " ", 
    "\[Delta]E"}], TraditionalForm]],ExpressionUUID->
  "1579313e-346c-4ba3-b913-056b8fe25fa4"],
 " is degenerate with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "7508d81e-01b6-469b-abd9-c4ba70f06165"],
 "."
}], "ExpositoryText",
 CellChangeTimes->{{3.826645336188217*^9, 
  3.826645548729568*^9}},ExpressionUUID->"ab170f05-0387-4d20-953f-\
a0dcd9f50fe7"],

Cell["\<\
We will then note that we made use of the degeneracy in our inductive proof \
when we wrote\
\>", "ExpositoryText",
 CellChangeTimes->{{3.826645569756824*^9, 
  3.826645585694665*^9}},ExpressionUUID->"2e42a582-27e9-46b1-90a8-\
08e68f35612d"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["P", "D", 
        RowBox[{"(", 
         RowBox[{"a", "+", "1"}], ")"}]], 
       SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
        RowBox[{"(", "a", ")"}]], 
       SubsuperscriptBox["P", "D", 
        RowBox[{"(", "a", ")"}]]}], "=", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["P", "D", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]], 
        SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
         RowBox[{"(", "a", ")"}]], 
        SubsuperscriptBox["P", "D", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]]}], "+", 
       RowBox[{
        SubsuperscriptBox["P", "D", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]], 
        SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
         RowBox[{"(", "a", ")"}]], 
        SubsuperscriptBox["P", "U", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       SubsuperscriptBox["P", "D", 
        RowBox[{"(", 
         RowBox[{"a", "+", "1"}], ")"}]], 
       SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
        RowBox[{"(", "a", ")"}]], 
       SubsuperscriptBox["P", "D", 
        RowBox[{"(", 
         RowBox[{"a", "+", "1"}], ")"}]]}]}]},
    {
     RowBox[{"=", "\[DoubleStruckZero]"}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8266455869648952`*^9, 
  3.8266457065268993`*^9}},ExpressionUUID->"088f5009-cf80-41eb-a191-\
d88dd8c2ed04"],

Cell["this hinges on expressing the operator as ", "ExpositoryText",
 CellChangeTimes->{{3.826645712035433*^9, 3.826645712509356*^9}, {
  3.826645807080474*^9, 
  3.82664581973582*^9}},ExpressionUUID->"7a76e1ca-e707-4f4f-b2ef-\
90e271c48997"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
    RowBox[{"(", "a", ")"}]], "=", 
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"d", "\[Element]", 
       SuperscriptBox["D", 
        RowBox[{"(", 
         RowBox[{"a", "+", "1"}], ")"}]]}]], 
     RowBox[{
      SubsuperscriptBox["E", "d", 
       RowBox[{"(", "a", ")"}]], 
      TemplateBox[{
        SuperscriptBox["d", 
         RowBox[{"(", "0", ")"}]]},
       "Ket"], 
      TemplateBox[{
        SuperscriptBox["d", 
         RowBox[{"(", "0", ")"}]]},
       "Bra"]}]}], "-", 
    SubsuperscriptBox["E", "\[Eta]", 
     RowBox[{"(", "a", ")"}]]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.826645820853992*^9, 
  3.826645888481329*^9}},ExpressionUUID->"3830873b-1cd3-44f3-bcb1-\
b76f10165193"],

Cell["and by the definition of degeneracy", "ExpositoryText",
 CellChangeTimes->{{3.826645900200466*^9, 
  3.826645921120955*^9}},ExpressionUUID->"0ad233ac-ae3b-4f5f-bd00-\
f8c8dc93a7f4"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
       RowBox[{"(", "a", ")"}]], "=", 
      RowBox[{
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"d", "\[Element]", 
          SuperscriptBox["D", 
           RowBox[{"(", 
            RowBox[{"a", "+", "1"}], ")"}]]}]], 
        RowBox[{
         SubsuperscriptBox["E", "\[Eta]", 
          RowBox[{"(", "a", ")"}]], 
         TemplateBox[{
           SuperscriptBox["d", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"], 
         TemplateBox[{
           SuperscriptBox["d", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"]}]}], "-", 
       SubsuperscriptBox["E", "\[Eta]", 
        RowBox[{"(", "a", ")"}]]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       SubsuperscriptBox["E", "\[Eta]", 
        RowBox[{"(", "a", ")"}]], "(", 
       RowBox[{
        SubsuperscriptBox["P", "D", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]], "-", "I"}], ")"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826645820853992*^9, 3.826645888481329*^9}, {
  3.826645998470475*^9, 
  3.8266460414730663`*^9}},ExpressionUUID->"988c3984-de72-4e88-973f-\
1584bfa755c7"],

Cell[TextData[{
 "so the scale of the error we make in the ",
 StyleBox["nearly-degenerate",
  FontSlant->"Italic"],
 " case is proportional to the error induced by assuming ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["E", "d", 
     RowBox[{"(", "a", ")"}]], "=", 
    SubsuperscriptBox["E", "\[Eta]", 
     RowBox[{"(", "a", ")"}]]}], TraditionalForm]],ExpressionUUID->
  "9be721ec-e4bb-41f8-b3d8-b2d0c85e7dbe"],
 " for all ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", " ", "\[Element]", " ", 
    SuperscriptBox["D", 
     RowBox[{"(", 
      RowBox[{"a", "+", "1"}], ")"}]]}], TraditionalForm]],ExpressionUUID->
  "2be35796-1295-400a-ae1e-4a0a5368760d"],
 ", that is our error can be bounded at the 2-norm level by"
}], "ExpositoryText",
 CellChangeTimes->{{3.82664605453197*^9, 3.826646106797201*^9}, {
  3.826647201987509*^9, 3.826647216250828*^9}, {3.8266473528369083`*^9, 
  3.826647383250369*^9}},ExpressionUUID->"1185e6a1-5203-40d3-ae7f-\
0e04a78f3e39"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"\[LeftBracketingBar]", 
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          UnderscriptBox["\[Sum]", 
           RowBox[{"d", "\[Element]", 
            SuperscriptBox["D", 
             RowBox[{"(", 
              RowBox[{"a", "+", "1"}], ")"}]]}]], 
          RowBox[{
           SubsuperscriptBox["E", "d", 
            RowBox[{"(", "a", ")"}]], 
           TemplateBox[{
             SuperscriptBox["d", 
              RowBox[{"(", "0", ")"}]]},
            "Ket"], 
           TemplateBox[{
             SuperscriptBox["d", 
              RowBox[{"(", "0", ")"}]]},
            "Bra"]}]}], "-", 
         SubsuperscriptBox["E", "\[Eta]", 
          RowBox[{"(", "a", ")"}]]}], ")"}], " ", "-", " ", 
       RowBox[{"(", " ", 
        RowBox[{
         RowBox[{
          UnderscriptBox["\[Sum]", 
           RowBox[{"d", "\[Element]", 
            SuperscriptBox["D", 
             RowBox[{"(", 
              RowBox[{"a", "+", "1"}], ")"}]]}]], 
          RowBox[{
           SubsuperscriptBox["E", "d", 
            RowBox[{"(", "a", ")"}]], 
           TemplateBox[{
             SuperscriptBox["d", 
              RowBox[{"(", "0", ")"}]]},
            "Ket"], 
           TemplateBox[{
             SuperscriptBox["d", 
              RowBox[{"(", "0", ")"}]]},
            "Bra"]}]}], " ", "-", " ", 
         SubsuperscriptBox["E", "\[Eta]", 
          RowBox[{"(", "a", ")"}]]}], ")"}]}], "\[RightBracketingBar]"}], 
     "\[RightBracketingBar]"}], "2"], " ", "\[LessEqual]", " ", 
   RowBox[{"\[Delta]E", " ", 
    SubscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{"\[LeftBracketingBar]", 
       SubsuperscriptBox["P", "D", 
        RowBox[{"(", 
         RowBox[{"a", "+", "1"}], ")"}]], "\[RightBracketingBar]"}], 
      "\[RightBracketingBar]"}], "2"]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8266472219837313`*^9, 3.826647286575328*^9}, {
  3.826647355525934*^9, 3.826647370609181*^9}, {3.82664741012954*^9, 
  3.82664741874015*^9}},ExpressionUUID->"b8f269b2-b727-4c9b-8b3b-\
c253ce5017d6"],

Cell["this also appeared when we wrote", "ExpositoryText",
 CellChangeTimes->{{3.826648006144154*^9, 
  3.826648016653647*^9}},ExpressionUUID->"e1a9d2ca-2bf2-4f39-b82a-\
5d1a291b2e66"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     SubsuperscriptBox["P", "D", 
      RowBox[{"(", "a", ")"}]]}], 
    SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
     RowBox[{"(", "a", ")"}]], 
    SubsuperscriptBox["P", "D", 
     RowBox[{"(", "a", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{"-", 
     SubsuperscriptBox["P", "U", 
      RowBox[{"(", 
       RowBox[{"a", "+", "1"}], ")"}]]}], 
    SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
     RowBox[{"(", "a", ")"}]], 
    SubsuperscriptBox["P", "U", 
     RowBox[{"(", 
      RowBox[{"a", "+", "1"}], ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.82664801828262*^9, 
  3.826648040301867*^9}},ExpressionUUID->"57bfce13-129d-4097-b824-\
7953ff69b3c3"],

Cell["where in the nearly-degenerate context we instead get", "ExpositoryText",
 CellChangeTimes->{{3.826648026704093*^9, 
  3.8266480632876883`*^9}},ExpressionUUID->"b13337c1-00c3-4a38-ab3b-\
ea8147fa9f14"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     SubsuperscriptBox["P", "D", 
      RowBox[{"(", "a", ")"}]]}], 
    SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
     RowBox[{"(", "a", ")"}]], 
    SubsuperscriptBox["P", "D", 
     RowBox[{"(", "a", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      SubsuperscriptBox["P", "U", 
       RowBox[{"(", 
        RowBox[{"a", "+", "1"}], ")"}]]}], 
     SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
      RowBox[{"(", "a", ")"}]], 
     SubsuperscriptBox["P", "U", 
      RowBox[{"(", 
       RowBox[{"a", "+", "1"}], ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "k", ")"}]]},
      "Ket"]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"-", 
      SubsuperscriptBox["P", "D", 
       RowBox[{"(", 
        RowBox[{"a", "+", "1"}], ")"}]]}], 
     SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
      RowBox[{"(", "a", ")"}]], 
     SubsuperscriptBox["P", "D", 
      RowBox[{"(", 
       RowBox[{"a", "+", "1"}], ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "k", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.82664801828262*^9, 
  3.826648076067114*^9}},ExpressionUUID->"186548d3-e361-4a0b-a742-\
ca8ae6834cc3"],

Cell["\<\
and here we can apply the same type of error bound, but more relevant is the \
fact that we wrote\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8266480926985493`*^9, 3.826648152653922*^9}, 
   3.826648353761209*^9, {3.8266485062169847`*^9, 3.826648523676763*^9}, {
   3.826648624620449*^9, 
   3.826648625161736*^9}},ExpressionUUID->"9f2b4fb0-6995-43d3-b26f-\
ff6b114907a3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["P", "U", 
     RowBox[{"(", 
      RowBox[{"a", "+", "1"}], ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    SubsuperscriptBox["\[CapitalPi]", "U", 
     RowBox[{"(", "a", ")"}]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], 
      RowBox[{"k", "-", "1"}]], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["J", "a", 
         RowBox[{"(", 
          RowBox[{"k", ",", "i"}], ")"}]], "+", 
        SuperscriptBox["\[CapitalDelta]H", 
         RowBox[{"(", 
          RowBox[{"k", "+", "a", "-", "i"}], ")"}]]}], ")"}], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8266486094750547`*^9, 
  3.826648616362227*^9}},ExpressionUUID->"b3a4ce38-3912-4880-9ef0-\
33f1c07697d4"],

Cell["we instead should formally have written", "ExpositoryText",
 CellChangeTimes->{{3.8266486273721857`*^9, 
  3.826648637031047*^9}},ExpressionUUID->"a25b6552-1539-4692-a829-\
5ada3fd18065"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["P", "U", 
     RowBox[{"(", 
      RowBox[{"a", "+", "1"}], ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[CapitalPi]", "U", 
      RowBox[{"(", "a", ")"}]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "0"}], 
       RowBox[{"k", "-", "1"}]], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["J", "a", 
          RowBox[{"(", 
           RowBox[{"k", ",", "i"}], ")"}]], "+", 
         SuperscriptBox["\[CapitalDelta]H", 
          RowBox[{"(", 
           RowBox[{"k", "+", "a", "-", "i"}], ")"}]]}], ")"}], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]]},
        "Ket"]}]}]}], " ", "+", " ", 
    RowBox[{
     SubsuperscriptBox["\[CapitalPi]", "U", 
      RowBox[{"(", "a", ")"}]], 
     SubsuperscriptBox["P", "D", 
      RowBox[{"(", 
       RowBox[{"a", "+", "1"}], ")"}]], 
     SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
      RowBox[{"(", "a", ")"}]], 
     SubsuperscriptBox["P", "D", 
      RowBox[{"(", 
       RowBox[{"a", "+", "1"}], ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "k", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8266486094750547`*^9, 3.826648616362227*^9}, {
  3.826648647087996*^9, 
  3.826648654717864*^9}},ExpressionUUID->"725bb09b-5b90-4c01-a3f4-\
c7c6fe1f8685"],

Cell[TextData[{
 StyleBox["but",
  FontSlant->"Italic"],
 " by projection operator relations, this reduces to the original case, \
showing that no ",
 StyleBox["additional",
  FontSlant->"Italic"],
 " error is introduced by using the nearly-degenerate approximation here."
}], "ExpositoryText",
 CellChangeTimes->{{3.8266486587222137`*^9, 
  3.8266487149909697`*^9}},ExpressionUUID->"88b13e25-c406-40a3-b266-\
11c58d43e2ce"],

Cell[TextData[{
 "This means the overall error we introduce comes ",
 StyleBox["solely",
  FontSlant->"Italic"],
 " from the first type of error and in particular, it comes when we write"
}], "ExpositoryText",
 CellChangeTimes->{{3.826649516629328*^9, 3.826649539035495*^9}, {
  3.82664960670614*^9, 
  3.826649616768365*^9}},ExpressionUUID->"e57655ec-4362-4a2e-9a42-\
4808cdab36fa"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["P", "D", 
     RowBox[{"(", 
      RowBox[{"a", "+", "1"}], ")"}]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "0"}], "a"], 
     RowBox[{
      SuperscriptBox["\[CapitalDelta]H", 
       RowBox[{"(", 
        RowBox[{"a", "-", "i"}], ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", 
           RowBox[{"k", "+", "1", "+", "j"}], ")"}]]},
       "Ket"]}]}]}], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["P", "D", 
      RowBox[{"(", 
       RowBox[{"a", "+", "1"}], ")"}]], 
     SubsuperscriptBox["J", "a", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k", "+", "1"}], ",", "k"}], ")"}]], 
     SubsuperscriptBox["P", "D", 
      RowBox[{"(", 
       RowBox[{"a", "+", "1"}], ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "k", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     SubscriptBox["P", 
      SuperscriptBox["D", 
       RowBox[{"(", "a", ")"}]]], 
     SubsuperscriptBox["J", "a", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k", "+", "1"}], ",", "k"}], ")"}]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"b", "=", "0"}], "a"], 
      RowBox[{
       SubsuperscriptBox["P", "U", 
        RowBox[{"(", "b", ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Ket"]}]}]}], "+", 
    RowBox[{
     SubsuperscriptBox["P", "D", 
      RowBox[{"(", 
       RowBox[{"a", "+", "1"}], ")"}]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "0"}], 
       RowBox[{"k", "-", "1"}]], 
      RowBox[{
       SubsuperscriptBox["J", "a", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"k", "+", "1"}], ",", "i"}], ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]]},
        "Ket"]}]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825818092135582*^9, 3.825818173142982*^9}, {
  3.8266497074019413`*^9, 
  3.8266497439070387`*^9}},ExpressionUUID->"24332275-c14f-4bdf-908b-\
4eeacc25f2cd"],

Cell["where more accurately this should have been", "ExpositoryText",
 CellChangeTimes->{{3.826649976385723*^9, 
  3.826649983726878*^9}},ExpressionUUID->"23e6fd09-06fc-4b65-9cfb-\
326c24c27f6b"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["P", "D", 
        RowBox[{"(", 
         RowBox[{"a", "+", "1"}], ")"}]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], "a"], 
        RowBox[{
         SuperscriptBox["\[CapitalDelta]H", 
          RowBox[{"(", 
           RowBox[{"a", "-", "i"}], ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", 
              RowBox[{"k", "+", "1", "+", "j"}], ")"}]]},
          "Ket"]}]}]}], "=", "\[AlignmentMarker]", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["P", "D", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]], 
        SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
         RowBox[{"(", "a", ")"}]], 
        SubsuperscriptBox["P", "D", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", 
             RowBox[{"k", "+", "1"}], ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        SubsuperscriptBox["P", "D", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]], 
        SubsuperscriptBox["J", "a", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"k", "+", "1"}], ",", "k"}], ")"}]], 
        SubsuperscriptBox["P", "D", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "k", ")"}]]},
         "Ket"]}]}]}]},
    {
     RowBox[{"\[AlignmentMarker]", 
      RowBox[{
       RowBox[{
        RowBox[{"+", 
         SubscriptBox["P", 
          SuperscriptBox["D", 
           RowBox[{"(", "a", ")"}]]]}], 
        SubsuperscriptBox["J", "a", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"k", "+", "1"}], ",", "k"}], ")"}]], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"b", "=", "0"}], "a"], 
         RowBox[{
          SubsuperscriptBox["P", "U", 
           RowBox[{"(", "b", ")"}]], 
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "k", ")"}]]},
           "Ket"]}]}]}], "+", 
       RowBox[{
        SubsuperscriptBox["P", "D", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"i", "=", "0"}], 
          RowBox[{"k", "-", "1"}]], 
         RowBox[{
          SubsuperscriptBox["J", "a", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"k", "+", "1"}], ",", "i"}], ")"}]], 
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "i", ")"}]]},
           "Ket"]}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCenteredManuallyAligned",
 CellChangeTimes->{{3.826649987762333*^9, 3.826649988805498*^9}, {
  3.82665002566188*^9, 
  3.826650093962549*^9}},ExpressionUUID->"75abb103-054b-44e7-9490-\
d4df1e96239d"],

Cell[TextData[{
 "and obviously this is untenable, because we have an ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["P", "D", 
     RowBox[{"(", 
      RowBox[{"a", "+", "1"}], ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}]]},
     "Ket"]}], TraditionalForm]],
  CellChangeTimes->{{3.826649987762333*^9, 3.826649988805498*^9}, {
   3.82665002566188*^9, 3.826650093962549*^9}},ExpressionUUID->
  "942d2cfa-7232-4bad-9de1-b23c1868183f"],
 " term lying around, but we can see that the error in assuming the \
degeneracy can be bounded by the same type of error bound as before,"
}], "ExpositoryText",
 CellChangeTimes->{{3.826650105626525*^9, 3.826650130459474*^9}, {
  3.826650400923449*^9, 3.826650466754025*^9}, {3.8266505193963947`*^9, 
  3.826650535988719*^9}},ExpressionUUID->"4f808aad-8292-4b4f-a69e-\
398af2c3e071"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"err", "(", 
    RowBox[{
     SubsuperscriptBox["P", "D", 
      RowBox[{"(", 
       RowBox[{"a", "+", "1"}], ")"}]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"j", "=", "0"}], "a"], 
      RowBox[{
       SuperscriptBox["\[CapitalDelta]H", 
        RowBox[{"(", 
         RowBox[{"a", "-", "i"}], ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", 
            RowBox[{"k", "+", "1", "+", "j"}], ")"}]]},
        "Ket"]}]}]}], ")"}], " ", "\[LessEqual]", " ", 
   RowBox[{"\[Delta]E", " ", 
    SubscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{"\[LeftBracketingBar]", 
       RowBox[{
        SubsuperscriptBox["P", "D", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", 
             RowBox[{"k", "+", "1"}], ")"}]]},
         "Ket"]}], "\[RightBracketingBar]"}], "\[RightBracketingBar]"}], 
     "2"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8266504691659517`*^9, 3.826650495767164*^9}, {
  3.826650543617053*^9, 
  3.826650548209256*^9}},ExpressionUUID->"6a0c12ac-36e6-4fb1-a78e-\
41960e1a5d93"],

Cell["\<\
which gives rise to an interesting relation: if the degenerate space \
correction to the wave function decays to zero, i.e.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.826650576196126*^9, 3.826650614108932*^9}, {
  3.826650694086034*^9, 
  3.8266507049837847`*^9}},ExpressionUUID->"e1d72dc5-800a-404e-bc07-\
7aa5d50894f7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["lim", 
     RowBox[{"k", "\[Rule]", "\[Infinity]"}]], " ", 
    SubscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{"\[LeftBracketingBar]", 
       RowBox[{
        SubsuperscriptBox["P", "D", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", 
             RowBox[{"k", "+", "1"}], ")"}]]},
         "Ket"]}], "\[RightBracketingBar]"}], "\[RightBracketingBar]"}], 
     "2"]}], " ", "=", " ", "0"}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.826650618010621*^9, 
  3.826650635853994*^9}},ExpressionUUID->"03853736-579d-4d41-b0d7-\
8db4c3745c5a"],

Cell["\<\
then the induced error in the inductive hypothesis can be bounded\
\>", "ExpositoryText",
 CellChangeTimes->{{3.826650637577157*^9, 3.826650665447648*^9}, {
  3.82665106986279*^9, 
  3.826651078836811*^9}},ExpressionUUID->"35d5b499-65ee-4ee8-aa1d-\
278f6f22b12f"],

Cell["\<\
This I think, corresponds to the case that the perturbation expansion to the \
Hamiltonian is decaying and where there are large enough gaps between the \
non-degenerate energy corrections at each order.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.826650822456354*^9, 
  3.8266508799488173`*^9}},ExpressionUUID->"aa5f3b44-9ed0-47cd-ae91-\
5abb19826740"],

Cell["\<\
Finally, we can use this to bound the error in the energy. First we recall \
that we wrote\
\>", "ExpositoryText",
 CellChangeTimes->{{3.826651009366268*^9, 3.826651016280777*^9}, {
  3.826651675804109*^9, 
  3.8266516980018883`*^9}},ExpressionUUID->"83d4c443-ace9-4a79-9925-\
66220383e49b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["E", 
    RowBox[{"(", 
     RowBox[{"k", "+", "a"}], ")"}]], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     SuperscriptBox["H", 
      RowBox[{"(", 
       RowBox[{"k", "+", "a"}], ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"j", "=", "0"}], "a"], 
      RowBox[{
       SuperscriptBox["\[CapitalDelta]H", 
        RowBox[{"(", 
         RowBox[{"a", "-", "j"}], ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", 
            RowBox[{"k", "+", "j"}], ")"}]]},
        "Ket"]}]}]}], "+", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], 
      RowBox[{"k", "-", "1"}]], 
     RowBox[{
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]]},
       "Bra"], 
      SuperscriptBox["\[CapitalDelta]H", 
       RowBox[{"(", 
        RowBox[{"k", "+", "a", "-", "i"}], ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826651705130884*^9, 3.8266517391775713`*^9}, {
  3.8266519766135902`*^9, 
  3.826651998446355*^9}},ExpressionUUID->"72a53719-e3ef-4856-928f-\
5471643f8a3b"],

Cell[TextData[{
 "and then applied the inductive hypothesis. Assuming no error ",
 StyleBox["before",
  FontSlant->"Italic"],
 " applying the inductive hypothesis, we get "
}], "ExpositoryText",
 CellChangeTimes->{{3.826652000208209*^9, 3.8266520731243067`*^9}, {
  3.826652168685458*^9, 3.8266521749201612`*^9}, {3.826675872725453*^9, 
  3.826675873730526*^9}},ExpressionUUID->"73bf52d1-fed4-4d50-8705-\
051460256da1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"err", "(", 
    SuperscriptBox["E", 
     RowBox[{"(", 
      RowBox[{"k", "+", "a"}], ")"}]], ")"}], " ", "\[LessEqual]", " ", 
   RowBox[{"\[Delta]E", 
    RowBox[{"\[LeftBracketingBar]", 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{
          RowBox[{"(", "0", ")"}], " "}]], 
       RowBox[{" ", 
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]}]},
      "BraKet"], "\[RightBracketingBar]"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826652031810465*^9, 3.826652043987167*^9}, {
  3.826652086220155*^9, 3.826652125839746*^9}, {3.8266756168238583`*^9, 
  3.826675624791844*^9}},ExpressionUUID->"89119ca5-e7cb-4935-b9ff-\
96e4bfaf9f4d"],

Cell["\<\
that is of course a suspect assumption in general, but we can use it to build \
an inductive expression for the error in general.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.826652256076643*^9, 3.8266522738690453`*^9}, {
  3.826675051879553*^9, 
  3.8266750811122828`*^9}},ExpressionUUID->"02030473-6549-4dea-aed1-\
3ef6b49467d1"],

Cell[TextData[{
 "First taking on the error in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "k", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "47c5f6f8-4193-4a06-8432-8136773a06c1"],
 " we recall that we could write, without error,"
}], "ExpositoryText",
 CellChangeTimes->{{3.8266758492676888`*^9, 3.8266758524418297`*^9}, {
  3.8266758873388643`*^9, 
  3.82667596947264*^9}},ExpressionUUID->"512118cb-1359-4b4f-919a-\
a1d07e08d8ec"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["P", "U", 
     RowBox[{"(", "a", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    SubsuperscriptBox["\[CapitalPi]", "U", 
     RowBox[{"(", 
      RowBox[{"a", "-", "1"}], ")"}]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], 
      RowBox[{"k", "-", "1"}]], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["J", 
         RowBox[{"a", "-", "1"}], 
         RowBox[{"(", 
          RowBox[{"k", ",", "i"}], ")"}]], "+", 
        SuperscriptBox["\[CapitalDelta]H", 
         RowBox[{"(", 
          RowBox[{"k", "+", "a", "-", "1", "-", "i"}], ")"}]]}], ")"}], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8266486094750547`*^9, 3.826648616362227*^9}, {
  3.826648647087996*^9, 3.826648654717864*^9}, {3.826675940239978*^9, 
  3.826675940767394*^9}, {3.826676055299062*^9, 
  3.826676065852211*^9}},ExpressionUUID->"964a913e-90ec-49b4-9c75-\
4f3b0c0cb1a5"],

Cell[TextData[{
 "by assuming that ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["E", 
    RowBox[{"(", 
     RowBox[{"k", "+", "a", "-", "i"}], ")"}]], TraditionalForm]],
  ExpressionUUID->"237a4d7b-bb6a-42a9-bb09-36d7aefdb708"],
 " was exact for all ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "\[GreaterEqual]", "1"}], TraditionalForm]],ExpressionUUID->
  "dd35c81d-8c2c-4347-8736-12abe014c650"],
 " and that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "i", ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.8266486094750547`*^9, 3.826648616362227*^9}, {
   3.826648647087996*^9, 3.826648654717864*^9}, {3.826675940239978*^9, 
   3.826675940767394*^9}, {3.826676055299062*^9, 3.826676065852211*^9}},
  ExpressionUUID->"161b3c55-c7eb-4b38-a7ee-7f01ae38539b"],
 " was exact for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "<", "k"}], TraditionalForm]],ExpressionUUID->
  "b992d466-e528-4891-bf08-231a133292bb"],
 " we find there is no error in this at all. Then we recall we had"
}], "ExpositoryText",
 CellChangeTimes->{{3.826675948521441*^9, 3.82667596025251*^9}, {
  3.8266760705212393`*^9, 
  3.826676161490891*^9}},ExpressionUUID->"deeff432-8826-4cdd-8af4-\
8b8bdb67c968"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["P", "V", 
       RowBox[{"(", "a", ")"}]], "=", 
      RowBox[{
       SubsuperscriptBox["P", "D", 
        RowBox[{"(", "a", ")"}]], "-", 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"]}]}]}]},
    {
     RowBox[{
      SubsuperscriptBox["\[CapitalPi]", "V", 
       RowBox[{"(", "a", ")"}]], "=", 
      RowBox[{
       SuperscriptBox[
        RowBox[{
         SubsuperscriptBox["P", "V", 
          RowBox[{"(", "a", ")"}]], "(", 
         RowBox[{"-", 
          SubsuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", "n", 
           RowBox[{"(", "a", ")"}]]}], ")"}], 
        RowBox[{"-", "1"}]], 
       SubsuperscriptBox["P", "V", 
        RowBox[{"(", "a", ")"}]]}]}]},
    {
     RowBox[{
      RowBox[{
       SubsuperscriptBox["P", "V", 
        RowBox[{"(", "a", ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       SubsuperscriptBox["\[CapitalPi]", "V", 
        RowBox[{"(", "a", ")"}]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], 
         RowBox[{"k", "-", "1"}]], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SubsuperscriptBox["J", 
            RowBox[{"n", ",", "a"}], 
            RowBox[{"(", 
             RowBox[{"k", ",", "i"}], ")"}]], " ", "+", " ", 
           SubsuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", "n", 
            RowBox[{"(", 
             RowBox[{"k", "+", "a", "-", "i"}], ")"}]]}], ")"}], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8266762122270317`*^9, 
  3.826676359371231*^9}},ExpressionUUID->"ae0d1214-05dc-485a-ae3e-\
41e6efe3b476"],

Cell[TextData[{
 "where now the only error comes from ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", "n", 
    RowBox[{"(", 
     RowBox[{"k", "+", "a"}], ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.8266762122270317`*^9, 3.826676359371231*^9}},
  ExpressionUUID->"f7edfad3-a20e-46f2-b39e-8620d3c5cb9d"],
 ", which is equivalent in magnitude to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"err", "(", 
    SuperscriptBox["E", 
     RowBox[{"(", 
      RowBox[{"k", "+", "a"}], ")"}]], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.826652031810465*^9, 3.826652043987167*^9}, {
   3.826652086220155*^9, 3.826652125839746*^9}, {3.8266756168238583`*^9, 
   3.826675624791844*^9}},ExpressionUUID->
  "9722bde9-a8ce-42a5-9f81-d6bd89a51f78"],
 ", ",
 StyleBox["but",
  FontSlant->"Italic"],
 " this term comes in as"
}], "ExpositoryText",
 CellChangeTimes->{{3.826676352102561*^9, 3.8266763877840757`*^9}, {
  3.826676453692986*^9, 
  3.826676465309486*^9}},ExpressionUUID->"d64e7365-a8ff-4d4c-b1e8-\
abf24ef07a3e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[CapitalPi]", "V", 
     RowBox[{"(", "a", ")"}]], 
    SuperscriptBox["E", 
     RowBox[{"(", 
      RowBox[{"k", "+", "a"}], ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], "=", "\[DoubleStruckZero]"}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.82667646667022*^9, 
  3.82667648391593*^9}},ExpressionUUID->"cf8549ac-2ee8-4cb8-a91d-\
77048bdebb00"],

Cell[TextData[{
 "and so there is no induced error up through order ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "k", ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.8266762122270317`*^9, 3.826676359371231*^9}},
  ExpressionUUID->"c401e3ac-5462-4067-abdf-fd57541b8a9b"],
 " either."
}], "ExpositoryText",
 CellChangeTimes->{{3.826676484926683*^9, 
  3.826676498224901*^9}},ExpressionUUID->"17f3c231-8f27-4483-983d-\
396687f4d900"],

Cell[TextData[{
 "We\[CloseCurlyQuote]ll now consider moving to correction ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "+", "1"}], TraditionalForm]],ExpressionUUID->
  "6a65e8ed-e734-4e02-9211-7f1500a02f7e"]
}], "ExpositoryText",
 CellChangeTimes->{{3.826675082692513*^9, 3.826675088008132*^9}, {
  3.826675125349584*^9, 3.826675155298765*^9}, {3.8267191942523193`*^9, 
  3.826719204377468*^9}},ExpressionUUID->"fcce0c6b-aa9b-4430-840c-\
770401202459"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox["E", 
       RowBox[{"(", 
        RowBox[{"k", "+", "1", "+", "a"}], ")"}]], "=", 
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], 
        SuperscriptBox["H", 
         RowBox[{"(", 
          RowBox[{"k", "+", "1", "+", "a"}], ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"j", "=", "0"}], "a"], 
         RowBox[{
          SuperscriptBox["\[CapitalDelta]H", 
           RowBox[{"(", 
            RowBox[{"a", "-", "j"}], ")"}]], 
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", 
               RowBox[{"k", "+", "1", "+", "j"}], ")"}]]},
           "Ket"]}]}]}], "+", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], "k"], 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], 
         SuperscriptBox["\[CapitalDelta]H", 
          RowBox[{"(", 
           RowBox[{"k", "+", "1", "+", "a", "-", "i"}], ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], 
        SuperscriptBox["H", 
         RowBox[{"(", 
          RowBox[{"k", "+", "1", "+", "a"}], ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"j", "=", "0"}], "a"], 
         RowBox[{
          SuperscriptBox["\[CapitalDelta]H", 
           RowBox[{"(", 
            RowBox[{"a", "-", "j"}], ")"}]], 
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", 
               RowBox[{"k", "+", "1", "+", "j"}], ")"}]]},
           "Ket"]}]}]}], "+", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], "k"], 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], 
         SuperscriptBox["\[CapitalDelta]H", 
          RowBox[{"(", 
           RowBox[{"k", "+", "1", "+", "a", "-", "i"}], ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], 
        SuperscriptBox["H", 
         RowBox[{"(", 
          RowBox[{"k", "+", "1", "+", "a"}], ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"j", "=", "0"}], "a"], 
         RowBox[{
          SuperscriptBox["\[CapitalDelta]H", 
           RowBox[{"(", 
            RowBox[{"a", "-", "j"}], ")"}]], 
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", 
               RowBox[{"k", "+", "1", "+", "j"}], ")"}]]},
           "Ket"]}]}]}], "+", 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], 
        SuperscriptBox["\[CapitalDelta]H", 
         RowBox[{"(", 
          RowBox[{"k", "+", "a"}], ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "1", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "2"}], "k"], 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], 
         SuperscriptBox["\[CapitalDelta]H", 
          RowBox[{"(", 
           RowBox[{"k", "+", "1", "+", "a", "-", "i"}], ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826651705130884*^9, 3.8266517391775713`*^9}, {
   3.8266519766135902`*^9, 3.826651998446355*^9}, {3.8266751604650917`*^9, 
   3.826675160756493*^9}, {3.8266751924093323`*^9, 3.82667527473079*^9}, {
   3.826675402368717*^9, 3.82667540621432*^9}, 
   3.826675505248267*^9},ExpressionUUID->"3d7e6536-1403-4df9-b218-\
cf89f5080765"],

Cell[TextData[{
 "we\[CloseCurlyQuote]ll obtain an error bounded by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]E", " ", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{
         RowBox[{"(", "0", ")"}], " "}]], 
      RowBox[{" ", 
        SuperscriptBox["n", 
         RowBox[{"(", 
           RowBox[{"k", "+", "1"}], ")"}]]}]},
     "BraKet"]}], TraditionalForm]],
  CellChangeTimes->{{3.826652031810465*^9, 3.826652043987167*^9}, {
   3.826652086220155*^9, 3.826652125839746*^9}},ExpressionUUID->
  "bca904a3-252d-4bcf-95f6-03a94dc9c367"],
 " from the second term and can propagate through the error bounded by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]E", " ", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{
         RowBox[{"(", "0", ")"}], " "}]], 
      RowBox[{" ", 
        SuperscriptBox["n", 
         RowBox[{"(", "k", ")"}]]}]},
     "BraKet"]}], TraditionalForm]],
  CellChangeTimes->{{3.826652031810465*^9, 3.826652043987167*^9}, {
   3.826652086220155*^9, 3.826652125839746*^9}},ExpressionUUID->
  "7a540fee-a78c-443b-a6ea-4a4e20eaebb5"],
 " from ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalDelta]H", 
    RowBox[{"(", 
     RowBox[{"k", "+", "a"}], ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.826651705130884*^9, 3.8266517391775713`*^9}, {
    3.8266519766135902`*^9, 3.826651998446355*^9}, {3.8266751604650917`*^9, 
    3.826675160756493*^9}, {3.8266751924093323`*^9, 3.82667527473079*^9}, {
    3.826675402368717*^9, 3.82667540621432*^9}, 3.826675505248267*^9},
  ExpressionUUID->"b21d8f39-78ad-4a1f-bfa9-0ea0050cc753"],
 " giving us"
}], "ExpositoryText",
 CellChangeTimes->{{3.826675515178381*^9, 3.8266756129742002`*^9}, 
   3.826719230039846*^9},ExpressionUUID->"3691036d-b79f-436c-a597-\
2da42e1195bd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"err", "(", 
    SuperscriptBox["E", 
     RowBox[{"(", 
      RowBox[{"k", "+", "1", "+", "a"}], ")"}]], ")"}], "\[LessEqual]", 
   RowBox[{
    RowBox[{"\[Delta]E", 
     RowBox[{"\[LeftBracketingBar]", 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{
           RowBox[{"(", "0", ")"}], " "}]], 
        RowBox[{" ", 
          SuperscriptBox["n", 
           RowBox[{"(", 
             RowBox[{"k", "+", "1"}], ")"}]]}]},
       "BraKet"], "\[RightBracketingBar]"}]}], "+", 
    RowBox[{"\[Delta]E", 
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{
            RowBox[{"(", "0", ")"}], " "}]], 
         RowBox[{" ", 
           SuperscriptBox["n", 
            RowBox[{"(", "k", ")"}]]}]},
        "BraKet"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{
            RowBox[{"(", "0", ")"}], " "}]], 
         RowBox[{" ", 
           SuperscriptBox["n", 
            RowBox[{"(", "1", ")"}]]}]},
        "BraKet"]}], "\[RightBracketingBar]"}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826675614184187*^9, 3.8266756511063967`*^9}, {
  3.826675827003276*^9, 
  3.82667582951278*^9}},ExpressionUUID->"429861db-98bb-49cf-986a-\
c56080302f09"],

Cell["then looking at the wave function corrections, first we have", \
"ExpositoryText",
 CellChangeTimes->{{3.826719237846137*^9, 3.826719243190978*^9}, {
  3.82671958444619*^9, 
  3.8267195909739447`*^9}},ExpressionUUID->"7b2adda4-6820-4c19-84e8-\
a1555dd64c55"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["P", "U", 
     RowBox[{"(", "a", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    SubsuperscriptBox["\[CapitalPi]", "U", 
     RowBox[{"(", 
      RowBox[{"a", "-", "1"}], ")"}]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], "k"], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["J", 
         RowBox[{"a", "-", "1"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"k", "+", "1"}], ",", "i"}], ")"}]], "+", 
        SuperscriptBox["\[CapitalDelta]H", 
         RowBox[{"(", 
          RowBox[{"k", "+", "a", "-", "i"}], ")"}]]}], ")"}], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8266486094750547`*^9, 3.826648616362227*^9}, {
  3.826648647087996*^9, 3.826648654717864*^9}, {3.826675940239978*^9, 
  3.826675940767394*^9}, {3.826676055299062*^9, 3.826676065852211*^9}, {
  3.8267204947874203`*^9, 
  3.8267205059613333`*^9}},ExpressionUUID->"38ab27fa-601e-4854-8e9d-\
5d38654e87d8"],

Cell[TextData[{
 "which contains a term involving ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPi]", "U", 
     RowBox[{"(", 
      RowBox[{"a", "-", "1"}], ")"}]], 
    SuperscriptBox["E", 
     RowBox[{"(", 
      RowBox[{"k", "+", "a"}], ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "1", ")"}]]},
     "Ket"]}], TraditionalForm]], "ExpositoryMathCentered",
  CellChangeTimes->{{3.82667646667022*^9, 3.82667648391593*^9}},
  ExpressionUUID->"cfee355b-f600-496c-a16a-7b0da5d7f574"],
 " "
}], "ExpositoryText",
 CellChangeTimes->{{3.826719619451243*^9, 3.8267196256624537`*^9}, {
   3.82672047888247*^9, 3.826720525836545*^9}, 
   3.826720652212535*^9},ExpressionUUID->"0fc29141-cbc8-4eaa-b7a5-\
2c13c8b97a35"],

Cell["next we have", "ExpositoryText",
 CellChangeTimes->{{3.826719592055025*^9, 
  3.826719593559079*^9}},ExpressionUUID->"33569d1e-0bf4-4e5a-a711-\
a13292e8c1cf"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["P", "V", 
     RowBox[{"(", "a", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    SubsuperscriptBox["\[CapitalPi]", "V", 
     RowBox[{"(", "a", ")"}]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], "k"], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["J", 
         RowBox[{"n", ",", "a"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"k", "+", "1"}], ",", "i"}], ")"}]], " ", "+", " ", 
        SubsuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", "n", 
         RowBox[{"(", 
          RowBox[{"k", "+", "a", "+", "1", "-", "i"}], ")"}]]}], ")"}], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "i", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826719249958005*^9, 
  3.8267192872406178`*^9}},ExpressionUUID->"4cb5790d-1136-4a7d-9532-\
9dedd26a8d08"],

Cell[TextData[{
 "we now have a term that looks like ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalPi]", "V", 
     RowBox[{"(", "a", ")"}]], 
    SuperscriptBox["E", 
     RowBox[{"(", 
      RowBox[{"k", "+", "a"}], ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "1", ")"}]]},
     "Ket"]}], TraditionalForm]], "ExpositoryMathCentered",
