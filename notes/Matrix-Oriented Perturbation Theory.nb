8eda85c86c39"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
       RowBox[{"(", "a", ")"}]], "=", 
      RowBox[{
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"d", "\[Element]", 
          SuperscriptBox["D", 
           RowBox[{"(", 
            RowBox[{"a", "+", "1"}], ")"}]]}]], 
        RowBox[{
         SubsuperscriptBox["E", "\[Eta]", 
          RowBox[{"(", "a", ")"}]], 
         TemplateBox[{
           SuperscriptBox["d", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"], 
         TemplateBox[{
           SuperscriptBox["d", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"]}]}], "-", 
       SubsuperscriptBox["E", "\[Eta]", 
        RowBox[{"(", "a", ")"}]]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       SubsuperscriptBox["E", "\[Eta]", 
        RowBox[{"(", "a", ")"}]], "(", 
       RowBox[{
        SubsuperscriptBox["P", "D", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]], "-", "I"}], ")"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826645820853992*^9, 3.826645888481329*^9}, {
  3.826645998470475*^9, 
  3.8266460414730663`*^9}},ExpressionUUID->"37b62acd-48ac-442c-8d0c-\
b020bea336d9"],

Cell[TextData[{
 "so the scale of the error we make in the ",
 StyleBox["nearly-degenerate",
  FontSlant->"Italic"],
 " case is proportional to the error induced by assuming ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["E", "d", 
     RowBox[{"(", "a", ")"}]], "=", 
    SubsuperscriptBox["E", "\[Eta]", 
     RowBox[{"(", "a", ")"}]]}], TraditionalForm]],ExpressionUUID->
  "dece2685-0edb-4dd6-a67c-712a9c326be4"],
 " for all ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", " ", "\[Element]", " ", 
    SuperscriptBox["D", 
     RowBox[{"(", 
      RowBox[{"a", "+", "1"}], ")"}]]}], TraditionalForm]],ExpressionUUID->
  "a6703a77-6e08-4c7f-8fd6-69c942442073"],
 ", that is our error can be bounded at the 2-norm level by"
}], "ExpositoryText",
 CellChangeTimes->{{3.82664605453197*^9, 3.826646106797201*^9}, {
  3.826647201987509*^9, 3.826647216250828*^9}, {3.8266473528369083`*^9, 
