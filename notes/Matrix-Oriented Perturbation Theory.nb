     SubsuperscriptBox["\[CapitalDelta]H", "n", 
      RowBox[{"(", 
       SubscriptBox["p", "M"], ")"}]]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.827779039976139*^9, 
  3.8277790541716423`*^9}},ExpressionUUID->"d1793c45-0315-44bd-9721-\
54eb7d908114"],

Cell[TextData[{
 "and now we\[CloseCurlyQuote]ll assume we want to evaluate integrals like ",
 Cell[BoxData[
  FormBox[
   RowBox[{
