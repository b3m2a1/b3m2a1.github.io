        RowBox[{
         SubsuperscriptBox["Q", "k", 
          RowBox[{"(", 
           RowBox[{"b", "-", "1"}], ")"}]], "(", "i", ")"}], 
        SuperscriptBox["n", 
         RowBox[{"k", "+", "1"}]]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       FractionBox["1", 
        RowBox[{
         SuperscriptBox["2", 
          RowBox[{"b", "-", "1"}]], "\[InvisibleSpace]"}]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], "a"], " ", 
        RowBox[{
         RowBox[{"(", GridBox[{
