    {
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"n", "+", "k", "+", "1"}], ")"}], 
       SubscriptBox[
        RowBox[{"(", "n", ")"}], 
        RowBox[{"b", "-", "1", "-", "\[Omega]"}]]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
