              RowBox[{"(", "0", ")"}]], " "}], 
           RowBox[{"\[VeryThinSpace] ", 
             SuperscriptBox["n", 
              RowBox[{"(", "1", ")"}]]}]},
          "BraKet"], "\[Conjugate]"}]}]}]}]},
    {
     RowBox[{
      RowBox[{"\[Therefore]", 
       TemplateBox[{
         RowBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "1", ")"}]], " "}], 
         RowBox[{"\[VeryThinSpace] ", 
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]}]},
        "BraKet"]}], "=", 
      RowBox[{
       TemplateBox[{
         RowBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]], " "}], 
         RowBox[{"\[VeryThinSpace] ", 
           SuperscriptBox["n", 
            RowBox[{"(", "1", ")"}]]}]},
        "BraKet"], "=", "0"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.810053185261359*^9, 
  3.810053236242015*^9}},ExpressionUUID->"e4e14e78-f4fc-4040-acd6-\
e8d1fe8e7f81"],

Cell[TextData[{
 "Next, we want to get an expression for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "1", ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.810046849073838*^9, 3.810046858383391*^9}, {
   3.810046891539076*^9, 3.810046906046307*^9}, {3.8100469607348423`*^9, 
   3.81004697447001*^9}, {3.8100470115061617`*^9, 3.810047014770599*^9}, {
   3.8100470822903357`*^9, 3.810047125745026*^9}, {3.810047259163547*^9, 
   3.810047272843564*^9}, {3.81004738503712*^9, 3.810047467764797*^9}},
  ExpressionUUID->"9351c36d-141e-478c-bd0b-04789823c9e6"],
 " itself, so we expand it out in our initial basis"
}], "ExpositoryText",
 CellChangeTimes->{{3.810053536652721*^9, 3.810053583423999*^9}, {
  3.810053670159532*^9, 
  3.810053683415029*^9}},ExpressionUUID->"02e3b2f1-fe44-4bd6-b66d-\
3508910beb6f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "1", ")"}]]},
    "Ket"], " ", "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", "m"], 
    RowBox[{
     SubsuperscriptBox["c", "m", 
      RowBox[{"(", "1", ")"}]], 
     TemplateBox[{
       SuperscriptBox["m", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8100536848014812`*^9, 
  3.8100537335216846`*^9}},ExpressionUUID->"a0b95e90-147e-49ec-84cd-\
f6b832e3870f"],

Cell[TextData[{
 "where we know that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["c", "n", 
     RowBox[{"(", "1", ")"}]], "=", "0"}], TraditionalForm]],
  CellChangeTimes->{{3.8100536848014812`*^9, 3.810053704744025*^9}},
  ExpressionUUID->"c4d884e9-93f1-4057-8f71-b416d337e1bb"]
}], "ExpositoryText",
 CellChangeTimes->{{3.810053707366557*^9, 3.810053742383171*^9}, 
   3.8100542260068913`*^9},ExpressionUUID->"2d1b8967-b86e-43c3-a0cd-\
ea7af309c23b"],

Cell["Then returning to our original equation, we have", "ExpositoryText",
 CellChangeTimes->{{3.8100537449658318`*^9, 
  3.810053756342067*^9}},ExpressionUUID->"960c858c-88f0-4b79-bc88-\
bef2df72379f"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["H", 
          RowBox[{"(", "0", ")"}]], "-", 
         SuperscriptBox[
          SubscriptBox["E", "n"], 
          RowBox[{"(", "0", ")"}]]}], ")"}], 
       RowBox[{
        UnderscriptBox["\[Sum]", "m"], 
        RowBox[{
         SubsuperscriptBox["c", "m", 
          RowBox[{"(", "1", ")"}]], 
         TemplateBox[{
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"]}]}]}], "=", 
      RowBox[{
       UnderscriptBox["\[Sum]", "m"], " ", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["c", "m", 
          RowBox[{"(", "1", ")"}]], "(", 
         RowBox[{
          SuperscriptBox["H", 
           RowBox[{"(", "0", ")"}]], "-", 
          SuperscriptBox[
           SubscriptBox["E", "n"], 
           RowBox[{"(", "0", ")"}]]}], ")"}], 
        TemplateBox[{
          SuperscriptBox["m", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"], " "}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderscriptBox["\[Sum]", "m"], " ", 
       RowBox[{
        SubsuperscriptBox["c", "m", 
         RowBox[{"(", "1", ")"}]], "(", 
        RowBox[{
         RowBox[{
          SuperscriptBox["H", 
           RowBox[{"(", "0", ")"}]], 
          TemplateBox[{
            SuperscriptBox["m", 
             RowBox[{"(", "0", ")"}]]},
           "Ket"]}], "-", 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["E", "n"], 
           RowBox[{"(", "0", ")"}]], 
          TemplateBox[{
            SuperscriptBox["m", 
             RowBox[{"(", "0", ")"}]]},
           "Ket"]}]}], ")"}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderscriptBox["\[Sum]", "m"], " ", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["c", "m", 
          RowBox[{"(", "1", ")"}]], "(", 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["E", "m"], 
           RowBox[{"(", "0", ")"}]], "-", 
          SuperscriptBox[
           SubscriptBox["E", "n"], 
           RowBox[{"(", "0", ")"}]]}], ")"}], 
        TemplateBox[{
          SuperscriptBox["m", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}]}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["E", "n"], 
           RowBox[{"(", "1", ")"}]], "-", 
          SuperscriptBox["H", 
           RowBox[{"(", "1", ")"}]]}], ")"}], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], 
         RowBox[{"k", "-", "1"}]], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox[
            SubscriptBox["E", "n"], 
            RowBox[{"(", 
             RowBox[{"k", "-", "i"}], ")"}]], "-", 
           SuperscriptBox["H", 
            RowBox[{"(", 
             RowBox[{"k", "-", "i"}], ")"}]]}], ")"}], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"]}]}]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["E", "n"], 
           RowBox[{"(", "1", ")"}]], "-", 
          SuperscriptBox["H", 
           RowBox[{"(", "1", ")"}]]}], ")"}], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], "0"], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox[
            SubscriptBox["E", "n"], 
            RowBox[{"(", 
             RowBox[{"k", "-", "i"}], ")"}]], "-", 
           SuperscriptBox["H", 
            RowBox[{"(", 
             RowBox[{"k", "-", "i"}], ")"}]]}], ")"}], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          SubscriptBox["E", "n"], 
          RowBox[{"(", "1", ")"}]], "-", 
         SuperscriptBox["H", 
          RowBox[{"(", "1", ")"}]]}], ")"}], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{
      RowBox[{
       UnderscriptBox["\[Sum]", "m"], " ", 
       RowBox[{
        SubsuperscriptBox["c", "m", 
         RowBox[{"(", "1", ")"}]], 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["E", "m"], 
           RowBox[{"(", "0", ")"}]], "-", 
          SuperscriptBox[
           SubscriptBox["E", "n"], 
           RowBox[{"(", "0", ")"}]]}], ")"}], 
        TemplateBox[{
          SuperscriptBox["m", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}], "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          SubscriptBox["E", "n"], 
          RowBox[{"(", "1", ")"}]], "-", 
         SuperscriptBox["H", 
          RowBox[{"(", "1", ")"}]]}], ")"}], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8100535918029413`*^9, 3.810053592539065*^9}, {
   3.810053629608357*^9, 3.810053631061491*^9}, {3.810054080287838*^9, 
   3.810054110671093*^9}, {3.81005442273834*^9, 3.810054452038814*^9}, 
   3.810296605140367*^9, {3.810296636654955*^9, 
   3.810296766029416*^9}},ExpressionUUID->"75d9c469-097b-4a2f-846c-\
0eff4e531010"],

Cell[TextData[{
 "and so assuming ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "\[NotEqual]", "n"}], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "c4f1b505-d7a2-4f42-aea3-664a10184c5b"],
 ", by projecting with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      SuperscriptBox["m", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], " "}], TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "186a6f32-79a4-4565-8a28-d6fbcef45e48"],
 " we find that "
}], "ExpositoryText",
 CellChangeTimes->{{3.8100544044717903`*^9, 3.810054405583444*^9}, {
  3.810296971852406*^9, 3.810296985248746*^9}, {3.810297161723774*^9, 
  3.810297175417544*^9}},ExpressionUUID->"66c34539-4b24-4d19-b2cb-\
3dcacca6329f"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["c", "m", 
       RowBox[{"(", "1", ")"}]], "=", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         TemplateBox[{
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], 
         SuperscriptBox["H", 
          RowBox[{"(", "1", ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"]}], 
        RowBox[{
         SuperscriptBox[
          SubscriptBox["E", "m"], 
          RowBox[{"(", "0", ")"}]], "-", 
         SuperscriptBox[
          SubscriptBox["E", "n"], 
          RowBox[{"(", "0", ")"}]]}]]}]}]},
    {
     RowBox[{"=", 
      FractionBox[
       RowBox[{
        TemplateBox[{
          SuperscriptBox["m", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["E", "n"], 
         RowBox[{"(", "0", ")"}]], "-", 
        SuperscriptBox[
         SubscriptBox["E", "m"], 
         RowBox[{"(", "0", ")"}]]}]]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.810296865254888*^9, 3.81029688714196*^9}, {
  3.8102969237062683`*^9, 3.8102969944789352`*^9}, {3.810297140540058*^9, 
  3.8102971693237247`*^9}, {3.810298251062698*^9, 
  3.8102982671533318`*^9}},ExpressionUUID->"fede3823-f1c1-486f-81e2-\
4436623285a6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Perturbation Operator", "Subsubsubsection",
 CellChangeTimes->{{3.8102974537431498`*^9, 
  3.810297457386026*^9}},ExpressionUUID->"12e42d9f-95d7-4eb9-984d-\
2ba1578a0d77"],

Cell[TextData[{
 "We will find it convenient to define two operators so that we can do less \
term-manipulation, first we\[CloseCurlyQuote]d like to introduce an operator \
that projects out the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["n", "th"], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"7b6b1e79-4b30-499a-9910-c5a21bb33198"],
 " state from our terms"
}], "ExpositoryText",
 CellChangeTimes->{{3.810297181267489*^9, 
  3.810297283681506*^9}},ExpressionUUID->"a77a3572-3557-44b0-9219-\
b106f4cdc68c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["R", "n"], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"I", "-", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"]}]}], ")"}], "=", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"\[Alpha]", "\[NotEqual]", "n"}]], 
     RowBox[{
      TemplateBox[{
        SuperscriptBox["m", 
         RowBox[{"(", "0", ")"}]]},
       "Ket"], 
      TemplateBox[{
        SuperscriptBox["m", 
         RowBox[{"(", "0", ")"}]]},
       "Bra"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.810297257029264*^9, 
  3.810297282001979*^9}},ExpressionUUID->"199c7df3-82b2-404b-9aeb-\
487524f3c691"],

Cell[TextData[{
 "with this defined, we can then directly construct our coefficient vectors \
by inverting ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "0", ")"}]], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"6918932f-c6c7-46ef-9af9-eebaac57025a"],
 " and defining our \[OpenCurlyDoubleQuote]perturbation operator\
\[CloseCurlyDoubleQuote]"
}], "ExpositoryText",
 CellChangeTimes->{{3.810297286393536*^9, 3.810297353155222*^9}, {
  3.810297391702218*^9, 
  3.810297399302951*^9}},ExpressionUUID->"b9050027-1dbb-4cab-b853-\
061ab9fc9ec5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[CapitalPi]", "n"], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["E", "n", 
        RowBox[{"(", "0", ")"}]], "-", 
       SuperscriptBox["H", 
        RowBox[{"(", "0", ")"}]]}], ")"}], 
     RowBox[{"-", "1"}]], 
    SubscriptBox["R", "n"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.810297354486033*^9, 3.810297355077523*^9}, {
  3.810298218909382*^9, 3.8102982233425493`*^9}, {3.8102982961715403`*^9, 
  3.810298299106058*^9}},ExpressionUUID->"eb749ed9-411b-49a8-9d4a-\
b35ed5207c15"],

Cell[TextData[{
 "that can be directly applied to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"0dca2fc2-4af0-4de5-a426-bb9880f2d216"],
 " to give"
}], "ExpositoryText",
 CellChangeTimes->{{3.810297366695545*^9, 
  3.810297411590455*^9}},ExpressionUUID->"af29f6f3-bc24-4c1c-a245-\
2db7e3341ce3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "1", ")"}]]},
    "Ket"], "=", 
   RowBox[{
    SubscriptBox["\[CapitalPi]", "n"], 
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8102974180015783`*^9, 
  3.8102974187151747`*^9}},ExpressionUUID->"9b2ba716-b3b2-4819-94cb-\
d5d3888cbb0d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Second-Order Correction", "Subsubsubsection",
 CellChangeTimes->{{3.810297464530077*^9, 
  3.81029747190592*^9}},ExpressionUUID->"2444e398-ea7c-48a1-843a-\
779c65ab27c1"],

Cell["We\[CloseCurlyQuote]ll return to our motivating equations", \
"ExpositoryText",
 CellChangeTimes->{{3.810297512028803*^9, 3.810297559622012*^9}, 
   3.810297695458317*^9},ExpressionUUID->"0fe83ff7-cf37-44df-a1a2-\
b515587b51f2"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox[
       SubscriptBox["E", "n"], 
       RowBox[{"(", "k", ")"}]], "=", 
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], " ", 
        SuperscriptBox["H", 
         RowBox[{"(", "k", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], "+", " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], "k"], 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], " ", 
         SuperscriptBox["H", 
          RowBox[{"(", 
           RowBox[{"k", "-", "i"}], ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"]}]}], "-", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["E", "n"], 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", "i", ")"}]]}]},
         "BraKet"]}]}]}]},
    {
     RowBox[{
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "k"], 
       TemplateBox[{
         RowBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]], " "}], 
         RowBox[{"\[VeryThinSpace] ", 
           SuperscriptBox["m", 
            RowBox[{"(", 
              RowBox[{"k", "-", "i"}], ")"}]]}]},
        "BraKet"]}], "=", "0"}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["H", 
          RowBox[{"(", "0", ")"}]], "-", 
         SuperscriptBox[
          SubscriptBox["E", "n"], 
          RowBox[{"(", "0", ")"}]]}], ")"}], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["E", "n"], 
           RowBox[{"(", "k", ")"}]], "-", 
          SuperscriptBox["H", 
           RowBox[{"(", "k", ")"}]]}], ")"}], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], 
         RowBox[{"k", "-", "1"}]], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox[
            SubscriptBox["E", "n"], 
            RowBox[{"(", 
             RowBox[{"k", "-", "i"}], ")"}]], "-", 
           SuperscriptBox["H", 
            RowBox[{"(", 
             RowBox[{"k", "-", "i"}], ")"}]]}], ")"}], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.81029754069508*^9, 3.810297541495832*^9}, {
  3.8102977074775476`*^9, 3.810297725672966*^9}, {3.810298432715782*^9, 
  3.810298442307538*^9}},ExpressionUUID->"8d5abd8f-3f1c-4963-bcd4-\
33377a302f11"],

Cell[TextData[{
 "and then letting ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "=", "2"}], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"54750569-df0f-4cf6-935d-9d0257665546"],
 " we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.810297643357192*^9, 3.810297644436596*^9}, {
  3.810297751182845*^9, 
  3.8102977792947683`*^9}},ExpressionUUID->"5a7192b9-f5b3-44bb-998f-\
3ee4a7ee8528"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox[
       SubscriptBox["E", "n"], 
       RowBox[{"(", "2", ")"}]], "=", 
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], " ", 
        SuperscriptBox["H", 
         RowBox[{"(", "2", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], " ", "+", " ", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], "2"], 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], " ", 
         SuperscriptBox["H", 
          RowBox[{"(", 
           RowBox[{"2", "-", "i"}], ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"]}]}], "-", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["E", "n"], 
         RowBox[{"(", 
          RowBox[{"2", "-", "i"}], ")"}]], 
        TemplateBox[{
