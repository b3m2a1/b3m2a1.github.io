4d9c9bc0fc24"],

Cell["\<\
and then we can use the fact that tensor contractions along different axes \
commute up to a transpose (although associativity is still certainly not a \
thing) so\
\>", "ExpositoryText",
 CellChangeTimes->{{3.83296655418006*^9, 3.832966586872155*^9}, {
  3.8329666601811733`*^9, 
  3.832966673499138*^9}},ExpressionUUID->"da75fc62-edba-48a2-be83-\
2369e067916e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[Del]", 
      SuperscriptBox["Q", "n"]], "X"}], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"i", ",", " ", 
      RowBox[{"j", "+", "1"}]}], "\[RightAngleBracket]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "Q"], "X"}], 
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["X", 
         RowBox[{"m", "+", "1"}]]], "V"}]}], ")"}]}], " ", "=", " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "Q"], "X"}], 
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{"2", ",", " ", "n"}], "\[RightAngleBracket]"}], 
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["Q", "n"]], "X"}], 
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{"i", ",", " ", 
        RowBox[{"j", "+", "1"}]}], "\[RightAngleBracket]"}], " ", 
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["X", 
         RowBox[{"m", "+", "1"}]]], "V"}]}], ")"}], 
    RowBox[{"1", "\[Rule]", "n"}]]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.832966588168955*^9, 
  3.832966635105523*^9}},ExpressionUUID->"9e71a7f0-fa9a-42a0-9939-\
137335e8e422"],

Cell["\<\
and finally the axis shifts cancel, giving us the expected result.\
\>", "Text",
 CellChangeTimes->{{3.8329666397482367`*^9, 3.8329666551239777`*^9}, 
   3.832966693562052*^9},ExpressionUUID->"bcca1c6e-44c8-45f3-9539-\
e3e29574d219"],

Cell[TextData[{
 "This is useful as it allows us to write simple code to handle terms as long \
as we don\[CloseCurlyQuote]t worry too much about efficiency. The efficiency \
can be recovered later by reducing the computation graph over unique \
contractions. The final complication is dealing with the axis shifts we\
\[CloseCurlyQuote]ll pick up as we expand this out further. The key here will \
be to note that in general we have, assuming ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "<", "j"}], TraditionalForm]],ExpressionUUID->
  "fb3840b4-dcb8-45c4-9ccb-bca0409e2bcb"]
}], "Text",
 CellChangeTimes->{{3.832966696766364*^9, 3.832966733351461*^9}, {
  3.8329669987542152`*^9, 3.832967012020217*^9}, {3.832967270937213*^9, 
  3.832967276429102*^9}, {3.8329673223010817`*^9, 3.832967521512207*^9}, {
  3.8329704782452593`*^9, 3.83297048230063*^9}, {3.8329766163766212`*^9, 
