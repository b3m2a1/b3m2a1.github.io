Cell["We\[CloseCurlyQuote]ll consider", "ExpositoryText",
 CellChangeTimes->{{3.888325645607061*^9, 
  3.888325647582552*^9}},ExpressionUUID->"29022bc0-6e79-462d-8904-\
18406bf3682d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{"n"},
     "Bra"], "A", 
    SuperscriptBox[
     TemplateBox[{"m"},
      "Ket"], 
     RowBox[{"(", "k", ")"}]]}], " ", "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], "k"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "0"}], "i"], "\[VeryThinSpace]", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{"s", "\[Element]", 
        RowBox[{"P", "(", 
         RowBox[{"k", "-", "i", "-", "j"}], ")"}]}]], 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{"r", "\[Element]", 
         RowBox[{"P", "(", "i", ")"}]}]], " ", 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], " ", 
        RowBox[{"(", 
         RowBox[{
          UnderscriptBox["\[Product]", 
           RowBox[{
            SubscriptBox["s", "a"], "\[Element]", "s"}]], 
          RowBox[{
           SubsuperscriptBox["\[CapitalDelta]H", "n", 
            RowBox[{"(", 
             SubscriptBox["s", "a"], ")"}]], 
           SubscriptBox["\[CapitalPi]", "n"]}]}], ")"}], 
        RowBox[{
         SuperscriptBox["A", 
          RowBox[{"(", "j", ")"}]], "(", 
         RowBox[{
          UnderscriptBox["\[Product]", 
           RowBox[{
            SubscriptBox["r", "b"], "\[Element]", "r"}]], 
          RowBox[{
           SubscriptBox["\[CapitalPi]", "m"], 
           SubsuperscriptBox["\[CapitalDelta]H", "m", 
            RowBox[{"(", 
             SubscriptBox["r", "b"], ")"}]]}]}], ")"}], 
        TemplateBox[{
          SuperscriptBox["m", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.888228501354525*^9, 3.8882287022394037`*^9}, {
  3.888235625954693*^9, 3.88823568485336*^9}, {3.888325677028632*^9, 
  3.888325721182*^9}},ExpressionUUID->"0a486692-f033-440f-ba82-9ee408eef581"],

Cell["\<\
which can be expanded out in terms of the sequences from above like\
\>", "ExpositoryText",
 CellChangeTimes->{{3.888325820431079*^9, 
  3.888325831740717*^9}},ExpressionUUID->"1bb9d16b-54db-4e8c-90a9-\
55204ece787c"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SuperscriptBox["S", 
        RowBox[{"(", "k", ")"}]], 
       SuperscriptBox["A", 
        RowBox[{"(", "i", ")"}]], 
       SuperscriptBox["R", 
        RowBox[{"(", "j", ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], " ", "=", " ", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SuperscriptBox["S", 
        RowBox[{"(", "k", ")"}]], 
       SuperscriptBox["A", 
        RowBox[{"(", "i", ")"}]], 
       SubscriptBox["\[CapitalPi]", "m"], 
       SubsuperscriptBox["\[CapitalDelta]H", "m", 
        RowBox[{"(", "a", ")"}]], 
       SuperscriptBox["R", 
        RowBox[{"(", 
         RowBox[{"j", "-", "a"}], ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SuperscriptBox["S", 
        RowBox[{"(", 
         RowBox[{"k", "-", "b"}], ")"}]], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", "b", ")"}]], 
       SubscriptBox["\[CapitalPi]", "n"], 
       SuperscriptBox["A", 
        RowBox[{"(", "i", ")"}]], 
       SuperscriptBox["R", 
        RowBox[{"(", "j", ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.888325648830673*^9, 3.888325649417762*^9}, {
   3.888325838268713*^9, 3.888325859733305*^9}, 3.888326123882662*^9, {
   3.8883262116647787`*^9, 3.888326329060389*^9}, {3.888327077886804*^9, 
   3.8883270782621098`*^9}},ExpressionUUID->"271e5b20-a730-42a4-bc61-\
bcc297a5f378"],

Cell["and we can pair up these sequences like", "ExpositoryText",
 CellChangeTimes->{{3.888327094811311*^9, 3.888327102327512*^9}, {
  3.8883272154809217`*^9, 
  3.888327220381942*^9}},ExpressionUUID->"2342c2a2-db85-496a-bad2-\
d4cdf7388bc1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], " ", 
    SuperscriptBox["S", 
     RowBox[{"(", "k", ")"}]], 
    SuperscriptBox["A", 
     RowBox[{"(", "i", ")"}]], 
    SubscriptBox["\[CapitalPi]", "m"], 
    SubsuperscriptBox["\[CapitalDelta]H", "m", 
     RowBox[{"(", "a", ")"}]], 
    SuperscriptBox["R", 
     RowBox[{"(", 
      RowBox[{"j", "-", "a"}], ")"}]], 
    TemplateBox[{
      SuperscriptBox["m", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], " ", "+", " ", 
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], " ", 
    SuperscriptBox["S", 
     RowBox[{"(", "k", ")"}]], 
    SubsuperscriptBox["\[CapitalDelta]H", "n", 
     RowBox[{"(", "a", ")"}]], 
    SubscriptBox["\[CapitalPi]", "n"], 
    SuperscriptBox["A", 
     RowBox[{"(", "i", ")"}]], 
    SuperscriptBox["R", 
     RowBox[{"(", 
      RowBox[{"j", "-", "a"}], ")"}]], 
    TemplateBox[{
      SuperscriptBox["m", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.888327163785919*^9, 
  3.888327177179625*^9}},ExpressionUUID->"d5e385d1-2321-4c28-a387-\
12fc74c4b5cc"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", "a", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SuperscriptBox["A", 
         RowBox[{"(", "i", ")"}]]}], " ", "+", " ", 
       RowBox[{
        SuperscriptBox["A", 
         RowBox[{"(", "i", ")"}]], 
        SubscriptBox["\[CapitalPi]", "m"], 
        SubsuperscriptBox["\[CapitalDelta]H", "m", 
         RowBox[{"(", "a", ")"}]]}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        SuperscriptBox["H", 
         RowBox[{"(", "a", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SuperscriptBox["A", 
         RowBox[{"(", "i", ")"}]]}], " ", "+", " ", 
       RowBox[{
        SuperscriptBox["A", 
         RowBox[{"(", "i", ")"}]], 
        SubscriptBox["\[CapitalPi]", "m"], 
        SuperscriptBox["H", 
         RowBox[{"(", "a", ")"}]]}], " ", "-", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubsuperscriptBox["E", "n", 
           RowBox[{"(", "a", ")"}]], 
          SubscriptBox["\[CapitalPi]", "n"], 
          SuperscriptBox["A", 
           RowBox[{"(", "i", ")"}]]}], "+", 
         RowBox[{
          SubsuperscriptBox["E", "m", 
           RowBox[{"(", "a", ")"}]], 
          SuperscriptBox["A", 
           RowBox[{"(", "i", ")"}]], 
          SubscriptBox["\[CapitalPi]", "m"]}]}], ")"}]}]}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["H", 
         RowBox[{"(", "a", ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"], 
        SuperscriptBox["A", 
         RowBox[{"(", "i", ")"}]]}], " ", "+", " ", 
       RowBox[{
        SuperscriptBox["A", 
         RowBox[{"(", "i", ")"}]], 
        SubscriptBox["\[CapitalPi]", "m"], 
        SuperscriptBox["H", 
         RowBox[{"(", "a", ")"}]]}]}], " ", "=", " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "k"], " ", 
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{
           SuperscriptBox["H", 
            RowBox[{"(", "a", ")"}]], 
           TemplateBox[{
             SuperscriptBox["k", 
              RowBox[{"(", "0", ")"}]]},
            "Ket"], "\[InvisibleSpace]", 
           TemplateBox[{
             SuperscriptBox["k", 
              RowBox[{"(", "0", ")"}]]},
            "Bra"], 
           SuperscriptBox["A", 
            RowBox[{"(", "i", ")"}]]}], 
          RowBox[{
           SubscriptBox["E", "n"], "-", 
           SubscriptBox["E", "k"]}]], " ", "+", " ", 
         FractionBox[
          RowBox[{
           SuperscriptBox["A", 
            RowBox[{"(", "i", ")"}]], 
           TemplateBox[{
             SuperscriptBox["k", 
              RowBox[{"(", "0", ")"}]]},
            "Ket"], "\[InvisibleSpace]", 
           TemplateBox[{
             SuperscriptBox["k", 
              RowBox[{"(", "0", ")"}]]},
            "Bra"], 
           SuperscriptBox["H", 
            RowBox[{"(", "a", ")"}]]}], 
          RowBox[{
           SubscriptBox["E", "m"], "-", 
           SubscriptBox["E", "k"]}]]}], ")"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "k"], " ", 
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{
           SubscriptBox[
            RowBox[{"(", "\[InvisibleSpace]", 
             SubscriptBox["V", "a"], ")"}], 
            RowBox[{"x", "\[InvisibleSpace]", "k"}]], 
           SubscriptBox[
            RowBox[{"(", "\[InvisibleSpace]", 
             SubscriptBox["A", "a"], ")"}], 
            RowBox[{"k", "\[InvisibleSpace]", "y"}]], 
           SuperscriptBox["Q", "a"], 
           TemplateBox[{
             SuperscriptBox["k", 
              RowBox[{"(", "0", ")"}]]},
            "Ket"], "\[InvisibleSpace]", 
           TemplateBox[{
             SuperscriptBox["k", 
              RowBox[{"(", "0", ")"}]]},
            "Bra"], 
           SuperscriptBox["Q", "a"]}], 
          RowBox[{
           SubscriptBox["E", "n"], "-", 
           SubscriptBox["E", "k"]}]], " ", "+", " ", 
         FractionBox[
          RowBox[{
           SubscriptBox[
            RowBox[{"(", "\[InvisibleSpace]", 
             SubscriptBox["A", "a"], ")"}], 
            RowBox[{"n", "\[InvisibleSpace]", "k"}]], 
           SubscriptBox[
            RowBox[{"(", "\[InvisibleSpace]", 
             SubscriptBox["V", "a"], ")"}], 
            RowBox[{"k", "\[InvisibleSpace]", "m"}]], 
           SuperscriptBox["Q", "a"], 
           TemplateBox[{
             SuperscriptBox["k", 
              RowBox[{"(", "0", ")"}]]},
            "Ket"], "\[InvisibleSpace]", 
           TemplateBox[{
             SuperscriptBox["k", 
              RowBox[{"(", "0", ")"}]]},
            "Bra"], 
           SuperscriptBox["Q", "a"]}], 
          RowBox[{
           SubscriptBox["E", "m"], "-", 
           SubscriptBox["E", "k"]}]]}], ")"}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "k"], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{
            SubscriptBox[
             RowBox[{"(", "\[InvisibleSpace]", 
              SubscriptBox["V", "a"], ")"}], 
             RowBox[{"x", "\[InvisibleSpace]", "k"}]], 
            SubscriptBox[
             RowBox[{"(", "\[InvisibleSpace]", 
              SubscriptBox["A", "a"], ")"}], 
             RowBox[{"k", "\[InvisibleSpace]", "y"}]]}], 
           RowBox[{
            SubscriptBox["E", "n"], "-", 
            SubscriptBox["E", "k"]}]], " ", "+", " ", 
          FractionBox[
           RowBox[{
            SubscriptBox[
             RowBox[{"(", "\[InvisibleSpace]", 
              SubscriptBox["A", "a"], ")"}], 
             RowBox[{"x", "\[InvisibleSpace]", "k"}]], 
            SubscriptBox[
             RowBox[{"(", "\[InvisibleSpace]", 
              SubscriptBox["V", "a"], ")"}], 
             RowBox[{"k", "\[InvisibleSpace]", "y"}]]}], 
           RowBox[{
            SubscriptBox["E", "m"], "-", 
            SubscriptBox["E", "k"]}]]}], ")"}], " ", 
        SuperscriptBox["Q", "a"], 
        TemplateBox[{
          SuperscriptBox["k", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"], "\[InvisibleSpace]", 
        TemplateBox[{
          SuperscriptBox["k", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], 
        SuperscriptBox["Q", "a"]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "k"], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{
            SubscriptBox[
             RowBox[{"(", "\[InvisibleSpace]", 
              SubscriptBox["V", "a"], ")"}], 
             RowBox[{"x", "\[InvisibleSpace]", "k"}]], 
            SubscriptBox[
             RowBox[{"(", "\[InvisibleSpace]", 
              SubscriptBox["A", "a"], ")"}], 
             RowBox[{"k", "\[InvisibleSpace]", "y"}]], 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["E", "m"], "-", 
              SubscriptBox["E", "k"]}], ")"}]}], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["E", "n"], "-", 
              SubscriptBox["E", "k"]}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["E", "m"], "-", 
              SubscriptBox["E", "k"]}], ")"}]}]], " ", "+", " ", 
          FractionBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["E", "n"], "-", 
              SubscriptBox["E", "k"]}], ")"}], 
            SubscriptBox[
             RowBox[{"(", "\[InvisibleSpace]", 
              SubscriptBox["A", "a"], ")"}], 
             RowBox[{"x", "\[InvisibleSpace]", "k"}]], 
            SubscriptBox[
             RowBox[{"(", "\[InvisibleSpace]", 
              SubscriptBox["V", "a"], ")"}], 
             RowBox[{"k", "\[InvisibleSpace]", "y"}]]}], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["E", "n"], "-", 
              SubscriptBox["E", "k"]}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["E", "m"], "-", 
              SubscriptBox["E", "k"]}], ")"}]}]]}], ")"}], " ", 
        SuperscriptBox["Q", "a"], 
        TemplateBox[{
          SuperscriptBox["k", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"], "\[InvisibleSpace]", 
        TemplateBox[{
          SuperscriptBox["k", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], 
        SuperscriptBox["Q", "a"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.888327202455509*^9, 3.888327293300712*^9}, {
  3.888327325508601*^9, 3.8883273772403517`*^9}, {3.88832741604683*^9, 
  3.888327503458816*^9}, {3.888328201747053*^9, 3.8883282988793783`*^9}, {
  3.8883283328230457`*^9, 
  3.888328466422743*^9}},ExpressionUUID->"7801c396-d3cb-4864-88b5-\
2800f27120b8"],

Cell[TextData[{
 "Next, assuming ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "a", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.888327202455509*^9, 3.888327293300712*^9}, {
   3.888327325508601*^9, 3.8883273772403517`*^9}, {3.88832741604683*^9, 
   3.888327503458816*^9}},ExpressionUUID->
  "1abc9dcc-8fe0-473b-b1d0-4a36342ab3ad"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.888327202455509*^9, 3.888327293300712*^9}, {
   3.888327325508601*^9, 3.8883273772403517`*^9}, {3.88832741604683*^9, 
   3.888327503458816*^9}},ExpressionUUID->
  "b4a6809d-e70c-4b35-a1a9-0065daccff71"],
 " ",
 StyleBox["operate on states in a similar manner ",
  FontSlant->"Italic"],
 "(that is, they are both say 3rd order in the raising and lowering \
operators), then...IDK they\[CloseCurlyQuote]ll feed the same states into ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPi]", "m"], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "b0c9051c-37bc-4b18-97da-2063cc5c0879"],
 " or something and so the same selection rules will apply???"
}], "ExpositoryText",
 CellChangeTimes->{{3.888327709845386*^9, 3.8883278301948013`*^9}, {
  3.8883278978335238`*^9, 3.888327936333741*^9}, {3.888328078367221*^9, 
  3.888328094751192*^9}},ExpressionUUID->"6d462c17-8b3c-4a1c-a6a8-\
f555785bce75"],

Cell["We\[CloseCurlyQuote]ll assume specifically for the moment that ", \
"ExpositoryText",
 CellChangeTimes->{{3.8883281051104116`*^9, 
  3.888328110521936*^9}},ExpressionUUID->"fedb3bb3-f98b-4379-97c7-\
1692a6fc00da"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox["H", 
       RowBox[{"(", "a", ")"}]], "=", 
      RowBox[{
       SubscriptBox["V", "a"], "\[CircleDot]", 
       SubscriptBox["Q", "a"]}]}]},
    {
     RowBox[{
      SuperscriptBox["A", 
       RowBox[{"(", "i", ")"}]], " ", "=", " ", 
      RowBox[{
       SubscriptBox["A", "a"], "\[CircleDot]", 
       SubscriptBox["Q", "a"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.888328112174252*^9, 
  3.888328147356902*^9}},ExpressionUUID->"4c685d2b-ad63-40d7-882c-\
a9d6e250f70e"],

Cell["then", "ExpositoryText",
 CellChangeTimes->{{3.8883281490986156`*^9, 
  3.8883281494712467`*^9}},ExpressionUUID->"449a6679-085e-45e6-a5ba-\
02fda0f44401"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox["H", 
      RowBox[{"(", "a", ")"}]], 
     SubscriptBox["\[CapitalPi]", "n"], 
     SuperscriptBox["A", 
      RowBox[{"(", "i", ")"}]]}], " ", "+", " ", 
    RowBox[{
     SuperscriptBox["A", 
      RowBox[{"(", "i", ")"}]], 
     SubscriptBox["\[CapitalPi]", "m"], 
     SuperscriptBox["H", 
      RowBox[{"(", "a", ")"}]]}]}], " ", "=", " ", 
   RowBox[{
    SubscriptBox["V", "a"], "\[CircleDot]", 
    RowBox[{"(", 
     FractionBox[
      SubscriptBox["Q", "a"], 
      RowBox[{
       SubscriptBox["E", "n"], "-", 
       SubscriptBox["E", "m"]}]], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.888328156566744*^9, 
  3.888328192944538*^9}},ExpressionUUID->"68d98aa0-8895-4e52-86d2-\
c9325444f330"],

Cell[TextData[{
 "Therefore, every sequence will have a set of partner sequences given by \
different values of ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "52006645-94c8-4d70-9ec5-89d720798844"],
 " and ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "5479f85f-c857-47dc-8194-f06ef32ee793"]
}], "ExpositoryText",
 CellChangeTimes->{{3.888326176410191*^9, 3.888326197009616*^9}, {
  3.888326383521001*^9, 
  3.888326391246421*^9}},ExpressionUUID->"22365b2c-4595-4366-a59d-\
7da74f2e7d4b"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], " ", 
     SuperscriptBox["S", 
      RowBox[{"(", "k", ")"}]], 
     SuperscriptBox["A", 
      RowBox[{"(", "i", ")"}]], 
     SuperscriptBox["R", 
      RowBox[{"(", "j", ")"}]], 
     TemplateBox[{
       SuperscriptBox["m", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], ",", " ", 
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], " ", 
     SuperscriptBox["S", 
      RowBox[{"(", 
       RowBox[{"k", "-", "b"}], ")"}]], 
     SuperscriptBox["A", 
      RowBox[{"(", 
       RowBox[{"i", "+", "b"}], ")"}]], 
     SuperscriptBox["R", 
      RowBox[{"(", "j", ")"}]], 
     TemplateBox[{
       SuperscriptBox["m", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], ",", " ", 
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], " ", 
     SuperscriptBox["S", 
      RowBox[{"(", "k", ")"}]], 
     SuperscriptBox["A", 
      RowBox[{"(", 
       RowBox[{"i", "+", "a"}], ")"}]], 
     SuperscriptBox["R", 
      RowBox[{"(", 
       RowBox[{"j", "-", "a"}], ")"}]], 
     TemplateBox[{
       SuperscriptBox["m", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}]}], "}"}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.888326352422873*^9, 
  3.8883264201584597`*^9}},ExpressionUUID->"4f09e3d7-a1a4-47ab-be88-\
6eb41754ec9e"],

Cell["and in particular we will have terms that look like", "ExpositoryText",
 CellChangeTimes->{{3.8883264265005836`*^9, 3.888326433097579*^9}, {
  3.8883264892225237`*^9, 
  3.8883264922062798`*^9}},ExpressionUUID->"55008787-8fe1-4452-a642-\
53fbc8e49422"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Bra"], " ", 
   RowBox[{
    SuperscriptBox["S", 
     RowBox[{"(", "k", ")"}]], "(", 
    RowBox[{
     RowBox[{
      SuperscriptBox["A", 
       RowBox[{"(", "i", ")"}]], 
      SubscriptBox["\[CapitalPi]", "m"], 
      SubsuperscriptBox["\[CapitalDelta]H", "m", 
       RowBox[{"(", "a", ")"}]]}], " ", "+", " ", 
     SuperscriptBox["A", 
      RowBox[{"(", 
       RowBox[{"i", "+", "a"}], ")"}]]}], ")"}], 
   SuperscriptBox["R", 
    RowBox[{"(", 
     RowBox[{"j", "-", "a"}], ")"}]], 
   TemplateBox[{
     SuperscriptBox["m", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.888326086916037*^9, 3.888326092144293*^9}, {
  3.8883264760259237`*^9, 3.888326516233526*^9}, {3.8883267454414454`*^9, 
  3.888326785093711*^9}},ExpressionUUID->"1f8c12ed-b1b7-4273-a3b5-\
279741ef22ac"],

Cell["and notably, if ", "ExpositoryText",
 CellChangeTimes->{{3.888326814238521*^9, 
  3.888326821013088*^9}},ExpressionUUID->"a6f4944e-799c-4228-8ff0-\
d87e1c09a55e"],

Cell["where ", "ExpositoryText",
 CellChangeTimes->{{3.888325671222178*^9, 
  3.888325674356372*^9}},ExpressionUUID->"48d7452c-ad7e-48a9-8de0-\
b0e3dc22c67b"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SuperscriptBox["S", 
        RowBox[{"(", "k", ")"}]], 
       SuperscriptBox["R", 
        RowBox[{"(", "j", ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], " ", "=", " ", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SubsuperscriptBox["S", "-", 
        RowBox[{"(", "k", ")"}]], 
       SubscriptBox["\[CapitalPi]", "n"], 
       SubscriptBox["\[CapitalPi]", "m"], 
       SubsuperscriptBox["R", "-", 
        RowBox[{"(", "j", ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       FractionBox["1", "\[CapitalDelta]E"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       RowBox[{
        SubsuperscriptBox["S", "-", 
         RowBox[{"(", "k", ")"}]], "(", 
        RowBox[{
         SubscriptBox["\[CapitalPi]", "m"], "-", 
         SubscriptBox["\[CapitalPi]", "n"]}], ")"}], 
       SubsuperscriptBox["R", "-", 
        RowBox[{"(", "j", ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       FractionBox["1", "\[CapitalDelta]E"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]]},
           "Bra"], " ", 
          SubsuperscriptBox["S", "-", 
           RowBox[{"(", "k", ")"}]], 
          SuperscriptBox["R", 
           RowBox[{"(", "j", ")"}]], 
          TemplateBox[{
            SuperscriptBox["m", 
             RowBox[{"(", "0", ")"}]]},
           "Ket"]}], " ", "-", " ", 
         RowBox[{
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]]},
           "Bra"], " ", 
          SuperscriptBox["S", 
           RowBox[{"(", "k", ")"}]], 
          SubsuperscriptBox["R", "-", 
           RowBox[{"(", "j", ")"}]], 
          TemplateBox[{
            SuperscriptBox["m", 
             RowBox[{"(", "0", ")"}]]},
           "Ket"]}]}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.888325648830673*^9, 
  3.888325649417762*^9}},ExpressionUUID->"a04db2c3-db45-487a-816e-\
98acba17bb6c"],

Cell[CellGroupData[{

Cell["Diagonal Terms", "Subsubsection",
 CellChangeTimes->{{3.8883289021986628`*^9, 3.888328902735372*^9}, {
  3.888329185589233*^9, 
  3.8883291920046997`*^9}},ExpressionUUID->"f0b17b3b-21d5-4bcc-92ce-\
68ceb04835ad"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SuperscriptBox["\[CapitalDelta]H", 
        RowBox[{"(", "1", ")"}]], 
       SubscriptBox["\[CapitalPi]", "n"], 
       SuperscriptBox["H", 
        RowBox[{"(", "0", ")"}]], 
       SubscriptBox["\[CapitalPi]", "m"], 
       SuperscriptBox["\[CapitalDelta]H", 
        RowBox[{"(", "1", ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], " ", "=", " ", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]], 
       SubscriptBox["\[CapitalPi]", "n"], 
       SuperscriptBox["H", 
        RowBox[{"(", "0", ")"}]], 
       SubscriptBox["\[CapitalPi]", "m"], 
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       RowBox[{
        SubscriptBox[
         RowBox[{"(", "\[InvisibleSpace]", 
          SubscriptBox["V", "3"], ")"}], "xyz"], "\[CircleDot]", 
        SubscriptBox[
         RowBox[{
          RowBox[{"(", 
           SuperscriptBox["Q", "3"], ")"}], "\[InvisibleSpace]"}], "xyz"]}], 
       RowBox[{"(", 
        FractionBox["1", 
         RowBox[{
          SubscriptBox["W", "v"], "\[CircleDot]", 
          SubscriptBox[
           RowBox[{"(", 
            SubscriptBox["\[CapitalDelta]", "3"], ")"}], 
           RowBox[{"v", "\[InvisibleSpace]", "xyz"}]]}]], ")"}], 
       SuperscriptBox["H", 
        RowBox[{"(", "0", ")"}]], 
       RowBox[{
        SubscriptBox[
         RowBox[{"(", "\[InvisibleSpace]", 
          SubscriptBox["V", "3"], ")"}], "xyz"], "\[CircleDot]", 
        SubscriptBox[
         RowBox[{
          RowBox[{"(", 
           SuperscriptBox["Q", "3"], ")"}], "\[InvisibleSpace]"}], "xyz"]}], 
       RowBox[{"(", 
        FractionBox["1", 
         RowBox[{
          SubscriptBox["W", "v"], "\[CircleDot]", 
          SubscriptBox[
           RowBox[{"(", 
            SubscriptBox["\[CapitalDelta]", "3"], ")"}], 
           RowBox[{"v", "\[InvisibleSpace]", "xyz"}]]}]], ")"}], 
       SubscriptBox["\[CapitalPi]", "m"], 
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.888330158137738*^9, 3.888330269529331*^9}, {
   3.888330323221973*^9, 3.888330385591453*^9}, {3.8883304184778*^9, 
   3.888330459185697*^9}, 
   3.888330525432379*^9},ExpressionUUID->"d3263d82-f784-4f17-b2ac-\
05de58348cc3"],

Cell[TextData[{
 "Note that every path we do on the left has a corresponding path on the \
right and all of those are treated ",
 StyleBox["identically",
  FontSlant->"Italic"],
 " until we get to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "0", ")"}]], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "1e308096-38d7-4a10-9b00-f5c6bc444a1a"],
 ", where we filter by state, which allows us to filter out by the ",
 StyleBox["admissible",
  FontSlant->"Italic"],
 " paths, which are the ones that account for the difference in quantum \
numbers between ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "737d92da-330d-4aac-b63a-49d68e20501b"],
 " and ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "d551af95-f39b-4aca-a87b-9de0b8124264"]
}], "ExpositoryText",
 CellChangeTimes->{{3.888330527474698*^9, 
  3.8883307011930113`*^9}},ExpressionUUID->"3dcb4090-1c5c-4fcc-9e8d-\
bc3636e280c0"],

Cell[TextData[{
 "If, however, we want to transform entire spaces, i.e. we want the space of \
all ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "bab245de-1044-4224-b652-6150ece0010a"],
 " that differ from ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "a49659e6-4589-44bc-9dcb-186cebe135e0"],
 " by two quantum numbers, we can do this somewhat differently, as we know \
the transform ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.888330158137738*^9, 3.888330269529331*^9}, {
    3.888330323221973*^9, 3.888330385591453*^9}, {3.8883304184778*^9, 
    3.888330459185697*^9}, 3.888330525432379*^9},ExpressionUUID->
  "dd98c127-e9cf-449b-81d1-2ff4c10cc87c"],
 " "
}], "ExpositoryText",
 CellChangeTimes->{{3.8883307258414993`*^9, 
  3.888330835431501*^9}},ExpressionUUID->"0f731cb4-025a-4170-803b-\
c9d35e8c9d84"],

Cell["We can get a bit further with diagonal operators", "ExpositoryText",
 CellChangeTimes->{{3.888329195025261*^9, 
  3.888329205814789*^9}},ExpressionUUID->"ef57cbfb-a98d-4fce-bbf9-\
3db095db5de3"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SubsuperscriptBox["S", "-", 
        RowBox[{"(", "k", ")"}]], 
       SubscriptBox["\[CapitalPi]", "n"], 
       SuperscriptBox["H", 
        RowBox[{"(", "0", ")"}]], 
       SubscriptBox["\[CapitalPi]", "m"], 
       SubsuperscriptBox["R", "-", 
        RowBox[{"(", "j", ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], " ", "=", " ", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SubsuperscriptBox["S", "-", 
