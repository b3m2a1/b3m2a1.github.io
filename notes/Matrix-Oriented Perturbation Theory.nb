}], "Subsubsubsection",
 CellChangeTimes->{{3.811964995745964*^9, 
  3.811965022602689*^9}},ExpressionUUID->"2ae15275-aaff-4886-ac73-\
1c0f4ab7cf19"],

Cell["\<\
First, write out the regular second-order energy correction as\
\>", "ExpositoryText",
 CellChangeTimes->{{3.811956575224296*^9, 3.811956583510285*^9}, {
  3.811957860735992*^9, 
  3.8119578726999598`*^9}},ExpressionUUID->"d216b046-468e-4a10-b1f9-\
93759625372b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    SubscriptBox["E", "n"], 
    RowBox[{"(", "2", ")"}]], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
