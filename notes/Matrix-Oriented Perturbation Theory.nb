496f4522e447"],

Cell[TextData[{
 "Water in standard ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"r", "\[InvisibleSpace]", 
     SubscriptBox["OH", "1"]}], ",", " ", 
    RowBox[{"r", "\[InvisibleSpace]", 
     SubscriptBox["OH", "2"]}], ",", " ", 
    RowBox[{"\[Theta]", "\[InvisibleSpace]", "HOH"}]}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "9a9d5f3b-a849-423b-8704-a04fba74aa69"],
 " coordinates has a quartic contribution to the antisymmetric stretch \
fundamental of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Minus]", "388.4"}], " ", 
    SuperscriptBox["cm", 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "76d6465c-a5ab-4080-a1cb-46bee9197ff9"],
 ", this drops to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Minus]", "305.9"}], " ", 
    SuperscriptBox["cm", 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "9d8922f6-a3e9-4414-9bb0-4610935e07af"],
 " when all the anharmonicity is included in the ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "13834362-6c14-4b6a-b4c8-c2f3eb60aaf4"],
 " matrix, this also means the cubic contribution is decreased in magnitude \
by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"~", "83"}], " ", 
    SuperscriptBox["cm", 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "b86461c7-9f64-4cc8-90df-76f7b9bbda2c"]
}], "ExpositoryText",
 CellChangeTimes->{{3.921338360607149*^9, 3.9213383964208403`*^9}, {
  3.921338550993874*^9, 3.92133866097858*^9}, {3.92133874234813*^9, 
  3.921338763129367*^9}},ExpressionUUID->"9ab3f74b-b12f-43ae-86a4-\
414d30af4a9d"],

Cell[TextData[{
 "The quartic contribution to the bend goes from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Minus]", "57"}], " ", 
    SuperscriptBox["cm", 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "cf06af6a-1222-40af-b1c1-ba42629c6156"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Minus]", "44"}], " ", 
    SuperscriptBox["cm", 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "447b7f66-273e-44ba-802c-e847a30884ac"],
 ", which is actually enough to flip the sign on the cubic contribution, \
going from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"7.39", " ", 
    SuperscriptBox["cm", 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "ba42fdb3-bde0-4ad7-a194-5a4ccab9e800"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Minus]", "5.7"}], " ", 
    SuperscriptBox["cm", 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "45248578-6b21-46e2-9659-bcf26a4f9339"],
 " "
}], "ExpositoryText",
