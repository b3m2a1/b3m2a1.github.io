      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", "m"], " ", 
    RowBox[{
     SubsuperscriptBox["k", 
      RowBox[{"\[VeryThinSpace]", "m"}], 
      RowBox[{"(", "n", ")"}]], 
     TemplateBox[{
       SuperscriptBox["m", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8119878663840837`*^9, 
  3.811987870893588*^9}},ExpressionUUID->"bad42bfd-dab9-43c8-ad13-\
2e61a60e811b"],

Cell[TextData[{
 "where we actually know explicitly which ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["k", 
    RowBox[{"\[VeryThinSpace]", "m"}], 
    RowBox[{"(", "n", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.8119878663840837`*^9, 3.811987870893588*^9}},
  ExpressionUUID->"7217e383-bbf8-4e93-ad0e-00677c734dce"],
 " terms will be non-zero and how they relate to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],
  CellChangeTimes->{{3.8119878663840837`*^9, 3.811987870893588*^9}},
  ExpressionUUID->"ca3a62b9-5bf7-4e18-9a03-3ee0f8e5fbd7"],
 ". For the ease of putting things down, though, we\[CloseCurlyQuote]ll write \
it out like that (which is formally equivalent to obtaining a full \
representation of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],ExpressionUUID->
  "6aeba808-8974-4a87-8b50-960685e585d0"],
 " in an infinite basis)."
}], "ExpositoryText",
 CellChangeTimes->{{3.8119878762767887`*^9, 3.811987978286592*^9}, {
  3.8119885450815153`*^9, 
  3.811988556830594*^9}},ExpressionUUID->"0d4cc5fc-0eb5-4f64-a62e-\
109e7348af10"],

