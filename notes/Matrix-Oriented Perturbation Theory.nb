  3.8367408076555853`*^9}},ExpressionUUID->"aed65bbe-352c-49f3-b2e2-\
e2b98539d430"],

Cell[TextData[{
 "One thing to note is that we need to be sure that we\[CloseCurlyQuote]re \
calculating enough elements of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["g", 
      RowBox[{"(", "i", ")"}]]},
    "Bra"], TraditionalForm]],ExpressionUUID->
  "735a6754-a4c1-45d0-8616-0d15aeef6902"],
 ", in particular we have"
}], "ExpositoryText",
 CellChangeTimes->{{3.836749480059039*^9, 
  3.836749522085037*^9}},ExpressionUUID->"f76e7dbc-9883-44fb-bea2-\
bc86071838c7"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"\[CurlyPhi]", "(", 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"], ")"}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Union]", 
         RowBox[{"k", "=", "0"}], "N"], " ", 
        RowBox[{"\[CapitalPhi]", "(", 
         RowBox[{
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]]},
           "Bra"], " ", 
          SuperscriptBox["H", 
           RowBox[{"(", "k", ")"}]]}], ")"}]}], " ", "\[Union]", " ", 
       SuperscriptBox["\[CapitalGamma]", 
        RowBox[{"(", "k", ")"}]]}]}]},
    {
     RowBox[{" ", 
      RowBox[{
       RowBox[{"\[CapitalPhi]", "(", 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"], ")"}], " ", "=", " ", 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.836749523127667*^9, 
  3.836749584264612*^9}},ExpressionUUID->"743882fa-d6d4-4ad6-acee-\
6b0b8ddf5c6e"],

Cell[TextData[{
 "and so we\[CloseCurlyQuote]ll need ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{"(", "k", ")"}]], " ", "\[Intersection]", " ", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "6a0e766e-18c3-4788-88d0-884b76560a13"],
 " for all ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "89f8583e-8b9a-495c-bd97-7488c08b93c4"]
}], "ExpositoryText",
 CellChangeTimes->{{3.836749563319687*^9, 
  3.836749636548542*^9}},ExpressionUUID->"fa223125-7633-41dd-873b-\
7f722fa835e0"],

Cell[TextData[{
 "Looking at the most common case explicitly, for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "=", "2"}], TraditionalForm]],ExpressionUUID->
  "3653a217-e232-4561-9eec-376dd57a396c"],
 " then we have"
}], "Text",
 CellChangeTimes->{{3.836739037440776*^9, 3.83673912176046*^9}, {
  3.836739458123118*^9, 3.8367394616685953`*^9}, {3.836749681103063*^9, 
  3.836749690428008*^9}},ExpressionUUID->"12996b28-ebed-44bc-8e7d-\
a7868c555024"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"\[CapitalPhi]", "(", 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "1", ")"}]]},
        "Ket"], ")"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"\[CapitalPhi]", "(", 
        RowBox[{
         SuperscriptBox["H", 
          RowBox[{"(", "1", ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"]}], ")"}], " ", "\[Union]", " ", 
       RowBox[{"{", 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"], "}"}]}]}]},
    {
     RowBox[{
      RowBox[{"\[CurlyPhi]", "(", 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "1", ")"}]]},
        "Ket"], ")"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"\[CapitalPhi]", "(", 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], " ", 
         SuperscriptBox["H", 
          RowBox[{"(", "1", ")"}]]}], ")"}], " ", "\[Union]", " ", 
       RowBox[{"\[CapitalPhi]", "(", 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], " ", 
         SuperscriptBox["H", 
          RowBox[{"(", "0", ")"}]]}], ")"}], " ", "\[Union]", " ", 
       SuperscriptBox["\[CapitalGamma]", 
        RowBox[{"(", "1", ")"}]]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{"\[CapitalPhi]", "(", 
        RowBox[{
         SuperscriptBox["H", 
          RowBox[{"(", "1", ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"]}], ")"}], " ", "\[Union]", " ", 
       RowBox[{"\[CapitalPhi]", "(", 
        RowBox[{"{", 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"], "}"}], ")"}], " ", "\[Union]", " ", 
       SuperscriptBox["\[CapitalGamma]", 
        RowBox[{"(", "1", ")"}]]}]}]},
    {
     RowBox[{
      RowBox[{"\[CapitalPhi]", "(", 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "2", ")"}]]},
        "Ket"], ")"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"\[CapitalPhi]", "(", 
        RowBox[{
         SuperscriptBox["H", 
          RowBox[{"(", "2", ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"]}], ")"}], " ", "\[Union]", " ", 
       RowBox[{"\[CapitalPhi]", "(", 
        RowBox[{
         SuperscriptBox["H", 
          RowBox[{"(", "1", ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "1", ")"}]]},
          "Ket"]}], ")"}], " ", "\[Union]", " ", 
       RowBox[{"{", 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"], "}"}]}]}]},
    {
     RowBox[{
      RowBox[{"\[CurlyPhi]", "(", 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "2", ")"}]]},
        "Ket"], ")"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"{", 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"], "}"}], " ", "\[Union]", " ", 
       SuperscriptBox["\[CapitalGamma]", 
        RowBox[{"(", "0", ")"}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.836739110306885*^9, 3.836739167823021*^9}, {
   3.836739229795149*^9, 3.836739244453781*^9}, 3.836739308751585*^9, {
   3.836739374626686*^9, 3.8367394328042173`*^9}, {3.8367394696416273`*^9, 
