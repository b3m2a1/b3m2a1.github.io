       RowBox[{
        TemplateBox[{"n"},
         "Bra"], 
        RowBox[{
         SubscriptBox["\[Sum]", 
          RowBox[{"\[VeryThinSpace]", 
           RowBox[{"i", "\[VeryThinSpace]", "j", "\[VeryThinSpace]", "k"}]}]], 
         RowBox[{
          FractionBox["1", "2"], 
          FractionBox[
           RowBox[{"\[PartialD]", 
            SubscriptBox["g", 
             RowBox[{"\[VeryThinSpace]", 
              RowBox[{"i", "\[VeryThinSpace]", "j"}]}]]}], 
           RowBox[{"\[PartialD]", 
            SubscriptBox["Q", "k"]}]], 
          SubscriptBox["p", "i"], 
          SubscriptBox["Q", "k"], 
          SubscriptBox["p", "j"]}]}]}], "+", 
       RowBox[{
        FractionBox["1", "6"], 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[PartialD]", "3"], "V"}], 
         RowBox[{
          RowBox[{"\[PartialD]", 
           SubscriptBox["Q", "i"]}], 
          SubscriptBox["Q", "j"], 
          SubscriptBox["Q", "k"]}]], 
        SubscriptBox["Q", "i"], 
        SubscriptBox["Q", "j"], 
        SubscriptBox["Q", "k"], 
        TemplateBox[{"m"},
         "Ket"]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Sum]", 
         RowBox[{"\[VeryThinSpace]", 
          RowBox[{"i", "\[VeryThinSpace]", "j", "\[VeryThinSpace]", "k"}]}]], 
        
        RowBox[{
         FractionBox["1", "2"], 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubscriptBox["g", 
            RowBox[{"\[VeryThinSpace]", 
             RowBox[{"i", "\[VeryThinSpace]", "j"}]}]]}], 
          RowBox[{"\[PartialD]", 
           SubscriptBox["Q", "k"]}]], 
         TemplateBox[{"n"},
          "Bra"], 
         SubscriptBox["p", "i"], 
         SubscriptBox["Q", "k"], 
         SubscriptBox["p", "j"], 
         TemplateBox[{"m"},
          "Ket"]}]}], " ", "+", " ", 
       RowBox[{
        FractionBox["1", "6"], 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[PartialD]", "3"], "V"}], 
         RowBox[{
          RowBox[{"\[PartialD]", 
           SubscriptBox["Q", "i"]}], 
          SubscriptBox["Q", "j"], 
          SubscriptBox["Q", "k"]}]], 
        TemplateBox[{"n"},
         "Bra"], 
        SubscriptBox["Q", "i"], 
        SubscriptBox["Q", "j"], 
        SubscriptBox["Q", "k"], 
        TemplateBox[{"m"},
         "Ket"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.793484956128211*^9, 3.79348497881885*^9}, {
  3.793485038676215*^9, 
  3.793485075426423*^9}},ExpressionUUID->"6febd014-b154-42e3-b06a-\
52ffaeab7d0d"],

Cell[TextData[{
 "we realize that we need to get representations of the operators ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "\[VeryThinSpace]", "Q", "\[VeryThinSpace]", "p"}], 
   TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "32572fc4-dc9d-4205-aefd-601dd08ddb81"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", "\[VeryThinSpace]", "Q", "\[VeryThinSpace]", "Q"}], 
   TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "c486e252-c919-4f96-8039-b3bb4fe31bb2"]
}], "ExpositoryText",
 CellChangeTimes->{{3.7934850900729733`*^9, 
  3.793485146475657*^9}},ExpressionUUID->"18b05599-ddf7-4773-a99d-\
87da849e2453"],

Cell["\<\
The form that these operator representations should take may not be entirely \
obvious.\
\>", "Text",
 CellChangeTimes->{{3.793485156670377*^9, 3.793485176631493*^9}, {
  3.79348785814456*^9, 
  3.7934878611686153`*^9}},ExpressionUUID->"d46b6067-979b-438a-b658-\
17142cc46433"],

Cell[CellGroupData[{

Cell["A 2D Example", "Subsubsection",
 CellChangeTimes->{{3.7934851945189333`*^9, 
  3.793485200731648*^9}},ExpressionUUID->"64e48ead-9128-4fbf-93c2-\
0f8cdfbdff6c"],

Cell[TextData[{
 "The first thing we should do is consider a 2-dimensional example, e.g. the \
operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "\[VeryThinSpace]", "y"}], TraditionalForm]],ExpressionUUID->
  "dd89d8a8-7da2-4dc8-ba11-b9c5e56549ea"],
 ". As it turns out, the representation for this in some general basis, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "\[Phi]", "}"}], TraditionalForm]],ExpressionUUID->
  "23a20290-4770-4530-b31b-54f556ed0c83"],
 ", unlike the case of something like ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "2"], "+", 
    SuperscriptBox["y", "2"]}], TraditionalForm]],ExpressionUUID->
  "88980bdd-7bb2-4ac8-8344-bbc469f51b2d"],
 " is unpleasant since it cannot be cleanly separated into some combination \
of 1D representations."
}], "Text",
 CellChangeTimes->{{3.793485188490472*^9, 
  3.793485384089135*^9}},ExpressionUUID->"3e3a76c1-c16f-46d5-90e5-\
cda04a64cb7f"],

Cell["\<\
However, if we set up a direct product basis, i.e. one such that\
\>", "Text",
 CellChangeTimes->{{3.793485361880123*^9, 3.793485389985018*^9}, {
  3.793485424598989*^9, 
  3.793485431187305*^9}},ExpressionUUID->"92df7bb8-1050-43c8-a3b4-\
ce25b7fcccbc"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Phi]", "n"], "=", 
   RowBox[{
    SubscriptBox["\[Phi]", 
     SubscriptBox["n", "x"]], 
    SubscriptBox["\[Phi]", 
     SubscriptBox["n", "y"]]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.793485392067484*^9, 
  3.793485410154735*^9}},ExpressionUUID->"b933ce49-2485-47f4-8918-\
cb8e3ecaf7ee"],

Cell["this becomes much nicer", "ExpositoryText",
 CellChangeTimes->{{3.7934854138023653`*^9, 
  3.7934854396060038`*^9}},ExpressionUUID->"7742c587-2b24-4205-ac87-\
ccbed7effa66"],

Cell["In this case we have ", "Text",
 CellChangeTimes->{{3.793485441310704*^9, 
  3.7934854437033043`*^9}},ExpressionUUID->"0dcb5df3-425c-4bd5-bd6b-\
58448fb4f994"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{"n"},
        "Bra"], "x", "\[VeryThinSpace]", "y", 
       TemplateBox[{"m"},
        "Ket"]}], "=", 
      RowBox[{
       TemplateBox[{
         SubscriptBox["n", "y"]},
        "Bra"], 
       TemplateBox[{
         SubscriptBox["n", "x"]},
        "Bra"], "x", "\[VeryThinSpace]", "y", 
       TemplateBox[{
         SubscriptBox["m", "x"]},
        "Ket"], 
       TemplateBox[{
         SubscriptBox["m", "y"]},
        "Ket"]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       TemplateBox[{
         SubscriptBox["n", "x"]},
        "Bra"], "x", "\[VeryThinSpace]", 
       TemplateBox[{
         SubscriptBox["m", "x"]},
        "Ket"], 
       TemplateBox[{
         SubscriptBox["n", "y"]},
        "Bra"], "\[VeryThinSpace]", "y", 
       TemplateBox[{
         SubscriptBox["m", "y"]},
        "Ket"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.793485446232683*^9, 
  3.793485518843504*^9}},ExpressionUUID->"91adf3a2-be26-466a-8588-\
136111936ead"],

Cell[TextData[{
 "and so if we can set up representations for both ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "007772bc-152d-4ffa-bb5e-e51715cd132f"],
 " and ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],ExpressionUUID->
  "fa276921-448f-4994-beeb-d7b855b93be8"],
 ", we can take the direct product of those representations and get a total \
representation"
}], "Text",
 CellChangeTimes->{{3.793485523276601*^9, 
  3.793485628762192*^9}},ExpressionUUID->"53b736c8-c3c4-4e98-ae6d-\
ef888598bae4"],

Cell[TextData[{
 "What we ",
 StyleBox["do",
  FontSlant->"Italic"],
 " need to keep in mind with this is that it will take us from a 2D matrix to \
a 4D tensor, as we have two quantum numbers ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["n", "x"], 
     SubscriptBox["n", "y"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "a44cdafa-ef46-4259-aed3-01cb761dce5b"],
 " for every ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "1bff3d3e-94e3-4c9d-a074-bcb2752aedc0"]
}], "Text",
 CellChangeTimes->{{3.793485630792967*^9, 
  3.793485706469474*^9}},ExpressionUUID->"8e9e78ec-8500-4cb4-b3a1-\
8c694fbda9c9"],

Cell[CellGroupData[{

Cell["Representation", "Subsubsubsection",
 CellChangeTimes->{{3.793485942561306*^9, 
  3.793485945050589*^9}},ExpressionUUID->"ed33a899-f31a-491e-a878-\
4e648f14905b"],

Cell["\<\
What might this look like, then, for a product of harmonic oscillator \
wavefunction basis?\
\>", "Text",
 CellChangeTimes->{{3.79348590481854*^9, 3.793485934626606*^9}, 
   3.7934859860728807`*^9},ExpressionUUID->"ba35e372-3f86-441c-8fb2-\
00133d18b5b2"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s assume we have ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "x"], TraditionalForm]],ExpressionUUID->
  "eb6c1ea9-d3c5-4d9b-b278-b41ea256cea9"],
 " wavefunctions in ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "e83dbe2d-22f4-446e-ace3-399ad030d74f"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "y"], TraditionalForm]],ExpressionUUID->
  "213fc347-3bef-4a32-aa6b-bfa107c3553c"],
 " in ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],ExpressionUUID->
  "9f3124ba-da19-41d7-b5f9-e48a3b098249"],
 ". This means the representations will be"
}], "Text",
 CellChangeTimes->{{3.793485975545062*^9, 3.7934860468263063`*^9}, {
  3.793486212810397*^9, 
  3.793486216138033*^9}},ExpressionUUID->"be2f868f-7372-49ab-ad0f-\
6e91b20055ea"],

Cell[BoxData[
 FormBox[
  RowBox[{"X", "=", 
   RowBox[{"(", GridBox[{
      {"0", 
       SqrtBox["1"], " ", " ", " "},
      {
       SqrtBox["1"], "0", 
       SqrtBox["2"], " ", " "},
      {" ", 
       SqrtBox["2"], "\[DescendingEllipsis]", "\[DescendingEllipsis]", " "},
      {" ", " ", "\[DescendingEllipsis]", " ", 
       StyleBox[
        SqrtBox[
         StyleBox[
          SubscriptBox["N", "x"],
          FontSize->14]],
        FontSize->10]},
      {" ", " ", " ", 
       StyleBox[
        SqrtBox[
         StyleBox[
          SubscriptBox["N", "x"],
          FontSize->14]],
        FontSize->9], "0"}
     }], ")"}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.793486049852742*^9, 3.793486169108515*^9}, 
   3.793486738613715*^9},ExpressionUUID->"72e4c20e-fe80-482c-bccc-\
774313f7e4cf"],

Cell[BoxData[
 FormBox[
  RowBox[{"Y", "=", 
   RowBox[{"(", GridBox[{
      {"0", 
       SqrtBox["1"], " ", " ", " "},
      {
       SqrtBox["1"], "0", 
       SqrtBox["2"], " ", " "},
      {" ", 
       SqrtBox["2"], "\[DescendingEllipsis]", "\[DescendingEllipsis]", " "},
      {" ", " ", "\[DescendingEllipsis]", " ", 
       StyleBox[
        SqrtBox[
         StyleBox[
          SubscriptBox["N", "y"],
          FontSize->14]],
        FontSize->10]},
      {" ", " ", " ", 
       StyleBox[
        SqrtBox[
         StyleBox[
          SubscriptBox["N", "y"],
          FontSize->14]],
        FontSize->9], "0"}
     }], ")"}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.793486049852742*^9, 3.793486169108515*^9}, {
   3.793486219964615*^9, 3.7934862230888567`*^9}, 
   3.7934867402789*^9},ExpressionUUID->"8700496f-4756-48fb-b32e-bdace7bb9e99"],

Cell[TextData[{
 "But then what happens when we have our total basis of size ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["N", "x"], 
    SubscriptBox["N", "y"]}], TraditionalForm]],ExpressionUUID->
  "89411fb0-270c-4da1-821f-ebfb0be13764"],
 "? Well we can assume that our basis functions are ordered like"
}], "Text",
 CellChangeTimes->{{3.793486252497074*^9, 3.793486281321332*^9}, {
  3.793486397732212*^9, 3.793486400092774*^9}, {3.7934864865887833`*^9, 
  3.793486488499713*^9}},ExpressionUUID->"7d3edfd7-348e-4d21-966e-\
a1e4f7ae1ad1"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["\[Phi]", "1"], "=", 
      RowBox[{
       SubscriptBox["\[Phi]", 
        RowBox[{"x", "=", "1"}]], 
       SubscriptBox["\[Phi]", 
        RowBox[{"y", "=", "1"}]]}]}]},
    {
     RowBox[{
      SubscriptBox["\[Phi]", "2"], "=", 
      RowBox[{
       SubscriptBox["\[Phi]", 
        RowBox[{"x", "=", "2"}]], 
       SubscriptBox["\[Phi]", 
        RowBox[{"y", "=", "1"}]]}]}]},
    {
     RowBox[{" ", "\[VerticalEllipsis]"}]},
    {
     RowBox[{
      SubscriptBox["\[Phi]", 
       SubscriptBox["N", "x"]], "=", 
      RowBox[{
       SubscriptBox["\[Phi]", 
        RowBox[{"x", "=", 
         SubscriptBox["N", "x"]}]], 
       SubscriptBox["\[Phi]", 
        RowBox[{"y", "=", "1"}]]}]}]},
    {
     RowBox[{
      SubscriptBox["\[Phi]", 
       RowBox[{
        SubscriptBox["N", "x"], "+", "1"}]], "=", 
      RowBox[{
       SubscriptBox["\[Phi]", 
        RowBox[{"x", "=", "1"}]], 
       SubscriptBox["\[Phi]", 
        RowBox[{"y", "=", "2"}]]}]}]},
    {"\[VerticalEllipsis]"},
    {
     RowBox[{
      SubscriptBox["\[Phi]", 
       RowBox[{
        SubscriptBox["N", "x"], 
        SubscriptBox["N", "y"]}]], "=", 
      RowBox[{
       SubscriptBox["\[Phi]", 
        RowBox[{"x", "=", 
         SubscriptBox["N", "x"]}]], 
       SubscriptBox["\[Phi]", 
        RowBox[{"y", "=", 
         SubscriptBox["N", "y"]}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.793486386325502*^9, 
  3.793486518658361*^9}},ExpressionUUID->"23ef7759-6f19-4744-9b25-\
c0e5ba182bbd"],

Cell["and so when we look at our total array, it will look like", "Text",
 CellChangeTimes->{{3.793486708934355*^9, 
  3.793486759731861*^9}},ExpressionUUID->"b6fd863f-7f5b-4be9-a6ac-\
95b7426c1672"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"X", "\[VeryThinSpace]", "Y"}], "=", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{
        SubscriptBox["X", "11"], 
        SubscriptBox["Y", "11"]}], 
       RowBox[{
        SubscriptBox["X", "12"], 
        SubscriptBox["Y", "11"]}], "\[Ellipsis]", 
       RowBox[{
        SubscriptBox["X", 
         RowBox[{"1", "\[VeryThinSpace]", 
          SubscriptBox["N", "x"]}]], "\[VeryThinSpace]", 
        SubscriptBox["Y", "11"]}], 
       RowBox[{
        SubscriptBox["X", "11"], 
        SubscriptBox["Y", "12"]}], "\[Ellipsis]", 
       RowBox[{
        SubscriptBox["X", 
         RowBox[{"1", "\[VeryThinSpace]", 
          SubscriptBox["N", "x"]}]], 
        SubscriptBox["Y", 
         RowBox[{"1", "\[VeryThinSpace]", 
          SubscriptBox["N", "y"]}]]}]},
      {
       RowBox[{
        SubscriptBox["X", "21"], 
        SubscriptBox["Y", "11"]}], 
       RowBox[{
        SubscriptBox["X", "22"], 
        SubscriptBox["Y", "11"]}], " ", " ", " ", " ", 
       RowBox[{" ", "\[VerticalEllipsis]"}]},
      {"\[VerticalEllipsis]", " ", "\[DescendingEllipsis]", 
       RowBox[{"\[VerticalEllipsis]", " "}], " ", " ", " "},
      {
       RowBox[{
        SubscriptBox["X", 
         RowBox[{
          SubscriptBox["N", "x"], "\[VeryThinSpace]", "1", 
          "\[VeryThinSpace]"}]], 
        SubscriptBox["Y", "11"]}], " ", "\[Ellipsis]", 
       RowBox[{
        SubscriptBox["X", 
         RowBox[{
          SubscriptBox["N", "x"], "\[VeryThinSpace]", 
          SubscriptBox["N", "x"]}]], 
        SubscriptBox["Y", "11"]}], " ", " ", " "},
      {
       RowBox[{
        SubscriptBox["X", "11"], 
        SubscriptBox["Y", "21"]}], " ", " ", "\[DescendingEllipsis]", " ", 
       " ", " "},
      {"\[VerticalEllipsis]", " ", " ", " ", " ", " ", " "},
      {" ", " ", " ", " ", " ", " ", " "},
      {
       RowBox[{
        SubscriptBox["X", 
         RowBox[{
          SubscriptBox["N", "x"], "\[VeryThinSpace]", "1", 
          "\[VeryThinSpace]"}]], 
        SubscriptBox["Y", 
         RowBox[{
          SubscriptBox["N", "y"], "1"}]]}], "\[Ellipsis]", " ", " ", " ", " ", 
       RowBox[{
        SubscriptBox["X", 
         RowBox[{
          SubscriptBox["N", "x"], "\[VeryThinSpace]", 
          SubscriptBox["N", "x"]}]], 
        SubscriptBox["Y", 
         RowBox[{
          SubscriptBox["N", "y"], "\[VeryThinSpace]", 
          SubscriptBox["N", "y"]}]]}]}
     },
     GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
    ")"}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.793486770619841*^9, 3.79348726112421*^9}, {
  3.79348731590478*^9, 3.793487338855484*^9}, {3.793487420458929*^9, 
  3.793487624932283*^9}},ExpressionUUID->"77aadd87-d8cb-436e-9141-\
b8d4f9caee5f"],

Cell["which we could rewrite as ", "Text",
 CellChangeTimes->{{3.793487649652631*^9, 
  3.79348766928472*^9}},ExpressionUUID->"cea7c3ff-b2db-4436-80d7-\
b36ff2cb2e19"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"X", "\[VeryThinSpace]", "Y"}], "=", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{"X", "\[VeryThinSpace]", 
        SubscriptBox["Y", "11"]}], 
       RowBox[{"X", "\[VeryThinSpace]", 
        SubscriptBox["Y", "12"]}], "\[Ellipsis]", 
       RowBox[{"X", "\[VeryThinSpace]", 
        SubscriptBox["Y", 
         RowBox[{"1", "\[VeryThinSpace]", 
          SubscriptBox["N", "y"]}]]}]},
      {
       RowBox[{"X", "\[VeryThinSpace]", 
        SubscriptBox["Y", "21"]}], 
       RowBox[{"X", "\[VeryThinSpace]", 
        SubscriptBox["Y", "22"]}], " ", " "},
      {"\[VerticalEllipsis]", " ", "\[DescendingEllipsis]", 
       RowBox[{"\[VerticalEllipsis]", " "}]},
      {
       SubscriptBox["XY", 
        RowBox[{
         SubscriptBox["N", "y"], "\[VeryThinSpace]", "1"}]], " ", 
       "\[Ellipsis]", 
       RowBox[{"X", "\[VeryThinSpace]", 
        SubscriptBox["Y", 
         RowBox[{
          SubscriptBox["N", "y"], "\[VeryThinSpace]", 
          SubscriptBox["N", "y"]}]]}]}
     },
     GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
    ")"}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.7934876712807903`*^9, 
  3.793487739627295*^9}},ExpressionUUID->"b7c39b68-e4a1-468a-b0b6-\
5c3c3939ea53"],

Cell[TextData[{
 "which is the Kronecker product of the matrices ",
 Cell[BoxData[
  FormBox["X", TraditionalForm]],ExpressionUUID->
  "6058187b-f6bd-4baf-bef6-68848ad023d5"],
 " and ",
 Cell[BoxData[
  FormBox["Y", TraditionalForm]],ExpressionUUID->
  "5db8b9d3-6a43-442a-a7fe-3c3cfabdaf1a"],
 ", or in more standard notation"
}], "Text",
 CellChangeTimes->{{3.793487743034326*^9, 3.793487760355618*^9}, {
  3.7934878026736*^9, 
  3.7934878058346653`*^9}},ExpressionUUID->"99352207-8766-4e59-9761-\
357678877fc3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"X", "\[InvisibleSpace]", "Y"}], " ", "=", " ", 
   RowBox[{"X", "\[CircleTimes]", "Y"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.793487762085807*^9, 
  3.7934878007296457`*^9}},ExpressionUUID->"8c9fde6a-488d-47db-b385-\
8f1efb447ad0"],

Cell["The ND case follows the same pattern, being", "Text",
 CellChangeTimes->{{3.793488105904747*^9, 
  3.793488117945594*^9}},ExpressionUUID->"2cd3de69-e490-497d-8796-\
0125086a2067"],

Cell[BoxData[
 FormBox[
  RowBox[{"X", "=", 
   RowBox[{
    SubscriptBox["X", "1"], "\[CircleTimes]", 
    SubscriptBox["X", "2"], "\[CircleTimes]", "\[Ellipsis]", "\[CircleTimes]", 
    SubscriptBox["X", "N"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.793488119364355*^9, 
  3.7934881878873663`*^9}},ExpressionUUID->"717b10c7-1ead-430f-9eb1-\
269a5c967f99"]
}, Open  ]]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Representation of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["H",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.793484698745399*^9, 3.7934846987822123`*^9}, {
   3.793484742135104*^9, 3.793484766972056*^9}, {3.793484821738806*^9, 
   3.793484924257436*^9}},ExpressionUUID->
  "32d52f58-a318-44f6-80d7-4881f635bd03"]
}], "Subsection",
 CellChangeTimes->{{3.793487842720108*^9, 3.7934878453371487`*^9}, {
  3.793488056065695*^9, 3.7934880587145643`*^9}, {3.7934882003671923`*^9, 
  3.7934882126555357`*^9}},ExpressionUUID->"ea55399c-dcde-4889-aac1-\
ab0e5fdcf1c6"],

Cell[TextData[{
 "With all this in place, we can now think about how we will handle just the \
second part of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["H",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.793484698745399*^9, 3.7934846987822123`*^9}, {
   3.793484742135104*^9, 3.793484766972056*^9}, {3.793484821738806*^9, 
   3.793484924257436*^9}},ExpressionUUID->
  "45851869-a332-4629-b525-0733ae349d19"]
}], "Text",
 CellChangeTimes->{{3.793488216559657*^9, 3.793488235264184*^9}, {
  3.793488284585802*^9, 
  3.7934882899947243`*^9}},ExpressionUUID->"904bba1b-54c8-4970-9096-\
04b598ebe1c1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Sum]", 
    RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]], 
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["\[PartialD]", "3"], "V"}], 
     RowBox[{
      RowBox[{"\[PartialD]", 
       SubscriptBox["Q", "i"]}], 
      SubscriptBox["Q", "j"], 
      SubscriptBox["Q", "k"]}]], 
    SubscriptBox["Q", "i"], 
    SubscriptBox["Q", "j"], 
    SubscriptBox["Q", "k"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.7934882975102158`*^9, 
  3.793488305365816*^9}},ExpressionUUID->"8830db0e-8a10-47e7-9a28-\
91ee186026bc"],

Cell["\<\
as we\[CloseCurlyQuote]ve shown previously, we can get a full tensor \
representation of the derivatives, i.e.\
\>", "Text",
 CellChangeTimes->{{3.793488311890069*^9, 
  3.7934883388664207`*^9}},ExpressionUUID->"e6c34422-218e-4069-82a8-\
461e82d83c8b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     SubscriptBox["V", 
      SuperscriptBox["Q", "3"]], ")"}], 
    RowBox[{"i", "\[VeryThinSpace]", "j", "\[VeryThinSpace]", "k"}]], "=", 
   FractionBox[
    RowBox[{
     SuperscriptBox["\[PartialD]", "3"], "V"}], 
    RowBox[{
     RowBox[{"\[PartialD]", 
      SubscriptBox["Q", "i"]}], 
     SubscriptBox["Q", "j"], 
     SubscriptBox["Q", "k"]}]]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.793488340084702*^9, 
  3.793488354572021*^9}},ExpressionUUID->"b82e732a-6b14-425e-a31e-\
f84387420228"],

Cell[TextData[{
 "This term has dimension ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"M", ",", " ", "M", ",", " ", "M"}], ")"}], TraditionalForm]],
  ExpressionUUID->"ce37e75e-a82d-4946-a0d1-5f0664b5d773"],
 " where ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],ExpressionUUID->
  "70b1d09c-f2dd-40be-9a0c-17db85022f07"],
 " is the total number of coordinates in our system."
}], "Text",
 CellChangeTimes->{{3.7934883603291388`*^9, 3.7934883840888233`*^9}, 
   3.793488415316751*^9},ExpressionUUID->"d29c260f-62e7-4956-9e98-\
0bba7409bd0f"],

Cell[TextData[{
 "The question, then, is what to do with ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["Q", "3"], TraditionalForm]],ExpressionUUID->
  "23340c42-8892-4e82-bf9c-f798b76f40dd"],
 "?"
}], "Text",
 CellChangeTimes->{{3.793488409280346*^9, 
  3.793488438924254*^9}},ExpressionUUID->"fc41b67b-a712-429e-9da0-\
132a12d127e5"],

Cell[TextData[{
 "Here we need to decide how many quanta of excitation we will allow to be in \
each of our modes. We will let this be ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "i"], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"e6d34426-0a11-45c7-94c5-124e16450c35"],
 ". This means our basis elements look like"
}], "ExpositoryText",
 CellChangeTimes->{{3.793488455470344*^9, 
  3.793488563477048*^9}},ExpressionUUID->"4d820167-070a-436d-aefd-\
94c1e378641b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Phi]", "n"], "=", 
   RowBox[{
    UnderoverscriptBox["\[Product]", 
     RowBox[{"i", "=", "1"}], "M"], 
    SubscriptBox["\[CurlyPhi]", 
     SubscriptBox["n", "i"]]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.793488621292417*^9, 
  3.793488669114973*^9}},ExpressionUUID->"f773f320-d395-406a-bce2-\
049bdd3e56b4"],

Cell["and we have a total basis size of", "Text",
 CellChangeTimes->{{3.793488679370862*^9, 
  3.793488691795865*^9}},ExpressionUUID->"56ae1f72-bcb5-4b6a-8976-\
5a83f3be2e7d"],

Cell[BoxData[
 FormBox[
  RowBox[{"N", "=", 
   RowBox[{
    UnderoverscriptBox["\[Product]", 
     RowBox[{"i", "=", "1"}], "M"], 
    SubscriptBox["N", "i"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.793488693021937*^9, 3.7934886956605473`*^9}, {
  3.793488774803486*^9, 
  3.793488801330138*^9}},ExpressionUUID->"d9df932f-a37b-4778-9b9b-\
1b82c7a15b55"],

Cell[TextData[{
 "and so we expect that ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["H",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.793484698745399*^9, 3.7934846987822123`*^9}, {
   3.793484742135104*^9, 3.793484766972056*^9}, {3.793484821738806*^9, 
   3.793484924257436*^9}},ExpressionUUID->
  "651e1004-915a-4f50-b93b-34068de5013d"],
 " should be have dimension ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"N", ",", " ", "N"}], ")"}], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "bff76109-468d-4f03-b620-fa33318a6259"]
}], "ExpositoryText",
 CellChangeTimes->{{3.7934888041787853`*^9, 
  3.7934888470593367`*^9}},ExpressionUUID->"141411e1-0485-471e-9932-\
e62b8df068f5"],

Cell[TextData[{
 "Thus we expect to have representation of ",
 StyleBox["QQQ",
  FontSlant->"Italic"],
 " that has dimension ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"M", ",", " ", "M", ",", " ", "M", ",", " ", "N", ",", " ", "N"}],
     ")"}], TraditionalForm]],ExpressionUUID->
  "3b1700d9-fc34-4060-8463-bd14b13ac307"],
 ", which can of course get memory intensive ",
 StyleBox["very",
  FontSlant->"Italic"],
 " quickly unless we can control the size of ",
 StyleBox["N",
  FontSlant->"Italic"],
 " or by computing individual elements of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["H",
     FontSlant->"Plain"], 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],ExpressionUUID->
  "4e6e616c-072d-4300-ac77-89d2dc2ebed3"],
 ", like"
}], "Text",
 CellChangeTimes->{{3.79348891248628*^9, 3.793488963497746*^9}, {
  3.793489029159936*^9, 
  3.793489087476399*^9}},ExpressionUUID->"2f0e72ba-aa12-4bc0-9d1b-\
dcd1ad2e3d20"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox[
       RowBox[{
        StyleBox["(",
         FontSlant->"Plain"], 
        SuperscriptBox[
         StyleBox["H",
          FontSlant->"Plain"], 
         RowBox[{"(", "1", ")"}]], ")"}], 
       RowBox[{"n", ",", "m"}]], "=", 
      SubscriptBox[
       RowBox[{
        StyleBox["(",
         FontSlant->"Plain"], 
        SuperscriptBox[
         StyleBox["H",
          FontSlant->"Plain"], 
         RowBox[{"(", "1", ")"}]], ")"}], 
       RowBox[{
        RowBox[{
         SubscriptBox["n", 
          SubscriptBox["x", "1"]], 
         SubscriptBox["n", 
          SubscriptBox["x", 
           RowBox[{"\[VeryThinSpace]", "2"}]]], "\[Ellipsis]", 
         "\[VeryThinSpace]", 
         SubscriptBox["n", 
          SubscriptBox["x", "M"]]}], ",", 
        RowBox[{
         SubscriptBox["m", 
          SubscriptBox["x", "1"]], 
         SubscriptBox["m", 
          SubscriptBox["x", 
           RowBox[{"\[VeryThinSpace]", "2"}]]], "\[Ellipsis]", 
         "\[VeryThinSpace]", 
         SubscriptBox["m", 
          SubscriptBox["x", "M"]]}]}]]}]},
    {
     RowBox[{"=", 
      RowBox[{
       SubscriptBox["V", 
        SuperscriptBox["Q", "3"]], "\[CircleDot]", 
       RowBox[{"(", 
        SubscriptBox[
         SuperscriptBox["Q", "3"], 
         RowBox[{"...", "nm"}]], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.793489089736169*^9, 3.7934891641524687`*^9}, {
  3.79348920423526*^9, 3.79348920960341*^9}, {3.793489274457801*^9, 
  3.7934892998353853`*^9}},ExpressionUUID->"0ee3bca2-40ea-4bb6-9125-\
790cb2aa3f49"],

Cell[TextData[{
 "where the \[CircleDot] is telling us to contract the axes of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", 
    SuperscriptBox["Q", "3"]], TraditionalForm]],
  CellChangeTimes->{{3.793489089736169*^9, 3.7934891641524687`*^9}, {
   3.79348920423526*^9, 3.79348920960341*^9}, {3.793489274457801*^9, 
   3.7934892998353853`*^9}},ExpressionUUID->
  "e325e8f4-2764-430a-bf2e-2afb77025d8c"],
 " with the first three axes of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["Q", "3"], TraditionalForm]],
  CellChangeTimes->{{3.793489089736169*^9, 3.7934891641524687`*^9}, {
   3.79348920423526*^9, 3.79348920960341*^9}, {3.793489274457801*^9, 
   3.7934892998353853`*^9}},ExpressionUUID->
  "f207d1c2-81c7-4e3d-8233-d0cf1c5be8b6"]
}], "Text",
 CellChangeTimes->{{3.7934893126266947`*^9, 
  3.793489343450451*^9}},ExpressionUUID->"8cab7416-8d9f-464d-86bb-\
1d8e2fbd7006"],

Cell[TextData[{
 "But, saving that for another day, we\[CloseCurlyQuote]re still left with \
the question of how to represent ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["Q", "3"], TraditionalForm]],
  CellChangeTimes->{{3.793489089736169*^9, 3.7934891641524687`*^9}, {
   3.79348920423526*^9, 3.79348920960341*^9}, {3.793489274457801*^9, 
   3.7934892998353853`*^9}},ExpressionUUID->
  "575de62d-b862-4275-9823-e20c469163e0"],
 ", given that for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", ">", "3"}], TraditionalForm]],ExpressionUUID->
  "74b57f7f-c40a-45fb-852c-48b519ca2a84"],
 " the indices ",
 StyleBox["i",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k",
  FontSlant->"Italic"],
 "  don\[CloseCurlyQuote]t cover the full set of combinations of axes."
}], "Text",
 CellChangeTimes->{{3.793489043261196*^9, 3.793489050190564*^9}, {
  3.793489357998335*^9, 
  3.7934894793905888`*^9}},ExpressionUUID->"a84235bd-444c-4630-a9b2-\
86bae5cae4c3"],

Cell["In this case, we can think of this as", "Text",
 CellChangeTimes->{{3.793489482596334*^9, 
  3.79348952570956*^9}},ExpressionUUID->"ea078082-d9a6-441e-8db5-\
4c9e05c03b88"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["Q", "3"], "=", 
   RowBox[{
    SuperscriptBox["Q", "3"], 
    SuperscriptBox["I", 
     RowBox[{"(", 
      RowBox[{"M", "-", "3"}], ")"}]]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.793489498584724*^9, 
  3.793489527429002*^9}},ExpressionUUID->"02883b3c-c59b-4c06-b016-\
188fe077bd9e"],

Cell["and so we end up having", "ExpositoryText",
 CellChangeTimes->{{3.7934895132631893`*^9, 
  3.793489555720724*^9}},ExpressionUUID->"f9d6cc0b-8743-491c-9f42-\
efe191e2288b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["Q", "3"], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["I", 
      SubscriptBox["N", "1"]], "\[CircleTimes]", 
     SubscriptBox["I", 
      SubscriptBox["N", "2"]], "\[CircleTimes]", "\[Ellipsis]", 
     "\[CircleTimes]", 
     SubscriptBox["Q", "i"], "\[CircleTimes]", 
     SubscriptBox["I", 
      SubscriptBox["N", 
       RowBox[{"i", "+", "1"}]]], "\[CircleTimes]", "\[Ellipsis]", 
     "\[CircleTimes]", 
     SubscriptBox["Q", "j"], "\[CircleTimes]", 
     SubscriptBox["I", 
      SubscriptBox["N", 
       RowBox[{"j", "+", "1"}]]], "\[CircleTimes]", "\[Ellipsis]"}], 
    RowBox[{
     SubscriptBox["Q", "k"], "\[CircleTimes]", 
     SubscriptBox["I", 
      SubscriptBox["N", 
       RowBox[{"k", "+", "1"}]]], "\[CircleTimes]", 
     SubscriptBox["\[Ellipsis]I", 
      SubscriptBox["N", "M"]]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.793489565532256*^9, 
  3.7934896909248238`*^9}},ExpressionUUID->"37e914a1-59e8-4ebe-bf39-\
f2ed6689cc3c"],

Cell["which is a truly massive tensor", "Text",
 CellChangeTimes->{{3.793489696276346*^9, 
  3.793489705700527*^9}},ExpressionUUID->"bd7eedab-d7d3-4d4c-8d6c-\
1daba604244b"],

Cell[TextData[{
 "On the other hand, it is also an extremely ",
 StyleBox["sparse",
  FontSlant->"Italic"],
 " tensor, and so by using sparse matrix methods we can end up storing very \
little of it, if we decide that we ",
 StyleBox["do",
  FontSlant->"Italic"],
 " want to do a direct calculation of the tensor."
}], "Text",
 CellChangeTimes->{{3.793489707467319*^9, 3.793489730668614*^9}, {
   3.793489897571959*^9, 3.793489963813322*^9}, 
   3.793490023762939*^9},ExpressionUUID->"3cdf91fd-36b0-4a9a-8836-\
8610b4a4cf6e"],

Cell[CellGroupData[{

Cell["Explicit Form", "Subsubsection",
 CellChangeTimes->{{3.793764392902018*^9, 3.7937643949466343`*^9}, {
  3.7938234940823927`*^9, 
  3.7938234962737703`*^9}},ExpressionUUID->"8e0ad03d-fed3-4aa5-a93c-\
bc32ab6f9e54"],

Cell[TextData[{
 "There is also a mild complication that we haven\[CloseCurlyQuote]t dealt \
with here, either, which is that sometimes we won\[CloseCurlyQuote]t have \
three distinct indices. That is sometimes we\[CloseCurlyQuote]ll have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Q", "x"], 
    SubscriptBox["Q", "y"], 
    SubscriptBox["Q", "z"]}], TraditionalForm]],ExpressionUUID->
  "1cdf7880-a96b-4191-86d6-50918ef9afde"],
 " but other times we might have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Q", "x"], 
    SubscriptBox["Q", "y"], 
    SubscriptBox["Q", "x"]}], TraditionalForm]],ExpressionUUID->
  "7c49f637-69cf-4466-8a94-3e76ea83da48"],
 ". These terms will have different representations:"
}], "Text",
 CellChangeTimes->{{3.7937643538919487`*^9, 3.7937643875714073`*^9}, {
  3.793764420666395*^9, 3.793764423690653*^9}, {3.793764456898553*^9, 
  3.7937644700972357`*^9}, {3.793764511595327*^9, 
  3.793764521227674*^9}},ExpressionUUID->"e605c0c9-ff26-418f-ae26-\
b40430135dfe"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["Q", "x"], 
       SubscriptBox["Q", "y"], 
       SubscriptBox["Q", "z"]}], " ", "\[Implies]", " ", 
      RowBox[{
       SubscriptBox["Q", "x"], "\[CircleTimes]", 
       SubscriptBox["Q", "y"], "\[CircleTimes]", 
       SubscriptBox["Q", "z"]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["Q", "x"], 
       SubscriptBox["Q", "y"], 
       SubscriptBox["Q", "x"]}], "\[Implies]", 
      RowBox[{
       SuperscriptBox[
        SubscriptBox["Q", "x"], "2"], "\[CircleTimes]", 
       SubscriptBox["Q", "y"]}]}]}
   },
   GridBoxAlignment->{"Columns" -> {"\[Implies]"}}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.7937646747316923`*^9, 
  3.793764676518367*^9}},ExpressionUUID->"537c0c9f-ce18-41ec-8987-\
381a742677c7"],

Cell[TextData[{
 "where that ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["Q", "x"], "2"], TraditionalForm]], "ExpositoryMathCentered",
  
  CellChangeTimes->{{3.7937646747316923`*^9, 3.793764676518367*^9}},
  ExpressionUUID->"29387b57-c42d-43ed-ac9f-2415e146883d"],
 " term is, as usual, a matrix power of the representation of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Q", "x"], TraditionalForm]],ExpressionUUID->
  "e13f54d1-ef20-4645-afce-225fa3fde62a"],
 ", not a direct term wise multiplication."
}], "Text",
 CellChangeTimes->{{3.793764688873826*^9, 3.793764753632595*^9}, 
   3.7938222524811077`*^9},ExpressionUUID->"2446e8e5-4b17-44d4-8484-\
63c854c02292"],

Cell["\<\
This can also make indexing something of a challenge to think about. Let\
\[CloseCurlyQuote]s consider three modes (we\[CloseCurlyQuote]ll call them x, \
y, and z) and in each of these we put up to 1 quantum of excitation.\
\>", "Text",
 CellChangeTimes->{{3.7937647608887863`*^9, 3.793764805159851*^9}, {
  3.793821265725317*^9, 
  3.793821273905908*^9}},ExpressionUUID->"33473385-2e82-4cd5-a6d9-\
39f862056bbb"],

Cell[TextData[{
 "Then if we\[CloseCurlyQuote]re asking for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["QQQ", 
    RowBox[{"n", "\[VeryThinSpace]", "m"}]], TraditionalForm]],ExpressionUUID->
  "9aad2c9d-28fb-4b3a-aa80-a63280b97f89"],
 " we are really asking for this tensor"
}], "Text",
 CellChangeTimes->{{3.793764869900865*^9, 3.793764925108594*^9}, {
  3.7938207320184507`*^9, 3.793820756057971*^9}, {3.7938222427133217`*^9, 
  3.793822246799918*^9}, {3.793824410493779*^9, 
  3.793824410493841*^9}},ExpressionUUID->"922eac13-fe54-4bbf-9fa5-\
df3bb9acc390"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["QQQ", 
       RowBox[{"n", "\[VeryThinSpace]", "m"}]], "=", 
      RowBox[{"(", GridBox[{
         {
          RowBox[{"(", GridBox[{
             {
              SubscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubscriptBox["Q", "x"], 
                 SubscriptBox["Q", "x"], 
                 SubscriptBox["Q", "x"]}], ")"}], 
               RowBox[{"n", "\[VeryThinSpace]", "m"}]], 
              SubscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubscriptBox["Q", "x"], 
                 SubscriptBox["Q", "x"], 
                 SubscriptBox["Q", "y"]}], ")"}], 
               RowBox[{"n", "\[VeryThinSpace]", "m"}]], 
              SubscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubscriptBox["Q", "x"], 
                 SubscriptBox["Q", "x"], 
                 SubscriptBox["Q", "z"]}], ")"}], 
               RowBox[{"n", "\[VeryThinSpace]", "m"}]]},
             {
              SubscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubscriptBox["Q", "x"], 
                 SubscriptBox["Q", "y"], 
                 SubscriptBox["Q", "x"]}], ")"}], 
               RowBox[{"n", "\[VeryThinSpace]", "m"}]], 
              SubscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubscriptBox["Q", "x"], 
                 SubscriptBox["Q", "y"], 
                 SubscriptBox["Q", "y"]}], ")"}], 
               RowBox[{"n", "\[VeryThinSpace]", "m"}]], 
              SubscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubscriptBox["Q", "x"], 
                 SubscriptBox["Q", "y"], 
                 SubscriptBox["Q", "z"]}], ")"}], 
               RowBox[{"n", "\[VeryThinSpace]", "m"}]]},
             {
              SubscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubscriptBox["Q", "x"], 
                 SubscriptBox["Q", "z"], 
                 SubscriptBox["Q", "x"]}], ")"}], 
               RowBox[{"n", "\[VeryThinSpace]", "m"}]], 
              SubscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubscriptBox["Q", "x"], 
                 SubscriptBox["Q", "z"], 
                 SubscriptBox["Q", "y"]}], ")"}], 
               RowBox[{"n", "\[VeryThinSpace]", "m"}]], 
              SubscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubscriptBox["Q", "x"], 
                 SubscriptBox["Q", "z"], 
                 SubscriptBox["Q", "z"]}], ")"}], 
               RowBox[{"n", "\[VeryThinSpace]", "m"}]]}
            },
            GridBoxAlignment->{"Columns" -> {{Center}}}], ")"}]},
         {
          RowBox[{"(", GridBox[{
             {
              SubscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubscriptBox["Q", "y"], 
                 SubscriptBox["Q", "x"], 
                 SubscriptBox["Q", "x"]}], ")"}], 
               RowBox[{"n", "\[VeryThinSpace]", "m"}]], 
              SubscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubscriptBox["Q", "y"], 
                 SubscriptBox["Q", "x"], 
                 SubscriptBox["Q", "y"]}], ")"}], 
               RowBox[{"n", "\[VeryThinSpace]", "m"}]], 
              SubscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubscriptBox["Q", "y"], 
                 SubscriptBox["Q", "x"], 
                 SubscriptBox["Q", "z"]}], ")"}], 
               RowBox[{"n", "\[VeryThinSpace]", "m"}]]},
             {
              SubscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SubscriptBox["Q", "y"], 
                 SubscriptBox["Q", "y"], 
