Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["J", "a", 
    RowBox[{"(", 
     RowBox[{"k", ",", "i"}], ")"}]], "=", 
   RowBox[{
    SubsuperscriptBox["J", 
     RowBox[{"a", "-", "1"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"k", "+", "1"}], ",", "i"}], ")"}]], "+", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"b", "=", "0"}], 
      RowBox[{"a", "-", "1"}]], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox["\[CapitalDelta]H", 
          RowBox[{"(", "a", ")"}]], 
         SubsuperscriptBox["\[CapitalPi]", "U", 
          RowBox[{"(", "b", ")"}]]}], "+", 
        RowBox[{
         SubsuperscriptBox["J", 
          RowBox[{"a", "-", "1"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"k", "+", "1"}], ",", "k"}], ")"}]], 
         SubsuperscriptBox["\[CapitalPi]", "U", 
          RowBox[{"(", "b", ")"}]]}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["J", "b", 
         RowBox[{"(", 
          RowBox[{"k", ",", "i"}], ")"}]], "+", 
        SuperscriptBox["\[CapitalDelta]H", 
         RowBox[{"(", 
          RowBox[{"k", "+", "b", "-", "i"}], ")"}]]}], ")"}]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
