Cell[BoxData[
 RowBox[{
  RowBox[{"fallingFactorialize", "[", 
   RowBox[{"poly_", ",", " ", "var_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"With", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"c", "=", 
      RowBox[{"CoefficientList", "[", 
       RowBox[{"poly", ",", " ", "var"}], "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"CoefficientList", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Expand", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Sum", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"c", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "*", 
           RowBox[{"Sum", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"StirlingS2", "[", 
               RowBox[{
                RowBox[{"i", "-", "1"}], ",", " ", "k"}], "]"}], 
              RowBox[{"FF", "[", 
               RowBox[{"var", ",", " ", "k"}], "]"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"k", ",", " ", "0", ",", " ", 
               RowBox[{"i", "-", "1"}]}], "}"}]}], "\[IndentingNewLine]", 
            "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", 
            RowBox[{"Length", "@", "c"}]}], "}"}]}], "\[IndentingNewLine]", 
         "]"}], "/.", 
        RowBox[{
         RowBox[{"FF", "[", 
          RowBox[{"var", ",", " ", "k_"}], "]"}], ":>", 
         SuperscriptBox["\[FormalCapitalF]", "k"]}]}], "\[IndentingNewLine]", 
       "]"}], ",", "\[IndentingNewLine]", "\[FormalCapitalF]"}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",\

