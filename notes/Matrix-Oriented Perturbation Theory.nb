            RowBox[{
             SubscriptBox["\[Sigma]", "i"], "0"}]]}]}], "+", 
         RowBox[{
          SubsuperscriptBox["\[CapitalGamma]", "m", 
           RowBox[{"(", 
            SubscriptBox["q", "i"], ")"}]], 
          SubscriptBox["\[Delta]", 
           RowBox[{
            SubscriptBox["\[Sigma]", "i"], "1"}]]}]}], ")"}], 
