72cf804caa0e"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SuperscriptBox[
        SubscriptBox["q", "i"], "3"], "\[InvisibleSpace]", "\[CapitalPi]", 
       "\[InvisibleSpace]", 
       SuperscriptBox[
        SubscriptBox["q", "i"], "3"]}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}]}]},
    {
     RowBox[{
      RowBox[{
       SuperscriptBox[
        SubscriptBox["q", "i"], "3"], "\[InvisibleSpace]", "\[CapitalPi]", 
       "\[InvisibleSpace]", 
       SuperscriptBox[
        SubscriptBox["q", "i"], "1"], 
       SuperscriptBox[
        SubscriptBox["q", "j"], "2"]}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "0"}], "}"}]}], "}"}]}]},
    {
