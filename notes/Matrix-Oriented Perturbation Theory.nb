47a07368ffc1"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", 
         SubscriptBox["q", "j"]}]], 
       RowBox[{"Tr", "(", "A", ")"}]}], "=", 
      RowBox[{
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", 
         SubscriptBox["q", "j"]}]], 
       RowBox[{
        UnderscriptBox["\[Sum]", "k"], 
        SubscriptBox["A", 
         RowBox[{"k", "\[InvisibleSpace]", "k"}]]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderscriptBox["\[Sum]", "k"], 
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", 
          SubscriptBox["q", "j"]}]], 
        SubscriptBox["A", 
         RowBox[{"k", "\[InvisibleSpace]", "k"}]]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8112846742856207`*^9, 3.8112847317035637`*^9}, {
   3.811284860587077*^9, 3.8112848609882107`*^9}, 3.811284983907642*^9, {
   3.811382304202635*^9, 
   3.8113823296281*^9}},ExpressionUUID->"30b5a06a-8d3a-49c2-a248-\
e244c4a2b006"],

Cell["where just for generality it\[CloseCurlyQuote]s worth noting that", \
"ExpositoryText",
 CellChangeTimes->{{3.833132892378475*^9, 
