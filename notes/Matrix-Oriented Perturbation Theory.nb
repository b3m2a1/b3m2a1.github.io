320d50acd0a0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["P", "b", "a"], " ", "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], "b"], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       UnderoverscriptBox["\[Product]", 
        RowBox[{"j", "=", "0"}], "i"], " ", 
       RowBox[{"(", 
        RowBox[{"n", "+", 
         RowBox[{"(", 
          RowBox[{"a", "-", "b", "+", "1"}], ")"}], "+", "j"}], ")"}]}], 
      ")"}], 
     RowBox[{
      SubsuperscriptBox["P", 
       RowBox[{"b", "-", "i"}], 
       RowBox[{"a", "-", "1"}]], "(", "n", ")"}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.889624389820703*^9, 3.889624395725329*^9}, {
  3.88962443185742*^9, 3.889624499665318*^9}, {3.8896245820599957`*^9, 
  3.889624583634129*^9}, {3.889624619606833*^9, 3.8896246407686157`*^9}, {
  3.889624691375309*^9, 
  3.889624695188175*^9}},ExpressionUUID->"22066ef1-1526-4cc1-8b35-\
1a476f9bbfda"],

Cell[TextData[{
 "then if we express this in terms of the parameter ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", " ", "=", " ", 
    RowBox[{"n", " ", "+", " ", 
     RowBox[{"(", 
      RowBox[{"a", "\[Minus]", "b", "+", "1"}], ")"}]}]}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "f0fb019a-0577-4518-a8f8-dbb32e5ea1ba"],
 " we get"
}], "ExpositoryText",
 CellChangeTimes->{{3.88962464852297*^9, 3.8896246893200607`*^9}, {
