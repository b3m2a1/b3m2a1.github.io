  3.814546875145767*^9}},ExpressionUUID->"0980ea6d-8eff-44a8-9d2c-\
27f8c98260b1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["E", "n", 
     RowBox[{"(", "4", ")"}]], "-", 
    SubsuperscriptBox["E", "0", 
     RowBox[{"(", "4", ")"}]], "-", 
    SubsuperscriptBox["diag", 
     RowBox[{
     "k", "\[InvisibleSpace]\[InvisibleSpace]", "j", "\[InvisibleSpace]", 
      "l"}], 
     RowBox[{"(", "2", ")"}]]}], "=", 
   RowBox[{"6", 
    SubscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Epsilon]", "3", 
       RowBox[{"(", "4", ")"}]], ")"}], 
     RowBox[{"k", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "l"}]], 
    SubscriptBox["n", "k"], "\[InvisibleSpace]", 
    SubscriptBox["n", "j"], "\[InvisibleSpace]", 
    SubscriptBox["n", "l"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8145392977767477`*^9, 3.8145395164507437`*^9}, {
   3.814539565495068*^9, 3.814539620319025*^9}, {3.814540102925145*^9, 
   3.8145401053162117`*^9}, {3.814540390237661*^9, 3.814540395019607*^9}, {
   3.814544276393297*^9, 3.814544316520212*^9}, {3.81454455381712*^9, 
   3.814544598763447*^9}, {3.814544677685597*^9, 3.814544681844369*^9}, {
   3.814544793823398*^9, 3.814544794116481*^9}, {3.8145456533081303`*^9, 
   3.814545667149251*^9}, {3.814545704190783*^9, 3.8145457264678793`*^9}, {
   3.814545766393886*^9, 3.814545776055637*^9}, {3.814545977982993*^9, 
   3.814546064001794*^9}, 3.814546881543126*^9, 3.814547031464539*^9, {
   3.814547132877392*^9, 3.8145471420094337`*^9}, 3.81454746529722*^9, {
   3.814548842520627*^9, 3.814548848163823*^9}, {3.814549917429286*^9, 
   3.814549918502995*^9}, {3.814549953662443*^9, 3.814549967651581*^9}, {
   3.814550028566276*^9, 
   3.81455002875288*^9}},ExpressionUUID->"225d3252-ee1e-40cc-9bcb-\
ff2a0875c791"],

Cell["which is just a number", "ExpositoryText",
 CellChangeTimes->{{3.814551912109848*^9, 
  3.8145519152582703`*^9}},ExpressionUUID->"f82a7955-1bf4-4022-bcac-\
d175c3afc460"]
}, Open  ]],

Cell[CellGroupData[{

Cell["General Approach?", "Subsubsubsection",
 CellChangeTimes->{{3.8145519171696577`*^9, 3.814551919385996*^9}, {
  3.81455291220043*^9, 3.814552915520866*^9}, {3.814569036407763*^9, 
  3.814569037339229*^9}},ExpressionUUID->"1e0b1373-4955-4913-b5f4-\
df409d707cc2"],

Cell["We\[CloseCurlyQuote]ll start with", "ExpositoryText",
 CellChangeTimes->{{3.814551968211072*^9, 
  3.814551970280613*^9}},ExpressionUUID->"79453d33-c2a4-40fd-9e1e-\
6fb4274c7131"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["E", "n", 
     RowBox[{"(", "o", ")"}]], "-", 
    SubsuperscriptBox["E", "0", 
     RowBox[{"(", "o", ")"}]]}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"\[Alpha]", "=", "1"}], "M"], "\[VeryThinSpace]", 
    RowBox[{
     SubsuperscriptBox["\[Epsilon]", "\[Alpha]", 
      RowBox[{"(", "o", ")"}]], 
     SubscriptBox["\[CircleDot]", "\[Alpha]"], 
     SuperscriptBox[
      RowBox[{"(", 
       StyleBox["n",
        FontWeight->"Bold"], ")"}], "\[Alpha]"]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8145392977767477`*^9, 3.8145395164507437`*^9}, {
   3.814539565495068*^9, 3.814539620319025*^9}, {3.814540102925145*^9, 
   3.8145401053162117`*^9}, {3.814540390237661*^9, 3.814540395019607*^9}, {
   3.814544276393297*^9, 3.814544316520212*^9}, {3.8145519306623898`*^9, 
   3.814551956468553*^9}, {3.8145520000082808`*^9, 3.814552002154579*^9}, 
   3.814552038604023*^9, 3.814552186609003*^9, {3.814552366470943*^9, 
   3.814552383446419*^9}},ExpressionUUID->"63a97802-c45f-4504-b497-\
d1f6f82445ef"],

Cell[TextData[{
 "and we\[CloseCurlyQuote]ll note that to solve for all of the ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Epsilon]", "k", 
    RowBox[{"(", "o", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.8145392977767477`*^9, 3.8145395164507437`*^9}, {
   3.814539565495068*^9, 3.814539620319025*^9}, {3.814540102925145*^9, 
   3.8145401053162117`*^9}, {3.814540390237661*^9, 3.814540395019607*^9}, {
   3.814544276393297*^9, 3.814544316520212*^9}, {3.8145519306623898`*^9, 
   3.814551956468553*^9}, {3.8145520000082808`*^9, 3.814552002154579*^9}},
  ExpressionUUID->"39fb3ff7-2cde-4126-8ff0-2a9e1c8fe6dc"],
 " tensors we need every excitations with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"#quanta", " ", "\[LessEqual]", "M"}], TraditionalForm]],
  ExpressionUUID->"a2602991-ab40-4518-80bb-20f1e9e058a3"],
 "."
}], "ExpositoryText",
 CellChangeTimes->{{3.814552006901017*^9, 3.814552076910201*^9}, {
  3.814552368617156*^9, 
  3.8145523757576513`*^9}},ExpressionUUID->"3f13b996-a49d-4b83-be8b-\
2a504962d433"],

Cell["\<\
To solve for the diagonal elements of the tensors, we set up the vector \
\>", "ExpositoryText",
 CellChangeTimes->{{3.814552079101294*^9, 3.814552117737862*^9}, {
  3.8145521591795673`*^9, 
  3.814552194981618*^9}},ExpressionUUID->"a81953c0-0e0e-4f40-83b2-\
08b3ce4a130a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[CurlyEpsilon]", 
    RowBox[{"diag", ",", "i"}]], "\[VeryThinSpace]", "=", "\[VeryThinSpace]", 
   
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox["E", 
      RowBox[{
       SubscriptBox["n", "i"], "=", "m"}], 
      RowBox[{"(", "o", ")"}]], "-", 
     RowBox[{
      SubsuperscriptBox["E", "0", 
       RowBox[{"(", "o", ")"}]], " ", ":", " ", 
      RowBox[{"1", "<", "m", "<", "M"}]}]}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.814552118977396*^9, 3.814552157277301*^9}, {
  3.814552189512236*^9, 3.8145522640860767`*^9}, {3.814552391501108*^9, 
  3.814552394702489*^9}},ExpressionUUID->"a01ab0db-4566-43ff-abce-\
cdd52b456405"],

Cell["\<\
and the associated coefficient matrix has elements defined by\
\>", "ExpositoryText",
 CellChangeTimes->{{3.814552270560473*^9, 3.814552283183301*^9}, {
  3.81455231915001*^9, 
  3.814552322933817*^9}},ExpressionUUID->"e9ef7bba-8144-49c7-b1b9-\
bdd042ec03b3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     SubscriptBox["C", 
      RowBox[{"diag", ",", "i"}]], ")"}], 
    RowBox[{"\[Alpha]", "\[InvisibleSpace]", "m"}]], "=", 
   SuperscriptBox["m", "\[Alpha]"]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.814552284486038*^9, 3.81455232455165*^9}, {
  3.8145523593263903`*^9, 3.8145523609839573`*^9}, {3.814552411095613*^9, 
  3.814552453578176*^9}},ExpressionUUID->"1426e468-a20c-4b5f-b3f6-\
e4584ed0addc"],

Cell["and so we have", "ExpositoryText",
 CellChangeTimes->{{3.814552463625592*^9, 
  3.814552470495043*^9}},ExpressionUUID->"efa242da-b260-4acd-9726-\
5cb143353fdb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"(", GridBox[{
      {
       SubscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["\[Epsilon]", "1", 
          RowBox[{"(", "o", ")"}]], ")"}], "i"]},
      {
       SubscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["\[Epsilon]", "2", 
          RowBox[{"(", "o", ")"}]], ")"}], 
        RowBox[{"i", "\[InvisibleSpace]", "i"}]]},
      {"\[VerticalEllipsis]"},
      {
       SubscriptBox[
        RowBox[{"(", 
         SubsuperscriptBox["\[Epsilon]", "m", 
          RowBox[{"(", "o", ")"}]], ")"}], 
        RowBox[{"i", "\[InvisibleSpace]", "\[Ellipsis]i"}]]}
     }], ")"}], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SubscriptBox["C", 
       RowBox[{"diag", ",", "i"}]], ")"}], 
     RowBox[{"-", "1"}]], 
    RowBox[{"(", GridBox[{
       {
        RowBox[{
         SubsuperscriptBox["E", 
          RowBox[{
           SubscriptBox["n", "i"], "=", "1"}], 
          RowBox[{"(", "o", ")"}]], "-", 
         SubsuperscriptBox["E", "0", 
          RowBox[{"(", "o", ")"}]]}]},
       {
        RowBox[{
         SubsuperscriptBox["E", 
          RowBox[{
           SubscriptBox["n", "i"], "=", "2"}], 
          RowBox[{"(", "o", ")"}]], "-", 
         SubsuperscriptBox["E", "0", 
          RowBox[{"(", "o", ")"}]]}]},
       {"\[VerticalEllipsis]"},
       {
        RowBox[{
         SubsuperscriptBox["E", 
          RowBox[{
           SubscriptBox["n", "i"], "=", "m"}], 
          RowBox[{"(", "o", ")"}]], "-", 
         SubsuperscriptBox["E", "0", 
          RowBox[{"(", "o", ")"}]]}]}
      }], ")"}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.814552475365808*^9, 3.814552529650015*^9}, {
  3.814552627483499*^9, 
  3.814552703829033*^9}},ExpressionUUID->"b9dc4444-2a2c-45b0-84ac-\
5ba653884d02"],

Cell["\<\
Next we want to solve for the first off-diagonal elements, i.e. the elements \
where two modes change. To do that, we construct the matrix\
\>", "ExpositoryText",
 CellChangeTimes->{{3.81455271080564*^9, 
  3.814552758965107*^9}},ExpressionUUID->"6c0b4203-1895-47f8-b2d3-\
5c4c8bca1b2e"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[CurlyEpsilon]", 
        RowBox[{"i", "\[InvisibleSpace]", "j"}]], "(", 
       RowBox[{
        SubscriptBox["m", "1"], ",", " ", 
        SubscriptBox["m", "2"]}], ")"}], "\[VeryThinSpace]", "=", 
      "\[VeryThinSpace]", 
      RowBox[{
       SubsuperscriptBox["E", 
        RowBox[{
         RowBox[{
          SubscriptBox["n", "i"], "=", 
          SubscriptBox["m", "1"]}], ",", 
         RowBox[{
          SubscriptBox["n", "j"], "=", 
          SubscriptBox["m", "2"]}]}], 
        RowBox[{"(", "o", ")"}]], "-", 
       SubsuperscriptBox["E", "0", 
        RowBox[{"(", "o", ")"}]], "-", 
       RowBox[{
        SubscriptBox["rem", 
         RowBox[{"i", "\[InvisibleSpace]", "j"}]], "(", 
        RowBox[{
         SubscriptBox["m", "1"], ",", " ", 
         SubscriptBox["m", "2"]}], ")"}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["rem", 
        RowBox[{"i", "\[InvisibleSpace]", "j"}]], "(", 
       RowBox[{
        SubscriptBox["m", "1"], ",", " ", 
        SubscriptBox["m", "2"]}], ")"}], "=", 
      RowBox[{
       RowBox[{
        SubscriptBox["diag", "i"], "(", 
        SubscriptBox["m", "1"], ")"}], "+", 
       RowBox[{
        SubscriptBox["diag", "j"], "(", 
        SubscriptBox["m", "2"], ")"}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["diag", "i"], "(", 
       SubscriptBox["m", "1"], ")"}], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Alpha]", "=", "1"}], "M"], "\[VeryThinSpace]", 
       RowBox[{
        SubscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox["\[Epsilon]", "\[Alpha]", 
           RowBox[{"(", "o", ")"}]], ")"}], 
         RowBox[{
          RowBox[{"i", "..."}], "i"}]], 
        SuperscriptBox[
         SubscriptBox["m", "1"], "\[Alpha]"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.814552762335383*^9, 3.8145528162020617`*^9}, {
  3.814552991817157*^9, 3.8145530500426283`*^9}, {3.8145531298177013`*^9, 
  3.8145531769041557`*^9}, {3.8145685754526167`*^9, 3.8145685862534*^9}, {
  3.81456926846369*^9, 3.814569276872217*^9}, {3.8145697195600243`*^9, 
  3.814569722457773*^9}, {3.814569889810129*^9, 3.8145699245735083`*^9}, {
  3.814569958296276*^9, 3.814569986618479*^9}, {3.8145700676359177`*^9, 
  3.814570068986483*^9}, {3.814570194709285*^9, 3.814570216149745*^9}, {
  3.8145702753693123`*^9, 
  3.8145703326486998`*^9}},ExpressionUUID->"3f6ea66d-80c2-4d82-9c9f-\
0346709178f1"],

Cell["and we want to solve for all the terms looking like", "ExpositoryText",
 CellChangeTimes->{{3.81455287536913*^9, 3.814552881400659*^9}, {
  3.814554390445263*^9, 3.814554398145873*^9}, {3.8145659040790567`*^9, 
  3.814565906795425*^9}, {3.814567823793427*^9, 
  3.81456783047803*^9}},ExpressionUUID->"a0d53dcd-8dae-42e3-ad49-\
8c83363f200b"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      RowBox[{"(", 
       SubsuperscriptBox["\[Epsilon]", "\[Alpha]", 
        RowBox[{"(", "o", ")"}]], ")"}], "p"], ":", " ", 
     RowBox[{"p", " ", "\[Element]", " ", 
      RowBox[{
       RowBox[{"odinds", "(", 
        RowBox[{"\[Alpha]", ",", " ", "2"}], ")"}], " ", "and", " ", 
       RowBox[{
        SubscriptBox["\[ForAll]", 
         SubscriptBox["p", "k"]], " ", 
        SubscriptBox["p", "k"]}]}]}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"i", " ", "or", " ", 
      SubscriptBox["p", "k"]}], " ", "=", " ", "j"}]}], " ", "}"}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.814567847501895*^9, 3.814567847505701*^9}, {
   3.814567886503892*^9, 3.814568153338451*^9}, 
   3.814568863339304*^9},ExpressionUUID->"927b11e8-545f-4eda-a55a-\
98f0dee930fe"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"odinds", "(", "\[Alpha]", ")"}], TraditionalForm]],ExpressionUUID->
  "301b1ed5-6e7e-42d0-96a3-92423584469a"],
 " is the set of off-diagonal indices of a rank \[Alpha] tensor where there \
are only two distinct indices. It\[CloseCurlyQuote]s not entirely clear right \
now how we want to construct this, but at the least it is clearly \
constructable. For each ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "2da98af8-480a-47e3-bfab-6938b08c6c08"],
 " we can define an associated coefficient function"
}], "ExpositoryText",
 CellChangeTimes->{{3.814568048282382*^9, 3.814568087837263*^9}, {
  3.8145681584180307`*^9, 3.814568199653816*^9}, {3.814568393111763*^9, 
  3.8145684397868834`*^9}},ExpressionUUID->"64b1bd4e-0d8d-49bb-87a6-\
bd349896a0e0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Epsilon]coeff", 
     RowBox[{"i", "\[InvisibleSpace]", "j"}]], "(", 
    RowBox[{"p", ",", " ", 
     SubscriptBox["m", "1"], ",", " ", 
     SubscriptBox["m", "2"]}], ")"}], "=", 
   RowBox[{
    SuperscriptBox[
     SubscriptBox["m", "1"], 
     RowBox[{"count", "(", 
      RowBox[{"p", ",", " ", "i"}], ")"}]], 
    SuperscriptBox[
     SubscriptBox["m", "2"], 
     RowBox[{"count", "(", 
      RowBox[{"p", ",", " ", "j"}], ")"}]]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.814568441260139*^9, 3.814568458828567*^9}, {
  3.8145685597361803`*^9, 3.8145685933632517`*^9}, {3.8145686481876297`*^9, 
  3.8145686736980753`*^9}, {3.81457122854081*^9, 
  3.814571251540268*^9}},ExpressionUUID->"68413f70-02b1-4e3d-8600-\
68adf5f18be8"],

Cell["\<\
and all of this gives us a way to construct a set of linear equations\
\>", "ExpositoryText",
 CellChangeTimes->{{3.814568684329609*^9, 3.8145687591622467`*^9}, 
   3.814568814088725*^9},ExpressionUUID->"09eb81e1-21ad-4f4f-a58c-\
3e38145d5d6a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[Sum]", "\[Alpha]"], 
    RowBox[{
     UnderscriptBox["\[Sum]", "p"], "\[VeryThinSpace]", 
     RowBox[{
      SubscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox["\[Epsilon]", "\[Alpha]", 
         RowBox[{"(", "o", ")"}]], ")"}], "p"], 
      RowBox[{
       SubscriptBox["\[Epsilon]coeff", 
        RowBox[{"i", "\[InvisibleSpace]", "j"}]], "(", 
       RowBox[{"p", ",", " ", 
        SubscriptBox["m", "1"], ",", " ", 
        SubscriptBox["m", "2"]}], ")"}]}]}]}], "=", 
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", 
     RowBox[{"i", "\[InvisibleSpace]", "j"}]], "(", 
    RowBox[{
     SubscriptBox["m", "1"], ",", " ", 
     SubscriptBox["m", "2"]}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.814568732832795*^9, 3.814568804907445*^9}, 
   3.814568859313796*^9, {3.8145704933294897`*^9, 
   3.814570511001721*^9}},ExpressionUUID->"3b4bfed5-d854-4741-9e75-\
0d7c74d58b96"],

Cell[TextData[{
 "if we have ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],ExpressionUUID->
  "47d2a6ee-776a-4b64-8f50-59760e162cb4"],
 " coefficients, we simply need to pick enough distinct combinations of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "i"], TraditionalForm]],ExpressionUUID->
  "e40a280b-67b9-4d53-886d-22c7f068dec3"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "j"], TraditionalForm]],ExpressionUUID->
  "808870de-0b2e-487d-87ae-2297a5b0f9f8"],
 " to solve for the remaining terms by constructing the appropriate ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Epsilon]coeff", 
     RowBox[{"i", "\[InvisibleSpace]", "j"}]], "(", 
    RowBox[{"p", ",", " ", 
     SubscriptBox["m", "1"], ",", " ", 
     SubscriptBox["m", "2"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "afe8fca5-47ae-4d7a-b237-88c34b857618"],
 " matrix and inverting."
}], "ExpositoryText",
 CellChangeTimes->{{3.8145689394404097`*^9, 3.814569028633336*^9}, {
  3.814571270883086*^9, 3.814571276421282*^9}, {3.814571314892847*^9, 
  3.814571366474123*^9}},ExpressionUUID->"089b4555-4d39-4c55-b223-\
c7f1bec490a2"],

Cell["Moving onto the case where 3 indices are distinct, we have", \
"ExpositoryText",
 CellChangeTimes->{{3.814569281471221*^9, 
  3.814569316356948*^9}},ExpressionUUID->"6aa1a8b6-18a3-4133-8929-\
f7a2f663aea0"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[CurlyEpsilon]", 
        RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]], 
       "\[VeryThinSpace]", "(", 
       RowBox[{
        SubscriptBox["m", "1"], ",", " ", 
        SubscriptBox["m", "2"], ",", " ", 
        SubscriptBox["m", "3"]}], ")"}], "=", "\[VeryThinSpace]", 
      RowBox[{
       SubsuperscriptBox["E", 
        RowBox[{
         RowBox[{
          SubscriptBox["n", "i"], "=", 
          SubscriptBox["m", "1"]}], ",", 
         RowBox[{
          SubscriptBox["n", "j"], "=", 
          SubscriptBox["m", "2"]}], ",", 
         RowBox[{
          SubscriptBox["n", "k"], "=", 
          SubscriptBox["m", "3"]}]}], 
        RowBox[{"(", "o", ")"}]], "-", 
       SubsuperscriptBox["E", "0", 
        RowBox[{"(", "o", ")"}]], "-", 
       RowBox[{
        SubscriptBox["rem", 
         RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]], 
        "(", 
        RowBox[{
         SubscriptBox["m", "1"], ",", " ", 
         SubscriptBox["m", "2"], ",", " ", 
         SubscriptBox["m", "3"]}], ")"}]}]}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["rem", 
         RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]], 
        "(", 
        RowBox[{
         SubscriptBox["m", "1"], ",", " ", 
         SubscriptBox["m", "2"], ",", " ", 
         SubscriptBox["m", "3"]}], ")"}], "=", 
       RowBox[{
        RowBox[{
         SubscriptBox["diag2", 
          RowBox[{"i", "\[InvisibleSpace]", "j"}]], "(", 
         RowBox[{
          SubscriptBox["m", "1"], ",", " ", 
          SubscriptBox["m", "2"]}], ")"}], "+", 
        RowBox[{
         SubscriptBox["diag2", 
          RowBox[{"i", "\[InvisibleSpace]", "j"}]], "(", 
         RowBox[{
          SubscriptBox["m", "1"], ",", " ", 
          SubscriptBox["m", "3"]}], ")"}], "+", 
        RowBox[{
         SubscriptBox["diag2", 
          RowBox[{"j", "\[InvisibleSpace]", "k"}]], "(", 
         RowBox[{
          SubscriptBox["m", "2"], ",", " ", 
          SubscriptBox["m", "3"]}], ")"}]}]}], "\[LineSeparator]", 
      RowBox[{
       RowBox[{"+", 
        RowBox[{
         SubscriptBox["diag", "i"], "(", 
         SubscriptBox["m", "1"], ")"}]}], "+", 
       RowBox[{
        SubscriptBox["diag", "j"], "(", 
        SubscriptBox["m", "1"], ")"}], "+", 
       RowBox[{
        SubscriptBox["diag", "k"], "(", 
        SubscriptBox["m", "1"], ")"}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["diag2", 
        RowBox[{"i", "\[InvisibleSpace]", "j"}]], "(", 
       RowBox[{
        SubscriptBox["n", "i"], ",", " ", 
        SubscriptBox["n", "j"]}], ")"}], "=", 
      RowBox[{
       UnderscriptBox["\[Sum]", "\[Alpha]"], 
       RowBox[{
        UnderscriptBox["\[Sum]", "p"], "\[VeryThinSpace]", 
        RowBox[{
         SubscriptBox[
          RowBox[{"(", 
           SubsuperscriptBox["\[Epsilon]", "\[Alpha]", 
            RowBox[{"(", "o", ")"}]], ")"}], "p"], 
         RowBox[{
          SubscriptBox["\[Epsilon]coeff", 
           RowBox[{"i", "\[InvisibleSpace]", "j"}]], "(", 
          RowBox[{"p", ",", " ", 
           SubscriptBox["n", "i"], ",", " ", 
           SubscriptBox["n", "j"]}], ")"}]}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8145693175242853`*^9, 3.814569319590063*^9}, {
   3.814569375423626*^9, 3.814569386405356*^9}, {3.814569702225176*^9, 
   3.814569735870697*^9}, 3.814569806186481*^9, {3.814570022691011*^9, 
   3.81457006096397*^9}, {3.814570093208473*^9, 3.814570103768077*^9}, {
   3.814570257113832*^9, 3.814570268235517*^9}, {3.814570379406734*^9, 
   3.8145704802973547`*^9}, {3.814571057331442*^9, 3.814571084980524*^9}, {
   3.8145711289358807`*^9, 3.814571182619789*^9}, {3.81457788689043*^9, 
   3.8145779097225227`*^9}},ExpressionUUID->"463ae1e8-19c5-4062-9eb8-\
b32f8a4ad9c6"],

Cell["and then we\[CloseCurlyQuote]ll have", "ExpositoryText",
 CellChangeTimes->{{3.814571191272184*^9, 
  3.814571201649932*^9}},ExpressionUUID->"68566554-fb98-4147-b291-\
7063387b0650"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[Sum]", "\[Alpha]"], 
    RowBox[{
     UnderscriptBox["\[Sum]", "p"], "\[VeryThinSpace]", 
     RowBox[{
      SubscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox["\[Epsilon]", "\[Alpha]", 
         RowBox[{"(", "o", ")"}]], ")"}], "p"], 
      RowBox[{
       SubscriptBox["\[Epsilon]coeff", 
        RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]], 
       "(", 
       RowBox[{"p", ",", " ", 
        SubscriptBox["m", "1"], ",", " ", 
        SubscriptBox["m", "2"], ",", " ", 
        SubscriptBox["m", "3"]}], ")"}]}]}]}], "=", 
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", 
     RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]], "(", 
    
    RowBox[{
     SubscriptBox["m", "1"], ",", " ", 
     SubscriptBox["m", "2"], ",", " ", 
     SubscriptBox["m", "3"]}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.814568732832795*^9, 3.814568804907445*^9}, 
   3.814568859313796*^9, {3.8145704933294897`*^9, 3.814570511001721*^9}, {
   3.814571211865924*^9, 3.814571216604205*^9}, {3.814575479832466*^9, 
   3.8145754855561447`*^9}},ExpressionUUID->"4bf75a79-ace9-49e0-9838-\
2e615f4f8582"],

Cell["and it should be possible at this point to see how we extend", \
"ExpositoryText",
 CellChangeTimes->{{3.81457547265068*^9, 
  3.814575509978294*^9}},ExpressionUUID->"3504554d-d8a8-4ea9-894e-\
7bba835b6c70"],

Cell[CellGroupData[{

Cell["Proof Induction", "Subsubsubsubsection",
 CellChangeTimes->{{3.814575824436646*^9, 
  3.814575828796364*^9}},ExpressionUUID->"6a4d7c63-6941-4158-ad52-\
8261764a698c"],

Cell[TextData[{
 "We\[CloseCurlyQuote]ll assume that we have all of the terms that involve ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "d4a2d529-bdc8-4335-843b-b3d2e89e0655"],
 " or fewer indices, then we can define"
}], "ExpositoryText",
 CellChangeTimes->{{3.814575499057111*^9, 3.8145755309309683`*^9}, {
  3.814575759332547*^9, 3.814575779237743*^9}, {3.8145758212488737`*^9, 
  3.8145758212489347`*^9}, {3.8145779378246937`*^9, 
  3.8145779378247766`*^9}},ExpressionUUID->"68e4f518-ab57-4d62-8025-\
17ba892be9e2"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[CurlyEpsilon]", 
        RowBox[{
         SubscriptBox[
          RowBox[{"i", "\[InvisibleSpace]"}], "1"], "\[Ellipsis]", 
         "\[InvisibleSpace]", 
         SubscriptBox["i", "n"]}]], "\[VeryThinSpace]", "(", 
       RowBox[{
        SubscriptBox["m", "1"], ",", " ", "\[Ellipsis]", ",", " ", 
        SubscriptBox["m", "n"]}], ")"}], "=", "\[VeryThinSpace]", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["E", 
         RowBox[{
          SubscriptBox[
           RowBox[{"i", "\[InvisibleSpace]"}], "1"], "\[Ellipsis]", 
          "\[InvisibleSpace]", 
          SubscriptBox["i", "n"]}], 
         RowBox[{"(", "o", ")"}]], "(", 
        RowBox[{
         SubscriptBox["m", "1"], ",", " ", "\[Ellipsis]", ",", " ", 
         SubscriptBox["m", "n"]}], ")"}], "-", 
       SubsuperscriptBox["E", "0", 
        RowBox[{"(", "o", ")"}]], "-", 
       RowBox[{
        SubscriptBox["rem", 
         RowBox[{
          SubscriptBox[
           RowBox[{"i", "\[InvisibleSpace]"}], "1"], "\[Ellipsis]", 
          "\[InvisibleSpace]", 
          SubscriptBox["i", "n"]}]], "(", 
        RowBox[{
         SubscriptBox["m", "1"], ",", " ", "\[Ellipsis]", ",", " ", 
         SubscriptBox["m", "n"]}], ")"}]}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["rem", 
        RowBox[{
         SubscriptBox[
          RowBox[{"i", "\[InvisibleSpace]"}], "1"], "\[Ellipsis]", 
         "\[InvisibleSpace]", 
         SubscriptBox["i", "n"]}]], "(", 
       RowBox[{
        SubscriptBox["m", "1"], ",", " ", "\[Ellipsis]", ",", " ", 
        SubscriptBox["m", "n"]}], ")"}], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Alpha]", "=", "1"}], "n"], "\[VeryThinSpace]", 
       RowBox[{
        SubsuperscriptBox["\[Epsilon]", "\[Alpha]", 
         RowBox[{"(", "o", ")"}]], 
        SubscriptBox["\[CircleDot]", "\[Alpha]"], 
        SuperscriptBox[
         RowBox[{"(", 
          StyleBox["n",
           FontWeight->"Bold"], ")"}], "\[Alpha]"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8145757862593203`*^9, 3.81457581608908*^9}, {
  3.8145778311666727`*^9, 3.8145778616019382`*^9}, {3.8145779162161283`*^9, 
  3.814577941787072*^9}, {3.814578554535324*^9, 
  3.8145785782352743`*^9}},ExpressionUUID->"f31d397d-b272-46db-a1a0-\
9bc69e5246d8"]
}, Open  ]]
}, Open  ]]
}, Closed]]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["State Indexing", "Section",
 CellChangeTimes->{{3.8148849526973553`*^9, 3.814884953628088*^9}, {
  3.816097329777651*^9, 3.816097332752124*^9}, {3.81708408073657*^9, 
  3.817084083347575*^9}},ExpressionUUID->"85a127c9-92bd-410b-814c-\
5aa0019aafd1"],

Cell["\<\
We need to be able to do efficient indexing of states, which can be expressed \
as vectors of quanta of excitation in our different modes. The basic tack we\
\[CloseCurlyQuote]ll take is to order by number of quanta of excitation, then \
lexicographically based on the partition of the total number of quanta, and \
finally lexicographically based for the permutation of that partition.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8170840854765778`*^9, 3.817084109952634*^9}, {
  3.817084157753169*^9, 3.817084210588575*^9}, {3.8171204161249647`*^9, 
  3.817120489421089*^9}},ExpressionUUID->"3ab82dc8-53d4-402a-839e-\
a56b7ef2cf10"],

Cell["\<\
This has many nice features, for one, the ground state is always the first \
state, the states are ordered in terms of quanta of excitation, and then \
states are ordered by how few modes they touch. On the other hand, these \
numbers will still grow quite quickly. \
\>", "ExpositoryText",
 CellChangeTimes->{{3.81712049537927*^9, 
  3.8171205985745792`*^9}},ExpressionUUID->"c8713d2e-b2fc-4627-b544-\
8e49f2e30d65"],

Cell["\<\
For a given number of total quanta of excitation, there will be some number \
of integer partitionings. For each of those partitionings, the number of \
distinct permutations is given by\
\>", "ExpositoryText",
 CellChangeTimes->{{3.81712049537927*^9, 3.817120638794643*^9}, {
  3.817120673496962*^9, 3.817120680168446*^9}, {3.817124082183742*^9, 
  3.817124083857923*^9}},ExpressionUUID->"b5ce44d8-eed0-4b51-a13b-\
b7b1e6882c2e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"perms", "(", "p", ")"}], "=", 
   FractionBox[
    RowBox[{"D", "!"}], 
    RowBox[{
     StyleBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{"D", "-", 
         RowBox[{"\[LeftBracketingBar]", "p", "\[RightBracketingBar]"}]}], 
        ")"}], "!"}],
      FontSize->14], 
     RowBox[{
      StyleBox[
       UnderscriptBox[
        StyleBox["\[Product]",
         FontSize->14], "i"],
       FontSize->14], "\[VeryThinSpace]", 
      SubscriptBox[
       StyleBox[
        RowBox[{
         StyleBox["#",
          FontSize->14], "p"}]], "i"]}]}]]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.817120681569368*^9, 3.8171207013281593`*^9}, {
  3.8171209460559196`*^9, 3.817120979404449*^9}, {3.817121268521381*^9, 
  3.8171213002703*^9}},
 PrivateFontOptions->{
 "OperatorSubstitution"->
  False},ExpressionUUID->"d6937b87-1861-4603-bfd9-c19f7914ae81"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox[
     RowBox[{"#", 
      StyleBox["p",
       FontSlant->"Italic"]}]], "i"], ExpositoryMath]],ExpressionUUID->
  "709e7756-7086-48c0-8c8e-e8f90b13b72f"],
 " gives the number of times ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "i"], TraditionalForm]],ExpressionUUID->
  "f46569a2-54c1-478d-8d69-7620e47f813c"],
 " appears in the partition."
}], "ExpositoryText",
 CellChangeTimes->{{3.817120982181942*^9, 3.817121016421126*^9}, {
  3.8171210988514547`*^9, 
  3.817121158259247*^9}},ExpressionUUID->"6ea7b762-c361-4a16-a34d-\
c2e5672f368f"],

Cell[CellGroupData[{

Cell["Permutation Indexing", "Subsection",
 CellChangeTimes->{{3.83138510197523*^9, 
  3.831385105773036*^9}},ExpressionUUID->"1380ef0f-3e2f-42bf-9040-\
6c724909c7fb"],

Cell["We can write a function that counts these like", "ExpositoryText",
 CellChangeTimes->{{3.817121159948614*^9, 
  3.817121168571858*^9}},ExpressionUUID->"a7161bec-1363-4bb0-a005-\
f3376ff927ba"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"numPerms", "[", 
   RowBox[{"p_", ",", " ", "dim_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"dim", "!"}], "/", 
   RowBox[{"Apply", "[", 
    RowBox[{"Times", ",", " ", "\[IndentingNewLine]", 
     RowBox[{"Factorial", "[", "\[IndentingNewLine]", 
      RowBox[{"Append", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Values", "[", 
         RowBox[{"Counts", "[", "p", "]"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"dim", "-", 
         RowBox[{"Length", "[", "p", "]"}]}]}], "\[IndentingNewLine]", "]"}], 
      "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"numStates", "[", 
   RowBox[{"nq_Integer", ",", " ", "dim_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Sum", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numPerms", "[", 
     RowBox[{"p", ",", " ", "dim"}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", 
      RowBox[{"IntegerPartitions", "[", "nq", "]"}]}], "}"}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.817121171062965*^9, 3.817121248837434*^9}, {
  3.817121394902789*^9, 3.8171214601022663`*^9}, {3.817122428463743*^9, 
  3.817122462919348*^9}, {3.817122565561784*^9, 3.817122566046897*^9}},
 CellLabel->
  "In[719]:=",ExpressionUUID->"aa090d0d-bb18-466b-8379-14651d7a6b22"],

Cell["\<\
which allows us to figure out, say, how many 10 quantum states there are in a \
system of dimension 100\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8171214683086042`*^9, 3.817121490779561*^9}, {
  3.81712153950439*^9, 
  3.817121542523184*^9}},ExpressionUUID->"de4c6b6e-bff9-4b6c-a272-\
b3f52908957f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"2", "^", "64"}], "-", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{"numStates", "[", 
     RowBox[{"i", ",", " ", "377"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", "10"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8171214928787327`*^9, 3.817121531131681*^9}, {
  3.819934913143711*^9, 3.81993498066929*^9}, {3.8199351415147467`*^9, 
  3.819935169670292*^9}},
 CellLabel->
  "In[918]:=",ExpressionUUID->"fb3b2892-6272-4ceb-a232-a3ae1a1f5f57"],

Cell[BoxData[
 RowBox[{"-", "21640509651853999"}]], "Output",
 CellChangeTimes->{{3.817121500448488*^9, 3.817121531549953*^9}, {
  3.8199349133366203`*^9, 3.819934981266897*^9}, {3.819935141871286*^9, 
  3.8199351699055347`*^9}},
 CellLabel->
  "Out[918]=",ExpressionUUID->"00baa11d-f080-480d-8917-dfc2ba5f1f66"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sum", "[", 
  RowBox[{
   RowBox[{"numStates", "[", 
    RowBox[{"i", ",", " ", "350"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"i", ",", " ", "10"}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[909]:=",ExpressionUUID->"85ebac4e-1cba-484c-9873-5f5d82f306a7"],

Cell[BoxData["8881600973913295055"], "Output",
 CellChangeTimes->{3.819935089041107*^9},
 CellLabel->
  "Out[909]=",ExpressionUUID->"f9f6fc7b-0e05-43c2-9612-75a3ac9fbf68"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sum", "[", 
  RowBox[{
   RowBox[{"numStates", "[", 
    RowBox[{"i", ",", " ", "350"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"i", ",", " ", "10"}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[905]:=",ExpressionUUID->"1fe1e846-03f1-4b49-9573-5c2b4294d6d2"],

Cell[BoxData["8881600973913295055"], "Output",
 CellChangeTimes->{3.819934996493465*^9},
 CellLabel->
  "Out[905]=",ExpressionUUID->"6cb7a5b9-f84f-47e7-a7c0-e6bfab1f417e"]
}, Open  ]],

Cell["or how many \[LessEqual]10 quanta states there are at dimension 100", \
"ExpositoryText",
 CellChangeTimes->{{3.817121545883719*^9, 3.81712157488577*^9}, {
  3.819934964617846*^9, 
  3.8199349649003067`*^9}},ExpressionUUID->"33bff193-8293-46a3-bdd3-\
8e130d66247a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sum", "[", 
  RowBox[{
   RowBox[{"numStates", "[", 
    RowBox[{"i", ",", " ", "100"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"i", ",", " ", "10"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.8171215795660143`*^9, 3.817121588885235*^9}, {
  3.828099182740653*^9, 3.828099212952533*^9}},
 CellLabel->
  "In[728]:=",ExpressionUUID->"d630377f-a273-4c7f-adff-4a679b322d5a"],

Cell[BoxData["46897636623980"], "Output",
 CellChangeTimes->{
  3.817121589679513*^9, {3.828099186118615*^9, 3.8280992134114017`*^9}},
 CellLabel->
  "Out[728]=",ExpressionUUID->"6679d974-b612-4a8b-b9c9-f3a17d216093"]
}, Open  ]],

Cell["\<\
(we can see that it\[CloseCurlyQuote]s really dominated by those 10 quantum \
states)\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8171215945869913`*^9, 
  3.817121608473926*^9}},ExpressionUUID->"c4b848be-cfeb-4c10-b437-\
c5521132de06"],

Cell["\<\
Overall, this is a plus, as it means we can index up to large-ish numbers of \
quanta in a \[OpenCurlyDoubleQuote]global\[CloseCurlyDoubleQuote] fashion.\
\>", "ExpositoryText",
 CellChangeTimes->{{3.817121610859209*^9, 3.817121637520939*^9}, 
   3.8171216772663183`*^9},ExpressionUUID->"9e183a29-c485-4b1a-a994-\
d293bfeba753"],

Cell[CellGroupData[{

Cell["Generating Indices", "Subsubsection",
 CellChangeTimes->{{3.817121697070661*^9, 
  3.817121699308567*^9}},ExpressionUUID->"270e0d08-143d-46a5-8438-\
7c8641ed27e3"],

Cell["\<\
The next issue we have is actually generating the indices \
we\[CloseCurlyQuote]ll need. To do this, let\[CloseCurlyQuote]s consider the \
concrete case of the state (1, 4, 3, 1, 0, 0, 0, 1, 0) which is in 9D space, \
so maybe it\[CloseCurlyQuote]s like for methane or something. Our first step \
will be to get the total number of quanta in the state\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8171217005300817`*^9, 3.817121713467638*^9}, {
  3.817121892863597*^9, 3.817121899104555*^9}, {3.817121940707131*^9, 
  3.817121943796974*^9}, {3.817121976476375*^9, 
  3.8171220887980328`*^9}},ExpressionUUID->"493b5214-cf9a-4329-9bdf-\
c7da4db0a181"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{"#quanta", " ", "=", " ", 
      RowBox[{"1", "+", "4", "+", "3", "+", "1", "+", "1"}]}]},
    {
     RowBox[{"=", " ", "10"}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.817122089821292*^9, 3.8171220984995823`*^9}, {
  3.817122207671775*^9, 3.817122220233886*^9}},
 PrivateFontOptions->{
 "OperatorSubstitution"->
  False},ExpressionUUID->"63bdfd70-d958-47f6-a6d6-9ba580d2f45f"],

Cell["\<\
then we reverse sort the list (alternately, sort its negation)\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8171222239016933`*^9, 
  3.8171223197965508`*^9}},ExpressionUUID->"f3c4f7e9-46fa-4f98-a850-\
7db1d68c999a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"revsorted", "(", "s", ")"}], "=", 
   RowBox[{"(", 
    RowBox[{
    "4", ",", " ", "3", ",", " ", "1", ",", " ", "1", ",", " ", "1", ",", " ",
      "0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.817122240247087*^9, 3.8171222595022297`*^9}, {
  3.817122327289814*^9, 
  3.81712234105324*^9}},ExpressionUUID->"71a27339-0955-4e88-a4e4-\
81732f6a0c2b"],

Cell["and find how many integer partitions came before it", "ExpositoryText",
 CellChangeTimes->{{3.817122345616823*^9, 
  3.81712236715245*^9}},ExpressionUUID->"1c1ec80d-5d09-4beb-82d6-\
8d388e30e75c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TakeWhile", "[", 
  RowBox[{
   RowBox[{"IntegerPartitions", "[", "10", "]"}], ",", " ", 
   RowBox[{
    RowBox[{"#", "\[NotEqual]", 
     RowBox[{"{", 
      RowBox[{
      "4", ",", " ", "3", ",", " ", "1", ",", " ", "1", ",", " ", "1"}], 
      "}"}]}], "&"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.817122375044155*^9, 3.817122413549312*^9}},
 CellLabel->
  "In[1698]:=",ExpressionUUID->"98303d9a-40d1-404d-bd51-0dc7dd3869c1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "10", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"9", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"8", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"8", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"7", ",", "3"}], "}"}], ",", 
