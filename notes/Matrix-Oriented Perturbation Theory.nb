8485765174f0"],

Cell[TextData[{
 "Obviously, this is just a bunch of products of matrix elements! And \
everything commutes! The next key thing to realize is that any time we have a \
",
 Cell[BoxData[
  FormBox["1", TraditionalForm]],ExpressionUUID->
  "f7231077-b75f-4d47-a8a7-2a1340ba5a27"],
 " in the sequence, this allows us to split up the product into two products, \
e.g. let\[CloseCurlyQuote]s say ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "r"], "=", "1"}], TraditionalForm]],ExpressionUUID->
  "d7935a78-1d2f-4d0f-a4fe-a792d4c86ee8"],
 ",  this allows us to write"
}], "ExpositoryText",
 CellChangeTimes->{{3.827875296028672*^9, 3.827875372829056*^9}, {
  3.827877217014762*^9, 
  3.827877248250085*^9}},ExpressionUUID->"0cafdae0-757b-46e8-bc04-\
55c2ac3bd139"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], 
       RowBox[{
        SubscriptBox["\[GothicCapitalD]", "n"], "(", 
        RowBox[{"M", ",", " ", "p", ",", " ", "t"}], ")"}], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], "(", "\[VeryThinSpace]", 
        RowBox[{
         RowBox[{
          UnderoverscriptBox["\[Product]", 
           RowBox[{"i", "=", "1"}], 
           RowBox[{"r", "-", "1"}]], 
          RowBox[{
           SubsuperscriptBox["\[CapitalOmega]", "n", 
            RowBox[{"(", 
             SubscriptBox["p", "i"], ")"}]], 
           SubscriptBox["\[Delta]", 
            RowBox[{
             SubscriptBox["t", "i"], "0"}]]}]}], "+", 
         RowBox[{
          SubsuperscriptBox["\[CapitalGamma]", "n", 
           RowBox[{"(", 
            SubscriptBox["p", "i"], ")"}]], 
          SubscriptBox["\[Delta]", 
           RowBox[{
            SubscriptBox["t", "i"], "1"}]]}]}], ")"}], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", 
         StyleBox[
          SubscriptBox["p", "r"],
          FontSize->14], ")"}]], 
       TemplateBox[{
         RowBox[{"\[VeryThinSpace]", 
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]}]},
        "Ket"], 
       RowBox[{
        TemplateBox[{
          SuperscriptBox["m", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], "(", "\[VeryThinSpace]", 
        RowBox[{
         RowBox[{
          UnderoverscriptBox["\[Product]", 
           RowBox[{"i", "=", 
            RowBox[{"r", "+", "1"}]}], 
           RowBox[{"M", "-", "1"}]], 
          RowBox[{
           SubsuperscriptBox["\[CapitalOmega]", "n", 
            RowBox[{"(", 
             SubscriptBox["p", "i"], ")"}]], 
           SubscriptBox["\[Delta]", 
            RowBox[{
             SubscriptBox["t", "i"], "0"}]]}]}], "+", 
         RowBox[{
          SubsuperscriptBox["\[CapitalGamma]", "n", 
           RowBox[{"(", 
            SubscriptBox["p", "i"], ")"}]], 
          SubscriptBox["\[Delta]", 
           RowBox[{
            SubscriptBox["t", "i"], "1"}]]}]}], ")"}], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", 
         SubscriptBox["p", "M"], ")"}]], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], 
       RowBox[{
        SubscriptBox["\[GothicCapitalD]", "n"], "(", 
        RowBox[{"r", ",", " ", 
         RowBox[{"p", "[", 
          RowBox[{":", "r"}], "]"}], ",", " ", 
         RowBox[{"t", "[", 
          RowBox[{":", "r"}], "]"}]}], ")"}], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], 
       RowBox[{
        SubscriptBox["\[GothicCapitalD]", "n"], "(", 
        RowBox[{
         RowBox[{"M", "-", "r"}], ",", " ", 
         RowBox[{"p", "[", 
          RowBox[{
           RowBox[{"r", "+", "1"}], ":"}], "]"}], ",", " ", 
         RowBox[{"t", "[", 
          RowBox[{
           RowBox[{"r", "+", "1"}], ":"}], "]"}]}], ")"}], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.827875377687532*^9, 3.827875426583523*^9}, {
   3.827875461064253*^9, 3.82787549840467*^9}, 3.8278757715006437`*^9, {
   3.8278758129017572`*^9, 
   3.827875903244787*^9}},ExpressionUUID->"333f9ea1-3bbb-4ca5-8148-\
668573b4bccb"],

Cell[TextData[{
 "which the immediate benefit that we have recovered commutativity. We can go \
further than this, though, and say that there is a sequence ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox["r", "j"], "}"}], TraditionalForm]],ExpressionUUID->
  "6f1ddbd4-925f-4f6d-96aa-90c184416c0b"],
 " of length ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", "r", "\[RightBracketingBar]"}], 
   TraditionalForm]],ExpressionUUID->"bf75ca4f-e0cc-452e-be6f-985fb3648724"],
 " that provides the positions of every 1 in ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "21310296-e730-428a-a651-43e7e2df2033"],
 ", so we can now write"
}], "ExpositoryText",
 CellChangeTimes->{{3.8278757629951677`*^9, 3.8278757956566257`*^9}, {
  3.827875909197358*^9, 3.8278760655291977`*^9}, {3.827876137287127*^9, 
  3.827876147383873*^9}, {3.827931131617566*^9, 3.827931203963732*^9}, {
  3.82793212889351*^9, 
  3.8279321484060183`*^9}},ExpressionUUID->"bc0dbce6-8a2d-4f66-9ebc-\
97c0262c2683"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], 
    RowBox[{
     SubscriptBox["\[GothicCapitalD]", "n"], "(", 
     RowBox[{"M", ",", " ", "p", ",", " ", "t"}], ")"}], 
    TemplateBox[{
      SuperscriptBox["m", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], "(", "\[VeryThinSpace]", 
     RowBox[{
      UnderoverscriptBox["\[Product]", 
       RowBox[{"i", "=", "1"}], 
       RowBox[{
        SubscriptBox["r", "1"], "-", "1"}]], 
      SubsuperscriptBox["\[CapitalOmega]", "n", 
       RowBox[{"(", 
