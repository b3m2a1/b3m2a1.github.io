Cell[BoxData[
 FormBox[
  RowBox[{"\[AlignmentMarker]", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       SuperscriptBox["i", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     SubsuperscriptBox["P", "D", 
      RowBox[{"(", "\[Beta]", ")"}]], 
