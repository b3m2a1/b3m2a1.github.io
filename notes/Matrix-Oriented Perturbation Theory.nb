Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["m", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"], 
        SubsuperscriptBox["\[GothicCapitalO]", "n", 
         RowBox[{"(", "p", ")"}]]}], 
       SubsuperscriptBox["\[VerticalSeparator]", "a", "b"], 
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       RowBox[{
        TemplateBox[{
          SuperscriptBox["m", 
