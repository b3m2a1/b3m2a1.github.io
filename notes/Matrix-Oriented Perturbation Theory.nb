Cell["Before setting out to prove anything, though, we\[CloseCurlyQuote]ll \
look at ", "ExpositoryText",
 CellChangeTimes->{{3.825948950971159*^9, 3.825948952827065*^9}, {
  3.825948985929294*^9, 
  3.82594901233881*^9}},ExpressionUUID->"2f211135-1074-4baf-80af-\
30ffb0fb2557"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"S", "(", 
       SuperscriptBox["G", 
        RowBox[{"(", "3", ")"}]], ")"}], "=", "\[AlignmentMarker]", 
      RowBox[{
       RowBox[{"(", " ", 
        RowBox[{
         UnderoverscriptBox["\[Union]", 
          RowBox[{"i", "=", "0"}], "2"], " ", 
         RowBox[{
          RowBox[{"S", "(", 
           SuperscriptBox["H", 
            RowBox[{"(", 
             RowBox[{"k", "-", "i"}], ")"}]], ")"}], "\[CircleTimes]", 
          RowBox[{"S", "(", 
           SuperscriptBox["G", 
            RowBox[{"(", "i", ")"}]], ")"}]}]}], " ", ")"}], " ", "\[Union]", 
       " ", 
       RowBox[{
        RowBox[{"(", " ", 
         RowBox[{
          UnderoverscriptBox["\[Union]", 
           RowBox[{"i", "=", "0"}], "2"], " ", 
          RowBox[{"S", "(", 
           SuperscriptBox["H", 
            RowBox[{"(", 
             RowBox[{"k", "-", "i"}], ")"}]], ")"}]}], " ", ")"}], " ", "\\", 
        " ", 
        RowBox[{"{", "e", "}"}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"S", "(", 
         SuperscriptBox["H", 
          RowBox[{"(", "2", ")"}]], ")"}], "\[CircleTimes]", 
        RowBox[{"S", "(", 
         SuperscriptBox["G", 
          RowBox[{"(", "1", ")"}]], ")"}]}], "\[Union]", 
       RowBox[{
        RowBox[{"S", "(", 
         SuperscriptBox["H", 
          RowBox[{"(", "1", ")"}]], ")"}], "\[CircleTimes]", 
        RowBox[{"S", "(", 
         SuperscriptBox["G", 
          RowBox[{"(", "2", ")"}]], ")"}]}], "\[Union]", 
       RowBox[{"S", "(", 
        SuperscriptBox["H", 
         RowBox[{"(", "2", ")"}]], ")"}], "\[Union]", 
       RowBox[{
        RowBox[{"S", "(", 
         SuperscriptBox["H", 
          RowBox[{"(", "1", ")"}]], ")"}], " ", "\\", " ", 
        RowBox[{"{", "e", "}"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825949022771673*^9, 3.825949034122384*^9}, {
  3.8259491468816977`*^9, 3.825949148629627*^9}, {3.825949181392954*^9, 
  3.8259492070538683`*^9}, {3.8259492664075212`*^9, 
  3.825949285105301*^9}},ExpressionUUID->"24f73d15-9fcc-40b6-96e1-\
587857d696ca"],

Cell[TextData[{
 "which will include ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"S", "(", 
     SuperscriptBox["H", 
      RowBox[{"(", "2", ")"}]], ")"}], "\[CircleTimes]", 
    RowBox[{"S", "(", 
     SuperscriptBox["H", 
      RowBox[{"(", "1", ")"}]], ")"}]}], TraditionalForm]],ExpressionUUID->
  "73c08d87-036c-4a5c-b308-38bba26525bb"],
 ". This will involve the partition/permutations up to order 7."
}], "ExpositoryText",
 CellChangeTimes->{{3.825949578133369*^9, 
  3.825949649966826*^9}},ExpressionUUID->"4b117be0-4ee2-4f25-b700-\
a61829b1004c"],

Cell[TextData[{
 "At this point, we\[CloseCurlyQuote]ll introduce some helpful notation, we\
\[CloseCurlyQuote]ll say ",
 Cell[BoxData[
  FormBox[
   RowBox[{"IP", "(", "N", ")"}], TraditionalForm]],ExpressionUUID->
  "ed9164b9-232b-4cf1-a471-537450953558"],
 " is the set of integer partitions of non-negative integer ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],ExpressionUUID->
  "b917d897-2a47-44c5-bf75-d2066a3413df"],
 ". We\[CloseCurlyQuote]ll call ",
 Cell[BoxData[
  FormBox[
   RowBox[{"D", "(", "v", ")"}], TraditionalForm]],ExpressionUUID->
  "e2b7d998-5d42-490d-93f6-326f70e912b7"],
 " the length/dimension of the vector ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "3b17ea48-2e50-4abb-92cd-0dcca266548b"],
 ". "
}], "ExpositoryText",
 CellChangeTimes->{{3.825950140098955*^9, 3.825950221854529*^9}, 
   3.8259502690931253`*^9},ExpressionUUID->"7b4557a9-1c67-46a0-ae65-\
ce66021bfb9e"],

Cell["With this, we can write", "ExpositoryText",
 CellChangeTimes->{{3.825950140098955*^9, 3.825950221854529*^9}, {
  3.825950270214855*^9, 
  3.8259502717700453`*^9}},ExpressionUUID->"7f9cd669-19f0-4615-9428-\
72799bc97f28"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"S", "(", 
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]], ")"}], "=", 
      RowBox[{
       UnderscriptBox["\[Union]", 
        RowBox[{"v", "\[Element]", 
         RowBox[{"IP", "(", "3", ")"}]}]], 
       RowBox[{
        SuperscriptBox["P", 
         RowBox[{"D", "(", "v", ")"}]], " ", 
        RowBox[{"(", "  ", 
         RowBox[{
          UnderoverscriptBox["\[Product]", 
           RowBox[{"i", "=", "1"}], 
           RowBox[{"D", "(", "v", ")"}]], "  ", 
          SuperscriptBox[
           SubscriptBox["q", "i"], 
           SubscriptBox["v", "i"]]}], " ", ")"}]}]}]}]},
    {
     RowBox[{
      RowBox[{"S", 
       RowBox[{"(", 
        SuperscriptBox["H", 
         RowBox[{"(", "2", ")"}]], ")"}]}], "=", 
      RowBox[{
       UnderscriptBox["\[Union]", 
        RowBox[{"v", "\[Element]", 
         RowBox[{"IP", "(", "4", ")"}]}]], 
       RowBox[{
        SuperscriptBox["P", 
         RowBox[{"D", "(", "v", ")"}]], " ", 
        RowBox[{"(", "  ", 
         RowBox[{
          UnderoverscriptBox["\[Product]", 
           RowBox[{"i", "=", "1"}], 
           RowBox[{"D", "(", "v", ")"}]], "  ", 
          SuperscriptBox[
           SubscriptBox["q", "i"], 
           SubscriptBox["v", "i"]]}], " ", ")"}]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825949774271632*^9, 3.825949792058895*^9}, {
  3.825949822360917*^9, 3.825950032933749*^9}, {3.825950065880693*^9, 
  3.8259500757085123`*^9}, {3.825950239134008*^9, 
  3.825950255995921*^9}},ExpressionUUID->"83a4ac17-0e87-47f4-a7cf-\
d2d1aa8361cb"],

Cell[TextData[{
 "which means that under the equivalence relation which is just sorting the \
coefficients on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Product]", 
     RowBox[{"i", "=", "1"}], 
     RowBox[{"D", "(", "v", ")"}]], "  ", 
    SuperscriptBox[
     SubscriptBox["q", "i"], 
     SubscriptBox["v", "i"]]}], TraditionalForm]],ExpressionUUID->
  "3a100044-b19f-4bab-bf3d-4c93ac5b3e7b"],
 " we can define some mapping"
}], "ExpositoryText",
 CellChangeTimes->{{3.825950282864677*^9, 
  3.825950322649358*^9}},ExpressionUUID->"75866d22-cc50-4d2d-a2df-\
93da9f57db8c"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"\[Phi]", "(", 
       RowBox[{"S", "(", 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], ")"}], ")"}], " ", "=", " ", 
      RowBox[{"IP", "(", "3", ")"}]}]},
    {
     RowBox[{
      RowBox[{"\[Phi]", 
       RowBox[{"(", 
        RowBox[{"S", 
         RowBox[{"(", 
          SuperscriptBox["H", 
           RowBox[{"(", "2", ")"}]], ")"}]}], ")"}]}], " ", "=", " ", 
      RowBox[{"IP", "(", "4", ")"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825950324195979*^9, 
  3.8259503511029*^9}},ExpressionUUID->"c048d334-73d7-4ee3-9f2b-447ae7e6ea20"],

Cell[TextData[{
 "which defines the equivalence classes of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "(", 
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], ")"}], TraditionalForm]],ExpressionUUID->
  "c9339077-20e5-4d58-b2d5-baa468fe4b4a"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "(", 
    SuperscriptBox["H", 
     RowBox[{"(", "2", ")"}]], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.825950324195979*^9, 3.8259503511029*^9}},
  ExpressionUUID->"213f9c94-ab2c-4aa7-a206-38f67c8aa5fc"]
}], "ExpositoryText",
 CellChangeTimes->{{3.825950353339916*^9, 
  3.825950384869007*^9}},ExpressionUUID->"ca812669-2a58-4e3d-bfc2-\
f0a9ebba44be"],

Cell["\<\
We\[CloseCurlyQuote]ll toss out a conjecture which I won\[CloseCurlyQuote]t \
even bother to prove\
\>", "ExpositoryText",
 CellChangeTimes->{{3.825949651661357*^9, 3.82594970390898*^9}, {
  3.82595013379751*^9, 3.82595013646887*^9}, {3.825950558709202*^9, 
  3.825950560055821*^9}},ExpressionUUID->"237ece98-03e4-4b76-8b3b-\
e6d982d4304c"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Conjecture",
 FontWeight->"Bold"]], "Subsubsubsubsection",
 CellChangeTimes->{{3.8259497822809896`*^9, 
  3.825949787345842*^9}},ExpressionUUID->"044182c2-1d87-43cc-aa3f-\
f04e9de94bc4"],

Cell[BoxData[
 FormBox[
  RowBox[{"Suppose", " ", "we", " ", "have", " ", "operators", " ", 
   SuperscriptBox["G", 
    RowBox[{"(", "i", ")"}]], " ", "and", " ", 
   SuperscriptBox["G", 
    RowBox[{"(", "j", ")"}]], " ", "and", " ", "corresponding", " ", 
   "integers", " ", "N", " ", "and", " ", "M", " ", "such", " ", "that", 
   " "}], TraditionalForm]], "ExpositoryMath",
 CellChangeTimes->{{3.8259497064858513`*^9, 3.825949769041765*^9}, 
   3.825949818422257*^9, {3.825949866375339*^9, 3.82594987935325*^9}, 
   3.8259505658170443`*^9, {3.825950601051406*^9, 
   3.8259506108076687`*^9}},ExpressionUUID->"77800d11-01dd-41f6-817d-\
ec3798a22634"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"\[Phi]", "(", 
       RowBox[{"S", "(", 
        SuperscriptBox["G", 
         RowBox[{"(", "i", ")"}]], ")"}], ")"}], " ", "=", " ", 
      RowBox[{"IP", "(", "N", ")"}]}]},
    {
     RowBox[{
      RowBox[{"\[Phi]", "(", 
       RowBox[{"S", "(", 
        SuperscriptBox["G", 
         RowBox[{"(", "j", ")"}]], ")"}], ")"}], " ", "=", " ", 
      RowBox[{"IP", "(", "M", ")"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825950324195979*^9, 3.8259503511029*^9}, {
  3.825950584303033*^9, 
  3.825950613028541*^9}},ExpressionUUID->"a844cb2e-32f5-4647-bc39-\
3b29132f51a9"],

Cell[BoxData[
 FormBox["then", TraditionalForm]], "ExpositoryMath",
 CellChangeTimes->{{3.825950592444667*^9, 
  3.8259505938301277`*^9}},ExpressionUUID->"c0c681df-5ff4-4833-b1a7-\
6e8a2fdb4ede"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Phi]", "(", 
    RowBox[{"S", "(", 
     RowBox[{
      SuperscriptBox["G", 
       RowBox[{"(", "i", ")"}]], 
      SuperscriptBox["G", 
       RowBox[{"(", "j", ")"}]]}], ")"}], ")"}], "=", 
   RowBox[{
    RowBox[{"\[Phi]", "(", 
     RowBox[{
      RowBox[{"S", "(", 
       SuperscriptBox["G", 
        RowBox[{"(", "i", ")"}]], ")"}], "\[CircleTimes]", 
      RowBox[{"S", "(", 
       SuperscriptBox["G", 
        RowBox[{"(", "j", ")"}]], ")"}]}], ")"}], "=", 
    RowBox[{"IP", "(", 
     RowBox[{"N", "+", "M"}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8259506151230087`*^9, 
  3.825950643121949*^9}},ExpressionUUID->"a00dd44b-4988-4f76-9d13-\
fc0f6a22b48b"],

Cell[TextData[{
 "this conjecture basically comes from mapping ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["G", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.825950324195979*^9, 3.8259503511029*^9}, {
   3.825950584303033*^9, 3.825950613028541*^9}},ExpressionUUID->
  "5a7e488b-6a37-414f-87fb-1ab222d084a7"],
 " to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["Q", "N"], TraditionalForm]],ExpressionUUID->
  "1ea9fd3b-b488-4f68-88fb-9cd5a8319381"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["G", 
    RowBox[{"(", "j", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.825950324195979*^9, 3.8259503511029*^9}, {
   3.825950584303033*^9, 3.825950613028541*^9}},ExpressionUUID->
  "603adbbe-b4f9-487f-811e-44b206c7d184"],
 " to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["Q", "M"], TraditionalForm]],ExpressionUUID->
  "c796db60-6f22-4d16-b226-3e82f1e58513"],
 " and noting by operator math that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["Q", "N"], 
     SuperscriptBox["Q", "M"]}], "=", 
    SuperscriptBox["Q", 
     RowBox[{"N", "+", "M"}]]}], TraditionalForm]],ExpressionUUID->
  "f7fb22bc-077c-48e5-bb3d-e891e3267610"]
}], "ExpositoryText",
 CellChangeTimes->{{3.825950655657633*^9, 
  3.825950696220954*^9}},ExpressionUUID->"b0acc182-b529-4312-9124-\
b4819d544071"],

Cell["Now for the real proof", "ExpositoryText",
 CellChangeTimes->{{3.825950981871818*^9, 
  3.825950985578106*^9}},ExpressionUUID->"e32ca738-929b-4aa5-b53b-\
afdf3e7540db"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Theorem",
 FontWeight->"Bold"]], "Subsubsubsubsection",
 CellChangeTimes->{{3.8259509883048067`*^9, 
  3.8259509949594393`*^9}},ExpressionUUID->"7b1ea0bf-35ad-40de-a1eb-\
60ac287e21a9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"For", " ", "every", " ", "k"}], ",", " ", 
   RowBox[{
    RowBox[{
    "there", " ", "is", " ", "some", " ", "set", " ", "of", " ", "integers", 
     " ", Cell[TextData[Cell[BoxData[
      FormBox[
       RowBox[{"{", 
        SubsuperscriptBox["N", "i", 
         RowBox[{"(", "k", ")"}]], "}"}], TraditionalForm]],ExpressionUUID->
      "8292f025-9d01-49f2-895a-f51661737325"]],ExpressionUUID->
      "2b672be9-8745-4fb9-93c2-cb8225f17ed0"], " ", "such", " ", "that", " ", 
     
     RowBox[{"\[Phi]", "(", 
      RowBox[{"S", "(", 
       SuperscriptBox["G", 
        RowBox[{"(", "k", ")"}]], ")"}], ")"}]}], "=", 
    RowBox[{
     UnderscriptBox["\[Union]", "i"], " ", 
     RowBox[{"IP", "(", 
      SubsuperscriptBox["N", "i", 
       RowBox[{"(", "k", ")"}]], ")"}]}]}]}], 
  TraditionalForm]], "ExpositoryMath",
 CellChangeTimes->{{3.8259510054628067`*^9, 
  3.82595109040773*^9}},ExpressionUUID->"bc4a4434-a6f9-43bc-800c-\
c1c8369f9c90"],

Cell[TextData[{
 "As will everything we\[CloseCurlyQuote]ll prove this by induction. The \
first few cases we already did, so we\[CloseCurlyQuote]ll assume that holds \
for ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "0708a0d3-7870-47ac-8e8c-5092e35cf69f"],
 " and write"
}], "ExpositoryText",
 CellChangeTimes->{{3.825951094041479*^9, 
  3.82595114565077*^9}},ExpressionUUID->"ace04571-20c2-423a-a8e5-\
69b44ed80944"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Phi]", "(", 
    RowBox[{"S", "(", 
     SuperscriptBox["G", 
      RowBox[{"(", 
       RowBox[{"k", "+", "1"}], ")"}]], ")"}], ")"}], "=", 
   RowBox[{
    RowBox[{"(", " ", 
     RowBox[{
      UnderoverscriptBox["\[Union]", 
       RowBox[{"i", "=", "0"}], "k"], " ", 
      RowBox[{"\[Phi]", "(", " ", 
       RowBox[{
        RowBox[{"S", "(", 
         SuperscriptBox["H", 
          RowBox[{"(", 
           RowBox[{"k", "+", "1", "-", "i"}], ")"}]], ")"}], "\[CircleTimes]", 
        RowBox[{"S", "(", 
         SuperscriptBox["G", 
          RowBox[{"(", "i", ")"}]], ")"}]}], " ", ")"}]}], " ", ")"}], " ", 
    "\[Union]", " ", 
    RowBox[{"(", " ", 
     RowBox[{
      UnderoverscriptBox["\[Union]", 
       RowBox[{"i", "=", "0"}], "k"], " ", 
      RowBox[{"\[Phi]", "(", 
       RowBox[{"S", "(", 
        SuperscriptBox["H", 
         RowBox[{"(", 
          RowBox[{"k", "+", "1", "-", "i"}], ")"}]], ")"}], " ", ")"}]}], " ",
      ")"}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8259054934790573`*^9, 3.825905569187333*^9}, {
  3.825939331383416*^9, 3.825939394407836*^9}, {3.825939654485529*^9, 
  3.825939692906013*^9}, {3.825951162158885*^9, 
  3.825951247458992*^9}},ExpressionUUID->"6b55caae-be90-4c9b-8f87-\
16d8267205ee"],

Cell[TextData[{
 "we\[CloseCurlyQuote]ll note that by the assumed form of our Hamiltonian, \
there\[CloseCurlyQuote]s some ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SuperscriptBox["M", 
     RowBox[{"(", "j", ")"}]], "}"}], TraditionalForm]],ExpressionUUID->
  "e551d624-26cf-4450-b92a-a28211018834"],
 " so that second half of this can be written as"
}], "ExpositoryText",
 CellChangeTimes->{{3.82595119151346*^9, 3.825951197817679*^9}, {
  3.825951471937562*^9, 3.825951506966151*^9}, {3.82595155568011*^9, 
  3.825951591868243*^9}},ExpressionUUID->"a3458d5c-0ff3-4046-b903-\
6f87755c9d02"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderoverscriptBox["\[Union]", 
     RowBox[{"i", "=", "0"}], "k"], " ", 
    RowBox[{"\[Phi]", "(", 
     RowBox[{"S", "(", 
      SuperscriptBox["H", 
       RowBox[{"(", 
        RowBox[{"k", "+", "1", "-", "i"}], ")"}]], ")"}], " ", ")"}]}], " ", 
   "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Union]", 
     RowBox[{"i", "=", "0"}], "k"], " ", 
    RowBox[{"IP", "(", 
     SuperscriptBox["M", 
      RowBox[{"(", 
       RowBox[{"k", "+", "1", "-", "i"}], ")"}]], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.82595150813492*^9, 
  3.825951549700086*^9}},ExpressionUUID->"78c07f26-3591-4bb6-aa42-\
08d02f60589d"],

Cell["\<\
as for the first part, we can now apply the inductive hypothesis and the \
prior conjecture to write\
\>", "ExpositoryText",
 CellChangeTimes->{{3.825951600804315*^9, 3.8259516258027563`*^9}, {
  3.825951707880889*^9, 
  3.825951711235207*^9}},ExpressionUUID->"9edd9214-0b8a-4943-90bb-\
794536a7d0bf"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Phi]", "(", 
    RowBox[{
     RowBox[{"S", "(", 
      SuperscriptBox["H", 
       RowBox[{"(", 
        RowBox[{"k", "+", "1", "-", "i"}], ")"}]], ")"}], "\[CircleTimes]", 
     RowBox[{"S", "(", 
      SuperscriptBox["G", 
       RowBox[{"(", "i", ")"}]], ")"}]}], ")"}], "=", 
   RowBox[{
    UnderscriptBox["\[Union]", "j"], " ", 
    RowBox[{"IP", "(", 
     RowBox[{
      SuperscriptBox["M", 
       RowBox[{"(", 
        RowBox[{"k", "+", "1", "-", "i"}], ")"}]], "+", 
      SubsuperscriptBox["N", "j", 
       RowBox[{"(", "i", ")"}]]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8259516267584333`*^9, 3.825951650378953*^9}, {
  3.825951698578474*^9, 
  3.82595170362326*^9}},ExpressionUUID->"6b533b93-acd3-4ac8-bf5d-\
7c7881c55349"],

Cell["so ", "ExpositoryText",
 CellChangeTimes->{{3.825951755985551*^9, 
  3.825951756355873*^9}},ExpressionUUID->"54989622-027d-49a1-b15c-\
c1ccf8d44526"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"{", 
       SubsuperscriptBox["N", "i", 
        RowBox[{"(", 
         RowBox[{"k", "+", "1"}], ")"}]], "}"}], "=", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Union]", 
         RowBox[{"i", "=", "0"}], "k"], " ", 
        RowBox[{"(", 
         RowBox[{"{", 
          RowBox[{
           SuperscriptBox["M", 
            RowBox[{"(", 
             RowBox[{"k", "+", "1", "-", "i"}], ")"}]], "+", 
           RowBox[{"n", " ", ":", " ", 
            RowBox[{"n", " ", "\[Element]", " ", 
             RowBox[{"{", 
              SubsuperscriptBox["N", "j", 
               RowBox[{"(", "i", ")"}]], "}"}]}]}]}]}], ")"}]}], " ", 
       "\[Union]", " ", 
       RowBox[{"{", 
        SuperscriptBox["M", 
         RowBox[{"(", 
          RowBox[{"k", "+", "1", "-", "i"}], ")"}]], "}"}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderoverscriptBox["\[Union]", 
        RowBox[{"i", "=", "0"}], "k"], " ", 
       RowBox[{"{", " ", 
        RowBox[{
         SuperscriptBox["M", 
          RowBox[{"(", 
           RowBox[{"k", "+", "1", "-", "i"}], ")"}]], "+", 
         RowBox[{"n", " ", ":", " ", 
          RowBox[{"n", " ", "\[Element]", " ", 
           RowBox[{
            RowBox[{"{", "0", "}"}], "\[Union]", 
            RowBox[{"{", 
             SubsuperscriptBox["N", "j", 
              RowBox[{"(", "i", ")"}]], "}"}]}]}]}]}], " ", "}"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825951764825405*^9, 3.825951895149906*^9}, 
   3.825952358359913*^9, {3.825952632316163*^9, 
   3.8259526759653873`*^9}},ExpressionUUID->"ecc80b3d-1b9b-41f3-a30a-\
9be13c0d2479"],

Cell[TextData[{
 "which shows that ",
 StyleBox["all",
  FontSlant->"Italic"],
 " of our terms can be written as simple expansions in integer partitions and \
permutations. For what follows, we\[CloseCurlyQuote]ll write"
}], "ExpositoryText",
 CellChangeTimes->{{3.825951715503921*^9, 3.825951752747303*^9}, {
  3.825951900610839*^9, 3.825951908738796*^9}, {3.825952208848289*^9, 
  3.825952213473937*^9}, {3.825952253297092*^9, 3.825952273303534*^9}, {
  3.825953235091982*^9, 
  3.825953241736238*^9}},ExpressionUUID->"d2f98768-6e31-4324-ac41-\
31bfeb2fb2ba"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["\[ScriptCapitalN]", 
    RowBox[{"(", "k", ")"}]], "=", 
   RowBox[{"{", 
    SubsuperscriptBox["N", "i", 
     RowBox[{"(", "k", ")"}]], "}"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8259532427798862`*^9, 
  3.82595328280798*^9}},ExpressionUUID->"548c473e-30ad-474f-a5df-\
e013e094327c"],

Cell[TextData[{
 "But we can actually do better than this if we assume that there's some \
starting order ",
 Cell[BoxData[
  FormBox["Z", TraditionalForm]],ExpressionUUID->
  "8219c6e5-5ec3-48b0-a18f-c94f60e0b061"],
 " such that for all ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", " ", ">", " ", "0"}], TraditionalForm]],ExpressionUUID->
  "d7a5f944-ef1f-4ace-9677-33f01cd35f23"]
}], "ExpositoryText",
 CellChangeTimes->{{3.825951715503921*^9, 3.825951752747303*^9}, {
  3.825951900610839*^9, 3.825951908738796*^9}, {3.825952208848289*^9, 
  3.825952213473937*^9}, {3.825952253297092*^9, 
  3.825952273303534*^9}},ExpressionUUID->"9c24ecae-3d51-4b6b-80cd-\
38764e098a86"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Phi]", "(", 
    RowBox[{"S", "(", 
     SuperscriptBox["H", 
      RowBox[{"(", "i", ")"}]], ")"}], ")"}], "=", 
   RowBox[{"IP", "(", 
    RowBox[{"Z", "+", "i"}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825952215212316*^9, 
  3.825952251685754*^9}},ExpressionUUID->"f28e17a2-1128-4f88-96d2-\
b48010a6f4ca"],

Cell["then we can say that ", "ExpositoryText",
 CellChangeTimes->{{3.825952236945923*^9, 
  3.8259522406688232`*^9}},ExpressionUUID->"9d35cfae-29b3-43d2-a4f6-\
af8f9ee2f351"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["\[ScriptCapitalN]", 
    RowBox[{"(", "k", ")"}]], "=", 
   RowBox[{
