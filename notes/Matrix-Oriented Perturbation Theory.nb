Cell[CellGroupData[{

Cell["Coriolis Zeta Constants", "Section",
 CellChangeTimes->{{3.8110784730306273`*^9, 
  3.811078478540464*^9}},ExpressionUUID->"ae069538-7a05-4140-8c74-\
66eabe78a44d"],

Cell[TextData[{
 "To be able to compare to pure Cartesian coordinate calculations, it is \
useful to be able to add the effects of Coriolis coupling to our \
calculations, even though we\[CloseCurlyQuote]d prefer to work purely in \
internal coordinates. To make this work, we note that the according to ",
 ButtonBox["Barone and friends",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://aip-scitation-org.offcampus.lib.washington.edu/doi/pdf/10.\
1063/1.3695210"], None},
  ButtonNote->
   "https://aip-scitation-org.offcampus.lib.washington.edu/doi/pdf/10.1063/1.\
3695210"],
 ", the Coriolis term comes in at second order"
}], "ExpositoryText",
 CellChangeTimes->{{3.811078480559285*^9, 3.811078565757196*^9}, {
  3.811124134024275*^9, 3.811124143054079*^9}, {3.8111244646406107`*^9, 
