c9c82fe6e2f3"],

Cell[TextData[{
 "then we\[CloseCurlyQuote]ll focus on what happens with ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "2", ")"}]], TraditionalForm]],ExpressionUUID->
  "041d2a6e-dbc2-4829-bfac-0f0dc0bdd987"],
 ". When we operate with it we get something like"
}], "ExpositoryText",
 CellChangeTimes->{{3.811957680175207*^9, 3.8119576963872538`*^9}, {
  3.811957876764759*^9, 3.811957938632504*^9}, {3.811958373628354*^9, 
  3.811958384618265*^9}},ExpressionUUID->"1037c875-a00c-4492-b894-\
b22942bd07e1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["H", 
     RowBox[{"(", "2", ")"}]], " ", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], " ", "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", "m"], 
    RowBox[{
     SubscriptBox["c", "m"], 
     TemplateBox[{
       SuperscriptBox["m", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811958099749627*^9, 
  3.811958154408188*^9}},ExpressionUUID->"f9c8a0bb-49b3-4562-93fb-\
0aa619ecc2eb"],

Cell[TextData[{
 "but after projecting, we just get ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "n"], TraditionalForm]],ExpressionUUID->
  "e294a111-0282-4a23-8199-405a00b89f95"],
 ". This ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "n"], TraditionalForm]],ExpressionUUID->
  "4ab4bbca-e7cf-424a-b7c2-fdbb06ba5217"],
 ", then, should be partitioned into its parts coming from the various modes. \
To that effect, we note that for us (in rectilinear normal modes) "
}], "ExpositoryText",
 CellChangeTimes->{{3.8119577161056747`*^9, 3.811957720709996*^9}, {
  3.811958156593837*^9, 3.811958277111772*^9}, {3.811958458678874*^9, 
  3.811958460692204*^9}},ExpressionUUID->"e7f66c69-1221-41cf-b35e-\
1e974f0c464c"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       SuperscriptBox["H", 
        RowBox[{"(", "2", ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], " ", "=", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], " ", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["q", "4"]], "V"}], "\[CircleDot]", "q"}], 
       "\[InvisibleSpace]", "q", "\[InvisibleSpace]", "q", 
       "\[InvisibleSpace]", "q", 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"], " "}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["q", "4"]], "V"}], "\[CircleDot]", 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Bra"]}], "q", "\[InvisibleSpace]", "q", "\[InvisibleSpace]", "q", 
       "\[InvisibleSpace]", "q", 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8119582296964693`*^9, 3.811958229704674*^9}, {
  3.811958279728088*^9, 3.8119583081549473`*^9}, {3.811958345757167*^9, 
  3.811958361971005*^9}, {3.8119584711432657`*^9, 
  3.811958495501071*^9}},ExpressionUUID->"4d19291d-a828-4df0-9584-\
6048d932e88e"],

Cell[TextData[{
 "and of course we established earlier how to compute representations of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], "q", "\[InvisibleSpace]", "q", "\[InvisibleSpace]", "q", 
    "\[InvisibleSpace]", "q", 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "99675c23-669f-42b0-b341-00f5a5375e3a"],
 ", but what\[CloseCurlyQuote]s important here is that only two flavors of \
permutations have the ability to properly couple, and those are"
}], "ExpositoryText",
 CellChangeTimes->{{3.8119584997708282`*^9, 3.811958578307707*^9}, {
  3.8119595160563307`*^9, 
  3.811959520127701*^9}},ExpressionUUID->"bab5caca-2987-4147-90ce-\
75827f338c36"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]]},
       "Bra"], 
      SubscriptBox[
       RowBox[{"q", "\[InvisibleSpace]"}], "i"], "\[InvisibleSpace]", 
      SubscriptBox["q", "i"], "\[InvisibleSpace]", 
      SubscriptBox["q", "i"], "\[InvisibleSpace]", 
      SubscriptBox["q", "i"], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]]},
       "Ket"]}]},
    {
     RowBox[{
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]]},
       "Bra"], 
      SubscriptBox[
       RowBox[{"q", "\[InvisibleSpace]"}], "i"], "\[InvisibleSpace]", 
      SubscriptBox["q", "i"], "\[InvisibleSpace]", 
      SubscriptBox["q", "j"], "\[InvisibleSpace]", 
      SubscriptBox["q", "j"], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", "0", ")"}]]},
       "Ket"]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.811958560668254*^9, 3.8119586037762337`*^9}, {
  3.8119818425989656`*^9, 
  3.811981852310287*^9}},ExpressionUUID->"fd27a8b3-aca8-44aa-aa70-\
ca09ed69e2c8"],

Cell[TextData[{
 "since no other flavor of these operators can leave the quantum numbers \
unchanged. This is incredibly convenient, and is the reason the classic ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"i", "\[InvisibleSpace]", "j"}]], TraditionalForm]],
  CellChangeTimes->{{3.81195616060509*^9, 3.811956220859634*^9}, {
   3.811957562502832*^9, 3.811957571501989*^9}},ExpressionUUID->
  "64ad1b4f-ced3-49e5-8706-b8efc5375db5"],
 " expressions only contain only semi-diagonal elements in the quartic force \
constants. We\[CloseCurlyQuote]ll deal with the coefficients later. For now, \
we need to figure out what to do about ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "1", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "81f52b13-dc4d-4390-93b4-1094a3ded2bd"],
 "."
}], "ExpositoryText",
 CellChangeTimes->{{3.811958606638693*^9, 
  3.811958837191429*^9}},ExpressionUUID->"5f69e5b1-1417-4060-8aa0-\
8271c12e1201"],

Cell["", "ExpositoryText",
 CellChangeTimes->{{3.811987829055738*^9, 
  3.8119878298985577`*^9}},ExpressionUUID->"64ffaad1-44fa-4920-ab33-\
4c87629c6b38"],

Cell["First off, we note that ", "ExpositoryText",
 CellChangeTimes->{{3.8119587691996603`*^9, 3.8119587708180943`*^9}, {
  3.811958839243681*^9, 3.8119588479024754`*^9}, {3.811958886289146*^9, 
  3.8119588867570057`*^9}},ExpressionUUID->"e57ca365-8caa-403e-a33c-\
d978c1650265"],

