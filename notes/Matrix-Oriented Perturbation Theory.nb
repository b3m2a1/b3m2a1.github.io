           RowBox[{"(", "i", ")"}]]}]},
       "BraKet"]}], ")"}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825904303371274*^9, 3.825904312050803*^9}, {
  3.825905273219805*^9, 
  3.825905274458647*^9}},ExpressionUUID->"8ae26bbc-b238-4c18-b174-\
413e88320bb0"],

Cell["and finally using the normalization criterion we always have", \
"ExpositoryText",
 CellChangeTimes->{{3.825904315574749*^9, 
  3.825904324657778*^9}},ExpressionUUID->"ebaa6172-4c39-4c84-8894-\
54d29c6ee9d5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["G", 
    RowBox[{"(", "k", ")"}]], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], 
     RowBox[{"k", "-", "1"}]], 
    RowBox[{
     SuperscriptBox["\[CapitalGamma]", 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]], "(", 
     RowBox[{
      SuperscriptBox["G", 
       RowBox[{"(", "i", ")"}]], "-", 
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "1"}], 
         RowBox[{"i", "-", "1"}]], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", 
               RowBox[{"i", "-", "j"}], ")"}]], " "}], 
          RowBox[{" ", 
            SuperscriptBox["n", 
             RowBox[{"(", "j", ")"}]]}]},
         "BraKet"]}]}]}], ")"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825904325973545*^9, 3.825904381113515*^9}, {
  3.8259052860637493`*^9, 
  3.825905292932765*^9}},ExpressionUUID->"58065971-7396-4c33-9f6e-\
954d364711db"],

Cell[TextData[{
 "which is unfortunately still not totally convenient, since we have that \
overlap term, but from a ",
 StyleBox["group theoretic perspective this is nice, since that overlap term \
is ",
  FontSize->14],
 StyleBox["diagonal ",
  FontSize->14,
  FontSlant->"Italic"],
 StyleBox["and so will transform exactly as ",
  FontSize->14],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalGamma]", 
    RowBox[{"(", 
     RowBox[{"k", "-", "i"}], ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.825904325973545*^9, 3.825904381113515*^9}, {
   3.8259052860637493`*^9, 3.825905292932765*^9}},ExpressionUUID->
  "5886600d-81f3-40c0-8101-fd362beea4a6"],
 StyleBox[" does.",
  FontSize->14]
}], "ExpositoryText",
 CellChangeTimes->{{3.825904435517318*^9, 3.8259044477417393`*^9}, {
  3.825904478011807*^9, 3.825904527397406*^9}, {3.825905300717454*^9, 
  3.825905320338504*^9}},ExpressionUUID->"d89b6674-84bf-46b5-84ae-\
2396154ebb1d"],

Cell[CellGroupData[{

Cell["Selection Rules Group Theory", "Subsubsection",
 CellChangeTimes->{{3.825950750007197*^9, 
  3.825950758703847*^9}},ExpressionUUID->"4d399606-c693-41f8-b91e-\
ae74949c7258"],

Cell[TextData[{
 "In particular, this means is for every ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]],ExpressionUUID->
  "e73ac029-7abd-48e3-b593-bc1d5eda88a9"],
 " we have a set of selection rules, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "(", 
    SuperscriptBox["H", 
     RowBox[{"(", "i", ")"}]], ")"}], TraditionalForm]],ExpressionUUID->
  "aa19d001-9f6f-4610-8953-7b698ab4513d"],
 ", as ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalDelta]H", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]],ExpressionUUID->
  "523c95ba-de18-43a5-81ac-40e4c916e23d"],
 " will support the exact same set of selection rules. The selection-rule \
space operation of the projection operator is the removal of the identity \
rule, so"
}], "ExpositoryText",
 CellChangeTimes->{{3.825905360002565*^9, 3.825905429522819*^9}, {
  3.825905497990672*^9, 3.825905504213565*^9}, {3.825939059562079*^9, 
  3.825939118950263*^9}},ExpressionUUID->"5820ef1d-205e-494f-98bd-\
fee90f42e87b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"S", "(", 
    SuperscriptBox["\[CapitalGamma]", 
     RowBox[{"(", 
      RowBox[{"k", "-", "i"}], ")"}]], ")"}], "=", 
   RowBox[{
    RowBox[{"S", "(", 
     SuperscriptBox["H", 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]], ")"}], " ", "\[Backslash]", " ", 
    RowBox[{"{", " ", "e", " ", "}"}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825905431082922*^9, 3.82590545399326*^9}, {
  3.825939303458638*^9, 
  3.8259393037671003`*^9}},ExpressionUUID->"e696e78a-a396-490d-851b-\
223223bbedeb"],

Cell["since \[CapitalGamma] is always applied last, we can write", \
"ExpositoryText",
 CellChangeTimes->{{3.825939166580926*^9, 3.8259391921583242`*^9}, {
  3.825939248665021*^9, 3.8259392692726917`*^9}, {3.8259399289666033`*^9, 
  3.825939941850375*^9}},ExpressionUUID->"502b2de3-bc04-4a09-b438-\
1ddb540e6b05"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"S", "(", 
    RowBox[{
     SuperscriptBox["\[CapitalGamma]", 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]], 
     SuperscriptBox["G", 
      RowBox[{"(", "i", ")"}]]}], ")"}], "=", 
   RowBox[{
    RowBox[{"S", "(", 
     SuperscriptBox["H", 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]], ")"}], "\[CircleTimes]", 
    RowBox[{
     RowBox[{"S", "(", 
      SuperscriptBox["G", 
       RowBox[{"(", "i", ")"}]], ")"}], " ", "\[Backslash]", " ", 
     RowBox[{"{", " ", "e", " ", "}"}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825939275020455*^9, 
  3.825939326731146*^9}},ExpressionUUID->"bf6f90b0-d77b-4ea1-b0c9-\
31679bc57191"],

