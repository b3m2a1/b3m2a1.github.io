  3.82136813957386*^9}},ExpressionUUID->"0f9d149b-f234-437d-9374-\
842efd571094"],

Cell["giving us now", "ExpositoryText",
 CellChangeTimes->{{3.8213596434997683`*^9, 3.8213596516895723`*^9}, {
  3.821360308350293*^9, 
  3.821360309175742*^9}},ExpressionUUID->"d3a939a8-d9eb-4bb1-aad9-\
5f8ebd50c239"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["P", "D"], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["P", "U"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "1", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        SubscriptBox["P", "D"], 
        SuperscriptBox["H", 
         RowBox[{"(", "2", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         SubscriptBox["P", "D"]}], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", "D"], 
        SubscriptBox["P", "U"], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["P", "D"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        SubscriptBox["P", "D"], 
        SuperscriptBox["H", 
         RowBox[{"(", "2", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       SuperscriptBox["E", 
        RowBox[{"(", "2", ")"}]], "\[VeryThinSpace]", 
       SubscriptBox["P", "D"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821360328637252*^9, 3.821360351870304*^9}, 
   3.821360478616523*^9, 
   3.8213681471262293`*^9},ExpressionUUID->"41a204e8-bae0-4b03-951e-\
06b75d848967"],

Cell["and so now we can write", "ExpositoryText",
 CellChangeTimes->{{3.8213603623155622`*^9, 
  3.821360374723318*^9}},ExpressionUUID->"0895ae95-6a2e-4a93-8610-\
03ed6bbbe5f3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["P", "D"], "(", 
     RowBox[{
      SuperscriptBox["H", 
       RowBox[{"(", "2", ")"}]], "-", 
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]], 
       SubscriptBox["\[CapitalPi]", "D"], 
       SubscriptBox["P", "U"], 
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]]}]}], ")"}], 
    SubscriptBox["P", "D"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    SuperscriptBox["E", 
     RowBox[{"(", "2", ")"}]], "\[VeryThinSpace]", 
    SubscriptBox["P", "D"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821360376817705*^9, 3.821360392706938*^9}, {
  3.821360485697563*^9, 3.821360517318488*^9}, {3.8213681412517157`*^9, 
  3.821368141550746*^9}},ExpressionUUID->"1a751e8b-9dd1-4c9d-bef2-\
292915e923f6"],

Cell[TextData[{
 "and so now we obtain the second order energy correction and the zero-order \
states in one go by diagonalizing that perturbed from of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "2", ")"}]], TraditionalForm]],
  CellChangeTimes->{{3.821360376817705*^9, 3.821360392706938*^9}, 
    3.821360485697563*^9},ExpressionUUID->
  "3b9881d8-3df3-4f35-9c0a-99dc2a14e3c2"],
 " in the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "D"], TraditionalForm]],ExpressionUUID->
  "fc9feb35-b24b-4dac-bedb-022d46fd695c"],
 " subspace"
}], "ExpositoryText",
 CellChangeTimes->{{3.821359662212983*^9, 3.821359680152032*^9}, {
  3.8213600490117073`*^9, 3.821360062213031*^9}, {3.8213604963507147`*^9, 
