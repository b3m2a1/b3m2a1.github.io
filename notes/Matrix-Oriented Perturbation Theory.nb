Cell["\<\
IT TURNS OUT THE REVERSE DIRECTION IS EQUIVALENT TO THE FORWARD DIRECTION BUT \
WITH A SHIFT ON N\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8895495768463373`*^9, 
  3.889549596120928*^9}},ExpressionUUID->"871daea9-54dd-4755-8fd8-\
9e46baa85296"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["P", "a", "b"], "(", 
    RowBox[{"n", " ", "+", " ", 
     RowBox[{"(", 
      RowBox[{"a", "-", "b"}], ")"}]}], ")"}], " ", "=", " ", 
   RowBox[{
    SubsuperscriptBox["P", "b", "a"], "(", "n", ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.889549598751487*^9, 3.889549654672254*^9}, {
  3.892215981378977*^9, 
  3.892215982933777*^9}},ExpressionUUID->"8eec0a1d-7fda-4d32-98b0-\
784bcf7c4416"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "polyGenNeg", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"polyGenNeg", "[", "0", "]"}], "=", "1"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"polyGenNeg", "[", "1", "]"}], "=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{"1", "+", "\[FormalA]"}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{"\[FormalN]", "+", "1"}], ")"}]}], "-", "\[FormalA]"}], 
     ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"polyGenNeg", "[", "b_", "]"}], ":=", 
   RowBox[{
    RowBox[{"polyGenNeg", "[", "b", "]"}], "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[FormalN]", "-", "\[FormalA]", "+", "b"}], ")"}], " ", 
         RowBox[{"polyGenNeg", "[", 
          RowBox[{"b", "-", "1"}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\[FormalA]", ",", " ", "0", ",", " ", "\[FormalI]"}], 
         "}"}]}], "]"}], "/.", "\[VeryThinSpace]", 
      RowBox[{"\[FormalI]", "\[Rule]", "\[FormalA]"}]}], 
     "\[IndentingNewLine]", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"reducedPolyGenNeg", "[", "b_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"polyGenNeg", "[", "b", "]"}], " ", 
    RowBox[{
     SuperscriptBox["2", "b"], " ", "/", 
     RowBox[{"Binomial", "[", 
      RowBox[{
       RowBox[{"\[FormalA]", "+", "b"}], ",", " ", "b"}], "]"}]}]}], "//", 
   "Simplify"}]}]}], "Input",
