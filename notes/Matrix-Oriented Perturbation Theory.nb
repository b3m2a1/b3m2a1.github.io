         "Q", "\[InvisibleSpace]", "Q", "\[InvisibleSpace]", "Q", 
          "\[InvisibleSpace]", "Q"}]}], ")"}]}]}]},
    {
     RowBox[{" ", 
      RowBox[{"=", " ", 
       RowBox[{
        SuperscriptBox["V", 
         RowBox[{"(", "1", ")"}]], "\[CircleDot]", "("}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
