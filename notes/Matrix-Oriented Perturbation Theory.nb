  3.82698379577284*^9}},ExpressionUUID->"d2dcd9c0-9754-42cd-bd1a-\
ab8422763fb2"],

Cell["Next we\[CloseCurlyQuote]ll recognize that", "ExpositoryText",
 CellChangeTimes->{{3.8269166716357317`*^9, 3.8269166757598886`*^9}, 
   3.826983613598406*^9, {3.826983801331756*^9, 
   3.826983801936681*^9}},ExpressionUUID->"c1fffd50-dd68-4644-bafc-\
bd1d6ed12310"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox["\[ScriptCapitalH]", 
       RowBox[{"(", "\[Beta]", ")"}]], "=", 
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", 
         RowBox[{"a", "+", "1"}], ")"}]], "+", 
       SubsuperscriptBox["J", "a", 
        RowBox[{"(", "1", ")"}]]}]}]},
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], 
       SuperscriptBox["\[ScriptCapitalH]", 
        RowBox[{"(", "\[Beta]", ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], 
       SubsuperscriptBox["P", "D", 
        RowBox[{"(", "a", ")"}]], 
       SuperscriptBox["\[ScriptCapitalH]", 
        RowBox[{"(", "\[Beta]", ")"}]], 
       SubsuperscriptBox["P", "D", 
        RowBox[{"(", "a", ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]},
    {
     RowBox[{
      SubsuperscriptBox["P", "D", 
       RowBox[{"(", "a", ")"}]], "=", 
      RowBox[{
       SubsuperscriptBox["P", "D", 
        RowBox[{"(", "\[Beta]", ")"}]], " ", "+", " ", 
       SubsuperscriptBox["P", "U", 
        RowBox[{"(", "\[Beta]", ")"}]]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.826916682223922*^9, 3.826916725586894*^9}, {
  3.8269167816730328`*^9, 3.826916785354999*^9}, {3.826980146551947*^9, 
  3.826980224747789*^9}},ExpressionUUID->"88d68d8b-543d-4797-ae14-\
c4812d1317b7"],

Cell[TextData[{
 "and so by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"], "\[Element]", 
    SuperscriptBox["D", 
     RowBox[{"(", "\[Beta]", ")"}]]}], TraditionalForm]],
  CellChangeTimes->{{3.826916052010932*^9, 3.8269160711669817`*^9}, {
   3.826916185485743*^9, 3.8269161973464937`*^9}, {3.826916248866921*^9, 
