27eecbb23197"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"if", " ", 
     RowBox[{
      SubscriptBox["\[ForAll]", "i"], " ", 
      RowBox[{"i", ">", "M"}]}]}], " ", "\[Implies]", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["k", "i"], " ", "\[LessEqual]", " ", 
      RowBox[{"M", " ", "and", " ", 
       RowBox[{
        SubscriptBox["\[ForAll]", "j"], " ", 
        RowBox[{"j", "\[LessEqual]", "M"}]}]}]}], " ", "\[Implies]", " ", 
     RowBox[{
      SubscriptBox["k", "j"], ">", "M"}]}]}], ","}], 
