      "\[IndentingNewLine]", 
      RowBox[{"padR", "=", 
       RowBox[{"PadRight", "[", 
        RowBox[{"r", ",", " ", "totalLen"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"DeleteDuplicates", "@", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"DeleteCases", "[", 
