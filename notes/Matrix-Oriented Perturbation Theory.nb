Cell[CellGroupData[{

Cell["Kinetic Optimized Transformations", "Subsection",
 CellChangeTimes->{{3.921370533425694*^9, 
  3.9213705452766314`*^9}},ExpressionUUID->"90265305-73f1-4d5c-a33b-\
d16df2eb8998"],

Cell["\<\
Starting from an expansion with all of the anharmonicity in the kinetic \
energy, we can try to go the other direction. First we write\
\>", "ExpositoryText",
 CellChangeTimes->{{3.921370562165021*^9, 
  3.921370587193398*^9}},ExpressionUUID->"936c53fe-9ff4-4dfe-893f-\
1dcb83d44a6d"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{"G", " ", "=", " ", 
      RowBox[{"[", 
       RowBox[{
        SubscriptBox["R", 
         RowBox[{"a", "\[InvisibleSpace]", "i"}]], 
        SubscriptBox["R", 
         RowBox[{"b", "\[InvisibleSpace]", "j"}]], 
        SubsuperscriptBox["G", 
         RowBox[{"a", "\[InvisibleSpace]", "b"}], "0"]}], "]"}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", "Q"], "G"}], " ", "=", " ", 
      RowBox[{
       SubscriptBox["Q", 
        RowBox[{"i", "\[InvisibleSpace]", "x"}]], "(", 
       RowBox[{
        SubscriptBox[
         RowBox[{"[", 
          RowBox[{
           SubsuperscriptBox["R", 
            RowBox[{"\[InvisibleSpace]", 
             RowBox[{
             "x", "\[InvisibleSpace]", "a", "\[InvisibleSpace]", "j"}]}], 
            "2"], 
           SubscriptBox["R", 
            RowBox[{"b", "\[InvisibleSpace]", "k"}]], 
           SubsuperscriptBox["G", 
            RowBox[{"a", "\[InvisibleSpace]", "b"}], "0"]}], "]"}], 
         RowBox[{
          RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}], 
          "+", 
          RowBox[{
          "i", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "j"}]}]], " ", 
        "+", " ", 
        RowBox[{"[", 
         RowBox[{
          SubscriptBox["R", 
           RowBox[{"a", "\[InvisibleSpace]", "j"}]], 
          SubscriptBox["R", 
           RowBox[{"b", "\[InvisibleSpace]", "k"}]], 
          SubsuperscriptBox["G", 
           RowBox[{"x", "\[InvisibleSpace]", "a", "\[InvisibleSpace]", "b"}], 
           "1"]}], "]"}]}], ")"}]}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Del]", 
        SuperscriptBox["Q", "2"]], "G"}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubsuperscriptBox["Q", 
          RowBox[{"i", "\[InvisibleSpace]", "x"}], "2"], "(", "...", ")"}], 
        " ", "+", " ", 
        RowBox[{
         SubscriptBox["Q", 
          RowBox[{"i", "\[InvisibleSpace]", "x"}]], 
         RowBox[{
          SubscriptBox["Q", 
           RowBox[{"i", "\[InvisibleSpace]", "x"}]], "(", 
          SubscriptBox[
           RowBox[{"[", 
            RowBox[{
             SubsuperscriptBox["R", 
              RowBox[{"\[InvisibleSpace]", 
               RowBox[{
               "x", "\[InvisibleSpace]", "a", "\[InvisibleSpace]", "j"}]}], 
              "3"], 
             SubscriptBox["R", 
              RowBox[{"b", "\[InvisibleSpace]", "k"}]], 
             SubsuperscriptBox["G", 
              RowBox[{"a", "\[InvisibleSpace]", "b"}], "0"]}], "]"}], 
           RowBox[{
            RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}],
             "+", 
            RowBox[{
            "i", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "j"}]}]], 
          ")"}]}], " ", "+"}], " ", "..."}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.921370590926725*^9, 3.921370751077484*^9}, {
  3.921370862366385*^9, 3.9213708652606*^9}, {3.926510446631332*^9, 
  3.926510459748108*^9}, {3.92651050408051*^9, 
  3.9265105508839808`*^9}},ExpressionUUID->"ebbce770-0ed8-43e5-bf2a-\
99a0aae915e8"],

Cell["and so we get", "ExpositoryText",
 CellChangeTimes->{{3.921370753676635*^9, 
  3.921370758420576*^9}},ExpressionUUID->"b1276fe9-7f14-4ad8-ab7b-\
684d5c6ab6dc"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SubscriptBox["\[Del]", 
            SuperscriptBox["R", "2"]], 
           SubscriptBox["Q", 
            RowBox[{"\[InvisibleSpace]", 
             RowBox[{
             "i", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "j"}]}]]}], 
          "+", 
          RowBox[{
           SubscriptBox["\[Del]", 
            SuperscriptBox["R", "2"]], 
           SubscriptBox["Q", 
            RowBox[{"\[InvisibleSpace]", 
             RowBox[{
             "j", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "i"}]}]]}]}],
          ")"}], 
        SubscriptBox["\[Omega]", "k"]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SubscriptBox["\[Del]", 
            SuperscriptBox["R", "2"]], 
           SubscriptBox["Q", 
            RowBox[{"\[InvisibleSpace]", 
             RowBox[{
             "i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]}]]}], 
          "+", 
          RowBox[{
           SubscriptBox["\[Del]", 
            SuperscriptBox["R", "2"]], 
           SubscriptBox["Q", 
            RowBox[{"\[InvisibleSpace]", 
             RowBox[{
             "k", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "i"}]}]]}]}],
          ")"}], 
        SubscriptBox["\[Omega]", "j"]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SubscriptBox["\[Del]", 
            SuperscriptBox["R", "2"]], 
           SubscriptBox["Q", 
            RowBox[{"\[InvisibleSpace]", 
             RowBox[{
             "j", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "k"}]}]]}], 
          "+", 
          RowBox[{
           SubscriptBox["\[Del]", 
            SuperscriptBox["R", "2"]], 
           SubscriptBox["Q", 
            RowBox[{"\[InvisibleSpace]", 
             RowBox[{
             "k", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "j"}]}]]}]}],
          ")"}], 
        SubscriptBox["\[Omega]", "i"]}]}], "=", " ", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["G", 
          RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}], 
          "1"], "+", 
         SubsuperscriptBox["G", 
          RowBox[{"j", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "k"}], 
          "1"], "+", 
         SubsuperscriptBox["G", 
          RowBox[{"k", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "j"}], 
          "1"]}], ")"}]}]}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              SubscriptBox["\[Del]", 
               SuperscriptBox["R", "2"]], 
              SubscriptBox["Q", 
               RowBox[{"\[InvisibleSpace]", 
                RowBox[{
                "i", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", 
                 "j"}]}]]}], "+", 
             RowBox[{
              SubscriptBox["\[Del]", 
               SuperscriptBox["R", "2"]], 
              SubscriptBox["Q", 
               RowBox[{"\[InvisibleSpace]", 
                RowBox[{
                "j", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", 
                 "i"}]}]]}]}], ")"}], 
           SubscriptBox["\[Omega]", "k"]}], "+", 
          RowBox[{
           SubscriptBox["\[Del]", 
            SuperscriptBox["R", "2"]], 
           RowBox[{
            SubscriptBox["Q", 
             RowBox[{"\[InvisibleSpace]", 
              RowBox[{
              "i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}]}]], 
            "(", 
            RowBox[{
             SubscriptBox["\[Omega]", "i"], "+", 
             SubscriptBox["\[Omega]", "j"]}], ")"}]}], "+", 
          RowBox[{
           SubscriptBox["\[Del]", 
            SuperscriptBox["R", "2"]], 
           SubscriptBox["Q", 
            RowBox[{"\[InvisibleSpace]", 
             RowBox[{
             "k", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "i"}]}]]}]}],
          ")"}], 
        SubscriptBox["\[Omega]", "j"]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"+", 
          RowBox[{
           SubscriptBox["\[Del]", 
            SuperscriptBox["R", "2"]], 
           SubscriptBox["Q", 
            RowBox[{"\[InvisibleSpace]", 
             RowBox[{
             "i", "\[InvisibleSpace]", "k", "\[InvisibleSpace]", "j"}]}]]}]}],
          ")"}], 
        SubscriptBox["\[Omega]", "i"]}]}], "=", " ", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["G", 
          RowBox[{"i", "\[InvisibleSpace]", "j", "\[InvisibleSpace]", "k"}], 
          "1"], "+", 
         SubsuperscriptBox["G", 
          RowBox[{"j", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "k"}], 
          "1"], "+", 
         SubsuperscriptBox["G", 
          RowBox[{"k", "\[InvisibleSpace]", "i", "\[InvisibleSpace]", "j"}], 
          "1"]}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.921370833677258*^9, 3.9213708930622053`*^9}, {
  3.9275999182079983`*^9, 3.9275999315730543`*^9}, {3.9276000087514*^9, 
