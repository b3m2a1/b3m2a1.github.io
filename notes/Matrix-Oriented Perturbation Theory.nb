       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          SubscriptBox["\[Delta]", 
           RowBox[{"\[InvisibleSpace]", 
            RowBox[{"j", "\[InvisibleSpace]", "0"}]}]]}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Delta]", 
           RowBox[{"i", "\[InvisibleSpace]", "0"}]], "-", 
          SubsuperscriptBox["\[ScriptCapitalF]", 
           RowBox[{"i", "\[InvisibleSpace]", "0"}], 
           RowBox[{"(", "b", ")"}]]}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"n", "=", 
            RowBox[{"j", "-", "1"}]}], 
           RowBox[{"2", "\[InvisibleSpace]", "b"}]], " ", 
          RowBox[{
           RowBox[{
            SubscriptBox["S", "2"], "(", 
            RowBox[{"0", ",", " \[InvisibleSpace]", "n"}], ")"}], " ", 
           FractionBox["1", 
            RowBox[{"n", "+", "1"}]], 
