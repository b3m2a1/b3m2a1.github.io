                  "}"}]}]}], "]"}], ",", " ", "\"\< \>\""}], "}"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"RowBox", "@", 
            RowBox[{"{", 
             RowBox[{"\"\< \>\"", ",", " ", 
              RowBox[{"SuperscriptBox", "[", 
               RowBox[{"\"\<n\>\"", ",", " ", 
                RowBox[{"RowBox", "@", 
                 RowBox[{"{", 
                  RowBox[{"\"\<(\>\"", ",", " ", 
                   RowBox[{"toPTBoxes", "@", "j"}], ",", " ", "\"\<)\>\""}], 
                  "}"}]}]}], "]"}]}], "}"}]}]}], "\[IndentingNewLine]", "}"}],
          ",", " ", "\"\<BraKet\>\""}], "]"}]}]}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"toPTBoxes", "[", "u_", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Replace", "[", 
    RowBox[{
     RowBox[{"u", "/.", "$ptFormattingRules"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"RawBoxes", "[", "x_", "]"}], "\[RuleDelayed]", "x"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"e_", ":>", 
        RowBox[{"ToBoxes", "@", "e"}]}]}], "\[IndentingNewLine]", "}"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"formatPTExpr", "[", "e_", "]"}], ":=", 
   RowBox[{"Cell", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"BoxData", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"boxTags", "=", 
           RowBox[{"<|", "|>"}]}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"e", "//.", "$ptFormattingRules"}], ")"}], "//.", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"p", ":", 
            RowBox[{"_Plus", "|", "_Times"}]}], "\[RuleDelayed]", 
           "\[IndentingNewLine]", 
           RowBox[{"ReplaceAll", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"ToBoxes", "[", "\[IndentingNewLine]", 
              RowBox[{"p", "/.", 
               RowBox[{
                RowBox[{"RawBoxes", "[", "x_", "]"}], "\[RuleDelayed]", 
                RowBox[{"With", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"h", "=", 
                    RowBox[{"Hash", "[", "x", "]"}]}], "}"}], ",", " ", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"boxTags", "[", "h", "]"}], "=", "x"}], ";", 
                   RowBox[{"Hold", "[", "h", "]"}]}]}], "]"}]}]}], 
              "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"RowBox", "[", 
               RowBox[{"{", 
                RowBox[{
                "\"\<Hold\>\"", ",", "\"\<[\>\"", ",", "i_", ",", 
                 "\"\<]\>\""}], "}"}], "]"}], "\[RuleDelayed]", 
              RowBox[{"boxTags", "[", 
               RowBox[{"ToExpression", "[", "i", "]"}], "]"}]}]}], 
            "\[IndentingNewLine]", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
       "//.", 
       RowBox[{
        RowBox[{"RawBoxes", "[", "x_", "]"}], "\[RuleDelayed]", "x"}]}], 
      "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", " ", 
     "\"\<InlineMath\>\""}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",\

