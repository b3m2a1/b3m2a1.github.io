       "Bra"], "(", 
      RowBox[{
       UnderscriptBox["\[Product]", "i"], " ", 
       RowBox[{
        SubsuperscriptBox["\[CapitalDelta]H", "n", 
         RowBox[{"(", 
          SubscriptBox["s", "i"], ")"}]], 
        SubscriptBox["\[CapitalPi]", "n"]}]}], ")"}], 
     RowBox[{
      SuperscriptBox["\[Mu]", 
       RowBox[{"(", "k", ")"}]], "(", 
      RowBox[{
       UnderscriptBox["\[Product]", "j"], " ", 
       RowBox[{
        SubscriptBox["\[CapitalPi]", "m"], 
        SubsuperscriptBox["\[CapitalDelta]H", "m", 
         RowBox[{"(", 
          SubscriptBox["r", "j"], ")"}]]}]}], ")"}], 
     TemplateBox[{
       SuperscriptBox["m", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8902370642379303`*^9, 
  3.890237188297009*^9}},ExpressionUUID->"85aa169d-9be5-4696-bdb4-\
5e866dac6fee"],

Cell["where", "ExpositoryText",
 CellChangeTimes->{{3.8902371952481337`*^9, 
  3.890237199339188*^9}},ExpressionUUID->"07f8399f-90cb-4f67-b9ba-\
6d6b94da21e9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", "i"], " ", 
     SubscriptBox["s", "i"]}], " ", "+", " ", 
    RowBox[{
     UnderscriptBox["\[Sum]", "j"], " ", 
     SubscriptBox["r", "j"]}], " ", "+", " ", "k"}], " ", "\[LessEqual]", " ",
    "N"}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.890237200817276*^9, 
  3.890237228001646*^9}},ExpressionUUID->"36505243-5e20-4f5d-b898-\
901c8e88dfe3"],

Cell[TextData[{
 "which will lead to long strings of raising and lowering operations, and in \
particular tabulating the options at second order with the linear dipole in \
",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Mu]", 
    RowBox[{"(", "0", ")"}]], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"3a9c43ea-8c7d-404e-af26-057920db4a83"],
 " we get"
}], "ExpositoryText",
 CellChangeTimes->{{3.890237230716112*^9, 3.890237233073387*^9}, {
  3.89023729570475*^9, 3.890237301863596*^9}, {3.890237853051097*^9, 
  3.890237889541033*^9}},ExpressionUUID->"3b708f2e-b415-46eb-a596-\
454b47e85e40"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       RowBox[{"#", 
        RowBox[{"\[LeftBracketingBar]", " ", 
         RowBox[{
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]]},
           "Bra"], 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"k", "=", "0"}], "2"], " ", 
           RowBox[{
            SuperscriptBox["\[Mu]", 
             RowBox[{"(", "k", ")"}]], 
            TemplateBox[{
              SuperscriptBox["m", 
               RowBox[{"(", "0", ")"}]]},
             "Ket"]}]}]}], " ", "\[RightBracketingBar]"}]}], " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{"1", ","}], ")"}]}], ",", " ", 
      RowBox[{"(", 
       RowBox[{"2", ","}], ")"}], ",", " ", 
      RowBox[{"(", 
       RowBox[{"3", ","}], ")"}]}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{"#", 
        RowBox[{"\[LeftBracketingBar]", " ", 
         RowBox[{
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]]},
           "Bra"], 
          SubsuperscriptBox["\[CapitalDelta]H", "n", 
           RowBox[{"(", "1", ")"}]], 
          SubscriptBox["\[CapitalPi]", "n"], 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"k", "=", "0"}], "1"], " ", 
           RowBox[{
            SuperscriptBox["\[Mu]", 
             RowBox[{"(", "k", ")"}]], 
            TemplateBox[{
              SuperscriptBox["m", 
               RowBox[{"(", "0", ")"}]]},
             "Ket"]}]}]}], " ", "\[RightBracketingBar]"}]}], " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{"3", ",", " ", "1"}], ")"}]}], ",", " ", 
      RowBox[{"(", 
       RowBox[{"3", ",", " ", "2"}], ")"}]}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{"#", 
        RowBox[{"\[LeftBracketingBar]", " ", 
         RowBox[{
          TemplateBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]]},
           "Bra"], 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"k", "=", "0"}], 
            RowBox[{"N", "-", "1"}]], " ", 
           RowBox[{
            SuperscriptBox["\[Mu]", 
             RowBox[{"(", "k", ")"}]], 
            SubscriptBox["\[CapitalPi]", "m"], 
            SubsuperscriptBox["\[CapitalDelta]H", "m", 
             RowBox[{"(", "1", ")"}]], 
            TemplateBox[{
              SuperscriptBox["m", 
               RowBox[{"(", "0", ")"}]]},
             "Ket"]}]}]}], " ", "\[RightBracketingBar]"}]}], " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{"1", ",", " ", "3"}], ")"}]}], ",", " ", 
      RowBox[{"(", 
       RowBox[{"2", ",", " ", "3"}], ")"}]}]},
    {
     RowBox[{
      RowBox[{"#", 
       RowBox[{"\[LeftBracketingBar]", " ", 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], 
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", "2", ")"}]], 
         SubscriptBox["\[CapitalPi]", "n"], " ", 
         SuperscriptBox["\[Mu]", 
          RowBox[{"(", "0", ")"}]], 
         TemplateBox[{
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"]}], " ", "\[RightBracketingBar]"}]}], " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{"4", ",", " ", "1"}], ")"}]}]},
    {
     RowBox[{
      RowBox[{"#", 
       RowBox[{"\[LeftBracketingBar]", " ", 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], " ", 
         SuperscriptBox["\[Mu]", 
          RowBox[{"(", "0", ")"}]], 
         SubscriptBox["\[CapitalPi]", "m"], 
         SubsuperscriptBox["\[CapitalDelta]H", "m", 
          RowBox[{"(", "2", ")"}]], 
         TemplateBox[{
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"]}], " ", "\[RightBracketingBar]"}]}], " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{"1", ",", " ", "4"}], ")"}]}]},
    {
     RowBox[{
      RowBox[{"#", 
       RowBox[{"\[LeftBracketingBar]", " ", 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], 
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", "1", ")"}]], " ", 
         SubscriptBox["\[CapitalPi]", "n"], " ", 
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", "1", ")"}]], 
         SubscriptBox["\[CapitalPi]", "n"], " ", 
         SuperscriptBox["\[Mu]", 
          RowBox[{"(", "0", ")"}]], 
         TemplateBox[{
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"]}], " ", "\[RightBracketingBar]"}]}], " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{"3", ",", " ", "3", ",", " ", "1"}], ")"}]}]},
    {
     RowBox[{
      RowBox[{"#", 
       RowBox[{"\[LeftBracketingBar]", " ", 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], " ", 
         SuperscriptBox["\[Mu]", 
          RowBox[{"(", "0", ")"}]], 
         SubscriptBox["\[CapitalPi]", "m"], 
         SubsuperscriptBox["\[CapitalDelta]H", "m", 
          RowBox[{"(", "1", ")"}]], 
         SubscriptBox["\[CapitalPi]", "m"], 
         SubsuperscriptBox["\[CapitalDelta]H", "m", 
          RowBox[{"(", "1", ")"}]], 
         TemplateBox[{
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"]}], " ", "\[RightBracketingBar]"}]}], " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{"1", ",", " ", "3", ",", " ", "3"}], ")"}]}]},
    {
     RowBox[{
      RowBox[{"#", 
       RowBox[{"\[LeftBracketingBar]", " ", 
        RowBox[{
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Bra"], 
         SubsuperscriptBox["\[CapitalDelta]H", "n", 
          RowBox[{"(", "1", ")"}]], 
         SubscriptBox["\[CapitalPi]", "n"], " ", 
         SuperscriptBox["\[Mu]", 
          RowBox[{"(", "0", ")"}]], 
         SubscriptBox["\[CapitalPi]", "m"], " ", 
         SubsuperscriptBox["\[CapitalDelta]H", "m", 
          RowBox[{"(", "1", ")"}]], 
         TemplateBox[{
           SuperscriptBox["m", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"]}], " ", "\[RightBracketingBar]"}]}], " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{"3", ",", " ", "1", ",", " ", "3"}], ")"}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.890237933225856*^9, 3.8902380830715647`*^9}, {
  3.89023815669142*^9, 3.890238279721324*^9}, {3.8902383815889883`*^9, 
  3.890238404113703*^9}, {3.890243982477089*^9, 
  3.890244017936474*^9}},ExpressionUUID->"688e56e6-8ce1-4cdd-97cc-\
6cc1826f1c29"],

Cell["\<\
but given the appropriate expansion coefficients for each operator, we can of \
course work this all out programmatically\
\>", "ExpositoryText",
 CellChangeTimes->{{3.890243857296468*^9, 3.8902439082405*^9}, {
  3.890244045114357*^9, 
  3.8902440483928003`*^9}},ExpressionUUID->"9d8f1512-1646-4372-88a9-\
b63e1ab9d31f"],

Cell[TextData[{
 "At the end of the day, though, as noted we\[CloseCurlyQuote]re taking every \
possible sequence of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "169c358c-3aec-4688-839f-21409e27b819"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Mu]", 
    RowBox[{"(", "k", ")"}]], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "1a2c312e-fdf8-4d4c-aac3-fab23c7107aa"],
 "where the sum of the exponents is less than or equal to our total order \
(and of course we can add on corrections pretty easily)"
}], "ExpositoryText",
 CellChangeTimes->{{3.890244049856923*^9, 
  3.8902441492313633`*^9}},ExpressionUUID->"095f0d70-3dde-49e0-af8f-\
90c9e007e61f"],

Cell["Each of these operators now can be expanded like", "ExpositoryText",
 CellChangeTimes->{{3.8902441679479303`*^9, 
  3.890244181644001*^9}},ExpressionUUID->"a1c9b2c1-a06d-4938-ad1b-\
f68ddb54d628"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{"z", "\[Element]", 
      RowBox[{"idx", "(", "i", ")"}]}]], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["V", "z"], "\[PlusMinus]", 
       SubscriptBox["G", "z"]}], ")"}], "\[VeryThinSpace]", "a", 
     "\[InvisibleSpace]", "b", "\[InvisibleSpace]", "c"}]}], "..."}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8902441828518333`*^9, 3.890244243883*^9}, {
  3.8902442927802887`*^9, 3.890244295652812*^9}, {3.890305627407652*^9, 
  3.89030563726301*^9}},ExpressionUUID->"d3b92fb4-52d4-47fc-91e5-\
925669530dc2"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"a", "\[InvisibleSpace]", "b", "\[InvisibleSpace]", "c"}], 
    "..."}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "4d183148-e2fe-450c-82c8-80669d182814"],
 " are strings of raising and lowering operations"
}], "ExpositoryText",
 CellChangeTimes->{{3.890305639165812*^9, 
  3.89030565793554*^9}},ExpressionUUID->"c7f287d1-2a1e-4135-b32c-\
21311437585e"],

Cell["Therefore to evaluate, say", "ExpositoryText",
 CellChangeTimes->{{3.890305659901567*^9, 3.890305669593104*^9}, {
  3.890305891582273*^9, 
  3.890305894246832*^9}},ExpressionUUID->"9bd7f382-4622-48ad-9a3a-\
7c5597879630"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Bra"], 
   SubsuperscriptBox["\[CapitalDelta]H", "n", 
    RowBox[{"(", "1", ")"}]], 
   SubscriptBox["\[CapitalPi]", "n"], " ", 
   SuperscriptBox["\[Mu]", 
    RowBox[{"(", "0", ")"}]], 
   SubscriptBox["\[CapitalPi]", "m"], " ", 
   SubsuperscriptBox["\[CapitalDelta]H", "m", 
    RowBox[{"(", "1", ")"}]], 
   TemplateBox[{
     SuperscriptBox["m", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], " "}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.890305897926506*^9, 
  3.890305911276506*^9}},ExpressionUUID->"bac55e22-b8d0-42fa-9c0e-\
75158c1474c5"],

Cell[TextData[{
 "we need to first determine which quantum number changes we need to do to \
get from ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "e38255a1-27a1-4de0-be3f-cfe0df343468"],
 " to ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "a8d46a69-c523-48c7-9556-b347a507a563"],
 ", then we have to write out the classes of \[OpenCurlyDoubleQuote]do \
nothing\[CloseCurlyDoubleQuote] terms in the remaining coordinates, which if \
we have say 8 remaining operators looks like"
}], "ExpositoryText",
 CellChangeTimes->{{3.89030589998315*^9, 
  3.8903059898283653`*^9}},ExpressionUUID->"14be3055-c603-448b-b723-\
99f95e0e25f0"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{"\[InvisibleSpace]", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"i", "\[InvisibleSpace]"}], "+"], "\[InvisibleSpace]", 
       SuperscriptBox["i", "-"], 
       SuperscriptBox[
        RowBox[{"i", "\[InvisibleSpace]"}], "+"], "\[InvisibleSpace]", 
       SuperscriptBox["i", "-"], 
       SuperscriptBox[
        RowBox[{"i", "\[InvisibleSpace]"}], "+"], "\[InvisibleSpace]", 
       SuperscriptBox["i", "-"], 
       SuperscriptBox[
        RowBox[{"i", "\[InvisibleSpace]"}], "+"], "\[InvisibleSpace]", 
       SuperscriptBox["i", "-"]}]}]},
    {
     RowBox[{
      SuperscriptBox[
       RowBox[{"i", "\[InvisibleSpace]"}], "+"], "\[InvisibleSpace]", 
      SuperscriptBox["i", "-"], 
      SuperscriptBox[
       RowBox[{"i", "\[InvisibleSpace]"}], "+"], "\[InvisibleSpace]", 
      SuperscriptBox["i", "-"], 
      SuperscriptBox[
       RowBox[{"i", "\[InvisibleSpace]"}], "+"], "\[InvisibleSpace]", 
      SuperscriptBox["i", "-"], 
      SuperscriptBox[
       RowBox[{"j", "\[InvisibleSpace]"}], "+"], "\[InvisibleSpace]", 
      SuperscriptBox["j", "-"]}]},
    {
     RowBox[{
      SuperscriptBox[
       RowBox[{"i", "\[InvisibleSpace]"}], "+"], "\[InvisibleSpace]", 
      SuperscriptBox["i", "-"], 
      SuperscriptBox[
       RowBox[{"i", "\[InvisibleSpace]"}], "+"], "\[InvisibleSpace]", 
      SuperscriptBox["i", "-"], 
      SuperscriptBox[
       RowBox[{"j", "\[InvisibleSpace]"}], "+"], "\[InvisibleSpace]", 
      SuperscriptBox["j", "-"], 
      SuperscriptBox[
       RowBox[{"j", "\[InvisibleSpace]"}], "+"], "\[InvisibleSpace]", 
      SuperscriptBox["j", "-"]}]},
    {
     RowBox[{
      SuperscriptBox[
       RowBox[{"i", "\[InvisibleSpace]"}], "+"], "\[InvisibleSpace]", 
      SuperscriptBox["i", "-"], 
      SuperscriptBox[
       RowBox[{"j", "\[InvisibleSpace]"}], "+"], "\[InvisibleSpace]", 
      SuperscriptBox["j", "-"], 
      SuperscriptBox[
       RowBox[{"j", "\[InvisibleSpace]"}], "+"], "\[InvisibleSpace]", 
      SuperscriptBox["j", "-"], 
      SuperscriptBox[
       RowBox[{"k", "\[InvisibleSpace]"}], "+"], "\[InvisibleSpace]", 
      SuperscriptBox["k", "-"]}]},
    {
     RowBox[{
      SuperscriptBox[
       RowBox[{"i", "\[InvisibleSpace]"}], "+"], "\[InvisibleSpace]", 
      SuperscriptBox["i", "-"], 
      SuperscriptBox[
       RowBox[{"i", "\[InvisibleSpace]"}], "+"], "\[InvisibleSpace]", 
      SuperscriptBox["i", "-"], 
      SuperscriptBox[
       RowBox[{"j", "\[InvisibleSpace]"}], "+"], "\[InvisibleSpace]", 
      SuperscriptBox["j", "-"], 
      SuperscriptBox[
       RowBox[{"k", "\[InvisibleSpace]"}], "+"], "\[InvisibleSpace]", 
      SuperscriptBox["k", "-"]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8903059912429123`*^9, 
  3.8903061034191236`*^9}},ExpressionUUID->"dc19526f-604f-4131-8765-\
57a35b7ed57c"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "7b5fd97f-726e-4012-afb7-bba833bec60f"],
 ", ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "17603054-4b34-479c-9ed3-625a5316eb17"],
 ", and ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "14259f8b-057f-4c1c-8538-59585db2db6d"],
 " can take on any value, which means we do need to consider when they are \
the same as one of the changed coordinates and when they are not"
}], "ExpositoryText",
 CellChangeTimes->{{3.8903061418714457`*^9, 
  3.890306215241116*^9}},ExpressionUUID->"b30c846c-f341-4cd3-8c92-\
5428b4802712"],

Cell[TextData[{
 "For each class of raising and lowering operations, we then enumerate the ",
 StyleBox["subclasses",
  FontSlant->"Italic"],
 " of terms, by noting the different ways we can distribute them over the \
corresponding operators, again, for"
}], "ExpositoryText",
 CellChangeTimes->{{3.890306285765069*^9, 3.8903063097658157`*^9}, {
  3.890306343771248*^9, 3.890306377210702*^9}, {3.894132075032915*^9, 
  3.894132081422133*^9}},ExpressionUUID->"1a1776df-e696-4b01-a36b-\
bc0621b5ca2a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Bra"], 
   SubsuperscriptBox["\[CapitalDelta]H", "n", 
    RowBox[{"(", "1", ")"}]], 
   SubscriptBox["\[CapitalPi]", "n"], " ", 
   SuperscriptBox["\[Mu]", 
    RowBox[{"(", "0", ")"}]], 
   SubscriptBox["\[CapitalPi]", "m"], " ", 
   SubsuperscriptBox["\[CapitalDelta]H", "m", 
    RowBox[{"(", "1", ")"}]], 
   TemplateBox[{
     SuperscriptBox["m", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], " "}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.890305897926506*^9, 
  3.890305911276506*^9}},ExpressionUUID->"fb36ba82-f22d-44d8-bc45-\
0e92f4161eac"],

Cell[TextData[{
 "the operator string ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["i", "+"], 
    SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
    SuperscriptBox["j", "+"], 
    SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
    SuperscriptBox["i", "\[Minus]"], 
    SuperscriptBox["k", "+"], "\[InvisibleSpace]", 
    SuperscriptBox["k", "\[Minus]"]}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "1663302c-4a54-4076-a408-76cff2a4e061"],
 " would have the classes"
}], "ExpositoryText",
 CellChangeTimes->{{3.890306384591448*^9, 
  3.890306469861904*^9}},ExpressionUUID->"0854d930-94fd-43d0-93b7-\
e106bab0fee7"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SuperscriptBox["i", "+"], 
      SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
      SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
      SuperscriptBox["i", "\[Minus]"], 
      SuperscriptBox["j", "+"], 
      SuperscriptBox["k", "+"], "\[InvisibleSpace]", 
      SuperscriptBox["k", "\[Minus]"]}]},
    {
     RowBox[{
      SuperscriptBox["i", "+"], 
      SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
      SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
      SuperscriptBox["i", "\[Minus]"], 
      SuperscriptBox["j", "+"], 
      SuperscriptBox["k", "\[Minus]"], "\[InvisibleSpace]", 
      SuperscriptBox["k", "+"], "\[InvisibleSpace]"}]},
    {
     RowBox[{
      SuperscriptBox["i", "+"], 
      SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
      SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
      SuperscriptBox["i", "\[Minus]"], 
      SuperscriptBox["k", "+"], 
      SuperscriptBox["j", "+"], "\[InvisibleSpace]", 
      SuperscriptBox["k", "\[Minus]"]}]},
    {
     RowBox[{
      SuperscriptBox["i", "+"], 
      SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
      SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
      SuperscriptBox["i", "\[Minus]"], 
      SuperscriptBox["k", "-"], 
      SuperscriptBox["j", "+"], "\[InvisibleSpace]", 
      SuperscriptBox["k", "+"]}]},
    {
     RowBox[{
      SuperscriptBox["i", "+"], 
      SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
      SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
      SuperscriptBox["i", "\[Minus]"], 
      SuperscriptBox["k", "+"], "\[InvisibleSpace]", 
      SuperscriptBox["k", "-"], 
      SuperscriptBox["j", "+"]}]},
    {"..."}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.890306474294424*^9, 3.890306606649543*^9}, {
  3.8903245218431664`*^9, 
  3.890324556896613*^9}},ExpressionUUID->"5aa9ef35-08a6-415f-ba07-\
dfc44b8569a3"],

Cell["\<\
but we can reduce much of this over permutations by the work done before, so \
we are better off characterizing this by the number of operations in each \
dimension in each of three buckets, so like\
\>", "ExpositoryText",
 CellChangeTimes->{{3.890324588319933*^9, 3.89032463698934*^9}, 
   3.890393018435484*^9},ExpressionUUID->"edcef0bc-5f84-4b5d-a750-\
7b50640a01cd"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SuperscriptBox["i", "+"], 
       SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
       SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
       SuperscriptBox["i", "\[Minus]"], 
       SuperscriptBox["j", "+"], 
       SuperscriptBox["k", "+"], "\[InvisibleSpace]", 
       SuperscriptBox["k", "\[Minus]"]}], " ", "->", " ", 
      RowBox[{
       RowBox[{"[", 
        RowBox[{"3", ",", " ", "0", ",", " ", "0"}], "]"}], " ", "|", " ", 
       RowBox[{"[", 
        RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "]"}], " ", "|", " ", 
       RowBox[{"[", 
        RowBox[{"0", ",", " ", "1", ",", " ", "2"}], "]"}]}]}]},
    {
     RowBox[{
      RowBox[{
       SuperscriptBox["i", "+"], 
       SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
       SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
       SuperscriptBox["i", "\[Minus]"], 
       SuperscriptBox["j", "+"], 
       SuperscriptBox["k", "\[Minus]"], "\[InvisibleSpace]", 
       SuperscriptBox["k", "+"]}], " ", "->", " ", 
      RowBox[{
       RowBox[{"[", 
        RowBox[{"3", ",", " ", "0", ",", " ", "0"}], "]"}], " ", "|", " ", 
       RowBox[{"[", 
        RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "]"}], " ", "|", " ", 
       RowBox[{"[", 
        RowBox[{"0", ",", " ", "1", ",", " ", "2"}], "]"}], 
       "\[InvisibleSpace]"}]}]},
    {
     RowBox[{
      RowBox[{
       SuperscriptBox["i", "+"], 
       SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
       SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
       SuperscriptBox["i", "\[Minus]"], 
       SuperscriptBox["k", "+"], 
       SuperscriptBox["j", "+"], "\[InvisibleSpace]", 
       SuperscriptBox["k", "\[Minus]"]}], " ", "->", " ", 
      RowBox[{
       RowBox[{"[", 
        RowBox[{"3", ",", " ", "0", ",", " ", "0"}], "]"}], " ", "|", " ", 
       RowBox[{"[", 
        RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "]"}], " ", "|", " ", 
       RowBox[{"[", 
        RowBox[{"0", ",", " ", "1", ",", " ", "2"}], "]"}]}]}]},
    {
     RowBox[{
      RowBox[{
       SuperscriptBox["i", "+"], 
       SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
       SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
       SuperscriptBox["i", "\[Minus]"], 
       SuperscriptBox["k", "-"], 
       SuperscriptBox["j", "+"], "\[InvisibleSpace]", 
       SuperscriptBox["k", "+"]}], " ", "->", " ", 
      RowBox[{
       RowBox[{"[", 
        RowBox[{"3", ",", " ", "0", ",", " ", "0"}], "]"}], " ", "|", " ", 
       RowBox[{"[", 
        RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "]"}], " ", "|", " ", 
       RowBox[{"[", 
        RowBox[{"0", ",", " ", "1", ",", " ", "2"}], "]"}]}]}]},
    {
     RowBox[{
      RowBox[{
       SuperscriptBox["i", "+"], 
       SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
       SuperscriptBox["i", "+"], "\[InvisibleSpace]", 
       SuperscriptBox["i", "\[Minus]"], 
       SuperscriptBox["k", "+"], "\[InvisibleSpace]", 
       SuperscriptBox["k", "-"], 
       SuperscriptBox["j", "+"]}], " ", "->", " ", 
      RowBox[{
       RowBox[{"[", 
        RowBox[{"3", ",", " ", "0", ",", " ", "0"}], "]"}], " ", "|", " ", 
       RowBox[{"[", 
        RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "]"}], " ", "|", " ", 
       RowBox[{"[", 
        RowBox[{"0", ",", " ", "1", ",", " ", "2"}], "]"}]}]}]},
    {"..."}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.890324614219075*^9, 3.8903247007828074`*^9}, {
  3.890324810322904*^9, 3.8903249137610188`*^9}, {3.8903929438558397`*^9, 
  3.890392947887117*^9}, {3.890393008815433*^9, 
  3.890393063799367*^9}},ExpressionUUID->"e4175a24-7fab-455d-bdd1-\
6dba956fc01d"],

Cell[TextData[{
 "which as we can see reduces all of these different permutations to just one \
subclass, and indeed these subclasses are straightforwardly enumerable, first \
by noting that we have buckets of length 3, 1, and 3, and 4 terms in \
dimension ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "fafd0f55-3217-4382-ae74-383df6b08a59"],
 ", 1 term in dimension ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "1d6c6af5-a0a1-49e1-82b2-63ecfb5d89c6"],
 ", and 2 in dimension ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "584083cc-4e81-48ec-a27e-2a3e5ccf1601"],
 " which we\[CloseCurlyQuote]ll distribute recursively"
}], "ExpositoryText",
 CellChangeTimes->{{3.8903249163229437`*^9, 3.890324936131075*^9}, {
  3.89032515234016*^9, 3.890325225858042*^9}, {3.8903292595733433`*^9, 
  3.890329259893141*^9}, {3.890329321971199*^9, 3.89032938986023*^9}, {
  3.8903295801346617`*^9, 
  3.8903295995846443`*^9}},ExpressionUUID->"adc457a6-5d27-4fdf-ae8d-\
8a01c7851538"],

Cell[TextData[{
 "First, we can start off by taking the integer partitions of 4",
 Cell[BoxData[
  FormBox["i", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "b34db739-e895-4521-9bfc-1864b41dc713"],
 " into up to 3 terms and distribute these over the different buckets, like"
}], "ExpositoryText",
 CellChangeTimes->{{3.890329601672124*^9, 3.890329620993511*^9}, {
  3.8903296618243313`*^9, 3.8903296685022287`*^9}, {3.890329733416494*^9, 
  3.8903297417653437`*^9}},ExpressionUUID->"f4e96298-92d2-4007-84fe-\
e785f118ed3d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{"3", " ", "|", " ", "1", " ", "|", " ", "0"}], ")"}], ",", " ", 
   RowBox[{"(", 
    RowBox[{"3", " ", "|", " ", "0", " ", "|", " ", "1"}], ")"}], ",", " ", 
   RowBox[{"(", 
    RowBox[{"1", " ", "|", " ", "0", " ", "|", " ", "3"}], ")"}], ",", " ", 
   RowBox[{"(", 
    RowBox[{"0", " ", "|", " ", "1", " ", "|", " ", "3"}], ")"}], ",", " ", 
   RowBox[{"(", 
    RowBox[{"2", " ", "|", " ", "0", " ", "|", " ", "2"}], ")"}], ",", " ", 
   RowBox[{"(", 
    RowBox[{"2", " ", "|", " ", "1", " ", "|", " ", "1"}], ")"}], ",", " ", 
   RowBox[{"(", 
    RowBox[{"1", " ", "|", " ", "1", " ", "|", " ", "2"}], ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8903296707013683`*^9, 3.890329712123847*^9}, {
  3.890329866034287*^9, 3.890329871914898*^9}, {3.890330060107748*^9, 
  3.890330060271441*^9}, {3.890393071778985*^9, 
  3.890393095785709*^9}},ExpressionUUID->"8d19645c-37d9-488f-a9a6-\
ce49bff59f5e"],

Cell[TextData[{
 "then we can take the 1 in dimension ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "6c9e228a-7ec2-4397-bdfe-95168ef26311"],
 " and add that to the buckets in as many ways as are possible"
}], "ExpositoryText",
 CellChangeTimes->{{3.8903297152838297`*^9, 
  3.89032975695779*^9}},ExpressionUUID->"6bd8371c-8b0d-4822-b140-\
3882f7d98d57"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"[", 
         RowBox[{"3", ",", " ", "0"}], "]"}], " ", "|", " ", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "0"}], "]"}], " ", "|", " ", 
        RowBox[{"[", 
         RowBox[{"0", ",", " ", "1"}], "]"}]}], ")"}], ",", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"[", 
         RowBox[{"3", ",", " ", "0"}], "]"}], " ", "|", " ", 
        RowBox[{"[", 
         RowBox[{"0", ",", " ", "1"}], "]"}], " ", "|", " ", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "0"}], "]"}]}], ")"}], ",", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"[", 
         RowBox[{"3", ",", " ", "0"}], "]"}], " ", "|", " ", 
        RowBox[{"[", 
         RowBox[{"0", ",", " ", "0"}], "]"}], " ", "|", " ", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "1"}], "]"}]}], ")"}]}]},
    {
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"[", 
         RowBox[{"0", ",", " ", "1"}], "]"}], " ", "|", " ", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "0"}], "]"}], " ", "|", " ", 
        RowBox[{"[", 
         RowBox[{"3", ",", " ", "0"}], "]"}]}], ")"}], ",", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "0"}], "]"}], " ", "|", " ", 
        RowBox[{"[", 
         RowBox[{"0", ",", " ", "1"}], "]"}], " ", "|", " ", 
        RowBox[{"[", 
         RowBox[{"3", ",", " ", "0"}], "]"}]}], ")"}], ",", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "1"}], "]"}], " ", "|", " ", 
        RowBox[{"[", 
         RowBox[{"0", ",", " ", "0"}], "]"}], " ", "|", " ", 
        RowBox[{"[", 
         RowBox[{"3", ",", " ", "0"}], "]"}]}], ")"}]}]},
    {
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "1"}], "]"}], " ", "|", " ", 
        RowBox[{"[", 
         RowBox[{"0", ",", " ", "0"}], "]"}], " ", "|", " ", 
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "0"}], "]"}]}], ")"}], ",", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "0"}], "]"}], " ", "|", " ", 
        RowBox[{"[", 
         RowBox[{"0", ",", " ", "1"}], "]"}], " ", "|", " ", 
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "0"}], "]"}]}], ")"}], ",", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "0"}], "]"}], " ", "|", " ", 
        RowBox[{"[", 
         RowBox[{"0", ",", " ", "0"}], "]"}], " ", "|", " ", 
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "1"}], "]"}]}], ")"}]}]},
    {"..."}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8903296707013683`*^9, 3.890329712123847*^9}, {
  3.890329761817822*^9, 3.890329905817947*^9}, {3.890329938678954*^9, 
  3.890329987996731*^9}, {3.890330041857965*^9, 3.890330057264061*^9}, {
  3.8903929500690317`*^9, 3.8903930035733356`*^9}, {3.890393098671295*^9, 
  3.890393164453405*^9}},ExpressionUUID->"45216ffa-ca74-4a95-97cd-\
28e1c4bc1014"],

Cell["\<\
and finally we can iterate over the permutations of the integer partitions of \
2 and add those in\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8903300635397263`*^9, 
  3.890330097268238*^9}},ExpressionUUID->"fc07820a-7dee-44ff-9071-\
1fbea95e818c"],

Cell["\<\
This will give us the ways we can divide the operations up, then we can use \
the recursive strategy for enumerating the possible energetic contributions \
from there, giving us energy change paths in each dimension for each class of \
terms\
\>", "ExpositoryText",
 CellChangeTimes->{{3.890330100833262*^9, 3.890330145354217*^9}, {
  3.890392849837521*^9, 3.890392883699203*^9}, {3.890393176666656*^9, 
  3.89039317725273*^9}},ExpressionUUID->"3c78d0ec-5039-444f-a49b-\
4eab36d92916"],

Cell["\<\
The energy contribution then will be the direct product of the polynomials \
over each path with divided by the direct product of the energy changes, all \
multiplied by the appropriate operator expansion coefficients\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8903931861386843`*^9, 
  3.890393264859172*^9}},ExpressionUUID->"536445c0-b603-4264-91ca-\
f3942e922356"],

Cell[CellGroupData[{

Cell["Tail Recursive Expansions", "Subsubsubsection",
 CellChangeTimes->{{3.890395326973701*^9, 
  3.890395333302614*^9}},ExpressionUUID->"707452bd-d4f1-4b29-b3c7-\
30adadfd373d"],

Cell["\<\
Finally, if we can take these tail-recursive processes and expand them out to \
build up as functions of permutations we should be able to parallelize well \
so to that we\[CloseCurlyQuote]ll provide a constructive algorithm for \
enumerating the classes of terms possible over a set of buckets and terms\
\>", "ExpositoryText",
 CellChangeTimes->{{3.8903951130126543`*^9, 3.8903951322093563`*^9}, {
  3.8903951762574997`*^9, 3.890395178169121*^9}, {3.890395226114278*^9, 
  3.890395368707922*^9}},ExpressionUUID->"8f714eec-43b7-4ca1-a60b-\
610b7ee42cf8"],

Cell[TextData[{
 "To start, we note that given ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "6dbe0a73-0d23-4b0b-b7fb-7e272f64103b"],
 " buckets ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox["s", "i"], "}"}], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"39b4f997-22a0-49fe-91e5-4604fcb96909"],
 " and a set of numbers of operations ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox["o", "j"]}], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"9254f041-1284-488d-b2ab-a79fa41521cc"],
 "}, we can take our first operator and divide it up into its integer \
partitions"
}], "ExpositoryText",
 CellChangeTimes->{{3.8903953711154757`*^9, 3.890395463890224*^9}, {
  3.89039549679145*^9, 
  3.8903955212231092`*^9}},ExpressionUUID->"c78bac35-316c-423b-9ec7-\
bea9183dda59"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Pi]", "1"], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["n", "1"], ",", " ", 
         SubscriptBox["n", "2"], ",", " ", "...", ",", " ", 
         SubscriptBox["n", "N"]}], ")"}], "k"], " ", "\[VerticalSeparator]", 
      " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["n", "1"], "+"}], "..."}], "+", 
       SubscriptBox["n", "N"]}]}], "=", 
     SubscriptBox["o", "1"]}], " ", "}"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.890395465226877*^9, 3.890395494029337*^9}, {
  3.8903955278952503`*^9, 
  3.890395557855316*^9}},ExpressionUUID->"ee5ab8da-efb2-4c26-9d7a-\
d07bbedfa2f5"],

Cell[TextData[{
 "taking then all the permutations of this, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubsuperscriptBox["\[Sigma]", "l", 
     RowBox[{"(", "1", ")"}]], "}"}], TraditionalForm]], 
  "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "252e0004-f11e-4674-9c42-d616ab14ef43"],
 ", dropping the ones that don\[CloseCurlyQuote]t go cleanly into the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox["s", "i"], "}"}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "d66e345d-4d1e-4d53-81d6-a3fd2d14a5ab"],
 ", for each permutation/partition we get a new set of buckets and we\
\[CloseCurlyQuote]ve reduced our set of operators by 1"
}], "ExpositoryText",
 CellChangeTimes->{{3.8903955850344133`*^9, 3.890395625671586*^9}, {
  3.890395689988729*^9, 3.8903957606743107`*^9}, {3.890395808318933*^9, 
  3.890395824498817*^9}},ExpressionUUID->"3e093b16-e3da-463c-801b-\
ba24ec5777b2"],

Cell[TextData[{
 "However, we can also do this in the ",
 StyleBox["opposite",
  FontSlant->"Italic"],
 " direction, by building towards the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox["s", "i"], "}"}], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"a0895a10-4b86-422d-97b2-6299651b15aa"],
 ", starting from every admissible permutation partition",
 " "
}], "ExpositoryText",
 CellChangeTimes->{{3.890395827491309*^9, 
  3.890395894343452*^9}},ExpressionUUID->"7a248a74-d0e8-4460-82d2-\
bb01ea04bcdf"],

Cell[TextData[{
 "Why does this help? Well from this, it should be clear that we will need \
all of the integer partitions with maximum part no larger than the biggest ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "i"], TraditionalForm]], "ExpositoryTextInline",
  ExpressionUUID->"5ec59b81-ca92-4fe9-8fe1-c3f2c7e1d33c"],
 " of all of our operators, so we can precompute those"
}], "ExpositoryText",
 CellChangeTimes->{{3.8903959441138687`*^9, 3.8903960183973017`*^9}, {
  3.89039728339186*^9, 
  3.890397295116193*^9}},ExpressionUUID->"e39f83e3-cbcc-4235-8081-\
974fc4b9855a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tree Expression for Classes of Terms ", "Subsubsubsection",
 CellChangeTimes->{{3.890769890108324*^9, 
  3.8907698984627457`*^9}},ExpressionUUID->"6edaf92c-c1e5-4e96-a275-\
3c15fde26280"],

Cell[TextData[{
 "We have boxes ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox["s", "i"], "}"}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "68337085-98a7-49fd-abd5-0f504c588a19"],
 " and ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "da1a55d7-3e8b-4183-8d6a-d172c63a6388"],
 " steps ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox["n", "j"], "}"}], TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "da7b2fe9-1349-43b8-942e-68b610ed6fd6"],
 ", which means we get trees of depth ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "ExpositoryTextInline",
  FormatType->TraditionalForm,ExpressionUUID->
  "8cfbecb3-1347-457b-ba1e-42a37f3078f5"],
 " "
}], "ExpositoryText",
 CellChangeTimes->{{3.890769899757701*^9, 
  3.8907699617314777`*^9}},ExpressionUUID->"ae7df9f6-9d5d-4ee5-bf0b-\
f86c4b35cdc9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "buildParitionTree", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"buildParitionTree", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"boxes", ":", 
      RowBox[{"{", "__Integer", "}"}]}], ",", " ", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"step_Integer", ",", " ", "rest___Integer"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Hold", "[", 
      RowBox[{"cache_Symbol", "?", "AssociationQ"}], "]"}]}], 
    "\[IndentingNewLine]", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Block", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"boxMax", "=", 
        RowBox[{"Max", "@", "boxes"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"numBoxes", "=", 
        RowBox[{"Length", "@", "boxes"}]}], ",", "\[IndentingNewLine]", 
       "parts", ",", "\[IndentingNewLine]", "newBox", ",", 
       "\[IndentingNewLine]", "newPerm"}], "\[IndentingNewLine]", "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"parts", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"PadRight", "[", 
          RowBox[{"#", ",", " ", "numBoxes"}], "]"}], "&"}], "/@", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"IntegerPartitions", "[", 
           RowBox[{"step", ",", " ", "numBoxes"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "<=", "boxMax"}], "&"}]}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"newBox", "=", 
          RowBox[{"boxes", "-", "p"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Min", "@", "newBox"}], ">=", "0"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"newPerm", "=", 
             RowBox[{"Reverse", "@", 
