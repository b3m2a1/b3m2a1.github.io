Cell["In the two state case we have", "ExpositoryText",
 CellChangeTimes->{{3.821225586405218*^9, 
  3.821225607262898*^9}},ExpressionUUID->"fe12fb83-049c-4bb4-90b7-\
b877110d01f3"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       RowBox[{
        TemplateBox[{"n"},
         "Bra"], 
        SubscriptBox["P", "U"], "H", "\[VeryThinSpace]", 
        SubscriptBox["P", "U"], 
        TemplateBox[{"n"},
         "Ket"]}], "+", 
       RowBox[{
        TemplateBox[{"n"},
         "Bra"], 
        SubscriptBox["P", "U"], "H", "\[VeryThinSpace]", 
        SubscriptBox["P", "D"], 
        TemplateBox[{"n"},
         "Ket"]}]}], "=", 
      RowBox[{
       SubscriptBox["E", "n"], 
       TemplateBox[{"n"},
        "Bra"], 
       SubscriptBox["P", "U"], 
       TemplateBox[{"n"},
        "Ket"]}]}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{
        TemplateBox[{"m"},
         "Bra"], 
        SubscriptBox["P", "U"], "H", "\[VeryThinSpace]", 
        SubscriptBox["P", "U"], 
        TemplateBox[{"n"},
         "Ket"]}], "+", 
       RowBox[{
        TemplateBox[{"m"},
         "Bra"], 
        SubscriptBox["P", "U"], "H", "\[VeryThinSpace]", 
        SubscriptBox["P", "D"], 
        TemplateBox[{"n"},
         "Ket"]}]}], "=", 
      RowBox[{
       SubscriptBox["E", "n"], 
       TemplateBox[{"m"},
        "Bra"], 
       SubscriptBox["P", "U"], 
       TemplateBox[{"n"},
        "Ket"]}]}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{
        TemplateBox[{"m"},
         "Bra"], 
