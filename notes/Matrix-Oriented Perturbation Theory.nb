         RowBox[{
          SuperscriptBox[
           SubscriptBox["q", "1"], "2"], 
          SubscriptBox["q", "2"], 
          SubscriptBox["q", "3"], 
          SubscriptBox["q", "4"], 
          SubscriptBox["q", "5"]}], ")"}], ")"}], "\[Union]"}]}]},
    {
     RowBox[{"\[AlignmentMarker]      ", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[ScriptCapitalP]", "3"], "(", 
        RowBox[{"S", "(", 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["q", "1"], "2"], 
          SuperscriptBox[
           SubscriptBox["q", "2"], "2"], 
          SuperscriptBox[
           SubscriptBox["q", "3"], "2"]}], ")"}], ")"}], "\[Union]", 
       RowBox[{
        SuperscriptBox["\[ScriptCapitalP]", "6"], "(", 
