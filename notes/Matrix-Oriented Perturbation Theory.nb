Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["T", "v"], " ", "=", " ", 
      RowBox[{
       RowBox[{"-", 
        FractionBox[
         SuperscriptBox["\[HBar]", "2"], "2"]}], 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"i", ",", "j"}]], "\[VeryThinSpace]\[ThinSpace]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            FractionBox["\[PartialD]", 
             RowBox[{"\[PartialD]", 
              SubscriptBox["r", "i"]}]], 
            RowBox[{"+", 
             FractionBox["1", 
              RowBox[{"4", "\[InvisibleSpace]", "d"}]]}]}], 
           FractionBox[
            RowBox[{"\[PartialD]", "\[VeryThinSpace]", "d"}], 
            RowBox[{"\[PartialD]", 
             SubscriptBox["r", "i"]}]]}], ")"}], 
         SubscriptBox["G", 
          RowBox[{"i", "\[InvisibleSpace]", "j"}]], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            FractionBox["\[PartialD]", 
             RowBox[{"\[PartialD]", 
              SubscriptBox["r", "j"]}]], 
            RowBox[{"-", 
             FractionBox["1", 
              RowBox[{"4", "\[InvisibleSpace]", "d"}]]}]}], 
           FractionBox[
            RowBox[{"\[PartialD]", "\[VeryThinSpace]", "d"}], 
            RowBox[{"\[PartialD]", 
             SubscriptBox["r", "j"]}]]}], ")"}]}]}]}]}]},
    {
     RowBox[{" ", 
      RowBox[{"=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           SuperscriptBox["\[HBar]", "2"], "2"]}], 
         RowBox[{
          UnderscriptBox["\[Sum]", 
           RowBox[{"i", ",", "j"}]], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             FractionBox["\[PartialD]", 
              RowBox[{"\[PartialD]", 
               SubscriptBox["r", "i"]}]], 
             SubscriptBox["G", 
              RowBox[{"i", "\[InvisibleSpace]", "j"}]]}], " ", 
            FractionBox[
             RowBox[{"\[PartialD]", "\[VeryThinSpace]", "d"}], 
             RowBox[{"\[PartialD]", 
              SubscriptBox["r", "j"]}]]}], ")"}]}]}], " ", "+", " ", 
        RowBox[{
         FractionBox[
          SuperscriptBox["\[HBar]", "2"], "8"], 
         RowBox[{
          UnderscriptBox["\[Sum]", 
           RowBox[{"i", ",", "j"}]], 
          RowBox[{
           FractionBox["1", "d"], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              FractionBox[
               RowBox[{"\[PartialD]", "d"}], 
               RowBox[{"\[PartialD]", 
                SubscriptBox["r", "j"]}]], 
              FractionBox[
               RowBox[{"\[PartialD]", 
                SubscriptBox["G", 
                 RowBox[{"i", "\[InvisibleSpace]", "j"}]]}], 
               RowBox[{"\[PartialD]", 
                SubscriptBox["r", "i"]}]]}], "+", 
             RowBox[{
              SubscriptBox["G", 
               RowBox[{"i", "\[InvisibleSpace]", "j"}]], "(", 
              RowBox[{
               FractionBox[
                RowBox[{
                 SuperscriptBox["\[PartialD]", "2"], "d"}], 
                RowBox[{
                 RowBox[{"\[PartialD]", 
                  SubscriptBox["r", "i"]}], 
                 RowBox[{"\[PartialD]", 
                  SubscriptBox["r", "j"]}]}]], "+", 
