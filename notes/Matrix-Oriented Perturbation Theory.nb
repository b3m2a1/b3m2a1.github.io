  3.825821594232551*^9}},ExpressionUUID->"ca2b16c2-748e-4f3c-875a-\
4d8841880644"],

Cell["This jibes with the fact that at order 1 we have", "ExpositoryText",
 CellChangeTimes->{{3.825821630967819*^9, 
  3.825821646120001*^9}},ExpressionUUID->"cfa12a72-6e07-4766-b776-\
0ee9412f11d4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", 
     SuperscriptBox["D", 
      RowBox[{"(", "0", ")"}]]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "0"}], "1"], 
     RowBox[{
      SuperscriptBox["\[CapitalDelta]H", 
       RowBox[{"(", 
        RowBox[{"1", "-", "j"}], ")"}]], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{"(", 
           RowBox[{"k", "+", "j"}], ")"}]]},
       "Ket"]}]}]}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["P", 
      SuperscriptBox["D", 
       RowBox[{"(", "0", ")"}]]], 
     SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
      RowBox[{"(", "1", ")"}]], 
     SubscriptBox["P", 
      SuperscriptBox["D", 
       RowBox[{"(", "0", ")"}]]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "k", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     SubscriptBox["P", 
      SuperscriptBox["D", 
       RowBox[{"(", "0", ")"}]]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "0"}], 
       RowBox[{"k", "-", "1"}]], 
      RowBox[{
       SuperscriptBox["\[CapitalDelta]\[ScriptCapitalH]", 
        RowBox[{"(", "1", ")"}]], 
       SubsuperscriptBox["\[CapitalPi]", 
        SuperscriptBox["U", 
         RowBox[{"(", "0", ")"}]], "n"], 
       SubsuperscriptBox["\[CapitalDelta]H", "n", 
        RowBox[{"(", 
         RowBox[{"k", "-", "i"}], ")"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "i", ")"}]]},
        "Ket"]}]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8257875367865953`*^9, 3.8257875638442307`*^9}, {
   3.825787600088464*^9, 3.825787605142007*^9}, {3.825788238984977*^9, 
