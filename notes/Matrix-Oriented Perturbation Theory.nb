Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["c", "k", 
    RowBox[{"(", 
     RowBox[{"a", ",", "b"}], ")"}]], " ", "=", " ", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "0"}], "b"], " ", 
     RowBox[{
      FractionBox["1", 
       SuperscriptBox["2", 
        RowBox[{"b", "+", "k"}]]], 
      SubsuperscriptBox["f", 
       RowBox[{"k", "\[InvisibleSpace]", "j"}], 
       RowBox[{"\[VeryThinSpace]", 
        RowBox[{"(", "b", ")"}]}]], 
      SuperscriptBox["a", "j"]}]}], " ", "+", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "a"], " ", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"j", "=", "0"}], 
       RowBox[{"b", "+", "k", "-", "1"}]], " ", 
      RowBox[{
       FractionBox["1", 
        SuperscriptBox["2", 
         RowBox[{"b", "+", "k"}]]], 
       SubsuperscriptBox["g", 
        RowBox[{"k", "\[InvisibleSpace]", "j"}], 
        RowBox[{"\[VeryThinSpace]", 
         RowBox[{"(", "b", ")"}]}]], 
       SuperscriptBox["a", "j"], " "}]}]}]}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.891305316813382*^9, 3.8913053632115*^9}, {
