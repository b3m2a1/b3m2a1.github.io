beefab3ed363"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], "k"], 
        RowBox[{
         SuperscriptBox["H", 
          RowBox[{"(", 
           RowBox[{"k", "-", "i"}], ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"]}]}]}], "=", 
      RowBox[{
       TemplateBox[{
         SuperscriptBox["m", 
          RowBox[{"(", "0", ")"}]]},
        "Bra"], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], "k"], 
        RowBox[{
         SuperscriptBox[
          SubscriptBox["E", "n"], 
          RowBox[{"(", 
           RowBox[{"k", "-", "i"}], ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "k"], 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["E", "n"], 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["m", 
             RowBox[{"(", "0", ")"}]], " "}], 
          RowBox[{"\[VeryThinSpace] ", 
            SuperscriptBox["n", 
             RowBox[{"(", "i", ")"}]]}]},
         "BraKet"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821192173865511*^9, 3.82119219604725*^9}, {
  3.821192306587338*^9, 3.8211923324126453`*^9}, {3.8211924710105124`*^9, 
  3.821192472325801*^9}},ExpressionUUID->"8f940637-22cb-40fd-9d8d-\
2524d0cc2790"],

