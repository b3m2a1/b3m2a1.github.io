  3.810514527649879*^9}},ExpressionUUID->"792eaf87-ee10-43e0-b103-\
e56853728cf0"],

Cell[TextData[{
 StyleBox["note that this can be easily proved by the fact that ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Del]", "Q"], 
    RowBox[{
     SubscriptBox["\[Del]", "X"], 
     SubscriptBox["\[Mu]", "\[Alpha]"]}]}], TraditionalForm]],
  CellChangeTimes->{{3.810514232108677*^9, 3.8105142348610497`*^9}, {
   3.810514270626685*^9, 3.810514365423052*^9}, {3.810514427404434*^9, 
   3.810514453827209*^9}, {3.81051449899897*^9, 3.810514527649879*^9}},
  ExpressionUUID->"01582a3d-8ca3-40aa-91ec-2f00d7717573"],
 StyleBox[" = ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Del]", "X"], 
      RowBox[{
       SubscriptBox["\[Del]", "Q"], 
       SubscriptBox["\[Mu]", "\[Alpha]"]}]}], ")"}], 
    StyleBox["T",
     FontSize->9,
     FontSlant->"Plain"]], TraditionalForm]],
  CellChangeTimes->{{3.810514232108677*^9, 3.8105142348610497`*^9}, {
