ff85e57dcb04"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "4th Order PT and the ",
 StyleBox["y",
  FontSlant->"Italic"],
 "-tensor"
}], "Subsubsubsection",
 CellChangeTimes->{{3.8145441365100594`*^9, 3.814544139907856*^9}, {
