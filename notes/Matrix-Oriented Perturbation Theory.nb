  ExpressionUUID->"aff9d154-6f1b-4fc9-ac3a-964548eabeb1"],
 " ",
 StyleBox["by Clairaut\[CloseCurlyQuote]s theorem or whatever",
  FontSlant->"Italic"]
}], "ExpositoryText",
