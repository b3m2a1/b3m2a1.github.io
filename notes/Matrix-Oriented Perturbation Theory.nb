    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bt3", "[", 
   RowBox[{"a_", ",", " ", "w_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Binomial", "[", 
    RowBox[{
     RowBox[{"a", "+", "1"}], ",", " ", "w"}], "]"}], "*", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", 
         FractionBox["1", "2"]}], ")"}], 
       RowBox[{"(", 
        RowBox[{"w", "-", "k"}], ")"}]], 
      FractionBox[
       RowBox[{"w", "!"}], 
