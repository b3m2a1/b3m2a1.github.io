f9e7f6e06938"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["K", "b", "a"], "(", "n", ")"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "0"}], 
       RowBox[{
        RowBox[{"\[LeftBracketingBar]", 
         RowBox[{"a", "-", "b"}], "\[RightBracketingBar]"}], "/", "2"}]], 
      RowBox[{
       SubsuperscriptBox["c", "i", 
        RowBox[{"(", 
         RowBox[{"a", ",", "b"}], ")"}]], 
       SuperscriptBox["n", "i"]}]}], ")"}], 
    TagBox[GridBox[{
       {"\[Piecewise]", GridBox[{
          {
           RowBox[{
            UnderoverscriptBox["\[Product]", 
             RowBox[{"j", "=", "1"}], 
             RowBox[{"a", "-", "b"}]], 
            SqrtBox[
             RowBox[{"n", "+", "j"}]]}], 
           RowBox[{"a", " ", "\[GreaterEqual]", "b"}]},
          {
           RowBox[{
            UnderoverscriptBox["\[Product]", 
             RowBox[{"j", "=", "0"}], 
             RowBox[{"b", "-", "a", "-", "1"}]], 
            SqrtBox[
             RowBox[{"n", "-", "j"}]]}], 
           RowBox[{"a", " ", "<", " ", "b"}]}
         },
