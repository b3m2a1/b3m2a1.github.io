Cell[TextData[{
 "and now we can apply the equations we\[CloseCurlyQuote]ve written down in \
basically the same way as we did before, starting with getting the \
corrections in the non-degenerate subspace using ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["E", "n", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],ExpressionUUID->
  "2fb37e01-588e-44ed-84aa-4be7b3e469d4"],
 ", then moving to ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "4f343842-d8b0-49fa-b9ef-2dfc71ec3e11"],
 " space, using ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["E", 
    RowBox[{"(", "2", ")"}]], TraditionalForm]],ExpressionUUID->
  "6ef1d551-478c-4f7b-8710-56918c01d93c"],
 ", and finally using those bits to build ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["E", 
    RowBox[{"(", "3", ")"}]], TraditionalForm]],ExpressionUUID->
  "572de255-a362-4736-b9e6-e6483eb909ff"],
 ", which we\[CloseCurlyQuote]ll use to get the corrections in the ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],ExpressionUUID->
  "f17732b4-e54e-4f63-98a0-3d6e4a2140ec"],
 " space."
}], "ExpositoryText",
 CellChangeTimes->{{3.82174042523847*^9, 
  3.821740566514263*^9}},ExpressionUUID->"575d1232-add1-4ceb-b374-\
421833d2b00b"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Nearly-Degenerate Analysis", "Subsection",
 CellChangeTimes->{{3.821910776239746*^9, 3.821910782033484*^9}, {
  3.821911735790607*^9, 
  3.821911738891591*^9}},ExpressionUUID->"52678e00-3b67-4521-b615-\
024b6ee0fa96"],

Cell[TextData[{
 "It is often not the case that we have ",
 StyleBox["truly",
  FontSlant->"Italic"],
 " degenerate states, instead tending to have ",
 StyleBox["nearly",
  FontSlant->"Italic"],
 " degenerate states which cause numerical issues. To that effect, we note \
that the use of the identity"
}], "ExpositoryText",
 CellChangeTimes->{{3.8219107968256903`*^9, 3.8219108469423523`*^9}, {
  3.82191087912265*^9, 
  3.821910887692176*^9}},ExpressionUUID->"5eb5f5a5-85f6-4cba-ac90-\
d4e1d8dfcc68"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["H", 
     RowBox[{"(", "0", ")"}]], 
    SubscriptBox["P", "D"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    SubsuperscriptBox["E", "n", 
     RowBox[{"(", "0", ")"}]], 
    SubscriptBox["P", "D"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821910947936442*^9, 3.8219109753963623`*^9}, {
  3.821911103370124*^9, 
  3.82191110483013*^9}},ExpressionUUID->"170cb671-c3a3-4a35-8cb2-\
50fcaecf6aa8"],

Cell["is not formally correct. If instead we have that ", "ExpositoryText",
 CellChangeTimes->{{3.821910959214716*^9, 
  3.821911001911831*^9}},ExpressionUUID->"f3733628-729d-4a26-a13d-\
00d4e04a5a12"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[ForAll]", 
     RowBox[{"d", "\[Element]", "D"}]], 
    RowBox[{
     SuperscriptBox["H", 
      RowBox[{"(", "0", ")"}]], 
     TemplateBox[{
       SuperscriptBox["d", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}]}], "=", 
   RowBox[{
    SubsuperscriptBox["E", "n", 
     RowBox[{"(", "0", ")"}]], "+", 
    RowBox[{"\[Delta]", "\[VeryThinSpace]", 
     SubscriptBox["E", "d"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",\

 CellChangeTimes->{{3.821911040018381*^9, 
  3.821911069583592*^9}},ExpressionUUID->"a0816fd3-db83-4b84-8de9-\
4ff11911f102"],

Cell["we get", "ExpositoryText",
 CellChangeTimes->{{3.821911076937998*^9, 
  3.821911077905532*^9}},ExpressionUUID->"cc6014ea-2ee4-4398-8041-\
3fff0fd6a3c8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["H", 
     RowBox[{"(", "0", ")"}]], 
    SubscriptBox["P", "D"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "k", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["E", "n", 
      RowBox[{"(", "0", ")"}]], 
     SubscriptBox["P", "D"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "k", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     UnderscriptBox["\[Sum]", "d"], "\[VeryThinSpace]", 
     RowBox[{"\[Delta]", "\[VeryThinSpace]", 
      SubscriptBox["E", "d"], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{
           RowBox[{"(", "k", ")"}], "\[VeryThinSpace]"}]], 
        RowBox[{" ", 
          SuperscriptBox["d", 
           RowBox[{
             RowBox[{"(", "0", ")"}], "\[VeryThinSpace]"}]]}]},
       "BraKet"], 
      TemplateBox[{
        SuperscriptBox["d", 
         RowBox[{"(", "0", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821911029115279*^9, 3.821911032684766*^9}, {
  3.8219111068923483`*^9, 3.821911132848276*^9}, {3.82191154629739*^9, 
  3.821911580739017*^9}},ExpressionUUID->"0db124ef-412a-483e-82de-\
20e4ef5612a5"],

Cell[TextData[{
 "and so when we use that identity we are actually assuming that ",
 Cell[BoxData[
  RowBox[{"\[Delta]", "\[VeryThinSpace]", 
   SubscriptBox["E", "d"]}]],
  CellChangeTimes->{{3.821911272078689*^9, 3.8219112727708063`*^9}, 
    3.821911589087022*^9},ExpressionUUID->
  "58f376c0-a423-4b7a-a0bd-6b757feaef05"],
 " is small enough in general to swamp any overlap term."
}], "ExpositoryText",
 CellChangeTimes->{{3.821910889146196*^9, 3.821910889166535*^9}, 
   3.8219111627350073`*^9, {3.82191125767874*^9, 3.8219112798162527`*^9}, {
   3.821911593672531*^9, 
   3.8219116071787024`*^9}},ExpressionUUID->"ef65b418-67b7-4d53-9677-\
3b6d9eba4ac0"],

Cell["\<\
A key place this comes in is in deriving the first order degenerate energy \
correction when we say that \
\>", "ExpositoryText",
 CellChangeTimes->{{3.821911407342867*^9, 3.8219114876498823`*^9}, 
   3.821911634629421*^9},ExpressionUUID->"29050699-780c-4726-8da8-\
c30aa8127687"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["P", "D"], " ", 
     SuperscriptBox["H", 
      RowBox[{"(", "0", ")"}]], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "1", ")"}]]},
      "Ket"]}], "-", 
    RowBox[{
     SubsuperscriptBox["E", "n", 
      RowBox[{"(", "0", ")"}]], 
     SubscriptBox["P", "D"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "1", ")"}]]},
      "Ket"]}]}], " ", "=", " ", "0"}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8219114387745323`*^9, 
  3.8219114465362167`*^9}},ExpressionUUID->"50fe521d-7613-44c8-baf4-\
c08cc6e9addc"],

Cell["if we are to include this error term we have", "ExpositoryText",
 CellChangeTimes->{{3.821911523148829*^9, 3.8219115325548058`*^9}, {
  3.8219116415028276`*^9, 
  3.821911641668775*^9}},ExpressionUUID->"99bf9b45-133d-4feb-bab3-\
fa00c7b25735"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", "D"], " ", 
    SuperscriptBox["H", 
     RowBox[{"(", "1", ")"}]], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["E", "n", 
      RowBox[{"(", "1", ")"}]], 
     SubscriptBox["P", "D"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}], "+", 
    RowBox[{
     UnderscriptBox["\[Sum]", "d"], "\[VeryThinSpace]", 
     RowBox[{"\[Delta]", "\[VeryThinSpace]", 
      SubscriptBox["E", "d"], 
      TemplateBox[{
        SuperscriptBox["n", 
         RowBox[{
           RowBox[{"(", "1", ")"}], "\[VeryThinSpace]"}]], 
        RowBox[{" ", 
          SuperscriptBox["d", 
           RowBox[{
             RowBox[{"(", "0", ")"}], "\[VeryThinSpace]"}]]}]},
       "BraKet"], 
      TemplateBox[{
        SuperscriptBox["d", 
         RowBox[{"(", "0", ")"}]]},
       "Ket"]}]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821911416345872*^9, 3.821911417873311*^9}, {
  3.821911653516087*^9, 
  3.821911678609788*^9}},ExpressionUUID->"2e38de1e-2b97-4abb-a77e-\
b6113405abdf"],

Cell[TextData[{
 "and by using the same trick as for the degenerate ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],ExpressionUUID->
  "c21c8b6e-83d9-459b-ad2a-6d8ee6991d3c"],
 " case, we pull ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "D"], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "1", ")"}]]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "20c3e379-1415-44d7-a058-a80a17f7b3d8"],
 " in terms of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["n", 
      RowBox[{"(", "0", ")"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "24260ecb-9665-4006-96f7-372649ad8768"]
}], "ExpositoryText",
 CellChangeTimes->{{3.821911667868648*^9, 
  3.821911729965167*^9}},ExpressionUUID->"bd2b4fec-5728-43f3-bbad-\
352b7532ebaf"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["P", "n"], "=", 
   RowBox[{"I", "-", 
    RowBox[{
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8214953193114758`*^9, 
  3.821495352672785*^9}},ExpressionUUID->"8def964c-08e7-4ff7-9bd5-\
d41b28289f44"],

Cell["and now we can define", "ExpositoryText",
 CellChangeTimes->{{3.821495355012727*^9, 3.821495369932953*^9}, {
  3.8214960057810287`*^9, 
  3.821496005976755*^9}},ExpressionUUID->"3c0224bd-a706-4431-bae6-\
0ee2f0320ae7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[CapitalPi]", 
    RowBox[{"D", "\[VeryThinSpace]", "n", "\[VeryThinSpace]"}]], "=", 
   RowBox[{
    SubscriptBox["P", "D"], 
    SuperscriptBox[
     RowBox[{
      SubscriptBox["P", "n"], "(", 
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]], "-", 
       SubsuperscriptBox["E", "n", 
        RowBox[{"(", "1", ")"}]]}], ")"}], 
     RowBox[{"-", "1"}]], 
    SubscriptBox["P", "n"], 
    SubscriptBox["P", "D"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.821495307723208*^9, 3.821495313919986*^9}, {
  3.821495364165114*^9, 3.821495395285977*^9}, {3.821496063160696*^9, 
  3.8214960748655157`*^9}},ExpressionUUID->"8b267e1b-441a-42fa-8efb-\
ffb3af15813c"],

Cell["which means that ", "ExpositoryText",
 CellChangeTimes->{{3.821496007761271*^9, 
  3.8214960098772173`*^9}},ExpressionUUID->"1ab2c234-61c0-4c0b-9f10-\
f979e98fbdbe"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", 
        RowBox[{"D", "\[VeryThinSpace]", "n"}]], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "1", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       SubscriptBox["\[CapitalPi]", 
        RowBox[{"D", "\[VeryThinSpace]", "n", "\[VeryThinSpace]"}]], "(", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SubsuperscriptBox["E", "n", 
            RowBox[{"(", "2", ")"}]], 
           TemplateBox[{
             SuperscriptBox["n", 
              RowBox[{"(", "0", ")"}]]},
            "Ket"]}], "-", 
          RowBox[{
           SuperscriptBox["H", 
            RowBox[{"(", "2", ")"}]], 
           TemplateBox[{
             SuperscriptBox["n", 
              RowBox[{"(", "0", ")"}]]},
            "Ket"]}]}], ")"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["H", 
            RowBox[{"(", "1", ")"}]], "-", 
           SubsuperscriptBox["E", "n", 
            RowBox[{"(", "1", ")"}]]}], ")"}], 
         SubscriptBox["\[CapitalPi]", "U"], 
         SuperscriptBox["H", 
          RowBox[{"(", "1", ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "0", ")"}]]},
          "Ket"]}]}], ")"}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[CapitalPi]", 
         RowBox[{"D", "\[VeryThinSpace]", "n", "\[VeryThinSpace]"}]], 
        SubsuperscriptBox["E", "n", 
         RowBox[{"(", "2", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], "-", 
       RowBox[{
        SubscriptBox["\[CapitalPi]", 
         RowBox[{"D", "\[VeryThinSpace]", "n", "\[VeryThinSpace]"}]], 
        SuperscriptBox["H", 
         RowBox[{"(", "2", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], "+", 
       RowBox[{
        SubscriptBox["\[CapitalPi]", 
         RowBox[{"D", "\[VeryThinSpace]", "n", "\[VeryThinSpace]"}]], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", "U"], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}], "-", 
       RowBox[{
        SubsuperscriptBox["E", "n", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", 
         RowBox[{"D", "\[VeryThinSpace]", "n", "\[VeryThinSpace]"}]], 
        SubscriptBox["\[CapitalPi]", "U"], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[CapitalPi]", 
         RowBox[{"D", "\[VeryThinSpace]", "n", "\[VeryThinSpace]"}]], "(", 
        RowBox[{
         RowBox[{
          SuperscriptBox["H", 
           RowBox[{"(", "1", ")"}]], 
          SubscriptBox["\[CapitalPi]", "U"], 
          SuperscriptBox["H", 
           RowBox[{"(", "1", ")"}]]}], "-", 
         SuperscriptBox["H", 
          RowBox[{"(", "2", ")"}]]}], ")"}], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "0", ")"}]]},
        "Ket"]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8214960137617702`*^9, 3.821496084869258*^9}, {
   3.821496257807138*^9, 3.821496259656931*^9}, {3.821911920567882*^9, 
   3.8219119307405043`*^9}, 3.821912001980152*^9, {3.8219120853406897`*^9, 
   3.821912095731976*^9}, {3.8219122074840517`*^9, 3.821912212627597*^9}, {
   3.821912290544104*^9, 
   3.821912380909314*^9}},ExpressionUUID->"bf68cfa2-8a91-4803-a902-\
777142d76f39"],

Cell["and so we get", "ExpositoryText",
 CellChangeTimes->{{3.8219124162602863`*^9, 
  3.821912463536787*^9}},ExpressionUUID->"73f7a92c-98d0-4121-90f0-\
06fbcc72f88f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[Sum]", "d"], "\[VeryThinSpace]", 
    RowBox[{"\[Delta]", "\[VeryThinSpace]", 
     SubscriptBox["E", "d"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{
          RowBox[{"(", "1", ")"}], "\[VeryThinSpace]"}]], 
       RowBox[{" ", 
         SuperscriptBox["d", 
          RowBox[{
            RowBox[{"(", "0", ")"}], "\[VeryThinSpace]"}]]}]},
      "BraKet"], 
     TemplateBox[{
       SuperscriptBox["d", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}]}], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", "d"], "\[VeryThinSpace]", 
    RowBox[{"\[Delta]", "\[VeryThinSpace]", 
     SubscriptBox["E", "d"], 
     TemplateBox[{
       SuperscriptBox["d", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"], 
     TemplateBox[{
       SuperscriptBox["d", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"], 
     RowBox[{
      SubscriptBox["\[CapitalPi]", 
       RowBox[{"D", "\[VeryThinSpace]", "n", "\[VeryThinSpace]"}]], "(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]], 
        SubscriptBox["\[CapitalPi]", "U"], 
        SuperscriptBox["H", 
         RowBox[{"(", "1", ")"}]]}], "-", 
       SuperscriptBox["H", 
        RowBox[{"(", "2", ")"}]]}], ")"}], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.8219124674855137`*^9, 3.821912537576704*^9}, {
  3.821913379455708*^9, 3.821913388489318*^9}, {3.821913435017208*^9, 
  3.821913444168046*^9}},ExpressionUUID->"89c185c5-7f60-4ea6-8398-\
6bc96b1f48f5"],

Cell["then we\[CloseCurlyQuote]ll introduce an error operator", \
"ExpositoryText",
 CellChangeTimes->{{3.821913452825471*^9, 
  3.821913476775559*^9}},ExpressionUUID->"9b160627-94c2-4e11-b685-\
8f8a2b010fc9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["F", "D"], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", "d"], "\[VeryThinSpace]", 
    RowBox[{"\[Delta]", "\[VeryThinSpace]", 
     SubscriptBox["E", "d"], 
     TemplateBox[{
       SuperscriptBox["d", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"], 
     TemplateBox[{
       SuperscriptBox["d", 
        RowBox[{"(", "0", ")"}]]},
      "Bra"]}]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.82191347775819*^9, 
  3.8219135009797697`*^9}},ExpressionUUID->"986389c6-e444-4b1d-a44d-\
60fce70db603"],

Cell["which gives us", "ExpositoryText",
 CellChangeTimes->{{3.821913510995103*^9, 
  3.821913513368672*^9}},ExpressionUUID->"a0e73d1a-d66c-4549-a045-\
ccf76df55881"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[Sum]", "d"], "\[VeryThinSpace]", 
    RowBox[{"\[Delta]", "\[VeryThinSpace]", 
     SubscriptBox["E", "d"], 
     TemplateBox[{
       SuperscriptBox["n", 
        RowBox[{
          RowBox[{"(", "1", ")"}], "\[VeryThinSpace]"}]], 
       RowBox[{" ", 
         SuperscriptBox["d", 
          RowBox[{
            RowBox[{"(", "0", ")"}], "\[VeryThinSpace]"}]]}]},
      "BraKet"], 
     TemplateBox[{
       SuperscriptBox["d", 
        RowBox[{"(", "0", ")"}]]},
      "Ket"]}]}], "=", 
   RowBox[{
    SubscriptBox["F", "D"], 
    RowBox[{
     SubscriptBox["\[CapitalPi]", 
      RowBox[{"D", "\[VeryThinSpace]", "n", "\[VeryThinSpace]"}]], "(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]], 
       SubscriptBox["\[CapitalPi]", "U"], 
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]]}], "-", 
      SuperscriptBox["H", 
       RowBox[{"(", "2", ")"}]]}], ")"}], 
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}]}], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.82191351960324*^9, 
  3.821913532682929*^9}},ExpressionUUID->"9b59fdcb-4804-4d0f-9cde-\
f6a98fb4ce6e"],

Cell[TextData[{
 "which ",
 StyleBox["almost",
  FontSlant->"Italic"],
 " gives us a way to get a \[OpenCurlyDoubleQuote]corrected\
\[CloseCurlyDoubleQuote] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["E", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],ExpressionUUID->
  "361ca0ed-fbdb-4256-91b4-4cbcdea24ce0"],
 " and zero-order states from which we can infer our error bounds from \
assuming ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", "D"], "=", "\[DoubleStruckZero]"}], TraditionalForm]],
  ExpressionUUID->"ee560b58-64aa-4eb4-a33d-3ac1833c669f"],
 ". Unfortunately"
}], "ExpositoryText",
 CellChangeTimes->{{3.821913535475918*^9, 
  3.821913642963038*^9}},ExpressionUUID->"e8896a51-f458-4867-8a1e-\
2581467bba8e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[CapitalPi]", 
    RowBox[{"D", "\[VeryThinSpace]", "n", "\[VeryThinSpace]"}]], "=", 
   RowBox[{
    SubscriptBox["P", "D"], 
    SuperscriptBox[
     RowBox[{
      SubscriptBox["P", "n"], "(", 
      RowBox[{
       SuperscriptBox["H", 
        RowBox[{"(", "1", ")"}]], "-", 
       SubsuperscriptBox["E", "n", 
        RowBox[{"(", "1", ")"}]]}], ")"}], 
     RowBox[{"-", "1"}]], 
