              SubscriptBox["a", "i"], "-", 
              SubscriptBox["b", "i"], "-", 
              SubscriptBox["k", "i"]}]], "(", "n", ")"}], 
           RowBox[{
            SubsuperscriptBox["S", 
             SubscriptBox["k", "i"], "0"], "(", "n", ")"}], "  "}], 
