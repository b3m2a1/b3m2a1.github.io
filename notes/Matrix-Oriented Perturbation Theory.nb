   }], TraditionalForm]], "ExpositoryMathCenteredManuallyAligned",
 CellChangeTimes->{{3.82805199953102*^9, 3.828052001770055*^9}, {
   3.8280520415681143`*^9, 3.828052076570458*^9}, {3.828052110066807*^9, 
   3.828052317190997*^9}, 3.8280525531972637`*^9, {3.828052721290851*^9, 
   3.828052723765136*^9}},ExpressionUUID->"11393296-7d00-4c17-9f75-\
42512998a9b8"],

Cell[TextData[{
 "and we can see that there are many terms, like ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalDelta]H", "n", 
     RowBox[{"(", "3", ")"}]], 
    SubscriptBox["\[CapitalPi]", "n"], 
    SubsuperscriptBox["\[CapitalDelta]H", "n", 
     RowBox[{"(", "1", ")"}]]}], TraditionalForm]],
  CellChangeTimes->{{3.82805199953102*^9, 3.828052001770055*^9}, {
   3.8280520415681143`*^9, 3.828052076570458*^9}, {3.828052110066807*^9, 
   3.828052317190997*^9}},ExpressionUUID->
  "5c2882dd-78ba-4291-b8b0-965fdbc8a204"],
 ", which only have one application of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPi]", "n"], TraditionalForm]],ExpressionUUID->
  "1b17ffe0-76d7-4043-a14e-fbfede38bf10"],
 " and would therefore may be unproblematic in the PT, conversely, we have \
stuff like ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalDelta]H", "n", 
     RowBox[{"(", "1", ")"}]], 
    SubscriptBox["\[CapitalPi]", "n"], 
    SubsuperscriptBox["\[CapitalDelta]H", "n", 
     RowBox[{"(", "1", ")"}]], 
    SubscriptBox["\[CapitalPi]", "n"], 
    SubsuperscriptBox["\[CapitalDelta]H", "n", 
     RowBox[{"(", "1", ")"}]], 
    SubscriptBox["\[CapitalPi]", "n"], 
    SubsuperscriptBox["\[CapitalDelta]H", "n", 
     RowBox[{"(", "1", ")"}]]}], TraditionalForm]],
  CellChangeTimes->{{3.82805199953102*^9, 3.828052001770055*^9}, {
    3.8280520415681143`*^9, 3.828052076570458*^9}, {3.828052110066807*^9, 
    3.828052317190997*^9}, 3.8280525531972637`*^9},ExpressionUUID->
  "119f1218-f5eb-430b-8d95-d61fba3bedd5"],
 " which has a full 3 application of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPi]", "n"], TraditionalForm]],ExpressionUUID->
  "50a320da-1ae4-4ec0-b702-82672afd2cab"],
 " and may well be problematic. The order at which things would become \
problematic is non-obvious to this lowly graduate student. We can make use of \
this, though, and track terms by their order in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPi]", "n"], TraditionalForm]],ExpressionUUID->
  "95221251-f35d-45ee-a0f6-0050950a0e75"],
 ", which is not much of a lift. We\[CloseCurlyQuote]ll go one step further, \
though, and everywhere we see a ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPi]", "n"], TraditionalForm]],ExpressionUUID->
  "eca8b336-bbee-4935-bab8-2c8dd5cf926d"],
 " we\[CloseCurlyQuote]ll expand it as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalPi]", "n"], 
    SubscriptBox["P", "O"]}], "+", 
   RowBox[{
    SubscriptBox["\[CapitalPi]", "n"], 
    SubscriptBox["P", "D"]}]}]],
  CellChangeTimes->{{3.827707029211122*^9, 3.827707051809273*^9}, {
   3.8277071012478857`*^9, 3.827707103590711*^9}, {3.8277139502139*^9, 
   3.8277139841597157`*^9}, {3.827714028413035*^9, 3.827714039715076*^9}, {
   3.828051675180504*^9, 3.828051684530818*^9}},ExpressionUUID->
  "bc2ca9b2-2a1a-4a18-b681-3011583656c6"],
 ". I\[CloseCurlyQuote]m only going to do this through order 3"
}], "ExpositoryText",
 CellChangeTimes->{{3.828052331483185*^9, 3.828052365398888*^9}, {
  3.828052555835066*^9, 3.828052564701285*^9}, {3.828052601591652*^9, 
  3.828052707290457*^9}, {3.828052975215193*^9, 3.8280530282181473`*^9}, {
  3.828053103259798*^9, 
  3.828053103460328*^9}},ExpressionUUID->"200e99d1-0cdb-413e-8ddf-\
005b3cf3f7c4"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["B", "n", 
       RowBox[{"(", "1", ")"}]], "=", "\[AlignmentMarker]", 
      SubsuperscriptBox["\[CapitalDelta]H", "n", 
       RowBox[{"(", "1", ")"}]]}]},
    {
