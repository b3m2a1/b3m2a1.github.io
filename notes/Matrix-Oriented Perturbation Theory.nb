Cell[TextData[{
 "We\[CloseCurlyQuote]ll assume we have that form for all ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],ExpressionUUID->
  "93c3d63f-9a47-44fa-aef9-9be6f744db0d"],
 " up to order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "-", "1"}], TraditionalForm]],ExpressionUUID->
  "c99e15f2-293b-46f1-a448-a874ec990f54"],
 ", then clearly"
}], "ExpositoryText",
 CellChangeTimes->{{3.825903106616357*^9, 3.825903133027615*^9}, {
  3.825903871464171*^9, 
  3.825903871630767*^9}},ExpressionUUID->"0554dc8a-5c0c-4a77-a03c-\
03a8dd80cb26"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["P", "U"], 
       TemplateBox[{
         SuperscriptBox["n", 
          RowBox[{"(", "k", ")"}]]},
        "Ket"]}], "=", 
      RowBox[{
       SubscriptBox["\[CapitalPi]", "U"], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], 
         RowBox[{"k", "-", "1"}]], 
        RowBox[{
         SuperscriptBox["\[CapitalDelta]H", 
          RowBox[{"(", 
           RowBox[{"k", "-", "i"}], ")"}]], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       SubscriptBox["\[CapitalPi]", "U"], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], 
         RowBox[{"k", "-", "1"}]], 
        RowBox[{
         RowBox[{
          SuperscriptBox["\[CapitalDelta]H", 
           RowBox[{"(", 
            RowBox[{"k", "-", "i"}], ")"}]], "(", 
          RowBox[{
           SubscriptBox["P", "U"], "+", 
           RowBox[{
            TemplateBox[{
              SuperscriptBox["n", 
               RowBox[{"(", "0", ")"}]]},
             "Ket"], 
            TemplateBox[{
              SuperscriptBox["n", 
               RowBox[{"(", "0", ")"}]]},
             "Bra"]}]}], ")"}], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"]}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "0"}], 
         RowBox[{"k", "-", "1"}]], 
        RowBox[{
         SuperscriptBox["\[CapitalGamma]", 
          RowBox[{"(", 
           RowBox[{"k", "-", "i"}], ")"}]], 
         SubscriptBox["P", "U"], 
         TemplateBox[{
           SuperscriptBox["n", 
            RowBox[{"(", "i", ")"}]]},
          "Ket"]}]}], "+", 
       RowBox[{
        SuperscriptBox["\[CapitalGamma]", 
         RowBox[{"(", 
          RowBox[{"k", "-", "i"}], ")"}]], 
        TemplateBox[{
          RowBox[{
            SuperscriptBox["n", 
             RowBox[{"(", "0", ")"}]], " "}], 
          RowBox[{" ", 
            SuperscriptBox["n", 
             RowBox[{"(", "i", ")"}]]}]},
         "BraKet"], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], 
        RowBox[{"k", "-", "1"}]], 
       RowBox[{
        RowBox[{
         SuperscriptBox["\[CapitalGamma]", 
          RowBox[{"(", 
           RowBox[{"k", "-", "i"}], ")"}]], "(", 
         RowBox[{
          SuperscriptBox["G", 
           RowBox[{"(", "i", ")"}]], "+", 
          TemplateBox[{
            RowBox[{
              SuperscriptBox["n", 
               RowBox[{"(", "0", ")"}]], " "}], 
            RowBox[{" ", 
              SuperscriptBox["n", 
               RowBox[{"(", "i", ")"}]]}]},
           "BraKet"]}], ")"}], 
        TemplateBox[{
          SuperscriptBox["n", 
           RowBox[{"(", "0", ")"}]]},
         "Ket"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.825902312684655*^9, 3.8259023551283417`*^9}, {
