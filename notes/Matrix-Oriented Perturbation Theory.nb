    3.8894683240807133`*^9, 3.889468365779113*^9}, {3.889468573644895*^9, 
    3.8894685966551847`*^9}, {3.889468654354072*^9, 3.88946867122362*^9}, {
    3.889468830849325*^9, 3.889468884460628*^9}, {3.889468984742216*^9, 
    3.889469011654874*^9}, {3.889469637404029*^9, 3.889469643902707*^9}, {
    3.889469709242173*^9, 3.8894697396782837`*^9}},ExpressionUUID->
  "a1a4bd84-a4c8-47b9-8e09-079ea9591d77"],
 " term \[Rule] a sign that this could probably be done with matrix \
transforms between the rising and falling factorial bases]"
}], "ExpositoryText",
 CellChangeTimes->{{3.8894688341807547`*^9, 3.889468842616426*^9}, {
  3.88946975535736*^9, 3.889469772014264*^9}, {3.889470051402802*^9, 
