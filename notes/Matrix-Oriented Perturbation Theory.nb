Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", "Q"], 
    RowBox[{"(", " ", 
     RowBox[{
      FormBox[
       RowBox[{
        RowBox[{
         SubscriptBox["\[Del]", 
          SuperscriptBox["Q", "n"]], "X"}], 
        RowBox[{"\[LeftAngleBracket]", 
         RowBox[{"i", ",", "j"}], "\[RightAngleBracket]"}], " "}],
       TraditionalForm], "\[InvisibleSpace]", 
      RowBox[{
