           RowBox[{"2", "\[InvisibleSpace]", "n"}]}], ")"}], 
         RowBox[{"(", 
          RowBox[{"a", "-", "i", "+", "n", "-", "1"}], ")"}]}]}], " ", "+", 
       " ", 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"n", "(", "\[InvisibleSpace]", 
         RowBox[{
          RowBox[{"2", "\[InvisibleSpace]", "n"}], "-", "2"}], ")"}]}]}]}]},
    {
     RowBox[{"=", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", 
         RowBox[{"a", "-", "2"}]}], "a"], " ", 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"(", 
         RowBox[{"a", "-", "i", "+", "1"}], ")"}], 
