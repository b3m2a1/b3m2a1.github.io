ab6020150e3d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["G", 
    RowBox[{"(", "k", ")"}]], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], 
     RowBox[{"k", "-", "1"}]], 
    RowBox[{
     SuperscriptBox["\[CapitalGamma]", 
      RowBox[{"(", 
       RowBox[{"k", "-", "i"}], ")"}]], "(", 
