Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"phasedPathsNi", ",", " ", "phasedRhoNi"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"phasedPathsNi", "[", 
    RowBox[{"seq_", ",", " ", "target_", ",", " ", 
     RowBox[{"p_", ":", "p"}], ",", " ", 
     RowBox[{"q_", ":", "q"}]}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Block", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"perms", "=", 
        RowBox[{"Join", "@@", 
         RowBox[{"Permutations", "/@", 
          RowBox[{"IntegerPartitions", "[", 
           RowBox[{"target", ",", 
            RowBox[{"{", 
             RowBox[{"Length", "[", "seq", "]"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}]}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"sel", "=", 
        RowBox[{"Pick", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "seq", "]"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "===", "p"}], "&"}], "/@", "seq"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", "states", ",", "\[IndentingNewLine]", "paths", 
       ",", "\[IndentingNewLine]", "phases"}], "\[IndentingNewLine]", "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"states", "=", 
       RowBox[{"Accumulate", "/@", "perms"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"paths", " ", "=", 
       RowBox[{"states", "+", 
        RowBox[{"Unitize", "[", 
         RowBox[{"perms", "-", "1"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"phases", "=", 
       RowBox[{"Times", "@@@", 
        RowBox[{"perms", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", " ", "sel"}], "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"I", "^", 
          RowBox[{"Length", "[", "sel", "]"}]}], "*", "phases"}], ",", " ", 
        "paths", ",", " ", "perms"}], "}"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"phasedRhoNi", "[", 
   RowBox[{"seq_", ",", " ", "target_", ",", " ", "ni_", ",", " ", 
    RowBox[{"p_", ":", "p"}], ",", " ", 
    RowBox[{"q_", ":", "q"}]}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pathStuff", "=", 
      RowBox[{"phasedPathsNi", "[", 
       RowBox[{"seq", ",", " ", "target", ",", " ", "p", ",", " ", "q"}], 
       "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Total", "@", "\[IndentingNewLine]", 
     RowBox[{"MapThread", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Function", "[", 
