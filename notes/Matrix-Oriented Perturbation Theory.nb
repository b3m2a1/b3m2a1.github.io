   3.8277210891430807`*^9},ExpressionUUID->"1a6e48fa-222b-45ce-823e-\
58633a63f03d"],

Cell[TextData[{
 "it is clear that whenever ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["s", "1"], "=", "1"}], TraditionalForm]],ExpressionUUID->
  "7b9a9661-faa4-46ed-895a-7fd0f6bd58c4"],
 " and ",
 StyleBox["M",
  FontSlant->"Italic"],
 " is large enough, that term is 0, a similar property applies for the \
opposite direction"
}], "ExpositoryText",
 CellChangeTimes->{{3.82772072617356*^9, 3.827720749770524*^9}, {
