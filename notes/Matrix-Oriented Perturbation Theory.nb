Cell[TextData[{
 "which means in evaluating ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      SuperscriptBox["n", 
       RowBox[{"(", "0", ")"}]]},
     "Bra"], 
    SubsuperscriptBox["A", "n", 
     RowBox[{"(", "i", ")"}]], 
    SubscriptBox["\[CapitalPi]", "n"], 
    SubscriptBox["\[CapitalPi]", "m"], 
    SubsuperscriptBox["A", "m", 
     RowBox[{"(", 
      RowBox[{"k", "-", "i"}], ")"}]], 
    TemplateBox[{
      SuperscriptBox["m", 
       RowBox[{"(", "0", ")"}]]},
     "Ket"]}], TraditionalForm]],
  CellChangeTimes->{{3.827894308031608*^9, 3.827894318522044*^9}},
  ExpressionUUID->"5133c96a-e102-4b2a-bf30-4757789df9c4"],
 ", we just need to evaluate elements over those products. Expanding these \
terms then gives us"
}], "ExpositoryText",
