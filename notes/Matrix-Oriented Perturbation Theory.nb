a2d5216dcbaa"],

Cell[TextData[{
 "We have ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubsuperscriptBox["P", "k", "m"],
    FontSlant->"Italic"], TraditionalForm]],
  CellChangeTimes->{{3.8120294342277737`*^9, 3.812029467278864*^9}},
  ExpressionUUID->"4f0c7ea0-d2a9-4516-9525-f75de601be35"],
 ", which is the set of paths of length ",
 StyleBox["m",
  FontSlant->"Italic"],
 " that will change the number of quanta by ",
 StyleBox["k",
  FontSlant->"Italic"],
 ". If ",
 StyleBox["m",
  FontSlant->"Italic"],
 " is 5 and ",
 StyleBox["k",
  FontSlant->"Italic"],
 " is 1, this set of paths is generated from a list of the possible set of \
transitions"
}], "ExpositoryText",
 CellChangeTimes->{{3.8120297810084257`*^9, 3.81202980997486*^9}, {
   3.812029849649455*^9, 3.8120298963406467`*^9}, {3.8120299758678093`*^9, 
   3.812030036458632*^9}, {3.812044848383518*^9, 3.81204485126777*^9}, {
