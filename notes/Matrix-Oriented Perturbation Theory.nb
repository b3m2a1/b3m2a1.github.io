Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubsuperscriptBox["P", "b", "a"], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "a"], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"n", "+", "i", "-", 
          RowBox[{"(", 
           RowBox[{"b", "-", "1"}], ")"}]}], ")"}], 
        FractionBox["1", 
         RowBox[{
          SuperscriptBox["2", 
           RowBox[{"b", "-", "1"}]], "\[InvisibleSpace]"}]], 
        RowBox[{"(", GridBox[{
           {
            RowBox[{"i", "+", "b", "-", "1"}]},
           {
            RowBox[{"b", "-", "1"}]}
          },
          GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
        RowBox[{
         SubsuperscriptBox[
          OverscriptBox["P", "~"], 
          RowBox[{"b", "-", "1"}], "i"], "(", "n", ")"}]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       FractionBox["1", 
        RowBox[{
         SuperscriptBox["2", 
          RowBox[{"b", "-", "1"}]], "\[InvisibleSpace]"}]], 
