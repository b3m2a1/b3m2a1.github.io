  3.946520823362225*^9}},ExpressionUUID->"23c96117-6fe1-45cb-99f7-\
e76c2869c0d4"],

Cell["and alternately we have", "ExpositoryText",
 CellChangeTimes->{{3.9203806349086523`*^9, 
  3.920380638137694*^9}},ExpressionUUID->"05bceceb-439a-45cb-a60d-\
0b945906fc83"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["P", "a", "b"], "(", 
    RowBox[{"n", " ", "+", " ", 
     RowBox[{"(", 
      RowBox[{"a", "-", "b"}], ")"}]}], ")"}], " ", "=", " ", 
   RowBox[{
    SubsuperscriptBox["P", "b", "a"], "(", "n", ")"}]}], 
  TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.889549598751487*^9, 3.889549654672254*^9}, {
  3.892215981378977*^9, 
  3.892215982933777*^9}},ExpressionUUID->"121eb0da-1071-4bb5-a85c-\
8a57b8b10bb6"],

Cell[TextData[{
 "We can make a combinatoric model of this where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {
       RowBox[{"a", "+", "b"}]},
      {"b"}
     },
     GridBoxAlignment->{"Columns" -> {Center}}], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.891535471072451*^9, 3.891535511271593*^9}},
  ExpressionUUID->"c1f87780-33e3-4ab4-84d6-d88afcbf24b2"],
 " is the total number of paths where we go up ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "ce1ac186-1454-4d1e-8582-24e95a01501d"],
 " steps and down ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]], "ExpositoryTextInline",ExpressionUUID->
  "f175e197-2dcc-4f18-9ef1-69d90781d5dd"],
 " steps, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[Omega]", "!"}], 
   RowBox[{"(", GridBox[{
      {"b"},
      {"\[Omega]"}
     },
     GridBoxAlignment->{"Columns" -> {Center}}], ")"}], 
   RowBox[{"(", GridBox[{
      {"a"},
      {"\[Omega]"}
     },
     GridBoxAlignment->{"Columns" -> {Center}}], ")"}]}]],
  CellChangeTimes->{{3.891535471072451*^9, 3.891535511271593*^9}, {
   3.8921978011448927`*^9, 3.892197809108573*^9}, {3.892215745603386*^9, 
   3.892215750976857*^9}},ExpressionUUID->
  "088dfa52-6e1f-4f52-8578-64eb546ac3dd"],
 " is a falling factorial connection coefficient which correspond to the \
numbers of ways to pull together \[Omega] raising/lowering operations, and \
the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SuperscriptBox["2", "\[Omega]"]}], TraditionalForm]], 
  "ExpositoryTextInline",ExpressionUUID->
  "10dc2aaa-20db-4498-a8e4-0f7bb4bbb074"],
 " is keeping us from over-counting as we would naturally double-count (and \
so recursively multiply) for each of the \[Omega] choices"
}], "ExpositoryText",
 CellChangeTimes->{{3.892147847267599*^9, 3.8921480307043943`*^9}, {
   3.892148111484448*^9, 3.892148152791308*^9}, {3.892148348035096*^9, 
   3.8921483541989594`*^9}, {3.892148389409848*^9, 3.892148390891756*^9}, 
   3.892166642440497*^9, {3.892215760622115*^9, 
   3.892215900304991*^9}},ExpressionUUID->"7cabc34e-60b3-44a4-86a2-\
c04d0828d4f2"],

