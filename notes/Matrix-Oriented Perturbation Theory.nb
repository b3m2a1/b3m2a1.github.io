    3.8894683240807133`*^9, 3.889468365779113*^9}, {3.889468573644895*^9, 
    3.8894685966551847`*^9}, {3.889468654354072*^9, 3.88946867122362*^9}, {
    3.889468830849325*^9, 3.889468884460628*^9}, {3.889468984742216*^9, 
