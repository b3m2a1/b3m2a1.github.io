Cell[CellGroupData[{

Cell["Inclusion of Momenta", "Subsubsection",
 CellChangeTimes->{{3.812212864928891*^9, 3.812212879592451*^9}, {
  3.8122201232376537`*^9, 
  3.8122201270762167`*^9}},ExpressionUUID->"d4bf56a7-9e12-4e35-9cb0-\
8452e7aba558"],

Cell["Let's look back at", "ExpositoryText",
 CellChangeTimes->{{3.813429852919649*^9, 
  3.8134299236709347`*^9}},ExpressionUUID->"2cfc8147-099b-457a-9f07-\
ba45c4d227fc"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{"Q", "=", 
      RowBox[{"(", 
       RowBox[{"a", "+", 
        SuperscriptBox["a", "+"]}], ")"}]}]},
    {
     RowBox[{"p", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"-", "i"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"a", "-", 
         SuperscriptBox["a", "+"]}], ")"}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.813429925000875*^9, 
  3.81342994714922*^9}},ExpressionUUID->"b7f320b1-12e2-401d-9025-\
afdf56b7f90e"],

Cell[TextData[{
 "we see that the terms we get come from generating the Cartesian product of \
pairs like ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", " ", "1"}], ")"}], TraditionalForm]],ExpressionUUID->
  "04c8185b-d94e-4957-b9db-34f61525ba63"],
 " for ",
 StyleBox["Q",
  FontSlant->"Italic"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", " ", 
     RowBox[{"-", "1"}]}], ")"}], TraditionalForm]],ExpressionUUID->
  "33021bf5-57eb-4d8c-a9c7-f0afb2b22510"],
 " for ",
 StyleBox["p",
  FontSlant->"Italic"],
 ". Our permutations are constructed in the same way, but in that case all of \
the pairs are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], ",", " ", "1"}], ")"}], TraditionalForm]],
  ExpressionUUID->"94d1e8a6-c9ee-4a21-b63b-e727a6738e17"],
 " because as written the lowering operator comes first. This means we can \
write"
}], "ExpositoryText",
 CellChangeTimes->{{3.8134299518381453`*^9, 3.81343009076779*^9}, {
  3.81343062109135*^9, 
  3.81343062770728*^9}},ExpressionUUID->"c336921b-520a-48fe-97bc-\
0fb6282fb915"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       UnderscriptBox["\[Product]", "r"], " ", 
       RowBox[{
        SubscriptBox["o", "r"], " ", 
        TemplateBox[{
          SubscriptBox["n", "i"]},
         "Ket"]}]}], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Alpha]", "=", 
         RowBox[{"-", "N"}]}], "N"], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          UnderscriptBox["\[Sum]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\[Phi]", ",", " ", "p"}], "}"}], "\[Element]", 
            StyleBox[
             SubsuperscriptBox["P", 
              SubscriptBox["o", "r"], "\[Alpha]"],
             FontSize->12]}]], 
          RowBox[{"\[Phi]", 
           RowBox[{
            UnderscriptBox["\[Product]", 
             RowBox[{"l", "\[VeryThinSpace]", "\[Element]", "p"}]], 
            SqrtBox[
             FractionBox[
              RowBox[{
               SubscriptBox["n", "i"], "+", "l"}], "2"]]}]}]}], ")"}], 
        TemplateBox[{
          RowBox[{
            SubscriptBox["n", "i"], "+", "j"}]},
         "Ket"]}]}]}]},
    {
     RowBox[{"=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"\[Alpha]", "=", 
         RowBox[{"-", "N"}]}], "N"], 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["\[Rho]", 
          SubscriptBox["o", "r"], "\[Alpha]"], "(", 
         SubscriptBox["n", "i"], ")"}], 
        TemplateBox[{
          RowBox[{
            SubscriptBox["n", "i"], "+", "j"}]},
         "Ket"]}]}]}]}
   }], TraditionalForm]], "ExpositoryMathCentered",
 CellChangeTimes->{{3.813430101966902*^9, 3.813430102690489*^9}, {
   3.813430183717347*^9, 3.813430343561923*^9}, {3.813430394409296*^9, 
   3.81343040751757*^9}, 3.813430641054298*^9, {3.813431454310824*^9, 
   3.81343146084363*^9}, {3.813431496377748*^9, 
   3.813431500307948*^9}},ExpressionUUID->"9b19425b-3860-4693-97ad-\
bf0eab1f349d"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["o", "r"], TraditionalForm]],ExpressionUUID->
  "96ee740b-7d24-4dcf-8417-25b5ac460c94"],
 " is a sequence of ",
 StyleBox["N",
  FontSlant->"Italic"],
 " operators (where each is ",
 StyleBox["Q",
  FontSlant->"Italic"],
 " or ",
 StyleBox["p)",
  FontSlant->"Italic"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubsuperscriptBox["P", 
     SubscriptBox["o", "r"], "\[Alpha]"],
    FontSize->12], TraditionalForm]],
  CellChangeTimes->{{3.813430101966902*^9, 3.813430102690489*^9}, {
   3.813430183717347*^9, 3.813430343561923*^9}, {3.813430394409296*^9, 
   3.81343040751757*^9}},ExpressionUUID->
  "d5979ac9-ec9a-4ef0-a567-cff5d78a01e0"],
 " is the same as ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubsuperscriptBox["P", "N", "\[Alpha]"],
    FontSize->12], TraditionalForm]],
  CellChangeTimes->{{3.813430101966902*^9, 3.813430102690489*^9}, {
   3.813430183717347*^9, 3.813430343561923*^9}, {3.813430394409296*^9, 
   3.81343040751757*^9}},ExpressionUUID->
  "0fdcf791-f555-49f8-a692-f77bb26c234d"],
 " but now also tracking phase information in the permutations, as given by \
\[Phi]. This will include "
}], "ExpositoryText",
 CellChangeTimes->{{3.813430358955518*^9, 3.8134304831800222`*^9}, {
  3.813431069802946*^9, 3.81343107385355*^9}, {3.813431465286789*^9, 
  3.813431493564191*^9}},ExpressionUUID->"7bb89973-c701-46e0-80ec-\
6fb6738bc332"],

Cell[TextData[{
 "Now we\[CloseCurlyQuote]d like to see if the phase information encoded in \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["o", "r"], TraditionalForm]],
  CellChangeTimes->{{3.813430101966902*^9, 3.813430102690489*^9}, {
    3.813430183717347*^9, 3.813430343561923*^9}, {3.813430394409296*^9, 
    3.81343040751757*^9}, 3.813430641054298*^9},ExpressionUUID->
  "5796a18a-131c-4d1b-b5d0-575a8ad1a6b5"],
 " can be deduced if we\[CloseCurlyQuote]re given a permutation. To do that, \
we\[CloseCurlyQuote]ll start with a function to generate ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubsuperscriptBox["P", 
     SubscriptBox["o", "r"], "\[Alpha]"],
    FontSize->12], TraditionalForm]],
  CellChangeTimes->{{3.813430101966902*^9, 3.813430102690489*^9}, {
    3.813430183717347*^9, 3.813430343561923*^9}, {3.813430394409296*^9, 
    3.81343040751757*^9}, 3.813430641054298*^9},ExpressionUUID->
  "8db2c2e7-e608-4950-8013-2badcb7366f0"],
 " (defined below)."
}], "ExpositoryText",
 CellChangeTimes->{{3.813430631913596*^9, 3.813430681935561*^9}, {
  3.813430735118607*^9, 3.813430772984704*^9}, {3.813430914791665*^9, 
